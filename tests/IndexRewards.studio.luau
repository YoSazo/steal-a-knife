local Rewards = require(game.ReplicatedStorage.Shared.IndexRewards)
return function(t)
	t.test("only real unclaimed catalogue rewards count", function()
		local pending = Rewards.Pending("PocketKnife,PocketKnife,NotAKnife,RustyShank", "RustyShank")
		t.expect.equal(#pending, 1)
		t.expect.equal(pending[1], "PocketKnife")
	end)
	t.test("successful claim clears guidance before the attribute catches up", function()
		t.expect.equal(#Rewards.Pending("PocketKnife,RustyShank", "", "PocketKnife,RustyShank"), 0)
	end)
	t.test("claiming one reward leaves the other available", function()
		t.expect.equal(#Rewards.Pending("PocketKnife,RustyShank", "", "PocketKnife"), 1)
	end)
end

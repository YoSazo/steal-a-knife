# Copy to .env and fill in. NEVER commit .env. Then: cd analytics && npm install && npm run setup
#
# ROBLOX_API_KEY: create.roblox.com -> Dashboard -> Open Cloud -> API Keys -> Create API Key
#   (owned by YOU, not a group, so the Ads Manager part works). Add these APIs, each for this
#   experience where it asks:
#     Assets API ............................ asset:read, asset:write   (model uploads)
#     developer-product ..................... read, write                (creates the Robux products)
#     game-pass ............................. read, write                (creates the passes)
#     universe.secret ....................... read, write                (stores the game's ingest_key)
#     universe.analytics .................... read                       (Roblox's impressions/retention)
#     ad.campaign ........................... read                       (Ads Manager campaign status)
#   Accepted IP addresses: 0.0.0.0/0 (Render's IP changes)
ROBLOX_API_KEY=
# Your Roblox user id (the number in your profile URL: roblox.com/users/<ID>/profile)
ROBLOX_USER_ID=
# Optional: upload models to a group instead of your user
ROBLOX_GROUP_ID=
# The game (the universe is looked up from it)
ROBLOX_PLACE_ID=119376992331481

# Analytics server (analytics/, on Render)
# Neon -> your project -> Connection string (pooled, ends with ?sslmode=require)
DATABASE_URL=
# Your Render service's address (custom domain or the onrender.com one), no trailing /ingest
INGEST_URL=
# Render -> the service -> Environment -> INGEST_KEY (generated by render.yaml): copy it here
INGEST_KEY=
# Only Render needs it, but keep it here so you don't lose it
DASH_PASSWORD=

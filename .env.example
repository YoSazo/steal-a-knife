# Copy to .env and fill in. NEVER commit .env.
# create.roblox.com -> Dashboard -> Open Cloud -> API Keys -> Create API Key
#   Access: "Assets API" with asset:read + asset:write, and your IP (or 0.0.0.0/0)
ROBLOX_API_KEY=
# Your Roblox user id (the number in your profile URL: roblox.com/users/<ID>/profile)
ROBLOX_USER_ID=
# Optional: upload to a group instead of your user
ROBLOX_GROUP_ID=

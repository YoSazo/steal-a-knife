	-- Knife made it home: arms up, little hops
	Cheer = {
		Length = 1.3,
		Keys = {
			{ T = 0, Pose = {} },
			{
				T = 0.15,
				Ease = BACK,
				Dir = OUT,
				Pose = {
					RightShoulder = R(175, 0, 25),
					LeftShoulder = R(175, 0, -25),
					Neck = R(-15, 0, 0),
					RootMove = T(0, 0.9, 0),
				},
			},
			{
				T = 0.35,
				Ease = SINE,
				Dir = INOUT,
				Pose = {
					RightShoulder = R(150, 0, 45),
					LeftShoulder = R(150, 0, -45),
					RightElbow = R(30, 0, 0),
					LeftElbow = R(30, 0, 0),
					RootMove = T(0, 0, 0),
				},
			},
			{
				T = 0.55,
				Ease = BACK,
				Dir = OUT,
				Pose = {
					RightShoulder = R(178, 0, 20),
					LeftShoulder = R(178, 0, -20),
					Neck = R(-15, 0, 0),
					RootMove = T(0, 0.9, 0),
				},
			},
			{
				T = 0.8,
				Ease = SINE,
				Dir = INOUT,
				Pose = {
					RightShoulder = R(150, 0, 45),
					LeftShoulder = R(150, 0, -45),
					RootMove = T(0, 0, 0),
				},
			},
			{ T = 1.3, Ease = QUAD, Dir = INOUT, Pose = {} },
		},
	},

	-- The Murderer gets the knife: flourish it up to the face and look at it
	Draw = {
		Length = 1.1,
		Keys = {
			{ T = 0, Pose = {} },
			{
				T = 0.25,
				Ease = BACK,
				Dir = OUT,
				Pose = {
					RightShoulder = R(110, 20, -35),
					RightElbow = R(95, 0, 0),
					RightWrist = R(0, 180, 0),
					Neck = R(-12, -25, 0),
					Waist = R(0, -10, 0),
				},
			},
			{

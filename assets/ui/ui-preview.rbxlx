					LeftShoulder = R(140, 0, -50),
					RightElbow = R(30, 0, 0),
					LeftElbow = R(30, 0, 0),
					RightHip = R(35, 0, 0),
					LeftHip = R(10, 0, 0),
					RightKnee = R(-30, 0, 0),
					LeftKnee = R(-10, 0, 0),
				},
			},
			{
				T = 0.34,
				Ease = QUAD,
				Dir = OUT,
				Pose = {
					Root = R(-90, 0, 4),
					RootMove = T(0, -2.3, 1),
					Neck = R(-6, 0, 0),
					RightShoulder = R(100, 0, 70),
					LeftShoulder = R(100, 0, -70),
					RightHip = R(20, 0, 0),
					LeftHip = R(5, 0, 0),
					RightKnee = R(-20, 0, 0),
					LeftKnee = R(-5, 0, 0),
				},
			},
			{
				T = 1.7,
				Ease = SINE,
				Dir = INOUT,
				Pose = {
					Root = R(-88, 0, -4),
					RootMove = T(0, -2.3, 1),
					Neck = R(-10, 20, 0),
					RightShoulder = R(95, 0, 75),
					LeftShoulder = R(95, 0, -75),
					RightHip = R(25, 0, 0),
					LeftHip = R(8, 0, 0),
					RightKnee = R(-25, 0, 0),
					LeftKnee = R(-8, 0, 0),
				},
			},
			{ T = 2.2, Ease = BACK, Dir = OUT, Pose = {} },
		},
	},

	-- Grabbing a knife off the floor
	Pickup = {
		Length = 0.5,
		Keys = {
			{ T = 0, Pose = {} },
			{
				T = 0.16,
				Ease = QUAD,
				Dir = OUT,
				Pose = {
					RootMove = T(0, -1.1, 0),
					Waist = R(42, 0, 0),
					Neck = R(15, 0, 0),
					RightShoulder = R(75, 0, 10),
					LeftShoulder = R(40, 0, -10),
					RightHip = R(55, 0, 0),
					LeftHip = R(55, 0, 0),
					RightKnee = R(-70, 0, 0),
					LeftKnee = R(-70, 0, 0),
				},
			},
			{
				T = 0.3,
				Ease = QUAD,
				Dir = IN,
				Pose = {
					RootMove = T(0, -0.3, 0),
					Waist = R(-5, 0, 0),
					RightShoulder = R(170, 0, -10),
					LeftShoulder = R(170, 0, 10),
				},
			},
			{ T = 0.5, Ease = SINE, Dir = OUT, Pose = {} },
		},

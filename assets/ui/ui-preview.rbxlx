            <string name="Name">Disguises</string>
            <string name="Source"><![CDATA[--!strict
-- Classic murder-game disguises: for a round, every player becomes a pre-made character with a
-- first name and a fixed outfit ("Nick", "Frank", "Rose"...), so nobody can tell who is behind
-- the Murderer. Blocky default bodies wearing painted classic clothing (tools/make_clothing.py),
-- cartoon face decals and Blender hair / hats (blender/scripts/accessories.py -> PropMeshes).
-- The real look comes back when the round ends.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Props = require(ReplicatedStorage.Shared.Props)
local CharacterFaces = require(script.Parent.CharacterFaces)
local CharacterDetails = require(script.Parent.CharacterDetails)

local Disguises = {}

-- One accessory: a PropMeshes key, recoloured. Color paints the Hair / Hat / Frame parts, Trim the
-- Trim / Tie parts (hat bands, brims, ponytail ties, headphone cups).
export type Wear = { Prop: string, Color: Color3?, Trim: Color3?, On: string? } -- On: body part (default Head)

type Outfit = {
	Name: string,
	Skin: Color3,
	Shirt: string, -- classic shirt template (uploaded image)
	Pants: string,
	Face: string,
	Wear: { Wear },
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Same order as SKIN in tools/make_clothing.py (that list is 0-based)
local SKIN = { rgb(255, 204, 153), rgb(234, 184, 146), rgb(204, 142, 105), rgb(124, 92, 70), rgb(245, 205, 48) }

-- Drawn by tools/make_faces.py (512px, 4x supersampled), uploaded as images
local FACES = {
	Angry = "rbxassetid://84558222936421",
	Cheeky = "rbxassetid://94635670686306",
	Chill = "rbxassetid://77301303588999",
	Determined = "rbxassetid://132969218020669",
	Freckles = "rbxassetid://108002712515013",
	Grin = "rbxassetid://83376711920116",
	Happy = "rbxassetid://80477324382185",
	Lashes = "rbxassetid://120029999967726",
	Smile = "rbxassetid://137483136763270",
	Smirk = "rbxassetid://93391310013128",
	Surprised = "rbxassetid://75573684402533",
	Wink = "rbxassetid://138211541316773",
}

local OUTFITS: { Outfit } = {
	{
		Name = "Nick",
		Skin = SKIN[5],
		Shirt = "rbxassetid://95677480024122",
		Pants = "rbxassetid://138894592345744",
		Face = FACES.Determined,
		Wear = {
			{ Prop = "HairSwoop", Color = rgb(105, 40, 30) },
			{ Prop = "ShutterShades", Color = rgb(245, 245, 245) },
		},
	},
	{
		Name = "Frank",
		Skin = SKIN[1],
		Shirt = "rbxassetid://121001848108826",
		Pants = "rbxassetid://118712505468034",
		Face = FACES.Angry,
		Wear = { { Prop = "Cap", Color = rgb(200, 30, 40), Trim = rgb(200, 30, 40) } },
	},
	{
		Name = "Rose",
		Skin = SKIN[2],
		Shirt = "rbxassetid://107934248336704",
		Pants = "rbxassetid://73411295491442",
		Face = FACES.Lashes,
		Wear = { { Prop = "HairLong", Color = rgb(255, 210, 90) } },
	},
	{
		Name = "Lucy",
		Skin = SKIN[1],
		Shirt = "rbxassetid://74568680751515",
		Pants = "rbxassetid://127963485526269",
		Face = FACES.Wink,
		Wear = {
			{ Prop = "HairBob", Color = rgb(80, 45, 25) },
			{ Prop = "Beanie", Color = rgb(230, 40, 40), Trim = rgb(245, 245, 245) },
		},
	},
	{
		Name = "Jake",
		Skin = SKIN[3],
		Shirt = "rbxassetid://102089062714861",
		Pants = "rbxassetid://93715269903522",
		Face = FACES.Happy,
		Wear = { { Prop = "HairMessy", Color = rgb(120, 80, 45) } },
	},
	{
		Name = "Emma",
		Skin = SKIN[2],
		Shirt = "rbxassetid://119790783596328",
		Pants = "rbxassetid://122789398619655",
		Face = FACES.Freckles,
		Wear = {
			{ Prop = "HairPonytail", Color = rgb(80, 45, 25), Trim = rgb(90, 200, 120) },
			{ Prop = "RoundGlasses", Color = rgb(25, 25, 28) },
		},
	},
	{
		Name = "Oscar",
		Skin = SKIN[4],
		Shirt = "rbxassetid://110710971824580",
		Pants = "rbxassetid://95926429468333",
		Face = FACES.Chill,
		Wear = {
			{ Prop = "HairAfro", Color = rgb(30, 20, 14) },
		},
	},
	{
		Name = "Mia",
		Skin = SKIN[1],
		Shirt = "rbxassetid://129412155369857",
		Pants = "rbxassetid://86579477798846",
		Face = FACES.Lashes,
		Wear = { { Prop = "HairBuns", Color = rgb(255, 150, 200), Trim = rgb(255, 255, 255) } },
	},
	{
		Name = "Leo",
		Skin = SKIN[3],
		Shirt = "rbxassetid://122887375166293",
		Pants = "rbxassetid://119111877490533",
		Face = FACES.Smirk,
		Wear = { { Prop = "TopHat", Color = rgb(25, 25, 28), Trim = rgb(170, 30, 40) } },
	},
	{
		Name = "Zoe",
		Skin = SKIN[4],
		Shirt = "rbxassetid://89539205752774",
		Pants = "rbxassetid://126825022549279",
		Face = FACES.Happy,
		Wear = {
			{ Prop = "HairBob", Color = rgb(20, 20, 20) },
			{ Prop = "Headphones", Color = rgb(245, 245, 245), Trim = rgb(60, 200, 230) },
		},
	},
	{
		Name = "Max",
		Skin = SKIN[5],
		Shirt = "rbxassetid://103738904240948",
		Pants = "rbxassetid://78808631904474",
		Face = FACES.Grin,
		Wear = { { Prop = "CowboyHat", Color = rgb(130, 85, 45), Trim = rgb(60, 35, 20) } },
	},
	{
		Name = "Ruby",
		Skin = SKIN[2],
		Shirt = "rbxassetid://131782825573769",
		Pants = "rbxassetid://83645273066066",
		Face = FACES.Determined,
		Wear = { { Prop = "HairLong", Color = rgb(200, 60, 30) } },
	},
	{
		Name = "Sam",
		Skin = SKIN[1],
		Shirt = "rbxassetid://94783315712898",
		Pants = "rbxassetid://133849304341480",
		Face = FACES.Surprised,
		Wear = {
			{ Prop = "Beanie", Color = rgb(40, 140, 60), Trim = rgb(30, 30, 30) },
			{ Prop = "ShutterShades", Color = rgb(20, 20, 22) },
		},
	},
	{
		Name = "Ivy",
		Skin = SKIN[3],
		Shirt = "rbxassetid://113848148510369",
		Pants = "rbxassetid://73173985298360",
		Face = FACES.Smile,
		Wear = {
			{ Prop = "HairPonytail", Color = rgb(240, 220, 170), Trim = rgb(122, 60, 160) },
			{ Prop = "RoundGlasses", Color = rgb(122, 60, 160) },
		},
	},
	{
		Name = "Ben",
		Skin = SKIN[5],
		Shirt = "rbxassetid://92608771511347",
		Pants = "rbxassetid://92208132645825",
		Face = FACES.Cheeky,
		Wear = { { Prop = "HairSpiky", Color = rgb(250, 215, 90) } },
	},
	{
		Name = "Kate",
		Skin = SKIN[2],
		Shirt = "rbxassetid://111093050431184",
		Pants = "rbxassetid://109086968383414",
		Face = FACES.Smirk,
		Wear = {
			{ Prop = "HairLong", Color = rgb(150, 20, 30) },
			{ Prop = "ShutterShades", Color = rgb(20, 20, 22) },
		},
	},
}

local HEAD_HEIGHT = 1.2 -- the default R15 head the accessories were modelled on

local originals: { [Player]: HumanoidDescription } = {}

-- Part-built stand-ins for when a Blender accessory isn't loaded ------------------------------

local function hatPart(
	head: BasePart,
	model: Model,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	p.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

local function fallbackWear(head: BasePart, model: Model, wear: Wear)
	local s = head.Size
	local top = s.Y / 2
	local color = wear.Color or Color3.new(0.2, 0.2, 0.2)
	local trim = wear.Trim or color
	local prop = wear.Prop
	if prop == "Beanie" then
		hatPart(
			head,
			model,
			"Hat",
			Vector3.new(s.X * 1.08, s.Y * 0.5, s.Z * 1.08),
			CFrame.new(0, top - s.Y * 0.05, 0),
			color
		)
		hatPart(
			head,
			model,
			"Trim",
			Vector3.new(s.X * 1.14, s.Y * 0.14, s.Z * 1.14),
			CFrame.new(0, top - s.Y * 0.28, 0),
			trim
		)
		hatPart(
			head,
			model,
			"Pompom",
			Vector3.one * s.X * 0.35,
			CFrame.new(0, top + s.Y * 0.28, 0),
			Color3.new(1, 1, 1),
			Enum.PartType.Ball
		)
	elseif prop == "Cap" then
		hatPart(
			head,
			model,
			"Hat",
			Vector3.new(s.X * 1.06, s.Y * 0.35, s.Z * 1.06),
			CFrame.new(0, top + s.Y * 0.05, 0),
			color
		)
		hatPart(
			head,
			model,
			"Trim",
			Vector3.new(s.X * 0.9, s.Y * 0.06, s.Z * 0.55),
			CFrame.new(0, top - s.Y * 0.08, -s.Z * 0.72),
			trim
		)
	elseif prop == "TopHat" then
		hatPart(
			head,
			model,
			"Brim",
			Vector3.new(s.X * 1.5, s.Y * 0.07, s.Z * 1.5),
			CFrame.new(0, top + s.Y * 0.03, 0),
			color
		)
		hatPart(
			head,
			model,
			"Hat",
			Vector3.new(s.X * 0.95, s.Y * 0.95, s.Z * 0.95),
			CFrame.new(0, top + s.Y * 0.5, 0),
			color
		)
		hatPart(
			head,
			model,
			"Trim",
			Vector3.new(s.X * 0.97, s.Y * 0.15, s.Z * 0.97),
			CFrame.new(0, top + s.Y * 0.12, 0),
			trim
		)
	elseif prop == "CowboyHat" then
		hatPart(
			head,
			model,
			"Brim",
			Vector3.new(s.X * 1.9, s.Y * 0.07, s.Z * 1.6),
			CFrame.new(0, top + s.Y * 0.02, 0),
			color
		)
		hatPart(
			head,
			model,
			"Hat",
			Vector3.new(s.X * 1.0, s.Y * 0.5, s.Z * 0.9),
			CFrame.new(0, top + s.Y * 0.27, 0),
			color
		)
	elseif prop == "ShutterShades" or prop == "RoundGlasses" then
		hatPart(
			head,
			model,
			"Frame",
			Vector3.new(s.X * 0.9, s.Y * 0.2, 0.1),
			CFrame.new(0, s.Y * 0.1, -s.Z / 2 - 0.03),
			color
		)
	elseif prop == "Headphones" then
		hatPart(
			head,
			model,
			"Hat",
			Vector3.new(s.X * 1.15, s.Y * 0.1, s.Z * 0.2),
			CFrame.new(0, top + s.Y * 0.04, 0),
			color
		)
		for _, x in { -1, 1 } do
			hatPart(
				head,
				model,
				"Trim",
				Vector3.new(s.X * 0.15, s.Y * 0.4, s.Z * 0.4),
				CFrame.new(x * s.X * 0.56, 0, 0),
				trim
			)
		end
	elseif string.sub(prop, 1, 4) == "Hair" then
		hatPart(head, model, "Hair", Vector3.new(s.X * 1.08, s.Y * 0.3, s.Z * 1.08), CFrame.new(0, top, 0), color)
		hatPart(
			head,
			model,
			"Hair",
			Vector3.new(s.X * 1.08, s.Y * 0.75, s.Z * 0.25),
			CFrame.new(0, s.Y * 0.1, s.Z * 0.47),
			color
		)
	end
end

-- Accessories ---------------------------------------------------------------------------------

-- Hats sit on top of the sculpted hair, so over hair they're worn a size up
local HATS: { [string]: boolean } =
	{ Beanie = true, Cap = true, TopHat = true, CowboyHat = true, Crown = true, Headphones = true }
local OVER_HAIR = 1.12

local function wearOn(head: BasePart, model: Model, wear: Wear, overHair: boolean?)
	if not Props.Has(wear.Prop) then
		fallbackWear(head, model, wear)
		return
	end
	local prop = Props.Build(wear.Prop)
	-- Some pieces sit on the body rather than the head (angel wings on the UpperTorso)
	local anchor: BasePart = head
	if wear.On then
		local part = head.Parent and head.Parent:FindFirstChild(wear.On)
		if part and part:IsA("BasePart") then
			anchor = part
		end
	end
	for _, d in prop:GetDescendants() do
		if d:IsA("BasePart") then
			if (d.Name == "Hair" or d.Name == "Hat" or d.Name == "Frame") and wear.Color then
				d.Color = wear.Color
			elseif (d.Name == "Trim" or d.Name == "Tie") and wear.Trim then
				d.Color = wear.Trim
			end
			-- Glasses lenses and the space helmet's bubble are see-through
			if d.Name == "Lens" then
				d.Transparency = if wear.Prop == "SpaceHelmet" then 0.82 else 0.78
				d.Reflectance = 0.03
				d.CastShadow = false
			end
			if d.Name == "Hair" then
				d.Material = Enum.Material.SmoothPlastic
				d.Reflectance = 0
			elseif d.Name == "Frame" or d.Name == "Trim" then
				d.Reflectance = 0.05
			end
		end
	end
	-- Made for the default head; guards / odd rigs get it scaled to fit
	local scale = head.Size.Y / HEAD_HEIGHT
	if overHair and HATS[wear.Prop] then
		scale *= OVER_HAIR
	end
	if math.abs(scale - 1) > 0.02 then
		prop:ScaleTo(scale)
	end
	prop:PivotTo(anchor.CFrame)
	local root = prop.PrimaryPart :: BasePart
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = root
	weld.Parent = root
	prop.Parent = model
end

local function buildWear(head: BasePart, wears: { Wear }): Model
	local old = head.Parent and head.Parent:FindFirstChild("DisguiseHat")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "DisguiseHat"
	local hasHair = false
	for _, wear in wears do
		if string.sub(wear.Prop, 1, 4) == "Hair" then
			hasHair = true
		end
	end
	for _, wear in wears do
		wearOn(head, model, wear, hasHair)
	end
	model.Parent = head.Parent
	return model
end

-- Body ----------------------------------------------------------------------------------------

local function describe(outfit: Outfit): HumanoidDescription
	local d = Instance.new("HumanoidDescription")
	-- Bare skin everywhere: the clothing templates paint sleeves, shorts and socks themselves
	d.HeadColor = outfit.Skin
	d.TorsoColor = outfit.Skin
	d.LeftArmColor = outfit.Skin
	d.RightArmColor = outfit.Skin
	d.LeftLegColor = outfit.Skin
	d.RightLegColor = outfit.Skin
	-- Everything else stays at 0/"" = the default blocky body, no catalog items
	return d
end

local function stripClothing(character: Model)
	for _, child in character:GetChildren() do
		if child:IsA("Clothing") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end
end

-- Template clothes + face + accessories on a rig that already has the outfit's description
local function dress(character: Model, outfit: Outfit)
	stripClothing(character)
	local shirt = Instance.new("Shirt")
	shirt.Name = "DisguiseShirt"
	shirt.ShirtTemplate = outfit.Shirt
	shirt.Parent = character
	local pants = Instance.new("Pants")
	pants.Name = "DisguisePants"
	pants.PantsTemplate = outfit.Pants
	pants.Parent = character
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	head = CharacterFaces.Apply(head, outfit.Face)
	buildWear(head, outfit.Wear)
	CharacterDetails.Apply(character, outfit.Name)
end

local function putOn(player: Player, outfit: Outfit)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end
	if not originals[player] then
		local ok, current = pcall(humanoid.GetAppliedDescription, humanoid)
		if ok then
			originals[player] = current
		end
	end
	local ok, err = pcall(humanoid.ApplyDescriptionResetAsync, humanoid, describe(outfit))
	if not ok then
		warn(`[Disguises] couldn't dress {player.Name}: {err}`)
	end
	if character.Parent then
		dress(character, outfit)
	end
	humanoid.DisplayName = outfit.Name
	player:SetAttribute("Disguise", outfit.Name)
end

-- Hands out a different outfit to each player (loops if there are more than 16)
function Disguises.Assign(players: { Player }): { [Player]: string }
	local pool = table.clone(OUTFITS)
	local rng = Random.new()
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local names = {}
	local pending = 0
	for i, player in players do
		local outfit = pool[(i - 1) % #pool + 1]
		names[player] = outfit.Name
		if not player.Character then
			continue
		end
		-- Applying a description yields, so dress everyone at the same time
		pending += 1
		task.spawn(function()
			putOn(player, outfit)
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 5 do
		task.wait()
	end
	return names
end

-- ShapeShifter perk: swap to an outfit nobody in `taken` is wearing. Returns the new name.
function Disguises.Shift(player: Player, taken: { [string]: boolean }): string?
	local free = {}
	for _, outfit in OUTFITS do
		if not taken[outfit.Name] then
			table.insert(free, outfit)
		end
	end
	if #free == 0 then
		return nil
	end
	local outfit = free[Random.new():NextInteger(1, #free)]
	putOn(player, outfit)
	return outfit.Name
end

-- Back to their own avatar (only needed for people who are still alive; respawns reload it anyway)
function Disguises.Remove(player: Player)
	player:SetAttribute("Disguise", nil)
	local original = originals[player]
	originals[player] = nil
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end
	local hat = character:FindFirstChild("DisguiseHat")
	if hat then
		hat:Destroy()
	end
	for _, name in { "DisguiseShirt", "DisguisePants", "DisguiseDetails" } do
		local item = character:FindFirstChild(name)
		if item then
			item:Destroy()
		end
	end
	humanoid.DisplayName = player.DisplayName
	if original then
		task.spawn(function()
			pcall(humanoid.ApplyDescriptionResetAsync, humanoid, original)
		end)
	end
end

-- Hat for any rig's head (the guards and burglars use this too): a PropMeshes key or one of the
-- old names ("Cowboy" = CowboyHat)
function Disguises.AddHat(head: BasePart, hat: string, color: Color3, shades: boolean?): Model
	local wears: { Wear } = { { Prop = if hat == "Cowboy" then "CowboyHat" else hat, Color = color, Trim = color } }
	if shades then
		table.insert(wears, { Prop = "ShutterShades", Color = Color3.new(0.05, 0.05, 0.05) })
	end
	return buildWear(head, wears)
end

-- Build a complete accessory set at once; AddHat replaces the set rather than appending to it.
function Disguises.AddAccessories(head: BasePart, wears: { Wear }): Model
	return buildWear(head, wears)
end

-- A dressed R15 rig for a round bot, wearing an outfit nobody in `taken` has. Returns its name.
function Disguises.BuildBot(taken: { [string]: boolean }): (Model, string)
	local free = {}
	for _, outfit in OUTFITS do
		if not taken[outfit.Name] then
			table.insert(free, outfit)
		end
	end
	local pool = if #free > 0 then free else OUTFITS
	local outfit = pool[Random.new():NextInteger(1, #pool)]
	local rig = Players:CreateHumanoidModelFromDescription(describe(outfit), Enum.HumanoidRigType.R15)
	dress(rig, outfit)
	return rig, outfit.Name
end

-- A dressed R15 rig of one named character (the biome bosses are round characters), with extra
-- Blender pieces on top of their usual outfit (crown, halo, horns, wings...)
local BODY_PIECES: { [string]: string } = { AngelWings = "UpperTorso" }
function Disguises.BuildCharacter(name: string, extra: { string }?): Model
	local outfit = OUTFITS[1]
	for _, candidate in OUTFITS do
		if candidate.Name == name then
			outfit = candidate
		end
	end
	local rig = Players:CreateHumanoidModelFromDescription(describe(outfit), Enum.HumanoidRigType.R15)
	dress(rig, outfit)
	if extra and #extra > 0 then
		local wears = table.clone(outfit.Wear)
		for _, prop in extra do
			table.insert(wears, { Prop = prop, On = BODY_PIECES[prop] })
		end
		local head = rig:FindFirstChild("Head") :: BasePart?
		if head then
			buildWear(head, wears)
		end
	end
	rig.Name = outfit.Name
	return rig
end

function Disguises.Forget(player: Player)
	originals[player] = nil
end

return Disguises
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Fuel</string>
            <string name="Source"><![CDATA[--!strict
-- The fuel that makes both games feed each other, kept to two numbers players can see:
--
--   🔥 Heat (0-10): everything good you do in EITHER game adds to it - stealing from a boss,
--      surviving a round, winning as the Murderer. Each point boosts BOTH games: your vault's
--      income and your luck on rare Murderer powers. Dying in a round halves it; getting caught by
--      a boss knocks one off. So every round matters more the hotter you are.
--
--   🔪 Murderer meter (profile.Luck): playing fills it (every round you're not the Murderer, every
--      steal, every survival); dying early or getting caught takes a little off. Your chance to be
--      the Murderer is your meter against everyone else's, capped so nobody hogs it, and it empties
--      when you're picked. Shown as "Your chance to be the Murderer: X%".
--
-- Rare powers (Items.Powers) are rolled when a knife reaches your vault; Heat, deeper zones and
-- bad-luck protection raise the odds, and losing a power to a Sheriff gives you "revenge" luck.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local Net = require(script.Parent.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local ServerEvents = require(script.Parent.ServerEvents)
local Social = require(script.Parent.Social)

local Fuel = {}

local CONFIG = GameConfig.Fuel
local rng = Random.new()

function Fuel.Heat(player: Player): number
	local profile = DataService.Get(player)
	return if profile then profile.Heat else 0
end

-- Vault income multiplier from Heat
function Fuel.IncomeMultiplier(player: Player): number
	return 1 + Fuel.Heat(player) * CONFIG.HeatIncome
end

-- Power-roll luck: Heat, bad-luck protection, revenge after losing one
function Fuel.PowerLuck(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	local luck = 1 + profile.Heat * CONFIG.HeatLuck
	luck *= 1 + profile.PowerPity / CONFIG.PityPer
	if profile.RevengeUntil > os.time() then
		luck *= CONFIG.RevengeLuck
	end
	-- Playing together: friends here, and the server's Lucky Rush
	luck *= Social.FriendsMultiplier(player)
	if ServerEvents.Active("LuckyRush") then
		luck *= 2
	end
	return luck
end

-- +/- Heat with a little pop on the owner's screen (client/Hud "Heat")
function Fuel.AddHeat(player: Player, delta: number, reason: string)
	local profile = DataService.Get(player)
	if not profile or delta == 0 then
		return
	end
	local before = profile.Heat
	if delta > 0 and ServerEvents.Active("HeatWave") then
		delta *= 2
	end
	local after = math.clamp(before + delta, 0, CONFIG.MaxHeat)
	if after == before then
		return
	end
	DataService.Update(player, function(p)
		p.Heat = after
	end)
	Net.Remotes.Effect:FireClient(player, "Heat", after, after - before, reason)
	-- Maxed out: the whole server catches fire
	if after == CONFIG.MaxHeat and before < CONFIG.MaxHeat then
		ServerEvents.Start("HeatWave", player.DisplayName)
	end
end

-- Dying in a round: half your Heat goes
function Fuel.HalveHeat(player: Player, reason: string)
	local profile = DataService.Get(player)
	if not profile or profile.Heat <= 0 then
		return
	end
	Fuel.AddHeat(player, math.floor(profile.Heat / 2) - profile.Heat, reason)
end

function Fuel.AddMeter(player: Player, delta: number)
	DataService.Update(player, function(p)
		p.Luck = math.max(0, p.Luck + delta)
	end)
end

-- Gives a "?" knife its power (or none), using this player's luck. Deeper-zone knives roll better.
-- Returns the finished item string.
function Fuel.RollPower(player: Player, item: string): string
	local parsed = Items.Parse(item)
	if not parsed or not parsed.Unrolled then
		return item
	end
	local rarityIndex = (table.find(Knives.Rarities, parsed.Knife.Rarity) or 1) - 1
	local luck = Fuel.PowerLuck(player) * (1 + rarityIndex * CONFIG.RarityLuck)
	local power = Items.RollPower(rng, luck)
	DataService.Update(player, function(p)
		p.PowerPity = if power == "" then p.PowerPity + 1 else 0
	end)
	return Items.WithPower(item, power)
end

return Fuel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">GuardService</string>
            <string name="Source"><![CDATA[--!strict
-- The biome bosses (the file keeps its old name: powers, combat and raids talk to "guards").
--
-- Every zone of the runway has one boss: a round character (Frank, Ivy, Sam, Leo, Ruby, Kate, Zoe,
-- Nick - the same people you turn into in murder rounds) standing in front of a wall of knives in
-- their lair. They never touch you while you look. Steal a knife off the wall and they come for
-- you, all the way back to the plaza; if they're already chasing someone, their shadow comes
-- instead, so every thief has their own chaser. Caught = they snatch the knife back (it goes
-- straight back on the wall) and it hurts. Make it home and the empty slot restocks a little later
-- with a freshly rolled knife (rare mutations get announced to the server).
--
-- Deeper bosses are faster (GuardSpeed), hit harder (Damage) and throw knives (Throws). Hitting a
-- chaser with your knife staggers it: better knives stagger longer (Damage vs the zone's Health).
-- Bosses are anchored and moved by the server, so nobody can push or fling them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnimLibrary = require(ReplicatedStorage.Shared.AnimLibrary)
local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Props = require(ReplicatedStorage.Shared.Props)
local Toy = require(ReplicatedStorage.Shared.Toy)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local ManorDecor = require(script.Parent.ManorDecor)
local Disguises = require(script.Parent.Disguises)
local MapService = require(script.Parent.MapService)
local Obstacles = require(script.Parent.Obstacles)
local Ragdoll = require(script.Parent.Ragdoll)
local StealService = require(script.Parent.StealService)
local ServerEvents = require(script.Parent.ServerEvents)
local StuckKnives = require(script.Parent.StuckKnives)

type ZoneConfig = {
	Rarity: string,
	Title: string,
	Boss: string,
	BossTitle: string,
	BossWear: { string },
	Restock: number,
	GuardSpeed: number,
	Health: number,
	Damage: number,
	Throws: boolean?,
	Color: Color3,
}

type Slot = {
	Index: number,
	Item: string?, -- on the wall right now
	Out: boolean, -- someone is running off with it
	RestockAt: number?, -- empty after a successful theft until this time
	Spot: CFrame, -- where the knife floats
	Pad: BasePart,
	Plaque: Part, -- the plate behind it (tinted with the knife's colour)
	Frame: Part, -- the thin glowing border around the plate
	Display: Model?,
	Prompt: ProximityPrompt,
}

type Boss = {
	Index: number,
	Zone: MapService.Zone,
	Config: ZoneConfig,
	Name: string,
	Post: CFrame, -- where they stand guard, facing the plaza
	Folder: Model, -- the lair
	Slots: { Slot },
	Guard: Guard, -- the boss in person
}

export type Guard = {
	Model: Model,
	Zone: MapService.Zone,
	Config: ZoneConfig,
	Boss: Boss,
	IsShadow: boolean,
	Position: Vector3,
	Target: Player?, -- the thief being chased
	Returning: boolean, -- walking back to the post (shadows vanish instead)
	AlertUntil: number,
	Alert: BillboardGui,
	Dead: boolean, -- (kept for the powers' checks; bosses never die)
	KnifeName: string,
	LastAttack: number,
	ThrowReadyAt: number,
	WindupUntil: number,
	BusyUntil: number, -- staggered / stabbing / trapped
	StaggerImmuneUntil: number,
	Tracks: { [string]: AnimationTrack },
	Playing: string?,
	Lure: BasePart?,
	LureUntil: number,
	OnLureReached: (() -> ())?,
}

type Projectile = {
	Model: Model,
	Position: Vector3,
	Direction: Vector3,
	Traveled: number,
	Damage: number,
	Target: Player,
}

local GuardService = {}

local HEIGHT = 3 -- a boss's HumanoidRootPart centre above the floor (probe rig at BossScale, Init)
local PERSON_HEIGHT = 3 -- the same for a normal-size rig (burglars use it: RootHeight)
local PLATFORM = 0.8 -- lair floor height
local ANIMATIONS: { [string]: string } = {
	Idle = "rbxassetid://507766388",
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
}

local bosses: { Boss } = {}
local chasers: { Guard } = {} -- every guard currently chasing or walking back (bosses and shadows)
local guardByModel: { [Model]: Guard } = {}
local projectiles: { Projectile } = {}
local folder: Folder
local projectileFolder: Folder
local rng = Random.new()
local idleHitNotice: { [Player]: number } = {}

local function now(): number
	return os.clock()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function billboard(adornee: BasePart, size: UDim2, offset: Vector3, maxDistance: number): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffsetWorldSpace = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

local function text(parent: Instance, content: string, color: Color3, position: UDim2, size: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.Position = position
	label.Size = size
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = content
	label.Parent = parent
	return label
end

-- Rigs -----------------------------------------------------------------------------------------

local function loadTracks(rig: Model): { [string]: AnimationTrack }
	local humanoid = rig:FindFirstChildOfClass("Humanoid") :: Humanoid
	local animator: Animator = humanoid:FindFirstChildOfClass("Animator")
		or (function()
			local created = Instance.new("Animator")
			created.Parent = humanoid
			return created
		end)()
	local tracks: { [string]: AnimationTrack } = {}
	for key, id in ANIMATIONS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(animator.LoadAnimation, animator, animation)
		if ok then
			track.Looped = true
			tracks[key] = track
		end
	end
	return tracks
end

local function animate(guard: Guard, key: string, speed: number?)
	local track = guard.Tracks[key]
	if guard.Playing ~= key then
		local old = guard.Playing and guard.Tracks[guard.Playing]
		if old then
			old:Stop(0.2)
		end
		if track then
			track:Play(0.2)
		end
		guard.Playing = key
	end
	if track and speed then
		track:AdjustSpeed(speed)
	end
end

-- A boss character: their round outfit plus their signature pieces, the zone's best knife in hand,
-- a glow in the zone's colour, and their name over their head
local function buildRig(config: ZoneConfig, shadow: boolean): Model
	local rig = Disguises.BuildCharacter(config.Boss, config.BossWear)
	-- Big enough to spot across the runway on a phone (HEIGHT is measured on a rig this size)
	rig:ScaleTo(GameConfig.BossScale)
	rig.Name = if shadow then `{config.Boss}Shadow` else config.Boss
	rig.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	rig:AddTag("Guard") -- clients animate these (fidgets, stabs, throws)
	local humanoid = rig:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.EvaluateStateMachine = false
	for _, d in rig:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			-- CanQuery stays on so thrown knives can hit them
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	rig.PrimaryPart = root

	-- The zone's best knife, held ready
	local pool = Knives.ByRarity[config.Rarity]
	local knifeName = pool[#pool].Name
	local rightHand = rig:FindFirstChild("RightHand") :: BasePart
	local knife = KnifeModel.Build(knifeName, false)
	KnifeModel.FitLength(knife, 2.6)
	knife:PivotTo(rightHand.CFrame * CFrame.new(0, -0.3, 0) * CFrame.Angles(math.rad(-90), 0, 0))
	for _, d in knife:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = rightHand
	weld.Part1 = knife.PrimaryPart :: BasePart
	weld.Parent = knife.PrimaryPart
	knife.Name = "Knife"
	knife.Parent = rig
	rig:SetAttribute("KnifeName", knifeName)

	-- A boss aura: sparks in the zone's colour and a soft light
	local torso = rig:FindFirstChild("UpperTorso") :: BasePart?
	if torso then
		local aura = Instance.new("ParticleEmitter")
		aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		aura.Color = ColorSequence.new(config.Color, Color3.new(1, 1, 1))
		aura.LightEmission = 1
		aura.Size = NumberSequence.new(0.35, 0)
		aura.Lifetime = NumberRange.new(0.8, 1.4)
		aura.Rate = 10
		aura.Speed = NumberRange.new(1, 2.5)
		aura.SpreadAngle = Vector2.new(180, 180)
		aura.Parent = torso
		local light = Instance.new("PointLight")
		light.Color = config.Color
		light.Range = 14
		light.Brightness = 1.5
		light.Parent = torso
	end

	local head = rig:FindFirstChild("Head") :: BasePart
	-- Name + title (visible from across the zone)
	local tag = billboard(head, UDim2.fromOffset(150, 40), Vector3.new(0, 3, 0), 60)
	tag.Name = "BossTag"
	text(
		tag,
		if shadow then `{config.Boss:upper()}'S SHADOW` else config.Boss:upper(),
		config.Color:Lerp(Color3.new(1, 1, 1), 0.2),
		UDim2.fromScale(0, 0),
		UDim2.fromScale(1, 0.58)
	)
	text(tag, config.BossTitle, Color3.fromRGB(235, 230, 240), UDim2.fromScale(0, 0.58), UDim2.fromScale(1, 0.42))
	-- "!" when they start a chase
	local alert = billboard(head, UDim2.fromScale(3, 3), Vector3.new(0, 5.6, 0), 200)
	alert.Name = "Alert"
	alert.Enabled = false
	text(alert, "!", Color3.fromRGB(255, 60, 60), UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))

	if shadow then
		-- A shadow: the same person, see-through and glowing in the zone's colour
		for _, d in rig:GetDescendants() do
			if d:IsA("BasePart") and d.Transparency < 1 then
				d.Material = Enum.Material.ForceField
				d.Color = config.Color
			elseif d:IsA("Decal") then
				d.Transparency = 0.5
			elseif d:IsA("Clothing") then
				d:Destroy()
			end
		end
	end
	return rig
end

local function newGuard(boss: Boss, shadow: boolean, at: CFrame): Guard
	local model = buildRig(boss.Config, shadow)
	model:PivotTo(at)
	model.Parent = folder
	local head = model:FindFirstChild("Head") :: BasePart
	local guard: Guard = {
		Model = model,
		Zone = boss.Zone,
		Config = boss.Config,
		Boss = boss,
		IsShadow = shadow,
		Position = at.Position,
		Target = nil,
		Returning = false,
		AlertUntil = 0,
		Alert = head:FindFirstChild("Alert") :: BillboardGui,
		Dead = false,
		KnifeName = model:GetAttribute("KnifeName") :: string,
		LastAttack = 0,
		ThrowReadyAt = 0,
		WindupUntil = 0,
		BusyUntil = 0,
		StaggerImmuneUntil = 0,
		Tracks = loadTracks(model),
		Playing = nil,
		Lure = nil,
		LureUntil = 0,
		OnLureReached = nil,
	}
	guardByModel[model] = guard
	animate(guard, "Idle")
	return guard
end

-- The wall ---------------------------------------------------------------------------------------

local function clearDisplay(slot: Slot)
	if slot.Display then
		slot.Display:Destroy()
		slot.Display = nil
	end
	slot.Plaque.Color = Color3.fromRGB(40, 36, 48)
	slot.Plaque.Material = Enum.Material.SmoothPlastic
	slot.Frame.Color = Color3.fromRGB(60, 56, 70)
	slot.Prompt.Enabled = false
end

-- Puts `item` on the wall in `slot`: floating, turning, labelled, glowing in its colour
local function setSlot(boss: Boss, slot: Slot, item: string)
	clearDisplay(slot)
	slot.Item = item
	slot.Out = false
	slot.RestockAt = nil
	local parsed = Items.Parse(item)
	if not parsed then
		return
	end
	local model = KnifeModel.Build(item, true)
	KnifeModel.FitLength(model, 6)
	model:PivotTo(slot.Spot)
	local box = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + (slot.Spot.Position - box.Position))
	model:AddTag("Spin")
	model.Parent = boss.Folder
	slot.Display = model
	-- No labels: the knife itself shows what it is (walk up and the prompt names it). A soft glow
	-- in its colour from the plate under it.
	local glow = Instance.new("PointLight")
	glow.Color = Items.Color(item)
	glow.Range = 8
	glow.Brightness = 1.2
	glow.Shadows = false
	glow.Parent = model.PrimaryPart
	slot.Prompt.ObjectText = `{Items.DisplayName(item)} · +{Format.Cash(Items.Income(item))}/s`
	slot.Prompt.Enabled = true
end

local function rollItem(boss: Boss): string
	return Items.OpenCase(rng, boss.Config.Rarity, 1)
end

-- A restock worth shouting about: a strong mutation or a huge size
local function announceIfRare(boss: Boss, item: string)
	local parsed = Items.Parse(item)
	if parsed and (parsed.Mutation.Rank >= 2 or parsed.Size.Rank >= 3) then
		Net.Announce(
			`💎 A {Items.DisplayName(item)} just appeared on {boss.Name}'s wall in {boss.Config.Title}!`,
			Items.Color(item),
			2
		)
	end
end

-- The lair: a raised stage across the middle of the runway, a back wall with the knife slots on
-- pedestals and a glowing plaque behind each, the boss's name in lights, torches either side
local function buildLair(index: number, zone: MapService.Zone, config: ZoneConfig): Boss
	local lair = GameConfig.BossLair
	local center = GameConfig.BossLairCenter(index)
	-- Local frame: -Z (the frame's look) points out at the runway, where the boss looks; the side
	-- wall is behind it at +Z
	local frame = CFrame.lookAt(center, Vector3.new(0, 0, center.Z))
	ManorDecor.ClearArea(center, lair.Depth / 2 + 4, lair.Width / 2 + 4)
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	local model = Instance.new("Model")
	model.Name = `Lair{index}`
	model.Parent = folder
	local dark = config.Color:Lerp(Color3.fromRGB(40, 44, 90), 0.6)
	local W, D = lair.Width, lair.Depth
	-- The wall stands at the far end of the stage (local +Z, deeper into the zone)
	local wallZ = D / 2 - 1

	local stage = block(
		model,
		"Stage",
		Vector3.new(W, PLATFORM, D),
		at(0, PLATFORM / 2, 0),
		config.Color:Lerp(Color3.new(1, 1, 1), 0.35),
		Enum.Material.SmoothPlastic
	)
	Toy.Dress(stage, nil, 1, 4)
	local edge = block(
		model,
		"StageEdge",
		Vector3.new(W + 0.4, 0.25, 0.4),
		at(0, PLATFORM, -D / 2),
		config.Color,
		Enum.Material.Neon
	)
	edge.CanCollide = false
	Toy.DirtWall(
		block(model, "BackWall", Vector3.new(W, 18, 2), at(0, 9 + PLATFORM, wallZ), dark, Enum.Material.SmoothPlastic)
	)
	-- The boss's name in lights across the top of the wall, facing the runway
	local sign = block(
		model,
		"Sign",
		Vector3.new(W - 8, 5, 0.4),
		at(0, PLATFORM + 13.5, wallZ - 1.2),
		Color3.fromRGB(20, 16, 26)
	)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front -- the frame looks at the plaza, so Front faces the runway
	surface.CanvasSize = Vector2.new(800, 100)
	surface.LightInfluence = 0
	surface.Brightness = 0.85 -- full-bright signs, a touch softer than pure white
	surface.Parent = sign
	text(
		surface,
		`{config.Boss:upper()}'S STASH`,
		config.Color:Lerp(Color3.new(1, 1, 1), 0.25),
		UDim2.fromScale(0, 0),
		UDim2.fromScale(1, 0.7)
	)
	text(
		surface,
		`{config.BossTitle} · steal one if you dare`,
		Color3.fromRGB(230, 225, 240),
		UDim2.fromScale(0, 0.7),
		UDim2.fromScale(1, 0.3)
	)
	-- Torches at both front corners of the stage
	for _, x in { -W / 2 + 2, W / 2 - 2 } do
		block(
			model,
			"TorchPost",
			Vector3.new(0.8, 7, 0.8),
			at(x, PLATFORM + 3.5, -D / 2 + 2),
			Color3.fromRGB(40, 32, 30),
			Enum.Material.Wood
		)
		local bowl = block(
			model,
			"TorchBowl",
			Vector3.new(1.8, 0.6, 1.8),
			at(x, PLATFORM + 7.2, -D / 2 + 2),
			Color3.fromRGB(30, 28, 34),
			Enum.Material.Metal
		)
		local fire = Instance.new("Fire")
		fire.Size = 4
		fire.Heat = 7
		fire.Color = config.Color
		fire.SecondaryColor = config.Color:Lerp(Color3.new(1, 1, 1), 0.5)
		fire.Parent = bowl
		local light = Instance.new("PointLight")
		light.Color = config.Color
		light.Range = 22
		light.Brightness = 1.6
		light.Parent = bowl
	end

	local postPosition = at(0, PLATFORM + HEIGHT, -D / 2 + 2.5).Position
	local boss: Boss = {
		Index = index,
		Zone = zone,
		Config = config,
		Name = config.Boss,
		-- Front and centre on the stage, facing the runway
		Post = CFrame.lookAt(postPosition, Vector3.new(0, postPosition.Y, postPosition.Z)),
		Folder = model,
		Slots = {},
		Guard = nil :: any,
	}

	-- The wall slots: pedestals in a line in front of the wall, a glowing plaque behind each
	local count = GameConfig.BossWallSlots
	local span = W - 10
	for i = 1, count do
		local x = -span / 2 + (i - 1) * span / math.max(count - 1, 1)
		local plaque = block(
			model,
			"Plaque",
			Vector3.new(6, 9, 0.3),
			at(x, PLATFORM + 7, wallZ - 1.15),
			Color3.fromRGB(40, 36, 48)
		)
		plaque.CanCollide = false
		plaque.Transparency = 1 -- kept for the slot record; the wall stays clean
		local border = block(
			model,
			"PlaqueFrame",
			Vector3.new(6.5, 9.5, 0.2),
			at(x, PLATFORM + 7, wallZ - 1.05),
			Color3.fromRGB(60, 56, 70),
			Enum.Material.Neon
		)
		border.CanCollide = false
		border.Transparency = 1
		local pedestal = Props.Build("Pedestal", true)
		pedestal:ScaleTo(1.3)
		pedestal:PivotTo(at(x, PLATFORM, wallZ - 6))
		for _, d in pedestal:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = d.Name == "Stone"
				d.CanQuery = d.Name == "Stone"
			end
		end
		pedestal.Parent = model
		local pad = (pedestal:FindFirstChild("Stone") or pedestal.PrimaryPart) :: BasePart
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Steal"
		prompt.ObjectText = ""
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
		prompt.Enabled = false
		prompt:SetAttribute("BossSteal", true)
		prompt.Parent = pad
		table.insert(boss.Slots, {
			Index = i,
			Item = nil,
			Out = false,
			RestockAt = nil,
			Spot = at(x, PLATFORM + 5.2, wallZ - 6) * CFrame.Angles(0, 0, math.rad(28)),
			Pad = pad,
			Plaque = plaque,
			Frame = border,
			Display = nil,
			Prompt = prompt,
		})
	end
	return boss
end

-- Chasing --------------------------------------------------------------------------------------

-- The thief is still worth chasing: alive, out of a round, still carrying this boss's knife, and not
-- yet back on the plaza or in a vault (that's the safe point)
local function chaseTarget(guard: Guard): BasePart?
	local player = guard.Target
	if not player or not player.Parent or player:GetAttribute("InRound") then
		return nil
	end
	local root = rootOf(player)
	local carry = StealService.BossCarry(player)
	if not root or not carry or carry.Zone ~= guard.Boss.Index then
		return nil
	end
	if root.Position.Z < -2 or BaseService.IsInAnyBase(root.Position) then
		return nil
	end
	return root
end

local function face(guard: Guard, point: Vector3)
	local look = Vector3.new(point.X, guard.Position.Y, point.Z)
	if (look - guard.Position).Magnitude > 0.1 then
		guard.Model:PivotTo(CFrame.lookAt(guard.Position, look))
	end
end

local function stopChase(guard: Guard, escaped: boolean)
	local thief = guard.Target
	guard.Target = nil
	guard.Alert.Enabled = false
	guard.WindupUntil = 0
	guard.Model:SetAttribute("ChargeStart", nil)
	if thief and escaped and thief.Parent then
		Net.Notify(thief, `You got away from {guard.Boss.Name}!`, "good")
	end
	if guard.IsShadow then
		-- Shadows just fade out
		Net.Remotes.Effect:FireAllClients("Smoke", guard.Position)
		guardByModel[guard.Model] = nil
		guard.Model:Destroy()
		guard.Dead = true
		local i = table.find(chasers, guard)
		if i then
			table.remove(chasers, i)
		end
	else
		guard.Returning = true
	end
end

-- Someone just took a knife off the wall: the boss (or a shadow of them) comes for them
local function sendChaser(boss: Boss, thief: Player)
	local guard = boss.Guard
	if guard.Target ~= nil then
		-- Already busy with someone else: a shadow steps out of the wall
		guard = newGuard(boss, true, boss.Post)
		Net.Remotes.Effect:FireAllClients("Smoke", boss.Post.Position)
	end
	guard.Target = thief
	guard.Returning = false
	guard.AlertUntil = now() + GameConfig.GuardAlertTime
	guard.Alert.Enabled = true
	guard.ThrowReadyAt = now() + 2
	if not table.find(chasers, guard) then
		table.insert(chasers, guard)
	end
	Net.Animate(guard.Model, "Alert")
	Net.Remotes.Effect:FireClient(thief, "Alarm")
	Net.Notify(thief, `{boss.Name:upper()} IS COMING FOR YOU! Get it home!`, "bad")
end

-- Hurt a thief (throws, and the snatch). Shields block it.
local function hurt(player: Player, amount: number, from: Vector3): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = rootOf(player)
	if not character or not humanoid or not root then
		return false
	end
	local shieldUntil = character:GetAttribute("ShieldUntil")
	if type(shieldUntil) == "number" and workspace:GetServerTimeNow() < shieldUntil then
		character:SetAttribute("ShieldUntil", nil)
		Net.Remotes.Effect:FireAllClients("Shield", root.Position)
		return false
	end
	humanoid:TakeDamage(amount)
	Net.Remotes.Effect:FireAllClients("Hit", root.Position)
	Net.Remotes.Effect:FireClient(player, "Hurt", from)
	if humanoid.Health > 0 then
		Net.Animate(character, "Hurt")
	end
	return true
end

-- Caught: the knife goes back on the wall, and it hurts
local function snatch(guard: Guard, thief: Player)
	local root = rootOf(thief)
	if not root then
		return
	end
	if not hurt(thief, guard.Config.Damage * 2, guard.Position) then
		Net.Notify(thief, "Your Shield saved you - keep running!", "good")
		return
	end
	local item = StealService.ReturnToBoss(thief)
	if item then
		Net.Notify(thief, `{guard.Boss.Name} caught you and took the {Items.DisplayName(item)} back!`, "bad")
		Net.Remotes.Effect:FireClient(thief, "Damage", root.Position + Vector3.new(0, 3, 0), "CAUGHT!")
	end
	-- Thrown through the air like a rag doll (Steal An Egg style)
	local away = (root.Position - guard.Position) * Vector3.new(1, 0, 1)
	local push = (if away.Magnitude > 0.1 then away.Unit else -root.CFrame.LookVector) * 50 + Vector3.new(0, 50, 0)
	Ragdoll.Tumble(thief, push, 1.6)
	stopChase(guard, false)
end

-- Thrown knives (Epic+ bosses): aimed where the thief is heading, curving after them a little
local function throwAt(guard: Guard, aim: Vector3, target: Player)
	local hand = guard.Model:FindFirstChild("RightHand") :: BasePart?
	local origin = if hand then hand.Position else guard.Position + Vector3.new(0, 1, 0)
	local config = GameConfig.GuardThrow
	-- Lead the target: where they'll be by the time the knife gets there
	local targetRoot = rootOf(target)
	if targetRoot then
		local velocity = targetRoot.AssemblyLinearVelocity
		local flight = (targetRoot.Position - origin).Magnitude / config.Speed
		aim = targetRoot.Position + Vector3.new(velocity.X, 0, velocity.Z) * flight * config.Lead
	end
	local flat = Vector3.new(aim.X - origin.X, 0, aim.Z - origin.Z)
	if flat.Magnitude < 0.1 then
		return
	end
	local model = KnifeModel.Build(guard.KnifeName, true)
	KnifeModel.FitLength(model, 2.6)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
		elseif d:IsA("Trail") then
			d.Enabled = true
		end
	end
	model.Parent = projectileFolder
	table.insert(projectiles, {
		Model = model,
		Position = origin,
		Direction = flat.Unit,
		Traveled = 0,
		Damage = guard.Config.Damage,
		Target = target,
	})
	Net.Remotes.Effect:FireAllClients("Dash", origin)
end

local function stepProjectiles(dt: number)
	local config = GameConfig.GuardThrow
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { projectileFolder, folder }
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		-- Curve gently towards the thief (capped turn rate, so a sharp sidestep still dodges it)
		local chasing = rootOf(p.Target)
		if chasing then
			local want = Vector3.new(chasing.Position.X - p.Position.X, 0, chasing.Position.Z - p.Position.Z)
			if want.Magnitude > 0.5 then
				want = want.Unit
				local angle = math.acos(math.clamp(p.Direction:Dot(want), -1, 1))
				-- Only while it's still coming at them (no U-turns once it has flown past)
				if angle > 1e-3 and angle < math.rad(100) then
					local turn = math.min(1, config.TurnRate * dt / angle)
					p.Direction = p.Direction:Lerp(want, turn).Unit
				end
			end
		end
		local stepLength = config.Speed * dt
		local nextPosition = p.Position + p.Direction * stepLength
		local done = false
		local hit = workspace:Raycast(p.Position, nextPosition - p.Position, params)
		local wall = false
		if hit and not Players:GetPlayerFromCharacter(hit.Instance:FindFirstAncestorOfClass("Model")) then
			nextPosition = hit.Position
			done = true
			wall = true
		end
		local root = rootOf(p.Target)
		if root then
			local ab = nextPosition - p.Position
			local t = math.clamp((root.Position - p.Position):Dot(ab) / math.max(ab:Dot(ab), 1e-6), 0, 1)
			if (root.Position - (p.Position + ab * t)).Magnitude < config.HitRadius + 1 then
				-- A knife in the back knocks you flying (and costs you ground, not the knife)
				if hurt(p.Target, p.Damage, p.Position) then
					Ragdoll.Tumble(p.Target, p.Direction * 45 + Vector3.new(0, 40, 0), 1)
				end
				done = true
			end
		end
		p.Position = nextPosition
		p.Traveled += stepLength
		if wall and done and hit then
			-- Missed and hit a wall: it sticks there for a minute
			StuckKnives.Stick(p.Model, hit.Position, p.Direction, 60)
			table.remove(projectiles, i)
		elseif done or p.Traveled > config.FlightRange then
			p.Model:Destroy()
			table.remove(projectiles, i)
		else
			local spin = p.Traveled * 0.5
			p.Model:PivotTo(CFrame.lookAt(p.Position, p.Position + p.Direction) * CFrame.Angles(-spin, 0, 0))
		end
	end
end

-- One step towards `destination`; true once there
local function moveTowards(guard: Guard, destination: Vector3, speed: number, dt: number): boolean
	local offset = Vector3.new(destination.X - guard.Position.X, 0, destination.Z - guard.Position.Z)
	local distance = offset.Magnitude
	if distance < 0.3 then
		return true
	end
	local arena = MapService.Arena :: MapService.Bounds
	local stepLength = math.min(distance, speed * dt)
	local nextPos = guard.Position + offset.Unit * stepLength
	-- On the lair stage they stand a little higher than on the runway
	local lair = GameConfig.BossLairCenter(guard.Boss.Index)
	local onStage = math.abs(nextPos.X - lair.X) < GameConfig.BossLair.Depth / 2
		and math.abs(nextPos.Z - lair.Z) < GameConfig.BossLair.Width / 2
	local y = HEIGHT + (if onStage then PLATFORM else 0)
	nextPos = Vector3.new(
		math.clamp(nextPos.X, arena.MinX + 2, arena.MaxX - 2),
		y,
		math.clamp(nextPos.Z, arena.MinZ - 4, arena.MaxZ - 2)
	)
	-- A Barricade in the way: stop and smash it
	local obstacle = Obstacles.Blocks(guard.Position, nextPos, 1.5)
	if obstacle then
		face(guard, obstacle.Part.Position)
		animate(guard, "Idle")
		local t = now()
		if t - guard.LastAttack >= GameConfig.GuardAttackCooldown then
			guard.LastAttack = t
			Net.Animate(guard.Model, "GuardStab")
			guard.BusyUntil = t + 0.6
			task.delay(AnimLibrary.Clips.GuardStab.Impact or 0.3, function()
				if obstacle.Part.Parent then
					obstacle.Hit("Guard")
				end
			end)
		end
		return false
	end
	guard.Position = nextPos
	guard.Model:PivotTo(CFrame.lookAt(nextPos, nextPos + offset))
	if speed > GameConfig.GuardPatrolSpeed then
		animate(guard, "Run", speed / 16)
	else
		animate(guard, "Walk", speed / 10)
	end
	return false
end

local function step(guard: Guard, dt: number)
	local t = now()
	if t < guard.BusyUntil then
		animate(guard, "Idle")
		return
	end

	-- Walking back to the post after a chase
	if guard.Returning then
		if moveTowards(guard, guard.Boss.Post.Position, guard.Config.GuardSpeed * 0.6, dt) then
			guard.Returning = false
			guard.Position = guard.Boss.Post.Position
			guard.Model:PivotTo(guard.Boss.Post)
			animate(guard, "Idle")
			local i = table.find(chasers, guard)
			if i then
				table.remove(chasers, i)
			end
		end
		return
	end

	-- A Decoy pulls them off course until it's caught
	local lure = guard.Lure
	if lure and (t > guard.LureUntil or not lure.Parent) then
		guard.Lure = nil
		lure = nil
	end
	if lure then
		if (lure.Position - guard.Position).Magnitude <= GameConfig.GuardAttackRange then
			guard.Lure = nil
			Net.Animate(guard.Model, "GuardStab")
			guard.BusyUntil = t + 0.5
			local reached = guard.OnLureReached
			guard.OnLureReached = nil
			if reached then
				reached()
			end
		else
			moveTowards(guard, lure.Position, guard.Config.GuardSpeed, dt)
		end
		return
	end

	local thief = guard.Target
	local targetRoot = chaseTarget(guard)
	if not thief or not targetRoot then
		stopChase(guard, thief ~= nil and thief.Parent ~= nil and StealService.BossCarry(thief) == nil)
		return
	end

	-- Vanished: they've lost sight of you and stand there searching until you reappear. Disguised
	-- as furniture (Mimic) works the same, unless you come close enough for them to see through it.
	local gap = ((targetRoot.Position - guard.Position) * Vector3.new(1, 0, 1)).Magnitude
	if thief:GetAttribute("Invisible") or (thief:GetAttribute("Mimic") and gap > GameConfig.MimicSpotRange) then
		guard.Alert.Enabled = false
		animate(guard, "Idle")
		return
	end

	-- The "!" beat: a fair head start
	if t < guard.AlertUntil then
		face(guard, targetRoot.Position)
		animate(guard, "Idle")
		return
	end
	guard.Alert.Enabled = false

	-- Winding up a throw: they keep running at you while the arm cranks back, and let go
	-- mid-stride (never stopping, so throwing never costs them ground)
	if guard.WindupUntil > 0 and t >= guard.WindupUntil then
		guard.WindupUntil = 0
		guard.Model:SetAttribute("ChargeStart", nil)
		local aim = targetRoot.Position
		Net.Animate(guard.Model, "Throw")
		task.delay(AnimLibrary.Clips.Throw.Release or 0.07, function()
			if not guard.Dead then
				throwAt(guard, aim, thief)
			end
		end)
	end

	local distance = ((targetRoot.Position - guard.Position) * Vector3.new(1, 0, 1)).Magnitude
	if distance <= GameConfig.CatchRadius then
		-- Grab! They swing without stopping (stopping let a runner slip away every time) and it
		-- counts if you're still within arm's reach when the blow lands
		if t - guard.LastAttack >= GameConfig.GuardAttackCooldown * 0.6 then
			guard.LastAttack = t
			local clip = AnimLibrary.Clips.GuardStab
			Net.Animate(guard.Model, "GuardStab")
			local model = guard.Model
			task.delay(clip.Impact or 0.3, function()
				if guard.Dead or guard.Model ~= model or guard.Target ~= thief then
					return
				end
				local root = chaseTarget(guard)
				local reach = if root
					then ((root.Position - guard.Position) * Vector3.new(1, 0, 1)).Magnitude
					else math.huge
				if root and reach <= GameConfig.CatchRadius + 4 then
					snatch(guard, thief)
				end
			end)
		end
		moveTowards(guard, targetRoot.Position, guard.Config.GuardSpeed, dt)
		return
	end
	local throwConfig = GameConfig.GuardThrow
	if
		guard.Config.Throws
		and guard.WindupUntil == 0
		and t >= guard.ThrowReadyAt
		and distance > throwConfig.MinRange
		and distance < throwConfig.MaxRange
	then
		guard.WindupUntil = t + throwConfig.Windup
		guard.ThrowReadyAt = guard.WindupUntil + throwConfig.Cooldown
		guard.Model:SetAttribute("ChargeTime", throwConfig.Windup)
		guard.Model:SetAttribute("ChargeStart", workspace:GetServerTimeNow())
	end
	moveTowards(guard, targetRoot.Position, guard.Config.GuardSpeed, dt)
end

-- Stealing -----------------------------------------------------------------------------------------

local function onSteal(player: Player, boss: Boss, slot: Slot)
	local item = slot.Item
	local root = rootOf(player)
	if not item or slot.Out or not root or player:GetAttribute("InRound") or StealService.IsCarrying(player) then
		return
	end
	if (root.Position - slot.Pad.Position).Magnitude > 14 then
		return
	end
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	if #profile.Knives >= profile.Slots then
		Net.Notify(player, "Your vault wall is full! Sell a knife or add a mount first.", "bad")
		return
	end
	slot.Item = nil
	slot.Out = true
	clearDisplay(slot)
	StealService.StartCarry(player, "Knife", item, nil, { Zone = boss.Index, Slot = slot.Index })
	sendChaser(boss, player)
end

-- A stolen boss knife left its thief's hands (StealService): back on the wall, or delivered
local function onBossCarryEnded(zone: number, slotIndex: number, item: string, delivered: boolean)
	local boss = bosses[zone]
	local slot = boss and boss.Slots[slotIndex]
	if not boss or not slot then
		return
	end
	if delivered then
		slot.Out = false
		local rush = ServerEvents.Active("CosmicRush") and boss.Index > #GameConfig.Zones / 2
		slot.RestockAt = now() + boss.Config.Restock * (if rush then 0.1 else 1)
	else
		setSlot(boss, slot, item)
	end
end

-- API used by powers, combat and raids ------------------------------------------------------------

function GuardService.RootHeight(): number
	return PERSON_HEIGHT
end

-- Every boss and every chasing shadow (Radar, traps, Flash and Decoy look through these)
function GuardService.All(): { Guard }
	local list = {}
	for _, boss in bosses do
		table.insert(list, boss.Guard)
	end
	for _, guard in chasers do
		if guard.IsShadow and not guard.Dead then
			table.insert(list, guard)
		end
	end
	return list
end

-- Bear Trap / Flash: frozen in place for a while (only matters mid-chase)
function GuardService.Stun(guard: Guard, seconds: number)
	if guard.Dead or not guard.Target then
		return
	end
	guard.BusyUntil = math.max(guard.BusyUntil, now() + seconds)
	guard.WindupUntil = 0
	guard.Model:SetAttribute("ChargeStart", nil)
	Net.Animate(guard.Model, "GuardHurt")
end

-- Decoy: whoever is chasing `owner` chases the decoy instead until it's caught
function GuardService.Lure(owner: Player, part: BasePart, duration: number, onReached: () -> ())
	for _, guard in chasers do
		if guard.Target == owner and not guard.Dead then
			guard.Lure = part
			guard.LureUntil = now() + duration
			guard.OnLureReached = onReached
		end
	end
end

function GuardService.FromPart(part: Instance): Guard?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local guard = guardByModel[model]
		if guard then
			return guard
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function GuardService.InReach(position: Vector3, look: Vector3, range: number): Guard?
	local best, bestDist = nil, range
	for _, guard in GuardService.All() do
		local offset = guard.Position - position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local dist = flat.Magnitude
		local facing = if dist > 0.1 then look:Dot(flat.Unit) else 1
		if dist < bestDist and facing > -0.1 then
			best, bestDist = guard, dist
		end
	end
	return best
end

-- Hit by a hub knife (swing or throw). A chaser staggers - longer for better knives, with a short
-- immunity after so nobody can lock one down forever. A boss at their post just ignores you.
-- What a boss shouts when you hit them (floating text over their head, for the attacker)
local QUIPS = {
	Idle = { "Ow! Rude!", "That tickles!", "HEY!", "Not the face!", "Is that all?", "Go steal something!" },
	Stagger = { "OOF!", "ARGH!", "Lucky shot!", "You'll pay for that!", "Grr...!", "OUCH!", "My knees!" },
	Resist = { "Ha! Too slow!", "Nice try!", "Missed me!", "Not again!" },
}
local function quip(guard: Guard, attacker: Player?, kind: string, extra: string?)
	if not attacker then
		return
	end
	local lines = QUIPS[kind]
	local line = lines[rng:NextInteger(1, #lines)]
	Net.Remotes.Effect:FireClient(
		attacker,
		"Damage",
		guard.Position + Vector3.new(0, 3 * GameConfig.BossScale, 0),
		if extra then `{line} {extra}` else line
	)
end

function GuardService.Damage(guard: Guard, amount: number, attacker: Player?)
	if guard.Dead then
		return
	end
	local head = guard.Model:FindFirstChild("Head") :: BasePart?
	Net.Remotes.Effect:FireAllClients("Hit", if head then head.Position else guard.Position)
	if not guard.Target then
		quip(guard, attacker, "Idle")
		if attacker and now() - (idleHitNotice[attacker] or 0) > 20 then
			idleHitNotice[attacker] = now()
			Net.Notify(attacker, `{guard.Boss.Name} doesn't care. Steal a knife off the wall... if you dare!`, "info")
		end
		return
	end
	local t = now()
	if t < guard.StaggerImmuneUntil then
		quip(guard, attacker, "Resist")
		return
	end
	local seconds = math.clamp(amount / guard.Config.Health * 3, 0.3, 2.2)
	guard.BusyUntil = math.max(guard.BusyUntil, t + seconds)
	guard.StaggerImmuneUntil = t + seconds + 0.8
	guard.WindupUntil = 0
	guard.Model:SetAttribute("ChargeStart", nil)
	Net.Animate(guard.Model, "GuardHurt")
	if attacker then
		quip(guard, attacker, "Stagger", string.format("(%.1fs)", seconds))
		-- Knocked back a step, away from whoever hit them
		local attackerRoot = rootOf(attacker)
		if attackerRoot then
			local away = (guard.Position - attackerRoot.Position) * Vector3.new(1, 0, 1)
			if away.Magnitude > 0.1 then
				guard.Position += away.Unit * 2
				guard.Model:PivotTo(CFrame.lookAt(guard.Position, guard.Position - away))
			end
		end
	end
end

-- Init ---------------------------------------------------------------------------------------------

function GuardService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Guards"
	folder.Parent = workspace:FindFirstChild("Map")
	projectileFolder = Instance.new("Folder")
	projectileFolder.Name = "GuardKnives"
	projectileFolder.Parent = workspace:FindFirstChild("Map")

	-- How high a rig's root sits so feet touch the floor
	local probe = Disguises.BuildCharacter("Frank")
	local function rootHeight(): number
		local probeHumanoid = probe:FindFirstChildOfClass("Humanoid") :: Humanoid
		return probeHumanoid.HipHeight + (probe:FindFirstChild("HumanoidRootPart") :: BasePart).Size.Y / 2
	end
	PERSON_HEIGHT = rootHeight()
	probe:ScaleTo(GameConfig.BossScale)
	HEIGHT = rootHeight()
	probe:Destroy()

	for i, config in GameConfig.Zones do
		local zone = MapService.Zones[i]
		local boss = buildLair(i, zone, config :: any)
		boss.Guard = newGuard(boss, false, boss.Post)
		bosses[i] = boss
		for _, slot in boss.Slots do
			setSlot(boss, slot, rollItem(boss))
			local thisSlot = slot
			slot.Prompt.Triggered:Connect(function(player)
				onSteal(player, boss, thisSlot)
			end)
		end
	end

	StealService.OnBossCarryEnded = onBossCarryEnded

	-- Restocks, once a second
	task.spawn(function()
		while true do
			task.wait(1)
			local t = now()
			for _, boss in bosses do
				for _, slot in boss.Slots do
					if slot.RestockAt and t >= slot.RestockAt and not slot.Item and not slot.Out then
						local item = rollItem(boss)
						setSlot(boss, slot, item)
						Net.Remotes.Effect:FireAllClients("Smoke", slot.Spot.Position)
						announceIfRare(boss, item)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		idleHitNotice[player] = nil
	end)

	-- Only chasers think; a boss at their post just stands there (the client fidgets them)
	RunService.Heartbeat:Connect(function(dt: number)
		for i = #chasers, 1, -1 do
			local guard = chasers[i]
			if guard and not guard.Dead then
				step(guard, dt)
			end
		end
		stepProjectiles(dt)
	end)
end

return GuardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
-- The knife menu: pick which owned knife you bring into rounds as the Murderer, and sell knives
-- off the rack to make room for better ones. Clients send a name or a rack index; the server
-- checks ownership against the profile.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)

local InventoryService = {}

local lastRequest: { [Player]: number } = {}

local function throttled(player: Player): boolean
	local now = os.clock()
	if now - (lastRequest[player] or 0) < 0.3 then
		return true
	end
	lastRequest[player] = now
	return false
end

function InventoryService.SellPrice(item: string): number
	return math.floor(Items.Income(item) * GameConfig.SellSeconds)
end

local function equip(player: Player, name: unknown): boolean
	local profile = DataService.Get(player)
	if not profile or type(name) ~= "string" or throttled(player) then
		return false
	end
	if player:GetAttribute("InRound") then
		Net.Notify(player, "You can't switch knives during a round", "bad")
		return false
	end
	if name ~= "" and not table.find(profile.Knives, name) then
		return false
	end
	DataService.Update(player, function(p)
		p.Equipped = name
	end)
	-- The knife flies off its plate into your hand, with a flourish (client Effects "Equipped")
	local base = BaseService.GetBase(player)
	local index = if name ~= "" then table.find(profile.Knives, name) else nil
	local slot = if index then DataService.PlateOf(profile, index) else nil
	local from = if base and slot and base.SlotCFrames[slot] then base.SlotCFrames[slot].Position else nil
	if name ~= "" then
		Net.Remotes.Effect:FireAllClients("Equipped", player, name, from)
		if player.Character then
			Net.Animate(player.Character, "Draw")
		end
	end
	Net.Notify(
		player,
		if name ~= "" then `{Items.DisplayName(name)} equipped!` else "Auto-equip: your best knife",
		"good"
	)
	-- ...and what it gives you when you're the Murderer
	local parsed = if name ~= "" then Items.Parse(name) else nil
	local perk = parsed and parsed.Perk and GameConfig.Perks[parsed.Perk]
	if perk then
		Net.Notify(player, `🔪 As the Murderer: {perk.DisplayName} - {perk.Description}`, "info")
	end
	return true
end

local function sell(player: Player, index: unknown): boolean
	local profile = DataService.Get(player)
	if not profile or type(index) ~= "number" or throttled(player) then
		return false
	end
	local name = profile.Knives[index]
	if not name or index % 1 ~= 0 then
		return false
	end
	local price = InventoryService.SellPrice(name)
	DataService.Update(player, function(p)
		DataService.RemoveKnife(p, index)
		p.Cash += price
		if p.Equipped == name and not table.find(p.Knives, name) then
			p.Equipped = ""
		end
	end)
	BaseService.RefreshRack(player)
	Net.Notify(player, `Sold {Items.DisplayName(name)} for {Format.Cash(price)}`, "good")
	return true
end

function InventoryService.Init()
	Net.Remotes.Equip.OnServerInvoke = equip
	Net.Remotes.Sell.OnServerInvoke = sell
	BaseService.OnSellPrompt = function(player, slot)
		sell(player, slot)
	end
	BaseService.OnEquipPrompt = function(player, name)
		equip(player, name)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ManorDecor</string>
            <string name="Source"><![CDATA[--!strict
-- Blackwood Manor's toy island, laid out as one long runway. Each zone has a distinct
-- palette and small square-built scenery, with clear routes and readable landmarks:
--   The Courtyard (green)  hedges, a fountain, benches, lanterns
--   The Gardens   (blue)   glowing flowers, a pond, a gazebo, topiary
--   The Crypts    (purple) gravestones, mausoleums, dead trees
--   The Catacombs (gold)   pillars, candelabras, torches, urns
--   The Inferno   (orange) lava pools, obsidian spires, fire vents
--   Mount Olympus (pink)   a marble temple, gold god statues, columns, braziers
--   The Heavens   (cyan)   clouds, angel statues, light shafts, the pearly gates
--   Outer Space   (violet) planets in the sky, asteroids, crystals, stars
-- Plus wall sconces all the way down, a stone arch and title at every zone, the events board
-- over the entrance, the plaza and its giant Void Edge. Purely cosmetic: MapService owns gameplay.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Props = require(ReplicatedStorage.Shared.Props)
local Toy = require(ReplicatedStorage.Shared.Toy)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)

local ManorDecor = {}

export type Bounds = { MinX: number, MaxX: number, MinZ: number, MaxZ: number }

local IRON = Color3.fromRGB(28, 28, 34)
local DARK_STONE = Color3.fromRGB(62, 60, 72)
local BARK = Color3.fromRGB(52, 42, 38)
local WINDOW = Color3.fromRGB(255, 205, 120)

local folder: Folder
local rng = Random.new(1337)

local function block(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end

-- Walk-through decoration (keeps the runway clear and saves physics work)
local function ghost(p: Part): Part
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function ball(p: Part): Part
	p.Shape = Enum.PartType.Ball
	return p
end

-- A cylinder standing upright (Roblox cylinders lie along X)
local function cylinderUp(p: Part): Part
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = p.CFrame * CFrame.Angles(0, 0, math.rad(90))
	return p
end

local function glow(p: BasePart, color: Color3, range: number, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1.2
	light.Shadows = false
	light.Parent = p
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

-- Shared pieces -------------------------------------------------------------------------------

-- A lantern on an iron bracket, bolted to the runway wall (facing = -1 left wall, 1 right wall)
-- A Blender lantern hanging off an iron bracket on the runway wall, glowing in the zone's colour
local function prop(name: string, cframe: CFrame, scale: number?, recolor: { [string]: Color3 }?): Model
	local model = Props.Build(name, true)
	if scale then
		model:ScaleTo(scale)
	end
	model:PivotTo(cframe)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			if recolor and recolor[d.Name] then
				d.Color = recolor[d.Name]
			end
		end
	end
	model.Parent = folder
	return model
end

local function detail(name: string, cframe: CFrame, scale: number?, recolor: { [string]: Color3 }?): Model?
	if not Props.Has(name) then
		return nil
	end
	local model = prop(name, cframe, scale, recolor)
	model:SetAttribute("MapDetail", true)
	return model
end

-- A blocky cartoon bush (Steal An Egg style): a couple of stacked stud-covered green blocks
local function bush(position: Vector3, scale: number?)
	local k = scale or 1
	local green = Toy.Grass:Lerp(Color3.new(0, 0, 0), 0.12 + rng:NextNumber(0, 0.08))
	local w = rng:NextNumber(5, 8) * k
	local d = rng:NextNumber(4, 6) * k
	local h = rng:NextNumber(3, 4) * k
	local turn = CFrame.Angles(0, math.rad(rng:NextInteger(0, 3) * 90), 0)
	local base = block("Bush", Vector3.new(w, h, d), CFrame.new(position + Vector3.new(0, h / 2, 0)) * turn, green)
	Toy.Dress(base, Toy.Sides, 1, 0)
	local top = block(
		"Bush",
		Vector3.new(w * 0.6, h * 0.8, d * 0.7),
		CFrame.new(position + Vector3.new(rng:NextNumber(-1, 1) * k, h + h * 0.4, 0)) * turn,
		green:Lerp(Color3.new(1, 1, 1), 0.05)
	)
	Toy.Dress(top, Toy.Sides, 1, 0)
end

local function sconce(_x: number, _z: number, _facing: number, _color: Color3)
	-- (daytime: no wall lanterns)
end

local function torch(position: Vector3, color: Color3?)
	block("TorchPost", Vector3.new(0.5, 4, 0.5), CFrame.new(position + Vector3.new(0, 2, 0)), BARK, Enum.Material.Wood)
	local head = ghost(
		block(
			"TorchHead",
			Vector3.new(0.8, 0.8, 0.8),
			CFrame.new(position + Vector3.new(0, 4.3, 0)),
			IRON,
			Enum.Material.Metal
		)
	)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = color or Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
	fire.Parent = head
	glow(head, color or Color3.fromRGB(255, 150, 70), 20, 1.5)
end

local function streetLamp(position: Vector3)
	local model = detail("DetailLamp", CFrame.new(position))
	if model then
		local glass = model:FindFirstChild("Glass")
		if glass and glass:IsA("BasePart") then
			glow(glass, WINDOW, 18, 0.6)
		end
		return
	end
	ghost(block("LampPost", Vector3.new(0.45, 8, 0.45), CFrame.new(position + Vector3.new(0, 4, 0)), IRON))
	local lamp = ghost(
		block(
			"Lantern",
			Vector3.new(1.2, 1.6, 1.2),
			CFrame.new(position + Vector3.new(0, 8.3, 0)),
			WINDOW,
			Enum.Material.Neon
		)
	)
	glow(lamp, WINDOW, 18, 0.6)
end

-- Fireflies drifting over a stretch of ground, and a low mist rolling along it
local function fireflies(_center: Vector3, _size: Vector3, _color: Color3, _rate: number)
	-- (daytime: no fireflies)
end

local function mist(_center: Vector3, _size: Vector3, _color: Color3)
	-- (daytime: no mist)
end

-- Biome props ---------------------------------------------------------------------------------

local function hedge(position: Vector3, length: number)
	for x = -length / 2 + 3, length / 2 - 3, 7 do
		bush(position + Vector3.new(x, 0, 0), 0.9)
	end
end

local function fountain(position: Vector3)
	if detail("DetailFountain", CFrame.new(position)) then
		return
	end
	ghost(
		block(
			"FountainBasin",
			Vector3.new(12, 0.8, 12),
			CFrame.new(position + Vector3.new(0, 0.4, 0)),
			Color3.fromRGB(184, 199, 213)
		)
	)
	ghost(
		block(
			"FountainWater",
			Vector3.new(10, 0.12, 10),
			CFrame.new(position + Vector3.new(0, 0.87, 0)),
			Color3.fromRGB(82, 211, 242)
		)
	)
	ghost(
		block(
			"FountainColumn",
			Vector3.new(1, 5, 1),
			CFrame.new(position + Vector3.new(0, 3, 0)),
			Color3.fromRGB(239, 247, 251)
		)
	)
end

local function bench(position: Vector3, rotation: number)
	local cf = CFrame.new(position) * CFrame.Angles(0, rotation, 0)
	if detail("DetailBench", cf) then
		return
	end
	ghost(block("BenchSeat", Vector3.new(6.5, 0.3, 1.8), cf * CFrame.new(0, 1.7, 0), Color3.fromRGB(181, 99, 56)))
	ghost(block("BenchBack", Vector3.new(6.5, 1.4, 0.3), cf * CFrame.new(0, 2.7, 0.8), Color3.fromRGB(181, 99, 56)))
end

local function glowFlower(position: Vector3, color: Color3)
	ghost(
		block(
			"Stem",
			Vector3.new(0.2, 1.6, 0.2),
			CFrame.new(position + Vector3.new(0, 0.8, 0)),
			Color3.fromRGB(40, 110, 60)
		)
	)
	ball(
		ghost(
			block("Bloom", Vector3.one * 0.9, CFrame.new(position + Vector3.new(0, 1.8, 0)), color, Enum.Material.Neon)
		)
	)
end

local function topiary(position: Vector3)
	if detail("DetailTopiary", CFrame.new(position)) then
		return
	end
	cylinderUp(
		block(
			"TopiaryPot",
			Vector3.new(1.6, 2.4, 2.4),
			CFrame.new(position + Vector3.new(0, 0.8, 0)),
			Color3.fromRGB(150, 85, 55)
		)
	)
	for i, size in { 3.6, 2.8, 1.8 } do
		ball(
			block(
				"Topiary",
				Vector3.one * size,
				CFrame.new(position + Vector3.new(0, 1 + i * 2.2, 0)),
				Color3.fromRGB(50, 130, 120),
				Enum.Material.Grass
			)
		)
	end
end

local function gazebo(position: Vector3)
	if detail("DetailGazebo", CFrame.new(position)) then
		return
	end
	local white = Color3.fromRGB(225, 225, 235)
	cylinderUp(
		block(
			"GazeboFloor",
			Vector3.new(0.6, 16, 16),
			CFrame.new(position + Vector3.new(0, 0.3, 0)),
			white,
			Enum.Material.Marble
		)
	)
	for i = 0, 5 do
		local angle = i * math.pi / 3
		block(
			"GazeboPost",
			Vector3.new(0.6, 9, 0.6),
			CFrame.new(position + Vector3.new(math.cos(angle) * 7, 4.8, math.sin(angle) * 7)),
			white,
			Enum.Material.Marble
		)
	end
	for i = 1, 4 do
		local s = 18 - i * 3.6
		cylinderUp(
			block(
				"GazeboRoof",
				Vector3.new(1, s, s),
				CFrame.new(position + Vector3.new(0, 9 + i * 0.9, 0)),
				Color3.fromRGB(60, 110, 170),
				Enum.Material.Slate
			)
		)
	end
	local lamp = ball(
		ghost(
			block(
				"GazeboLamp",
				Vector3.one * 1.4,
				CFrame.new(position + Vector3.new(0, 7.5, 0)),
				Color3.fromRGB(140, 210, 255),
				Enum.Material.Neon
			)
		)
	)
	glow(lamp, Color3.fromRGB(120, 200, 255), 26, 1.6)
end

local function pond(position: Vector3, sizeX: number, sizeZ: number)
	local water = ghost(
		block(
			"Pond",
			Vector3.new(sizeX, 0.2, sizeZ),
			CFrame.new(position + Vector3.new(0, 0.15, 0)),
			Color3.fromRGB(40, 110, 200),
			Enum.Material.Glass
		)
	)
	water.Transparency = 0.2
	for _ = 1, 4 do
		local offset = Vector3.new(
			rng:NextNumber(-sizeX / 2 + 1, sizeX / 2 - 1),
			0.3,
			rng:NextNumber(-sizeZ / 2 + 1, sizeZ / 2 - 1)
		)
		cylinderUp(
			ghost(
				block("LilyPad", Vector3.new(0.1, 1.6, 1.6), CFrame.new(position + offset), Color3.fromRGB(70, 170, 90))
			)
		)
	end
end

local function gravestone(position: Vector3)
	local tilt = CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(-0.4, 0.4), rng:NextNumber(-0.1, 0.1))
	local base = CFrame.new(position) * tilt
	if detail("DetailGravestone", base) then
		return
	end
	local color = Color3.fromRGB(120, 110, 140)
	block("Gravestone", Vector3.new(2.4, 3, 0.6), base * CFrame.new(0, 1.5, 0), color, Enum.Material.Slate)
	local top = block(
		"GravestoneTop",
		Vector3.new(0.6, 2.4, 2.4),
		base * CFrame.new(0, 3, 0) * CFrame.Angles(0, math.rad(90), 0),
		color,
		Enum.Material.Slate
	)
	top.Shape = Enum.PartType.Cylinder
end

local function mausoleum(position: Vector3, facing: number)
	local cf = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	if detail("DetailMausoleum", cf) then
		return
	end
	block(
		"Mausoleum",
		Vector3.new(10, 9, 10),
		cf * CFrame.new(0, 4.5, 0),
		Color3.fromRGB(90, 70, 120),
		Enum.Material.Slate
	)
	block("MausoleumRoof", Vector3.new(12, 1.5, 12), cf * CFrame.new(0, 9.75, 0), DARK_STONE, Enum.Material.Slate)
	block(
		"MausoleumDoor",
		Vector3.new(3.5, 6, 0.3),
		cf * CFrame.new(0, 3, -5.1),
		Color3.fromRGB(30, 20, 40),
		Enum.Material.Wood
	)
	local eye = ghost(
		block(
			"MausoleumLight",
			Vector3.new(4, 0.6, 0.3),
			cf * CFrame.new(0, 7, -5.15),
			Color3.fromRGB(190, 120, 255),
			Enum.Material.Neon
		)
	)
	glow(eye, Color3.fromRGB(180, 110, 255), 24, 1.6)
end

local function deadTree(position: Vector3)
	local height = rng:NextNumber(10, 15)
	local base = CFrame.new(position)
		* CFrame.Angles(rng:NextNumber(-0.1, 0.1), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.1, 0.1))
	block("Trunk", Vector3.new(1.4, height, 1.4), base * CFrame.new(0, height / 2, 0), BARK, Enum.Material.Wood)
	for i = 1, rng:NextInteger(3, 5) do
		local length = rng:NextNumber(3, 6)
		local branch = base
			* CFrame.new(0, height * rng:NextNumber(0.45, 0.95), 0)
			* CFrame.Angles(0, i * 2.1, 0)
			* CFrame.Angles(0, 0, math.rad(rng:NextNumber(35, 65)))
			* CFrame.new(0, length / 2, 0)
		ghost(block("Branch", Vector3.new(0.6, length, 0.6), branch, BARK, Enum.Material.Wood))
	end
end

local function pillar(position: Vector3)
	if
		detail(
			"DetailColumn",
			CFrame.new(position),
			nil,
			{ Stone = Color3.fromRGB(188, 165, 119), Flutes = Color3.fromRGB(222, 204, 158) }
		)
	then
		return
	end
	local gold = Color3.fromRGB(200, 160, 70)
	block(
		"Pillar",
		Vector3.new(3, 22, 3),
		CFrame.new(position + Vector3.new(0, 11, 0)),
		Color3.fromRGB(150, 130, 100),
		Enum.Material.Marble
	)
	block(
		"PillarBase",
		Vector3.new(4, 1.2, 4),
		CFrame.new(position + Vector3.new(0, 0.6, 0)),
		gold,
		Enum.Material.Metal
	)
	block("PillarCap", Vector3.new(4, 1.2, 4), CFrame.new(position + Vector3.new(0, 22, 0)), gold, Enum.Material.Metal)
end

local function candelabra(position: Vector3)
	local gold = Color3.fromRGB(230, 185, 70)
	block(
		"CandelabraStem",
		Vector3.new(0.5, 6, 0.5),
		CFrame.new(position + Vector3.new(0, 3, 0)),
		gold,
		Enum.Material.Metal
	)
	block(
		"CandelabraArm",
		Vector3.new(4, 0.4, 0.4),
		CFrame.new(position + Vector3.new(0, 5.5, 0)),
		gold,
		Enum.Material.Metal
	)
	for _, x in { -1.8, 0, 1.8 } do
		ghost(
			block(
				"Candle",
				Vector3.new(0.4, 1, 0.4),
				CFrame.new(position + Vector3.new(x, 6.3, 0)),
				Color3.fromRGB(250, 240, 220)
			)
		)
		ghost(
			block(
				"Flame",
				Vector3.new(0.3, 0.5, 0.3),
				CFrame.new(position + Vector3.new(x, 7, 0)),
				Color3.fromRGB(255, 200, 80),
				Enum.Material.Neon
			)
		)
	end
	local light = ghost(block("CandelabraLight", Vector3.one * 0.2, CFrame.new(position + Vector3.new(0, 7, 0)), gold))
	light.Transparency = 1
	glow(light, Color3.fromRGB(255, 200, 100), 24, 1.6)
end

local function urn(position: Vector3)
	local gold = Color3.fromRGB(210, 170, 70)
	ball(
		block(
			"Urn",
			Vector3.new(2.6, 3.2, 2.6),
			CFrame.new(position + Vector3.new(0, 1.8, 0)),
			gold,
			Enum.Material.Metal
		)
	)
	block("UrnNeck", Vector3.new(1.2, 1, 1.2), CFrame.new(position + Vector3.new(0, 3.6, 0)), gold, Enum.Material.Metal)
end

local function brazier(position: Vector3)
	block("BrazierStand", Vector3.new(1, 4, 1), CFrame.new(position + Vector3.new(0, 2, 0)), IRON, Enum.Material.Metal)
	local bowl = block(
		"BrazierBowl",
		Vector3.new(3, 1.2, 3),
		CFrame.new(position + Vector3.new(0, 4.4, 0)),
		IRON,
		Enum.Material.Metal
	)
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 9
	fire.Color = Color3.fromRGB(255, 70, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 30, 60)
	fire.Parent = bowl
	glow(bowl, Color3.fromRGB(255, 70, 60), 30, 2)
end

-- The Inferno ---------------------------------------------------------------------------------

local LAVA = Color3.fromRGB(255, 90, 20)
local OBSIDIAN = Color3.fromRGB(28, 18, 22)

-- A glowing lava pool sunk into the floor (walk over it: it's only scenery)
local function lavaPool(position: Vector3, sizeX: number, sizeZ: number)
	local rim = block(
		"LavaRim",
		Vector3.new(sizeX + 3, 0.6, sizeZ + 3),
		CFrame.new(position + Vector3.new(0, 0.3, 0)),
		OBSIDIAN,
		Enum.Material.Basalt
	)
	rim.CanCollide = false
	local lava = ghost(
		block(
			"Lava",
			Vector3.new(sizeX, 0.3, sizeZ),
			CFrame.new(position + Vector3.new(0, 0.55, 0)),
			LAVA,
			Enum.Material.Neon
		)
	)
	glow(lava, Color3.fromRGB(255, 110, 40), math.max(sizeX, sizeZ) + 14, 2.2)
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 60, 20))
	embers.LightEmission = 1
	embers.Size = NumberSequence.new(0.35, 0)
	embers.Lifetime = NumberRange.new(1.5, 3)
	embers.Rate = sizeX * sizeZ / 30
	embers.Speed = NumberRange.new(3, 7)
	embers.SpreadAngle = Vector2.new(20, 20)
	embers.EmissionDirection = Enum.NormalId.Top
	embers.Parent = lava
end

-- A jagged obsidian spire with glowing cracks
local function obsidianSpire(position: Vector3)
	local height = rng:NextNumber(8, 18)
	local cf = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi), math.rad(rng:NextNumber(-8, 8)))
	if detail("DetailSpire", cf, height / 14) then
		return
	end
	block("Spire", Vector3.new(4, height, 4), cf * CFrame.new(0, height / 2, 0), OBSIDIAN, Enum.Material.Basalt)
	block(
		"SpireTip",
		Vector3.new(2.4, height * 0.4, 2.4),
		cf * CFrame.new(0.4, height + height * 0.15, 0),
		OBSIDIAN,
		Enum.Material.Basalt
	)
	ghost(
		block(
			"SpireCrack",
			Vector3.new(0.3, height * 0.8, 4.1),
			cf * CFrame.new(0.6, height * 0.5, 0),
			LAVA,
			Enum.Material.Neon
		)
	)
end

-- A vent that coughs flames up out of the floor
local function fireVent(position: Vector3)
	local grate = block(
		"FireVent",
		Vector3.new(4, 0.5, 4),
		CFrame.new(position + Vector3.new(0, 0.25, 0)),
		IRON,
		Enum.Material.DiamondPlate
	)
	grate.CanCollide = false
	local fire = Instance.new("Fire")
	fire.Size = 8
	fire.Heat = 18
	fire.Color = Color3.fromRGB(255, 120, 30)
	fire.SecondaryColor = Color3.fromRGB(255, 40, 10)
	fire.Parent = grate
	glow(grate, Color3.fromRGB(255, 100, 40), 26, 2)
end

-- Mount Olympus ---------------------------------------------------------------------------------

local MARBLE = Color3.fromRGB(240, 236, 226)
local GOLD = Color3.fromRGB(255, 205, 70)

-- A tall white temple column with gold bands
local function olympusColumn(position: Vector3, height: number)
	if detail("DetailColumn", CFrame.new(position), height / 22.175) then
		return
	end
	cylinderUp(
		block(
			"Column",
			Vector3.new(height, 4, 4),
			CFrame.new(position + Vector3.new(0, height / 2, 0)),
			MARBLE,
			Enum.Material.Marble
		)
	)
	block(
		"ColumnBase",
		Vector3.new(5.5, 1.4, 5.5),
		CFrame.new(position + Vector3.new(0, 0.7, 0)),
		MARBLE,
		Enum.Material.Marble
	)
	block(
		"ColumnCap",
		Vector3.new(5.5, 1.4, 5.5),
		CFrame.new(position + Vector3.new(0, height, 0)),
		MARBLE,
		Enum.Material.Marble
	)
	ghost(
		block(
			"ColumnBand",
			Vector3.new(5.6, 0.4, 5.6),
			CFrame.new(position + Vector3.new(0, height - 1, 0)),
			GOLD,
			Enum.Material.Metal
		)
	)
	ghost(
		block(
			"ColumnBand",
			Vector3.new(5.6, 0.4, 5.6),
			CFrame.new(position + Vector3.new(0, 1.6, 0)),
			GOLD,
			Enum.Material.Metal
		)
	)
end

-- A ruined temple: a stepped plinth, a ring of columns, a gold roof edge
local function temple(position: Vector3)
	for i = 0, 2 do
		block(
			"TempleStep",
			Vector3.new(30 - i * 3, 1, 22 - i * 3),
			CFrame.new(position + Vector3.new(0, 0.5 + i, 0)),
			MARBLE,
			Enum.Material.Marble
		)
	end
	for _, x in { -11, -5.5, 0, 5.5, 11 } do
		for _, z in { -7, 7 } do
			olympusColumn(position + Vector3.new(x, 3, z), 16)
		end
	end
	block(
		"TempleRoof",
		Vector3.new(30, 2, 20),
		CFrame.new(position + Vector3.new(0, 20, 0)),
		MARBLE,
		Enum.Material.Marble
	)
	block(
		"TempleTrim",
		Vector3.new(30.4, 0.8, 20.4),
		CFrame.new(position + Vector3.new(0, 19, 0)),
		GOLD,
		Enum.Material.Metal
	)
	local wedge = Instance.new("WedgePart")
	wedge.Name = "Pediment"
	wedge.Anchored = true
	wedge.Size = Vector3.new(30, 5, 10)
	wedge.Color = MARBLE
	wedge.Material = Enum.Material.Marble
	wedge.CFrame = CFrame.new(position + Vector3.new(0, 23.5, -5))
	wedge.Parent = folder
	local back = wedge:Clone()
	back.CFrame = CFrame.new(position + Vector3.new(0, 23.5, 5)) * CFrame.Angles(0, math.pi, 0)
	back.Parent = folder
	-- A golden thunderbolt over the door
	local bolt = ghost(
		block(
			"Thunderbolt",
			Vector3.new(1, 6, 0.4),
			CFrame.new(position + Vector3.new(0, 15, -10.5)) * CFrame.Angles(0, 0, math.rad(20)),
			GOLD,
			Enum.Material.Neon
		)
	)
	glow(bolt, Color3.fromRGB(255, 230, 120), 30, 2)
end

-- A golden god statue on a marble plinth
local function godStatue(position: Vector3, facing: number)
	local cf = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	block("GodPlinth", Vector3.new(6, 4, 6), cf * CFrame.new(0, 2, 0), MARBLE, Enum.Material.Marble)
	block("GodLegs", Vector3.new(2.6, 4, 1.6), cf * CFrame.new(0, 6, 0), GOLD, Enum.Material.Metal)
	block("GodBody", Vector3.new(3.4, 4, 2), cf * CFrame.new(0, 10, 0), GOLD, Enum.Material.Metal)
	block("GodHead", Vector3.new(2, 2, 2), cf * CFrame.new(0, 13, 0), GOLD, Enum.Material.Metal)
	block("GodArm", Vector3.new(0.9, 4, 0.9), cf * CFrame.new(2.2, 13, 0), GOLD, Enum.Material.Metal)
	local bolt = ghost(
		block(
			"GodBolt",
			Vector3.new(0.5, 5, 0.5),
			cf * CFrame.new(2.2, 17, 0) * CFrame.Angles(0, 0, math.rad(15)),
			Color3.fromRGB(255, 250, 150),
			Enum.Material.Neon
		)
	)
	glow(bolt, Color3.fromRGB(255, 240, 150), 22, 1.6)
end

-- The Heavens ----------------------------------------------------------------------------------

local CLOUD = Color3.fromRGB(250, 250, 255)

-- A puffy cloud: a few overlapping white balls
local function cloud(position: Vector3, scale: number)
	for _ = 1, 5 do
		local size = rng:NextNumber(5, 9) * scale
		local p = ghost(
			ball(
				block(
					"Cloud",
					Vector3.one * size,
					CFrame.new(
						position
							+ Vector3.new(
								rng:NextNumber(-6, 6) * scale,
								rng:NextNumber(-1, 2) * scale,
								rng:NextNumber(-4, 4) * scale
							)
					),
					CLOUD,
					Enum.Material.SmoothPlastic
				)
			)
		)
		p.Transparency = 0.15
		p.CastShadow = false
	end
end

-- An angel statue: white body, gold halo, two big wings
local function angelStatue(position: Vector3, facing: number)
	local cf = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	if detail("DetailAngel", cf) then
		return
	end
	block("AngelPlinth", Vector3.new(5, 3, 5), cf * CFrame.new(0, 1.5, 0), MARBLE, Enum.Material.Marble)
	block("AngelRobe", Vector3.new(2.8, 6, 1.8), cf * CFrame.new(0, 6, 0), MARBLE, Enum.Material.Marble)
	block("AngelHead", Vector3.new(1.8, 1.8, 1.8), cf * CFrame.new(0, 10, 0), MARBLE, Enum.Material.Marble)
	local halo = ghost(
		block(
			"Halo",
			Vector3.new(0.3, 2.4, 2.4),
			cf * CFrame.new(0, 11.6, 0) * CFrame.Angles(0, 0, math.rad(90)),
			GOLD,
			Enum.Material.Neon
		)
	)
	halo.Shape = Enum.PartType.Cylinder
	glow(halo, Color3.fromRGB(255, 230, 140), 18, 1.5)
	for _, side in { -1, 1 } do
		for i = 0, 2 do
			block(
				"Wing",
				Vector3.new(0.4, 5 - i, 2.2),
				cf
					* CFrame.new(side * (2 + i * 1.3), 8 + i * 0.6, 1)
					* CFrame.Angles(0, 0, math.rad(side * (-25 - i * 15))),
				Color3.fromRGB(255, 255, 255),
				Enum.Material.SmoothPlastic
			)
		end
	end
end

-- A shaft of light falling from the sky
local function lightPillar(position: Vector3)
	local shaft = ghost(
		block(
			"LightShaft",
			Vector3.new(8, 60, 8),
			CFrame.new(position + Vector3.new(0, 30, 0)),
			Color3.fromRGB(255, 245, 200),
			Enum.Material.Neon
		)
	)
	shaft.Transparency = 0.85
	shaft.CastShadow = false
	glow(shaft, Color3.fromRGB(255, 240, 190), 30, 1.2)
end

-- Pearly gates: two gold-trimmed white pillars and an arch of bars
local function pearlyGates(position: Vector3)
	for _, x in { -14, 14 } do
		block(
			"GatePillar",
			Vector3.new(4, 20, 4),
			CFrame.new(position + Vector3.new(x, 10, 0)),
			MARBLE,
			Enum.Material.Marble
		)
		ghost(
			block("GateOrb", Vector3.one * 3, CFrame.new(position + Vector3.new(x, 21.5, 0)), GOLD, Enum.Material.Neon)
		).Shape =
			Enum.PartType.Ball
	end
	for x = -11, 11, 2.75 do
		local h = 16 + math.cos(x / 11 * math.pi / 2) * 4
		ghost(
			block(
				"GateBar",
				Vector3.new(0.5, h, 0.5),
				CFrame.new(position + Vector3.new(x, h / 2, 0)),
				GOLD,
				Enum.Material.Metal
			)
		)
	end
end

-- Outer Space ----------------------------------------------------------------------------------

-- A planet hanging in the sky over the runway (optionally ringed)
local function planet(position: Vector3, size: number, color: Color3, ringed: boolean)
	local body =
		ghost(ball(block("Planet", Vector3.one * size, CFrame.new(position), color, Enum.Material.SmoothPlastic)))
	body.CastShadow = false
	glow(body, color, size * 1.2, 0.8)
	if ringed then
		local ring = ghost(
			block(
				"PlanetRing",
				Vector3.new(0.4, size * 1.9, size * 1.9),
				CFrame.new(position) * CFrame.Angles(math.rad(20), 0, math.rad(90 - 15)),
				color:Lerp(Color3.new(1, 1, 1), 0.4),
				Enum.Material.Neon
			)
		)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.5
		ring.CastShadow = false
	end
end

-- A lumpy asteroid sitting on the floor (solid: something to dodge around)
local function asteroid(position: Vector3)
	local size = rng:NextNumber(4, 9)
	local rock = Color3.fromRGB(70, 62, 80)
	ball(
		block(
			"Asteroid",
			Vector3.new(size, size * 0.8, size * 1.1),
			CFrame.new(position + Vector3.new(0, size * 0.35, 0)),
			rock,
			Enum.Material.Slate
		)
	)
	for _ = 1, 3 do
		ghost(
			ball(
				block(
					"AsteroidLump",
					Vector3.one * size * 0.45,
					CFrame.new(
						position
							+ Vector3.new(
								rng:NextNumber(-1, 1) * size * 0.4,
								size * 0.5,
								rng:NextNumber(-1, 1) * size * 0.4
							)
					),
					rock,
					Enum.Material.Slate
				)
			)
		)
	end
end

-- A twinkling field of stars low over the floor
local function starfield(center: Vector3, size: Vector3)
	local anchor = ghost(block("Stars", size, CFrame.new(center), Color3.new(), Enum.Material.SmoothPlastic))
	anchor.Transparency = 1
	local stars = Instance.new("ParticleEmitter")
	stars.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	stars.Color = ColorSequence.new(Color3.fromRGB(200, 220, 255), Color3.fromRGB(255, 160, 255))
	stars.LightEmission = 1
	stars.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	stars.Lifetime = NumberRange.new(3, 6)
	stars.Rate = 40
	stars.Speed = NumberRange.new(0, 0.5)
	stars.Shape = Enum.ParticleEmitterShape.Box
	stars.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	stars.Parent = anchor
end

-- A cluster of glowing space crystals (Blender Crystal prop)
local function spaceCrystals(position: Vector3, color: Color3)
	for _ = 1, 3 do
		prop(
			"Crystal",
			CFrame.new(position + Vector3.new(rng:NextNumber(-2.5, 2.5), 0, rng:NextNumber(-2.5, 2.5)))
				* CFrame.Angles(
					math.rad(rng:NextNumber(-15, 15)),
					rng:NextNumber(0, math.pi * 2),
					math.rad(rng:NextNumber(-15, 15))
				),
			rng:NextNumber(1.2, 2.4),
			{ Crystal = color }
		)
	end
	local light = ghost(block("CrystalLight", Vector3.one * 0.2, CFrame.new(position + Vector3.new(0, 3, 0)), color))
	light.Transparency = 1
	glow(light, color, 24, 1.8)
end

-- The Manor at the end of the runway: a big dark house with lit windows and two towers
local function manor(center: Vector3)
	local wall = Color3.fromRGB(70, 50, 70)
	local roof = Color3.fromRGB(40, 28, 42)
	local W, H, D = 130, 40, 40
	block(
		"ManorBody",
		Vector3.new(W, H, D),
		CFrame.new(center + Vector3.new(0, H / 2, D / 2)),
		wall,
		Enum.Material.Brick
	)
	for _, side in { -1, 1 } do
		block(
			"ManorRoof",
			Vector3.new(W + 4, 1.5, D * 0.62),
			CFrame.new(center + Vector3.new(0, H + 7, D / 2 + side * D * 0.24))
				* CFrame.Angles(math.rad(side * -38), 0, 0),
			roof,
			Enum.Material.Slate
		)
	end
	for _, x in { -W / 2, W / 2 } do
		local tower = center + Vector3.new(x, 0, D / 2)
		block(
			"Tower",
			Vector3.new(16, H + 20, 16),
			CFrame.new(tower + Vector3.new(0, (H + 20) / 2, 0)),
			wall,
			Enum.Material.Brick
		)
		for i = 1, 5 do
			local s = 16 - i * 2.6
			block(
				"Spire",
				Vector3.new(s, 3, s),
				CFrame.new(tower + Vector3.new(0, H + 20 + i * 3, 0)),
				roof,
				Enum.Material.Slate
			)
		end
	end
	for row = 0, 2 do
		for i = 0, 10 do
			local x = -W / 2 + 10 + i * ((W - 20) / 10)
			if math.abs(x) < 10 and row == 0 then
				continue -- the door goes here
			end
			local lit = rng:NextNumber() < 0.7
			local window = ghost(
				block(
					"Window",
					Vector3.new(4, 6, 0.4),
					CFrame.new(center + Vector3.new(x, 8 + row * 11, -0.1)),
					if lit then WINDOW else Color3.fromRGB(25, 25, 35),
					if lit then Enum.Material.Neon else Enum.Material.Glass
				)
			)
			if lit and i % 3 == 0 then
				glow(window, WINDOW, 16, 0.8)
			end
			detail("DetailManorWindow", CFrame.new(center + Vector3.new(x, 5 + row * 11, -0.45)))
		end
	end
	-- The grand door, glowing red: the deepest point of the runway
	block(
		"ManorDoor",
		Vector3.new(14, 18, 0.6),
		CFrame.new(center + Vector3.new(0, 9, -0.2)),
		Color3.fromRGB(90, 20, 30),
		Enum.Material.Wood
	)
	local doorGlow = ghost(
		block(
			"DoorGlow",
			Vector3.new(12, 1, 0.3),
			CFrame.new(center + Vector3.new(0, 18.5, -0.5)),
			Color3.fromRGB(255, 60, 70),
			Enum.Material.Neon
		)
	)
	glow(doorGlow, Color3.fromRGB(255, 60, 70), 40, 2)
end

-- The board over the runway entrance; the client fills in the countdowns (Hud)
local function eventBoard(z: number, width: number)
	local woodColor = Color3.fromRGB(104, 66, 38)
	-- A beam from wall to wall, the board hanging off it on two ropes
	local beam = block("BoardBeam", Vector3.new(width + 12, 2, 2), at(0, 36, z), woodColor)
	Toy.Dress(beam, Toy.Sides, 1, 0)
	local boardWidth, boardHeight = 52, 15
	for _, x in { -boardWidth / 2 + 3, boardWidth / 2 - 3 } do
		block("BoardRope", Vector3.new(0.4, 6, 0.4), at(x, 32, z), Color3.fromRGB(70, 46, 28))
	end
	local frameBlock = block(
		"EventBoardFrame",
		Vector3.new(boardWidth + 1.6, boardHeight + 1.6, 1.2),
		at(0, 29 - boardHeight / 2 + 0.8, z + 0.2),
		woodColor
	)
	Toy.Dress(frameBlock, Toy.Sides, 1, 0)
	local board = block(
		"EventBoard",
		Vector3.new(boardWidth, boardHeight, 1.4),
		at(0, 29 - boardHeight / 2 + 0.8, z),
		Color3.fromRGB(34, 22, 16)
	)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = `Lines{face.Name}`
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 20
		gui.LightInfluence = 0
		gui.Brightness = 0.85 -- full-bright signs, a touch softer than pure white
		gui.Parent = board
		local layout = Instance.new("UIListLayout")
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Padding = UDim.new(0, 4)
		layout.Parent = gui
		for i = 1, 4 do
			local line = Instance.new("TextLabel")
			line.Name = `Line{i}`
			line.LayoutOrder = i
			line.Size = UDim2.fromScale(0.94, 0.21)
			line.BackgroundTransparency = 1
			line.Font = Enum.Font.FredokaOne
			line.TextScaled = true
			line.RichText = true
			line.TextColor3 = Color3.new(1, 1, 1)
			line.Text = ""
			line.Parent = gui
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 3
			stroke.Color = Color3.fromRGB(20, 12, 8)
			stroke.Parent = line
		end
	end
end

-- Build -----------------------------------------------------------------------------------------

-- Clears decoration out of a rectangle (the boss lairs, built after the decor)
function ManorDecor.ClearArea(center: Vector3, halfX: number, halfZ: number)
	if not folder then
		return
	end
	for _, child in folder:GetChildren() do
		local position = if child:IsA("BasePart")
			then child.Position
			elseif child:IsA("Model") then child:GetPivot().Position
			else nil
		local extentX, extentZ = 0, 0
		if child:IsA("Model") and child:GetAttribute("MapDetail") then
			local cf, size = child:GetBoundingBox()
			position = cf.Position
			extentX = (
				math.abs(cf.RightVector.X) * size.X
				+ math.abs(cf.UpVector.X) * size.Y
				+ math.abs(cf.LookVector.X) * size.Z
			) / 2
			extentZ = (
				math.abs(cf.RightVector.Z) * size.X
				+ math.abs(cf.UpVector.Z) * size.Y
				+ math.abs(cf.LookVector.Z) * size.Z
			) / 2
		end
		if
			position
			and math.abs(position.X - center.X) < halfX + extentX
			and math.abs(position.Z - center.Z) < halfZ + extentZ
			and position.Y < 60
		then
			child:Destroy()
		end
	end
end

function ManorDecor.Build(root: Instance, arena: Bounds, _hideaways: { Bounds })
	folder = Instance.new("Folder")
	folder.Name = "Decor"
	folder.Parent = root
	local width = arena.MaxX - arena.MinX
	local depth = GameConfig.ZoneDepth
	local half = width / 2

	-- Every zone (its name pops up on screen as you walk in: client/Transitions): sconces down both walls, its own biome inside
	for i, zone in GameConfig.Zones do
		local z0 = (i - 1) * depth
		local color: Color3 = zone.Color
		-- Fireflies in the zone's colour, and mist creeping along the ground
		fireflies(
			Vector3.new(0, 5, z0 + depth / 2),
			Vector3.new(width - 6, 8, depth - 10),
			color:Lerp(Color3.fromRGB(230, 255, 150), 0.5),
			6
		)
		mist(Vector3.new(0, 1.5, z0 + depth / 2), Vector3.new(width - 4, 1, depth - 6), Color3.fromRGB(150, 140, 190))
		for z = z0 + 18, z0 + depth - 10, 35 do
			sconce(-half, z, -1, color)
			sconce(half, z, 1, color)
		end
		-- Somewhere off the middle of the runway, so the run home stays fairly clear
		-- (never on the boss's stage: GameConfig.BossLair, plus a margin to walk around it)
		local lair = GameConfig.BossLair
		local lairAt = GameConfig.BossLairCenter(i)
		local function spot(): Vector3
			for _ = 1, 12 do
				local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(10, half - 5)
				local z = z0 + rng:NextNumber(20, depth - 15)
				if math.abs(x - lairAt.X) > lair.Depth / 2 + 6 or math.abs(z - lairAt.Z) > lair.Width / 2 + 6 then
					return Vector3.new(x, 0, z)
				end
			end
			return Vector3.new(half - 8, 0, z0 + 20)
		end
		if zone.Rarity == "Common" then
			for z = z0 + 30, z0 + depth - 30, 45 do
				hedge(Vector3.new(-half + 6, 0, z), 14)
				hedge(Vector3.new(half - 6, 0, z + 20), 14)
			end
			local garden = Vector3.new(35, 0, z0 + depth * 0.5)
			fountain(garden)
			for _, side in { -1, 1 } do
				for _, x in { -8, 8 } do
					bench(garden + Vector3.new(x, 0, side * 12), if side == 1 then 0 else math.pi)
					streetLamp(garden + Vector3.new(x * 1.5, 0, side * 9))
				end
				detail(
					"DetailFlowerBed",
					CFrame.new(garden + Vector3.new(side * 10, 0, 0)) * CFrame.Angles(0, math.pi / 2, 0)
				)
			end
		elseif zone.Rarity == "Rare" then
			local garden = Vector3.new(-half + 14, 0, z0 + depth * 0.4)
			gazebo(garden)
			for _, side in { -1, 1 } do
				detail("DetailFlowerBed", CFrame.new(garden + Vector3.new(0, 0, side * 10)))
			end
			pond(Vector3.new(half - 14, 0, z0 + depth * 0.65), 18, 26)
			for _ = 1, 6 do
				topiary(spot())
			end
			local colors =
				{ Color3.fromRGB(90, 200, 255), Color3.fromRGB(150, 120, 255), Color3.fromRGB(255, 140, 220) }
			for _ = 1, 40 do
				glowFlower(spot() + Vector3.new(rng:NextNumber(-3, 3), 0, 0), colors[rng:NextInteger(1, #colors)])
			end
		elseif zone.Rarity == "Epic" then
			mausoleum(Vector3.new(-half + 9, 0, z0 + depth * 0.3), math.rad(-90))
			mausoleum(Vector3.new(half - 9, 0, z0 + depth * 0.7), math.rad(90))
			for _ = 1, 22 do
				gravestone(spot())
			end
			for _ = 1, 5 do
				deadTree(spot())
			end
		elseif zone.Rarity == "Legendary" then
			for z = z0 + 25, z0 + depth - 20, 40 do
				pillar(Vector3.new(-half + 6, 0, z))
				pillar(Vector3.new(half - 6, 0, z))
			end
			for _ = 1, 6 do
				candelabra(spot())
			end
			for _ = 1, 8 do
				urn(spot())
			end
			for _ = 1, 6 do
				torch(spot(), Color3.fromRGB(255, 190, 60))
			end
		elseif zone.Rarity == "Mythic" then
			for _ = 1, 7 do
				lavaPool(spot(), rng:NextNumber(10, 20), rng:NextNumber(10, 24))
			end
			for _ = 1, 12 do
				obsidianSpire(spot())
			end
			for _ = 1, 8 do
				fireVent(spot())
			end
			for z = z0 + 25, z0 + depth - 15, 40 do
				brazier(Vector3.new(-half + 6, 0, z))
				brazier(Vector3.new(half - 6, 0, z))
			end
		elseif zone.Rarity == "Godly" then
			temple(Vector3.new(-half + 24, 0, z0 + depth * 0.45))
			temple(Vector3.new(half - 24, 0, z0 + depth * 0.75))
			for z = z0 + 20, z0 + depth - 10, 30 do
				olympusColumn(Vector3.new(-half + 4, 0, z), 26)
				olympusColumn(Vector3.new(half - 4, 0, z), 26)
			end
			for z = z0 + 40, z0 + depth * 0.5, 55 do
				godStatue(Vector3.new(-14, 0, z), math.rad(90))
				godStatue(Vector3.new(14, 0, z), math.rad(-90))
			end
			for _ = 1, 6 do
				brazier(spot())
			end
			for _ = 1, 8 do
				cloud(
					Vector3.new(rng:NextNumber(-half, half), rng:NextNumber(36, 50), z0 + rng:NextNumber(0, depth)),
					2
				)
			end
		elseif zone.Rarity == "Celestial" then
			pearlyGates(Vector3.new(0, 0, z0 + 12))
			for _ = 1, 26 do
				local p = spot()
				cloud(p + Vector3.new(0, rng:NextNumber(1, 3), 0), rng:NextNumber(0.6, 1.1))
			end
			for _ = 1, 10 do
				cloud(
					Vector3.new(rng:NextNumber(-half, half), rng:NextNumber(30, 45), z0 + rng:NextNumber(0, depth)),
					2.5
				)
			end
			for z = z0 + 40, z0 + depth - 25, 45 do
				angelStatue(Vector3.new(-half + 8, 0, z), math.rad(-90))
				angelStatue(Vector3.new(half - 8, 0, z + 20), math.rad(90))
			end
			for _ = 1, 6 do
				lightPillar(spot())
			end
		elseif zone.Rarity == "Cosmic" then
			for _, x in { -half + 16, half - 16 } do
				detail("DetailOrrery", CFrame.new(x, 0, z0 + 35))
			end
			starfield(Vector3.new(0, 14, z0 + depth / 2), Vector3.new(width - 6, 24, depth - 6))
			for _ = 1, 14 do
				asteroid(spot())
			end
			local crystalColors =
				{ Color3.fromRGB(170, 80, 255), Color3.fromRGB(80, 220, 255), Color3.fromRGB(255, 90, 230) }
			for _ = 1, 10 do
				spaceCrystals(spot(), crystalColors[rng:NextInteger(1, #crystalColors)])
			end
			planet(Vector3.new(-half - 40, 70, z0 + depth * 0.3), 50, Color3.fromRGB(255, 120, 80), true)
			planet(Vector3.new(half + 30, 55, z0 + depth * 0.7), 30, Color3.fromRGB(90, 180, 255), false)
			planet(Vector3.new(0, 95, z0 + depth * 0.55), 18, Color3.fromRGB(190, 255, 140), true)
		end
	end

	-- The entrance: events board hanging over the start of the runway
	eventBoard(-4, width)

	-- The plaza: lamps along both sides, the giant Void Edge at the back, fireflies everywhere
	fireflies(Vector3.new(0, 6, -95), Vector3.new(width - 6, 10, 170), Color3.fromRGB(255, 230, 140), 10)
	for z = -10, -230, -32 do
		streetLamp(Vector3.new(-half + 4, 0, z))
		streetLamp(Vector3.new(half - 4, 0, z))
	end
	local plinth = block("Plinth", Vector3.new(10, 6, 10), at(0, 3, -205), DARK_STONE, Enum.Material.Slate)
	glow(plinth, Color3.fromRGB(170, 70, 255), 30, 2)
	local statueKnife = KnifeModel.Build("VoidEdge", true)
	statueKnife:ScaleTo(7)
	statueKnife:PivotTo(CFrame.new(0, 6 + 7 * 0.9, -205) * CFrame.Angles(0, math.rad(90), 0))
	statueKnife.Name = "Statue"
	statueKnife.Parent = folder
	for _, x in { -8, 8 } do
		torch(Vector3.new(x, 0, -199))
	end

	manor(Vector3.new(0, 0, arena.MaxZ + 6))
end

return ManorDecor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the world in code so the whole layout lives in git. The hub is Blackwood Manor at night,
-- laid out like the big steal games: one long straight runway between tall stone walls, the
-- zones one after another down it, the vaults at the start. (Decoration lives in ManorDecor.)
-- Layout (top-down, +Z is "deeper"):
--
--   z = 1760+          the Manor
--   z = 1540..1760 ║ Cosmic     ║    Outer Space
--   z = 1320..1540 ║ Celestial  ║    The Heavens
--   z = 1100..1320 ║ Godly      ║    Mount Olympus
--   z = 880..1100  ║ Mythic     ║    The Inferno
--   z = 660..880   ║ Legendary  ║    runway: ArenaWidth (160) wide, ZoneDepth per zone, guards inside;
--   z = 440..660   ║ Epic       ║    they chase you all the way back to the plaza
--   z = 220..440   ║ Rare       ║
--   z = 0..220     ║ Common     ║
--   z = -170..0  [B1]  plaza  [B5]   four vaults on each side, opening onto the plaza
--                [B2]         [B6]
--                [B3]         [B7]
--                [B4] spawn   [B8]
--
--   round maps (indoor buildings, see RoundMaps) are built far away at x = 3000

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local ManorDecor = require(script.Parent.ManorDecor)
local RoundMaps = require(script.Parent.RoundMaps)
local VaultWalls = require(script.Parent.VaultWalls)
local Textures = require(ReplicatedStorage.Shared.Config.Textures)
local SignTheme = require(ReplicatedStorage.Shared.SignTheme)
local Toy = require(ReplicatedStorage.Shared.Toy)

export type Bounds = { MinX: number, MaxX: number, MinZ: number, MaxZ: number }
export type BaseSite = {
	Index: number,
	Color: Color3, -- this vault's own colour (wall strip, gate glow)
	Folder: Folder,
	WallFolder: Folder, -- rebuilt by VaultWalls whenever the owner's wall tier changes
	Gate: Model,
	Blocker: Part, -- the gate's hit / collision part (attributes: Owner, Health, MaxHealth, Open)
	SignPart: Part,
	Center: Vector3,
	Frame: CFrame, -- local +Z points out of the vault's open side, towards the plaza
	Bounds: Bounds,
	Spawn: CFrame,
	SlotCFrames: { CFrame }, -- where each knife floats, over its pedestal
	SlotPads: { BasePart }, -- each pedestal's stone (holds the prompts)
	SlotRims: { BasePart }, -- each pedestal's glowing top (the knife's colour when filled)
	FloorFolders: { Folder }, -- each storey's decks, ladder and plates (SetFloors shows the owned ones)
	CashPads: { BasePart }, -- the green pad beside each plate: walk on it to collect that knife's money
	CashLabels: { TextLabel }, -- the amount waiting, written on the pad
	Treadmill: Part, -- the floor inside the Haunted Wheel; standing on it trains Speed
	TreadmillSign: TextLabel,
	Wheel: Model,
	Sign: TextLabel,
}
export type Zone = { Index: number, Rarity: string, Bounds: Bounds }

local MapService = {}

MapService.MaxBases = 16 -- 6 down each side of the plaza + 4 across the back (16-player servers)
MapService.Arena = nil :: Bounds?
MapService.Zones = {} :: { Zone }
MapService.Hideaways = {} :: { Bounds }
MapService.Bases = {} :: { BaseSite }
MapService.RoundSpawns = {} :: { CFrame }
MapService.RoundCenter = Vector3.new(3000, 0, 0)
MapService.RoundMapSize = Vector2.new(150, 110)
MapService.LobbySpawn = CFrame.new(0, 4, -110)

local root: Folder

local function block(name: string, size: Vector3, cframe: CFrame, color: Color3, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or root
	return p
end

-- offset is in world space, so a sign's text can sit in front of its board
local function label(adornee: BasePart, text: string, color: Color3, size: UDim2, offset: Vector3): TextLabel
	local gui = Instance.new("BillboardGui")
	gui:SetAttribute("LabelCategory", "Utility")
	gui:AddTag("ResponsiveWorldLabel")
	gui.Size = size
	gui.StudsOffsetWorldSpace = offset
	gui.AlwaysOnTop = false
	gui.MaxDistance = 400
	gui.Adornee = adornee
	gui.Parent = adornee
	local text_ = Instance.new("TextLabel")
	text_.Size = UDim2.fromScale(1, 1)
	text_.BackgroundTransparency = 1
	text_.Font = Enum.Font.FredokaOne
	text_.TextScaled = true
	text_.TextColor3 = color
	text_.TextStrokeTransparency = 0
	text_.Text = text
	text_.Parent = gui
	return text_
end

local function bounds(center: Vector3, sizeX: number, sizeZ: number): Bounds
	return {
		MinX = center.X - sizeX / 2,
		MaxX = center.X + sizeX / 2,
		MinZ = center.Z - sizeZ / 2,
		MaxZ = center.Z + sizeZ / 2,
	}
end

function MapService.InBounds(b: Bounds, pos: Vector3, margin: number?): boolean
	local m = margin or 0
	return pos.X >= b.MinX - m and pos.X <= b.MaxX + m and pos.Z >= b.MinZ - m and pos.Z <= b.MaxZ + m
end

-- Safe in one of the nooks cut into the runway walls
function MapService.IsInHideaway(pos: Vector3): boolean
	for _, hideaway in MapService.Hideaways do
		if MapService.InBounds(hideaway, pos) then
			return true
		end
	end
	return false
end

-- A sunny afternoon high in the sky (Steal An Egg style): a real sun low enough that everything
-- throws a clear shadow, blue sky all the way round (also below: the map floats), soft clouds.
-- Set Lighting.Technology to Future (or ShadowMap) in Studio for crisp shadows.
local function buildLighting()
	-- Noon with the sun straight overhead (like Steal An Egg): at latitude 23.5 the noon sun is
	-- exactly vertical, so the tall runway walls throw no shadow across the boss lairs beside them
	Lighting.ClockTime = 12
	Lighting.GeographicLatitude = 23.5
	-- Flat and bright: a gentle sun (a strong one glares off the floors in bright patches) and
	-- strong, even fill light so nothing looks dim
	Lighting.Brightness = 4
	Lighting.ExposureCompensation = 0.1
	-- Warm and even, like Steal An Egg: the sun is overhead, so walls get no direct light - strong
	-- warm fill keeps them bright tan instead of murky. No sky-light bounce (it tinted everything blue).
	Lighting.Ambient = Color3.fromRGB(190, 188, 184)
	Lighting.OutdoorAmbient = Color3.fromRGB(222, 218, 210)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 252, 245)
	Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	-- Clients restore these after a round (client/Effects)
	Lighting:SetAttribute("HubAmbient", Lighting.Ambient)
	Lighting:SetAttribute("HubOutdoor", Lighting.OutdoorAmbient)
	-- Real shadows (with the sun overhead, just a small one under each character)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.2
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("PostEffect") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	-- A soft, pale haze with distance (things far below or far away go lighter, close up stays crisp)
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.05
	atmosphere.Color = Color3.fromRGB(225, 232, 240)
	atmosphere.Decay = Color3.fromRGB(190, 210, 230)
	atmosphere:SetAttribute("HubColor", atmosphere.Color)
	atmosphere:SetAttribute("HubDecay", atmosphere.Decay)
	atmosphere.Glare = 0
	atmosphere.Haze = 1 -- the soft, sunny white haze down the runway (Steal An Egg)
	atmosphere.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.SkyboxFt = Textures.Day.Ft
	sky.SkyboxBk = Textures.Day.Bk
	sky.SkyboxLf = Textures.Day.Lf
	sky.SkyboxRt = Textures.Day.Rt
	sky.SkyboxUp = Textures.Day.Up
	sky.SkyboxDn = Textures.Day.Dn
	sky.StarCount = 0
	sky.CelestialBodiesShown = true -- the real sun, matching the shadows
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 0
	sky.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.25
	bloom.Size = 20
	bloom.Threshold = 2
	bloom.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	-- Softer and a touch brighter, like Steal An Egg: slightly less saturation (the parts alone read
	-- neon) and a gentle lift
	grade.Contrast = -0.02
	grade.Saturation = -0.08
	grade.TintColor = Color3.fromRGB(255, 253, 248)
	grade.Brightness = 0.04
	grade.Parent = Lighting
	-- A clear sky (the few clouds are painted into the skybox)
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds:Destroy()
	end
end

-- Each zone is its own bright toy biome, so going deeper reads at a glance (Steal An Egg style)
local ZONE_FLOORS: { [string]: Color3 } = {
	Common = Color3.fromRGB(48, 146, 30), -- the Courtyard: grass (same green as the plaza)
	Rare = Color3.fromRGB(26, 104, 30), -- the Gardens: deep grass
	Epic = Color3.fromRGB(96, 100, 120), -- the Crypts: grey stone
	Legendary = Color3.fromRGB(196, 158, 86), -- the Catacombs: sand
	Mythic = Color3.fromRGB(150, 48, 30), -- the Inferno: red rock
	Godly = Color3.fromRGB(200, 196, 180), -- Olympus: marble
	Celestial = Color3.fromRGB(150, 196, 230), -- the Heavens: cloud blue
	Cosmic = Color3.fromRGB(70, 46, 130), -- Space: purple
}
-- Walls change with the biome too, so going deeper looks deeper
local ZONE_WALLS: { [string]: Color3 } = {
	Common = Color3.fromRGB(214, 146, 78), -- dirt
	Rare = Color3.fromRGB(174, 119, 72), -- dark dirt
	Epic = Color3.fromRGB(110, 110, 118), -- stone
	Legendary = Color3.fromRGB(176, 140, 80), -- sandstone
	Mythic = Color3.fromRGB(90, 40, 34), -- dark basalt
	Godly = Color3.fromRGB(196, 186, 160), -- marble
	Celestial = Color3.fromRGB(200, 214, 230), -- cloud
	Cosmic = Color3.fromRGB(48, 36, 84), -- void
}

local WALL_HEIGHT = 40
local WALL_THICK = 6
local STONE = Color3.fromRGB(98, 92, 150)

-- Runway walls take on a hint of the colour of the zone they're in
local function zoneTint(z: number): Color3
	local index = math.clamp(math.floor(z / GameConfig.ZoneDepth) + 1, 1, #GameConfig.Zones)
	local floor = ZONE_FLOORS[GameConfig.Zones[index].Rarity] or STONE
	return floor:Lerp(Color3.new(0, 0, 0), 0.32)
end

-- The runway: zone floors one after another, tall walls with hideaway nooks cut into them
local function buildArena()
	local width, depth = GameConfig.ArenaWidth, GameConfig.ZoneDepth
	local totalDepth = depth * #GameConfig.Zones
	MapService.Arena = { MinX = -width / 2, MaxX = width / 2, MinZ = 0, MaxZ = totalDepth }

	local arena = Instance.new("Folder")
	arena.Name = "Arena"
	arena.Parent = root

	for i, zone in GameConfig.Zones do
		local z0 = (i - 1) * depth
		local center = Vector3.new(0, 0, z0 + depth / 2)
		local floor = block(
			`Zone{i}Floor`,
			Vector3.new(width, 1, depth),
			CFrame.new(center + Vector3.new(0, -0.3, 0)),
			ZONE_FLOORS[zone.Rarity] or zone.Color,
			arena
		)
		Toy.Dress(floor, nil, 1, 5)
		table.insert(MapService.Zones, {
			Index = i,
			Rarity = zone.Rarity,
			Bounds = { MinX = -width / 2, MaxX = width / 2, MinZ = z0, MaxZ = z0 + depth },
		})
	end

	-- Solid walls down both sides, one segment per zone so each takes on that zone's tint. (The old
	-- hideaway nooks are gone: people sat in them throwing knives at guards that couldn't reach them.)
	for _, side in { -1, 1 } do
		local x = side * (width / 2 + WALL_THICK / 2)
		for i = 1, #GameConfig.Zones do
			local z0 = (i - 1) * depth
			local wall = block(
				"RunwayWall",
				Vector3.new(WALL_THICK, WALL_HEIGHT, depth),
				CFrame.new(x, WALL_HEIGHT / 2, z0 + depth / 2),
				zoneTint(z0 + depth / 2),
				arena
			)
			Toy.DirtWall(wall, ZONE_WALLS[GameConfig.Zones[i].Rarity])
		end
	end
	-- The far end: the Manor's wall
	local farWall = block(
		"RunwayEnd",
		Vector3.new(width + WALL_THICK * 2, WALL_HEIGHT, WALL_THICK),
		CFrame.new(0, WALL_HEIGHT / 2, totalDepth + WALL_THICK / 2),
		STONE,
		arena
	)
	Toy.DirtWall(farWall)

	-- A glowing line where the runway starts
	local line = block(
		"EntranceLine",
		Vector3.new(width, 0.4, 0.5),
		CFrame.new(0, 0.4, -0.25),
		Color3.fromRGB(235, 80, 95),
		arena
	)
	line.CanCollide = false
	line.CanQuery = false
	-- SAFE ZONE painted on the plaza floor: bosses give up the chase past the line
	local paint = block("SafeZone", Vector3.new(60, 0.05, 10), CFrame.new(0, 0.23, -12), Color3.new(), arena)
	paint.Transparency = 1
	paint.CanCollide = false
	paint.CanQuery = false
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Top
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 20
	surface.LightInfluence = 0
	surface.Brightness = 0.85 -- full-bright signs, a touch softer than pure white
	surface.Parent = paint
	local safeText = Instance.new("TextLabel")
	safeText.Size = UDim2.fromScale(1, 1)
	safeText.BackgroundTransparency = 1
	safeText.Font = Enum.Font.FredokaOne
	safeText.TextScaled = true
	safeText.TextColor3 = Color3.new(1, 1, 1)
	safeText.Text = "🛡 SAFE ZONE 🛡"
	safeText.Rotation = 180 -- reads the right way round walking up from the plaza
	safeText.Parent = surface
	local outline = Instance.new("UIStroke")
	outline.Thickness = 6
	outline.Color = Color3.fromRGB(30, 30, 40)
	outline.Parent = safeText
end

-- Vaults: four down each side of the plaza, each opening onto it. Built in each vault's own frame
-- (local +Z = the open side), so both columns share the same code.
local VAULT_WIDTH, VAULT_DEPTH, VAULT_SPACING = 40, 44, 40 -- vaults touch: no gaps to slip out through
-- Inside (vault-local; +Z is the open side), Tsunami style: every floor is a walkway down the middle
-- with a ladder at the back, and five big plates down each side. Floor 1 is the ground; each
-- upgrade shows the next storey (SetFloors).
local SLOTS_PER_FLOOR = GameConfig.SlotsPerFloor
local FLOORS = GameConfig.MaxSlots // SLOTS_PER_FLOOR
local FLOOR_HEIGHT = 16 -- roomy: plenty of headroom over the knives
local PLATE_X = 12 -- the two columns of plates, either side of the walkway
local PLATE_Z = { -17, -9, -1, 7, 15 } -- back to front
local WALK_HALF = 4
local LADDER_LANDING = 3.5 -- deck behind the ladder at the back, where you step off at the top
local LADDER_HOLE = 3 -- the slot in front of the ladder you climb up through
local LADDER_HOLE_HALF = 2.5
local PLATE_RADIUS = 3.4
local FLOOR_PINK = Color3.fromRGB(255, 222, 238)
local HUB_HALF = GameConfig.ArenaWidth / 2 + VAULT_DEPTH + 0.5 -- the hub's outer wall (inner face), just behind the vaults
local COLUMN = 6 -- vaults down each side; 4 more across the back
local HUB_BACK = COLUMN * 40 + 44 -- the hub ends right behind the back row of vaults
local NAVY = Color3.fromRGB(40, 44, 90)
local CYAN = Color3.fromRGB(70, 214, 245)
local KNIFE_TILT = 12 -- degrees
MapService.Floors = FLOORS
MapService.FloorHeight = FLOOR_HEIGHT
MapService.SlotsPerFloor = SLOTS_PER_FLOOR

local function buildBases()
	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	bases.Parent = root
	local palette = {
		Color3.fromRGB(255, 120, 120),
		Color3.fromRGB(255, 190, 90),
		Color3.fromRGB(255, 240, 110),
		Color3.fromRGB(130, 230, 130),
		Color3.fromRGB(110, 210, 255),
		Color3.fromRGB(150, 150, 255),
		Color3.fromRGB(220, 140, 255),
		Color3.fromRGB(255, 150, 210),
		Color3.fromRGB(255, 160, 110),
		Color3.fromRGB(190, 240, 120),
		Color3.fromRGB(110, 240, 210),
		Color3.fromRGB(120, 170, 255),
		Color3.fromRGB(200, 120, 220),
		Color3.fromRGB(255, 200, 150),
		Color3.fromRGB(170, 255, 170),
		Color3.fromRGB(180, 200, 255),
	}
	local half = GameConfig.ArenaWidth / 2

	for i = 1, MapService.MaxBases do
		-- 1-6 down the left side, 7-12 down the right, 13-16 across the back of the plaza
		local center: Vector3, frame: CFrame
		local sideways = i <= COLUMN * 2
		if sideways then
			local side = if i <= COLUMN then -1 else 1
			local row = (i - 1) % COLUMN
			center = Vector3.new(side * (half + VAULT_DEPTH / 2), 0, -20 - row * VAULT_SPACING)
			-- Rotate so local +Z faces the plaza (the left column faces +X, the right column -X)
			frame = CFrame.new(center) * CFrame.Angles(0, math.rad(if side < 0 then 90 else -90), 0)
		else
			local k = i - COLUMN * 2
			center = Vector3.new(
				-half + VAULT_WIDTH / 2 + (k - 1) * VAULT_WIDTH,
				0,
				-COLUMN * VAULT_SPACING - VAULT_DEPTH / 2
			)
			frame = CFrame.new(center) -- local +Z already faces the plaza
		end
		local function at(x: number, y: number, z: number): CFrame
			return frame * CFrame.new(x, y, z)
		end
		local color = palette[i]
		local folder = Instance.new("Folder")
		folder.Name = `Base{i}`
		folder.Parent = bases

		-- An open platform (Tsunami style): a pale studded floor with a hint of the owner's colour
		local floor = block(
			"Floor",
			Vector3.new(VAULT_WIDTH, 1, VAULT_DEPTH),
			at(0, 0.1, 0),
			FLOOR_PINK:Lerp(color, 0.12),
			folder
		)
		Toy.Dress(floor, nil, 1, 4)
		-- Walls, gate towers and the gate itself depend on the owner's wall tier (VaultWalls)
		local wallFolder = Instance.new("Folder")
		wallFolder.Name = "Walls"
		wallFolder.Parent = folder
		local walls = VaultWalls.Build(wallFolder, frame, color, 1)
		-- The storeys. Each has its own folder so the vault can grow: decks with a hole at the back
		-- middle, a ladder up from the floor below, a glass rail along the open front, the walkway
		-- and ten plates (slots 1-10 ground, 11-20 next floor, ...)
		local deckColor = FLOOR_PINK:Lerp(color, 0.12)
		local floorFolders: { Folder } = {}
		local slotCFrames: { CFrame }, slotPads: { BasePart }, slotRims: { BasePart } = {}, {}, {}
		local cashPads: { BasePart }, cashLabels: { TextLabel } = {}, {}
		local inner = VAULT_WIDTH / 2 - 0.5
		local back, front = -VAULT_DEPTH / 2 + 0.5, VAULT_DEPTH / 2 - 0.5
		for level = 1, FLOORS do
			local levelFolder = Instance.new("Folder")
			levelFolder.Name = `Floor{level}`
			levelFolder.Parent = folder
			floorFolders[level] = levelFolder
			local y = (level - 1) * FLOOR_HEIGHT
			local surface = if level == 1 then 0.6 else y
			if level > 1 then
				-- The deck is whole except a slot in front of the ladder (where you climb through);
				-- behind the ladder is a small landing you step onto at the top, Roblox-ladder style
				local landing = back + LADDER_LANDING
				local holeTo = landing + 2 + LADDER_HOLE
				local function deck(minX: number, maxX: number, minZ: number, maxZ: number)
					local piece = block(
						"Deck",
						Vector3.new(maxX - minX, 1, maxZ - minZ),
						at((minX + maxX) / 2, y - 0.5, (minZ + maxZ) / 2),
						deckColor,
						levelFolder
					)
					Toy.Dress(piece, nil, 1, 4)
				end
				deck(-inner, inner, back, landing) -- the landing
				deck(-inner, inner, holeTo, front) -- the floor
				for _, deckSide in { -1, 1 } do
					local a, b = deckSide * LADDER_HOLE_HALF, deckSide * inner
					deck(math.min(a, b), math.max(a, b), landing, holeTo)
				end
				local glass = block(
					"RailGlass",
					Vector3.new(inner * 2, 3.5, 0.3),
					at(0, y + 1.75, front - 0.2),
					Color3.fromRGB(190, 240, 255),
					levelFolder
				)
				glass.Material = Enum.Material.Glass
				glass.Transparency = 0.6
				block("RailCap", Vector3.new(inner * 2, 0.4, 0.6), at(0, y + 3.6, front - 0.2), NAVY, levelFolder)
				-- The ladder from the floor below, poking up through the hole so you can step off
				local truss = Instance.new("TrussPart")
				truss.Name = "Ladder"
				truss.Anchored = true
				-- From the floor below up to just over this deck: climb, then keep pushing to step onto the
				-- landing behind it
				local bottom = if level == 2 then 0.6 else y - FLOOR_HEIGHT
				truss.Size = Vector3.new(2, FLOOR_HEIGHT, 2)
				truss.CFrame = at(0, bottom + FLOOR_HEIGHT / 2, landing + 1)
				truss.Transparency = 1 -- climbable, but the ladder you see is drawn below
				truss.Parent = levelFolder
				-- The ladder you see: two chunky navy rails and bright yellow rungs, and a yellow trim
				-- round the hole so it's easy to spot from across the vault
				local ladderZ = landing + 1
				for _, railSide in { -1, 1 } do
					local rail = block(
						"LadderRail",
						Vector3.new(0.45, FLOOR_HEIGHT + 2.5, 0.45),
						at(railSide * 1.15, bottom + (FLOOR_HEIGHT + 2.5) / 2, ladderZ + 0.7),
						NAVY,
						levelFolder
					)
					rail.CanCollide = false
					rail.CanQuery = false
					Toy.Dress(rail, Toy.Sides, 1, 0)
				end
				for rungY = bottom + 1, bottom + FLOOR_HEIGHT - 0.4, 1.6 do
					local rung = block(
						"LadderRung",
						Vector3.new(2.3, 0.3, 0.35),
						at(0, rungY, ladderZ + 0.7),
						Color3.fromRGB(255, 205, 40),
						levelFolder
					)
					rung.CanCollide = false
					rung.CanQuery = false
				end
				for _, trim in
					{
						{ Vector3.new(LADDER_HOLE_HALF * 2 + 0.6, 0.12, 0.3), Vector3.new(0, y + 0.06, holeTo) },
						{
							Vector3.new(0.3, 0.12, holeTo - landing),
							Vector3.new(-LADDER_HOLE_HALF, y + 0.06, (landing + holeTo) / 2),
						},
						{
							Vector3.new(0.3, 0.12, holeTo - landing),
							Vector3.new(LADDER_HOLE_HALF, y + 0.06, (landing + holeTo) / 2),
						},
					}
				do
					local edge = block(
						"HoleTrim",
						trim[1],
						at(trim[2].X, trim[2].Y, trim[2].Z),
						Color3.fromRGB(255, 205, 40),
						levelFolder
					)
					edge.CanCollide = false
					edge.CanQuery = false
				end
			end
			-- The walkway down the middle, from the gate to the ladder
			-- (it stops where the ladder hole starts, so the cut-out reads as a hole)
			local walkFrom = back + LADDER_LANDING + 2 + LADDER_HOLE
			local walk = block(
				"Walkway",
				Vector3.new(WALK_HALF * 2, 0.06, front - walkFrom),
				at(0, surface + 0.03, (front + walkFrom) / 2),
				Color3.fromRGB(226, 230, 242),
				levelFolder
			)
			walk.CanCollide = false
			walk.CanQuery = false
			Toy.Dress(walk, nil, 1, 0)
			for index = 1, SLOTS_PER_FLOOR do
				local plateSide = if index <= #PLATE_Z then -1 else 1
				local x, z = plateSide * PLATE_X, PLATE_Z[(index - 1) % #PLATE_Z + 1]
				local slot = (level - 1) * SLOTS_PER_FLOOR + index
				-- A plain flat plate on the floor (Tsunami style), nothing else
				local plate = block(
					`Pedestal{slot}`,
					Vector3.new(0.3, PLATE_RADIUS * 2, PLATE_RADIUS * 2),
					at(x, surface + 0.15, z) * CFrame.Angles(0, 0, math.rad(90)),
					CYAN,
					levelFolder
				)
				plate.Shape = Enum.PartType.Cylinder
				plate.CanCollide = false
				slotPads[slot] = plate
				slotRims[slot] = plate
				-- The money pad between the plate and the walkway (Tsunami style): the knife's
				-- earnings pile up here until its owner walks over it
				-- The panel's +Z faces the plate, so the text reads from the walkway.
				local padAt = at(plateSide * (WALK_HALF + 2.2), surface + 0.06, z).Position
				local towardPlate = frame:VectorToWorldSpace(Vector3.new(plateSide, 0, 0))
				local cashPad = block(
					`CashPad{slot}`,
					Vector3.new(3.8, 0.12, 5.2),
					-- (a SurfaceGui on a Top face runs along the part's Z: turned so it reads across)
					CFrame.lookAt(padAt, padAt - towardPlate) * CFrame.Angles(0, math.pi / 2, 0),
					Color3.fromRGB(150, 240, 160),
					levelFolder
				)
				cashPad.Transparency = 1
				cashPad.CanCollide = false
				cashPad.CanQuery = false
				local padGui = Instance.new("SurfaceGui")
				padGui.Face = Enum.NormalId.Top
				padGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				padGui.PixelsPerStud = 40
				padGui.LightInfluence = 0
				padGui.Brightness = 0.85 -- full-bright signs, a touch softer than pure white
				padGui.MaxDistance = 70
				padGui.Parent = cashPad
				local panel = Instance.new("Frame")
				panel.AnchorPoint = Vector2.new(0.5, 0.5)
				panel.Position = UDim2.fromScale(0.5, 0.5)
				panel.Size = UDim2.new(1, -12, 1, -12)
				panel.Parent = padGui
				SignTheme.surface(panel, SignTheme.Green)
				SignTheme.cashIcon(panel, UDim2.fromScale(0.09, 0.07), UDim2.fromScale(0.2, 0.28))
				local collect = Instance.new("TextLabel")
				collect.Name = "Collect"
				collect.Position, collect.Size = UDim2.fromScale(0.29, 0.08), UDim2.fromScale(0.62, 0.24)
				collect.Text = "COLLECT"
				collect.Parent = panel
				SignTheme.text(collect, 24)
				local padText = Instance.new("TextLabel")
				padText.AnchorPoint = Vector2.new(0.5, 0.5)
				padText.Name = "Amount"
				padText.Position = UDim2.fromScale(0.5, 0.63)
				padText.Size = UDim2.fromScale(0.9, 0.5)
				padText.Text = ""
				padText.Parent = panel
				SignTheme.text(padText, 54)
				cashPads[slot] = cashPad
				cashLabels[slot] = padText
				-- The knife floats upright over the plate, a little tilted
				slotCFrames[slot] = at(x, surface + 4.2, z) * CFrame.Angles(0, 0, math.rad(KNIFE_TILT))
			end
		end

		-- The owner's sign rides on top of the frame (BaseService moves it as the vault grows)
		local signPart = block("Sign", Vector3.new(20, 5, 1), at(0, 18, -VAULT_DEPTH / 2 + 1.5), NAVY, folder)
		signPart.Transparency = 1
		signPart.CanCollide = false
		signPart.CanQuery = false
		local sign = label(
			signPart,
			"Empty Vault",
			color,
			UDim2.fromScale(24, 5),
			frame:VectorToWorldSpace(Vector3.new(0, 0, 1.5))
		);
		(sign.Parent :: BillboardGui).Enabled = false

		-- The Haunted Wheel: a giant iron wheel you run inside to train Speed (the plate at the bottom
		-- is what counts as "on it"). Clients spin it while its owner is training. It stands just
		-- outside the vault's gate, so the inside is nothing but knives.
		local wheelCenter = Vector3.new(-13, 6.6, VAULT_DEPTH / 2 + 7.5)
		-- The Upgrade Base sign on the other side of the gate (client/Hud fills it in for its owner)
		local upgradeSign = Instance.new("Model")
		upgradeSign.Name = "UpgradeSign"
		block("Post", Vector3.new(0.6, 4, 0.6), at(13, 2, VAULT_DEPTH / 2 + 6), Color3.fromRGB(70, 46, 28), upgradeSign)
		local signBoard = block(
			"Board",
			Vector3.new(7, 4, 0.5),
			at(13, 5.4, VAULT_DEPTH / 2 + 6) * CFrame.Angles(math.rad(-12), 0, 0),
			Color3.fromRGB(34, 26, 40),
			upgradeSign
		)
		local signGui = Instance.new("SurfaceGui")
		signGui.Name = "Gui"
		-- The board's front (-Z) looks into the vault; its back faces the plaza
		signGui.Face = Enum.NormalId.Back
		signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		signGui.PixelsPerStud = 40
		signGui.LightInfluence = 0
		signGui.Brightness = 0.85 -- full-bright signs, a touch softer than pure white
		signGui.MaxDistance = 80
		signGui.Parent = signBoard
		upgradeSign.Parent = folder
		local wheel = Instance.new("Model")
		wheel.Name = "HauntedWheel"
		local hub = block(
			"Hub",
			Vector3.new(7.4, 1.2, 1.2),
			at(wheelCenter.X, wheelCenter.Y, wheelCenter.Z),
			Color3.fromRGB(50, 46, 58),
			wheel
		)
		hub.Shape = Enum.PartType.Cylinder
		hub.Material = Enum.Material.Metal
		hub.CanCollide = false
		hub.Transparency = 1 -- just the pivot; a bar here would go through the runner's head
		for _, x in { -3.9, 3.9 } do
			local cap = block(
				"AxleCap",
				Vector3.new(1.4, 1.2, 1.2),
				at(wheelCenter.X + x, wheelCenter.Y, wheelCenter.Z),
				Color3.fromRGB(50, 46, 58),
				wheel
			)
			cap.Shape = Enum.PartType.Cylinder
			cap.Material = Enum.Material.Metal
			cap.CanCollide = false
		end
		local iron = NAVY
		local radius, segments = 6, 16
		for k = 0, segments - 1 do
			local angle = k / segments * math.pi * 2
			local oy, oz = math.cos(angle) * radius, math.sin(angle) * radius
			for _, x in { -3.4, 3.4 } do
				local rim = block(
					"Rim",
					Vector3.new(0.5, 0.5, 2 * math.pi * radius / segments + 0.1),
					at(wheelCenter.X + x, wheelCenter.Y + oy, wheelCenter.Z + oz) * CFrame.Angles(angle, 0, 0),
					iron,
					wheel
				)
				rim.Material = Enum.Material.Metal
				rim.CanCollide = false
			end
			-- Rungs across the inside, like a hamster wheel
			local rung = block(
				"Rung",
				Vector3.new(6.8, 0.25, 0.4),
				at(wheelCenter.X, wheelCenter.Y + oy * 0.97, wheelCenter.Z + oz * 0.97) * CFrame.Angles(angle, 0, 0),
				Color3.new(1, 1, 1),
				wheel
			)
			rung.CanCollide = false
			if k % 4 == 0 then
				local spoke = block(
					"Spoke",
					Vector3.new(0.4, radius, 0.4),
					at(wheelCenter.X - 3.4, wheelCenter.Y + oy / 2, wheelCenter.Z + oz / 2) * CFrame.Angles(angle, 0, 0),
					iron,
					wheel
				)
				spoke.CanCollide = false
				-- Ghost lights riding the rim
				local wisp = block(
					"Wisp",
					Vector3.one * 0.8,
					at(wheelCenter.X + 3.4, wheelCenter.Y + oy, wheelCenter.Z + oz),
					color,
					wheel
				)
				wisp.Shape = Enum.PartType.Ball
				wisp.Material = Enum.Material.Neon
				wisp.CanCollide = false
			end
		end
		wheel.PrimaryPart = hub
		-- Streams in as one piece, and remembers its resting position so clients can spin it
		-- around the right spot even if they see the model before all its parts arrive
		wheel.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		wheel:SetAttribute("Pivot", hub.CFrame)
		wheel:AddTag("HauntedWheel")
		wheel.Parent = folder
		-- Stands holding the axle
		for _, x in { -4.4, 4.4 } do
			block("WheelStand", Vector3.new(0.8, 7, 1.2), at(wheelCenter.X + x, 3.5, wheelCenter.Z), iron, folder).Material =
				Enum.Material.Metal
		end
		-- The plate you stand on inside the bottom of the wheel
		local belt = block("WheelFloor", Vector3.new(6, 0.4, 5), at(wheelCenter.X, 0.8, wheelCenter.Z), CYAN, folder)
		Toy.Dress(belt, nil, 1, 0)
		local wheelSign =
			block("WheelSign", Vector3.new(6, 1.6, 0.4), at(wheelCenter.X, 13.2, wheelCenter.Z), NAVY, folder)
		local treadmillSign = label(wheelSign, "Creaky Wheel", color, UDim2.fromScale(9, 2), Vector3.new(0, 0.2, 1)) -- under the vault's own sign

		-- Spawn just inside the door, facing out towards the plaza and the runway
		local spawnPos = (at(0, 4, VAULT_DEPTH / 2 - 10)).Position
		table.insert(MapService.Bases, {
			Index = i,
			Color = color,
			Folder = folder,
			WallFolder = wallFolder,
			Gate = walls.Gate,
			Blocker = walls.Blocker,
			SignPart = signPart,
			Center = center,
			Frame = frame,
			-- Rotated 90 degrees, so the world footprint swaps width and depth
			Bounds = if sideways
				then bounds(center, VAULT_DEPTH, VAULT_WIDTH)
				else bounds(center, VAULT_WIDTH, VAULT_DEPTH),
			Spawn = CFrame.lookAt(spawnPos, spawnPos + frame:VectorToWorldSpace(Vector3.zAxis)),
			SlotCFrames = slotCFrames,
			SlotPads = slotPads,
			SlotRims = slotRims,
			FloorFolders = floorFolders,
			CashPads = cashPads,
			CashLabels = cashLabels,
			Treadmill = belt,
			TreadmillSign = treadmillSign,
			Wheel = wheel,
			Sign = sign,
		})
	end

	-- The plaza between the two columns of vaults, out to the hub's outer wall
	local plaza = block(
		"Plaza",
		Vector3.new(HUB_HALF * 2, 1, HUB_BACK),
		CFrame.new(0, -0.3, -HUB_BACK / 2),
		Toy.Grass, -- the same grass as the runway: one place
		bases
	)
	Toy.Dress(plaza, nil, 1, 5)
	-- One dirt wall all the way round the hub, so you can't wander off anywhere: the two sides,
	-- the back behind the plaza, and the shoulders joining them to the runway walls
	local wallX = HUB_HALF + WALL_THICK / 2
	for _, side in { -1, 1 } do
		Toy.DirtWall(
			block(
				"HubWall",
				Vector3.new(WALL_THICK, WALL_HEIGHT, HUB_BACK + WALL_THICK * 2),
				CFrame.new(side * wallX, WALL_HEIGHT / 2, -HUB_BACK / 2),
				Toy.Dirt,
				bases
			)
		)
		local from, to = half, HUB_HALF + WALL_THICK
		Toy.DirtWall(
			block(
				"HubWall",
				Vector3.new(to - from, WALL_HEIGHT, WALL_THICK),
				CFrame.new(side * (from + to) / 2, WALL_HEIGHT / 2, WALL_THICK / 2),
				Toy.Dirt,
				bases
			)
		)
	end
	Toy.DirtWall(
		block(
			"HubWall",
			Vector3.new(HUB_HALF * 2 + WALL_THICK * 2, WALL_HEIGHT, WALL_THICK),
			CFrame.new(0, WALL_HEIGHT / 2, -HUB_BACK - WALL_THICK / 2),
			Toy.Dirt,
			bases
		)
	)
end

-- The whole hub is a floating island in the sky: under every floor hangs a studded block of earth
-- that narrows in steps, and puffy clouds drift around and below. Cosmetic only: nothing here collides.
local function buildIsland()
	local island = Instance.new("Folder")
	island.Name = "Island"
	island.Parent = root
	local rng = Random.new(77)
	local function deco(name: string, size: Vector3, cframe: CFrame, color: Color3): Part
		local p = block(name, size, cframe, color, island)
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		return p
	end

	local half = GameConfig.ArenaWidth / 2
	local runwayEnd = GameConfig.ZoneDepth * #GameConfig.Zones
	local footprints = {
		{ -half - WALL_THICK, half + WALL_THICK, 0, runwayEnd + WALL_THICK }, -- the runway
		{ -HUB_HALF - WALL_THICK, HUB_HALF + WALL_THICK, -HUB_BACK - WALL_THICK, WALL_THICK }, -- plaza + vaults
		{ -72, 72, runwayEnd, runwayEnd + 52 }, -- the Manor
	}
	-- Earth under each floor: three layers, each narrower and darker, studs on the sides
	local layers = {
		{ Inset = 0, Height = 7, Color = Color3.fromRGB(160, 108, 62) },
		{ Inset = 10, Height = 12, Color = Color3.fromRGB(132, 88, 52) },
		{ Inset = 26, Height = 16, Color = Color3.fromRGB(104, 70, 46) },
	}
	local sides = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
	for _, f in footprints do
		local minX, maxX, minZ, maxZ = f[1], f[2], f[3], f[4]
		local top = -0.8
		for _, layer in layers do
			local sizeX = maxX - minX - layer.Inset * 2
			local sizeZ = maxZ - minZ - layer.Inset * 2
			if sizeX > 4 and sizeZ > 4 then
				local slab = deco(
					"Earth",
					Vector3.new(sizeX, layer.Height, sizeZ),
					CFrame.new((minX + maxX) / 2, top - layer.Height / 2, (minZ + maxZ) / 2),
					layer.Color
				)
				Toy.Dress(slab, sides, 1, 4)
			end
			top -= layer.Height
		end
	end

	-- Puffy cartoon clouds: clusters of white balls around the island and drifting far below it
	local function cloud(at: Vector3, scale: number)
		for _ = 1, rng:NextInteger(4, 7) do
			local size = rng:NextNumber(10, 22) * scale
			local puff = deco(
				"Cloud",
				Vector3.new(size, size * 0.8, size),
				CFrame.new(
					at
						+ Vector3.new(
							rng:NextNumber(-1.6, 1.6) * size,
							rng:NextNumber(0, 0.4) * size,
							rng:NextNumber(-0.8, 0.8) * size
						)
				),
				Color3.fromRGB(250, 252, 255)
			)
			puff.Shape = Enum.PartType.Ball
		end
	end
	for _ = 1, 28 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		cloud(
			Vector3.new(side * rng:NextNumber(190, 480), rng:NextNumber(-90, 50), rng:NextNumber(-350, runwayEnd + 250)),
			rng:NextNumber(0.8, 1.6)
		)
	end
	for _ = 1, 16 do
		cloud(
			Vector3.new(rng:NextNumber(-260, 260), rng:NextNumber(-160, -80), rng:NextNumber(-300, runwayEnd + 200)),
			rng:NextNumber(1.2, 2)
		)
	end
	-- Overhead: drifting above the runway and plaza, high enough to never get in the way
	for _ = 1, 45 do
		cloud(
			Vector3.new(rng:NextNumber(-220, 220), rng:NextNumber(85, 150), rng:NextNumber(-350, runwayEnd + 150)),
			rng:NextNumber(1, 2.2)
		)
	end
	-- Just past the walls at eye level, so the sky around you is full of them
	for _ = 1, 30 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		cloud(
			Vector3.new(side * rng:NextNumber(150, 230), rng:NextNumber(20, 70), rng:NextNumber(-320, runwayEnd + 100)),
			rng:NextNumber(0.9, 1.6)
		)
	end
end

-- Round maps are real buildings (RoundMaps); a random one is rebuilt at the start of each round
function MapService.RoundMapFolder(): Instance?
	return root and root:FindFirstChild("RoundMap")
end

local ROUND_SCALE = 1.5 -- the buildings are built at 1x and scaled up: roomier, longer chases

function MapService.BuildRoundMap(name: string?): RoundMaps.Built
	local built = RoundMaps.Build(root, MapService.RoundCenter, name)
	local center = MapService.RoundCenter
	local folder = root:FindFirstChild("RoundMap")
	if folder then
		-- People stay the same size, so everything around them gets bigger
		local model = Instance.new("Model")
		for _, child in folder:GetChildren() do
			child.Parent = model
		end
		model.WorldPivot = CFrame.new(center)
		model:ScaleTo(ROUND_SCALE)
		for _, child in model:GetChildren() do
			child.Parent = folder
		end
		model:Destroy()
		for i, spawn in built.Spawns do
			built.Spawns[i] = CFrame.new(center + (spawn.Position - center) * ROUND_SCALE) * spawn.Rotation
		end
		built.Size *= ROUND_SCALE
	end
	MapService.RoundSpawns = built.Spawns
	MapService.RoundMapSize = built.Size
	return built
end

-- Sunny day everywhere: one even light, so lamps, torches, auras, glowing knives and the round
-- maps' room lamps carry no Light (neon and particles still glow).
local function noLights()
	local function check(instance: Instance)
		if instance:IsA("Light") then
			instance:Destroy()
		end
	end
	for _, d in workspace:GetDescendants() do
		check(d)
	end
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("Light") then
			task.defer(check, d)
		end
	end)
end

-- Shows the vault's first `count` storeys (the rest wait out of the world until they're bought)
function MapService.SetFloors(base: BaseSite, count: number)
	for level, levelFolder in base.FloorFolders do
		levelFolder.Parent = if level <= count then base.Folder else nil
	end
end

function MapService.Init()
	-- Clear out the template place's baseplate and default spawn; the map below replaces them
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end
	root = Instance.new("Folder")
	root.Name = "Map"
	root.Parent = workspace

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = MapService.LobbySpawn - Vector3.new(0, 3.3, 0)
	spawn.Color = Color3.fromRGB(62, 60, 72)
	spawn.Material = Enum.Material.Slate
	spawn.Duration = 0
	spawn.Parent = root

	buildLighting()
	buildArena()
	buildBases()
	buildIsland()
	ManorDecor.Build(root, MapService.Arena :: Bounds, MapService.Hideaways)
	-- Nothing from the plaza decor in the way of the wheels outside the vault gates
	for _, base in MapService.Bases do
		ManorDecor.ClearArea((base.Wheel.PrimaryPart :: BasePart).Position, 9, 9)
		MapService.SetFloors(base, 1)
	end
	MapService.BuildRoundMap("Office")
	noLights()
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux: game passes and developer products (Config/Monetization).
--   * passes: checked on join and on purchase, mirrored to the player as attribute Pass_<Key>
--     (server-set, so it can't be faked). Other services just read the attribute:
--       DoubleCash / VIP   BaseService.IncomeMultiplier      FastWheel  BaseService training
--       Fortified          BaseService.RefreshWalls          VIP        Rewards free chest, the tag
--       MurdererLuck       RoundService.pickMurderer
--   * products: MarketplaceService.ProcessReceipt. Every PurchaseId is granted once (kept in the
--     profile) and the save is written before Roblox is told it's granted; if that save fails the
--     receipt is retried later and the stored PurchaseId stops it being granted twice.
--   * Studio: anything whose id is still 0 can be "bought" for free through Remotes.StoreTest.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Monetization = require(ReplicatedStorage.Shared.Config.Monetization)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local Offers = require(script.Parent.Offers)
local RaidService = require(script.Parent.RaidService)
local StealService = require(script.Parent.StealService)

local MonetizationService = {}

local MAX_RECEIPTS = 60

local passById: { [number]: Monetization.Pass } = {}
local productById: { [number]: Monetization.Product } = {}
for _, pass in Monetization.Passes do
	if pass.Id > 0 then
		passById[pass.Id] = pass
	end
end
for _, product in Monetization.Products do
	if product.Id > 0 then
		productById[product.Id] = product
	end
end

-- VIP tag ------------------------------------------------------------------------------------

-- A gold "VIP" over the head in the hub (hidden in rounds: disguises must stay anonymous)
local function refreshTag(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local tag = head:FindFirstChild("VIPTag") :: BillboardGui?
	local show = player:GetAttribute("Pass_VIP") == true and not player:GetAttribute("InRound")
	if show and not tag then
		local gui = Instance.new("BillboardGui")
		gui.Name = "VIPTag"
		gui.Size = UDim2.fromOffset(90, 30)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 90
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = "👑 VIP"
		label.TextColor3 = Color3.fromRGB(255, 205, 60)
		label.TextStrokeTransparency = 0
		label.Parent = gui
	elseif tag then
		tag.Enabled = show
	end
end

-- Passes -------------------------------------------------------------------------------------

local function grantPass(player: Player, key: string, announce: boolean)
	if player:GetAttribute("Pass_" .. key) then
		return
	end
	player:SetAttribute("Pass_" .. key, true)
	local pass = Monetization.PassByKey[key]
	if key == "Fortified" then
		local base = BaseService.GetBase(player)
		if base then
			BaseService.RefreshWalls(base)
		end
	elseif key == "DoubleCash" or key == "VIP" then
		BaseService.RefreshRack(player) -- income readouts
	end
	if key == "VIP" then
		refreshTag(player)
	end
	if announce and pass then
		Net.Notify(player, `{pass.Icon} {pass.Name} unlocked! Thank you!`, "good")
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Net.Remotes.Effect:FireAllClients("Deposit", player, "Legendary")
		end
	end
end

local function checkPasses(player: Player)
	for _, pass in Monetization.Passes do
		if pass.Id > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns and player.Parent then
				grantPass(player, pass.Key, false)
			end
		end
	end
end

-- Products -----------------------------------------------------------------------------------

local function caseValue(rarity: string): number
	for _, entry in GameConfig.CaseShop do
		if entry.Rarity == rarity then
			return entry.Cost
		end
	end
	return 0
end

-- Gives what a product contains. Returns false if it can't be given right now (try again later).
local function grantProduct(player: Player, product: Monetization.Product): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	local key = product.Key
	if product.OneTime and table.find(profile.Bought, key) then
		-- Bought twice somehow: never lose their Robux, pay out the cash part twice instead
		local cash = if product.Cash then GameConfig.Pay(product.Cash, BaseService.RackIncome(player)) else 0
		DataService.AddCash(player, cash * 2 + (if product.Case then caseValue(product.Case) else 0))
		return true
	end

	local got: { string } = {}
	if product.Cash then
		local cash = GameConfig.Pay(product.Cash, BaseService.RackIncome(player))
		DataService.AddCash(player, cash)
		Net.Remotes.Effect:FireClient(player, "CashBurst", nil, cash)
		table.insert(got, `{Format.Cash(cash)}`)
	end
	if product.Tickets then
		local amount = product.Tickets
		DataService.Update(player, function(p)
			p.Tickets += amount
		end)
		table.insert(got, `{amount} Murderer Tickets`)
	end
	if product.Case then
		StealService.OpenCase(player, product.Case, true)
		table.insert(got, `a {product.Case} Case`)
	end
	if key == "Mount" then
		if profile.Slots < GameConfig.MaxSlots then
			DataService.Update(player, function(p)
				p.Slots = math.min(GameConfig.MaxSlots, p.Slots + GameConfig.SlotsPerFloor)
			end)
			BaseService.RefreshRack(player)
			table.insert(got, "a new vault floor")
		else
			-- Already maxed: their Robux turn into the cash a mount would have cost
			local value = GameConfig.SlotCost(profile.Slots)
			DataService.AddCash(player, value)
			table.insert(got, `{Format.Cash(value)} (your vault was already maxed)`)
		end
	elseif key == "HealthBoost" then
		local before = profile.HealthLevel
		local after = math.min(before + 3, GameConfig.Health.MaxLevel)
		if after > before then
			DataService.Update(player, function(p)
				p.HealthLevel = after
			end)
			table.insert(got, `+{after - before} Health levels`)
		end
		-- Anything past the max comes back as the cash those levels would have cost
		local refund = 0
		for level = after, before + 2 do
			refund += GameConfig.HealthCost(level)
		end
		if refund > 0 then
			DataService.AddCash(player, refund)
			table.insert(got, `{Format.Cash(refund)} (health was maxed)`)
		end
	elseif key == "Repair" then
		RaidService.RepairFull(player)
		table.insert(got, "a fully repaired gate")
	elseif key == "ServerLuck" then
		local config = Monetization.ServerLuck
		local now = workspace:GetServerTimeNow()
		local current = ReplicatedStorage:GetAttribute("ServerLuckUntil")
		local from = if type(current) == "number" and current > now then current else now
		ReplicatedStorage:SetAttribute("ServerLuckMultiplier", config.Multiplier)
		ReplicatedStorage:SetAttribute("ServerLuckUntil", from + config.Minutes * 60)
		Net.Announce(
			`🍀 {player.DisplayName} activated {config.Multiplier}x SERVER LUCK for everyone!`,
			Color3.fromRGB(90, 230, 120),
			3
		)
		table.insert(got, "Server Luck")
	elseif key == "ChestRefill" then
		DataService.Update(player, function(p)
			p.NextFreeChest = 0
		end)
		table.insert(got, "a full free chest")
	elseif key == "BloodMoon" then
		RaidService.Summon(player)
		table.insert(got, "the Thief Moon")
	end
	if product.OneTime then
		DataService.Update(player, function(p)
			table.insert(p.Bought, key)
		end)
		player:SetAttribute("Bought_" .. key, true)
	end
	if #got > 0 then
		Net.Notify(player, `{product.Icon} Thank you! You got {table.concat(got, ", ")}`, "good")
	end
	return true
end

local function processReceipt(info: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local profile = player and DataService.Get(player)
	if not player or not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if table.find(profile.Receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = productById[info.ProductId]
	if not product then
		warn(`[Monetization] unknown product {info.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(grantProduct, player, product)
	if not ok or not granted then
		warn(`[Monetization] couldn't grant {product.Key} to {player.Name}: {granted}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.Update(player, function(p)
		table.insert(p.Receipts, purchaseId)
		while #p.Receipts > MAX_RECEIPTS do
			table.remove(p.Receipts, 1)
		end
	end)
	if not DataService.SaveNow(player) then
		-- Roblox will retry; the PurchaseId is already recorded, so it won't be granted twice
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Studio: "buy" things whose ids aren't filled in yet, to test them for free
local lastTest: { [Player]: number } = {}
local function storeTest(player: Player, kind: unknown, key: unknown): boolean
	if not RunService:IsStudio() or type(key) ~= "string" then
		return false
	end
	if os.clock() - (lastTest[player] or 0) < 0.5 then
		return false
	end
	lastTest[player] = os.clock()
	if kind == "Pass" and Monetization.PassByKey[key] then
		grantPass(player, key, true)
		return true
	elseif kind == "Product" and Monetization.ProductByKey[key] then
		return grantProduct(player, Monetization.ProductByKey[key])
	end
	return false
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, passId: number, purchased: boolean)
			local pass = passById[passId]
			if purchased and pass then
				grantPass(player, pass.Key, true)
			end
		end
	)
	Net.Remotes.StoreTest.OnServerInvoke = storeTest

	local function setup(player: Player)
		player:SetAttribute("JoinedAt", os.time())
		task.spawn(checkPasses, player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			refreshTag(player)
		end)
		player:GetAttributeChangedSignal("InRound"):Connect(function()
			refreshTag(player)
		end)
	end
	for _, player in Players:GetPlayers() do
		setup(player)
	end
	Players.PlayerAdded:Connect(setup)
	Players.PlayerRemoving:Connect(function(player)
		lastTest[player] = nil
	end)

	-- The Starter Pack, once, right after the guide (they know the game by then)
	Net.Remotes.Tutorial.OnServerEvent:Connect(function(player: Player, step: unknown)
		if step == "Done" or step == "Skip" then
			task.delay(6, function()
				Offers.Show(
					player,
					"Starter",
					"Welcome to Blackwood! A one-time head start, just for new players.",
					true
				)
			end)
		end
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Obstacles</string>
            <string name="Source"><![CDATA[--!strict
-- Breakable things in the way: Barricades (the Innocent Power) for now. Guards, burglars and the
-- Murderer (player or bot) ask here whether something blocks them and smash it instead of walking
-- through. Whoever creates an obstacle says what a hit does.

local Obstacles = {}

export type Obstacle = {
	Part: BasePart,
	Owner: Player?,
	Hit: (by: string) -> (), -- by: "Guard" | "Murderer" | "Burglar" | "Player"
}

local list: { Obstacle } = {}

function Obstacles.Add(obstacle: Obstacle): () -> ()
	table.insert(list, obstacle)
	return function()
		local index = table.find(list, obstacle)
		if index then
			table.remove(list, index)
		end
	end
end

local function closestPoint(part: BasePart, point: Vector3): Vector3
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local half = part.Size / 2
	return part.CFrame:PointToWorldSpace(
		Vector3.new(
			math.clamp(localPoint.X, -half.X, half.X),
			math.clamp(localPoint.Y, -half.Y, half.Y),
			math.clamp(localPoint.Z, -half.Z, half.Z)
		)
	)
end

-- The obstacle within `range` of `position` (in front of `look`, if given)
function Obstacles.Near(position: Vector3, range: number, look: Vector3?): Obstacle?
	local best: Obstacle? = nil
	local bestDistance = range
	for _, obstacle in list do
		if not obstacle.Part.Parent then
			continue
		end
		local offset = closestPoint(obstacle.Part, position) - position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local distance = flat.Magnitude
		local facing = if look and distance > 0.5 then look:Dot(flat.Unit) else 1
		if distance <= bestDistance and facing > 0 then
			best, bestDistance = obstacle, distance
		end
	end
	return best
end

-- Would moving from `from` to `to` (a body `radius` wide) run into one?
function Obstacles.Blocks(from: Vector3, to: Vector3, radius: number): Obstacle?
	for _, obstacle in list do
		local part = obstacle.Part
		if not part.Parent then
			continue
		end
		local localTo = part.CFrame:PointToObjectSpace(to)
		local half = part.Size / 2 + Vector3.new(radius, 0, radius)
		if math.abs(localTo.X) <= half.X and math.abs(localTo.Z) <= half.Z then
			-- Only if it's moving into it (not already inside, walking out)
			local localFrom = part.CFrame:PointToObjectSpace(from)
			if math.abs(localFrom.X) > half.X or math.abs(localFrom.Z) > half.Z then
				return obstacle
			end
		end
	end
	return nil
end

return Obstacles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Offers</string>
            <string name="Source"><![CDATA[--!strict
-- Contextual store offers: "here's the thing that fixes what just happened" (short on cash, wall
-- full, gate under attack, just robbed...). Any service can call Offers.Show without pulling in
-- the whole MonetizationService. Rate limited hard (Monetization.OfferGap and friends) and never
-- shown during a round, so it never feels like spam.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Monetization = require(ReplicatedStorage.Shared.Config.Monetization)
local Net = require(script.Parent.Parent.Remotes)

local Offers = {}

local lastAny: { [Player]: number } = {}
local lastByKey: { [Player]: { [string]: number } } = {}

-- Whether `player` already has this (owned pass, or a one-time pack they've bought)
function Offers.Has(player: Player, key: string): boolean
	if Monetization.PassByKey[key] then
		return player:GetAttribute("Pass_" .. key) == true
	end
	local product = Monetization.ProductByKey[key]
	return product ~= nil and product.OneTime == true and player:GetAttribute("Bought_" .. key) == true
end

-- `early` skips the first-minutes grace period (the Starter Pack right after the tutorial)
function Offers.Show(player: Player, key: string, reason: string, early: boolean?)
	if not player.Parent or player:GetAttribute("InRound") or Offers.Has(player, key) then
		return
	end
	if not Monetization.PassByKey[key] and not Monetization.ProductByKey[key] then
		return
	end
	local joined = player:GetAttribute("JoinedAt")
	local grace = if RunService:IsStudio() then 10 else Monetization.FirstOfferAfter
	if not early and type(joined) == "number" and os.time() - joined < grace then
		return
	end
	local now = os.clock()
	local gap = if RunService:IsStudio() then 20 else Monetization.OfferGap
	if now - (lastAny[player] or -math.huge) < gap then
		return
	end
	local byKey = lastByKey[player] or {}
	lastByKey[player] = byKey
	if now - (byKey[key] or -math.huge) < Monetization.SameOfferGap then
		return
	end
	lastAny[player] = now
	byKey[key] = now
	Net.Remotes.Offer:FireClient(player, key, reason)
end

-- Short on cash: offer the smallest cash pack that covers the gap
function Offers.Cash(player: Player, short: number, income: number)
	if short <= 0 then
		return
	end
	for _, key in { "CashSmall", "CashMedium", "CashBig" } do
		local product = Monetization.ProductByKey[key]
		if product and product.Cash and GameConfig.Pay(product.Cash, income) >= short then
			Offers.Show(player, key, `Only {Format.Cash(math.ceil(short))} short? This covers it right now.`)
			return
		end
	end
	Offers.Show(player, "CashBig", "Need a big boost? Four hours of income, right now.")
end

Players.PlayerRemoving:Connect(function(player)
	lastAny[player] = nil
	lastByKey[player] = nil
end)

return Offers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PowerService</string>
            <string name="Source"><![CDATA[--!strict
-- Innocent Powers. Bought for good with cash (what your knives earn), upgraded to level 3, and
-- equipped in a loadout of PowerSlots. Every power works everywhere:
--   * in the arena against guards, on a cooldown
--   * in raids against raiders and burglars (same cooldowns)
--   * in rounds against the Murderer, paid for with Energy: you start each round with a little
--     and every coin you grab adds more (the Murderer can't use them)
-- The client only asks (Remotes.Power / Remotes.UsePower); everything is checked here.
-- State the HUD reads: player attributes PowerReady_<id> (server time), Energy, MaxEnergy.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local GuardService = require(script.Parent.GuardService)
local Obstacles = require(script.Parent.Obstacles)
local Offers = require(script.Parent.Offers)
local Stealth = require(script.Parent.Stealth)
local Targets = require(script.Parent.Targets)

type PowerConfig = {
	Id: string,
	DisplayName: string,
	Description: string,
	Cost: number,
	Color: Color3,
	Duration: { number },
	Energy: { number },
	Hits: { number }?,
	RoundDuration: { number }?, -- rounds use this instead of Duration when set
	RoundUses: number?, -- most uses per round
	Cooldown: number,
}

type Trap = {
	Model: Model,
	Owner: Player,
	Position: Vector3,
	Round: boolean,
	Stun: number,
	Expires: number,
	Home: boolean, -- set inside the owner's own vault: it waits there for intruders
}
type Decoy = { Model: Model, Owner: Player, Pop: () -> () }

local PowerService = {}
PowerService.CanRaidPlayer = nil :: ((Player, Player) -> boolean)?

local byId: { [string]: PowerConfig } = {}
for _, power in GameConfig.Powers do
	byId[power.Id] = power :: PowerConfig
end

local lastRequest: { [Player]: number } = {}
local energy: { [Player]: number? } = {} -- in a round
local roundUses: { [Player]: { [string]: number } } = {} -- powers used this round (RoundUses caps)
-- Others who react to a Flash (RoundService: Murderer bots; RaidService: burglars and raiders).
-- Called with (flasher, origin, look, range, duration).
local flashHandlers: { (Player, Vector3, Vector3, number, number, number) -> () } = {}
local traps: { Trap } = {}
local decoys: { Decoy } = {}
local effectsFolder: Folder

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function levelOf(player: Player, id: string): number
	local profile = DataService.Get(player)
	return if profile then profile.Powers[id] or 0 else 0
end

local function stat(values: { number }, level: number): number
	return values[math.clamp(level, 1, #values)]
end

local function floorUnder(position: Vector3, ignore: { Instance }): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(position, Vector3.new(0, -12, 0), params)
	return if hit then hit.Position else position - Vector3.new(0, 3, 0)
end

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Shop / loadout ----------------------------------------------------------------------------

local function handlePower(player: Player, action: unknown, id: unknown): boolean
	local now = os.clock()
	if now - (lastRequest[player] or 0) < 0.25 then
		return false
	end
	lastRequest[player] = now
	local profile = DataService.Get(player)
	if not profile or type(action) ~= "string" then
		return false
	end

	if action == "Slot" then
		if profile.PowerSlots >= GameConfig.MaxPowerSlots then
			Net.Notify(player, "You already have every power slot!", "bad")
			return false
		end
		if not DataService.TrySpend(player, GameConfig.PowerSlotCost) then
			Net.Notify(player, "Not enough cash", "bad")
			return false
		end
		DataService.Update(player, function(p)
			p.PowerSlots += 1
		end)
		Net.Notify(player, "New power slot unlocked!", "good")
		return true
	end

	local power = type(id) == "string" and byId[id] or nil
	if not power then
		return false
	end
	local level = profile.Powers[power.Id] or 0

	if action == "Buy" then
		if level >= GameConfig.PowerMaxLevel then
			Net.Notify(player, `{power.DisplayName} is maxed!`, "bad")
			return false
		end
		local cost = GameConfig.PowerCost(power.Cost, level)
		if not DataService.TrySpend(player, cost) then
			Net.Notify(player, "Not enough cash", "bad")
			Offers.Cash(player, cost - profile.Cash, BaseService.RackIncome(player))
			return false
		end
		DataService.Update(player, function(p)
			p.Powers[power.Id] = level + 1
			-- First unlock goes straight into a free slot
			if level == 0 and #p.Loadout < p.PowerSlots then
				table.insert(p.Loadout, power.Id)
			end
		end)
		Net.Notify(
			player,
			if level == 0 then `{power.DisplayName} unlocked!` else `{power.DisplayName} upgraded to level {level + 1}!`,
			"good"
		)
		return true
	elseif action == "Equip" then
		if level == 0 or table.find(profile.Loadout, power.Id) then
			return false
		end
		if #profile.Loadout >= profile.PowerSlots then
			Net.Notify(player, "Your loadout is full - unequip a power first", "bad")
			return false
		end
		DataService.Update(player, function(p)
			table.insert(p.Loadout, power.Id)
		end)
		return true
	elseif action == "Unequip" then
		local index = table.find(profile.Loadout, power.Id)
		if not index then
			return false
		end
		DataService.Update(player, function(p)
			table.remove(p.Loadout, index)
		end)
		return true
	end
	return false
end

-- The powers ------------------------------------------------------------------------------

-- Radar: see through walls. Rounds: the Murderer, once their knife is out (no free reveals). Arena: every guard, outlined in the colour of
-- the knife it carries, plus knives lying on the floor.
local function radar(player: Player, duration: number)
	local entries: { any } = {} -- { Model, Color } pairs for the client
	if player:GetAttribute("InRound") then
		for _, other in Players:GetPlayers() do
			if
				other:GetAttribute("InRound")
				and other:GetAttribute("Role") == "Murderer"
				and other:GetAttribute("KnifeOut")
				and other.Character
			then
				table.insert(entries, { Model = other.Character, Color = Color3.fromRGB(255, 40, 50) })
			end
		end
		for _, bot in CollectionService:GetTagged("RoundBot") do
			if bot:GetAttribute("Role") == "Murderer" and bot:GetAttribute("KnifeOut") then
				table.insert(entries, { Model = bot, Color = Color3.fromRGB(255, 40, 50) })
			end
		end
	else
		local canRaidPlayer = PowerService.CanRaidPlayer
		if canRaidPlayer then
			for _, other in Players:GetPlayers() do
				if other.Character and canRaidPlayer(player, other) then
					table.insert(entries, { Model = other.Character, Color = Color3.fromRGB(255, 100, 70) })
				end
			end
		end
		if ReplicatedStorage:GetAttribute("Raid") then
			for _, burglar in CollectionService:GetTagged("Burglar") do
				table.insert(entries, { Model = burglar, Color = Color3.fromRGB(255, 180, 70) })
			end
		end
		for _, guard in GuardService.All() do
			local knife = Knives.ByName[guard.KnifeName]
			table.insert(entries, {
				Model = guard.Model,
				Color = if knife then Knives.RarityColors[knife.Rarity] else Color3.new(1, 1, 1),
			})
		end
		local map = workspace:FindFirstChild("Map")
		local drops = map and map:FindFirstChild("DroppedKnives")
		if drops then
			for _, drop in drops:GetChildren() do
				table.insert(entries, { Model = drop, Color = Color3.fromRGB(255, 255, 255) })
			end
		end
	end
	if player:GetAttribute("InRound") and #entries == 0 then
		Net.Notify(player, "No knife drawn... the Murderer is hiding among you.", "info")
	end
	Net.Remotes.Effect:FireClient(player, "Radar", entries, duration)
end

-- Bear Trap: snaps on the next guard (arena) or Murderer (round) that steps in
local function placeTrap(player: Player, stun: number)
	local root = rootOf(player)
	if not root then
		return
	end
	-- One trap each; a new one replaces the old
	for i = #traps, 1, -1 do
		if traps[i].Owner == player then
			traps[i].Model:Destroy()
			table.remove(traps, i)
		end
	end
	local ignore: { Instance } = { effectsFolder }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local at = floorUnder(root.Position, ignore)
	local model = Instance.new("Model")
	model.Name = `Trap_{player.Name}`
	local metal = Color3.fromRGB(120, 120, 130)
	local base = part(
		model,
		"Base",
		Vector3.new(0.3, 3.2, 3.2),
		CFrame.new(at + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		metal,
		Enum.Material.Metal
	)
	base.Shape = Enum.PartType.Cylinder
	part(
		model,
		"Plate",
		Vector3.new(1, 0.15, 1),
		CFrame.new(at + Vector3.new(0, 0.32, 0)),
		Color3.fromRGB(170, 140, 60),
		Enum.Material.Metal
	)
	for i = 0, 7 do
		local angle = i * math.pi / 4
		part(
			model,
			"Tooth",
			Vector3.new(0.25, 0.6, 0.25),
			CFrame.new(at + Vector3.new(math.cos(angle) * 1.4, 0.45, math.sin(angle) * 1.4)),
			Color3.fromRGB(200, 200, 210),
			Enum.Material.Metal
		)
	end
	model.Parent = effectsFolder
	local inRound = player:GetAttribute("InRound") == true
	local home = not inRound and BaseService.IsInOwnBase(player, at)
	if home then
		-- One home trap at a time: the new one replaces the old
		for i = #traps, 1, -1 do
			if traps[i].Home and traps[i].Owner == player then
				traps[i].Model:Destroy()
				table.remove(traps, i)
			end
		end
		Net.Notify(player, "Trap set in your vault - it waits for intruders", "good")
	end
	table.insert(traps, {
		Model = model,
		Owner = player,
		Position = at,
		Round = inRound,
		Stun = stun,
		Expires = if home then math.huge else os.clock() + 45,
		Home = home,
	})
end

local function snap(trap: Trap)
	Net.Remotes.Effect:FireAllClients("TrapSnap", trap.Position)
	trap.Model:Destroy()
end

local function nearTrap(trap: Trap, position: Vector3, radius: number): boolean
	local offset = position - trap.Position
	return math.abs(offset.Y) <= 6 and (offset * Vector3.new(1, 0, 1)).Magnitude < radius
end

local function stepTraps()
	local now = os.clock()
	for i = #traps, 1, -1 do
		local trap = traps[i]
		local sprung = false
		if now > trap.Expires or not trap.Owner.Parent then
			trap.Model:Destroy()
			table.remove(traps, i)
			continue
		end
		do
			local canRaidPlayer = PowerService.CanRaidPlayer
			for _, other in Players:GetPlayers() do
				local root = rootOf(other)
				local eligible = if trap.Round
					then other:GetAttribute("InRound") and other:GetAttribute("Role") == "Murderer"
					else canRaidPlayer ~= nil and canRaidPlayer(trap.Owner, other)
				if root and eligible then
					if nearTrap(trap, root.Position, 3) then
						other:SetAttribute("StunnedUntil", workspace:GetServerTimeNow() + trap.Stun)
						BaseService.RefreshWalkSpeed(other)
						if other.Character then
							Net.Animate(other.Character, "Hurt")
						end
						Net.Notify(other, "SNAP! You stepped in a bear trap!", "bad")
						task.delay(trap.Stun, function()
							BaseService.RefreshWalkSpeed(other)
						end)
						sprung = true
						break
					end
				end
			end
		end
		if not trap.Round and not sprung then
			for _, guard in GuardService.All() do
				if nearTrap(trap, guard.Position, 3.5) then
					GuardService.Stun(guard, trap.Stun)
					sprung = true
					break
				end
			end
		end
		if sprung then
			snap(trap)
			table.remove(traps, i)
		end
	end
end

-- Shield: a bubble that eats the next hit (arena: for a while; round: until it's used)
local function shield(player: Player, duration: number)
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return
	end
	local inRound = player:GetAttribute("InRound") == true
	character:SetAttribute("ShieldUntil", workspace:GetServerTimeNow() + (if inRound then 9999 else duration))
	local old = character:FindFirstChild("ShieldBubble")
	if old then
		old:Destroy()
	end
	local bubble = Instance.new("Part")
	bubble.Name = "ShieldBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.one * 7
	bubble.Material = Enum.Material.ForceField
	bubble.Color = Color3.fromRGB(90, 180, 255)
	bubble.Transparency = 0.3
	bubble.CanCollide = false
	bubble.CanQuery = false
	bubble.CanTouch = false
	bubble.Massless = true
	bubble.CFrame = root.CFrame
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = bubble
	weld.Parent = bubble
	bubble.Parent = character
	-- The bubble goes when the shield is used up or runs out
	local connection
	connection = character:GetAttributeChangedSignal("ShieldUntil"):Connect(function()
		if character:GetAttribute("ShieldUntil") == nil then
			connection:Disconnect()
			bubble:Destroy()
		end
	end)
	if not inRound then
		task.delay(duration, function()
			if bubble.Parent then
				character:SetAttribute("ShieldUntil", nil)
			end
		end)
	end
end

-- Decoy: a copy of you that sprints off; whoever was after you follows it until they catch it
local function decoy(player: Player, duration: number)
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return
	end
	character.Archivable = true
	local ok, clone = pcall(character.Clone, character)
	local model = (clone :: any) :: Model?
	if not ok or not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("Tool") or d:IsA("Sound") or d.Name == "ShieldBubble" then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
		end
	end
	local decoyRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart
	decoyRoot.Anchored = true
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.EvaluateStateMachine = false
	model.Name = `Decoy_{player.Name}`
	model.Parent = effectsFolder

	-- Run away from the closest threat, or straight ahead
	local direction = root.CFrame.LookVector
	local threatPos: Vector3? = nil
	if player:GetAttribute("InRound") then
		for _, other in Players:GetPlayers() do
			local r = rootOf(other)
			if r and other:GetAttribute("InRound") and other:GetAttribute("Role") == "Murderer" then
				threatPos = r.Position
			end
		end
	else
		local best = math.huge
		for _, guard in GuardService.All() do
			local d = (guard.Position - root.Position).Magnitude
			if d < best then
				best, threatPos = d, guard.Position
			end
		end
	end
	if threatPos then
		local away = (root.Position - threatPos) * Vector3.new(1, 0, 1)
		if away.Magnitude > 0.1 then
			-- Off at an angle, so it doesn't run in a straight line from you
			direction = (CFrame.Angles(0, math.rad(math.random(-50, 50)), 0) * away.Unit)
		end
	end
	direction = Vector3.new(direction.X, 0, direction.Z).Unit

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://507767714" -- R15 run
		local trackOk, track = pcall(animator.LoadAnimation, animator, animation)
		if trackOk then
			track.Looped = true
			track:Play()
		end
	end

	local entry: Decoy
	local connection: RBXScriptConnection
	local popped = false
	local function pop()
		if popped then
			return
		end
		popped = true
		connection:Disconnect()
		Net.Remotes.Effect:FireAllClients("Smoke", decoyRoot.Position)
		model:Destroy()
		local index = table.find(decoys, entry)
		if index then
			table.remove(decoys, index)
		end
	end
	entry = { Model = model, Owner = player, Pop = pop }
	table.insert(decoys, entry)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { effectsFolder, character }
	local speed = 18
	local position = decoyRoot.Position
	local started = os.clock()
	connection = RunService.Heartbeat:Connect(function(dt)
		if os.clock() - started > duration then
			pop()
			return
		end
		-- Turn when something's in the way
		local ahead = workspace:Raycast(position, direction * 4, params)
		if ahead then
			direction = (CFrame.Angles(0, math.rad(if math.random() < 0.5 then 90 else -90), 0) * direction)
		end
		position += direction * speed * dt
		decoyRoot.CFrame = CFrame.lookAt(position, position + direction)
	end)
	GuardService.Lure(player, decoyRoot, duration, pop)
end

-- The Murderer swiping at a decoy pops it (RoundService calls this on every swing)
-- Round traps also catch a Murderer bot (Studio bot rounds): returns the stun time if one snapped
function PowerService.SpringRoundTrap(position: Vector3): number?
	for i = #traps, 1, -1 do
		local trap = traps[i]
		if trap.Round and nearTrap(trap, position, 3) then
			snap(trap)
			table.remove(traps, i)
			return trap.Stun
		end
	end
	return nil
end

function PowerService.SpringRaidTrap(position: Vector3): number?
	for i = #traps, 1, -1 do
		local trap = traps[i]
		if not trap.Round and os.clock() <= trap.Expires and nearTrap(trap, position, 3.5) then
			snap(trap)
			table.remove(traps, i)
			return trap.Stun
		end
	end
	return nil
end

function PowerService.PopDecoyNear(position: Vector3, range: number): boolean
	for _, entry in table.clone(decoys) do
		local r = entry.Model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r and (r.Position - position).Magnitude <= range then
			entry.Pop()
			return true
		end
	end
	return false
end

-- Mimic: hide the body and become a piece of furniture until you move
local PROPS = { "Crate", "Barrel", "Plant", "Chair", "Lamp" }
local function buildProp(kind: string, at: CFrame, parent: Instance): BasePart
	local wood = Color3.fromRGB(150, 105, 60)
	if kind == "Crate" then
		return part(
			parent,
			"Crate",
			Vector3.new(3.6, 3.6, 3.6),
			at * CFrame.new(0, -1.2, 0),
			wood,
			Enum.Material.WoodPlanks
		)
	elseif kind == "Barrel" then
		local b = part(
			parent,
			"Barrel",
			Vector3.new(4, 3, 3),
			at * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(120, 75, 40),
			Enum.Material.Wood
		)
		b.Shape = Enum.PartType.Cylinder
		return b
	elseif kind == "Plant" then
		local pot =
			part(parent, "Pot", Vector3.new(2.2, 2.2, 2.2), at * CFrame.new(0, -2, 0), Color3.fromRGB(170, 95, 60))
		local leaves = part(
			parent,
			"Leaves",
			Vector3.new(3.6, 3.6, 3.6),
			at * CFrame.new(0, 0.6, 0),
			Color3.fromRGB(60, 150, 60),
			Enum.Material.Grass
		)
		leaves.Shape = Enum.PartType.Ball
		return pot
	elseif kind == "Chair" then
		local seat =
			part(parent, "Seat", Vector3.new(2.6, 0.5, 2.6), at * CFrame.new(0, -1.1, 0), wood, Enum.Material.Wood)
		part(parent, "Back", Vector3.new(2.6, 3, 0.4), at * CFrame.new(0, 0.6, 1.1), wood, Enum.Material.Wood)
		part(
			parent,
			"Legs",
			Vector3.new(2.2, 1.6, 2.2),
			at * CFrame.new(0, -2.2, 0),
			wood:Lerp(Color3.new(0, 0, 0), 0.3)
		)
		return seat
	end
	local pole = part(
		parent,
		"Pole",
		Vector3.new(0.4, 5, 0.4),
		at * CFrame.new(0, -0.6, 0),
		Color3.fromRGB(40, 40, 45),
		Enum.Material.Metal
	)
	local shade = part(
		parent,
		"Shade",
		Vector3.new(2.4, 1.4, 2.4),
		at * CFrame.new(0, 2.2, 0),
		Color3.fromRGB(255, 220, 160),
		Enum.Material.Neon
	)
	local light = Instance.new("PointLight")
	light.Range = 10
	light.Color = Color3.fromRGB(255, 210, 150)
	light.Parent = shade
	return pole
end

local function mimic(player: Player, duration: number)
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return
	end
	Stealth.Reveal(player)
	local undo = Stealth.Hide(player)
	if not undo then
		return
	end
	Net.Remotes.Effect:FireAllClients("Smoke", root.Position)
	local prop = Instance.new("Model")
	prop.Name = `Mimic_{player.Name}`
	local yaw = math.random() * math.pi * 2
	buildProp(PROPS[math.random(1, #PROPS)], CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0), prop)
	-- The disguise moves with you (prop-hunt style), so it works mid-run too: weld it to the root
	for _, d in prop:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanTouch = false
			d.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	prop.Parent = effectsFolder
	player:SetAttribute("Mimic", true)
	local finished = false
	local connection: RBXScriptConnection
	local function finish()
		if finished then
			return
		end
		finished = true
		connection:Disconnect()
		Stealth.Unregister(player, finish)
		player:SetAttribute("Mimic", nil)
		prop:Destroy()
		undo()
		local r = rootOf(player)
		if r then
			Net.Remotes.Effect:FireAllClients("Smoke", r.Position)
		end
	end
	Stealth.Register(player, finish)
	local started = os.clock()
	connection = RunService.Heartbeat:Connect(function()
		-- Only dying or the time running out ends it (walking around in it is the fun part)
		if not rootOf(player) or os.clock() - started > duration then
			finish()
		end
	end)
end

-- Flash: a blinding camera flash. Everything within FLASH_BURST of you is caught whichever way
-- you face, and the beam reaches FLASH_RANGE in a wide cone where you aim (the client sends its
-- camera aim: people mostly flash over their shoulder while running away).
local FLASH_RANGE = 40
local FLASH_BURST = 24
local FLASH_CONE = math.cos(math.rad(55))
local function flash(player: Player, duration: number, aim: unknown)
	local root = rootOf(player)
	if not root then
		return
	end
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local look = root.CFrame.LookVector
	if typeof(aim) == "Vector3" then
		local flat = Vector3.new((aim :: Vector3).X, 0, (aim :: Vector3).Z)
		if flat.Magnitude > 0.01 and flat.Magnitude == flat.Magnitude then
			look = flat.Unit
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { effectsFolder, player.Character :: Model }
	local function inCone(position: Vector3, model: Instance?): boolean
		local offset = position - origin
		local distance = offset.Magnitude
		local inBurst = distance <= FLASH_BURST
		if distance > FLASH_RANGE or (not inBurst and look:Dot(offset.Unit) < FLASH_CONE) then
			return false
		end
		-- Walls block the light
		local hit = workspace:Raycast(origin, offset, params)
		return hit == nil or (model ~= nil and hit.Instance:IsDescendantOf(model))
	end
	Net.Remotes.Effect:FireAllClients("Flash", origin, look)
	local now = workspace:GetServerTimeNow()
	if player:GetAttribute("InRound") then
		for _, other in Players:GetPlayers() do
			local r = rootOf(other)
			if r and other:GetAttribute("InRound") and other:GetAttribute("Role") == "Murderer" then
				if inCone(r.Position, other.Character) then
					other:SetAttribute("StunnedUntil", now + duration)
					BaseService.RefreshWalkSpeed(other)
					Net.Remotes.Effect:FireClient(other, "Blinded", duration)
					Net.Animate(other.Character :: Model, "Hurt")
					Net.Notify(other, "FLASH! You can't see!", "bad")
					Net.Notify(player, "You blinded the Murderer! RUN!", "good")
					task.delay(duration, function()
						BaseService.RefreshWalkSpeed(other)
					end)
				end
			end
		end
	else
		for _, guard in GuardService.All() do
			if inCone(guard.Position, guard.Model) then
				GuardService.Stun(guard, duration)
			end
		end
	end
	for _, handler in flashHandlers do
		handler(player, origin, look, FLASH_RANGE, duration, FLASH_BURST)
	end
end

-- Barricade: a wooden barricade slams down in front of you. Solid to everyone; guards, burglars,
-- raiders and the Murderer have to smash it (Hits stabs) to get through.
local function barricade(player: Player, duration: number, hits: number)
	local root = rootOf(player)
	if not root then
		return
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local ignore: { Instance } = { effectsFolder }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local center = root.Position + look * 4.5
	local floor = floorUnder(center + Vector3.new(0, 2, 0), ignore)
	local frame = CFrame.lookAt(floor, floor + look)
	local model = Instance.new("Model")
	model.Name = `Barricade_{player.Name}`
	local wood = Color3.fromRGB(150, 98, 54)
	-- The solid core (what blocks and gets hit)
	local core =
		part(model, "Core", Vector3.new(10, 8, 1.2), frame * CFrame.new(0, 4, 0), wood, Enum.Material.WoodPlanks)
	core.CanCollide = true
	core.CanQuery = true
	core.Transparency = 1
	-- Planks, crossed boards and nails
	for i = 0, 4 do
		local plank = part(
			model,
			"Plank",
			Vector3.new(10.4, 1.3, 0.4),
			frame * CFrame.new(0, 0.9 + i * 1.6, 0) * CFrame.Angles(0, 0, math.rad((i % 2) * 4 - 2)),
			wood:Lerp(Color3.fromRGB(90, 60, 35), (i % 3) / 4),
			Enum.Material.WoodPlanks
		)
		plank.CanCollide = false
	end
	for _, angle in { 38, -38 } do
		part(
			model,
			"Brace",
			Vector3.new(12, 0.9, 0.35),
			frame * CFrame.new(0, 4, -0.35) * CFrame.Angles(0, 0, math.rad(angle)),
			Color3.fromRGB(110, 72, 40),
			Enum.Material.Wood
		)
	end
	for _, x in { -4.6, 4.6 } do
		part(
			model,
			"Post",
			Vector3.new(0.9, 8.6, 0.9),
			frame * CFrame.new(x, 4.3, 0.4),
			Color3.fromRGB(85, 55, 30),
			Enum.Material.Wood
		)
	end
	model.PrimaryPart = core
	model.Parent = effectsFolder
	Net.Remotes.Effect:FireAllClients("Barricade", core.Position)

	local health = hits
	local removeObstacle: () -> ()
	local removeTarget: () -> ()
	local function smash()
		if not model.Parent then
			return
		end
		removeObstacle()
		removeTarget()
		Net.Remotes.Effect:FireAllClients("Smash", core.Position)
		model:Destroy()
	end
	local function hit()
		health -= 1
		Net.Remotes.Effect:FireAllClients("Hit", core.Position)
		if health <= 0 then
			smash()
		else
			-- Knocked crooked a little more each hit
			for _, d in model:GetChildren() do
				if d:IsA("BasePart") and d ~= core then
					d.CFrame *= CFrame.Angles(0, 0, math.rad(math.random(-5, 5)))
				end
			end
		end
	end
	removeObstacle = Obstacles.Add({
		Part = core,
		Owner = player,
		Hit = function(_by: string)
			hit()
		end,
	})
	-- Other players' hub knives can smash it too (raiders)
	removeTarget = Targets.Add({
		Part = core,
		Model = model,
		Solid = true,
		CanHit = function(attacker: Player)
			return attacker ~= player
		end,
		Hit = function()
			hit()
		end,
	})
	task.delay(duration, smash)
	-- Rounds end: it goes too
	local connection: RBXScriptConnection
	connection = player:GetAttributeChangedSignal("InRound"):Connect(function()
		connection:Disconnect()
		smash()
	end)
end

-- Using a power -----------------------------------------------------------------------------

local function publishRound(player: Player)
	player:SetAttribute("Energy", energy[player])
	player:SetAttribute("MaxEnergy", if energy[player] then GameConfig.MaxEnergy else nil)
end

-- Coins in rounds charge your powers
function PowerService.AddEnergy(player: Player, amount: number)
	if energy[player] == nil then
		return
	end
	energy[player] = math.min(GameConfig.MaxEnergy, (energy[player] :: number) + amount)
	publishRound(player)
end

-- handler(flasher, origin, look, range, duration, burst): anything within `burst` is caught
-- whichever way the flasher faces; further out, only inside the cone along `look`
function PowerService.OnFlash(handler: (Player, Vector3, Vector3, number, number, number) -> ())
	table.insert(flashHandlers, handler)
end

local function usePower(player: Player, id: unknown, aim: unknown)
	if type(id) ~= "string" then
		return
	end
	local power = byId[id]
	local profile = DataService.Get(player)
	if not power or not profile or not table.find(profile.Loadout, id) or not rootOf(player) then
		return
	end
	local level = levelOf(player, id)
	if level < 1 then
		return
	end
	local inRound = player:GetAttribute("InRound") == true
	if inRound then
		if player:GetAttribute("Role") == "Murderer" then
			return -- the Murderer has their knife; powers are for innocents
		end
		if ReplicatedStorage:GetAttribute("Classic") then
			Net.Notify(player, "CLASSIC round: no powers this time!", "bad")
			return
		end
		-- One power per round (the first in your loadout), the same strength for everyone
		if profile.Loadout[1] ~= id then
			return
		end
		level = GameConfig.RoundPowerLevel
		local have = energy[player]
		local cost = stat(power.Energy, level)
		if not have then
			return
		end
		if have < cost then
			Net.Notify(player, `{power.DisplayName} needs {cost} Energy - grab coins!`, "bad")
			Net.Remotes.Effect:FireClient(player, "NoEnergy", id)
			return
		end
		-- Some powers are capped per round (Vanish), so nobody can just stay invisible
		local uses = roundUses[player] or {}
		roundUses[player] = uses
		if power.RoundUses and (uses[id] or 0) >= power.RoundUses then
			Net.Notify(player, `{power.DisplayName} is used up for this round!`, "bad")
			return
		end
		uses[id] = (uses[id] or 0) + 1
		energy[player] = have - cost
		publishRound(player)
	else
		local now = workspace:GetServerTimeNow()
		local readyAt = player:GetAttribute(`PowerReady_{id}`)
		if type(readyAt) == "number" and now < readyAt then
			return
		end
		player:SetAttribute(`PowerReady_{id}`, now + power.Cooldown)
	end

	local duration = stat(if inRound and power.RoundDuration then power.RoundDuration else power.Duration, level)
	if id == "Vanish" then
		Stealth.Vanish(player, duration)
		if inRound then
			-- The Murderer still catches a faint shimmer of you
			for _, other in Players:GetPlayers() do
				if other:GetAttribute("InRound") and other:GetAttribute("Role") == "Murderer" then
					Net.Remotes.Effect:FireClient(other, "Shimmer", player.Character, duration)
				end
			end
		end
	elseif id == "Radar" then
		radar(player, duration)
	elseif id == "Trap" then
		placeTrap(player, duration)
	elseif id == "Shield" then
		shield(player, duration)
	elseif id == "Decoy" then
		decoy(player, duration)
	elseif id == "Mimic" then
		mimic(player, duration)
	elseif id == "Flash" then
		flash(player, duration, aim)
	elseif id == "Barricade" then
		barricade(player, duration, stat(power.Hits or { 3 }, level))
	end
	player:SetAttribute("LastPower", id)
	player:SetAttribute("LastPowerAt", workspace:GetServerTimeNow())
	local root = rootOf(player)
	if root then
		Net.Remotes.Effect:FireClient(player, "PowerUsed", id, root.Position)
	end
end

-- Round start/end: hand out starting Energy, and clean everything up afterwards
local function onRoundChanged(player: Player)
	roundUses[player] = nil
	if player:GetAttribute("InRound") then
		energy[player] = if player:GetAttribute("Role") ~= "Murderer" then GameConfig.StartEnergy else nil
	else
		energy[player] = nil
		Stealth.Reveal(player)
		if player.Character then
			player.Character:SetAttribute("ShieldUntil", nil)
		end
		player:SetAttribute("StunnedUntil", nil)
		for i = #traps, 1, -1 do
			if traps[i].Owner == player and traps[i].Round then
				traps[i].Model:Destroy()
				table.remove(traps, i)
			end
		end
		for _, entry in table.clone(decoys) do
			if entry.Owner == player then
				entry.Pop()
			end
		end
	end
	publishRound(player)
end

function PowerService.Init()
	effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "PowerEffects"
	effectsFolder.Parent = workspace

	Net.Remotes.Power.OnServerInvoke = handlePower
	Net.Remotes.UsePower.OnServerEvent:Connect(usePower)

	local function watch(player: Player)
		player:GetAttributeChangedSignal("InRound"):Connect(function()
			-- Role is set right after InRound; wait a beat so the Murderer gets no uses
			task.defer(onRoundChanged, player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
		energy[player] = nil
		roundUses[player] = nil
		for _, entry in table.clone(decoys) do
			if entry.Owner == player then
				entry.Pop()
			end
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			stepTraps()
		end
	end)
end

return PowerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Ragdoll</string>
            <string name="Source"><![CDATA[--!strict
-- Classic murder-game deaths: the body goes limp and collapses to the floor with a death cry.
-- Every Motor6D is swapped for a limited BallSocketConstraint so R15 rigs fold up naturally.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage.Shared.Config.Sounds)

local Ragdoll = {}

function Ragdoll.Collapse(model: Model, push: Vector3?)
	for _, motor in model:GetDescendants() do
		-- Current R15 rigs use AnimationConstraints and already carry a BallSocketConstraint per
		-- joint; switching the animation joints off hands the body over to those sockets
		if motor:IsA("AnimationConstraint") then
			motor.Enabled = false
		elseif motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = "RagdollA0"
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "RagdollA1"
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local socket = Instance.new("BallSocketConstraint")
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.UpperAngle = 70
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = -45
			socket.TwistUpperAngle = 45
			socket.Parent = motor.Part0
			motor.Enabled = false
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			-- Limbs collide so the body lands on the floor instead of sinking through it
			local isLimb = part.Parent == model and part.Name ~= "HumanoidRootPart"
			part.CanCollide = isLimb
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and push then
		root:ApplyImpulse(push * root.AssemblyMass)
	end
end

-- Steal An Egg-style hit: a living player goes limp and is flung, then gets back up after
-- `seconds`. The joints go limp here (replicates to everyone); the fling itself is applied by the
-- player's own client (client/Tumble, from the TumblePush attribute) because their client owns the
-- body's physics - flinging from the server makes it freeze and snap on their screen.
-- Returns false if they're already tumbling (no stacking).
local tumbling: { [Player]: boolean } = {}
function Ragdoll.Tumble(player: Player, push: Vector3, seconds: number): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if tumbling[player] or not character or not humanoid or humanoid.Health <= 0 then
		return false
	end
	tumbling[player] = true
	local root = character:FindFirstChild("HumanoidRootPart")
	local joints: { AnimationConstraint } = {}
	for _, d in character:GetDescendants() do
		if d:IsA("AnimationConstraint") and d.Enabled then
			-- Keep the root joint: it's what ties the body to the (invisible) root part the fling
			-- moves. Without it the root flies off alone and the body flops where it was hit.
			local a0, a1 = d.Attachment0, d.Attachment1
			local onRoot = (a0 ~= nil and a0.Parent == root) or (a1 ~= nil and a1.Parent == root)
			if not onRoot then
				d.Enabled = false
				table.insert(joints, d)
			end
		end
	end
	humanoid.PlatformStand = true
	player:SetAttribute("TumblePush", push)
	player:SetAttribute("Tumbling", workspace:GetServerTimeNow() + seconds)
	task.delay(seconds, function()
		tumbling[player] = nil
		if player.Parent then
			player:SetAttribute("Tumbling", nil)
			player:SetAttribute("TumblePush", nil)
		end
		if not character.Parent or humanoid.Health <= 0 then
			return
		end
		for _, joint in joints do
			joint.Enabled = true
		end
		humanoid.PlatformStand = false
	end)
	return true
end

function Ragdoll.DeathCry(model: Model)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "DeathCry"
	sound.SoundId = Sounds.Death
	sound.Volume = 0.9
	sound.RollOffMaxDistance = 120
	sound.Parent = head
	sound:Play()
end

return Ragdoll
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">RaidService</string>
            <string name="Source"><![CDATA[--!strict
-- Break-ins, any time outside a round:
--   * every vault gate is a barrier you can break - knife swings and throws chip its health
--     (GameConfig.Walls). The owner is alerted the moment someone starts on it, can repair it
--     (R) and come home to stop them. A broken gate stays open for a bit, then reforges.
--   * inside a broken vault, anything on the wall except its owner's equipped knife can be
--     stolen (hold "Steal"); carry it home and it's yours
--   * hub knives knock down intruders and anyone carrying loot (never hurt them): they drop it.
--     A vault's owner who catches their thief gets the knife back, a bounty, and sends them home.
--   * a vault that just lost a knife is sealed for a while (GameConfig.Raid.RobbedSeal)
--   * gates can't be touched while their owner is in a round, during a round, or while the owner
--     still has the new-player shield
-- The Thief Moon (the "raid" in code) rises every few intermissions: burglars (NPCs) come for
-- everyone's knives, gates take more damage, bounties double and anyone outside their own vault can
-- be knocked down.
-- Getting robbed gives you revenge: for a while the thief's vault is open to you.
-- Knives on walls give off an aura (better knife, bigger aura) that slows anyone who isn't the
-- owner. State for clients lives in attributes: ReplicatedStorage Raid/RaidEndsAt/NextRaidAt,
-- gate Blockers (Health, MaxHealth, Open), players (KnockedUntil, RevengeOn, RevengeUntil,
-- AuraSlow, AuraFrom).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local AnimLibrary = require(ReplicatedStorage.Shared.AnimLibrary)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Props = require(ReplicatedStorage.Shared.Props)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local Disguises = require(script.Parent.Disguises)
local GuardService = require(script.Parent.GuardService)
local Offers = require(script.Parent.Offers)
local MapService = require(script.Parent.MapService)
local Obstacles = require(script.Parent.Obstacles)
local PowerService = require(script.Parent.PowerService)
local Ragdoll = require(script.Parent.Ragdoll)
local StealService = require(script.Parent.StealService)
local ServerEvents = require(script.Parent.ServerEvents)
local Targets = require(script.Parent.Targets)
local VaultWalls = require(script.Parent.VaultWalls)

local RaidService = {}

local CONFIG = GameConfig.Raid
local HALF_D = 22 -- vault depth / 2 (MapService)

type GateState = {
	Base: MapService.BaseSite,
	LastHit: number,
	LastAlert: number,
	BrokenUntil: number,
	RepairReadyAt: { [Player]: number },
	RemoveTarget: (() -> ())?,
}

type Burglar = {
	Model: Model,
	Root: BasePart,
	Name: string,
	Position: Vector3,
	Health: number,
	Dead: boolean,
	State: string, -- "ToGate" | "Bash" | "Enter" | "Steal" | "Escape" | "Taunt"
	Base: MapService.BaseSite?,
	Slot: number?,
	GateLane: number,
	Carrying: string?, -- item
	CarryOwner: number?,
	CarryVisual: Model?,
	Waypoints: { Vector3 },
	NextAction: number,
	StunnedUntil: number,
	Tracks: { [string]: AnimationTrack },
	Playing: string?,
	HealthFill: Frame,
	RemoveTarget: () -> (),
}

local gates: { [MapService.BaseSite]: GateState } = {}
-- Knives taken from each vault this raid, capped by BurglarStealsPerVault.
local takenFrom: { [MapService.BaseSite]: number } = {}
local burglars: { Burglar } = {}
local burglarFolder: Folder
local raiding = false
local raidEndsAt = 0
local raidGeneration = 0
local rng = Random.new()

local BURGLAR_NAMES = {
	"Sneaky Pete",
	"Slim Jim",
	"Burglar Bill",
	"Light-Fingers Lou",
	"Pockets",
	"The Weasel",
	"Quick Nick",
	"Shady Sal",
}
local ANIMATIONS: { [string]: string } = {
	Idle = "rbxassetid://507766388",
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function RaidService.IsRaiding(): boolean
	return raiding
end

-- Revenge: `player` may enter and rob `owner`'s vault right now
local function hasRevenge(player: Player, owner: Player): boolean
	local until_ = player:GetAttribute("RevengeUntil")
	return player:GetAttribute("RevengeOn") == owner.UserId and type(until_) == "number" and now() < until_
end

local function gateOpen(base: MapService.BaseSite): boolean
	return base.Blocker:GetAttribute("Open") == true
end

-- Why this vault's gate can't be attacked right now (nil = it can)
local function protectedReason(base: MapService.BaseSite, beforeRaid: boolean?): string?
	local owner = BaseService.OwnerOf(base)
	if not owner then
		return "Nobody lives here - nothing to steal"
	end
	if DataService.IsNewPlayer(owner) then
		local profile = DataService.Get(owner)
		local left = if profile then math.ceil((GameConfig.NewPlayerShield - profile.PlayTime) / 60) else 0
		return `🛡️ {owner.DisplayName} is new - protected for {math.max(1, left)} more min`
	end
	if owner:GetAttribute("InRound") then
		return `{owner.DisplayName} is in a round - come back after it`
	end
	if ReplicatedStorage:GetAttribute("Phase") ~= "Intermission" then
		return "Vaults are sealed during a round"
	end
	local sealed = owner:GetAttribute("SealedUntil")
	if not beforeRaid and type(sealed) == "number" and now() < sealed then
		return `🔒 {owner.DisplayName} was just robbed - sealed for {math.ceil(sealed - now())}s`
	end
	return nil
end

local function canBreak(base: MapService.BaseSite): boolean
	return protectedReason(base) == nil
end

-- Hitting a gate that's protected tells you why (not every swing)
local toldAt: { [Player]: number } = {}
local function tellProtected(attacker: Player, base: MapService.BaseSite, reason: string)
	local t = os.clock()
	if t - (toldAt[attacker] or 0) > 2.5 then
		toldAt[attacker] = t
		Net.Notify(attacker, reason, "info")
	end
	Net.Remotes.Effect:FireClient(attacker, "Shield", base.Blocker.Position)
end

-- Whether `player` may be inside `base` (owned by `owner`) right now
local function mayEnter(player: Player, base: MapService.BaseSite, owner: Player?): boolean
	if not owner or owner == player then
		return true
	end
	return canBreak(base) and (gateOpen(base) or hasRevenge(player, owner))
end

-- Who hub knives (and home traps, Flash, Radar) can go after: intruders in someone else's vault
-- and anyone carrying loot, any time; during the Thief Moon anyone who isn't home
function RaidService.CanAttackPlayer(attacker: Player, victim: Player): boolean
	if
		ReplicatedStorage:GetAttribute("Phase") ~= "Intermission"
		or attacker == victim
		or attacker:GetAttribute("InRound")
		or victim:GetAttribute("InRound")
		or DataService.IsNewPlayer(victim)
		or rootOf(attacker) == nil
	then
		return false
	end
	local root = rootOf(victim)
	if not root then
		return false
	end
	local _, vaultOwner = BaseService.BaseAt(root.Position)
	if vaultOwner == victim then
		return false -- safe at home
	end
	-- Hit my gate? Then you're fair game for me, anywhere in the hub, for a while
	if RaidService.IsMarkedBy(victim, attacker) then
		return true
	end
	return raiding or (vaultOwner ~= nil and vaultOwner ~= victim) or victim:GetAttribute("Carrying") ~= nil
end

-- Raiders: hitting someone's gate marks you as theirs to hunt (RaiderOf / RaiderUntil). Like the
-- watchmen, the owner's knife does real damage to you - a starter knife takes a few hits, a great
-- knife one-shots - and your Health level is what keeps you standing.
function RaidService.IsMarkedBy(raider: Player, owner: Player): boolean
	local until_ = raider:GetAttribute("RaiderUntil")
	return raider:GetAttribute("RaiderOf") == owner.UserId and type(until_) == "number" and now() < until_
end

local function markRaider(raider: Player, owner: Player)
	local fresh = not RaidService.IsMarkedBy(raider, owner)
	raider:SetAttribute("RaiderOf", owner.UserId)
	raider:SetAttribute("RaiderUntil", now() + CONFIG.RaiderMarkTime)
	if fresh then
		Net.Notify(raider, `You're raiding {owner.DisplayName}! They can fight back now - watch your health.`, "bad")
		Net.Notify(owner, `{raider.DisplayName} is raiding you! Your knife hurts them now - take them out!`, "bad")
	end
end

-- Gates ------------------------------------------------------------------------------------

local function refreshGateBar(base: MapService.BaseSite)
	local blocker = base.Blocker
	local gui = blocker:FindFirstChild("GateHealth") :: BillboardGui?
	if not gui then
		return
	end
	local health = (blocker:GetAttribute("Health") or 0) :: number
	local max = (blocker:GetAttribute("MaxHealth") or 1) :: number
	local owner = BaseService.OwnerOf(base)
	local shielded = owner ~= nil and DataService.IsNewPlayer(owner)
	gui.Enabled = owner ~= nil and (raiding or shielded or gateOpen(base) or health < max - 0.5)
	local fill = gui:FindFirstChild("Fill", true) :: Frame?
	if fill then
		fill.Size = UDim2.fromScale(math.clamp(health / max, 0, 1), 1)
	end
	local title = gui:FindFirstChild("Title") :: TextLabel?
	if title then
		title.Text = if gateOpen(base)
			then "BROKEN!"
			elseif shielded then `🛡️ {(owner :: Player).DisplayName} (new player)`
			else `{if owner then owner.DisplayName .. "'s " else ""}{GameConfig.Walls[(blocker:GetAttribute("Tier") or 1) :: number].Name}`
	end
end

local function breakGate(base: MapService.BaseSite, by: string)
	local state = gates[base]
	VaultWalls.SetOpen(base.Gate, true)
	base.Blocker:SetAttribute("Health", 0)
	state.BrokenUntil = now() + CONFIG.BrokenTime
	refreshGateBar(base)
	Net.Remotes.Effect:FireAllClients("GateBreak", base.Blocker.Position, base.Color)
	local owner = BaseService.OwnerOf(base)
	if owner then
		Net.Announce(`{by} broke into {owner.DisplayName}'s vault!`, Color3.fromRGB(255, 80, 70), 2)
		Net.Notify(owner, "YOUR GATE IS DOWN! Defend your knives!", "bad")
		Net.Remotes.Effect:FireClient(owner, "Alarm")
	end
end

local function damageGate(base: MapService.BaseSite, amount: number, by: string, attacker: Model?)
	if gateOpen(base) or not canBreak(base) then
		return
	end
	if raiding then
		amount *= CONFIG.BloodMoonGateDamage
	end
	local state = gates[base]
	local before = (base.Blocker:GetAttribute("Health") or 0) :: number
	local max = (base.Blocker:GetAttribute("MaxHealth") or 1) :: number
	local health = before - amount
	state.LastHit = now()
	local owner = BaseService.OwnerOf(base)
	local raider = attacker and Players:GetPlayerFromCharacter(attacker)
	if raider and owner and raider ~= owner then
		markRaider(raider, owner)
	end
	-- Someone just started on it: tell the owner straight away (not every hit)
	if owner and now() - state.LastAlert > 12 then
		state.LastAlert = now()
		Net.Notify(owner, `{by} is breaking into your vault! Get back and stop them!`, "bad")
		Net.Remotes.Effect:FireClient(owner, "Alarm")
		-- ...and who: outlined through walls for a while, so you can find them on the way home
		if attacker then
			Net.Remotes.Effect:FireClient(owner, "Radar", {
				{ Model = attacker, Color = Color3.fromRGB(255, 70, 60) },
			}, 8)
		end
	end
	-- Warn the owner as it goes down
	for _, mark in { 0.75, 0.5, 0.25 } do
		if owner and before > max * mark and health <= max * mark and health > 0 then
			Net.Notify(owner, `Your gate is at {math.floor(mark * 100)}%! {by} is breaking in!`, "bad")
			Net.Remotes.Effect:FireClient(owner, "Alarm")
			if mark == 0.5 then
				Offers.Show(owner, "Repair", `{by} is breaking in! Fix your gate instantly, wherever you are.`)
			end
		end
	end
	base.Blocker:SetAttribute("Health", math.max(0, health))
	Net.Remotes.Effect:FireAllClients("GateHit", base.Blocker.Position, amount)
	if health <= 0 then
		breakGate(base, by)
	else
		refreshGateBar(base)
	end
end

local function reforge(base: MapService.BaseSite, fraction: number)
	local max = (base.Blocker:GetAttribute("MaxHealth") or 1) :: number
	VaultWalls.SetOpen(base.Gate, false)
	base.Blocker:SetAttribute("Health", max * fraction)
	gates[base].BrokenUntil = 0
	refreshGateBar(base)
	Net.Remotes.Effect:FireAllClients("GateReforge", base.Blocker.Position, base.Color)
end

-- (Re)register a vault's gate as something knives can hit; called whenever its walls are rebuilt
local function trackGate(base: MapService.BaseSite)
	local state = gates[base]
	if not state then
		state = { Base = base, LastHit = 0, LastAlert = 0, BrokenUntil = 0, RepairReadyAt = {}, RemoveTarget = nil }
		gates[base] = state
	end
	if state.RemoveTarget then
		state.RemoveTarget()
	end
	state.BrokenUntil = 0
	state.RemoveTarget = Targets.Add({
		Part = base.Blocker,
		Model = base.Gate,
		Solid = true,
		CanHit = function(attacker: Player)
			-- Never your own gate. Empty vaults still take the swing, so the attacker hears why
			-- nothing happens.
			return BaseService.OwnerOf(base) ~= attacker and not attacker:GetAttribute("InRound") and not gateOpen(base)
		end,
		Hit = function(attacker: Player, damage: number, kind: string)
			if BaseService.OwnerOf(base) == attacker then
				return -- belt and braces: whatever path the hit came by
			end
			local reason = protectedReason(base)
			if reason then
				tellProtected(attacker, base, reason)
				return
			end
			damageGate(
				base,
				(if kind == "Throw" then damage * CONFIG.ThrowGateMultiplier else damage) * CONFIG.PlayerGateDamage,
				attacker.DisplayName,
				attacker.Character
			)
		end,
	})
	refreshGateBar(base)
end

local function onRepair(player: Player)
	local base = BaseService.GetBase(player)
	local root = rootOf(player)
	if not base or not root or gateOpen(base) then
		return
	end
	local state = gates[base]
	local t = now()
	if t < (state.RepairReadyAt[player] or 0) then
		return
	end
	if (root.Position - base.Blocker.Position).Magnitude > 16 then
		return
	end
	state.RepairReadyAt[player] = t + CONFIG.RepairCooldown
	local max = (base.Blocker:GetAttribute("MaxHealth") or 1) :: number
	local health = (base.Blocker:GetAttribute("Health") or 0) :: number
	base.Blocker:SetAttribute("Health", math.min(max, health + max * CONFIG.RepairAmount))
	refreshGateBar(base)
	Net.Remotes.Effect:FireAllClients("GateRepair", base.Blocker.Position, base.Color)
end

-- Instant Repair (Robux): the gate back to full, or rebuilt at full if it was broken
function RaidService.RepairFull(player: Player)
	local base = BaseService.GetBase(player)
	if not base then
		return
	end
	if gateOpen(base) then
		reforge(base, 1)
	else
		base.Blocker:SetAttribute("Health", base.Blocker:GetAttribute("MaxHealth"))
		refreshGateBar(base)
	end
	Net.Remotes.Effect:FireAllClients("GateRepair", base.Blocker.Position, base.Color)
end

-- Knockdowns -------------------------------------------------------------------------------

function RaidService.Knockdown(victim: Player, from: Vector3, by: string): boolean
	local character = victim.Character
	local root = rootOf(victim)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		ReplicatedStorage:GetAttribute("Phase") ~= "Intermission"
		or DataService.IsNewPlayer(victim)
		or not character
		or not root
		or not humanoid
		or victim:GetAttribute("InRound")
	then
		return false
	end
	local t = now()
	local knocked = victim:GetAttribute("KnockedUntil")
	local immune = victim:GetAttribute("KnockImmuneUntil")
	if (type(knocked) == "number" and t < knocked) or (type(immune) == "number" and t < immune) then
		return false
	end
	-- A Shield eats it
	local shieldUntil = character:GetAttribute("ShieldUntil")
	if type(shieldUntil) == "number" and t < shieldUntil then
		character:SetAttribute("ShieldUntil", nil)
		Net.Remotes.Effect:FireAllClients("Shield", root.Position)
		return false
	end
	StealService.ForceDrop(victim)
	local until_ = t + CONFIG.KnockdownTime
	victim:SetAttribute("KnockedUntil", until_)
	victim:SetAttribute("StunnedUntil", until_)
	BaseService.RefreshWalkSpeed(victim)
	humanoid.JumpHeight = 0
	-- Shoved back a little, then down
	local away = (root.Position - from) * Vector3.new(1, 0, 1)
	if away.Magnitude > 0.1 then
		root.AssemblyLinearVelocity = away.Unit * 30 + Vector3.new(0, 18, 0)
	end
	Net.Animate(character, "Knockdown")
	Net.Remotes.Effect:FireAllClients("Knockdown", root.Position)
	Net.Notify(victim, `{by} knocked you down!`, "bad")
	task.delay(CONFIG.KnockdownTime, function()
		if victim:GetAttribute("KnockedUntil") == until_ then
			victim:SetAttribute("KnockedUntil", nil)
			victim:SetAttribute("KnockImmuneUntil", now() + CONFIG.KnockImmunity)
			BaseService.RefreshWalkSpeed(victim)
			if humanoid.Parent then
				humanoid.JumpHeight = 7.2
			end
		end
	end)
	return true
end

-- Players as targets for hub knives during the raid window.
local function playerTargets(): { Targets.Target }
	local list: { Targets.Target } = {}
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if not root or player:GetAttribute("InRound") then
			continue
		end
		local character = player.Character :: Model
		local target: Targets.Target = {
			Part = root,
			Model = character,
			Solid = false,
			CanHit = function(attacker: Player)
				if not RaidService.CanAttackPlayer(attacker, player) then
					return false
				end
				if player:GetAttribute("Invisible") or player:GetAttribute("Mimic") then
					return false
				end
				return true
			end,
			Hit = function(attacker: Player, damage: number, _kind: string, from: Vector3)
				-- The vault's owner vs someone raiding them (marked at the gate, inside the vault, or
				-- running off with the owner's knife): real damage, like a watchman
				local _, vaultOwner = BaseService.BaseAt(root.Position)
				local caught = vaultOwner == attacker
					or player:GetAttribute("StolenFrom") == attacker.UserId
					or RaidService.IsMarkedBy(player, attacker)
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if caught and humanoid and humanoid.Health > 0 and not DataService.IsNewPlayer(player) then
					-- A Shield eats one hit
					local shieldUntil = character:GetAttribute("ShieldUntil")
					if type(shieldUntil) == "number" and now() < shieldUntil then
						character:SetAttribute("ShieldUntil", nil)
						Net.Remotes.Effect:FireAllClients("Shield", root.Position)
						return
					end
					local lethal = damage >= humanoid.Health
					-- The owner snatches their knife back before the thief's body hits the floor
					local recovered = if lethal then StealService.Recover(player, attacker) else nil
					humanoid:TakeDamage(damage)
					Net.Remotes.Effect:FireAllClients("Hit", root.Position)
					Net.Remotes.Effect:FireClient(player, "Hurt", from)
					Net.Remotes.Effect:FireClient(attacker, "Damage", root.Position + Vector3.new(0, 3, 0), damage)
					if humanoid.Health > 0 then
						Net.Animate(character, "Hurt")
						return
					end
					player:SetAttribute("RaiderOf", nil)
					player:SetAttribute("RaiderUntil", nil)
					local bonus = if raiding then CONFIG.BloodMoonBounty else 1
					local bounty = if recovered
						then GameConfig.Pay(CONFIG.CatchBounty, Items.Income(recovered)) * bonus
						else GameConfig.Pay(CONFIG.IntruderBounty, BaseService.RackIncome(attacker)) * bonus
					DataService.AddCash(attacker, bounty)
					Net.Remotes.Effect:FireClient(attacker, "CashBurst", root.Position, bounty)
					if recovered then
						Net.Notify(
							attacker,
							`Got your {Items.DisplayName(recovered)} back! Bounty +{Format.Cash(bounty)}`,
							"good"
						)
					else
						Net.Notify(attacker, `Raider down! Bounty +{Format.Cash(bounty)}`, "good")
					end
					Net.Notify(player, `{attacker.DisplayName} took you down defending their vault!`, "bad")
					return
				end
				if not RaidService.Knockdown(player, from, attacker.DisplayName) then
					return
				end
				Net.Remotes.Effect:FireClient(attacker, "Damage", root.Position + Vector3.new(0, 3, 0), "KO!")
			end,
		}
		table.insert(list, target)
	end
	return list
end

-- Stealing from walls ----------------------------------------------------------------------

local function onStealPrompt(thief: Player, owner: Player, slot: number)
	local base = BaseService.GetBase(owner)
	local profile = DataService.Get(owner)
	local thiefProfile = DataService.Get(thief)
	local root = rootOf(thief)
	if not base or not profile or not thiefProfile or not root then
		return
	end
	if thief:GetAttribute("InRound") or StealService.IsCarrying(thief) or thief:GetAttribute("KnockedUntil") then
		return
	end
	if ReplicatedStorage:GetAttribute("Phase") ~= "Intermission" then
		return
	end
	local sealed = owner:GetAttribute("SealedUntil")
	if type(sealed) == "number" and now() < sealed then
		Net.Notify(thief, `{owner.DisplayName} was just robbed - leave them be for a bit`, "info")
		return
	end
	local revenge = hasRevenge(thief, owner)
	if not (gateOpen(base) or revenge) or DataService.IsNewPlayer(owner) or owner:GetAttribute("InRound") then
		return
	end
	if not MapService.InBounds(base.Bounds, root.Position) then
		return
	end
	if not BaseService.GetBase(thief) then
		return
	end
	if #thiefProfile.Knives >= thiefProfile.Slots then
		Net.Notify(thief, "Your own wall is full - nowhere to put it!", "bad")
		return
	end
	local item = profile.Knives[slot]
	if not item or item == BaseService.ProtectedItem(owner) then
		return
	end
	local spot = base.SlotCFrames[DataService.PlateOf(profile, slot)]
	if not spot or (root.Position - spot.Position).Magnitude > 14 then
		return
	end
	DataService.Update(owner, function(p)
		DataService.RemoveKnife(p, slot)
	end)
	BaseService.RefreshRack(owner)
	StealService.StartCarry(thief, "Knife", item, owner.UserId)
	-- The victim gets revenge on the thief (and it ends the thief's own revenge on them)
	owner:SetAttribute("RevengeOn", thief.UserId)
	local revengeEndsAt = now() + CONFIG.RevengeTime
	owner:SetAttribute("RevengeUntil", revengeEndsAt)
	-- Nobody else gets to clean them out: the vault seals for a while
	owner:SetAttribute("SealedUntil", now() + CONFIG.RobbedSeal)
	task.delay(4, function()
		Offers.Show(owner, "Fortified", "Robbed! A Fortified Vault gives your gate +50% health for good.")
	end)
	if revenge then
		thief:SetAttribute("RevengeOn", nil)
		thief:SetAttribute("RevengeUntil", nil)
	end
	Net.Notify(owner, `{thief.DisplayName} is stealing your {Items.DisplayName(item)}! Knock them down!`, "bad")
	Net.Notify(
		owner,
		`REVENGE: {thief.DisplayName}'s vault is open to you for {math.ceil(revengeEndsAt - now())}s!`,
		"info"
	)
	Net.Remotes.Effect:FireClient(owner, "Alarm")
	Net.Remotes.Effect:FireAllClients("Stolen", root.Position, Items.Color(item))
end

-- Intruders: nobody stands in a sealed vault that isn't theirs (exploiters, or a gate that
-- reforged around someone) - they get put back outside the gate
local function evictIntruders()
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if not root or player:GetAttribute("InRound") then
			continue
		end
		local base, owner = BaseService.BaseAt(root.Position)
		if base and owner and not mayEnter(player, base, owner) then
			local outside = base.Frame * CFrame.new(0, 3, HALF_D + 5);
			(player.Character :: Model):PivotTo(
				CFrame.lookAt(outside.Position, outside.Position + base.Frame.LookVector)
			)
			Net.Notify(player, "That vault is sealed!", "bad")
		end
	end
end

-- Knife auras ------------------------------------------------------------------------------

function RaidService.AuraPower(item: string): number
	return Items.AuraPower(item)
end

-- Anyone who isn't the owner gets slowed near powerful mounted knives
local function stepAuras()
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		local slow, from = 1, nil :: string?
		if root and not player:GetAttribute("InRound") then
			local base, owner = BaseService.BaseAt(root.Position)
			local profile = owner and DataService.Get(owner)
			if base and owner and owner ~= player and profile then
				for slot, item in profile.Knives do
					local cf = base.SlotCFrames[DataService.PlateOf(profile, slot)]
					local power = RaidService.AuraPower(item)
					if cf and power > 0.5 then
						local radius = Items.AuraRadius(power)
						local distance = (cf.Position - root.Position).Magnitude
						if distance < radius then
							local strength = 1 - math.clamp(power / 12, 0, 0.6) * (1 - distance / radius)
							if strength < slow then
								slow = strength
								from = `{owner.DisplayName}'s {Items.DisplayName(item)}`
							end
						end
					end
				end
			end
		end
		local old = player:GetAttribute("AuraSlow")
		local value = if slow < 0.99 then math.floor(slow * 100) / 100 else nil
		if old ~= value then
			player:SetAttribute("AuraSlow", value)
			player:SetAttribute("AuraFrom", from)
			BaseService.RefreshWalkSpeed(player)
		end
	end
end

-- Burglars ---------------------------------------------------------------------------------

local function loadTracks(rig: Model): { [string]: AnimationTrack }
	local humanoid = rig:FindFirstChildOfClass("Humanoid") :: Humanoid
	local animator = humanoid:FindFirstChildOfClass("Animator") :: Animator?
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = humanoid
		animator = created
	end
	local tracks: { [string]: AnimationTrack } = {}
	for key, id in ANIMATIONS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall((animator :: Animator).LoadAnimation, animator :: Animator, animation)
		if ok then
			track.Looped = true
			tracks[key] = track
		end
	end
	return tracks
end

local function animate(b: Burglar, key: string, speed: number?)
	local track = b.Tracks[key]
	if b.Playing ~= key then
		local old = b.Playing and b.Tracks[b.Playing]
		if old then
			old:Stop(0.2)
		end
		if track then
			track:Play(0.2)
		end
		b.Playing = key
	end
	if track and speed then
		track:AdjustSpeed(speed)
	end
end

local function attachProp(prop: Model, to: BasePart, offset: CFrame, parent: Instance)
	prop:PivotTo(to.CFrame * offset)
	for _, d in prop:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = to
	weld.Part1 = prop.PrimaryPart :: BasePart
	weld.Parent = prop
	prop.Parent = parent
end

local function buildBurglar(name: string): Model
	local description = Instance.new("HumanoidDescription")
	local black = Color3.fromRGB(26, 24, 30)
	description.HeadColor = Color3.fromRGB(234, 184, 146)
	description.TorsoColor = Color3.fromRGB(230, 230, 235) -- the classic striped jumper (stripes below)
	description.LeftArmColor = black
	description.RightArmColor = black
	description.LeftLegColor = black
	description.RightLegColor = black
	local rig = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	rig.Name = name
	rig.ModelStreamingMode = Enum.ModelStreamingMode.Atomic -- streams in whole, never half a body
	rig:AddTag("Burglar")
	local humanoid = rig:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = name
	humanoid.NameDisplayDistance = 90
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.EvaluateStateMachine = false
	for _, d in rig:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	rig.PrimaryPart = root
	-- Stripes across the jumper
	local torso = rig:FindFirstChild("UpperTorso") :: BasePart?
	if torso then
		for i = -1, 1 do
			local stripe = Instance.new("Part")
			stripe.Name = "Stripe"
			stripe.Size = Vector3.new(torso.Size.X + 0.04, 0.28, torso.Size.Z + 0.04)
			stripe.Color = black
			stripe.Material = Enum.Material.Fabric
			stripe.CanCollide = false
			stripe.CanQuery = false
			stripe.CanTouch = false
			stripe.Massless = true
			stripe.CFrame = torso.CFrame * CFrame.new(0, i * 0.5, 0)
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = torso
			weld.Part1 = stripe
			weld.Parent = stripe
			stripe.Parent = rig
		end
		attachProp(Props.Build("LootSack"), torso, CFrame.new(0, -0.3, torso.Size.Z / 2 + 0.9), rig)
	end
	local head = rig:FindFirstChild("Head") :: BasePart?
	if head then
		Disguises.AddHat(head, "Beanie", black)
		attachProp(Props.Build("BurglarMask"), head, CFrame.new(0, 0.1, -head.Size.Z / 2 - 0.02), rig)
	end
	return rig
end

local function healthBar(head: BasePart): Frame
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(90, 10)
	gui.StudsOffset = Vector3.new(0, 2.8, 0)
	gui.MaxDistance = 100
	gui.Adornee = head
	gui.Parent = head
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(30, 10, 10)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 170, 50)
	fill.BorderSizePixel = 0
	fill.Parent = back
	return fill
end

local function dropLoot(b: Burglar)
	if b.CarryVisual then
		b.CarryVisual:Destroy()
		b.CarryVisual = nil
	end
	if b.Carrying then
		StealService.DropKnife(b.Carrying, b.Position, b.CarryOwner)
		b.Carrying = nil
	end
end

local killBurglar: (Burglar, Player?) -> ()

local function hitBurglar(b: Burglar, damage: number, attacker: Player?, from: Vector3?)
	if b.Dead then
		return
	end
	b.Health -= damage
	b.HealthFill.Size = UDim2.fromScale(math.max(0, b.Health / CONFIG.BurglarHealth), 1)
	Net.Remotes.Effect:FireAllClients("Hit", b.Position + Vector3.new(0, 1.5, 0))
	if attacker then
		Net.Remotes.Effect:FireClient(attacker, "Damage", b.Position + Vector3.new(0, 3, 0), damage)
	end
	if b.Health <= 0 then
		killBurglar(b, attacker)
		return
	end
	Net.Animate(b.Model, "GuardHurt")
	b.NextAction = math.max(b.NextAction, os.clock() + 0.25)
	-- Knocked back a step
	if from then
		local away = (b.Position - from) * Vector3.new(1, 0, 1)
		if away.Magnitude > 0.1 then
			b.Position += away.Unit * 1.5
		end
	end
end

killBurglar = function(b: Burglar, killer: Player?)
	if b.Dead then
		return
	end
	b.Dead = true
	b.RemoveTarget()
	for _, track in b.Tracks do
		track:Stop(0.1)
	end
	dropLoot(b)
	for _, d in b.Model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end
	Ragdoll.DeathCry(b.Model)
	Ragdoll.Collapse(b.Model, Vector3.new(0, 6, 0))
	pcall(b.Root.SetNetworkOwner, b.Root, nil)
	game:GetService("Debris"):AddItem(b.Model, 5)
	if killer then
		local bounty = GameConfig.Pay(CONFIG.BurglarReward, BaseService.RackIncome(killer)) * CONFIG.BloodMoonBounty
		DataService.AddCash(killer, bounty)
		Net.Notify(killer, `You stopped {b.Name}! Bounty +{Format.Cash(bounty)}`, "good")
	end
end

-- Escape route: out of the vault, across the plaza and down the runway into the dark
local function exitPath(base: MapService.BaseSite?): { Vector3 }
	local height = GuardService.RootHeight()
	local path = {}
	if base then
		table.insert(path, (base.Frame * CFrame.new(0, 0, 10)).Position)
		table.insert(path, (base.Frame * CFrame.new(0, 0, HALF_D + 6)).Position)
	end
	table.insert(path, Vector3.new(rng:NextNumber(-10, 10), 0, 30))
	table.insert(path, Vector3.new(rng:NextNumber(-20, 20), 0, 160))
	for i, p in path do
		path[i] = Vector3.new(p.X, height, p.Z)
	end
	return path
end

-- Count current assignments, so dead and escaping burglars immediately free up a gate.
local function assignedTo(base: MapService.BaseSite): number
	local count = 0
	for _, b in burglars do
		if not b.Dead and b.Base == base and b.State ~= "Escape" then
			count += 1
		end
	end
	return count
end

local function stealableSlot(base: MapService.BaseSite): number?
	local owner = BaseService.OwnerOf(base)
	local profile = owner and DataService.Get(owner)
	if not owner or not profile or not canBreak(base) or (takenFrom[base] or 0) >= CONFIG.BurglarStealsPerVault then
		return nil
	end
	local protected = BaseService.ProtectedItem(owner)
	for slot, item in profile.Knives do
		-- Burglars walk the ground floor only
		local plate = DataService.PlateOf(profile, slot)
		if plate <= profile.Slots and plate <= MapService.SlotsPerFloor and item ~= protected then
			return slot
		end
	end
	return nil
end

-- Picks a vault to hit: any owned, breakable one that hasn't got BurglarsPerGate of them at its
-- gate already. Ones with a stealable knife (and loot left this raid) come with a slot to rob;
-- the rest still get their gate smashed.
local function pickTarget(except: MapService.BaseSite?): (MapService.BaseSite?, number?)
	local options: { { Base: MapService.BaseSite, Slot: number? } } = {}
	for _, base in MapService.Bases do
		local owner = BaseService.OwnerOf(base)
		local profile = owner and DataService.Get(owner)
		if owner and profile and canBreak(base) and base ~= except then
			if assignedTo(base) >= CONFIG.BurglarsPerGate then
				continue
			end
			local protected = BaseService.ProtectedItem(owner)
			local any = false
			if (takenFrom[base] or 0) < CONFIG.BurglarStealsPerVault then
				for slot, item in profile.Knives do
					if item ~= protected and slot <= profile.Slots and slot <= MapService.SlotsPerFloor then
						table.insert(options, { Base = base, Slot = slot })
						any = true
					end
				end
			end
			-- Nothing worth taking? They'll still smash the gate and rummage around
			if not any then
				table.insert(options, { Base = base, Slot = nil })
			end
		end
	end
	if #options == 0 then
		return nil, nil
	end
	local pick = options[rng:NextInteger(1, #options)]
	return pick.Base, pick.Slot
end

-- Where a burglar stands to hack at a vault's gate
local function gateFront(base: MapService.BaseSite, burglar: Burglar): Vector3
	local occupied: { [number]: boolean } = {}
	for _, other in burglars do
		if other ~= burglar and not other.Dead and other.Base == base and other.State ~= "Escape" then
			occupied[other.GateLane] = true
		end
	end
	for lane = 1, CONFIG.BurglarsPerGate do
		if not occupied[lane] then
			burglar.GateLane = lane
			break
		end
	end
	local offset = if CONFIG.BurglarsPerGate > 1
		then -9 + 18 * (burglar.GateLane - 1) / (CONFIG.BurglarsPerGate - 1)
		else 0
	local front = (base.Frame * CFrame.new(offset, 0, HALF_D + 5)).Position
	return Vector3.new(front.X, GuardService.RootHeight(), front.Z)
end

local function spawnBurglar(generation: number)
	local name = BURGLAR_NAMES[rng:NextInteger(1, #BURGLAR_NAMES)]
	local model = buildBurglar(name)
	if not raiding or generation ~= raidGeneration then
		model:Destroy()
		return
	end
	local height = GuardService.RootHeight()
	local start = Vector3.new(rng:NextNumber(-25, 25), height, rng:NextNumber(150, 200))
	model:PivotTo(CFrame.new(start))
	local head = model:FindFirstChild("Head") :: BasePart
	local fill = healthBar(head)
	model.Parent = burglarFolder
	local b: Burglar
	b = {
		Model = model,
		Root = model.PrimaryPart :: BasePart,
		Name = name,
		Position = start,
		Health = CONFIG.BurglarHealth,
		Dead = false,
		State = "ToGate",
		Base = nil,
		Slot = nil,
		GateLane = 0,
		Carrying = nil,
		CarryOwner = nil,
		CarryVisual = nil,
		Waypoints = {},
		NextAction = 0,
		StunnedUntil = 0,
		Tracks = loadTracks(model),
		Playing = nil,
		HealthFill = fill,
		RemoveTarget = function() end,
	}
	b.RemoveTarget = Targets.Add({
		Part = b.Root,
		Model = model,
		Solid = false,
		CanHit = function()
			return not b.Dead
		end,
		Hit = function(attacker: Player, damage: number, _kind: string, from: Vector3)
			hitBurglar(b, damage, attacker, from)
		end,
	})
	b.Base, b.Slot = pickTarget()
	if b.Base then
		b.Waypoints = { Vector3.new(rng:NextNumber(-9, 9), height, 20), gateFront(b.Base, b) }
	else
		b.State = "Taunt"
		b.Waypoints = { Vector3.new(rng:NextNumber(-20, 20), height, rng:NextNumber(-140, -20)) }
	end
	table.insert(burglars, b)
	Net.Remotes.Effect:FireAllClients("BurglarSpawn", start)
end

-- Moves a burglar toward its next waypoint; returns true once there are none left
local function walk(b: Burglar, dt: number, speed: number): boolean
	local target = b.Waypoints[1]
	if not target then
		return true
	end
	local offset = target - b.Position
	local distance = offset.Magnitude
	if distance < 1 then
		table.remove(b.Waypoints, 1)
		return #b.Waypoints == 0
	end
	local nextPos = b.Position + offset.Unit * math.min(distance, speed * dt)
	-- Barricades stop burglars too; they smash through
	local obstacle = Obstacles.Blocks(b.Position, nextPos, 1.5)
	if obstacle then
		animate(b, "Idle")
		if os.clock() >= b.NextAction then
			b.NextAction = os.clock() + 1
			Net.Animate(b.Model, "GuardStab")
			obstacle.Hit("Burglar")
		end
		return false
	end
	b.Position = nextPos
	b.Model:PivotTo(CFrame.lookAt(nextPos, nextPos + Vector3.new(offset.X, 0, offset.Z)))
	animate(b, "Run", speed / 16)
	return false
end

local function stepBurglar(b: Burglar, dt: number)
	if b.Dead then
		return
	end
	local clock = os.clock()
	if raiding then
		local stun = PowerService.SpringRaidTrap(b.Position)
		if stun then
			b.StunnedUntil = now() + stun
		end
	end
	if not raiding and b.State ~= "Escape" then
		local inside = b.State == "Enter" or b.State == "Steal"
		b.Waypoints = exitPath(if inside then b.Base else nil)
		b.State = "Escape"
		b.NextAction = 0
	end
	if b.Base and b.State ~= "Escape" and not canBreak(b.Base) then
		local inside = b.State == "Enter" or b.State == "Steal"
		b.Waypoints = exitPath(if inside then b.Base else nil)
		b.State = "Escape"
		b.NextAction = 0
	end
	if now() < b.StunnedUntil or clock < b.NextAction then
		animate(b, "Idle")
		return
	end
	-- Shove anyone standing right in front of it
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if
			root
			and (root.Position - b.Position).Magnitude < 3.5
			and not BaseService.IsInOwnBase(player, b.Position)
		then
			if math.random() < 0.02 then
				Net.Animate(b.Model, "GuardStab")
				RaidService.Knockdown(player, b.Position, b.Name)
			end
		end
	end

	local base = b.Base
	if b.State == "ToGate" or b.State == "Taunt" then
		if walk(b, dt, CONFIG.BurglarSpeed) then
			if b.State == "Taunt" then
				-- Nothing to rob right now: look again, otherwise dart somewhere else on the plaza
				local nextBase, nextSlot = pickTarget()
				if nextBase then
					b.Base, b.Slot = nextBase, nextSlot
					b.State = "ToGate"
					b.Waypoints = { gateFront(nextBase, b) }
				else
					b.Waypoints =
						{ Vector3.new(rng:NextNumber(-20, 20), GuardService.RootHeight(), rng:NextNumber(-140, -20)) }
				end
			else
				b.State = "Bash"
			end
		end
	elseif b.State == "Bash" and base then
		if not raiding then
			b.State = "Escape"
			b.Waypoints = exitPath(nil)
		elseif gateOpen(base) or not BaseService.OwnerOf(base) then
			b.State = "Enter"
			b.Slot = stealableSlot(base)
			local robbed = BaseService.OwnerOf(base)
			local robbedProfile = robbed and DataService.Get(robbed)
			local slotCF = if b.Slot and robbedProfile
				then base.SlotCFrames[DataService.PlateOf(robbedProfile, b.Slot)]
				else nil
			local height = GuardService.RootHeight()
			local inside = (base.Frame * CFrame.new(0, 0, 10)).Position
			b.Waypoints = { Vector3.new(inside.X, height, inside.Z) }
			if slotCF then
				local reach = (slotCF * CFrame.new(0, 0, 3)).Position
				table.insert(b.Waypoints, Vector3.new(reach.X, height, reach.Z))
			end
		else
			-- Hack at the gate
			local blocker = base.Blocker
			b.Model:PivotTo(
				CFrame.lookAt(b.Position, Vector3.new(blocker.Position.X, b.Position.Y, blocker.Position.Z))
			)
			animate(b, "Idle")
			b.NextAction = clock + CONFIG.BurglarSwing
			Net.Animate(b.Model, "GuardStab")
			task.delay(AnimLibrary.Clips.GuardStab.Impact or 0.3, function()
				if not b.Dead and raiding and b.State == "Bash" and now() >= b.StunnedUntil then
					-- Burglars come prepared: tougher gates take bigger crowbars
					local max = (base.Blocker:GetAttribute("MaxHealth") or 0) :: number
					local _ = max
					damageGate(base, CONFIG.BurglarGateDamage, b.Name, b.Model)
				end
			end)
		end
	elseif b.State == "Enter" and base then
		if walk(b, dt, CONFIG.BurglarSpeed) then
			b.State = "Steal"
			b.NextAction = clock + CONFIG.StealTime
			Net.Animate(b.Model, "Pickup")
		end
	elseif b.State == "Steal" and base then
		-- Lift the knife (if it's still there)
		b.Slot = stealableSlot(base)
		local owner = BaseService.OwnerOf(base)
		local profile = owner and DataService.Get(owner)
		local slot = b.Slot
		local item = if profile and slot then profile.Knives[slot] else nil
		if
			owner
			and profile
			and slot
			and item
			and item ~= BaseService.ProtectedItem(owner)
			and canBreak(base)
			and (takenFrom[base] or 0) < CONFIG.BurglarStealsPerVault
		then
			takenFrom[base] = (takenFrom[base] or 0) + 1
			DataService.Update(owner, function(p)
				DataService.RemoveKnife(p, slot)
			end)
			BaseService.RefreshRack(owner)
			b.Carrying = item
			b.CarryOwner = owner.UserId
			local visual = KnifeModel.Build(item, false)
			KnifeModel.FitItem(visual, item, 3.4)
			local head = b.Model:FindFirstChild("Head") :: BasePart
			attachProp(visual, head, CFrame.new(0, 1.1, 0) * CFrame.Angles(0, 0, math.rad(90)), b.Model)
			b.CarryVisual = visual
			b.Model:SetAttribute("Carrying", true) -- clients hold it up with the Carry pose
			Net.Notify(owner, `{b.Name} grabbed your {Items.DisplayName(item)}! Stop them before they escape!`, "bad")
			Net.Remotes.Effect:FireClient(owner, "Alarm")
			Net.Announce(
				`{b.Name} is escaping with {owner.DisplayName}'s {Items.DisplayName(item)}!`,
				Color3.fromRGB(255, 160, 60),
				1
			)
		end
		if b.Carrying then
			b.State = "Escape"
			b.Waypoints = exitPath(base)
		else
			-- Came up empty: straight on to the next vault
			b.Base, b.Slot = nil, nil
			local nextBase, nextSlot = pickTarget(base)
			if nextBase then
				local height = GuardService.RootHeight()
				local outside = (base.Frame * CFrame.new(0, 0, HALF_D + 6)).Position
				b.Base, b.Slot = nextBase, nextSlot
				b.State = "ToGate"
				b.Waypoints = { Vector3.new(outside.X, height, outside.Z), gateFront(nextBase, b) }
			else
				b.State = "Escape"
				b.Waypoints = exitPath(base)
			end
		end
	elseif b.State == "Escape" then
		if walk(b, dt, if b.Carrying then CONFIG.BurglarCarrySpeed else CONFIG.BurglarSpeed) then
			-- Got away
			if b.Carrying then
				local owner = b.CarryOwner and Players:GetPlayerByUserId(b.CarryOwner)
				Net.Announce(
					`{b.Name} got away with {if owner then owner.DisplayName .. "'s" else "a"} {Items.DisplayName(
						b.Carrying
					)}!`,
					Color3.fromRGB(200, 120, 255),
					1
				)
			end
			b.Dead = true
			b.RemoveTarget()
			Net.Remotes.Effect:FireAllClients("Smoke", b.Position)
			b.Model:Destroy()
		end
	end
end

-- The raid itself --------------------------------------------------------------------------

function RaidService.Start()
	if raiding then
		return
	end
	-- Burglars need somewhere to go: if every vault is protected (new players, everyone in a
	-- round), there's no raid rather than an announcement that nothing follows
	local any = false
	for _, base in MapService.Bases do
		if protectedReason(base, true) == nil then
			any = true
		end
	end
	if not any then
		return
	end
	raiding = true
	raidGeneration += 1
	local generation = raidGeneration
	raidEndsAt = now() + CONFIG.Duration
	ReplicatedStorage:SetAttribute("Raid", true)
	ReplicatedStorage:SetAttribute("RaidEndsAt", raidEndsAt)
	for base in gates do
		refreshGateBar(base)
	end
	Net.Announce(
		"THIEF MOON! Burglars are coming, gates are weak and bounties are doubled!",
		Color3.fromRGB(255, 60, 60),
		3
	)
	Net.Remotes.Effect:FireAllClients("RaidStart", raidEndsAt)
	-- Burglars arrive in waves through the raid
	table.clear(takenFrom)
	local count = CONFIG.Burglars
	for i = 1, count do
		-- Three arrive together, with all waves appearing in the first half of the raid.
		task.delay(((i - 1) // 3) * (CONFIG.Duration * 0.5 / math.ceil(count / 3)) + ((i - 1) % 3) * 0.4, function()
			if raiding and generation == raidGeneration then
				spawnBurglar(generation)
			end
		end)
	end
end

function RaidService.Stop()
	if not raiding then
		return
	end
	raiding = false
	raidGeneration += 1
	ReplicatedStorage:SetAttribute("Raid", nil)
	ReplicatedStorage:SetAttribute("RaidEndsAt", nil)
	for base in gates do
		if gateOpen(base) then
			reforge(base, 1)
		else
			refreshGateBar(base)
		end
	end
	-- Burglars still around flee
	for _, b in burglars do
		if not b.Dead and b.State ~= "Escape" then
			local inside = b.State == "Enter" or b.State == "Steal"
			b.State = "Escape"
			b.Waypoints = exitPath(if inside then b.Base else nil)
			b.NextAction = 0
		end
	end
	Net.Announce("The Thief Moon sets. The burglars are fleeing...", Color3.fromRGB(200, 200, 220), 1)
	Net.Remotes.Effect:FireAllClients("RaidEnd")
end

-- Raids happen near the end of each intermission (GameConfig.Raid.StartBefore before the round)
-- Summon the Thief Moon (Robux): now if we can, otherwise as soon as the next intermission
-- allows; during one already it lasts a minute longer
local pendingSummon: string? = nil
function RaidService.Summon(player: Player)
	if raiding then
		raidEndsAt += 60
		ReplicatedStorage:SetAttribute("RaidEndsAt", raidEndsAt)
		Net.Announce(`🌕 {player.DisplayName} made the Thief Moon last longer!`, Color3.fromRGB(255, 70, 70), 2)
		return
	end
	pendingSummon = player.DisplayName
	Net.Notify(player, "The Thief Moon will rise as soon as the next intermission allows", "info")
end

local function schedule()
	local raidedThisIntermission = false
	local intermissions = 0
	local counted = false
	while true do
		task.wait(0.5)
		local phase = ReplicatedStorage:GetAttribute("Phase")
		local endsAt = ReplicatedStorage:GetAttribute("PhaseEndsAt")
		local waiting = ReplicatedStorage:GetAttribute("Status") ~= "🔪 MURDER ROUND in"
		if phase == "Intermission" and type(endsAt) == "number" and not waiting then
			if not counted then
				counted = true
				intermissions += 1
			end
			if pendingSummon and not raiding and endsAt - now() > 45 then
				local who = pendingSummon
				pendingSummon = nil
				RaidService.Start()
				if raiding then
					raidedThisIntermission = true
					Net.Announce(`🌕 {who} summoned the THIEF MOON!`, Color3.fromRGB(255, 60, 60), 3)
				end
			end
			local bloodMoon = intermissions % CONFIG.Every == 0
			local left = endsAt - now()
			ReplicatedStorage:SetAttribute(
				"NextRaidAt",
				if raidedThisIntermission or not bloodMoon then nil else endsAt - CONFIG.StartBefore
			)
			if
				bloodMoon
				and not raidedThisIntermission
				and not raiding
				and left <= CONFIG.StartBefore
				and left > 20
			then
				if #Players:GetPlayers() >= CONFIG.MinPlayers then
					raidedThisIntermission = true
					RaidService.Start()
				end
			end
		else
			ReplicatedStorage:SetAttribute("NextRaidAt", nil)
			if phase ~= "Intermission" then
				raidedThisIntermission = false
				counted = false
			end
		end
		if raiding and now() >= raidEndsAt then
			RaidService.Stop()
		end
		-- Stop before the round starts no matter what
		if raiding and phase ~= "Intermission" then
			RaidService.Stop()
		end
	end
end

local function step(dt: number)
	-- Gates: reopen broken ones after a while, slowly mend the rest
	do
		local t = now()
		for base, state in gates do
			if gateOpen(base) then
				if state.BrokenUntil > 0 and t >= state.BrokenUntil then
					reforge(base, 0.5)
				end
			elseif t - state.LastHit > CONFIG.GateRegenDelay then
				local max = (base.Blocker:GetAttribute("MaxHealth") or 1) :: number
				local health = (base.Blocker:GetAttribute("Health") or 0) :: number
				if health < max then
					base.Blocker:SetAttribute("Health", math.min(max, health + max * CONFIG.GateRegen * dt))
					refreshGateBar(base)
				end
			end
		end
	end
	for i = #burglars, 1, -1 do
		local b = burglars[i]
		if b.Dead and not b.Model.Parent then
			table.remove(burglars, i)
		elseif not b.Dead then
			stepBurglar(b, dt)
		end
	end
end

function RaidService.Init()
	-- A Murderer wipe calls the Thief Moon (now, or as soon as the intermission allows)
	ServerEvents.OnWipe = function(name: string)
		Net.Announce(`🔪 {name}'s massacre is calling the Thief Moon!`, Color3.fromRGB(255, 70, 70), 3)
		if raiding then
			raidEndsAt += 60
			ReplicatedStorage:SetAttribute("RaidEndsAt", raidEndsAt)
		else
			pendingSummon = name
		end
	end
	burglarFolder = Instance.new("Folder")
	burglarFolder.Name = "Burglars"
	burglarFolder.Parent = workspace:FindFirstChild("Map")

	for _, base in MapService.Bases do
		trackGate(base)
	end
	BaseService.OnWallsBuilt = function(base)
		trackGate(base)
		if raiding then
			-- New walls arrive at full strength
			base.Blocker:SetAttribute("Health", base.Blocker:GetAttribute("MaxHealth"))
		end
		refreshGateBar(base)
	end
	BaseService.OnStealPrompt = onStealPrompt
	PowerService.CanRaidPlayer = RaidService.CanAttackPlayer
	Targets.AddProvider(playerTargets)
	Net.Remotes.RepairGate.OnServerEvent:Connect(onRepair)

	-- Flash blinds burglars and raiders in front of you too
	PowerService.OnFlash(function(flasher, origin, look, range, duration, burst)
		for _, b in burglars do
			local offset = b.Position - origin
			if
				not b.Dead
				and offset.Magnitude < range
				and (offset.Magnitude <= burst or look:Dot(offset.Unit) > 0.57)
			then
				b.StunnedUntil = now() + duration
			end
		end
		-- Anyone you could hit (raiders marked on your gate, thieves, Thief Moon targets)
		do
			for _, player in Players:GetPlayers() do
				local root = rootOf(player)
				if root and RaidService.CanAttackPlayer(flasher, player) then
					local offset = root.Position - origin
					if offset.Magnitude < range and (offset.Magnitude <= burst or look:Dot(offset.Unit) > 0.57) then
						player:SetAttribute("StunnedUntil", now() + duration)
						BaseService.RefreshWalkSpeed(player)
						Net.Remotes.Effect:FireClient(player, "Blinded", duration)
						task.delay(duration, function()
							BaseService.RefreshWalkSpeed(player)
						end)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, other in Players:GetPlayers() do
			if other:GetAttribute("RevengeOn") == player.UserId then
				other:SetAttribute("RevengeOn", nil)
				other:SetAttribute("RevengeUntil", nil)
			end
		end
	end)

	RunService.Heartbeat:Connect(step)
	task.spawn(schedule)
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.3)
			evictIntruders()
			stepAuras()
			-- Gate labels (the new-player shield counts down, owners come and go)
			tick += 1
			if tick % 10 == 0 then
				for base in gates do
					refreshGateBar(base)
				end
			end
		end
	end)
end

return RaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Revolver</string>
            <string name="Source"><![CDATA[--!strict
-- Part-built Revolver: the floating pickup that drops into the round, and the Tool an innocent
-- holds after grabbing it. Firing is handled by RoundService (Remotes.Shoot).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage.Shared.Config.Sounds)

local Revolver = {}

local METAL = Color3.fromRGB(70, 72, 80)
local GRIP = Color3.fromRGB(110, 65, 35)

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

-- Grip along +Y at the origin, barrel pointing towards -Z (the direction a Tool faces)
local function assemble(parent: Instance): BasePart
	local handle = part(
		parent,
		"Handle",
		Vector3.new(0.35, 1.1, 0.55),
		CFrame.Angles(math.rad(-15), 0, 0),
		GRIP,
		Enum.Material.Wood
	)
	part(parent, "Frame", Vector3.new(0.4, 0.55, 1.1), CFrame.new(0, 0.7, -0.3), METAL, Enum.Material.Metal)
	local cylinder = part(
		parent,
		"Cylinder",
		Vector3.new(0.7, 0.62, 0.62),
		CFrame.new(0, 0.72, -0.45) * CFrame.Angles(0, math.rad(90), 0),
		METAL:Lerp(Color3.new(1, 1, 1), 0.2),
		Enum.Material.Metal
	)
	cylinder.Shape = Enum.PartType.Cylinder
	local barrel = part(
		parent,
		"Barrel",
		Vector3.new(1.5, 0.28, 0.28),
		CFrame.new(0, 0.85, -1.4) * CFrame.Angles(0, math.rad(90), 0),
		METAL,
		Enum.Material.Metal
	)
	barrel.Shape = Enum.PartType.Cylinder
	part(parent, "Hammer", Vector3.new(0.15, 0.3, 0.2), CFrame.new(0, 1.05, 0.25), METAL)
	part(parent, "Muzzle", Vector3.new(0.1, 0.1, 0.1), CFrame.new(0, 0.85, -2.2), METAL).Transparency = 1
	for _, child in parent:GetChildren() do
		if child:IsA("BasePart") and child ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = child
			weld.Parent = child
		end
	end
	return handle
end

function Revolver.BuildTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Revolver"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.GripPos = Vector3.new(0, -0.2, 0)
	tool.GripForward = Vector3.new(0, 0, -1)
	tool.GripUp = Vector3.new(0, 1, 0)
	tool.GripRight = Vector3.new(1, 0, 0)
	tool:SetAttribute("Revolver", true)
	local handle = assemble(tool)
	handle.Massless = false
	local sound = Instance.new("Sound")
	sound.Name = "Shot"
	sound.SoundId = Sounds.Gunshot
	sound.Volume = 1
	sound.Parent = handle
	return tool
end

-- The pickup: anchored, glowing, with sparkles so everyone knows where it is
function Revolver.BuildPickup(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "RevolverPickup"
	local handle = assemble(model)
	model.PrimaryPart = handle
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model:ScaleTo(1.6)
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)))
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(80, 255, 120)
	sparkles.Parent = handle
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(80, 255, 120)
	light.Range = 12
	light.Parent = handle
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(80, 255, 120)
	highlight.FillTransparency = 0.6
	highlight.OutlineColor = Color3.fromRGB(200, 255, 210)
	highlight.Parent = model
	-- A plain part that people touch to pick it up (the gun itself doesn't take touches)
	local zone = Instance.new("Part")
	zone.Name = "PickupZone"
	zone.Size = Vector3.new(5, 6, 5)
	zone.CFrame = CFrame.new(position)
	zone.Anchored = true
	zone.CanCollide = false
	zone.CanQuery = false
	zone.Transparency = 1
	zone.Parent = model
	model:AddTag("Spin")
	return model
end

return Revolver
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Little reasons to come back and look around the plaza:
--   * the Case Shop: sealed cases for cash, opened on the spot
--   * the free chest on the plaza: every FreeChest.Cooldown, cash (scaled to your income) or a case
--   * the Index: a one-time reward for every knife you've ever owned (Remotes.ClaimIndex)
--   * the first-minute guide: a little reward for finishing it (Remotes.Tutorial)
--   * coming back: the vault's offline earnings and the 7-day login streak (Remotes.Welcome on
--     join, Remotes.ClaimDaily)
-- The Case Shop goes through UpgradeService's Purchase remote ("Case:<Rarity>").

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local Props = require(ReplicatedStorage.Shared.Props)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local Offers = require(script.Parent.Offers)
local StealService = require(script.Parent.StealService)

local Rewards = {}

local rng = Random.new()
-- Beside the Knife Merchant's stall
local CHEST_AT = CFrame.new(-49, 1.4, -34) * CFrame.Angles(0, math.rad(130), 0)

-- Case Shop -----------------------------------------------------------------------------------

function Rewards.BuyCase(player: Player, rarity: string): (boolean, string)
	local entry = nil
	for _, e in GameConfig.CaseShop do
		if e.Rarity == rarity then
			entry = e
		end
	end
	local profile = DataService.Get(player)
	if not entry or not profile then
		return false, "Unknown case"
	end
	if player:GetAttribute("InRound") then
		return false, "Not during a round!"
	end
	if #profile.Knives >= profile.Slots then
		Offers.Show(player, "Mount", "Your wall is full! Add another mount instantly.")
		return false, "Your wall is full! Sell a knife or buy a mount first."
	end
	if not DataService.TrySpend(player, entry.Cost) then
		Offers.Cash(player, entry.Cost - profile.Cash, BaseService.RackIncome(player))
		return false, "Not enough cash"
	end
	StealService.OpenCase(player, rarity)
	return true, `Opening a {rarity} Case...`
end

-- Coming back ---------------------------------------------------------------------------------

local function today(): number
	return math.floor(os.time() / 86400)
end

-- Which streak day they'd claim today, or nil if today's is already claimed. Missing a day starts
-- the streak over; after day 7 it wraps back to day 1.
local function dailyDay(profile: DataService.Profile): number?
	local day = today()
	if profile.LastDaily == day then
		return nil
	end
	if profile.LastDaily == day - 1 and profile.DailyStreak > 0 then
		return profile.DailyStreak % #GameConfig.Daily + 1
	end
	return 1
end

-- A case they can't fit on the wall turns into cash instead (what the Case Shop charges for it)
local function giveCase(player: Player, rarity: string): string
	local profile = DataService.Get(player)
	if profile and #profile.Knives < profile.Slots then
		StealService.OpenCase(player, rarity)
		return `a {rarity} Case`
	end
	local cost = 250
	for _, entry in GameConfig.CaseShop do
		if entry.Rarity == rarity then
			cost = entry.Cost
		end
	end
	DataService.AddCash(player, cost)
	return `{Format.Cash(cost)} (your wall was full, so you got the {rarity} Case's value)`
end

local function claimDaily(player: Player): (boolean, string)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Still loading..."
	end
	local day = dailyDay(profile)
	if not day then
		return false, "Already claimed today - come back tomorrow!"
	end
	local reward = GameConfig.Daily[day]
	DataService.Update(player, function(p)
		p.DailyStreak = day
		p.LastDaily = today()
	end)
	local got
	if reward.Kind == "Case" then
		got = giveCase(player, reward.Rarity or "Common")
	elseif reward.Kind == "Tickets" then
		local amount = reward.Amount or 1
		DataService.Update(player, function(p)
			p.Tickets = math.min(GameConfig.MaxTickets, p.Tickets + amount)
		end)
		got = `{amount} Murderer Tickets`
	else
		local cash =
			GameConfig.Pay({ Min = reward.Min or 100, Seconds = reward.Seconds or 60 }, BaseService.RackIncome(player))
		DataService.AddCash(player, cash)
		got = `{Format.Cash(cash)}`
	end
	Net.Notify(player, `Day {day} reward: {got}!`, "good")
	return true, got
end

-- On join: pay what the vault earned while they were away, and tell the client about it and
-- about today's streak reward (it shows the welcome-back card)
local function welcome(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local awaySince = DataService.AwaySince[player] or 0
	local away = if awaySince > 0 then os.time() - awaySince else 0
	local earned = 0
	local config = GameConfig.Offline
	if away >= config.MinAway then
		local seconds = math.min(away, config.MaxHours * 3600)
		earned = math.floor(BaseService.RackIncome(player) * seconds * config.Fraction)
		if earned > 0 then
			DataService.AddCash(player, earned)
		end
	end
	local day = dailyDay(profile)
	Net.Remotes.Welcome:FireClient(player, {
		Offline = earned,
		Away = away,
		Streak = day or profile.DailyStreak,
		DailyReady = day ~= nil,
		Shielded = DataService.IsNewPlayer(player),
	})
end

-- Free chest ---------------------------------------------------------------------------------

local function claimFreeChest(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local now = os.time()
	if now < profile.NextFreeChest then
		Net.Notify(player, `The chest refills in {math.ceil((profile.NextFreeChest - now) / 60)} min`, "bad")
		Offers.Show(player, "ChestRefill", "Can't wait? Refill your chest right now.")
		return
	end
	local config = GameConfig.FreeChest
	DataService.Update(player, function(p)
		-- VIP: the chest refills twice as fast
		p.NextFreeChest = now + (if player:GetAttribute("Pass_VIP") then config.Cooldown / 2 else config.Cooldown)
	end)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Net.Remotes.Effect:FireAllClients("ChestOpen", CHEST_AT.Position, player)
	end
	-- Sometimes a case (better the further you've got), otherwise a pile of cash
	if rng:NextNumber() < config.CaseChance and #profile.Knives < profile.Slots then
		local best = 1
		for _, item in profile.Knives do
			local name = item:match("^[^|]+") or item
			local knife = Knives.ByName[name]
			best = math.max(best, if knife then table.find(Knives.Rarities, knife.Rarity) or 1 else 1)
		end
		local rarityIndex = math.clamp(best - (if rng:NextNumber() < 0.7 then 1 else 0), 1, #Knives.Rarities)
		local rarity = Knives.Rarities[rarityIndex]
		Net.Notify(player, `FREE CHEST: a {rarity} Case!`, "good")
		StealService.OpenCase(player, rarity)
	else
		local cash = math.max(
			config.MinCash,
			math.floor(BaseService.RackIncome(player) * config.IncomeSeconds * rng:NextNumber(0.8, 1.4))
		)
		DataService.AddCash(player, cash)
		Net.Notify(player, `FREE CHEST: +{Format.Cash(cash)}!`, "good")
		Net.Remotes.Effect:FireClient(player, "CashBurst", CHEST_AT.Position, cash)
	end
end

local function buildChest(parent: Instance)
	local chest = Props.Build("Chest", true)
	chest.Name = "FreeChest"
	chest:ScaleTo(1.6)
	chest:PivotTo(CHEST_AT)
	for _, d in chest:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "Lock" or d.Name == "Seam" then
				d.Color = Color3.fromRGB(255, 220, 80)
			elseif d.Name == "Iron" then
				d.Color = Color3.fromRGB(235, 185, 60)
			elseif d.Name == "Wood" then
				d.Color = Color3.fromRGB(190, 40, 40)
			end
		end
	end
	chest:AddTag("FreeChest")
	chest.Parent = parent
	local root = chest.PrimaryPart :: BasePart
	-- A glowing ring on the floor around it
	local ring = Instance.new("Part")
	ring.Name = "ChestRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(120, 255, 140)
	ring.Transparency = 0.55
	ring.Size = Vector3.new(0.15, 9, 9)
	ring.CFrame = CFrame.new(CHEST_AT.Position.X, 0.25, CHEST_AT.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = chest
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Range = 16
	light.Brightness = 2
	light.Parent = root
	-- "FREE!" floats over it; clients swap in their own countdown (see client/Hud)
	local gui = Instance.new("BillboardGui")
	gui.Name = "FreeLabel"
	gui.Size = UDim2.fromOffset(220, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 160
	gui.Adornee = root
	gui.Parent = root
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(120, 255, 140)
	label.TextStrokeTransparency = 0
	label.Text = "FREE!"
	label.Parent = gui
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "Free Chest"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(claimFreeChest)
end

-- Index rewards -------------------------------------------------------------------------------

local function claimIndex(player: Player, which: unknown): boolean
	local profile = DataService.Get(player)
	if not profile or type(which) ~= "string" then
		return false
	end
	local names = {}
	for _, name in profile.Discovered do
		if not table.find(profile.IndexClaimed, name) and (which == "All" or which == name) then
			table.insert(names, name)
		end
	end
	if #names == 0 then
		return false
	end
	local cash, speed = 0, 0
	for _, name in names do
		local knife = Knives.ByName[name]
		local reward = knife and GameConfig.IndexRewards[knife.Rarity]
		if reward then
			cash += reward.Cash
			speed += reward.Speed
		end
	end
	DataService.Update(player, function(p)
		for _, name in names do
			table.insert(p.IndexClaimed, name)
		end
		p.Cash += cash
		p.Speed += speed
	end)
	Net.Notify(player, `Index reward: +{Format.Cash(cash)} and +{Format.Short(speed)} Speed!`, "good")
	Net.Remotes.Effect:FireClient(player, "IndexClaim", cash, speed)
	return true
end

function Rewards.Init()
	local folder = Instance.new("Folder")
	folder.Name = "PlazaRewards"
	folder.Parent = workspace:FindFirstChild("Map")
	buildChest(folder)

	Net.Remotes.ClaimIndex.OnServerInvoke = claimIndex
	Net.Remotes.ClaimDaily.OnServerInvoke = claimDaily
	DataService.PlayerLoaded:Connect(function(player: Player)
		-- After the vault is assigned and the client has its UI up
		task.delay(4, function()
			if player.Parent then
				welcome(player)
			end
		end)
	end)
	Net.Remotes.Tutorial.OnServerEvent:Connect(function(player: Player, step: unknown)
		local profile = DataService.Get(player)
		if step == "Done" and profile and not profile.TutorialDone then
			DataService.Update(player, function(p)
				p.TutorialDone = true
				p.Cash += GameConfig.TutorialReward
			end)
			Net.Notify(player, `Guide complete! +{Format.Cash(GameConfig.TutorialReward)}`, "good")
		elseif step == "Skip" and profile then
			DataService.Update(player, function(p)
				p.TutorialDone = true
			end)
		end
	end)
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">RoundBots</string>
            <string name="Source"><![CDATA[--!strict
-- Stand-ins for missing players in Studio test rounds: disguised R15 NPCs that wander the round
-- map, run from the Murderer, or play the Murderer themselves. RoundService decides where each one
-- wants to go and who it stabs; this module builds them, walks them around furniture
-- (pathfinding, or straight at the goal when nothing is in the way), animates and kills them.

local PathfindingService = game:GetService("PathfindingService")

local KnifeModel = require(game:GetService("ReplicatedStorage").Shared.KnifeModel)
local Disguises = require(script.Parent.Disguises)
local Ragdoll = require(script.Parent.Ragdoll)
local Net = require(script.Parent.Parent.Remotes)

local RoundBots = {}

export type Bot = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Name: string,
	Role: string, -- "Murderer" | "Innocent"
	Alive: boolean,
	Goal: Vector3?,
	Waypoints: { Vector3 },
	NextWaypoint: number,
	PathGoal: Vector3?, -- the goal the current waypoints lead to
	PathAt: number,
	Computing: boolean,
	Tracks: { [string]: AnimationTrack },
	Playing: string?,
	NextThink: number, -- RoundService's per-bot timers
	NextStab: number,
	IdleUntil: number,
	StunnedUntil: number,
	Knife: Model?,
	Gun: Tool?, -- the Revolver, when this bot is the Sheriff
	NextShot: number,
	AimUntil: number, -- 0 = not aiming
}

-- Roblox's own R15 idle / run (the same ones the guards use)
local ANIMATIONS: { [string]: string } = {
	Idle = "rbxassetid://507766388",
	Run = "rbxassetid://507767714",
}

local mapParams = RaycastParams.new()
mapParams.FilterType = Enum.RaycastFilterType.Include

-- Line-of-sight checks only look at the round map's walls and furniture
function RoundBots.SetMap(map: Instance)
	mapParams.FilterDescendantsInstances = { map }
end

local function loadTracks(humanoid: Humanoid): { [string]: AnimationTrack }
	local animator = humanoid:FindFirstChildOfClass("Animator") :: Animator?
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = humanoid
		animator = created
	end
	local tracks: { [string]: AnimationTrack } = {}
	for key, id in ANIMATIONS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall((animator :: Animator).LoadAnimation, animator :: Animator, animation)
		if ok then
			track.Looped = true
			tracks[key] = track
		end
	end
	return tracks
end

function RoundBots.Spawn(at: CFrame, role: string, taken: { [string]: boolean }, parent: Instance): Bot
	local rig, name = Disguises.BuildBot(taken)
	taken[name] = true
	rig.Name = name
	rig.ModelStreamingMode = Enum.ModelStreamingMode.Atomic -- streams in whole, never half a body
	rig:SetAttribute("Role", role) -- Radar finds a Murderer bot by this
	rig:AddTag("RoundBot") -- clients animate these like players (Moves)
	local humanoid = rig:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = name
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.WalkSpeed = 10
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	for _, d in rig:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	rig.PrimaryPart = root
	rig:PivotTo(at)
	rig.Parent = parent
	root:SetNetworkOwner(nil) -- the server walks them
	return {
		Model = rig,
		Humanoid = humanoid,
		Root = root,
		Name = name,
		Role = role,
		Alive = true,
		Goal = nil,
		Waypoints = {},
		NextWaypoint = 1,
		PathGoal = nil,
		PathAt = 0,
		Computing = false,
		Tracks = loadTracks(humanoid),
		Playing = nil,
		NextThink = 0,
		NextStab = 0,
		IdleUntil = 0,
		StunnedUntil = 0,
		Knife = nil,
		Gun = nil,
		NextShot = 0,
		AimUntil = 0,
	}
end

-- The Murderer bot's knife, welded into its right hand blade-up (same grip as a held Tool)
function RoundBots.GiveKnife(bot: Bot, knifeName: string)
	bot.Model:SetAttribute("KnifeOut", true)
	local hand = bot.Model:FindFirstChild("RightHand") :: BasePart?
	if not hand or bot.Knife then
		return
	end
	local knife = KnifeModel.Build(knifeName, false)
	KnifeModel.FitLength(knife, 2.4)
	knife:PivotTo(hand.CFrame * CFrame.new(0, -0.3, 0) * CFrame.Angles(math.rad(-90), 0, 0))
	for _, d in knife:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = knife.PrimaryPart :: BasePart
	weld.Parent = knife
	knife.Name = "Knife"
	knife.Parent = bot.Model
	bot.Knife = knife
	Net.Animate(bot.Model, "Draw")
end

function RoundBots.WalkTo(bot: Bot, goal: Vector3?)
	bot.Goal = goal
end

local function clearPath(from: Vector3, to: Vector3): boolean
	-- Two rays: chest height (walls) and knee height (tables, beds)
	for _, height in { 0, -1.8 } do
		local origin = from + Vector3.new(0, height, 0)
		local target = Vector3.new(to.X, origin.Y, to.Z)
		if workspace:Raycast(origin, target - origin, mapParams) then
			return false
		end
	end
	return true
end

local function computePath(bot: Bot, goal: Vector3)
	bot.Computing = true
	bot.PathAt = os.clock()
	task.spawn(function()
		local path = PathfindingService:CreatePath({ AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = false })
		local ok = pcall(path.ComputeAsync, path, bot.Root.Position, goal)
		bot.Computing = false
		if not bot.Alive then
			return
		end
		bot.Waypoints = {}
		if ok and path.Status == Enum.PathStatus.Success then
			for _, waypoint in path:GetWaypoints() do
				table.insert(bot.Waypoints, waypoint.Position)
			end
		end
		bot.NextWaypoint = 2 -- the first one is where it's standing
		bot.PathGoal = goal
	end)
end

local function play(bot: Bot, key: string, speed: number)
	local track = bot.Tracks[key]
	if bot.Playing ~= key then
		local old = bot.Playing and bot.Tracks[bot.Playing]
		if old then
			old:Stop(0.2)
		end
		if track then
			track:Play(0.2)
		end
		bot.Playing = key
	end
	if track then
		track:AdjustSpeed(speed)
	end
end

-- Called a few times a second: steer toward the goal and pick the matching animation
function RoundBots.Step(bot: Bot)
	if not bot.Alive then
		return
	end
	local root, humanoid = bot.Root, bot.Humanoid
	local stunned = workspace:GetServerTimeNow() < bot.StunnedUntil
	local goal = bot.Goal
	if stunned or not goal then
		humanoid:MoveTo(root.Position)
	elseif clearPath(root.Position, goal) then
		bot.Waypoints = {}
		humanoid:MoveTo(goal)
	else
		local stale = not bot.PathGoal
			or ((bot.PathGoal :: Vector3) - goal).Magnitude > 5
			or os.clock() - bot.PathAt > 2
			or bot.NextWaypoint > #bot.Waypoints
		if stale and not bot.Computing then
			computePath(bot, goal)
		end
		local waypoint = bot.Waypoints[bot.NextWaypoint]
		if waypoint then
			local flat = Vector3.new(waypoint.X - root.Position.X, 0, waypoint.Z - root.Position.Z)
			if flat.Magnitude < 2.5 then
				bot.NextWaypoint += 1
				waypoint = bot.Waypoints[bot.NextWaypoint]
			end
		end
		humanoid:MoveTo(waypoint or goal)
	end
	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	if speed > 1 then
		play(bot, "Run", math.max(0.6, speed / 16))
	else
		play(bot, "Idle", 1)
	end
end

function RoundBots.Reached(bot: Bot, within: number): boolean
	local goal = bot.Goal
	if not goal then
		return true
	end
	local flat = Vector3.new(goal.X - bot.Root.Position.X, 0, goal.Z - bot.Root.Position.Z)
	return flat.Magnitude < within
end

function RoundBots.Face(bot: Bot, point: Vector3)
	local at = bot.Root.Position
	local flat = Vector3.new(point.X, at.Y, point.Z)
	if (flat - at).Magnitude > 0.1 then
		bot.Root.CFrame = CFrame.lookAt(at, flat)
	end
end

-- Collapse with a death cry; the body stays (frozen into `bodies`) like a player's would
function RoundBots.Kill(bot: Bot, push: Vector3?, bodies: Instance)
	if not bot.Alive then
		return
	end
	bot.Alive = false
	bot.Goal = nil
	for _, track in bot.Tracks do
		track:Stop(0)
	end
	bot.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	bot.Humanoid.Health = 0
	Ragdoll.Collapse(bot.Model, push)
	Ragdoll.DeathCry(bot.Model)
	local model = bot.Model
	task.delay(2.5, function()
		if not model.Parent or not bodies.Parent then
			return
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		model.Parent = bodies
	end)
end

return RoundBots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">RoundMapKit</string>
            <string name="Source"><![CDATA[--!strict
-- Building blocks for the round maps (RoundMaps): walls with real trim (baseboards, crown
-- moulding, wainscoting, door casings), floors, windows with moonlight, lights, wall clutter and a
-- catalogue of furniture. Everything is Parts on purpose - the blocky 2013 look is the point -
-- apart from a few Blender props (chandeliers, sconces).
--
-- Positions are studs from the map centre. Furniture is built in a local frame and rotated as a
-- whole; its FRONT is local -Z. Rotation for something standing against a wall, facing the room:
--   north wall (+Z) 0, south wall (-Z) 180, west wall (-X) -90, east wall (+X) 90.
-- Small details don't collide (nobody should snag on a keyboard) and big pieces do.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Props = require(ReplicatedStorage.Shared.Props)
local Textures = require(ReplicatedStorage.Shared.Config.Textures)

local Kit = {}

Kit.WALL_HEIGHT = 14
Kit.DOOR_WIDTH = 7
Kit.DOOR_HEIGHT = 9.5
local WALL_HEIGHT = Kit.WALL_HEIGHT
local DOOR_WIDTH = Kit.DOOR_WIDTH
local DOOR_HEIGHT = Kit.DOOR_HEIGHT
local T = 1 -- wall thickness

local folder: Folder
local origin: Vector3

function Kit.Begin(into: Folder, center: Vector3)
	folder = into
	origin = center
end

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end
Kit.rgb = rgb

local function darker(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount)
end

local function lighter(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

-- Primitives ---------------------------------------------------------------------------------

local function part(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end
Kit.part = part

-- A part nobody collides with or raycasts against (trim, clutter, lights)
local function deco(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(name, size, cframe, color, material)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(origin + Vector3.new(x, y, z))
end
Kit.at = at

local function frame(x: number, z: number, rotation: number?, y: number?): CFrame
	return at(x, y or 0, z) * CFrame.Angles(0, math.rad(rotation or 0), 0)
end
Kit.frame = frame

local function piece(
	base: CFrame,
	name: string,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	material: Enum.Material?
): Part
	return part(name, size, base * CFrame.new(offset), color, material)
end

local function bit(
	base: CFrame,
	name: string,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	material: Enum.Material?
): Part
	return deco(name, size, base * CFrame.new(offset), color, material)
end

local function cylinder(p: Part, axis: "X" | "Y" | "Z"?): Part
	p.Shape = Enum.PartType.Cylinder
	-- Roblox cylinders run along X; turn them to stand up (Y) or face forward (Z)
	if axis == "Y" then
		p.Size = Vector3.new(p.Size.Y, p.Size.X, p.Size.Z)
		p.CFrame = p.CFrame * CFrame.Angles(0, 0, math.rad(90))
	elseif axis == "Z" then
		p.Size = Vector3.new(p.Size.Z, p.Size.Y, p.Size.X)
		p.CFrame = p.CFrame * CFrame.Angles(0, math.rad(90), 0)
	end
	return p
end

local function ball(p: Part): Part
	p.Shape = Enum.PartType.Ball
	return p
end

local function light(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

-- Text on the front (-Z) face of a part
local function label(
	p: BasePart,
	text: string,
	color: Color3,
	font: Enum.Font?,
	face: Enum.NormalId?,
	glow: boolean?
): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = if glow then 0 else 1
	gui.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = font or Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = color
	t.Text = text
	t.Parent = gui
	return t
end

-- Walls --------------------------------------------------------------------------------------

export type WallStyle = {
	Color: Color3,
	Material: Enum.Material?,
	Base: Color3?, -- baseboard (default: a darker shade of the wall)
	Crown: Color3?, -- crown moulding at the ceiling (default: off-white)
	Wainscot: Color3?, -- lower wood panelling with a chair rail (mansion rooms)
	Door: Color3?, -- door casings and leaves
}

-- A strip running along a wall on one face (side = +1 / -1)
local function strip(
	alongX: boolean,
	fixed: number,
	from: number,
	to: number,
	y: number,
	height: number,
	depth: number,
	side: number,
	color: Color3,
	material: Enum.Material?
)
	local len = to - from
	if len < 0.05 then
		return
	end
	local mid = (from + to) / 2
	local off = fixed + side * (T / 2 + depth / 2)
	local size = if alongX then Vector3.new(len, height, depth) else Vector3.new(depth, height, len)
	local cf = if alongX then at(mid, y, off) else at(off, y, mid)
	deco("Trim", size, cf, color, material)
end

-- An axis-aligned wall from (x1, z1) to (x2, z2) with doorways cut at the given offsets along it.
-- `style` dresses the +X / +Z face, `back` the -X / -Z face (same as `style` if left out), so a
-- wall between two rooms can wear each room's wallpaper.
function Kit.wall(
	x1: number,
	z1: number,
	x2: number,
	z2: number,
	style: WallStyle,
	doors: { number }?,
	back: WallStyle?
)
	local alongX = z1 == z2
	local a, b =
		math.min(if alongX then x1 else z1, if alongX then x2 else z2),
		math.max(if alongX then x1 else z1, if alongX then x2 else z2)
	local fixed = if alongX then z1 else x1
	local gaps: { number } = table.clone(doors or {})
	table.sort(gaps)
	local doorColor = style.Door or rgb(110, 70, 40)
	local sides: { [number]: WallStyle } = { [1] = style, [-1] = back or style }

	local function segment(from: number, to: number, y0: number, y1: number)
		if to - from < 0.05 then
			return
		end
		local mid, len = (from + to) / 2, to - from
		local size = if alongX then Vector3.new(len, y1 - y0, T) else Vector3.new(T, y1 - y0, len)
		local cf = if alongX then at(mid, (y0 + y1) / 2, fixed) else at(fixed, (y0 + y1) / 2, mid)
		part("Wall", size, cf, style.Color, style.Material)
		for _, side in { -1, 1 } do
			local s = sides[side]
			if s ~= style and (s.Color ~= style.Color or s.Material ~= style.Material) then
				-- the other room's wallpaper, a thin layer on its face
				strip(alongX, fixed, from, to, (y0 + y1) / 2, y1 - y0, 0.04, side, s.Color, s.Material)
			end
			strip(alongX, fixed, from, to, WALL_HEIGHT - 0.35, 0.7, 0.35, side, s.Crown or rgb(245, 243, 236))
			if y0 == 0 then
				if s.Wainscot then
					local wood = s.Wainscot
					strip(alongX, fixed, from, to, 2.25, 4.5, 0.12, side, wood, Enum.Material.Wood)
					strip(alongX, fixed, from, to, 4.6, 0.3, 0.3, side, darker(wood, 0.2), Enum.Material.Wood)
					-- raised panel stiles every few studs
					local n = math.floor(len / 5)
					for i = 1, n do
						local stile = from + i * len / (n + 1)
						strip(
							alongX,
							fixed,
							stile - 0.2,
							stile + 0.2,
							2.4,
							3.6,
							0.2,
							side,
							darker(wood, 0.12),
							Enum.Material.Wood
						)
					end
				end
				strip(alongX, fixed, from, to, 0.4, 0.8, 0.22, side, s.Base or darker(s.Color, 0.45))
			end
		end
	end

	local cursor = a
	for _, center in gaps do
		local d0, d1 = center - DOOR_WIDTH / 2, center + DOOR_WIDTH / 2
		segment(cursor, d0, 0, WALL_HEIGHT)
		segment(d0, d1, DOOR_HEIGHT, WALL_HEIGHT) -- lintel
		-- Casing: two posts and a header on both faces, an open door leaf and its knob
		for _, edge in { d0, d1 } do
			local size = if alongX
				then Vector3.new(0.5, DOOR_HEIGHT, T + 0.3)
				else Vector3.new(T + 0.3, DOOR_HEIGHT, 0.5)
			part(
				"DoorFrame",
				size,
				if alongX then at(edge, DOOR_HEIGHT / 2, fixed) else at(fixed, DOOR_HEIGHT / 2, edge),
				doorColor
			)
		end
		local header = if alongX
			then Vector3.new(DOOR_WIDTH + 1, 0.6, T + 0.3)
			else Vector3.new(T + 0.3, 0.6, DOOR_WIDTH + 1)
		deco(
			"DoorFrame",
			header,
			if alongX then at(center, DOOR_HEIGHT + 0.3, fixed) else at(fixed, DOOR_HEIGHT + 0.3, center),
			doorColor
		)
		local leafSize = if alongX
			then Vector3.new(0.35, DOOR_HEIGHT - 0.3, DOOR_WIDTH - 0.6)
			else Vector3.new(DOOR_WIDTH - 0.6, DOOR_HEIGHT - 0.3, 0.35)
		-- Doors swing away from the middle of the building, so they open into rooms, not corridors
		local swing = if fixed < 0 then -1 else 1
		local leafCf = if alongX
			then at(d0 + 0.3, DOOR_HEIGHT / 2, fixed + swing * DOOR_WIDTH / 2)
			else at(fixed + swing * DOOR_WIDTH / 2, DOOR_HEIGHT / 2, d0 + 0.3)
		local leaf = deco("Door", leafSize, leafCf, darker(doorColor, 0.1), Enum.Material.Wood)
		-- two recessed panels on each side of the leaf
		for _, y in { -2, 2 } do
			local panel = if alongX
				then Vector3.new(0.45, 3, DOOR_WIDTH - 2.2)
				else Vector3.new(DOOR_WIDTH - 2.2, 3, 0.45)
			deco("DoorPanel", panel, leafCf * CFrame.new(0, y, 0), darker(doorColor, 0.25), Enum.Material.Wood)
		end
		local knobOffset = if alongX
			then Vector3.new(0, -0.4, DOOR_WIDTH / 2 - 1)
			else Vector3.new(DOOR_WIDTH / 2 - 1, -0.4, 0)
		ball(deco("Knob", Vector3.one * 0.45, leafCf * CFrame.new(knobOffset), rgb(212, 175, 80), Enum.Material.Metal))
		leaf.CanCollide = true -- an open door you bump into, not walk through
		leaf.CanQuery = true -- and thrown knives stick in it
		cursor = d1
	end
	segment(cursor, b, 0, WALL_HEIGHT)
end

-- Floors and ceilings ------------------------------------------------------------------------

-- The base slab. Coins and the Revolver land on anything called "Floor".
function Kit.floor(x: number, z: number, sizeX: number, sizeZ: number, color: Color3, material: Enum.Material)
	part("Floor", Vector3.new(sizeX, 1, sizeZ), at(x, -0.5, z), color, material)
end

-- A room's own floor laid on top of the slab (carpet tiles, parquet, concrete...)
function Kit.roomFloor(x: number, z: number, sizeX: number, sizeZ: number, color: Color3, material: Enum.Material)
	part("Floor", Vector3.new(sizeX, 0.1, sizeZ), at(x, 0.05, z), color, material)
end

-- Checkerboard tiles (kitchens, bathrooms)
function Kit.checker(x: number, z: number, sizeX: number, sizeZ: number, tile: number, c1: Color3, c2: Color3)
	local nx, nz = math.floor(sizeX / tile), math.floor(sizeZ / tile)
	local tx, tz = sizeX / nx, sizeZ / nz
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			part(
				"Floor",
				Vector3.new(tx, 0.1, tz),
				at(x - sizeX / 2 + (i + 0.5) * tx, 0.05, z - sizeZ / 2 + (j + 0.5) * tz),
				if (i + j) % 2 == 0 then c1 else c2,
				Enum.Material.CeramicTiles
			)
		end
	end
end

-- Rugs sit on the floor; no collision and no queries so coins still land "on" them
function Kit.rug(x: number, z: number, sizeX: number, sizeZ: number, color: Color3, border: Color3?)
	if border then
		deco("Rug", Vector3.new(sizeX, 0.1, sizeZ), at(x, 0.12, z), border, Enum.Material.Fabric)
		deco("Rug", Vector3.new(sizeX - 1.6, 0.1, sizeZ - 1.6), at(x, 0.14, z), color, Enum.Material.Fabric)
		deco(
			"Rug",
			Vector3.new(sizeX - 3.4, 0.1, sizeZ - 3.4),
			at(x, 0.16, z),
			darker(color, 0.15),
			Enum.Material.Fabric
		)
		deco("Rug", Vector3.new(sizeX - 4.2, 0.1, sizeZ - 4.2), at(x, 0.18, z), color, Enum.Material.Fabric)
	else
		deco("Rug", Vector3.new(sizeX, 0.1, sizeZ), at(x, 0.12, z), color, Enum.Material.Fabric)
	end
end

function Kit.ceiling(sizeX: number, sizeZ: number, color: Color3)
	local p = part("Ceiling", Vector3.new(sizeX + 2, 1, sizeZ + 2), at(0, WALL_HEIGHT + 0.5, 0), color)
	-- Solid and queryable: the camera bumps into it instead of poking out above the rooms.
	-- (Coins and spawns raycast from below it.)
	p.CastShadow = false
end

-- Drop-ceiling grid lines (offices)
function Kit.ceilingGrid(x: number, z: number, sizeX: number, sizeZ: number, spacing: number, color: Color3)
	for gx = x - sizeX / 2 + spacing, x + sizeX / 2 - 0.1, spacing do
		deco("CeilingGrid", Vector3.new(0.18, 0.1, sizeZ), at(gx, WALL_HEIGHT - 0.05, z), color)
	end
	for gz = z - sizeZ / 2 + spacing, z + sizeZ / 2 - 0.1, spacing do
		deco("CeilingGrid", Vector3.new(sizeX, 0.1, 0.18), at(x, WALL_HEIGHT - 0.05, gz), color)
	end
end

-- Lights ---------------------------------------------------------------------------------------
-- About one light in four flickers (Atmosphere animates anything tagged "Flicker").

local function maybeFlicker(p: BasePart, chance: number?)
	if math.random() < (chance or 0.25) then
		p:AddTag("Flicker")
	end
end

-- Candle and fire light: wavers softly instead of cutting out
local function flame(p: BasePart)
	p:SetAttribute("Flame", true)
	p:AddTag("Flicker")
end

-- Office strip light: a housing with a glowing lens, cool white
function Kit.fluorescent(x: number, z: number, rotation: number?, flicker: number?)
	local b = frame(x, z, rotation, WALL_HEIGHT)
	bit(b, "LightHousing", Vector3.new(2.6, 0.3, 6.4), Vector3.new(0, -0.15, 0), rgb(225, 225, 228))
	local lens =
		bit(b, "Lamp", Vector3.new(2, 0.1, 5.8), Vector3.new(0, -0.33, 0), rgb(235, 242, 255), Enum.Material.Neon)
	light(lens, rgb(225, 238, 255), 22, 0.55)
	maybeFlicker(lens, flicker)
end

-- A bare bulb on a cord (storage rooms)
function Kit.pendant(x: number, z: number, drop: number?, flicker: number?)
	local d = drop or 3
	local b = frame(x, z, 0, WALL_HEIGHT)
	bit(b, "Cord", Vector3.new(0.08, d, 0.08), Vector3.new(0, -d / 2, 0), rgb(20, 20, 20))
	local shade = cylinder(
		bit(b, "Shade", Vector3.new(1.6, 0.5, 1.6), Vector3.new(0, -d - 0.1, 0), rgb(60, 70, 60), Enum.Material.Metal),
		"Y"
	)
	local _ = shade
	local bulb =
		ball(bit(b, "Lamp", Vector3.one * 0.6, Vector3.new(0, -d - 0.45, 0), rgb(255, 225, 160), Enum.Material.Neon))
	light(bulb, rgb(255, 200, 130), 18, 0.6)
	maybeFlicker(bulb, flicker)
end

-- Round recessed downlight (corridors)
function Kit.downlight(x: number, z: number, color: Color3?, flicker: number?)
	local b = frame(x, z, 0, WALL_HEIGHT)
	cylinder(bit(b, "LightRing", Vector3.new(1.8, 0.12, 1.8), Vector3.new(0, -0.05, 0), rgb(200, 200, 205)), "Y")
	local lens = cylinder(
		bit(b, "Lamp", Vector3.new(1.3, 0.14, 1.3), Vector3.new(0, -0.07, 0), rgb(255, 245, 225), Enum.Material.Neon),
		"Y"
	)
	light(lens, color or rgb(255, 240, 220), 20, 0.55)
	maybeFlicker(lens, flicker)
end

-- The Blender chandelier hanging from the ceiling, with one warm light for all its candles
function Kit.chandelier(x: number, z: number)
	local model = Props.Build("Chandelier", true)
	model:PivotTo(at(x, WALL_HEIGHT, z))
	model.Parent = folder
	local glow = deco("Lamp", Vector3.one * 0.3, at(x, WALL_HEIGHT - 3, z), rgb(255, 190, 110))
	glow.Transparency = 1
	light(glow, rgb(255, 190, 120), 30, 0.85)
	flame(glow)
end

-- The Blender wall sconce (a candle on an iron arm). `outward` points away from the wall.
function Kit.sconce(x: number, y: number, z: number, outward: Vector3)
	local pos = origin + Vector3.new(x, y, z)
	local model = Props.Build("Sconce", true)
	model:PivotTo(CFrame.lookAt(pos, pos + outward))
	model.Parent = folder
	local glow =
		deco("Lamp", Vector3.one * 0.2, CFrame.new(pos + outward * 1.1 + Vector3.new(0, 0.4, 0)), rgb(255, 200, 120))
	glow.Transparency = 1
	light(glow, rgb(255, 180, 100), 12, 0.7)
	flame(glow)
end

-- Windows ------------------------------------------------------------------------------------

export type WindowOptions = {
	Width: number?,
	Height: number?,
	Sill: number?, -- height of the bottom edge
	Frame: Color3?,
	Curtains: Color3?,
}

-- A window on a wall face looking out at the night (x, z on the face; rotation as for furniture,
-- e.g. 0 on the north wall). Moonlight falls into the room.
function Kit.window(x: number, z: number, rotation: number, options: WindowOptions?)
	local o: WindowOptions = options or {}
	local w, h = o.Width or 6, o.Height or 6.5
	local sill = o.Sill or 3.8
	local frameColor = o.Frame or rgb(240, 240, 235)
	local b = frame(x, z, rotation, sill + h / 2)
	local sky = bit(b, "Window", Vector3.new(w, h, 0.1), Vector3.new(0, 0, -0.05), rgb(28, 42, 82), Enum.Material.Neon)
	sky:AddTag("Window")
	local moon = Instance.new("SpotLight")
	moon.Color = rgb(150, 175, 255)
	moon.Brightness = 1.4
	moon.Range = 20
	moon.Angle = 70
	moon.Shadows = false
	moon.Face = Enum.NormalId.Front
	moon.Parent = sky
	local glass =
		bit(b, "Glass", Vector3.new(w, h, 0.05), Vector3.new(0, 0, -0.18), rgb(190, 215, 240), Enum.Material.Glass)
	glass.Transparency = 0.75
	glass.Reflectance = 0.2
	-- frame and mullions
	bit(b, "WindowFrame", Vector3.new(w + 0.8, 0.4, 0.45), Vector3.new(0, h / 2 + 0.2, -0.22), frameColor)
	bit(b, "WindowFrame", Vector3.new(w + 0.8, 0.4, 0.45), Vector3.new(0, -h / 2 - 0.2, -0.22), frameColor)
	for _, sx in { -1, 1 } do
		bit(b, "WindowFrame", Vector3.new(0.4, h, 0.45), Vector3.new(sx * (w / 2 + 0.2), 0, -0.22), frameColor)
	end
	bit(b, "Mullion", Vector3.new(0.22, h, 0.3), Vector3.new(0, 0, -0.18), frameColor)
	bit(b, "Mullion", Vector3.new(w, 0.22, 0.3), Vector3.new(0, h * 0.12, -0.18), frameColor)
	bit(b, "Sill", Vector3.new(w + 1.4, 0.3, 0.9), Vector3.new(0, -h / 2 - 0.45, -0.45), frameColor)
	if o.Curtains then
		local c = o.Curtains
		bit(
			b,
			"CurtainRod",
			Vector3.new(w + 3.2, 0.18, 0.18),
			Vector3.new(0, h / 2 + 1, -0.7),
			rgb(200, 165, 70),
			Enum.Material.Metal
		)
		for _, sx in { -1, 1 } do
			bit(
				b,
				"Curtain",
				Vector3.new(1.6, h + 2.4, 0.3),
				Vector3.new(sx * (w / 2 + 0.6), -0.3, -0.75),
				c,
				Enum.Material.Fabric
			)
			bit(
				b,
				"CurtainTie",
				Vector3.new(1.75, 0.25, 0.4),
				Vector3.new(sx * (w / 2 + 0.6), -0.8, -0.75),
				rgb(200, 165, 70),
				Enum.Material.Fabric
			)
		end
		bit(
			b,
			"Valance",
			Vector3.new(w + 3, 1.1, 0.45),
			Vector3.new(0, h / 2 + 1.1, -0.8),
			darker(c, 0.15),
			Enum.Material.Fabric
		)
	end
end

-- Wall clutter -------------------------------------------------------------------------------
-- (x, y, z) is the spot on the wall face; rotation as for furniture.

export type ArtKind = "Landscape" | "Portrait" | "Abstract" | "Sea"

function Kit.picture(
	x: number,
	y: number,
	z: number,
	rotation: number,
	kind: ArtKind,
	frameColor: Color3?,
	scale: number?
)
	local s = scale or 1
	local b = frame(x, z, rotation, y)
	local fc = frameColor or rgb(90, 60, 30)
	local w, h = 4.4 * s, 3.4 * s
	if kind == "Portrait" then
		w, h = 3.2 * s, 4.2 * s
	end
	bit(b, "PictureFrame", Vector3.new(w + 0.5, h + 0.5, 0.25), Vector3.new(0, 0, -0.13), fc, Enum.Material.Wood)
	local function paint(name: string, size: Vector3, offset: Vector2, color: Color3, depth: number)
		bit(
			b,
			name,
			Vector3.new(size.X * s, size.Y * s, 0.06),
			Vector3.new(offset.X * s, offset.Y * s, -0.27 - depth * 0.01),
			color
		)
	end
	if kind == "Landscape" then
		paint("Canvas", Vector3.new(4.4, 3.4, 0), Vector2.zero, rgb(120, 170, 220), 0)
		paint("Hill", Vector3.new(4.4, 1.4, 0), Vector2.new(0, -1), rgb(80, 140, 70), 1)
		paint("Hill", Vector3.new(2.2, 1.2, 0), Vector2.new(-1, -0.4), rgb(100, 160, 80), 2)
		paint("Sun", Vector3.new(0.7, 0.7, 0), Vector2.new(1.3, 0.9), rgb(255, 220, 90), 1)
	elseif kind == "Sea" then
		paint("Canvas", Vector3.new(4.4, 3.4, 0), Vector2.zero, rgb(240, 170, 110), 0)
		paint("Sea", Vector3.new(4.4, 1.5, 0), Vector2.new(0, -0.95), rgb(40, 80, 140), 1)
		paint("Sun", Vector3.new(1.1, 0.55, 0), Vector2.new(0, -0.05), rgb(255, 210, 90), 1)
		paint("Boat", Vector3.new(0.6, 0.25, 0), Vector2.new(-1.1, -0.6), rgb(40, 30, 25), 2)
	elseif kind == "Portrait" then
		-- an old, slightly unsettling ancestor
		paint("Canvas", Vector3.new(3.2, 4.2, 0), Vector2.zero, rgb(45, 35, 30), 0)
		paint("Shoulders", Vector3.new(2.4, 1.2, 0), Vector2.new(0, -1.5), rgb(25, 25, 30), 1)
		paint("Collar", Vector3.new(0.7, 0.5, 0), Vector2.new(0, -1.05), rgb(230, 225, 210), 2)
		paint("Face", Vector3.new(1.2, 1.5, 0), Vector2.new(0, -0.05), rgb(225, 190, 160), 2)
		paint("Hair", Vector3.new(1.4, 0.5, 0), Vector2.new(0, 0.75), rgb(70, 60, 55), 3)
		for _, ex in { -0.25, 0.25 } do
			paint("Eye", Vector3.new(0.16, 0.12, 0), Vector2.new(ex, 0.1), rgb(20, 20, 20), 3)
		end
		paint("Mouth", Vector3.new(0.4, 0.07, 0), Vector2.new(0, -0.45), rgb(120, 60, 60), 3)
	else
		paint("Canvas", Vector3.new(4.4, 3.4, 0), Vector2.zero, rgb(240, 236, 225), 0)
		paint("Block", Vector3.new(1.6, 2.2, 0), Vector2.new(-1, 0.3), rgb(200, 50, 50), 1)
		paint("Block", Vector3.new(1.8, 1, 0), Vector2.new(0.9, 0.9), rgb(40, 80, 170), 1)
		paint("Block", Vector3.new(1.2, 1.2, 0), Vector2.new(1, -0.8), rgb(240, 200, 50), 1)
		paint("Line", Vector3.new(4.4, 0.12, 0), Vector2.new(0, -0.1), rgb(20, 20, 20), 2)
		paint("Line", Vector3.new(0.12, 3.4, 0), Vector2.new(0.05, 0), rgb(20, 20, 20), 2)
	end
end

-- A wall clock whose hands really turn (Atmosphere drives anything tagged "ClockHand")
function Kit.clock(x: number, y: number, z: number, rotation: number, face: Color3?, rim: Color3?)
	local b = frame(x, z, rotation, y)
	cylinder(bit(b, "ClockRim", Vector3.new(2.6, 2.6, 0.3), Vector3.new(0, 0, -0.15), rim or rgb(40, 40, 45)), "Z")
	cylinder(bit(b, "ClockFace", Vector3.new(2.2, 2.2, 0.1), Vector3.new(0, 0, -0.3), face or rgb(245, 245, 240)), "Z")
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local long = i % 3 == 0
		bit(
			b,
			"ClockTick",
			Vector3.new(0.08, if long then 0.3 else 0.18, 0.05),
			Vector3.new(math.sin(a) * 0.9, math.cos(a) * 0.9, -0.37),
			rgb(30, 30, 30)
		).CFrame = b
			* CFrame.new(math.sin(a) * 0.9, math.cos(a) * 0.9, -0.37)
			* CFrame.Angles(0, 0, -a)
	end
	local center = b * CFrame.new(0, 0, -0.42)
	local hands: { { Kind: string, Length: number, Width: number } } = {
		{ Kind = "Hour", Length = 0.55, Width = 0.12 },
		{ Kind = "Minute", Length = 0.85, Width = 0.08 },
		{ Kind = "Second", Length = 0.9, Width = 0.04 },
	}
	for _, hand in hands do
		local kind, length, width = hand.Kind, hand.Length, hand.Width
		local p = deco(
			"ClockHand",
			Vector3.new(width, length, 0.04),
			center * CFrame.new(0, length / 2, 0),
			if kind == "Second" then rgb(200, 30, 30) else rgb(20, 20, 20)
		)
		p:SetAttribute("Hand", kind)
		p:SetAttribute("Center", center)
		p:AddTag("ClockHand")
	end
	ball(deco("ClockPin", Vector3.one * 0.15, center, rgb(20, 20, 20)))
end

export type SignOptions = { Glow: boolean?, Font: Enum.Font?, Material: Enum.Material? }

-- A glowing sign with text (exit signs, door plates, company logos...)
function Kit.sign(
	x: number,
	y: number,
	z: number,
	rotation: number,
	text: string,
	size: Vector2,
	background: Color3,
	textColor: Color3,
	options: SignOptions?
)
	local o: SignOptions = options or {}
	local b = frame(x, z, rotation, y)
	local p = bit(b, "Sign", Vector3.new(size.X, size.Y, 0.2), Vector3.new(0, 0, -0.1), background, o.Material)
	label(p, text, textColor, o.Font, nil, o.Glow)
	if o.Glow then
		light(p, background:Lerp(textColor, 0.3), 8, 0.6)
	end
end

function Kit.exitSign(x: number, y: number, z: number, rotation: number)
	local b = frame(x, z, rotation, y)
	bit(b, "SignBox", Vector3.new(2.8, 1.1, 0.5), Vector3.new(0, 0, -0.25), rgb(235, 235, 235))
	local panel =
		bit(b, "Sign", Vector3.new(2.5, 0.85, 0.06), Vector3.new(0, 0, -0.53), rgb(40, 200, 90), Enum.Material.Neon)
	label(panel, "EXIT", rgb(255, 255, 255), Enum.Font.GothamBlack, nil, true)
	light(panel, rgb(60, 255, 120), 7, 0.5)
end

function Kit.lightSwitch(x: number, y: number, z: number, rotation: number)
	local b = frame(x, z, rotation, y)
	bit(b, "Switch", Vector3.new(0.5, 0.8, 0.08), Vector3.new(0, 0, -0.04), rgb(245, 245, 240))
	bit(b, "Toggle", Vector3.new(0.12, 0.25, 0.1), Vector3.new(0, 0.05, -0.1), rgb(230, 230, 225))
end

function Kit.extinguisher(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation, 0)
	bit(b, "Bracket", Vector3.new(0.9, 0.3, 0.3), Vector3.new(0, 4, -0.15), rgb(60, 60, 60), Enum.Material.Metal)
	cylinder(
		bit(
			b,
			"Extinguisher",
			Vector3.new(0.75, 2.2, 0.75),
			Vector3.new(0, 3.4, -0.55),
			rgb(200, 25, 25),
			Enum.Material.Metal
		),
		"Y"
	)
	bit(b, "Nozzle", Vector3.new(0.25, 0.5, 0.25), Vector3.new(0, 4.7, -0.55), rgb(30, 30, 30))
	bit(b, "Hose", Vector3.new(0.15, 1.4, 0.15), Vector3.new(0.35, 3.8, -0.85), rgb(25, 25, 25))
	local sign = bit(b, "Sign", Vector3.new(1.2, 1.2, 0.05), Vector3.new(0, 6, -0.03), rgb(200, 25, 25))
	label(sign, "FIRE", rgb(255, 255, 255), Enum.Font.GothamBlack)
end

-- Corkboard with pinned notes and a "MISSING" flyer
function Kit.corkboard(x: number, y: number, z: number, rotation: number, flyer: string?)
	local b = frame(x, z, rotation, y)
	bit(b, "BoardFrame", Vector3.new(6.4, 4.2, 0.2), Vector3.new(0, 0, -0.1), rgb(110, 75, 45), Enum.Material.Wood)
	bit(b, "Cork", Vector3.new(6, 3.8, 0.06), Vector3.new(0, 0, -0.22), rgb(190, 145, 95), Enum.Material.Fabric)
	local rng = Random.new(math.floor(x * 31 + z * 17))
	local colors = { rgb(255, 245, 140), rgb(255, 255, 255), rgb(170, 220, 255), rgb(255, 180, 200) }
	for _ = 1, 5 do
		local px, py = rng:NextNumber(0.6, 2.6), rng:NextNumber(-1.3, 1.3)
		local note =
			bit(b, "Note", Vector3.new(0.9, 0.9, 0.03), Vector3.new(px, py, -0.26), colors[rng:NextInteger(1, #colors)])
		note.CFrame = note.CFrame * CFrame.Angles(0, 0, rng:NextNumber(-0.2, 0.2))
		ball(bit(b, "Pin", Vector3.one * 0.12, Vector3.new(px, py + 0.35, -0.3), rgb(220, 40, 40)))
	end
	local poster = bit(b, "Poster", Vector3.new(2.2, 3, 0.03), Vector3.new(-1.6, 0, -0.26), rgb(250, 250, 245))
	label(
		poster,
		flyer or "MISSING\n\nHave you seen this person?\n\nLast seen near the Manor",
		rgb(30, 30, 30),
		Enum.Font.SourceSansBold
	)
	ball(bit(b, "Pin", Vector3.one * 0.12, Vector3.new(-1.6, 1.35, -0.3), rgb(40, 90, 220)))
end

function Kit.whiteboard(x: number, y: number, z: number, rotation: number, text: string)
	local b = frame(x, z, rotation, y)
	bit(b, "BoardFrame", Vector3.new(8.4, 4.4, 0.2), Vector3.new(0, 0, -0.1), rgb(190, 190, 195), Enum.Material.Metal)
	local board = bit(b, "Whiteboard", Vector3.new(8, 4, 0.06), Vector3.new(0, 0, -0.22), rgb(250, 250, 250))
	local t = label(board, text, rgb(30, 60, 160), Enum.Font.PatrickHand)
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Top
	bit(b, "Tray", Vector3.new(6, 0.2, 0.5), Vector3.new(0, -2.25, -0.3), rgb(190, 190, 195), Enum.Material.Metal)
	for i, c in { rgb(30, 60, 160), rgb(200, 40, 40), rgb(30, 140, 60) } do
		cylinder(bit(b, "Marker", Vector3.new(0.6, 0.15, 0.15), Vector3.new(-2 + i * 0.8, -2.08, -0.35), c))
	end
end

-- Furniture: offices --------------------------------------------------------------------------

local WOOD = rgb(125, 85, 50)
local DARK_WOOD = rgb(70, 42, 28)
local DARK = rgb(35, 35, 40)
local STEEL = rgb(165, 168, 175)
Kit.WOOD = WOOD
Kit.DARK_WOOD = DARK_WOOD

local SCREENS = { rgb(80, 150, 230), rgb(60, 180, 120), rgb(230, 230, 240), rgb(40, 60, 120) }

function Kit.desk(x: number, z: number, rotation: number, color: Color3?)
	local b = frame(x, z, rotation)
	local c = color or WOOD
	piece(b, "DeskTop", Vector3.new(7, 0.4, 3.4), Vector3.new(0, 3, 0), c, Enum.Material.Wood)
	for _, sx in { -3.2, 3.2 } do
		piece(b, "DeskSide", Vector3.new(0.4, 2.8, 3.2), Vector3.new(sx, 1.4, 0), c, Enum.Material.Wood)
	end
	bit(b, "ModestyPanel", Vector3.new(6, 1.8, 0.2), Vector3.new(0, 1.9, 1.4), darker(c, 0.1), Enum.Material.Wood)
	bit(b, "Drawers", Vector3.new(1.8, 2.6, 2.8), Vector3.new(-2.1, 1.5, 0), darker(c, 0.05), Enum.Material.Wood)
	for i = 0, 2 do
		bit(
			b,
			"Handle",
			Vector3.new(0.6, 0.12, 0.1),
			Vector3.new(-2.1, 0.6 + i * 0.85, -1.45),
			STEEL,
			Enum.Material.Metal
		)
	end
	bit(b, "Monitor", Vector3.new(2.6, 1.8, 0.25), Vector3.new(0.5, 4.3, 0.8), DARK)
	local rng = Random.new(math.floor(x * 13 + z * 7))
	local screen = SCREENS[rng:NextInteger(1, #SCREENS)]
	bit(b, "Screen", Vector3.new(2.3, 1.5, 0.05), Vector3.new(0.5, 4.3, 0.64), screen, Enum.Material.Neon)
	bit(b, "Stand", Vector3.new(0.3, 0.6, 0.3), Vector3.new(0.5, 3.4, 0.8), DARK)
	bit(b, "StandFoot", Vector3.new(1, 0.08, 0.7), Vector3.new(0.5, 3.24, 0.8), DARK)
	bit(b, "Keyboard", Vector3.new(2, 0.12, 0.7), Vector3.new(0.5, 3.26, -0.3), rgb(220, 220, 220))
	bit(b, "Mouse", Vector3.new(0.3, 0.12, 0.45), Vector3.new(2, 3.26, -0.3), rgb(220, 220, 220))
	bit(b, "Papers", Vector3.new(1.1, 0.3, 1.5), Vector3.new(-2.3, 3.35, 0.2), rgb(250, 250, 250))
	if rng:NextNumber() < 0.6 then
		cylinder(
			bit(
				b,
				"Mug",
				Vector3.new(0.35, 0.45, 0.35),
				Vector3.new(-1.2, 3.42, -0.6),
				rng:NextInteger(1, 2) == 1 and rgb(200, 50, 50) or rgb(240, 240, 240)
			),
			"Y"
		)
	end
	if rng:NextNumber() < 0.4 then
		bit(b, "Photo", Vector3.new(0.5, 0.6, 0.08), Vector3.new(2.6, 3.5, 0.6), DARK).CFrame = b
			* CFrame.new(2.6, 3.5, 0.6)
			* CFrame.Angles(math.rad(-15), math.rad(-20), 0)
	end
	-- Office chair: seat, back, gas lift and a five-star base
	local chair = b * CFrame.new(0.5, 0, -2.4) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0)
	piece(chair, "ChairSeat", Vector3.new(2.2, 0.4, 2.2), Vector3.new(0, 1.9, 0), DARK, Enum.Material.Fabric)
	piece(chair, "ChairBack", Vector3.new(2.2, 2.4, 0.35), Vector3.new(0, 3.3, -1), DARK, Enum.Material.Fabric)
	bit(chair, "ChairPole", Vector3.new(0.3, 1.5, 0.3), Vector3.new(0, 1, 0), STEEL, Enum.Material.Metal)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		bit(chair, "ChairLeg", Vector3.new(0.18, 0.18, 1.1), Vector3.zero, DARK).CFrame = chair
			* CFrame.Angles(0, a, 0)
			* CFrame.new(0, 0.25, -0.55)
	end
end

-- Low fabric partition between desk rows
function Kit.cubicle(x: number, z: number, length: number, rotation: number, color: Color3?)
	local b = frame(x, z, rotation)
	local c = color or rgb(120, 130, 150)
	piece(b, "Partition", Vector3.new(length, 4.6, 0.4), Vector3.new(0, 2.3, 0), c, Enum.Material.Fabric)
	bit(b, "PartitionCap", Vector3.new(length, 0.15, 0.5), Vector3.new(0, 4.65, 0), STEEL, Enum.Material.Metal)
end

function Kit.filingCabinet(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Cabinet", Vector3.new(2, 5.2, 2.4), Vector3.new(0, 2.6, 0), rgb(150, 155, 160), Enum.Material.Metal)
	for i = 0, 3 do
		local y = 0.75 + i * 1.25
		bit(b, "Drawer", Vector3.new(1.8, 1.1, 0.06), Vector3.new(0, y, -1.22), rgb(160, 165, 170), Enum.Material.Metal)
		bit(
			b,
			"Handle",
			Vector3.new(0.7, 0.12, 0.12),
			Vector3.new(0, y + 0.2, -1.3),
			rgb(80, 80, 85),
			Enum.Material.Metal
		)
		bit(b, "LabelCard", Vector3.new(0.5, 0.25, 0.04), Vector3.new(0, y - 0.15, -1.27), rgb(245, 240, 220))
	end
end


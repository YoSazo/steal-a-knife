-- Steel lift doors at a corridor end, with call buttons and a floor readout
function Kit.elevator(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	bit(
		b,
		"ElevatorFrame",
		Vector3.new(8.4, 10.4, 0.4),
		Vector3.new(0, 5.2, -0.2),
		rgb(120, 120, 125),
		Enum.Material.Metal
	)
	for _, sx in { -1.8, 1.8 } do
		bit(
			b,
			"ElevatorDoor",
			Vector3.new(3.5, 9.2, 0.15),
			Vector3.new(sx, 4.6, -0.45),
			rgb(190, 195, 200),
			Enum.Material.DiamondPlate
		)
	end
	bit(b, "ElevatorGap", Vector3.new(0.08, 9.2, 0.16), Vector3.new(0, 4.6, -0.46), rgb(30, 30, 30))
	local display = bit(b, "FloorDisplay", Vector3.new(1.8, 0.8, 0.1), Vector3.new(0, 9.9, -0.45), rgb(20, 10, 10))
	label(display, "13", rgb(255, 60, 40), Enum.Font.Code, nil, true)
	bit(b, "CallPanel", Vector3.new(0.7, 1.6, 0.1), Vector3.new(5, 4.5, -0.05), STEEL, Enum.Material.Metal)
	for i, c in { rgb(255, 255, 255), rgb(255, 170, 40) } do
		cylinder(
			bit(
				b,
				"CallButton",
				Vector3.new(0.35, 0.35, 0.1),
				Vector3.new(5, 4.1 + i * 0.5, -0.12),
				c,
				Enum.Material.Neon
			),
			"Z"
		)
	end
end

-- Glass front doors with push bars (decor: the outer wall stays solid behind them)
function Kit.glassDoors(x: number, z: number, rotation: number, text: string?)
	local b = frame(x, z, rotation)
	bit(b, "DoorFrame", Vector3.new(9, 10, 0.3), Vector3.new(0, 5, -0.15), rgb(60, 60, 65), Enum.Material.Metal)
	for _, sx in { -2.1, 2.1 } do
		local outside = bit(
			b,
			"Outside",
			Vector3.new(3.8, 8.8, 0.06),
			Vector3.new(sx, 4.6, -0.32),
			rgb(14, 20, 40),
			Enum.Material.Neon
		)
		outside:AddTag("Window")
		local g = bit(
			b,
			"Glass",
			Vector3.new(3.8, 8.8, 0.06),
			Vector3.new(sx, 4.6, -0.4),
			rgb(200, 225, 245),
			Enum.Material.Glass
		)
		g.Transparency = 0.7
		g.Reflectance = 0.25
		bit(b, "PushBar", Vector3.new(3, 0.2, 0.25), Vector3.new(sx, 4, -0.55), STEEL, Enum.Material.Metal)
	end
	if text then
		local sticker = bit(b, "Sticker", Vector3.new(3, 0.6, 0.03), Vector3.new(-2.1, 6.8, -0.44), rgb(255, 255, 255))
		sticker.Transparency = 1
		label(sticker, text, rgb(240, 240, 240), Enum.Font.GothamBold)
	end
	bit(b, "Mat", Vector3.new(7, 0.1, 3), Vector3.new(0, 0.1, -2), rgb(60, 50, 45), Enum.Material.Fabric)
end

function Kit.receptionDesk(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Reception", Vector3.new(14, 4, 2), Vector3.new(0, 2, 0), rgb(240, 240, 240))
	bit(b, "ReceptionStripe", Vector3.new(14.05, 0.6, 2.05), Vector3.new(0, 2.6, 0), rgb(150, 30, 40))
	piece(
		b,
		"ReceptionTop",
		Vector3.new(14.4, 0.3, 2.6),
		Vector3.new(0, 4.15, 0),
		rgb(60, 60, 65),
		Enum.Material.Marble
	)
	piece(b, "ReceptionWork", Vector3.new(14, 3, 2), Vector3.new(0, 1.5, 2.4), rgb(225, 225, 225))
	bit(b, "Bell", Vector3.new(0.5, 0.3, 0.5), Vector3.new(-4, 4.45, -0.3), rgb(212, 175, 80), Enum.Material.Metal)
	bit(b, "Monitor", Vector3.new(2.4, 1.6, 0.2), Vector3.new(2, 4.3, 2.6), DARK)
	bit(b, "Screen", Vector3.new(2.1, 1.3, 0.05), Vector3.new(2, 4.3, 2.48), rgb(80, 150, 230), Enum.Material.Neon).CFrame = b
		* CFrame.new(2, 4.3, 2.72)
	bit(b, "Phone", Vector3.new(0.9, 0.35, 0.7), Vector3.new(4.5, 3.2, 2.4), DARK)
	cylinder(
		bit(b, "Vase", Vector3.new(0.6, 1, 0.6), Vector3.new(5.8, 4.8, 0), rgb(240, 240, 255), Enum.Material.Glass),
		"Y"
	)
	for i = 0, 2 do
		ball(bit(b, "Flower", Vector3.one * 0.4, Vector3.new(5.6 + i * 0.2, 5.5 + (i % 2) * 0.2, 0), rgb(230, 60, 90)))
	end
	-- chair behind it
	local chair = b * CFrame.new(0, 0, 4.4) * CFrame.Angles(0, math.pi, 0)
	piece(chair, "ChairSeat", Vector3.new(2.2, 0.4, 2.2), Vector3.new(0, 1.9, 0), DARK, Enum.Material.Fabric)
	piece(chair, "ChairBack", Vector3.new(2.2, 2.4, 0.35), Vector3.new(0, 3.3, -1), DARK, Enum.Material.Fabric)
	bit(chair, "ChairPole", Vector3.new(0.3, 1.5, 0.3), Vector3.new(0, 1, 0), STEEL, Enum.Material.Metal)
end

-- Big wood desk, leather chair, a lamp and a nameplate
function Kit.executiveDesk(x: number, z: number, rotation: number, name: string)
	local b = frame(x, z, rotation)
	piece(b, "DeskTop", Vector3.new(10, 0.5, 4.4), Vector3.new(0, 3.2, 0), DARK_WOOD, Enum.Material.Wood)
	piece(
		b,
		"DeskFront",
		Vector3.new(10, 2.95, 0.4),
		Vector3.new(0, 1.5, -2),
		darker(DARK_WOOD, 0.1),
		Enum.Material.Wood
	)
	for _, sx in { -4.4, 4.4 } do
		piece(b, "DeskSide", Vector3.new(1.2, 2.95, 4.2), Vector3.new(sx, 1.5, 0), DARK_WOOD, Enum.Material.Wood)
	end
	bit(b, "Blotter", Vector3.new(4, 0.06, 2.2), Vector3.new(0, 3.48, 0.2), rgb(30, 70, 50), Enum.Material.Fabric)
	local plate = bit(
		b,
		"Nameplate",
		Vector3.new(2.2, 0.5, 0.4),
		Vector3.new(0, 3.7, -1.6),
		rgb(212, 175, 80),
		Enum.Material.Metal
	)
	label(plate, name, rgb(40, 30, 10), Enum.Font.Garamond)
	-- banker's lamp
	bit(b, "LampBase", Vector3.new(0.8, 0.2, 0.6), Vector3.new(3.6, 3.55, 0.8), rgb(212, 175, 80), Enum.Material.Metal)
	bit(
		b,
		"LampStem",
		Vector3.new(0.12, 0.9, 0.12),
		Vector3.new(3.6, 4.05, 0.8),
		rgb(212, 175, 80),
		Enum.Material.Metal
	)
	local shade = bit(
		b,
		"LampShade",
		Vector3.new(1.6, 0.4, 0.7),
		Vector3.new(3.6, 4.55, 0.6),
		rgb(30, 110, 60),
		Enum.Material.Glass
	)
	light(shade, rgb(255, 220, 160), 10, 0.6)
	bit(b, "Laptop", Vector3.new(2, 0.1, 1.4), Vector3.new(-1.5, 3.5, 0.3), rgb(180, 180, 185), Enum.Material.Metal)
	bit(b, "LaptopScreen", Vector3.new(2, 1.3, 0.1), Vector3.new(-1.5, 4.15, 1), rgb(60, 120, 200), Enum.Material.Neon)
	bit(b, "Cigar", Vector3.new(0.12, 0.12, 0.6), Vector3.new(-3.6, 3.55, -0.5), rgb(110, 70, 40))
	-- high-backed leather chair
	local chair = b * CFrame.new(0, 0, 3.5) * CFrame.Angles(0, math.pi, 0)
	local leather = rgb(90, 30, 25)
	piece(chair, "ChairSeat", Vector3.new(2.8, 0.7, 2.6), Vector3.new(0, 2, 0), leather, Enum.Material.Leather)
	piece(chair, "ChairBack", Vector3.new(2.8, 3.8, 0.6), Vector3.new(0, 4, 1.2), leather, Enum.Material.Leather)
	for _, sx in { -1.5, 1.5 } do
		bit(chair, "ChairArm", Vector3.new(0.4, 0.9, 2.4), Vector3.new(sx, 2.7, 0), leather, Enum.Material.Leather)
	end
	bit(chair, "ChairPole", Vector3.new(0.35, 1.6, 0.35), Vector3.new(0, 0.9, 0), DARK, Enum.Material.Metal)
end

function Kit.safe(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Safe", Vector3.new(3, 3.6, 2.8), Vector3.new(0, 1.8, 0), rgb(50, 55, 60), Enum.Material.Metal)
	bit(b, "SafeDoor", Vector3.new(2.5, 3.1, 0.1), Vector3.new(0, 1.8, -1.42), rgb(60, 66, 72), Enum.Material.Metal)
	cylinder(
		bit(b, "Dial", Vector3.new(0.9, 0.9, 0.15), Vector3.new(0, 2.2, -1.5), rgb(212, 175, 80), Enum.Material.Metal),
		"Z"
	)
	bit(
		b,
		"SafeHandle",
		Vector3.new(0.9, 0.15, 0.2),
		Vector3.new(0, 1.2, -1.52),
		rgb(212, 175, 80),
		Enum.Material.Metal
	)
end

-- Pull-down screen with a chart projected on it
function Kit.projectorScreen(x: number, y: number, z: number, rotation: number)
	local b = frame(x, z, rotation, y)
	bit(b, "ScreenCase", Vector3.new(11, 0.5, 0.5), Vector3.new(0, 3.3, -0.3), rgb(40, 40, 45))
	local screen = bit(b, "ProjectorScreen", Vector3.new(10, 6, 0.05), Vector3.new(0, 0, -0.3), rgb(250, 250, 248))
	local gui = Instance.new("SurfaceGui")
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = screen
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.18)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.Text = "KNIFE SALES - Q3"
	title.TextColor3 = rgb(40, 40, 50)
	title.Parent = gui
	for i, h in { 0.25, 0.4, 0.35, 0.6, 0.15 } do
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.fromScale(0.1 + (i - 1) * 0.16, 0.92)
		bar.Size = UDim2.fromScale(0.1, h)
		bar.BackgroundColor3 = if i == 5 then rgb(220, 50, 50) else rgb(60, 120, 220)
		bar.BorderSizePixel = 0
		bar.Parent = gui
	end
end

-- Furniture: homes ---------------------------------------------------------------------------

function Kit.sofa(x: number, z: number, rotation: number, color: Color3, length: number?)
	local b = frame(x, z, rotation)
	local l = length or 8
	piece(b, "SofaSeat", Vector3.new(l, 1.6, 3.2), Vector3.new(0, 0.8, 0), color, Enum.Material.Fabric)
	piece(b, "SofaBack", Vector3.new(l, 2.6, 0.9), Vector3.new(0, 2.1, 1.2), color, Enum.Material.Fabric)
	for _, sx in { -(l / 2 - 0.45), l / 2 - 0.45 } do
		piece(b, "SofaArm", Vector3.new(0.9, 2.3, 3.2), Vector3.new(sx, 1.15, 0), color, Enum.Material.Fabric)
	end
	-- separate seat cushions with a gap between them, plus a couple of throw pillows
	local n = math.max(2, math.floor((l - 1.8) / 3))
	local cw = (l - 1.8) / n
	for i = 0, n - 1 do
		bit(
			b,
			"Cushion",
			Vector3.new(cw - 0.12, 0.45, 2.3),
			Vector3.new(-l / 2 + 0.9 + (i + 0.5) * cw, 1.82, -0.25),
			lighter(color, 0.12),
			Enum.Material.Fabric
		)
	end
	for _, sx in { -(l / 2 - 1.6), l / 2 - 1.6 } do
		bit(
			b,
			"Pillow",
			Vector3.new(1.4, 1.4, 0.45),
			Vector3.new(sx, 2.6, 0.5),
			lighter(color, 0.35),
			Enum.Material.Fabric
		).CFrame = b
			* CFrame.new(sx, 2.6, 0.5)
			* CFrame.Angles(math.rad(-15), 0, math.rad(if sx > 0 then -12 else 12))
	end
	for _, sx in { -(l / 2 - 0.5), l / 2 - 0.5 } do
		for _, sz in { -1.3, 1.3 } do
			bit(b, "SofaFoot", Vector3.new(0.3, 0.25, 0.3), Vector3.new(sx, -0.1, sz), DARK_WOOD)
		end
	end
end

function Kit.armchair(x: number, z: number, rotation: number, color: Color3)
	local b = frame(x, z, rotation)
	piece(b, "ArmchairSeat", Vector3.new(3.2, 1.6, 3.2), Vector3.new(0, 0.9, 0), color, Enum.Material.Fabric)
	piece(b, "ArmchairBack", Vector3.new(3.2, 3.6, 0.8), Vector3.new(0, 2.6, 1.2), color, Enum.Material.Fabric)
	for _, sx in { -1.45, 1.45 } do
		piece(
			b,
			"ArmchairArm",
			Vector3.new(0.6, 2.4, 3.2),
			Vector3.new(sx, 1.4, 0),
			darker(color, 0.08),
			Enum.Material.Fabric
		)
	end
	bit(
		b,
		"Cushion",
		Vector3.new(2.2, 0.4, 2.3),
		Vector3.new(0, 1.9, -0.25),
		lighter(color, 0.12),
		Enum.Material.Fabric
	)
	for _, sx in { -1.4, 1.4 } do
		for _, sz in { -1.4, 1.4 } do
			bit(b, "Foot", Vector3.new(0.3, 0.3, 0.3), Vector3.new(sx, 0, sz), DARK_WOOD)
		end
	end
end

local LEAF = rgb(60, 150, 60)

function Kit.plant(x: number, z: number, kind: ("Bush" | "Tall" | "Fern")?)
	local b = frame(x, z, 0)
	local pot = cylinder(piece(b, "Pot", Vector3.new(2.2, 2, 2.2), Vector3.new(0, 1, 0), rgb(170, 95, 60)), "Y")
	local _ = pot
	cylinder(bit(b, "PotRim", Vector3.new(2.5, 0.3, 2.5), Vector3.new(0, 1.9, 0), rgb(150, 80, 50)), "Y")
	cylinder(bit(b, "Soil", Vector3.new(2, 0.1, 2), Vector3.new(0, 2.02, 0), rgb(60, 40, 25)), "Y")
	if kind == "Tall" then
		bit(b, "Trunk", Vector3.new(0.3, 5, 0.3), Vector3.new(0, 4.5, 0), rgb(100, 70, 40), Enum.Material.Wood)
		for i, offset in
			{
				Vector3.new(0, 7.2, 0),
				Vector3.new(0.9, 6.3, 0.4),
				Vector3.new(-0.8, 6.6, -0.5),
				Vector3.new(0.2, 5.5, -0.9),
			}
		do
			ball(bit(b, "Leaves", Vector3.one * (2.4 - i * 0.2), offset, darker(LEAF, i * 0.05), Enum.Material.Grass))
		end
	elseif kind == "Fern" then
		for i = 0, 6 do
			local a = i / 7 * math.pi * 2
			bit(b, "Frond", Vector3.new(0.5, 0.12, 2.6), Vector3.zero, LEAF, Enum.Material.Grass).CFrame = b
				* CFrame.new(0, 2.4, 0)
				* CFrame.Angles(0, a, 0)
				* CFrame.Angles(math.rad(25), 0, 0)
				* CFrame.new(0, 0, -1.1)
		end
	else
		for i, offset in
			{
				Vector3.new(0, 3.2, 0),
				Vector3.new(0.6, 4.2, 0.3),
				Vector3.new(-0.5, 4.6, -0.4),
				Vector3.new(0.1, 5.3, 0.1),
			}
		do
			ball(bit(b, "Leaves", Vector3.one * (2.6 - i * 0.3), offset, darker(LEAF, i * 0.04), Enum.Material.Grass))
		end
	end
end

function Kit.floorLamp(x: number, z: number, color: Color3?)
	local b = frame(x, z, 0)
	cylinder(
		bit(b, "LampBase", Vector3.new(1.4, 0.2, 1.4), Vector3.new(0, 0.1, 0), rgb(40, 40, 40), Enum.Material.Metal),
		"Y"
	)
	bit(b, "LampPole", Vector3.new(0.15, 6, 0.15), Vector3.new(0, 3.1, 0), rgb(40, 40, 40), Enum.Material.Metal)
	local shade = cylinder(
		bit(
			b,
			"LampShade",
			Vector3.new(1.8, 1.4, 1.8),
			Vector3.new(0, 6.6, 0),
			color or rgb(240, 225, 190),
			Enum.Material.Fabric
		),
		"Y"
	)
	light(shade, rgb(255, 210, 150), 14, 0.7)
end

function Kit.coffeeTable(x: number, z: number, sizeX: number, sizeZ: number, rotation: number?)
	local b = frame(x, z, rotation)
	piece(b, "CoffeeTable", Vector3.new(sizeX, 0.35, sizeZ), Vector3.new(0, 1.6, 0), DARK_WOOD, Enum.Material.Wood)
	bit(b, "Shelf", Vector3.new(sizeX - 0.6, 0.2, sizeZ - 0.6), Vector3.new(0, 0.5, 0), DARK_WOOD, Enum.Material.Wood)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			bit(
				b,
				"Leg",
				Vector3.new(0.3, 1.45, 0.3),
				Vector3.new(sx * (sizeX / 2 - 0.3), 0.72, sz * (sizeZ / 2 - 0.3)),
				DARK_WOOD
			)
		end
	end
	bit(b, "Magazine", Vector3.new(1, 0.06, 1.3), Vector3.new(-sizeX / 4, 1.8, 0), rgb(220, 60, 60)).CFrame = b
		* CFrame.new(-sizeX / 4, 1.8, 0)
		* CFrame.Angles(0, 0.3, 0)
	cylinder(bit(b, "Mug", Vector3.new(0.35, 0.45, 0.35), Vector3.new(sizeX / 4, 2, 0.2), rgb(240, 240, 240)), "Y")
end

function Kit.tableWithChairs(x: number, z: number, sizeX: number, sizeZ: number, color: Color3?)
	local b = frame(x, z, 0)
	local c = color or WOOD
	piece(b, "Table", Vector3.new(sizeX, 0.5, sizeZ), Vector3.new(0, 3, 0), c, Enum.Material.Wood)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			piece(
				b,
				"TableLeg",
				Vector3.new(0.5, 2.8, 0.5),
				Vector3.new(sx * (sizeX / 2 - 0.6), 1.4, sz * (sizeZ / 2 - 0.6)),
				c
			)
		end
	end
	local chairs = math.max(1, math.floor(sizeX / 4))
	for i = 1, chairs do
		local cx = -sizeX / 2 + (i - 0.5) * sizeX / chairs
		for _, side in { -1, 1 } do
			local chair = b
				* CFrame.new(cx, 0, side * (sizeZ / 2 + 1.4))
				* CFrame.Angles(0, if side > 0 then 0 else math.pi, 0)
			piece(chair, "ChairSeat", Vector3.new(2, 0.35, 2), Vector3.new(0, 1.9, 0), c)
			piece(chair, "ChairBack", Vector3.new(2, 2.4, 0.3), Vector3.new(0, 3.2, 0.9), c)
			for _, lx in { -0.8, 0.8 } do
				for _, lz in { -0.8, 0.8 } do
					bit(chair, "ChairLeg", Vector3.new(0.25, 1.75, 0.25), Vector3.new(lx, 0.88, lz), darker(c, 0.3))
				end
			end
		end
	end
end

-- Candle holder with three lit candles (one warm light for all of them)
local function candelabra(base: CFrame, y: number)
	local gold = rgb(212, 175, 80)
	local b = base * CFrame.new(0, y, 0)
	cylinder(deco("Candelabra", Vector3.new(0.9, 0.2, 0.9), b * CFrame.new(0, 0.1, 0), gold, Enum.Material.Metal), "Y")
	deco("Candelabra", Vector3.new(0.15, 1.4, 0.15), b * CFrame.new(0, 0.8, 0), gold, Enum.Material.Metal)
	deco("Candelabra", Vector3.new(1.8, 0.12, 0.12), b * CFrame.new(0, 1.4, 0), gold, Enum.Material.Metal)
	local first: Part? = nil
	for _, sx in { -0.85, 0, 0.85 } do
		local h = if sx == 0 then 0.9 else 0.7
		cylinder(
			deco("Candle", Vector3.new(0.22, h, 0.22), b * CFrame.new(sx, 1.5 + h / 2, 0), rgb(245, 240, 225)),
			"Y"
		)
		local f = ball(
			deco(
				"Flame",
				Vector3.new(0.18, 0.3, 0.18),
				b * CFrame.new(sx, 1.65 + h, 0),
				rgb(255, 190, 80),
				Enum.Material.Neon
			)
		)
		first = first or f
	end
	if first then
		light(first, rgb(255, 180, 90), 12, 0.6)
		flame(first)
	end
end

-- A long dining table in a white cloth, chairs down both long sides, places set
function Kit.diningTable(x: number, z: number, length: number, width: number, chairColor: Color3)
	local b = frame(x, z, 0)
	piece(b, "Table", Vector3.new(length, 0.5, width), Vector3.new(0, 3, 0), DARK_WOOD, Enum.Material.Wood)
	bit(
		b,
		"Tablecloth",
		Vector3.new(length + 0.4, 0.08, width - 1.2),
		Vector3.new(0, 3.28, 0),
		rgb(245, 242, 235),
		Enum.Material.Fabric
	)
	bit(
		b,
		"Runner",
		Vector3.new(length - 2, 0.06, 1.2),
		Vector3.new(0, 3.33, 0),
		rgb(150, 25, 35),
		Enum.Material.Fabric
	)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			piece(
				b,
				"TableLeg",
				Vector3.new(0.6, 2.8, 0.6),
				Vector3.new(sx * (length / 2 - 0.8), 1.4, sz * (width / 2 - 0.6)),
				DARK_WOOD,
				Enum.Material.Wood
			)
		end
	end
	local seats = math.max(1, math.floor(length / 3.6))
	for i = 1, seats do
		local cx = -length / 2 + (i - 0.5) * length / seats
		for _, side in { -1, 1 } do
			-- plate, glass and cutlery
			local place = b * CFrame.new(cx, 3.33, side * (width / 2 - 1.1))
			cylinder(deco("Plate", Vector3.new(1.2, 0.08, 1.2), place, rgb(250, 250, 250)), "Y")
			cylinder(
				deco(
					"Glass",
					Vector3.new(0.3, 0.6, 0.3),
					place * CFrame.new(0.8, 0.3, -side * 0.5),
					rgb(220, 240, 255),
					Enum.Material.Glass
				),
				"Y"
			).Transparency =
				0.4
			deco(
				"Fork",
				Vector3.new(0.08, 0.04, 0.8),
				place * CFrame.new(-0.85, 0.02, 0),
				rgb(200, 200, 205),
				Enum.Material.Metal
			)
			deco(
				"Knife",
				Vector3.new(0.08, 0.04, 0.9),
				place * CFrame.new(0.85, 0.02, 0),
				rgb(200, 200, 205),
				Enum.Material.Metal
			)
			local chair = b
				* CFrame.new(cx, 0, side * (width / 2 + 1.3))
				* CFrame.Angles(0, if side > 0 then 0 else math.pi, 0)
			piece(chair, "ChairSeat", Vector3.new(2.1, 0.4, 2), Vector3.new(0, 1.9, 0), DARK_WOOD, Enum.Material.Wood)
			bit(
				chair,
				"ChairPad",
				Vector3.new(1.8, 0.2, 1.7),
				Vector3.new(0, 2.15, 0),
				chairColor,
				Enum.Material.Fabric
			)
			piece(
				chair,
				"ChairBack",
				Vector3.new(2.1, 3.6, 0.3),
				Vector3.new(0, 3.8, 0.9),
				DARK_WOOD,
				Enum.Material.Wood
			)
			bit(
				chair,
				"ChairBackPad",
				Vector3.new(1.5, 2.2, 0.1),
				Vector3.new(0, 3.9, 0.72),
				chairColor,
				Enum.Material.Fabric
			)
			for _, lx in { -0.85, 0.85 } do
				for _, lz in { -0.8, 0.8 } do
					bit(chair, "ChairLeg", Vector3.new(0.25, 1.75, 0.25), Vector3.new(lx, 0.88, lz), DARK_WOOD)
				end
			end
		end
	end
	for _, cx in { -length / 4, length / 4 } do
		candelabra(b * CFrame.new(cx, 0, 0), 3.35)
	end
end

function Kit.roundTable(x: number, z: number, radius: number)
	local b = frame(x, z, 0)
	cylinder(
		piece(
			b,
			"Table",
			Vector3.new(radius * 2, 0.4, radius * 2),
			Vector3.new(0, 3.4, 0),
			DARK_WOOD,
			Enum.Material.Wood
		),
		"Y"
	)
	cylinder(bit(b, "Pedestal", Vector3.new(0.8, 3.2, 0.8), Vector3.new(0, 1.7, 0), DARK_WOOD, Enum.Material.Wood), "Y")
	cylinder(bit(b, "Foot", Vector3.new(2.4, 0.3, 2.4), Vector3.new(0, 0.15, 0), DARK_WOOD, Enum.Material.Wood), "Y")
	cylinder(bit(b, "Vase", Vector3.new(1, 2, 1), Vector3.new(0, 4.6, 0), rgb(40, 60, 140), Enum.Material.Glass), "Y")
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		ball(
			bit(
				b,
				"Flower",
				Vector3.one * 0.55,
				Vector3.new(math.cos(a) * 0.5, 5.9 + (i % 2) * 0.3, math.sin(a) * 0.5),
				if i % 2 == 0 then rgb(170, 20, 40) else rgb(240, 240, 240)
			)
		)
	end
end

function Kit.bookshelf(x: number, z: number, rotation: number, color: Color3?)
	local b = frame(x, z, rotation)
	local wood = color or darker(WOOD, 0.25)
	piece(b, "Shelf", Vector3.new(7, 9, 1.8), Vector3.new(0, 4.5, 0.15), wood, Enum.Material.Wood)
	bit(b, "ShelfTop", Vector3.new(7.4, 0.4, 2.1), Vector3.new(0, 9.2, 0), darker(wood, 0.15), Enum.Material.Wood)
	local rng = Random.new(math.floor(x * 7 + z * 13))
	local colors =
		{ rgb(180, 40, 40), rgb(40, 80, 170), rgb(50, 130, 60), rgb(220, 180, 60), rgb(90, 50, 110), rgb(60, 40, 30) }
	for row = 0, 3 do
		bit(
			b,
			"ShelfBoard",
			Vector3.new(6.6, 0.15, 1.6),
			Vector3.new(0, 0.82 + row * 2.1, -0.85),
			darker(wood, 0.2),
			Enum.Material.Wood
		)
		local cursor = -3.1
		while cursor < 2.8 do
			local w = rng:NextNumber(0.35, 0.7)
			local h = rng:NextNumber(1.3, 1.8)
			local book = bit(
				b,
				"Book",
				Vector3.new(w, h, 1.2),
				Vector3.new(cursor + w / 2, 0.9 + row * 2.1 + h / 2, -0.95),
				colors[rng:NextInteger(1, #colors)]
			)
			if rng:NextNumber() < 0.08 then
				-- the odd book leaning over
				book.CFrame = book.CFrame * CFrame.Angles(0, 0, math.rad(-18))
				cursor += 0.3
			end
			cursor += w + 0.05
		end
	end
end

function Kit.bed(x: number, z: number, rotation: number, color: Color3)
	local b = frame(x, z, rotation)
	piece(b, "BedFrame", Vector3.new(6, 1.4, 9), Vector3.new(0, 0.7, 0), WOOD, Enum.Material.Wood)
	piece(b, "Mattress", Vector3.new(5.6, 0.8, 8.4), Vector3.new(0, 1.8, 0), rgb(245, 245, 245), Enum.Material.Fabric)
	bit(b, "Blanket", Vector3.new(5.8, 0.3, 5.5), Vector3.new(0, 2.25, -1.3), color, Enum.Material.Fabric)
	bit(
		b,
		"BlanketFold",
		Vector3.new(5.8, 0.35, 0.8),
		Vector3.new(0, 2.3, 1.3),
		lighter(color, 0.3),
		Enum.Material.Fabric
	)
	bit(b, "Pillow", Vector3.new(3.6, 0.6, 1.6), Vector3.new(0, 2.5, 3.2), rgb(255, 255, 255), Enum.Material.Fabric)
	piece(b, "Headboard", Vector3.new(6, 4, 0.5), Vector3.new(0, 2, 4.4), WOOD, Enum.Material.Wood)
end

-- Canopy bed with turned posts and drapes
function Kit.fourPosterBed(x: number, z: number, rotation: number, color: Color3)
	local b = frame(x, z, rotation)
	piece(b, "BedFrame", Vector3.new(7.4, 1.6, 10), Vector3.new(0, 0.8, 0), DARK_WOOD, Enum.Material.Wood)
	piece(b, "Mattress", Vector3.new(7, 1, 9.4), Vector3.new(0, 2.1, 0), rgb(245, 240, 230), Enum.Material.Fabric)
	bit(b, "Blanket", Vector3.new(7.3, 0.35, 6.4), Vector3.new(0, 2.7, -1.6), color, Enum.Material.Fabric)
	bit(b, "Blanket", Vector3.new(7.5, 1.6, 0.2), Vector3.new(0, 2, -4.8), color, Enum.Material.Fabric)
	for _, sx in { -1.7, 1.7 } do
		bit(b, "Pillow", Vector3.new(2.8, 0.8, 1.6), Vector3.new(sx, 3, 3.6), rgb(255, 255, 255), Enum.Material.Fabric)
	end
	piece(b, "Headboard", Vector3.new(7.4, 5.5, 0.6), Vector3.new(0, 2.75, 4.9), DARK_WOOD, Enum.Material.Wood)
	for _, sx in { -3.5, 3.5 } do
		for _, sz in { -4.8, 4.8 } do
			cylinder(
				piece(b, "BedPost", Vector3.new(0.45, 10, 0.45), Vector3.new(sx, 5, sz), DARK_WOOD, Enum.Material.Wood),
				"Y"
			)
			ball(
				bit(
					b,
					"PostFinial",
					Vector3.one * 0.6,
					Vector3.new(sx, 10.1, sz),
					rgb(212, 175, 80),
					Enum.Material.Metal
				)
			)
		end
	end
	bit(b, "Canopy", Vector3.new(7.6, 0.25, 10.2), Vector3.new(0, 9.8, 0), darker(color, 0.25), Enum.Material.Fabric)
	for _, sx in { -3.7, 3.7 } do
		bit(
			b,
			"Drape",
			Vector3.new(0.15, 1.4, 10.2),
			Vector3.new(sx, 9.1, 0),
			darker(color, 0.25),
			Enum.Material.Fabric
		)
		for _, sz in { -4.5, 4.5 } do
			bit(
				b,
				"Drape",
				Vector3.new(0.3, 8.4, 1.4),
				Vector3.new(sx, 5.6, sz),
				darker(color, 0.25),
				Enum.Material.Fabric
			)
		end
	end
	-- a chest at the foot of the bed
	piece(b, "Chest", Vector3.new(4.5, 2, 2), Vector3.new(0, 1, -6.6), DARK_WOOD, Enum.Material.Wood)
	bit(
		b,
		"ChestLid",
		Vector3.new(4.7, 0.3, 2.2),
		Vector3.new(0, 2.1, -6.6),
		darker(DARK_WOOD, 0.2),
		Enum.Material.Wood
	)
	bit(b, "ChestLock", Vector3.new(0.5, 0.6, 0.1), Vector3.new(0, 1.6, -7.65), rgb(212, 175, 80), Enum.Material.Metal)
end

function Kit.nightstand(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Nightstand", Vector3.new(2.2, 2.6, 2), Vector3.new(0, 1.3, 0), DARK_WOOD, Enum.Material.Wood)
	bit(
		b,
		"Drawer",
		Vector3.new(1.8, 0.8, 0.06),
		Vector3.new(0, 1.9, -1.02),
		darker(DARK_WOOD, 0.15),
		Enum.Material.Wood
	)
	ball(bit(b, "Knob", Vector3.one * 0.2, Vector3.new(0, 1.9, -1.1), rgb(212, 175, 80), Enum.Material.Metal))
	cylinder(
		bit(b, "LampBase", Vector3.new(0.5, 1, 0.5), Vector3.new(0, 3.1, 0.2), rgb(200, 190, 170), Enum.Material.Marble),
		"Y"
	)
	local shade = cylinder(
		bit(
			b,
			"LampShade",
			Vector3.new(1.2, 0.9, 1.2),
			Vector3.new(0, 4, 0.2),
			rgb(245, 225, 190),
			Enum.Material.Fabric
		),
		"Y"
	)
	light(shade, rgb(255, 205, 140), 10, 0.5)
	bit(b, "Book", Vector3.new(0.9, 0.2, 1.2), Vector3.new(-0.5, 2.7, -0.3), rgb(120, 30, 30))
end

function Kit.wardrobe(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Wardrobe", Vector3.new(5, 9, 2.4), Vector3.new(0, 4.5, 0), DARK_WOOD, Enum.Material.Wood)
	bit(
		b,
		"WardrobeTop",
		Vector3.new(5.4, 0.5, 2.7),
		Vector3.new(0, 9.2, 0),
		darker(DARK_WOOD, 0.15),
		Enum.Material.Wood
	)
	for _, sx in { -1.22, 1.22 } do
		bit(
			b,
			"WardrobeDoor",
			Vector3.new(2.3, 7.4, 0.08),
			Vector3.new(sx, 4.9, -1.23),
			darker(DARK_WOOD, 0.1),
			Enum.Material.Wood
		)
		bit(
			b,
			"DoorPanel",
			Vector3.new(1.6, 2.6, 0.06),
			Vector3.new(sx, 6.6, -1.28),
			darker(DARK_WOOD, 0.22),
			Enum.Material.Wood
		)
		bit(
			b,
			"DoorPanel",
			Vector3.new(1.6, 2.6, 0.06),
			Vector3.new(sx, 3.2, -1.28),
			darker(DARK_WOOD, 0.22),
			Enum.Material.Wood
		)
	end
	for _, sx in { -0.25, 0.25 } do
		ball(bit(b, "Knob", Vector3.one * 0.25, Vector3.new(sx, 5, -1.32), rgb(212, 175, 80), Enum.Material.Metal))
	end
	-- a door left slightly open: something might be in there
	bit(b, "Gap", Vector3.new(0.08, 7.4, 0.1), Vector3.new(0, 4.9, -1.24), rgb(10, 10, 10))
end

function Kit.vanity(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Vanity", Vector3.new(5, 3, 2), Vector3.new(0, 1.5, 0), rgb(240, 235, 225))
	bit(b, "VanityTop", Vector3.new(5.2, 0.2, 2.2), Vector3.new(0, 3.1, 0), rgb(255, 250, 240), Enum.Material.Marble)
	bit(
		b,
		"MirrorFrame",
		Vector3.new(3.6, 4.4, 0.25),
		Vector3.new(0, 5.6, 0.85),
		rgb(212, 175, 80),
		Enum.Material.Metal
	)
	local mirror =
		bit(b, "Mirror", Vector3.new(3.2, 4, 0.1), Vector3.new(0, 5.6, 0.7), rgb(200, 210, 220), Enum.Material.Glass)
	mirror.Reflectance = 0.6
	for i, c in { rgb(230, 80, 120), rgb(140, 90, 200), rgb(250, 250, 250) } do
		cylinder(
			bit(b, "Bottle", Vector3.new(0.3, 0.6, 0.3), Vector3.new(-2 + i * 0.4, 3.5, 0.3), c, Enum.Material.Glass),
			"Y"
		)
	end
	bit(b, "Brush", Vector3.new(0.3, 0.12, 1), Vector3.new(1.5, 3.25, -0.2), rgb(120, 80, 50))
	piece(b, "Stool", Vector3.new(1.8, 0.4, 1.8), Vector3.new(0, 1.8, -2.4), rgb(200, 120, 150), Enum.Material.Fabric)
	cylinder(
		bit(
			b,
			"StoolLeg",
			Vector3.new(0.4, 1.6, 0.4),
			Vector3.new(0, 0.8, -2.4),
			rgb(212, 175, 80),
			Enum.Material.Metal
		),
		"Y"
	)
end

function Kit.stove(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Stove", Vector3.new(5, 3.3, 2.8), Vector3.new(0, 1.65, 0), rgb(40, 40, 42), Enum.Material.Metal)
	bit(b, "OvenDoor", Vector3.new(4.2, 2, 0.1), Vector3.new(0, 1.4, -1.42), rgb(55, 55, 58), Enum.Material.Metal)
	bit(b, "OvenWindow", Vector3.new(2.6, 0.9, 0.06), Vector3.new(0, 1.5, -1.48), rgb(255, 120, 40), Enum.Material.Neon)
	bit(b, "OvenHandle", Vector3.new(3.4, 0.15, 0.2), Vector3.new(0, 2.25, -1.55), STEEL, Enum.Material.Metal)
	for i = 0, 3 do
		bit(b, "Dial", Vector3.new(0.3, 0.3, 0.1), Vector3.new(-1.5 + i, 2.85, -1.45), rgb(220, 220, 220))
	end
	for _, sx in { -1.2, 1.2 } do
		for _, sz in { -0.6, 0.6 } do
			cylinder(bit(b, "Burner", Vector3.new(1.2, 0.08, 1.2), Vector3.new(sx, 3.34, sz), rgb(20, 20, 20)), "Y")
		end
	end
	-- a pot on the boil
	local pot = cylinder(
		bit(b, "Pot", Vector3.new(1.3, 0.9, 1.3), Vector3.new(-1.2, 3.8, -0.6), rgb(150, 150, 155), Enum.Material.Metal),
		"Y"
	)
	local steam = Instance.new("ParticleEmitter")
	steam.Texture = Textures.Smoke
	steam.Color = ColorSequence.new(rgb(240, 240, 240))
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	steam.Size = NumberSequence.new(0.6, 2)
	steam.Speed = NumberRange.new(1, 2)
	steam.Lifetime = NumberRange.new(1.5, 2.5)
	steam.Rate = 3
	steam.SpreadAngle = Vector2.new(10, 10)
	steam.EmissionDirection = Enum.NormalId.Right -- the pot is a cylinder turned upright: its +X points up
	steam.Parent = pot
	-- range hood
	bit(b, "Hood", Vector3.new(5, 1.4, 2.6), Vector3.new(0, 8.6, 0.2), STEEL, Enum.Material.Metal)
	bit(b, "HoodChimney", Vector3.new(1.8, 4, 1.5), Vector3.new(0, 11.3, 0.7), STEEL, Enum.Material.Metal)
	local hoodLight = bit(
		b,
		"HoodLight",
		Vector3.new(1.2, 0.08, 0.6),
		Vector3.new(0, 7.88, -0.4),
		rgb(255, 230, 180),
		Enum.Material.Neon
	)
	light(hoodLight, rgb(255, 220, 170), 8, 0.5)
end

-- Pots and pans hanging from a rail on the wall
function Kit.potRail(x: number, y: number, z: number, rotation: number, length: number)
	local b = frame(x, z, rotation, y)
	bit(b, "Rail", Vector3.new(length, 0.15, 0.15), Vector3.new(0, 0, -0.4), STEEL, Enum.Material.Metal)
	local n = math.floor(length / 1.6)
	for i = 0, n - 1 do
		local px = -length / 2 + 0.8 + i * 1.6
		bit(b, "Hook", Vector3.new(0.06, 0.5, 0.06), Vector3.new(px, -0.3, -0.4), STEEL, Enum.Material.Metal)
		if i % 2 == 0 then
			cylinder(
				bit(
					b,
					"Pan",
					Vector3.new(1.2, 0.15, 1.2),
					Vector3.new(px, -1.3, -0.45),
					rgb(40, 40, 42),
					Enum.Material.Metal
				),
				"Z"
			)
		else
			bit(b, "Ladle", Vector3.new(0.15, 1.4, 0.1), Vector3.new(px, -1.1, -0.45), STEEL, Enum.Material.Metal)
			ball(bit(b, "LadleCup", Vector3.one * 0.45, Vector3.new(px, -1.85, -0.45), STEEL, Enum.Material.Metal))
		end
	end
end

function Kit.kitchenIsland(x: number, z: number, length: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Island", Vector3.new(length, 3, 3.6), Vector3.new(0, 1.5, 0), rgb(60, 80, 100))
	piece(
		b,
		"IslandTop",
		Vector3.new(length + 0.6, 0.3, 4.4),
		Vector3.new(0, 3.15, 0),
		rgb(235, 235, 230),
		Enum.Material.Marble
	)
	bit(
		b,
		"CuttingBoard",
		Vector3.new(2, 0.15, 1.2),
		Vector3.new(-length / 4, 3.38, 0),
		rgb(190, 140, 90),
		Enum.Material.Wood
	)
	bit(
		b,
		"Cleaver",
		Vector3.new(1.1, 0.06, 0.5),
		Vector3.new(-length / 4 + 0.2, 3.5, 0.1),
		rgb(200, 200, 205),
		Enum.Material.Metal
	)
	for i = 0, 3 do
		ball(
			bit(
				b,
				"Apple",
				Vector3.one * 0.45,
				Vector3.new(length / 4 + (i % 2) * 0.4, 3.52 + (i // 2) * 0.35, (i // 2) * 0.2),
				rgb(200, 30, 30)
			)
		)
	end
	local stools = math.floor(length / 3)
	for i = 1, stools do
		local sx = -length / 2 + (i - 0.5) * length / stools
		local s = b * CFrame.new(sx, 0, -3)
		cylinder(
			piece(
				s,
				"Stool",
				Vector3.new(1.5, 0.3, 1.5),
				Vector3.new(0, 2.6, 0),
				rgb(40, 40, 42),
				Enum.Material.Leather
			),
			"Y"
		)
		cylinder(
			bit(s, "StoolLeg", Vector3.new(0.3, 2.5, 0.3), Vector3.new(0, 1.25, 0), STEEL, Enum.Material.Metal),
			"Y"
		)
		cylinder(
			bit(s, "StoolFoot", Vector3.new(1.2, 0.12, 1.2), Vector3.new(0, 0.06, 0), STEEL, Enum.Material.Metal),
			"Y"
		)
	end
end

function Kit.chinaCabinet(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "Cabinet", Vector3.new(6, 3.4, 2.2), Vector3.new(0, 1.7, 0), DARK_WOOD, Enum.Material.Wood)
	piece(b, "Hutch", Vector3.new(5.6, 6, 1.4), Vector3.new(0, 6.4, 0.4), DARK_WOOD, Enum.Material.Wood)
	local glass =
		bit(b, "Glass", Vector3.new(5, 5.4, 0.06), Vector3.new(0, 6.4, -0.32), rgb(210, 230, 240), Enum.Material.Glass)
	glass.Transparency = 0.6
	for row = 0, 2 do
		bit(b, "ShelfBoard", Vector3.new(5, 0.1, 1), Vector3.new(0, 4.4 + row * 1.8, 0.3), darker(DARK_WOOD, 0.2))
		for i = 0, 3 do
			cylinder(
				bit(
					b,
					"Plate",
					Vector3.new(1, 1, 0.08),
					Vector3.new(-1.8 + i * 1.2, 5 + row * 1.8, 0.75),
					rgb(245, 245, 250)
				),
				"Z"
			)
		end
	end
	for _, sx in { -1.5, 1.5 } do
		bit(
			b,
			"CabinetDoor",
			Vector3.new(2.7, 2.6, 0.06),
			Vector3.new(sx, 1.7, -1.13),
			darker(DARK_WOOD, 0.1),
			Enum.Material.Wood
		)
	end
end

function Kit.grandfatherClock(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	piece(b, "ClockCase", Vector3.new(2.4, 8, 1.6), Vector3.new(0, 4, 0), DARK_WOOD, Enum.Material.Wood)
	bit(b, "ClockHood", Vector3.new(2.8, 0.6, 1.9), Vector3.new(0, 8.3, 0), darker(DARK_WOOD, 0.15), Enum.Material.Wood)
	local glass = bit(
		b,
		"PendulumWindow",
		Vector3.new(1.4, 3.4, 0.06),
		Vector3.new(0, 3.6, -0.82),
		rgb(40, 30, 20),
		Enum.Material.Glass
	)
	glass.Transparency = 0.2
	bit(
		b,
		"PendulumRod",
		Vector3.new(0.08, 2.4, 0.06),
		Vector3.new(0, 4, -0.75),
		rgb(212, 175, 80),
		Enum.Material.Metal
	)
	cylinder(
		bit(
			b,
			"PendulumBob",
			Vector3.new(0.7, 0.7, 0.08),
			Vector3.new(0, 2.8, -0.75),
			rgb(212, 175, 80),
			Enum.Material.Metal
		),
		"Z"
	)
	-- the face (its hands turn like every other clock)
	local faceAt = b * CFrame.new(0, 6.7, -0.8)
	local p = faceAt.Position - origin
	local look = faceAt.LookVector
	local rot = math.deg(math.atan2(-look.X, -look.Z))
	Kit.clock(p.X, p.Y, p.Z, rot, rgb(245, 235, 210), rgb(212, 175, 80))
end

-- A suit of armour standing guard, halberd in hand
function Kit.armor(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	local steel = rgb(160, 165, 175)
	piece(b, "ArmorStand", Vector3.new(2.6, 0.6, 2.6), Vector3.new(0, 0.3, 0), rgb(60, 55, 50), Enum.Material.Slate)
	for _, sx in { -0.5, 0.5 } do
		bit(b, "ArmorLeg", Vector3.new(0.8, 3, 0.9), Vector3.new(sx, 2.1, 0), steel, Enum.Material.Metal)
		bit(
			b,
			"ArmorBoot",
			Vector3.new(0.9, 0.5, 1.4),
			Vector3.new(sx, 0.85, -0.2),
			darker(steel, 0.2),
			Enum.Material.Metal
		)
	end
	piece(b, "ArmorTorso", Vector3.new(2.1, 2.6, 1.2), Vector3.new(0, 4.9, 0), steel, Enum.Material.Metal)
	bit(b, "ArmorBelt", Vector3.new(2.2, 0.35, 1.3), Vector3.new(0, 3.75, 0), rgb(80, 50, 30), Enum.Material.Leather)
	for _, sx in { -1.4, 1.4 } do
		ball(
			bit(
				b,
				"Pauldron",
				Vector3.new(1.1, 0.9, 1.3),
				Vector3.new(sx, 6, 0),
				darker(steel, 0.1),
				Enum.Material.Metal
			)
		)
		bit(b, "ArmorArm", Vector3.new(0.7, 2.6, 0.8), Vector3.new(sx, 4.5, 0), steel, Enum.Material.Metal)
	end
	bit(b, "Helmet", Vector3.new(1.2, 1.4, 1.3), Vector3.new(0, 6.95, 0), steel, Enum.Material.Metal)
	bit(b, "Visor", Vector3.new(1.0, 0.12, 0.1), Vector3.new(0, 7, -0.66), rgb(15, 15, 15))
	bit(b, "Plume", Vector3.new(0.25, 1, 1.2), Vector3.new(0, 7.9, 0.2), rgb(150, 20, 30), Enum.Material.Fabric)
	bit(b, "Halberd", Vector3.new(0.15, 9.5, 0.15), Vector3.new(1.4, 4.9, -0.6), DARK_WOOD, Enum.Material.Wood)
	bit(b, "HalberdBlade", Vector3.new(0.08, 1.4, 1), Vector3.new(1.4, 9.4, -0.9), steel, Enum.Material.Metal)
end

function Kit.piano(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	local black = rgb(18, 18, 20)
	piece(b, "Piano", Vector3.new(6, 1.6, 5), Vector3.new(0, 3.4, 0.6), black, Enum.Material.Glass)
	piece(b, "PianoLid", Vector3.new(5.8, 0.15, 4.6), Vector3.new(0, 5.6, 1.4), black, Enum.Material.Glass).CFrame = b
		* CFrame.new(0, 5.2, 1.4)
		* CFrame.Angles(math.rad(25), 0, 0)
	bit(b, "LidProp", Vector3.new(0.1, 1.6, 0.1), Vector3.new(2.6, 4.9, 0.4), black)
	bit(b, "Keys", Vector3.new(5.4, 0.15, 1), Vector3.new(0, 3.1, -2.2), rgb(250, 250, 245))
	for i = 0, 13 do
		if i % 7 ~= 2 and i % 7 ~= 6 then
			bit(b, "BlackKey", Vector3.new(0.2, 0.1, 0.6), Vector3.new(-2.55 + i * 0.39, 3.22, -2.0), black)
		end
	end
	bit(b, "Fallboard", Vector3.new(5.6, 0.8, 0.2), Vector3.new(0, 3.6, -1.75), black)
	bit(b, "SheetMusic", Vector3.new(1.6, 1.1, 0.05), Vector3.new(0, 4.3, -1.6), rgb(245, 240, 225)).CFrame = b
		* CFrame.new(0, 4.3, -1.6)
		* CFrame.Angles(math.rad(-15), 0, 0)
	for _, sx in { -2.6, 2.6 } do
		bit(b, "PianoLeg", Vector3.new(0.5, 2.6, 0.5), Vector3.new(sx, 1.3, -1.4), black)
	end
	bit(b, "PianoLeg", Vector3.new(0.5, 2.6, 0.5), Vector3.new(0, 1.3, 2.8), black)
	-- bench
	piece(b, "PianoBench", Vector3.new(3.2, 0.5, 1.4), Vector3.new(0, 2, -3.6), black, Enum.Material.Leather)
	for _, sx in { -1.3, 1.3 } do
		bit(b, "BenchLeg", Vector3.new(0.3, 1.8, 1.2), Vector3.new(sx, 0.9, -3.6), black)
	end
end

function Kit.globe(x: number, z: number)
	local b = frame(x, z, 0)
	cylinder(
		bit(b, "GlobeStand", Vector3.new(1.8, 0.3, 1.8), Vector3.new(0, 0.15, 0), DARK_WOOD, Enum.Material.Wood),
		"Y"
	)
	bit(b, "GlobePole", Vector3.new(0.2, 2.6, 0.2), Vector3.new(0, 1.5, 0), DARK_WOOD, Enum.Material.Wood)
	local globe = ball(piece(b, "Globe", Vector3.one * 2, Vector3.new(0, 3.6, 0), rgb(70, 120, 180)))
	globe.CFrame = globe.CFrame * CFrame.Angles(0, 0, math.rad(23))
	ball(
		bit(
			b,
			"Continent",
			Vector3.new(0.9, 1, 0.9),
			Vector3.new(0.45, 3.8, -0.4),
			rgb(90, 150, 80),
			Enum.Material.Grass
		)
	)
	ball(
		bit(
			b,
			"Continent",
			Vector3.new(0.8, 0.7, 0.8),
			Vector3.new(-0.5, 3.3, 0.45),
			rgb(170, 150, 90),
			Enum.Material.Sand
		)
	)
	bit(b, "Meridian", Vector3.new(0.12, 2.4, 2.4), Vector3.new(0, 3.6, 0), rgb(212, 175, 80), Enum.Material.Metal).CFrame = b
		* CFrame.new(0, 3.6, 0)
		* CFrame.Angles(0, math.rad(90), math.rad(23))
end

function Kit.sideTable(x: number, z: number, withLamp: boolean?)
	local b = frame(x, z, 0)
	cylinder(piece(b, "SideTable", Vector3.new(2, 0.2, 2), Vector3.new(0, 2.6, 0), DARK_WOOD, Enum.Material.Wood), "Y")
	cylinder(
		bit(b, "SideTableLeg", Vector3.new(0.3, 2.5, 0.3), Vector3.new(0, 1.3, 0), DARK_WOOD, Enum.Material.Wood),
		"Y"
	)
	if withLamp then
		cylinder(
			bit(
				b,
				"LampBase",
				Vector3.new(0.4, 1.1, 0.4),
				Vector3.new(0, 3.25, 0),
				rgb(212, 175, 80),
				Enum.Material.Metal
			),
			"Y"
		)
		local shade = cylinder(
			bit(
				b,
				"LampShade",
				Vector3.new(1.3, 0.9, 1.3),
				Vector3.new(0, 4.2, 0),
				rgb(150, 30, 40),
				Enum.Material.Fabric
			),
			"Y"
		)
		light(shade, rgb(255, 180, 120), 12, 0.55)
	else
		candelabra(b, 2.7)
	end
end

-- Fireplace with a stone surround, a mantel, a crackling fire and a portrait above it
function Kit.fireplace(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	local stone = rgb(150, 145, 140)
	piece(b, "Fireplace", Vector3.new(12, 8, 3), Vector3.new(0, 4, 0), stone, Enum.Material.Brick)
	piece(
		b,
		"Chimney",
		Vector3.new(9, WALL_HEIGHT - 8, 2.2),
		Vector3.new(0, 8 + (WALL_HEIGHT - 8) / 2, 0.4),
		darker(stone, 0.1),
		Enum.Material.Brick
	)
	piece(b, "Mantel", Vector3.new(13, 0.6, 3.8), Vector3.new(0, 8.1, -0.3), DARK_WOOD, Enum.Material.Wood)
	piece(b, "Hearth", Vector3.new(13, 0.3, 2.4), Vector3.new(0, 0.15, -2.6), darker(stone, 0.3), Enum.Material.Slate)
	bit(b, "FireHole", Vector3.new(6, 4.4, 1.2), Vector3.new(0, 2.2, -1.1), rgb(20, 15, 15))
	bit(b, "Arch", Vector3.new(7, 0.8, 0.4), Vector3.new(0, 4.6, -1.6), darker(stone, 0.2), Enum.Material.Brick)
	for i, sx in { -0.9, 0.9 } do
		cylinder(
			bit(
				b,
				"Log",
				Vector3.new(3, 0.6, 0.6),
				Vector3.new(sx * 0.3, 0.6 + i * 0.25, -1.2),
				rgb(80, 50, 30),
				Enum.Material.Wood
			)
		).CFrame = b
			* CFrame.new(sx * 0.3, 0.6 + (i - 1) * 0.35, -1.2)
			* CFrame.Angles(0, sx * 0.3, 0)
	end
	local fire =
		bit(b, "Fire", Vector3.new(3.2, 1.6, 0.6), Vector3.new(0, 1.4, -1.3), rgb(255, 140, 30), Enum.Material.Neon)
	fire.Transparency = 0.3
	local flames = Instance.new("ParticleEmitter")
	flames.Texture = Textures.Fire
	flames.Color = ColorSequence.new(rgb(255, 180, 60), rgb(255, 70, 20))
	flames.LightEmission = 1
	flames.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0.2) })
	flames.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	flames.Lifetime = NumberRange.new(0.5, 0.9)
	flames.Rate = 30
	flames.Speed = NumberRange.new(2, 3.5)
	flames.SpreadAngle = Vector2.new(15, 15)
	flames.EmissionDirection = Enum.NormalId.Top
	flames.Parent = fire
	local embers = Instance.new("ParticleEmitter")
	embers.Color = ColorSequence.new(rgb(255, 150, 50))
	embers.LightEmission = 1
	embers.Size = NumberSequence.new(0.12, 0)
	embers.Lifetime = NumberRange.new(1, 2)
	embers.Rate = 6
	embers.Speed = NumberRange.new(2, 4)
	embers.SpreadAngle = Vector2.new(30, 30)
	embers.EmissionDirection = Enum.NormalId.Top
	embers.Parent = fire
	light(fire, rgb(255, 140, 60), 28, 1.1)
	flame(fire)
	-- mantel clutter
	candelabra(b * CFrame.new(-4.8, 0, -0.6), 8.4)
	candelabra(b * CFrame.new(4.8, 0, -0.6), 8.4)
	local skull = Props.Build("Skull", true)
	skull:PivotTo(b * CFrame.new(-2.2, 9.05, -0.8) * CFrame.Angles(0, math.rad(20), 0))
	skull:ScaleTo(0.6)
	skull.Parent = folder
	cylinder(
		bit(b, "Urn", Vector3.new(0.9, 1.4, 0.9), Vector3.new(2.4, 9.1, -0.6), rgb(40, 60, 70), Enum.Material.Marble),
		"Y"
	)
	-- portrait on the chimney breast
	local p = (b * CFrame.new(0, 11, -0.72)).Position - origin
	Kit.picture(p.X, p.Y, p.Z, rotation, "Portrait", rgb(212, 175, 80), 1.1)
	-- poker set
	bit(b, "Poker", Vector3.new(0.12, 3, 0.12), Vector3.new(6.8, 1.6, -2.4), rgb(30, 30, 30), Enum.Material.Metal)
	bit(b, "PokerStand", Vector3.new(0.8, 0.15, 0.8), Vector3.new(6.8, 0.1, -2.4), rgb(30, 30, 30), Enum.Material.Metal)
end

-- Grand double doors with a fanlight (decor on a solid outer wall)
function Kit.frontDoors(x: number, z: number, rotation: number)
	local b = frame(x, z, rotation)
	local wood = rgb(60, 30, 20)
	bit(b, "DoorFrame", Vector3.new(10.4, 12.6, 0.6), Vector3.new(0, 6.3, -0.3), rgb(240, 235, 225))
	for _, sx in { -2.3, 2.3 } do
		bit(b, "FrontDoor", Vector3.new(4.4, 9.6, 0.3), Vector3.new(sx, 4.8, -0.7), wood, Enum.Material.Wood)
		for _, y in { 2.4, 6.8 } do
			bit(
				b,
				"DoorPanel",
				Vector3.new(3, 3.2, 0.12),
				Vector3.new(sx, y, -0.9),
				darker(wood, 0.25),
				Enum.Material.Wood
			)
		end
		ball(
			bit(
				b,
				"Knocker",
				Vector3.new(0.8, 0.8, 0.15),
				Vector3.new(sx, 5.2, -0.95),
				rgb(212, 175, 80),
				Enum.Material.Metal
			)
		)
	end
	local fan =
		bit(b, "Window", Vector3.new(9, 2.4, 0.1), Vector3.new(0, 10.9, -0.65), rgb(16, 24, 48), Enum.Material.Neon)
	fan:AddTag("Window")
	for i = -2, 2 do
		bit(b, "FanBar", Vector3.new(0.15, 2.4, 0.15), Vector3.new(i * 1.8, 10.9, -0.75), rgb(240, 235, 225))
	end
	local mat =
		bit(b, "Mat", Vector3.new(6, 0.1, 3), Vector3.new(0, 0.12, -2.6), rgb(110, 30, 30), Enum.Material.Fabric)
	label(mat, "WELCOME", rgb(230, 200, 140), Enum.Font.Garamond, Enum.NormalId.Top)
end

function Kit.coatRack(x: number, z: number)
	local b = frame(x, z, 0)
	cylinder(
		bit(b, "RackBase", Vector3.new(1.6, 0.25, 1.6), Vector3.new(0, 0.12, 0), DARK_WOOD, Enum.Material.Wood),
		"Y"
	)
	cylinder(
		piece(b, "RackPole", Vector3.new(0.3, 6.5, 0.3), Vector3.new(0, 3.3, 0), DARK_WOOD, Enum.Material.Wood),
		"Y"
	)
	bit(b, "Coat", Vector3.new(1.6, 3.2, 0.8), Vector3.new(0, 4.4, -0.4), rgb(40, 40, 50), Enum.Material.Fabric)
	bit(b, "Hat", Vector3.new(1.3, 0.7, 1.3), Vector3.new(0.4, 6.8, 0.2), rgb(25, 25, 28), Enum.Material.Fabric)
	bit(b, "Scarf", Vector3.new(0.4, 2.4, 0.3), Vector3.new(0.5, 4.8, 0.4), rgb(150, 30, 40), Enum.Material.Fabric)
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">RoundMaps</string>
            <string name="Source"><![CDATA[--!strict
-- Indoor round maps in the style of the classic murder games (The Mad Murderer era): real
-- buildings with rooms that each look like a place - an open-plan office with cubicles and a
-- storage room where the bulbs won't stop flickering, a mansion with a fireplace, a four-poster
-- bed and a dining table set for twelve. Built from RoundMapKit (walls with trim, windows,
-- lights, furniture). One map is picked at random each round (no voting), like the original.
--
-- Layouts keep the same rooms, doors and spawns the chases were tuned on: every room has two
-- ways out so there's always somewhere to run.

local Kit = require(script.Parent.RoundMapKit)

local RoundMaps = {}

export type Built = {
	Name: string,
	Folder: Folder,
	Spawns: { CFrame },
	Size: Vector2, -- floor size (x, z) around the centre, for coin placement
}

local rgb = Kit.rgb
local at = Kit.at
local wall = Kit.wall

local folder: Folder

-- Office -------------------------------------------------------------------------------------
-- A marble corridor through the middle with four rooms on each side. Two doors per room
-- (corridor + neighbour) so there's always a way to loop away from the Murderer.
--   north: open-plan office | staff lounge | meeting room | the boss's office
--   south: storage          | office       | break room   | reception

local function buildOffice(): Built
	local W, D = 150, 110
	local WALL: Kit.WallStyle = {
		Color = rgb(218, 216, 208),
		Material = Enum.Material.Plaster,
		Base = rgb(70, 70, 75),
		Door = rgb(120, 80, 48),
	}
	local STORAGE: Kit.WallStyle = {
		Color = rgb(160, 162, 160),
		Material = Enum.Material.Concrete,
		Base = rgb(60, 60, 62),
		Crown = rgb(150, 150, 150),
	}
	local BOSS: Kit.WallStyle = { Color = rgb(70, 52, 40), Material = Enum.Material.Wood, Wainscot = rgb(50, 32, 22) }

	Kit.floor(0, 0, W, D, rgb(232, 226, 212), Enum.Material.Marble)
	Kit.ceiling(W, D, rgb(240, 240, 238))
	Kit.ceilingGrid(0, 0, W, D, 6, rgb(205, 205, 205))

	-- Outer walls (the boss and the storage room get their own panelling)
	wall(-W / 2, D / 2, 37.5, D / 2, WALL)
	wall(37.5, D / 2, W / 2, D / 2, WALL, nil, BOSS)
	wall(-W / 2, -D / 2, -37.5, -D / 2, STORAGE)
	wall(-37.5, -D / 2, W / 2, -D / 2, WALL)
	wall(-W / 2, -D / 2, -W / 2, -7, STORAGE)
	wall(-W / 2, -7, -W / 2, D / 2, WALL)
	wall(W / 2, -D / 2, W / 2, 7, WALL)
	wall(W / 2, 7, W / 2, D / 2, WALL, nil, BOSS)

	-- Corridor walls and the walls between rooms
	local roomX = { -56.25, -18.75, 18.75, 56.25 }
	wall(-W / 2, 7, 37.5, 7, WALL, roomX)
	wall(37.5, 7, W / 2, 7, BOSS, { 56.25 }, WALL)
	wall(-W / 2, -7, -37.5, -7, WALL, { -56.25 }, STORAGE)
	wall(-37.5, -7, W / 2, -7, WALL, { -18.75, 18.75, 56.25 })
	wall(-37.5, 7, -37.5, D / 2, WALL, { 31 })
	wall(0, 7, 0, D / 2, WALL, { 31 })
	wall(37.5, 7, 37.5, D / 2, BOSS, { 31 }, WALL)
	wall(-37.5, -D / 2, -37.5, -7, WALL, { -31 }, STORAGE)
	wall(0, -D / 2, 0, -7, WALL, { -31 })
	wall(37.5, -D / 2, 37.5, -7, WALL, { -31 })

	-- Room floors
	local carpet = Enum.Material.Carpet
	Kit.roomFloor(-56.25, 31, 37.5, 48, rgb(84, 96, 118), carpet)
	Kit.roomFloor(-18.75, 31, 37.5, 48, rgb(150, 110, 75), Enum.Material.WoodPlanks)
	Kit.roomFloor(18.75, 31, 37.5, 48, rgb(96, 104, 112), carpet)
	Kit.roomFloor(56.25, 31, 37.5, 48, rgb(90, 30, 32), carpet)
	Kit.roomFloor(-56.25, -31, 37.5, 48, rgb(120, 120, 118), Enum.Material.Concrete)
	Kit.roomFloor(-18.75, -31, 37.5, 48, rgb(84, 96, 118), carpet)
	Kit.checker(18.75, -31, 37.5, 48, 4.7, rgb(235, 235, 230), rgb(190, 192, 196))
	Kit.roomFloor(56.25, -31, 37.5, 48, rgb(205, 200, 190), Enum.Material.Marble)

	-- Lights: strip lights in the rooms, downlights down the corridor, bare bulbs in storage
	for x = -66, 66, 12 do
		Kit.downlight(x, 0, nil, 0.15)
	end
	for i, x in roomX do
		Kit.fluorescent(x - 9, 31, 0)
		Kit.fluorescent(x + 9, 31, 0)
		if i ~= 1 then
			Kit.fluorescent(x - 9, -31, 0)
			Kit.fluorescent(x + 9, -31, 0)
		end
	end
	Kit.pendant(-56, -20, 3, 0.7)
	Kit.pendant(-56, -42, 3, 0.7)

	-- Corridor: lift at one end, glass front doors at the other, plates over every door
	Kit.elevator(-W / 2 + 0.5, 0, -90)
	Kit.glassDoors(W / 2 - 0.5, 0, 90, "BLACKWOOD & CO.")
	Kit.exitSign(W / 2 - 0.5, 11.6, 0, 90)
	Kit.exitSign(-W / 2 + 0.5, 11.6, 4.5, -90)
	local plates =
		{ "OPEN OFFICE", "LOUNGE", "MEETING", "MR. BLACKWOOD", "STORAGE", "OFFICE B", "BREAK ROOM", "RECEPTION" }
	for i, x in roomX do
		Kit.sign(x, 10.9, 6.5, 0, plates[i], Vector2.new(4, 0.8), rgb(40, 40, 46), rgb(235, 235, 235))
		Kit.sign(x, 10.9, -6.5, 180, plates[i + 4], Vector2.new(4, 0.8), rgb(40, 40, 46), rgb(235, 235, 235))
		Kit.lightSwitch(x + 4.6, 4.5, 6.5, 0)
		Kit.lightSwitch(x - 4.6, 4.5, -6.5, 180)
	end
	Kit.bench(-37.5, 5.3, 0)
	Kit.bench(37.5, -5.3, 180)
	Kit.plant(-69, 4.8, "Tall")
	Kit.plant(69, -4.8, "Tall")
	Kit.plant(69, 4.8, "Fern")
	Kit.extinguisher(-30, 6.5, 0)
	Kit.extinguisher(30, -6.5, 180)
	Kit.corkboard(-4.5, 6.2, 6.5, 0)
	Kit.clock(0, 10.6, -6.5, 180)
	Kit.picture(-8, 6.6, -6.5, 180, "Portrait", rgb(212, 175, 80), 0.8)
	Kit.sign(-8, 4.1, -6.5, 180, "EMPLOYEE OF THE MONTH", Vector2.new(3.4, 0.6), rgb(212, 175, 80), rgb(40, 30, 10))
	Kit.trashBin(-44, -5.4)
	Kit.trashBin(44, 5.4)

	-- North 1: open-plan office, three rows of desks with partitions between them
	for _, dz in { 18, 30, 42 } do
		Kit.desk(-64, dz, 0)
		Kit.desk(-50, dz, 0)
	end
	for _, z in { 24, 36 } do
		Kit.cubicle(-64, z, 7.4, 0)
		Kit.cubicle(-50, z, 7.4, 0)
	end
	Kit.filingCabinet(-73.3, 11, -90)
	Kit.filingCabinet(-73.3, 13.2, -90)
	Kit.printer(-39.2, 12, 90)
	Kit.whiteboard(
		-56.25,
		6.6,
		54.5,
		0,
		"  TO DO:\n  - finish reports\n  - fix the lights in storage!!\n  - who keeps taking my knife?"
	)
	Kit.window(-64.25, 54.5, 0)
	Kit.window(-48.25, 54.5, 0)
	Kit.window(-74.5, 31, -90)
	Kit.clock(-74.5, 10.4, 45, -90)
	Kit.plant(-72, 52, "Bush")
	Kit.plant(-40, 52, "Tall")
	Kit.trashBin(-57, 15)
	Kit.trashBin(-57, 40)

	-- North 2: staff lounge
	Kit.rug(-18.75, 31, 24, 26, rgb(150, 40, 45), rgb(110, 25, 30))
	Kit.sofa(-18.75, 48, 0, rgb(30, 36, 48), 12)
	Kit.sofa(-32, 31, -90, rgb(30, 36, 48), 10)
	Kit.sofa(-5.5, 31, 90, rgb(30, 36, 48), 10)
	Kit.coffeeTable(-18.75, 31, 6, 4)
	Kit.floorLamp(-34.5, 40)
	Kit.floorLamp(-3, 40)
	Kit.plant(-34, 52, "Fern")
	Kit.plant(-3, 52, "Bush")
	Kit.arcade(-34, 12, -90)
	Kit.tv(-8, 8.6, 180)
	Kit.window(-29, 54.5, 0)
	Kit.window(-8.5, 54.5, 0)
	Kit.picture(-18.75, 7.4, 54.5, 0, "Sea")

	-- North 3: meeting room
	Kit.tableWithChairs(18.75, 33, 20, 7, rgb(60, 40, 28))
	Kit.projectorScreen(18.75, 8.4, 54.5, 0)
	Kit.waterCooler(34, 12)
	Kit.plant(3, 12, "Tall")
	Kit.window(5, 54.5, 0)
	Kit.window(32.5, 54.5, 0)
	Kit.whiteboard(0.5, 6.6, 45, -90, "  MEETING 3PM\n  agenda:\n  1. the missing staff\n  2. ???")
	Kit.clock(37, 10.4, 45, 90)

	-- North 4: the boss's office
	Kit.rug(56.25, 33, 22, 20, rgb(120, 30, 35), rgb(212, 175, 80))
	Kit.executiveDesk(56.25, 40, 0, "THE BOSS")
	Kit.bookshelf(73.4, 24, 90, rgb(60, 38, 25))
	Kit.bookshelf(73.4, 38, 90, rgb(60, 38, 25))
	Kit.window(74.5, 31, 90, { Curtains = rgb(110, 25, 30) })
	Kit.window(46, 54.5, 0, { Curtains = rgb(110, 25, 30) })
	Kit.window(66.5, 54.5, 0, { Curtains = rgb(110, 25, 30) })
	Kit.sofa(42, 22, -90, rgb(90, 30, 25), 10)
	Kit.coffeeTable(47.5, 22, 3, 6)
	Kit.safe(72.5, 50.5, 90)
	Kit.globe(67, 14)
	Kit.plant(40, 52, "Tall")
	Kit.floorLamp(48.5, 50, rgb(220, 190, 140))
	Kit.floorLamp(64, 50, rgb(220, 190, 140))
	Kit.picture(56.25, 8.6, 54.2, 0, "Portrait", rgb(212, 175, 80), 1.2)

	-- South 1: storage - no windows, bare bulbs, shelves of junk
	Kit.crates(-64, -24)
	Kit.crates(-50, -44)
	Kit.crates(-66, -46)
	Kit.crates(-48, -20)
	Kit.shelfUnit(-73.5, -18, -90)
	Kit.shelfUnit(-73.5, -32, -90)
	Kit.shelfUnit(-58, -53.5, 180)
	Kit.mopBucket(-42, -12)
	Kit.sign(-38, 6, -46, 90, "STAFF ONLY", Vector2.new(3, 1), rgb(200, 30, 30), rgb(255, 255, 255))

	-- South 2: office
	for _, dz in { -18, -30, -42 } do
		Kit.desk(-26, dz, 180)
		Kit.desk(-12, dz, 180)
	end
	for _, z in { -24, -36 } do
		Kit.cubicle(-26, z, 7.4, 0)
		Kit.cubicle(-12, z, 7.4, 0)
	end
	Kit.filingCabinet(-36.3, -12, -90)
	Kit.filingCabinet(-36.3, -14.2, -90)
	Kit.printer(-1.9, -48, 90)
	Kit.window(-30, -54.5, 180)
	Kit.window(-8, -54.5, 180)
	Kit.clock(-0.5, 10.4, -15, 90)
	Kit.plant(-34, -52, "Bush")
	Kit.trashBin(-19, -45)

	-- South 3: break room
	Kit.counter(15, -53.2, 24, 180, { Sink = 0, Coffee = 9, Microwave = -8 })
	Kit.window(15, -54.5, 180, { Sill = 4.6, Height = 5.5 })
	Kit.fridge(31, -53, 180)
	Kit.vending(35.5, -16, 90, rgb(200, 30, 40))
	Kit.vending(35.5, -21, 90, rgb(30, 90, 190))
	Kit.tableWithChairs(18.75, -30, 8, 5, rgb(240, 240, 240))
	Kit.trashBin(4, -48)
	Kit.plant(4, -12, "Bush")
	Kit.clock(0.5, 10.4, -20, -90)
	Kit.corkboard(0.5, 6.2, -42, -90, "MISSING\n\nDave from Accounts\n\nLast seen near the Manor")

	-- South 4: reception
	Kit.rug(56.25, -31, 30, 30, rgb(40, 70, 130), rgb(25, 45, 90))
	Kit.receptionDesk(56.25, -46, 180)
	Kit.sign(
		56.25,
		8.5,
		-54.5,
		180,
		"BLACKWOOD & CO.",
		Vector2.new(14, 2.4),
		rgb(30, 30, 34),
		rgb(212, 175, 80),
		{ Font = Enum.Font.Garamond }
	)
	Kit.sofa(56.25, -14, 0, rgb(120, 30, 35), 12)
	Kit.window(74.5, -20, 90)
	Kit.window(74.5, -42, 90)
	Kit.plant(42, -52, "Tall")
	Kit.plant(70.5, -52, "Tall")
	Kit.waterCooler(72, -11)
	Kit.armchair(69.5, -28.5, 90, rgb(120, 30, 35))
	Kit.armchair(69.5, -37.5, 90, rgb(120, 30, 35))
	Kit.sideTable(70.5, -33, true)
	Kit.clock(38, 10.4, -15, -90)
	Kit.picture(38, 7, -42, -90, "Abstract")

	local spawns = {}
	for _, x in roomX do
		table.insert(spawns, at(x, 3, 22))
		table.insert(spawns, at(x, 3, -22))
		table.insert(spawns, at(x - 6, 3, 0))
		table.insert(spawns, at(x + 6, 3, 0))
	end
	return { Name = "Office", Folder = folder, Spawns = spawns, Size = Vector2.new(W, D) }
end

-- Mansion ------------------------------------------------------------------------------------
-- A long central hall from the front doors to the fireplace, and a wing on each side:
--   west: kitchen (north) and dining room (south)
--   east: master bedroom (north) and library (south)

local function buildMansion(): Built
	local W, D = 150, 110
	local trim = rgb(232, 222, 196)
	local door = rgb(70, 40, 25)
	local HALL: Kit.WallStyle = {
		Color = rgb(110, 34, 40),
		Material = Enum.Material.Plaster,
		Wainscot = rgb(78, 48, 30),
		Crown = trim,
		Door = door,
	}
	local KITCHEN: Kit.WallStyle = {
		Color = rgb(222, 208, 160),
		Material = Enum.Material.Plaster,
		Wainscot = rgb(236, 234, 226),
		Crown = trim,
		Door = door,
	}
	local DINING: Kit.WallStyle = {
		Color = rgb(46, 78, 58),
		Material = Enum.Material.Plaster,
		Wainscot = rgb(78, 48, 30),
		Crown = trim,
		Door = door,
	}
	local BEDROOM: Kit.WallStyle = {
		Color = rgb(92, 110, 142),
		Material = Enum.Material.Plaster,
		Wainscot = rgb(226, 216, 192),
		Crown = trim,
		Door = door,
	}
	local LIBRARY: Kit.WallStyle = {
		Color = rgb(96, 66, 44),
		Material = Enum.Material.Wood,
		Wainscot = rgb(58, 36, 22),
		Crown = trim,
		Door = door,
	}

	Kit.floor(0, 0, W, D, rgb(92, 58, 36), Enum.Material.WoodPlanks)
	Kit.ceiling(W, D, rgb(196, 182, 160))

	-- Outer walls, papered per room
	wall(-W / 2, D / 2, -25, D / 2, KITCHEN)
	wall(-25, D / 2, 25, D / 2, HALL)
	wall(25, D / 2, W / 2, D / 2, BEDROOM)
	wall(-W / 2, -D / 2, -25, -D / 2, DINING)
	wall(-25, -D / 2, 25, -D / 2, HALL)
	wall(25, -D / 2, W / 2, -D / 2, LIBRARY)
	wall(-W / 2, -D / 2, -W / 2, 0, DINING)
	wall(-W / 2, 0, -W / 2, D / 2, KITCHEN)
	wall(W / 2, -D / 2, W / 2, 0, LIBRARY)
	wall(W / 2, 0, W / 2, D / 2, BEDROOM)

	-- The hall's side walls (two doors into each room) and the walls splitting each wing
	wall(-25, -D / 2, -25, 0, HALL, { -38, -15 }, DINING)
	wall(-25, 0, -25, D / 2, HALL, { 15, 38 }, KITCHEN)
	wall(25, -D / 2, 25, 0, LIBRARY, { -38, -15 }, HALL)
	wall(25, 0, 25, D / 2, BEDROOM, { 15, 38 }, HALL)
	wall(-W / 2, 0, -25, 0, KITCHEN, { -50 }, DINING)
	wall(25, 0, W / 2, 0, BEDROOM, { 50 }, LIBRARY)

	local curtains = { Curtains = rgb(120, 20, 30), Frame = rgb(232, 222, 196) }

	-- Hall --------------------------------------------------------------------------------
	Kit.checker(0, -45, 50, 20, 5, rgb(235, 230, 218), rgb(40, 38, 40))
	Kit.rug(0, 6, 12, 74, rgb(140, 22, 32), rgb(212, 175, 80))
	for z = -30, 50, 10 do
		Kit.part("Beam", Vector3.new(50, 0.8, 1), at(0, Kit.WALL_HEIGHT - 0.4, z), Kit.DARK_WOOD, Enum.Material.Wood).CanCollide =
			false
	end
	Kit.chandelier(0, -30)
	Kit.chandelier(0, 0)
	Kit.chandelier(0, 30)
	for _, z in { -26.5, 0, 26.5 } do
		Kit.sconce(-24.5, 6.6, z, Vector3.new(1, 0, 0))
		Kit.sconce(24.5, 6.6, z, Vector3.new(-1, 0, 0))
	end
	Kit.frontDoors(0, -54.5, 180)
	Kit.armor(-8, -51, 180)
	Kit.armor(8, -51, 180)
	Kit.window(-17, -54.5, 180, curtains)
	Kit.window(17, -54.5, 180, curtains)
	Kit.roundTable(0, -25, 2.6)
	Kit.grandfatherClock(-23.7, -48, -90)
	Kit.coatRack(21.5, -50)
	Kit.fireplace(0, 53, 0)
	Kit.sofa(-11, 40, -90, rgb(110, 30, 34), 10)
	Kit.sofa(11, 40, 90, rgb(110, 30, 34), 10)
	Kit.coffeeTable(0, 40, 4, 6)
	Kit.window(-17, 54.5, 0, curtains)
	Kit.window(17, 54.5, 0, curtains)
	Kit.piano(15, 8, 90)
	Kit.sideTable(-22.5, 22, true)
	Kit.sideTable(22.5, -5, true)
	Kit.picture(-24.5, 7.2, 7.5, -90, "Portrait", rgb(212, 175, 80))
	Kit.picture(24.5, 7.2, -7.5, 90, "Portrait", rgb(212, 175, 80))
	Kit.picture(24.5, 7.2, -46, 90, "Landscape", rgb(212, 175, 80))
	Kit.plant(-21, 51, "Tall")
	Kit.plant(21, 51, "Tall")

	-- Kitchen ---------------------------------------------------------------------------------
	Kit.checker(-50, 27.5, 50, 55, 4.2, rgb(240, 240, 235), rgb(30, 30, 34))
	Kit.counter(-63, 53.2, 22, 0, { KnifeBlock = -6, Coffee = 7 })
	Kit.stove(-49.5, 53.1, 0)
	Kit.counter(-38.5, 53.2, 17, 0, { Sink = 0 })
	Kit.window(-38.5, 54.5, 0, { Sill = 4.6, Height = 5.5, Frame = rgb(240, 240, 235) })
	Kit.potRail(-63, 8, 54.5, 0, 14)
	Kit.counter(-73.2, 35, 16, -90, { Microwave = 3 })
	Kit.fridge(-72.9, 20, -90)
	Kit.window(-74.5, 8, -90, { Frame = rgb(240, 240, 235) })
	Kit.kitchenIsland(-50, 30, 10, 0)
	Kit.pendant(-53, 30, 4.5)
	Kit.pendant(-47, 30, 4.5)
	Kit.downlight(-62, 14)
	Kit.downlight(-38, 14)
	Kit.downlight(-38, 42)
	Kit.trashBin(-28, 50)
	Kit.plant(-28, 4, "Fern")
	Kit.clock(-35, 10.4, 0.5, 180)

	-- Dining room -----------------------------------------------------------------------------
	Kit.roomFloor(-50, -27.5, 50, 55, rgb(120, 78, 46), Enum.Material.WoodPlanks)
	Kit.rug(-50, -28, 30, 16, rgb(46, 60, 100), rgb(212, 175, 80))
	Kit.diningTable(-50, -28, 22, 7, rgb(140, 25, 35))
	Kit.chandelier(-50, -28)
	Kit.chinaCabinet(-73.4, -28, -90)
	Kit.window(-62, -54.5, 180, curtains)
	Kit.window(-38, -54.5, 180, curtains)
	Kit.window(-74.5, -12, -90, curtains)
	Kit.window(-74.5, -44, -90, curtains)
	Kit.picture(-50, 7.4, -54.5, 180, "Landscape", rgb(212, 175, 80))
	Kit.counter(-62, -1.8, 10, 0, { Body = Kit.DARK_WOOD, Top = rgb(40, 26, 18) })
	Kit.sideTable(-28.5, -50)
	Kit.plant(-28.5, -4, "Tall")

	-- Master bedroom --------------------------------------------------------------------------
	Kit.roomFloor(50, 27.5, 50, 55, rgb(140, 100, 110), Enum.Material.Carpet)
	Kit.rug(52, 30, 18, 12, rgb(200, 170, 110), rgb(140, 30, 40))
	Kit.fourPosterBed(52, 47, 0, rgb(120, 25, 40))
	Kit.nightstand(46.5, 51.5, 0)
	Kit.nightstand(57.5, 51.5, 0)
	Kit.wardrobe(73.3, 20, 90)
	Kit.vanity(70, 53.4, 0)
	Kit.armchair(66, 30, 90, rgb(170, 140, 90))
	Kit.floorLamp(70.5, 36)
	Kit.chandelier(50, 27)
	Kit.window(35, 54.5, 0, curtains)
	Kit.window(74.5, 38, 90, curtains)
	Kit.window(74.5, 8, 90, curtains)
	Kit.picture(25.5, 7.2, 48, -90, "Sea", rgb(212, 175, 80))
	Kit.plant(28, 4, "Bush")

	-- Library ---------------------------------------------------------------------------------
	Kit.roomFloor(50, -27.5, 50, 55, rgb(80, 50, 32), Enum.Material.WoodPlanks)
	Kit.rug(50, -44, 22, 14, rgb(90, 50, 110), rgb(212, 175, 80))
	Kit.tv(50, -53.4, 180)
	Kit.sofa(50, -40, 0, rgb(40, 60, 110), 12)
	Kit.coffeeTable(50, -46.5, 6, 3)
	for _, z in { -12, -24, -36 } do
		Kit.bookshelf(73.4, z, 90, rgb(60, 38, 25))
	end
	Kit.window(74.5, -47, 90, curtains)
	Kit.window(35, -54.5, 180, curtains)
	Kit.window(66, -54.5, 180, curtains)
	Kit.armchair(33.5, -3, 0, rgb(30, 80, 60))
	Kit.armchair(40.5, -3, 0, rgb(30, 80, 60))
	Kit.sideTable(37, -2.4, true)
	Kit.globe(64, -6)
	Kit.chandelier(50, -27)
	Kit.picture(25.5, 7.2, -27, -90, "Portrait", rgb(212, 175, 80))

	local spawns = {}
	for _, z in { -40, -20, 20, 40 } do
		table.insert(spawns, at(-6, 3, z))
		table.insert(spawns, at(6, 3, z))
	end
	for _, x in { -50, 50 } do
		table.insert(spawns, at(x, 3, 15))
		table.insert(spawns, at(x, 3, -15))
		table.insert(spawns, at(x - 12, 3, 38))
		table.insert(spawns, at(x + 12, 3, -40))
	end
	return { Name = "Mansion", Folder = folder, Spawns = spawns, Size = Vector2.new(W, D) }
end

RoundMaps.Builders = {
	Office = buildOffice,
	Mansion = buildMansion,
}
RoundMaps.Names = { "Office", "Mansion" }

-- Tears down the previous round map and builds `name` (or a random one) around `center`
function RoundMaps.Build(parent: Instance, center: Vector3, name: string?): Built
	local old = parent:FindFirstChild("RoundMap")
	if old then
		old:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "RoundMap"
	Kit.Begin(folder, center)
	local chosen = name or RoundMaps.Names[math.random(1, #RoundMaps.Names)]
	local built = RoundMaps.Builders[chosen]()
	-- Everyone spawns facing the middle of the building
	for i, spawn in built.Spawns do
		built.Spawns[i] = CFrame.lookAt(spawn.Position, Vector3.new(center.X, spawn.Position.Y, center.Z))
	end
	folder.Parent = parent
	return built
end

return RoundMaps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--!strict
-- The main event. Every few minutes everyone is pulled into a round: one Murderer (weighted by
-- the luck meter and tickets), everyone else survives until the timer runs out.
-- Round state is published as attributes on ReplicatedStorage for the HUD:
--   Phase ("Intermission" | "Round" | "Results"), PhaseEndsAt (server time), Status (text), Alive
--
-- Classic murder-game rules: a random indoor map, everyone disguised as a named character
-- (Disguises), bodies stay where they fall, and a Revolver drops mid-round that any innocent can
-- grab. The two halves of the game feed each other:
--   * the Murderer's equipped knife (stolen in the arena) gives them a perk (GameConfig.Perks)
--   * every kill loots a random knife off the victim's rack, kept unless the Revolver ends them
--   * survivors get a temporary income boost back at their vault
-- Innocents also bring items from the pre-round shop and pick up coins while they hide.
-- Every ability and shot goes through a remote and is validated here.
--
-- Studio-only switches (set as attributes on ReplicatedStorage from the command bar):
--   DebugMinPlayers = 1   start rounds with fewer players
--   DebugSkip = true      end the current intermission now
-- The Studio "Bot Round" buttons (RoundService.DebugBotRound) fill the round with RoundBots so one
-- person can play either side: as the Murderer against innocent bots, or as an innocent against
-- a Murderer bot (plus a couple of innocent bots for it to chase).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local AnimLibrary = require(ReplicatedStorage.Shared.AnimLibrary)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Props = require(ReplicatedStorage.Shared.Props)
local Textures = require(ReplicatedStorage.Shared.Config.Textures)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fuel = require(script.Parent.Fuel)
local ServerEvents = require(script.Parent.ServerEvents)
local Social = require(script.Parent.Social)
local MapService = require(script.Parent.MapService)
local PowerService = require(script.Parent.PowerService)
local Stealth = require(script.Parent.Stealth)
local Sounds = require(ReplicatedStorage.Shared.Config.Sounds)
local Disguises = require(script.Parent.Disguises)
local Obstacles = require(script.Parent.Obstacles)
local Revolver = require(script.Parent.Revolver)
local StuckKnives = require(script.Parent.StuckKnives)
local StealService = require(script.Parent.StealService)
local RoundBots = require(script.Parent.RoundBots)

local RoundService = {}

-- The hub's top timer. Says what's coming, so a new player knows the Murder Mystery half exists.
local INTERMISSION_STATUS = "🔪 MURDER ROUND in"
RoundService.IntermissionStatus = INTERMISSION_STATUS
-- A first-time player joined during this intermission: their first round comes sooner, so they
-- see both halves of the game while they're still deciding whether to stay (once per intermission)
local newcomerWaiting = false

type Bot = RoundBots.Bot

type Round = {
	Murderer: Player?, -- nil when a bot is the Murderer
	MurdererBot: Bot?,
	Bots: { Bot },
	BotFolder: Folder,
	Innocents: { Player },
	Alive: { [Player]: boolean },
	Kills: number,
	Weapon: Tool?,
	WeaponKnife: string,
	LastAttack: number,
	PerkReadyAt: number,
	Coins: Folder,
	Bodies: Folder,
	Loot: { { Owner: Player, Knife: string, Killer: Player? } },
	Names: { [Player]: string },
	Revolver: Model?, -- the pickup while it's lying somewhere
	Gunner: Player?, -- whoever holds it
	GunTool: Tool?,
	LastShot: number,
	ThrowReadyAt: number,
	FuryKills: number,
	PerkUses: number,
	BulletproofUsed: boolean,
	LatestAim: Vector3?, -- where the Murderer is aiming (kept fresh during a Spam Knife volley)
	StabHint: { Target: Model, At: number }?, -- who the Murderer's client says the last swing was at
	Hero: Player?,
	PayScale: number, -- 1, or GameConfig.BotRoundPay with fewer than two real players
	HumanKills: number, -- real players the Murderer got (bots don't count toward the wipe prize)
	Connections: { RBXScriptConnection },
	GunnerBot: Bot?, -- a bot Sheriff
	ShotByBot: boolean, -- a bot shot the (player) Murderer: loot goes home like a hero's shot
	HeroBot: Bot?, -- that bot (its face goes on the VS card)
	AtRisk: { [Player]: string }, -- the knife each innocent loses if the Murderer gets them (shown at the start)
	Classic: boolean, -- no powers, no perks, extra pay
	Double: boolean, -- DOUBLE TROUBLE: two Murderers, two Sheriffs
	Killers: { [Player]: boolean }, -- every Murderer this round (one, or two in Double Trouble)
	Partner: Player?, -- the second Murderer
	PartnerRound: Round?, -- their own view of the round (own knife and cooldowns; see partnerView)
	Gunner2: Player?, -- the second Sheriff
	GunTool2: Tool?,
	ShotKillers: { [Player]: boolean }, -- Murderers a Sheriff took down (their loot goes back)
}

local current: Round? = nil
local rng = Random.new()
local updateDread: (Round) -> ()
local onMurderKill: (Round, Vector3) -> ()

-- Click-throw mode: all round for Spam Knife, a few seconds after Q for Hellfire (SpamUntil is a
-- player attribute the client reads too)
local function spamActive(player: Player): boolean
	local until_ = player:GetAttribute("SpamUntil")
	return type(until_) == "number" and workspace:GetServerTimeNow() < until_
end
-- Is this player one of the round's Murderers?
local function isKiller(round: Round, player: Player?): boolean
	return player ~= nil and round.Killers[player] == true
end

-- The second Murderer gets their own copy of the per-Murderer fields (Murderer, knife, cooldowns);
-- everything else reads and writes the real round. So every Murderer function just takes a round.
local OWN_FIELDS = {
	Murderer = true,
	Weapon = true,
	WeaponKnife = true,
	LastAttack = true,
	PerkReadyAt = true,
	ThrowReadyAt = true,
	FuryKills = true,
	PerkUses = true,
	BulletproofUsed = true,
	LatestAim = true,
	StabHint = true,
}
-- Is this the live round? The second Murderer's partnerView counts as the round it mirrors
local function isLive(round: Round): boolean
	return current ~= nil and (current == round or (current :: Round).PartnerRound == round)
end

local function partnerView(round: Round, partner: Player, knife: string): Round
	local own: { [string]: any } = {
		Murderer = partner,
		WeaponKnife = knife,
		LastAttack = 0,
		PerkReadyAt = 0,
		ThrowReadyAt = 0,
		FuryKills = 0,
		PerkUses = 0,
		BulletproofUsed = false,
	}
	return setmetatable({}, {
		__index = function(_, key)
			if OWN_FIELDS[key] then
				return own[key]
			end
			return (round :: any)[key]
		end,
		__newindex = function(_, key, value)
			if OWN_FIELDS[key] then
				own[key] = value
			else
				(round :: any)[key] = value
			end
		end,
	}) :: any
end

-- The round as seen by this Murderer (the partner's own view in Double Trouble)
local function killerRound(round: Round, player: Player): Round?
	if player == round.Murderer then
		return round
	elseif player == round.Partner then
		return round.PartnerRound
	end
	return nil
end

-- Set by the Studio "Bot Round" buttons; used by the next round
local botPlan: { Player: Player, Role: string }? = nil

local function setPhase(phase: string, duration: number, status: string)
	ReplicatedStorage:SetAttribute("Phase", phase)
	ReplicatedStorage:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow() + duration)
	ReplicatedStorage:SetAttribute("Status", status)
end

local function minPlayers(): number
	local override = ReplicatedStorage:GetAttribute("DebugMinPlayers")
	if RunService:IsStudio() and type(override) == "number" then
		return math.max(1, override)
	end
	-- Bots fill rounds in, so one real player is enough
	if GameConfig.BotFill.Size > 0 then
		return GameConfig.BotFill.MinHumans
	end
	return GameConfig.MinPlayers
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Round pay scales with what the player's vault earns (GameConfig.RoundPay); returns the amount
local function pay(round: Round, player: Player, entry: { Min: number, Seconds: number }, scale: number?): number
	local amount = math.floor(GameConfig.Pay(entry, BaseService.RackIncome(player)) * round.PayScale * (scale or 1))
	if amount > 0 then
		DataService.AddCash(player, amount)
	end
	return amount
end

local function aliveCount(round: Round): number
	local n = 0
	for _ in round.Alive do
		n += 1
	end
	for _, bot in round.Bots do
		if bot.Alive then
			n += 1
		end
	end
	return n
end

local function eligiblePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if DataService.Get(player) and humanoid and humanoid.Health > 0 then
			table.insert(list, player)
		end
	end
	return list
end

-- One player's draw weight (luck meter, pass, a ticket waiting to be used)
local function murdererWeight(player: Player): number
	local profile = DataService.Get(player)
	local weight = 1 + (if profile then profile.Luck else 0)
	return weight + (if profile and profile.Tickets > 0 then GameConfig.TicketWeight else 0)
end

-- Nobody's weight may be more than MeterCap x the average, so grinders can't hog the knife
local function cappedWeights(players: { Player }): { [Player]: number }
	local raw, total = {}, 0
	for _, player in players do
		raw[player] = murdererWeight(player)
		total += raw[player]
	end
	local cap = if #players > 1 then total / #players * GameConfig.Fuel.MeterCap else math.huge
	for player, weight in raw do
		raw[player] = math.min(weight, cap)
	end
	return raw
end

-- Everyone's chance (0-100) of the knife next round, shown on their HUD (MurdererChance)
local function publishChances()
	local players = {}
	for _, player in Players:GetPlayers() do
		if DataService.Get(player) then
			table.insert(players, player)
		end
	end
	local weights = cappedWeights(players)
	local total = 0
	for _, weight in weights do
		total += weight
	end
	-- Alone, bots fill the round and one of them can draw the knife instead
	if #players == 1 then
		total += math.max(0, GameConfig.BotFill.Size - 1)
	end
	for _, player in players do
		local chance = if total > 0 then weights[player] / total * 100 else 0
		player:SetAttribute("MurdererChance", math.floor(chance + 0.5))
	end
end

-- Luck meter + tickets. Everyone has at least weight 1 so a brand new player can still get picked.
local function pickMurderer(participants: { Player }): Player
	local weights = cappedWeights(participants)
	local total = 0
	for player, weight in weights do
		total += weight
		local profile = DataService.Get(player)
		if profile and profile.Tickets > 0 then
			DataService.Update(player, function(p)
				p.Tickets -= 1
			end)
		end
	end
	local roll = rng:NextNumber() * total
	for _, player in participants do
		roll -= weights[player]
		if roll <= 0 then
			return player
		end
	end
	return participants[#participants]
end

-- The equipped knife if they still own it, otherwise their highest earner
local function murdererKnife(player: Player): string
	local profile = DataService.Get(player)
	if not profile then
		return "RustyShank"
	end
	if profile.Equipped ~= "" and table.find(profile.Knives, profile.Equipped) then
		return profile.Equipped
	end
	local best, bestIncome = "RustyShank", -1
	for _, item in profile.Knives do
		local income = Items.Income(item)
		if income > bestIncome then
			best, bestIncome = item, income
		end
	end
	return best
end

local function leaveRound(player: Player)
	-- Hide the round ability first; CombatService re-arms the hub knife (and its Throw button)
	-- when InRound clears
	if player.Parent then
		Net.Remotes.AbilityState:FireClient(player, nil)
	end
	player:SetAttribute("InRound", nil)
	player:SetAttribute("Role", nil)
	player:SetAttribute("SpamUntil", nil)
	player:SetAttribute("Perk", nil)
	player:SetAttribute("RoundSpeedBonus", nil)
	player:SetAttribute("PerkSpeed", nil)
	player:SetAttribute("Dread", nil)
	player:SetAttribute("KnifeOut", nil)
	BaseService.RefreshWalkSpeed(player)
end

-- Bodies stay on the floor until the round ends, like the classic. The character ragdolls when it
-- dies (CombatService); once it has collapsed we freeze a copy of it where it fell, so the body
-- stays after the player respawns at their vault.
local function leaveBody(round: Round, player: Player)
	local character = player.Character
	if not character then
		return
	end
	task.delay(2.2, function()
		if current ~= round or not character.Parent then
			return
		end
		character.Archivable = true
		local ok, clone = pcall(character.Clone, character)
		local body = (clone :: any) :: Model?
		if not ok or not body then
			return
		end
		for _, d in body:GetDescendants() do
			if d:IsA("BaseScript") or d:IsA("Tool") or d:IsA("Humanoid") or d:IsA("Sound") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		body.Name = `Body_{round.Names[player] or player.Name}`
		body.Parent = round.Bodies
	end)
end

-- The Murderer takes a random knife off the victim's rack. It's held in the round's loot until
-- the round ends, so leaving or dying can't duplicate or lose it.
local function lootKnife(round: Round, victim: Player)
	local profile = DataService.Get(victim)
	if not profile then
		return
	end
	if DataService.IsNewPlayer(victim, profile) then
		if round.Murderer then
			Net.Notify(round.Murderer, `{round.Names[victim] or "They"} is new here - nothing to loot.`, "info")
		end
		return
	end
	for _ = 1, GameConfig.LootPerKill do
		-- Anything but the knife they fight with
		local choices = {}
		local protected = BaseService.ProtectedItem(victim)
		for index, item in profile.Knives do
			if item ~= protected then
				table.insert(choices, index)
			end
		end
		if #choices == 0 then
			break
		end
		local index = choices[rng:NextInteger(1, #choices)]
		-- The knife they were shown at the start of the round goes first
		local promised = round.AtRisk[victim]
		local promisedAt = promised and table.find(profile.Knives, promised)
		if promisedAt and promised ~= protected then
			index = promisedAt
			round.AtRisk[victim] = nil
		end
		local name = profile.Knives[index]
		DataService.Update(victim, function(p)
			DataService.RemoveKnife(p, index)
		end)
		BaseService.RefreshRack(victim)
		table.insert(round.Loot, { Owner = victim, Knife = name, Killer = round.Murderer })
		local parsed = Items.Parse(name) :: Items.Item
		Net.Notify(victim, `The Murderer took your {Items.DisplayName(name)}! Shoot them to get it back.`, "bad")
		if round.Murderer then
			Net.Notify(round.Murderer, `Looted a {Items.DisplayName(name)} ({parsed.Knife.Rarity})!`, "good")
		end
		ReplicatedStorage:SetAttribute("Loot", #round.Loot)
	end
end

-- Puts a knife on a rack, or pays its sell value if the rack is full
local function giveKnife(player: Player, item: string)
	local profile = DataService.Get(player)
	local parsed = Items.Parse(item)
	if not profile or not parsed then
		return
	end
	if #profile.Knives < profile.Slots then
		DataService.Update(player, function(p)
			DataService.AddKnife(p, item)
			if not table.find(p.Discovered, parsed.Name) then
				table.insert(p.Discovered, parsed.Name)
			end
		end)
		BaseService.RefreshRack(player)
	else
		local value = math.floor(Items.Income(item) * GameConfig.SellSeconds)
		DataService.AddCash(player, value)
		Net.Notify(player, `Rack full - {Items.DisplayName(item)} sold for {Format.Cash(value)}`, "info")
	end
end

local spawnRevolver: (Round, Vector3?) -> ()
local giveRevolver: (Round, Player) -> ()
local giveRevolverToBot: (Round, Bot) -> ()

local function dropRevolver(round: Round, position: Vector3)
	if round.GunTool then
		round.GunTool:Destroy()
		round.GunTool = nil
	end
	round.Gunner = nil
	spawnRevolver(round, position)
end

-- Innocents (players and bots) still standing
local function innocentsLeft(round: Round): number
	local n = 0
	for player in round.Alive do
		if not isKiller(round, player) then
			n += 1
		end
	end
	for _, bot in round.Bots do
		if bot.Alive and bot ~= round.MurdererBot then
			n += 1
		end
	end
	return n
end

-- The last innocent falls (or the Murderer is shot): everyone in the round gets the dramatic
-- slow-mo moment on their screen
local function finalMoment(round: Round, position: Vector3, kind: string)
	for player in round.Names do
		if player.Parent then
			Net.Remotes.Effect:FireClient(player, "FinalKill", position, kind)
		end
	end
end

-- killer = who gets credit; fatal = kill the character here (false when they already died)
local function eliminate(round: Round, victim: Player, killer: Player?, fatal: boolean?)
	if not round.Alive[victim] then
		return
	end
	round.Alive[victim] = nil
	ReplicatedStorage:SetAttribute("Alive", aliveCount(round))
	if not isKiller(round, victim) then
		Fuel.HalveHeat(victim, "You died in the round!")
		Fuel.AddMeter(victim, -1)
	end
	local root = rootOf(victim)
	if round.Gunner == victim and root then
		dropRevolver(round, root.Position)
	end
	if round.Gunner2 == victim then
		-- The second Sheriff's Revolver goes with them
		if round.GunTool2 then
			round.GunTool2:Destroy()
		end
		round.Gunner2, round.GunTool2 = nil, nil
	end
	leaveRound(victim)
	if killer then
		if isKiller(round, killer) then
			round.Kills += 1
			round.HumanKills += 1
			lootKnife(round, victim)
			onMurderKill(round, if root then root.Position else Vector3.zero)
		end
		local amount = pay(round, killer, GameConfig.RoundPay.Kill)
		DataService.Update(killer, function(p)
			p.TotalKills += 1
		end)
		Net.Notify(killer, `Eliminated {round.Names[victim] or victim.DisplayName}! +{Format.Cash(amount)}`, "good")
	end
	if killer or fatal then
		Net.Notify(victim, "You were killed! You'll respawn at your vault.", "bad")
		if root then
			Net.Remotes.Effect:FireAllClients("Hit", root.Position)
		end
		leaveBody(round, victim)
		local humanoid = victim.Character and victim.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
		end
	end
	victim:SetAttribute("Dread", nil)
	if root and not isKiller(round, victim) and innocentsLeft(round) == 0 and #round.Innocents + #round.Bots > 0 then
		finalMoment(round, root.Position, "Wipe")
	end
end

-- Every way the Murderer can hurt someone ends here, so the Shield works against all of them
local function strike(round: Round, victim: Player)
	if not round.Alive[victim] or isKiller(round, victim) then
		return -- (no friendly fire between Murderers)
	end
	Stealth.Reveal(victim) -- getting stabbed blows any Vanish / Mimic cover
	local character = victim.Character
	local shieldUntil = character and character:GetAttribute("ShieldUntil")
	if character and type(shieldUntil) == "number" and workspace:GetServerTimeNow() < shieldUntil then
		character:SetAttribute("ShieldUntil", nil)
		local root = rootOf(victim)
		if root then
			Net.Remotes.Effect:FireAllClients("Shield", root.Position)
		end
		Net.Notify(victim, "Your Shield blocked the hit! RUN!", "good")
		if round.Murderer then
			Net.Notify(round.Murderer, `{round.Names[victim] or "Their"}'s Shield blocked you!`, "bad")
		end
		return
	end
	if not round.Murderer then
		round.Kills += 1 -- a Murderer bot: no credit or loot, but it still kills
	end
	eliminate(round, victim, round.Murderer, true)
end

-- Bots --------------------------------------------------------------------------------------

local function killBot(round: Round, bot: Bot, killer: Player?)
	if not bot.Alive then
		return
	end
	local push = Vector3.zero
	local killerRoot = killer and rootOf(killer)
	if killerRoot then
		local away = bot.Root.Position - killerRoot.Position
		push = Vector3.new(away.X, 0, away.Z).Unit * 18 + Vector3.new(0, 8, 0)
	end
	Net.Remotes.Effect:FireAllClients("Hit", bot.Root.Position)
	if bot == round.GunnerBot then
		round.GunnerBot = nil
		if bot.Gun then
			bot.Gun:Destroy()
			bot.Gun = nil
		end
		spawnRevolver(round, bot.Root.Position)
	end
	RoundBots.Kill(bot, push, round.Bodies)
	if bot == round.MurdererBot then
		finalMoment(round, bot.Root.Position, "Hero")
	elseif innocentsLeft(round) == 0 then
		finalMoment(round, bot.Root.Position, "Wipe")
	end
	if bot == round.MurdererBot then
		if killer then
			round.Hero = killer
			for other in round.Alive do
				Net.Notify(other, `{round.Names[killer] or "Someone"} shot the Murderer!`, "good")
			end
		end
	else
		round.Kills += 1
		if killer then
			local amount = pay(round, killer, GameConfig.RoundPay.Kill, GameConfig.BotKillPay)
			Net.Notify(killer, `Eliminated {bot.Name}! +{Format.Cash(amount)}`, "good")
			if killer == round.Murderer then
				onMurderKill(round, bot.Root.Position)
			end
		end
	end
	ReplicatedStorage:SetAttribute("Alive", aliveCount(round))
end

local function botAt(round: Round, instance: Instance): Bot?
	for _, bot in round.Bots do
		if bot.Alive and (instance == bot.Model or instance:IsDescendantOf(bot.Model)) then
			return bot
		end
	end
	return nil
end

-- Server-side melee check: range, facing, cooldown, and the victim must still be alive in this round
-- Flashed or caught in a Bear Trap: no stabbing, throwing or perks until it wears off
local function isStunned(player: Player): boolean
	local until_ = player:GetAttribute("StunnedUntil")
	return type(until_) == "number" and workspace:GetServerTimeNow() < until_
end

local function onAttack(round: Round)
	local now = os.clock()
	local murderer = round.Murderer
	if not murderer or now - round.LastAttack < GameConfig.AttackCooldown or isStunned(murderer) then
		return
	end
	-- During a Spam Knife / Hellfire burst every click is a throw instead (onAbility "Spam")
	if spamActive(murderer) then
		return
	end
	local murdererRoot = rootOf(murderer)
	if not murdererRoot or not round.Alive[murderer] then
		return
	end
	round.LastAttack = now

	-- Same stab / slash combo as in the hub; the murderer's own client already started it
	local character = murderer.Character :: Model
	local clipName = CombatService.NextSwing(murderer)
	Net.Animate(character, clipName, murderer)
	task.wait(AnimLibrary.Clips[clipName].Impact or 0.15)
	murdererRoot = rootOf(murderer) :: BasePart
	if not isLive(round) or not murdererRoot or not round.Alive[murderer] then
		return
	end
	local weapon = round.Weapon
	local handle = weapon and weapon:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild("Slash") :: Sound?
	if sound then
		sound:Play()
	end
	Net.Remotes.Effect:FireAllClients("Swing", murdererRoot.Position)
	PowerService.PopDecoyNear(murdererRoot.Position + murdererRoot.CFrame.LookVector * 3, GameConfig.AttackRange)

	-- Who can this swing reach? Distance is measured flat (no missing someone on a step), the
	-- facing check is loose (the server's view of the Murderer's turn lags), and a wall in between
	-- always blocks it.
	local exclude: { Instance } = { round.Bodies, round.Coins, round.BotFolder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = exclude
	local function reach(root: BasePart, range: number): number?
		local offset = root.Position - murdererRoot.Position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local dist = flat.Magnitude
		if dist > range or math.abs(offset.Y) > 6 then
			return nil
		end
		local look = murdererRoot.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if dist > 3 and flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(flat.Unit) < -0.3 then
			return nil
		end
		local from = murdererRoot.Position + Vector3.new(0, 1.5, 0)
		local wallHit = workspace:Raycast(from, root.Position + Vector3.new(0, 1.5, 0) - from, rayParams)
		if wallHit and wallHit.Instance.Name == "Wall" then
			return nil
		end
		return dist
	end

	local closest: Player?, closestBot: Bot?, closestDist = nil, nil, math.huge
	-- 1. The target the Murderer's own screen showed, if the server agrees it's believable: what
	--    you see is a little behind where people really are, so it gets extra reach for lag
	local hint = round.StabHint
	round.StabHint = nil
	if hint and os.clock() - hint.At < 0.75 then
		local target = hint.Target
		local victim = Players:GetPlayerFromCharacter(target)
		local bot = if victim then nil else botAt(round, target)
		local root = target:FindFirstChild("HumanoidRootPart") :: BasePart?
		local range = GameConfig.AttackRange + GameConfig.StabLagSlack
		if root and victim and victim ~= murderer and round.Alive[victim] then
			local dist = reach(root, range)
			if dist then
				closest, closestDist = victim, dist
			end
		elseif bot and bot ~= round.MurdererBot then
			local dist = reach(bot.Root, range)
			if dist then
				closestBot, closestDist = bot, dist
			end
		end
	end
	-- 2. Otherwise whoever is closest in front of the Murderer on the server
	if not closest and not closestBot then
		local range = GameConfig.AttackRange + 1
		for player in round.Alive do
			local root = rootOf(player)
			local dist = if player ~= murderer and root then reach(root, range) else nil
			if dist and dist < closestDist then
				closest, closestDist = player, dist
			end
		end
		for _, bot in round.Bots do
			local dist = if bot.Alive then reach(bot.Root, range) else nil
			if dist and dist < closestDist then
				closest, closestBot, closestDist = nil, bot, dist
			end
		end
	end
	-- A Barricade in the way takes the hit instead
	local obstacle = Obstacles.Near(murdererRoot.Position, GameConfig.AttackRange, murdererRoot.CFrame.LookVector)
	if obstacle then
		local point = obstacle.Part.Position
		if (point - murdererRoot.Position).Magnitude < closestDist + 1 then
			obstacle.Hit("Murderer")
			return
		end
	end
	if closestBot then
		killBot(round, closestBot, murderer)
	elseif closest then
		strike(round, closest)
	end
end

-- Abilities ---------------------------------------------------------------------------------

local function distanceToSegment(point: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	local t = if lengthSq > 0 then math.clamp((point - a):Dot(ab) / lengthSq, 0, 1) else 0
	return (point - (a + ab * t)).Magnitude
end

-- The Murderer's perk (from their knife), or nil
local function perkOf(round: Round): (string?, any)
	if round.Classic then
		return nil, nil -- CLASSIC: just a knife
	end
	local parsed = Items.Parse(round.WeaponKnife)
	local id = parsed and parsed.Perk
	return id, if id then GameConfig.Perks[id] else nil
end

local function knifePerkId(round: Round): string?
	return (perkOf(round))
end

-- Kills one target in the blast around a throw kill (Exploding Knife, Hellfire)
local function explode(round: Round, at: Vector3, radius: number)
	Net.Remotes.Effect:FireAllClients("Explosion", at, radius)
	for player in round.Alive do
		local root = rootOf(player)
		if not isKiller(round, player) and root and (root.Position - at).Magnitude <= radius then
			strike(round, player)
		end
	end
	for _, bot in round.Bots do
		if bot.Alive and bot ~= round.MurdererBot and (bot.Root.Position - at).Magnitude <= radius then
			killBot(round, bot, round.Murderer)
		end
	end
end

-- A thrown knife. Perks change it: Fury (faster per kill), Laser Knife (full charge = lightning
-- fast), Ghost Knife (flies through people), Exploding Knife / Hellfire (kills explode).
local function throwKnife(
	round: Round,
	origin: Vector3,
	direction: Vector3,
	charge: number,
	flaming: boolean?,
	range: number?,
	speedOverride: number?
)
	local config = { Range = range or GameConfig.MurderThrow.Range }
	local perkId, perk = perkOf(round)
	local speed = speedOverride or GameConfig.MurderThrow.Speed * (0.55 + 0.45 * charge)
	if perkId == "Fury" then
		speed *= 1 + round.FuryKills * perk.PerKill
	end
	local laser = perkId == "LaserKnife" and charge >= 0.95
	if laser then
		speed = perk.Speed
	end
	local pierceLeft = if perkId == "GhostKnife" then perk.Pierce else 1
	local blast = if perkId == "ExplodingKnife" or perkId == "Hellfire" then perk.Radius else nil

	local model = KnifeModel.Build(round.WeaponKnife, true)
	KnifeModel.FitLength(model, 2.6)
	for _, d in model:GetDescendants() do
		if d:IsA("Trail") then
			d.Enabled = true
		elseif d:IsA("BasePart") then
			if perkId == "GhostKnife" then
				d.Transparency = math.max(d.Transparency, 0.45)
			end
		end
	end
	local primary = model.PrimaryPart :: BasePart
	if flaming then
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 8
		fire.Color = Color3.fromRGB(255, 120, 30)
		fire.SecondaryColor = Color3.fromRGB(255, 40, 10)
		fire.Parent = primary
	end
	model.Parent = workspace
	if laser then
		Net.Remotes.Effect:FireAllClients("Laser", origin, origin + direction * config.Range)
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { (round.Murderer :: Player).Character :: Model, model, round.Bodies }

	local hitAlready: { [any]: boolean } = {}
	local position, traveled, spin = origin, 0, 0
	local connection: RBXScriptConnection
	local function finish(stuck: boolean)
		connection:Disconnect()
		if not stuck then
			model:Destroy()
		end
	end
	local function landed(at: Vector3, killed: boolean): boolean
		if killed then
			if blast then
				explode(round, at, blast)
			end
		end
		pierceLeft -= 1
		return pierceLeft <= 0
	end
	connection = RunService.Heartbeat:Connect(function(dt)
		if not isLive(round) then
			finish(false)
			return
		end
		local stepLength = math.min(speed * dt, config.Range - traveled)
		local nextPosition = position + direction * stepLength
		-- Walls first: anyone standing behind the wall this step is safe
		local hit = workspace:Raycast(position, nextPosition - position, params)
		if hit then
			nextPosition = hit.Position
		end

		-- Generous hit test against innocents so it feels fair on laggy connections
		for player in round.Alive do
			local root = rootOf(player)
			if
				not isKiller(round, player)
				and not hitAlready[player]
				and root
				and distanceToSegment(root.Position, position, nextPosition) < 3
			then
				hitAlready[player] = true
				local at = root.Position
				strike(round, player)
				if landed(at, not round.Alive[player]) then
					finish(false)
					return
				end
			end
		end
		for _, bot in round.Bots do
			if
				bot.Alive
				and bot ~= round.MurdererBot
				and not hitAlready[bot]
				and distanceToSegment(bot.Root.Position, position, nextPosition) < 3
			then
				hitAlready[bot] = true
				local at = bot.Root.Position
				killBot(round, bot, round.Murderer)
				if landed(at, true) then
					finish(false)
					return
				end
			end
		end
		if hit then
			-- A Barricade takes the knife
			local obstacle = Obstacles.Near(hit.Position, 1.5, nil)
			if obstacle then
				obstacle.Hit("Murderer")
			end
			-- Stays stuck in the wall / door for the rest of the round (round.Bodies goes at the end)
			StuckKnives.Stick(model, hit.Position, direction, 0, round.Bodies)
			finish(true)
			return
		end

		position = nextPosition
		traveled += stepLength
		spin += dt * 25
		model:PivotTo(CFrame.lookAt(position, position + direction) * CFrame.Angles(if laser then 0 else spin, 0, 0))
		if traveled >= config.Range then
			finish(false)
		end
	end)
	table.insert(round.Connections, connection)
end

-- Throws one knife from the Murderer's hand on the Throw clip's release frame
local function throwFromHand(
	round: Round,
	murderer: Player,
	direction: Vector3,
	charge: number,
	flaming: boolean?,
	range: number?,
	speed: number?
)
	local character = murderer.Character
	if not character then
		return
	end
	Net.Animate(character, "Throw", murderer)
	task.delay(AnimLibrary.Clips.Throw.Release or 0.07, function()
		local from = CombatService.HandPosition(murderer)
		if from and isLive(round) then
			throwKnife(round, from, direction, charge, flaming, range, speed)
		end
	end)
end

-- Spam Knife (always) / Hellfire (for a few seconds after Q): every click throws a knife straight
-- at where you aimed, as fast as you can click, flying until it hits something
local SPAM_SPEED = 170
local lastSpam: { [Player]: number } = {}
local function spamThrow(round: Round, murderer: Player, direction: Vector3)
	local character = murderer.Character
	local weapon = round.Weapon
	if not character or not weapon or weapon.Parent ~= character or isStunned(murderer) then
		return
	end
	local perkId, perk = perkOf(round)
	local flaming = perkId == "Hellfire"
	if not ((perkId == "SpamKnife" or flaming) and spamActive(murderer)) then
		return
	end
	local now = os.clock()
	if now - (lastSpam[murderer] or 0) < perk.Interval then
		return
	end
	lastSpam[murderer] = now
	local range = if perkId == "SpamKnife" then perk.Range else GameConfig.MurderThrow.Range
	throwFromHand(round, murderer, direction, 1, flaming, range, SPAM_SPEED)
end

local function usePerk(round: Round, direction: Vector3)
	local now = os.clock()
	local murderer = round.Murderer
	if not murderer or not round.Weapon or now < round.PerkReadyAt or isStunned(murderer) then
		return
	end
	local perkId, perk = perkOf(round)
	local root = rootOf(murderer)
	if not perkId or not perk or perk.Passive or not root then
		return
	end
	if perk.Uses then
		if round.PerkUses >= perk.Uses then
			Net.Notify(murderer, `No {perk.DisplayName} left this round`, "bad")
			return
		end
		round.PerkUses += 1
	end
	round.PerkReadyAt = now + perk.Cooldown
	Net.Remotes.AbilityState:FireClient(murderer, perk.DisplayName, workspace:GetServerTimeNow() + perk.Cooldown)
	round.LatestAim = direction

	if perkId == "Hellfire" then
		-- For a few seconds every click throws a flaming knife
		murderer:SetAttribute("SpamUntil", workspace:GetServerTimeNow() + perk.Duration)
		Net.Remotes.Effect:FireAllClients("Hellfire", root.Position)
		Net.Notify(murderer, "HELLFIRE! Click to throw flaming knives!", "bad")
	elseif perkId == "Identifier" then
		-- Who has the Revolver? Outlined through walls for a few seconds, on the Murderer's screen only
		local gunner = round.Gunner
		if gunner and gunner.Character then
			Net.Remotes.Effect:FireClient(murderer, "Radar", {
				{ Model = gunner.Character, Color = Color3.fromRGB(255, 220, 60) },
			}, perk.Duration)
			Net.Notify(murderer, `{round.Names[gunner] or "Someone"} has the Revolver!`, "bad")
		else
			Net.Notify(murderer, "Nobody has the Revolver yet...", "info")
		end
		Net.Notify(murderer, `Identifier: {perk.Uses - round.PerkUses} left`, "info")
	elseif perkId == "ShapeShifter" then
		local taken: { [string]: boolean } = {}
		for _, name in round.Names do
			taken[name] = true
		end
		for _, bot in round.Bots do
			taken[bot.Name] = true
		end
		local newName = Disguises.Shift(murderer, taken)
		if newName then
			round.Names[murderer] = newName
			Net.Remotes.Effect:FireAllClients("Smoke", root.Position)
			Net.Notify(murderer, `You are now {newName}!`, "good")
			Net.Remotes.Role:FireClient(murderer, "Murderer", newName)
		end
	end
end

-- Every kill the Murderer makes (players or bots): Fury stacks, Invisiknife cloaks
onMurderKill = function(round: Round, _at: Vector3)
	local murderer = round.Murderer
	local perkId, perk = perkOf(round)
	if not murderer or not perkId then
		return
	end
	if perkId == "Fury" then
		round.FuryKills += 1
		local root = rootOf(murderer)
		if root then
			Net.Remotes.Effect:FireAllClients("Fury", root.Position, round.FuryKills)
		end
		Net.Notify(
			murderer,
			`FURY x{round.FuryKills}: throws +{math.floor(round.FuryKills * perk.PerKill * 100)}% faster`,
			"bad"
		)
	elseif perkId == "Invisiknife" then
		Stealth.Vanish(murderer, perk.Duration)
	end
end

-- Aim comes from the client, so make sure it's a sane unit vector before using it
local function sanitizeAim(player: Player, aim: unknown): Vector3?
	local root = rootOf(player)
	if not root then
		return nil
	end
	if typeof(aim) == "Vector3" then
		local v = aim :: Vector3
		if v == v and v.Magnitude > 0.01 and v.Magnitude < 1e4 then
			return v.Unit
		end
	end
	return root.CFrame.LookVector
end

-- Hold-click throw: every Murderer has one, on its own cooldown, whatever their knife's perk is
local function basicThrow(round: Round, murderer: Player, direction: Vector3)
	local now = os.clock()
	local character = murderer.Character
	local weapon = round.Weapon
	if now < round.ThrowReadyAt or not character or not weapon or weapon.Parent ~= character or isStunned(murderer) then
		CombatService.TakeCharge(murderer)
		return
	end
	round.ThrowReadyAt = now + math.max(GameConfig.MurdererThrowCooldown, GameConfig.ThrowMinInterval)
	local charge = CombatService.TakeCharge(murderer)
	throwFromHand(round, murderer, direction, charge)
end

local function onAbility(player: Player, aim: unknown, kind: unknown)
	local round = current
	if not round or not round.Alive[player] then
		return
	end
	local direction = sanitizeAim(player, aim)
	if not direction then
		return
	end
	local mine = killerRound(round, player)
	if mine then
		if kind == "Spam" then
			spamThrow(mine, player, direction)
		elseif kind == "Throw" then
			basicThrow(mine, player, direction)
		else
			usePerk(mine, direction)
		end
	end
end

-- Coins -------------------------------------------------------------------------------------

-- A random open spot on the round map's floor (not inside furniture or walls). Cast from just
-- under the ceiling so tall furniture still blocks it.
local function randomFloorPoint(): Vector3?
	local center = MapService.RoundCenter
	local half = MapService.RoundMapSize / 2 - Vector2.new(3, 3)
	for _ = 1, 20 do
		local x, z = rng:NextNumber(-half.X, half.X), rng:NextNumber(-half.Y, half.Y)
		local hit = workspace:Raycast(Vector3.new(center.X + x, 12, center.Z + z), Vector3.new(0, -20, 0))
		local parent = hit and hit.Instance.Parent
		if hit and hit.Instance.Name == "Floor" and parent and parent.Name == "RoundMap" then
			return hit.Position
		end
	end
	return nil
end

-- A floor point that isn't right on top of another coin, so they spread through every room
local function coinPoint(round: Round): Vector3?
	local best: Vector3?, bestGap = nil, -1
	for _ = 1, 6 do
		local point = randomFloorPoint()
		if not point then
			continue
		end
		local gap = math.huge
		for _, other in round.Coins:GetChildren() do
			if other.Name == "Coin" and other:IsA("Model") then
				gap = math.min(gap, (other:GetPivot().Position - point).Magnitude)
			end
		end
		if gap > 10 then
			return point
		elseif gap > bestGap then
			best, bestGap = point, gap
		end
	end
	return best
end

-- The Blender coin (Props "Coin": rim, notched edge, a skull on both faces) standing upright with
-- a soft gold glow and a few sparkles; an invisible ball around it is what you touch
local function buildCoin(at: CFrame): (Model, BasePart)
	local coin = Props.Build("Coin", true)
	coin.Name = "Coin"
	coin:PivotTo(at)
	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Shape = Enum.PartType.Ball
	hitbox.Size = Vector3.one * 3.4
	hitbox.CFrame = at
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanQuery = false
	hitbox.Transparency = 1
	hitbox.Parent = coin
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 80)
	light.Range = 6
	light.Brightness = 0.7
	light.Shadows = false
	light.Parent = hitbox
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = Textures.Sparkle
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 235, 150))
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, 0.45),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkle.Lifetime = NumberRange.new(0.5, 0.9)
	sparkle.Rate = 2.5
	sparkle.Speed = NumberRange.new(0.3, 0.8)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Rotation = NumberRange.new(0, 360)
	sparkle.Parent = hitbox
	coin.PrimaryPart = hitbox
	return coin, hitbox
end

local function spawnCoin(round: Round)
	local point = coinPoint(round)
	if not point then
		return
	end
	-- Face a random way so a room full of coins doesn't look stamped out
	local coin, hitbox =
		buildCoin(CFrame.new(point + Vector3.new(0, 2.1, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0))
	coin:AddTag("Coin")
	coin.Parent = round.Coins
	hitbox.Touched:Connect(function(other)
		local player = Players:GetPlayerFromCharacter(other.Parent)
		if not player or not round.Alive[player] or not coin.Parent or current ~= round then
			return
		end
		local position = hitbox.Position
		coin:Destroy()
		local amount = pay(round, player, GameConfig.RoundPay.Coin)
		PowerService.AddEnergy(player, GameConfig.EnergyPerCoin)
		Net.Remotes.Effect:FireClient(player, "Coin", position, amount)
		task.delay(GameConfig.CoinRespawn, function()
			if current == round then
				spawnCoin(round)
			end
		end)
	end)
end

-- Revolver ----------------------------------------------------------------------------------

-- The Sheriff: hand the Revolver to a player, or to a bot (which then hunts and shoots, see the brains)
giveRevolver = function(round: Round, player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local tool = Revolver.BuildTool()
	tool.Parent = backpack
	round.GunTool = tool
	round.Gunner = player
	ReplicatedStorage:SetAttribute("Revolver", "Taken")
	Net.Notify(player, "You're the SHERIFF! Shoot the Murderer - but hit an innocent and you're out too.", "good")
end
giveRevolverToBot = function(round: Round, bot: Bot)
	local tool = Revolver.BuildTool()
	tool.Parent = bot.Model
	bot.Humanoid:EquipTool(tool)
	bot.Gun = tool
	round.GunnerBot = bot
	ReplicatedStorage:SetAttribute("Revolver", "Taken")
end

spawnRevolver = function(round: Round, position: Vector3?)
	if current ~= round or round.Revolver then
		return
	end
	local point = position or randomFloorPoint()
	if not point then
		return
	end
	local pickup = Revolver.BuildPickup(point + Vector3.new(0, if position then 0 else 2.5, 0))
	pickup.Parent = round.Coins
	round.Revolver = pickup
	ReplicatedStorage:SetAttribute("Revolver", "Dropped")
	Net.Remotes.Effect:FireAllClients("RevolverDrop", point)
	local zone = pickup:FindFirstChild("PickupZone") :: BasePart
	zone.Touched:Connect(function(other)
		local player = Players:GetPlayerFromCharacter(other.Parent)
		if not player or current ~= round or round.Revolver ~= pickup then
			return
		end
		if not round.Alive[player] or isKiller(round, player) or round.Gunner then
			return
		end
		pickup:Destroy()
		round.Revolver = nil
		local backpack = player:FindFirstChildOfClass("Backpack")
		local tool = Revolver.BuildTool()
		tool.Parent = backpack
		round.GunTool = tool
		round.Gunner = player
		ReplicatedStorage:SetAttribute("Revolver", "Taken")
		Net.Notify(player, "You have the Revolver! Shoot the Murderer, but don't hit an innocent!", "good")
		for other_ in round.Alive do
			if other_ ~= player then
				Net.Notify(other_, "Someone picked up the Revolver...", "info")
			end
		end
	end)
end

-- Shot by the Sheriff: the Murderer's power jumps off their knife onto the Sheriff's (a bot Sheriff
-- just knocks it off). The robbed Murderer gets revenge luck for their next rolls.
local function stealPower(round: Round, hero: Player?)
	local murderer = round.Murderer
	local item = round.WeaponKnife
	local parsed = Items.Parse(item)
	local power = parsed and parsed.Perk
	if not murderer or round.Classic or not power then
		return
	end
	local profile = DataService.Get(murderer)
	local index = profile and table.find(profile.Knives, item)
	if not profile or not index then
		return
	end
	local stripped = Items.WithPower(item, "")
	DataService.Update(murderer, function(p)
		p.Knives[index] = stripped
		if p.Equipped == item then
			p.Equipped = stripped
		end
		p.RevengeUntil = os.time() + GameConfig.Fuel.RevengeTime
	end)
	BaseService.RefreshRack(murderer)
	local perk = GameConfig.Perks[power]
	local powerName = if perk then perk.DisplayName else power
	Net.Notify(murderer, `Your {powerName} was stolen! Revenge luck: 3x power odds for 30 minutes.`, "bad")
	local heroProfile = hero and DataService.Get(hero)
	local target = hero and BaseService.ProtectedItem(hero)
	if hero and heroProfile and target then
		local heroIndex = table.find(heroProfile.Knives, target)
		local upgraded = Items.WithPower(target, power)
		if heroIndex then
			DataService.Update(hero, function(p)
				p.Knives[heroIndex] = upgraded
				if p.Equipped == target then
					p.Equipped = upgraded
				end
			end)
			BaseService.RefreshRack(hero)
			Net.Remotes.Effect:FireClient(hero, "PowerRoll", upgraded, power, Items.PowerOneIn(power))
			Net.Announce(
				`{hero.DisplayName} stole {murderer.DisplayName}'s {powerName}!`,
				Color3.fromRGB(255, 90, 140),
				3
			)
			return
		end
	end
	Net.Announce(`{murderer.DisplayName} lost their {powerName}!`, Color3.fromRGB(255, 90, 140), 2)
end

local function onShoot(player: Player, aim: unknown)
	local round = current
	if
		not round
		or (round.Gunner ~= player and round.Gunner2 ~= player)
		or not round.Alive[player]
		or typeof(aim) ~= "Vector3"
	then
		return
	end
	local character = player.Character
	local tool = if player == round.Gunner2 then round.GunTool2 else round.GunTool
	if not character or not tool or tool.Parent ~= character then
		return -- has to be holding it
	end
	local now = os.clock()
	if now - round.LastShot < GameConfig.RevolverCooldown then
		return
	end
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local offset = (aim :: Vector3) - head.Position
	if offset ~= offset or offset.Magnitude < 0.5 then
		return
	end
	round.LastShot = now

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, round.Bodies, round.Coins }
	local direction = offset.Unit * GameConfig.RevolverRange
	local hit = workspace:Raycast(head.Position, direction, params)
	local handle = tool:FindFirstChild("Handle")
	local muzzle = tool:FindFirstChild("Muzzle") :: BasePart?
	local sound = handle and handle:FindFirstChild("Shot") :: Sound?
	if sound then
		sound:Play()
	end
	Net.Animate(character, "Recoil")
	Net.Remotes.Effect:FireAllClients(
		"Shot",
		if muzzle then muzzle.Position else head.Position,
		if hit then hit.Position else head.Position + direction
	)
	if not hit then
		return
	end

	local hitBot = botAt(round, hit.Instance)
	if hitBot then
		if hitBot ~= round.MurdererBot then
			Net.Notify(player, "You shot an innocent! That costs you your life.", "bad")
			eliminate(round, player, nil, true)
		end
		killBot(round, hitBot, if hitBot == round.MurdererBot then player else nil)
		return
	end

	local victim: Player? = nil
	for other in round.Alive do
		if other ~= player and other.Character and hit.Instance:IsDescendantOf(other.Character) then
			victim = other
			break
		end
	end
	if not victim then
		return
	end
	local shotKiller = killerRound(round, victim)
	local perkId = if shotKiller then perkOf(shotKiller) else nil
	if shotKiller and perkId == "Bulletproof" and not shotKiller.BulletproofUsed then
		-- The bullet bounces off; the vest is used up
		shotKiller.BulletproofUsed = true
		local victimRoot = rootOf(victim)
		if victimRoot then
			Net.Remotes.Effect:FireAllClients("Shield", victimRoot.Position)
		end
		Net.Notify(victim, "BULLETPROOF! That shot bounced off. Next one counts!", "good")
		Net.Notify(player, "They're BULLETPROOF! Shoot again!", "bad")
		return
	end
	if shotKiller then
		round.Hero = round.Hero or player
		round.ShotKillers[victim] = true
		stealPower(shotKiller, player)
		local victimRoot = rootOf(victim)
		if victimRoot then
			finalMoment(round, victimRoot.Position, "Hero")
		end
		for other in round.Alive do
			Net.Notify(other, `{round.Names[player] or "Someone"} shot the Murderer!`, "good")
		end
		eliminate(round, victim, player, true)
	elseif
		victim.Character
		and type(victim.Character:GetAttribute("ShieldUntil")) == "number"
		and workspace:GetServerTimeNow() < victim.Character:GetAttribute("ShieldUntil") :: number
	then
		victim.Character:SetAttribute("ShieldUntil", nil)
		Net.Notify(victim, "Your Shield stopped a bullet!", "good")
	else
		-- Shot an innocent: both go down, and the Revolver drops where the shooter stood
		Net.Notify(player, "You shot an innocent! That costs you your life.", "bad")
		eliminate(round, victim, nil, true)
		eliminate(round, player, nil, true)
	end
end

-- Bot brains --------------------------------------------------------------------------------

-- Where the Murderer is, if an innocent bot could notice it (only once the knife is out)
local function murdererThreat(round: Round): BasePart?
	local murdererBot = round.MurdererBot
	if murdererBot then
		return if murdererBot.Alive and murdererBot.Knife then murdererBot.Root else nil
	end
	for killer in round.Killers do
		local view = killerRound(round, killer)
		local weapon = view and view.Weapon
		-- Only once the knife is out (pulling it is the reveal)
		if
			view
			and weapon
			and round.Alive[killer]
			and weapon.Parent == killer.Character
			and not killer:GetAttribute("Invisible")
			and not killer:GetAttribute("Mimic")
		then
			return rootOf(killer)
		end
	end
	return nil
end

-- Stroll to a random spot, hang around a moment, pick another
local function wander(bot: Bot, now: number)
	bot.Humanoid.WalkSpeed = 10
	if bot.Goal then
		if RoundBots.Reached(bot, 4) then
			bot.Goal = nil
			bot.IdleUntil = now + rng:NextNumber(0.5, 3)
		end
	elseif now >= bot.IdleUntil then
		RoundBots.WalkTo(bot, randomFloorPoint())
	end
end

-- Can this point see that one? (only the round map's walls, doors and furniture block)
local function canSee(from: Vector3, to: Vector3): boolean
	local map = MapService.RoundMapFolder()
	if not map then
		return true
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { map }
	return workspace:Raycast(from, to - from, params) == nil
end

-- A bot Sheriff's shot: good aim up close, worse far away
local function botShoot(round: Round, bot: Bot, target: BasePart)
	local from = bot.Root.Position + Vector3.new(0, 1.5, 0)
	local dist = (target.Position - from).Magnitude
	-- Nervous shots: decent point-blank, mostly misses from across a room
	local hits = rng:NextNumber() < math.clamp(0.55 - dist / 80, 0.12, 0.55)
	local aimAt = if hits
		then target.Position
		else target.Position + Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(0, 3), rng:NextNumber(-4, 4))
	local handle = bot.Gun and bot.Gun:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild("Shot") :: Sound?
	if sound then
		sound:Play()
	end
	Net.Animate(bot.Model, "Recoil")
	Net.Remotes.Effect:FireAllClients("Shot", from, aimAt)
	if not hits then
		return
	end
	local murdererBot = round.MurdererBot
	if murdererBot and target == murdererBot.Root then
		round.HeroBot = bot
		for other in round.Alive do
			Net.Notify(other, `{bot.Name} shot the Murderer!`, "good")
		end
		killBot(round, murdererBot, nil)
		return
	end
	local murderer = round.Murderer
	if not murderer then
		return
	end
	local perkId = perkOf(round)
	if perkId == "Bulletproof" and not round.BulletproofUsed then
		round.BulletproofUsed = true
		Net.Remotes.Effect:FireAllClients("Shield", target.Position)
		Net.Notify(murderer, "BULLETPROOF! That shot bounced off. Next one counts!", "good")
		return
	end
	round.ShotByBot = true
	round.HeroBot = bot
	stealPower(round, nil)
	finalMoment(round, target.Position, "Hero")
	for other in round.Alive do
		Net.Notify(other, `{bot.Name} shot the Murderer!`, "good")
	end
	eliminate(round, murderer, nil, true)
end

local function innocentBrain(round: Round, bot: Bot, now: number)
	local threat = murdererThreat(round)
	local eye = bot.Root.Position + Vector3.new(0, 1.5, 0)
	-- The Sheriff: once it knows who the Murderer is, it closes in, stops, aims and shoots
	if bot.Gun then
		if threat then
			local dist = (threat.Position - bot.Root.Position).Magnitude
			if dist < 45 and canSee(eye, threat.Position) then
				RoundBots.WalkTo(bot, nil)
				RoundBots.Face(bot, threat.Position)
				if bot.AimUntil == 0 then
					bot.AimUntil = now + 1.1 + dist / 40 -- a slow, shaky aim: time to dodge or close in
				end
				if now >= bot.AimUntil and now >= bot.NextShot then
					bot.NextShot = now + GameConfig.RevolverCooldown + 2
					bot.AimUntil = 0
					botShoot(round, bot, threat)
				end
				return
			end
			-- Lost sight: go to where it was
			bot.AimUntil = 0
			bot.Humanoid.WalkSpeed = GameConfig.RoundWalkSpeed - 1
			RoundBots.WalkTo(bot, threat.Position)
			return
		end
		bot.AimUntil = 0
		wander(bot, now)
		return
	end
	-- A Revolver lying around and the coast is clear: go get it
	local pickup = round.Revolver
	if pickup and pickup.Parent and not round.Gunner and not round.GunnerBot then
		local spot = pickup:GetPivot().Position
		if not threat or (threat.Position - bot.Root.Position).Magnitude > 22 then
			bot.Humanoid.WalkSpeed = GameConfig.RoundWalkSpeed - 1
			RoundBots.WalkTo(bot, spot)
			if (spot - bot.Root.Position).Magnitude < 4 then
				pickup:Destroy()
				round.Revolver = nil
				giveRevolverToBot(round, bot)
				for other in round.Alive do
					Net.Notify(other, "Someone picked up the Revolver...", "info")
				end
			end
			return
		end
	end
	if not threat or (threat.Position - bot.Root.Position).Magnitude > 32 then
		wander(bot, now)
		return
	end
	-- Run! Head for a spot far from the Murderer that isn't back past it
	bot.Humanoid.WalkSpeed = GameConfig.RoundWalkSpeed - 1
	if bot.Goal and not RoundBots.Reached(bot, 4) and now < bot.NextThink then
		return
	end
	bot.NextThink = now + 1.2
	local away = bot.Root.Position - threat.Position
	local best, bestScore = nil, -math.huge
	for _ = 1, 8 do
		local point = randomFloorPoint()
		if point then
			local score = (point - threat.Position).Magnitude - 0.5 * (point - bot.Root.Position).Magnitude
			if (point - bot.Root.Position):Dot(away) < 0 then
				score -= 40
			end
			if score > bestScore then
				best, bestScore = point, score
			end
		end
	end
	RoundBots.WalkTo(bot, best)
end

local function murdererBrain(round: Round, bot: Bot, now: number)
	if not bot.Knife then
		wander(bot, now) -- the grace period: blend in
		return
	end
	-- Bear traps catch a Murderer bot too
	local stun = PowerService.SpringRoundTrap(bot.Root.Position)
	if stun then
		bot.StunnedUntil = workspace:GetServerTimeNow() + stun
		Net.Animate(bot.Model, "Hurt")
	end
	-- Stuck at a Barricade: smash it
	local obstacle = Obstacles.Near(bot.Root.Position, 4.5, bot.Root.CFrame.LookVector)
	if obstacle and now >= bot.NextStab then
		bot.NextStab = now + 1
		RoundBots.Face(bot, obstacle.Part.Position)
		Net.Animate(bot.Model, "Stab")
		obstacle.Hit("Murderer")
		return
	end

	-- Hunt the closest person it can see (Vanish / Mimic hide you)
	local target: BasePart?, targetPlayer: Player?, targetBot: Bot? = nil, nil, nil
	local bestDist = math.huge
	for player in round.Alive do
		local root = rootOf(player)
		local dist = if root then (root.Position - bot.Root.Position).Magnitude else math.huge
		-- (a walking Mimic disguise fools them from a distance, not up close)
		local hidden = player:GetAttribute("Invisible")
			or (player:GetAttribute("Mimic") and dist > GameConfig.MimicSpotRange)
		if root and not hidden then
			if dist < bestDist then
				target, targetPlayer, targetBot, bestDist = root, player, nil, dist
			end
		end
	end
	for _, other in round.Bots do
		if other.Alive and other ~= bot then
			local dist = (other.Root.Position - bot.Root.Position).Magnitude
			if dist < bestDist then
				target, targetPlayer, targetBot, bestDist = other.Root, nil, other, dist
			end
		end
	end
	local sheriff: BasePart? = if round.Gunner
		then rootOf(round.Gunner)
		elseif round.GunnerBot then round.GunnerBot.Root
		else nil
	if sheriff and (sheriff.Position - bot.Root.Position).Magnitude < 40 then
		target, bestDist = sheriff, (sheriff.Position - bot.Root.Position).Magnitude
		targetPlayer = round.Gunner
		targetBot = round.GunnerBot
	end
	if not target then
		wander(bot, now)
		return
	end
	bot.Humanoid.WalkSpeed = GameConfig.MurdererWalkSpeed - 0.5
	RoundBots.WalkTo(bot, target.Position)

	local stunned = workspace:GetServerTimeNow() < bot.StunnedUntil
	if bestDist < GameConfig.AttackRange - 2 and now >= bot.NextStab and not stunned then
		bot.NextStab = now + 1.2
		RoundBots.Face(bot, target.Position)
		Net.Animate(bot.Model, "Stab")
		Net.Remotes.Effect:FireAllClients("Swing", bot.Root.Position)
		PowerService.PopDecoyNear(bot.Root.Position + bot.Root.CFrame.LookVector * 3, GameConfig.AttackRange)
		local victimRoot = target
		task.delay(AnimLibrary.Clips.Stab.Impact or 0.15, function()
			-- Still in reach when the blade lands? (you can dodge it)
			if current ~= round or not bot.Alive then
				return
			end
			if (victimRoot.Position - bot.Root.Position).Magnitude > GameConfig.AttackRange + 1 then
				return
			end
			if targetPlayer then
				strike(round, targetPlayer)
			elseif targetBot then
				killBot(round, targetBot, nil)
			end
		end)
	end
end

local function stepBots(round: Round)
	local now = os.clock()
	for _, bot in round.Bots do
		if not bot.Alive then
			continue
		end
		if bot == round.MurdererBot then
			murdererBrain(round, bot, now)
		else
			innocentBrain(round, bot, now)
		end
		RoundBots.Step(bot)
		if bot.Root.Position.Y < -30 then
			killBot(round, bot, nil) -- fell out of the map
		end
	end
end

-- Dread: how close the Murderer (with the knife out) is to each innocent, 0..1. Clients turn
-- it into a heartbeat and a dark vignette. Nobody is told who the Murderer is.
updateDread = function(round: Round)
	local killerRoots: { BasePart } = {}
	if round.MurdererBot then
		if round.MurdererBot.Alive and round.MurdererBot.Knife then
			table.insert(killerRoots, round.MurdererBot.Root)
		end
	end
	for killer in round.Killers do
		local view = killerRound(round, killer)
		local root = rootOf(killer)
		if view and view.Weapon and round.Alive[killer] and root then
			table.insert(killerRoots, root)
		end
	end
	for player in round.Alive do
		if isKiller(round, player) then
			continue
		end
		local root = rootOf(player)
		local dread = 0
		for _, killerRoot in killerRoots do
			if root then
				local distance = (root.Position - killerRoot.Position).Magnitude
				dread = math.max(dread, math.clamp(1 - (distance - 8) / 45, 0, 1))
			end
		end
		local value = if dread > 0.05 then math.floor(dread * 10 + 0.5) / 10 else nil
		if player:GetAttribute("Dread") ~= value then
			player:SetAttribute("Dread", value)
		end
	end
end

-- Round flow --------------------------------------------------------------------------------

local function giveWeapon(round: Round)
	local murderer = round.Murderer
	if not murderer then
		if round.MurdererBot then
			RoundBots.GiveKnife(round.MurdererBot, round.WeaponKnife)
		end
		return
	end
	local backpack = murderer:FindFirstChildOfClass("Backpack")
	if not backpack or not round.Alive[murderer] then
		return
	end
	local tool = KnifeModel.BuildTool(round.WeaponKnife)
	tool:SetAttribute("MurderKnife", true)
	local slash = Instance.new("Sound")
	slash.Name = "Slash"
	slash.SoundId = Sounds.Slash
	slash.Volume = 0.8
	slash.Parent = tool:FindFirstChild("Handle")
	tool.Parent = backpack
	round.Weapon = tool
	-- Knife in hand = revealed: only then the Murderer's speed (no speed tell while hiding) and
	-- only then can Radar find them
	local function knifeOut(out: boolean)
		murderer:SetAttribute("KnifeOut", if out then true else nil)
		BaseService.RefreshWalkSpeed(murderer)
	end
	table.insert(
		round.Connections,
		tool.Equipped:Connect(function()
			knifeOut(true)
		end)
	)
	table.insert(
		round.Connections,
		tool.Unequipped:Connect(function()
			knifeOut(false)
		end)
	)
	-- Tool.Activated replicates to the server; the client never reports hits itself
	table.insert(
		round.Connections,
		tool.Activated:Connect(function()
			onAttack(round)
		end)
	)
	local perkId, perk = perkOf(round)
	-- Spam Knife: click = throw for the whole round (the same mode Hellfire's Q turns on briefly)
	local spam = perkId == "SpamKnife"
	if spam then
		murderer:SetAttribute("SpamUntil", workspace:GetServerTimeNow() + GameConfig.RoundTime + 60)
	end
	Net.Notify(
		murderer,
		`{Items.DisplayName(round.WeaponKnife)} is in your hotbar. Pull it out when you're ready - everyone will see it! {if spam
			then "Click = throw!"
			else "Click = stab, hold = throw."}`,
		"bad"
	)
	if perk then
		Net.Notify(
			murderer,
			`Perk: {perk.DisplayName} - {perk.Description}{if perk.Passive then "" else " (Q)"}`,
			"bad"
		)
		-- Only active perks get a button
		Net.Remotes.AbilityState:FireClient(murderer, if perk.Passive then nil else perk.DisplayName, 0)
		murderer:SetAttribute("Perk", knifePerkId(round))
	end
	-- The knife arrives quietly in their hotbar: nobody can tell who got it until they choose to
	-- pull it out (the draw flourish plays then, for everyone - that's the reveal)
	local root = rootOf(murderer)
	if root then
		Net.Remotes.Effect:FireClient(murderer, "Unsheath", nil)
	end
	table.insert(
		round.Connections,
		tool.Equipped:Connect(function()
			local character = murderer.Character
			if character and current == round then
				Net.Animate(character, "Draw")
			end
		end)
	)
end

local function startRound(participants: { Player })
	local built = MapService.BuildRoundMap()
	ReplicatedStorage:SetAttribute("MapName", built.Name)
	RoundBots.SetMap(built.Folder)
	-- A Studio bot round: the person who asked picks their side; bots fill in the rest
	local plan = botPlan
	botPlan = nil
	if plan and not table.find(participants, plan.Player) then
		plan = nil
	end
	-- Bots: a Studio bot round asks for exactly three; otherwise they top the round up to
	-- GameConfig.BotFill.Size. With two or more real players the Murderer is always one of them;
	-- alone with bots, a bot gets the knife as often as a fair draw would give it to one.
	local botCount = if plan then 3 else math.max(0, GameConfig.BotFill.Size - #participants)
	local murderer: Player?
	if plan then
		murderer = if plan.Role == "Murderer" then plan.Player else nil
	elseif #participants == 1 and botCount > 0 then
		local profile = DataService.Get(participants[1])
		local weight = (1 + (if profile then profile.Luck else 0))
			+ (if profile and profile.Tickets > 0 then GameConfig.TicketWeight else 0)
		murderer = if rng:NextNumber() * (weight + botCount) < weight then pickMurderer(participants) else nil
	else
		murderer = pickMurderer(participants)
	end
	-- DOUBLE TROUBLE: two Murderers (and two Sheriffs). Always on busy servers, sometimes on quiet
	-- ones; needs two real players to be the Murderers. Your teammate is picked with you.
	local partner: Player? = nil
	if
		not plan
		and murderer
		and #participants >= 3
		and (#participants >= GameConfig.DoubleTrouble.Always or rng:NextNumber() < GameConfig.DoubleTrouble.Chance)
	then
		local teammate = Social.PartnerOf(murderer)
		if teammate and table.find(participants, teammate) then
			partner = teammate
		else
			local rest = table.clone(participants)
			table.remove(rest, table.find(rest, murderer) :: number)
			partner = pickMurderer(rest)
		end
	end
	local botFolder = Instance.new("Folder")
	botFolder.Name = "RoundBots"
	botFolder.Parent = workspace
	local coins = Instance.new("Folder")
	coins.Name = "RoundCoins"
	coins.Parent = workspace
	local bodies = Instance.new("Folder")
	bodies.Name = "RoundBodies"
	bodies.Parent = workspace
	local round: Round = {
		Murderer = murderer,
		MurdererBot = nil,
		Bots = {},
		BotFolder = botFolder,
		Innocents = {},
		Alive = {},
		Kills = 0,
		Weapon = nil,
		WeaponKnife = if murderer then murdererKnife(murderer) else Knives.List[rng:NextInteger(1, #Knives.List)].Name,
		LastAttack = 0,
		PerkReadyAt = 0,
		Coins = coins,
		Bodies = bodies,
		Loot = {},
		Names = {},
		Revolver = nil,
		Gunner = nil,
		GunTool = nil,
		LastShot = 0,
		ThrowReadyAt = 0,
		FuryKills = 0,
		PerkUses = 0,
		BulletproofUsed = false,
		LatestAim = nil,
		Hero = nil,
		Double = false,
		Killers = if murderer then { [murderer] = true } else {},
		Partner = nil,
		PartnerRound = nil,
		Gunner2 = nil,
		GunTool2 = nil,
		ShotKillers = {},
		GunnerBot = nil,
		ShotByBot = false,
		HeroBot = nil,
		-- (never for a Studio bot round: those are for testing perks and powers)
		Classic = plan == nil and rng:NextNumber() < GameConfig.ClassicChance,
		AtRisk = {},
		PayScale = if #participants >= 2 then 1 else GameConfig.BotRoundPay,
		HumanKills = 0,
		Connections = {},
	}
	current = round
	if partner then
		round.Double = true
		round.Partner = partner
		round.Killers[partner] = true
		round.PartnerRound = partnerView(round, partner, murdererKnife(partner))
	end
	ReplicatedStorage:SetAttribute("Classic", round.Classic or nil)
	ReplicatedStorage:SetAttribute("Double", round.Double or nil)
	if round.Classic then
		round.PayScale *= GameConfig.ClassicPay
	end
	ReplicatedStorage:SetAttribute("Revolver", nil)
	ReplicatedStorage:SetAttribute("Loot", nil)

	-- Everyone becomes a named character (yields while outfits apply)
	round.Names = Disguises.Assign(participants)

	-- Shuffle spawns so the Murderer's spot gives nothing away
	local spawns = table.clone(MapService.RoundSpawns)
	for i = #spawns, 2, -1 do
		local j = rng:NextInteger(1, i)
		spawns[i], spawns[j] = spawns[j], spawns[i]
	end

	-- Screens fade to black with the map's name while everyone is moved (client/Transitions)
	for _, player in participants do
		Net.Remotes.Effect:FireClient(
			player,
			"Fade",
			`🔪 {ReplicatedStorage:GetAttribute("MapName") or "The Murder"}{if round.Double
				then "\nDOUBLE TROUBLE - 2 Murderers, 2 Sheriffs!"
				else ""}{if round.Classic
				then "\nCLASSIC ROUND - no powers, no perks, x" .. GameConfig.ClassicPay .. " pay!"
				else ""}`
		)
	end
	task.wait(0.35)

	-- The round map is far from the hub: load it on everyone's client first, or StreamingEnabled
	-- freezes them with "Gameplay paused" while it streams in (all at once, at most 4 seconds)
	local pending = 0
	for i, player in participants do
		pending += 1
		task.spawn(function()
			pcall(player.RequestStreamAroundAsync, player, spawns[(i - 1) % #spawns + 1].Position, 4)
			pending -= 1
		end)
	end
	local streamStart = os.clock()
	while pending > 0 and os.clock() - streamStart < 4 do
		task.wait()
	end

	for i, player in participants do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not character or not humanoid then
			continue
		end
		StealService.ForceDrop(player)
		local isMurderer = round.Killers[player] == true
		if not isMurderer then
			table.insert(round.Innocents, player)
		end
		round.Alive[player] = true
		player:SetAttribute("InRound", true)
		player:SetAttribute("Role", if isMurderer then "Murderer" else "Innocent")
		DataService.Update(player, function(p)
			p.Luck = if isMurderer then 0 else p.Luck + GameConfig.Fuel.MeterPerRound
		end)

		-- Back to exactly this spot when the round is over (BaseService.TeleportHome)
		local here = character:GetPivot()
		local facing = here.LookVector * Vector3.new(1, 0, 1)
		BaseService.SetReturnSpot(
			player,
			if facing.Magnitude > 0.1 then CFrame.lookAt(here.Position, here.Position + facing) else here
		)
		character:PivotTo(spawns[(i - 1) % #spawns + 1])
		BaseService.RefreshWalkSpeed(player)
		Net.Remotes.Role:FireClient(player, if isMurderer then "Murderer" else "Innocent", round.Names[player])

		table.insert(
			round.Connections,
			humanoid.Died:Connect(function()
				if isKiller(round, player) then
					round.Alive[player] = nil -- fell off or reset: that Murderer is out
				else
					eliminate(round, player, nil)
				end
			end)
		)
	end

	if botCount > 0 then
		local taken: { [string]: boolean } = {}
		for _, name in round.Names do
			taken[name] = true
		end
		local roles: { string } = {}
		for i = 1, botCount do
			table.insert(roles, if i == 1 and not murderer then "Murderer" else "Innocent")
		end
		for i, role in roles do
			local at = spawns[(#participants + i - 1) % #spawns + 1]
			local bot = RoundBots.Spawn(at, role, taken, botFolder)
			table.insert(round.Bots, bot)
			if role == "Murderer" then
				round.MurdererBot = bot
			end
		end
	end
	ReplicatedStorage:SetAttribute("Alive", aliveCount(round))

	for _ = 1, GameConfig.RoundCoins do
		spawnCoin(round)
	end

	if round.Partner then
		local a, b = round.Murderer :: Player, round.Partner :: Player
		for _, pair in { { a, b }, { b, a } } do
			Net.Remotes.Effect:FireClient(
				pair[1],
				"Partner",
				pair[2].Character,
				round.Names[pair[2]] or pair[2].DisplayName
			)
		end
	end
	task.delay(GameConfig.MurdererGrace, function()
		if current == round then
			giveWeapon(round)
			if round.PartnerRound then
				giveWeapon(round.PartnerRound)
			end
		end
	end)
	-- A Sheriff from the start (MM2 style): any innocent, player or bot, gets the Revolver now
	local sheriffs: { any } = {}
	for _, player in round.Innocents do
		if round.Alive[player] then
			table.insert(sheriffs, player)
		end
	end
	for _, bot in round.Bots do
		if bot.Alive and bot ~= round.MurdererBot then
			table.insert(sheriffs, bot)
		end
	end
	if #sheriffs > 0 then
		local chosen = sheriffs[rng:NextInteger(1, #sheriffs)]
		if typeof(chosen) == "Instance" then
			giveRevolver(round, chosen :: Player)
		else
			giveRevolverToBot(round, chosen)
		end
		table.remove(sheriffs, table.find(sheriffs, chosen) :: number)
		if round.Double and #sheriffs > 0 then
			local teammate = if typeof(chosen) == "Instance" then Social.PartnerOf(chosen :: Player) else nil
			local second = if teammate and table.find(sheriffs, teammate)
				then teammate
				else sheriffs[rng:NextInteger(1, #sheriffs)]
			if typeof(second) == "Instance" then
				local player = second :: Player
				local tool = Revolver.BuildTool()
				tool.Parent = player:FindFirstChildOfClass("Backpack")
				round.Gunner2, round.GunTool2 = player, tool
				Net.Notify(player, "You're the second SHERIFF! Two Murderers this round - shoot carefully.", "good")
			else
				giveRevolverToBot(round, second)
			end
		end
	end

	-- Everyone sees the knife they'd lose to the Murderer (client/Transitions spins a reel onto it)
	for _, player in round.Innocents do
		local profile = DataService.Get(player)
		if not profile or DataService.IsNewPlayer(player, profile) then
			continue
		end
		local protected = BaseService.ProtectedItem(player)
		local choices = {}
		for _, item in profile.Knives do
			if item ~= protected then
				table.insert(choices, item)
			end
		end
		if #choices > 0 then
			local chosen = choices[rng:NextInteger(1, #choices)]
			round.AtRisk[player] = chosen
			Net.Remotes.Effect:FireClient(player, "AtRisk", choices, chosen)
		end
	end

	-- Nobody took the Revolver (or it dropped): it turns up somewhere later
	task.delay(GameConfig.RevolverTime, function()
		if current == round and not round.Gunner and not round.GunnerBot and not round.Revolver then
			spawnRevolver(round, nil)
			for player in round.Alive do
				Net.Notify(player, "A Revolver appeared somewhere in the building!", "info")
			end
		end
	end)
end

local function endRound(round: Round)
	current = nil
	for _, connection in round.Connections do
		connection:Disconnect()
	end
	if round.Weapon then
		round.Weapon:Destroy()
	end
	if round.PartnerRound and round.PartnerRound.Weapon then
		round.PartnerRound.Weapon:Destroy()
	end
	if round.GunTool2 then
		round.GunTool2:Destroy()
	end
	ReplicatedStorage:SetAttribute("Double", nil)
	if round.GunTool then
		round.GunTool:Destroy()
	end
	-- Bots have no Roblox photo: keep their disguise's face for the VS card before they're gone
	local function botFace(bot: Bot?): { Face: string, Skin: Color3 }?
		local head = bot and bot.Model:FindFirstChild("Head") :: BasePart?
		local decal = head and head:FindFirstChildOfClass("Decal")
		return if head then { Face = if decal then decal.Texture else "", Skin = head.Color } else nil
	end
	local murdererBotFace = botFace(round.MurdererBot)
	local heroBotFace = botFace(round.HeroBot)
	round.Coins:Destroy()
	round.Bodies:Destroy()
	round.BotFolder:Destroy()
	ReplicatedStorage:SetAttribute("Revolver", nil)

	local survivors = {}
	for _, player in round.Innocents do
		if round.Alive[player] and player.Parent then
			table.insert(survivors, player)
		end
	end
	local murderer = round.Murderer
	local murdererPresent = murderer == nil or murderer.Parent ~= nil
	local botsSurvived = false
	for _, bot in round.Bots do
		if bot.Alive and bot ~= round.MurdererBot then
			botsSurvived = true
		end
	end
	local innocentsWon = #survivors > 0 or botsSurvived or round.Hero ~= nil

	-- Loot goes back to its owners if the Murderer was shot (or quit); otherwise they keep it
	local hero = round.Hero
	local kept: { [Player]: number } = {}
	for _, entry in round.Loot do
		local killer = entry.Killer or murderer
		local returned = round.ShotByBot
			or not killer
			or not killer.Parent
			or round.ShotKillers[killer]
			or (not round.Double and (hero ~= nil or not murdererPresent))
		if returned or not killer then
			if entry.Owner.Parent then
				giveKnife(entry.Owner, entry.Knife)
				Net.Notify(entry.Owner, `Your {Items.DisplayName(entry.Knife)} is back!`, "good")
			end
		else
			giveKnife(killer, entry.Knife)
			kept[killer] = (kept[killer] or 0) + 1
		end
	end
	for killer, count in kept do
		Net.Notify(killer, `{count} looted knife(s) added to your vault!`, "good")
	end
	if hero and hero.Parent then
		local amount = pay(round, hero, GameConfig.RoundPay.Hero)
		Net.Notify(hero, `HERO! You stopped the Murderer! +{Format.Cash(amount)}`, "good")
	end
	ReplicatedStorage:SetAttribute("Loot", nil)
	if round.Partner and round.Partner.Parent and not innocentsWon then
		Fuel.AddHeat(round.Partner, 1, "You won as the Murderers!")
	end
	if murderer and murderer.Parent and not innocentsWon then
		Fuel.AddHeat(murderer, 1, "You won as the Murderer!")
		-- A massacre of real players calls the Thief Moon early: chaos spills into the hub
		if round.HumanKills >= 2 then
			ServerEvents.Wipe(murderer.DisplayName)
		end
	end
	local fewLeft = #survivors <= math.max(1, math.ceil(#round.Innocents * GameConfig.LastAliveFraction))

	-- The innocents' side won: everyone on it gets something, even the ones who didn't make it
	if innocentsWon and murdererPresent then
		for _, player in round.Innocents do
			if player.Parent and not table.find(survivors, player) and player ~= hero then
				local amount = pay(round, player, GameConfig.RoundPay.TeamWin)
				Net.Notify(player, `Your side won! +{Format.Cash(amount)}`, "good")
			end
		end
	end

	for _, player in survivors do
		Fuel.AddHeat(player, 1, "Survived the round!")
		Fuel.AddMeter(player, 1)
		ServerEvents.Progress("Survives")
		local reward = pay(round, player, GameConfig.RoundPay.Survive)
			+ (if fewLeft then pay(round, player, GameConfig.RoundPay.LastAlive) else 0)
		DataService.Update(player, function(p)
			p.RoundsWon += 1
		end)
		Net.Notify(player, `You survived! +{Format.Cash(reward)}`, "good")
		if player.Character then
			Net.Animate(player.Character, "Cheer")
		end
		player:SetAttribute("BoostUntil", workspace:GetServerTimeNow() + GameConfig.BoostDuration)
		Net.Notify(
			player,
			`Survivor boost: {GameConfig.BoostMultiplier}x vault income for {GameConfig.BoostDuration}s!`,
			"info"
		)
	end
	if murderer and murdererPresent then
		if hero then
			Net.Notify(murderer, "You were shot! Your loot went back to its owners.", "bad")
		elseif not innocentsWon and round.Kills > 0 then -- no bonus when everyone just left
			-- One against the whole lobby: the prize grows with every real player they got
			local bonus = pay(round, murderer, GameConfig.RoundPay.Wipe)
			for _ = 1, round.HumanKills do
				bonus += pay(round, murderer, GameConfig.RoundPay.WipePerVictim)
			end
			DataService.Update(murderer, function(p)
				p.RoundsWon += 1
			end)
			Net.Notify(murderer, `You got everyone! Bonus +{Format.Cash(bonus)}`, "good")
			if round.HumanKills > 0 then
				local config = GameConfig.WipeCase
				local rarity = if #round.Innocents >= config.BigLobby then config.Big else config.Small
				task.delay(1.5, function()
					if not murderer.Parent then
						return
					end
					if StealService.OpenCase(murderer, rarity) then
						Net.Notify(murderer, `Wipe prize: a {rarity} Case!`, "good")
					else
						local value = 0
						for _, entry in GameConfig.CaseShop do
							if entry.Rarity == rarity then
								value = entry.Cost
							end
						end
						DataService.AddCash(murderer, value)
						Net.Notify(
							murderer,
							`Wipe prize: your wall is full, so +{Format.Cash(value)} instead of a {rarity} Case`,
							"good"
						)
					end
				end)
			end
		else
			Net.Notify(murderer, `Time's up! {round.Kills} eliminated.`, "info")
		end
	end

	-- Everyone still in the round goes home as themselves, behind a fade (client/Transitions)
	local fading = false
	for player in round.Alive do
		if player.Parent then
			Net.Remotes.Effect:FireClient(player, "Fade", "🏠 Back to the hub")
			fading = true
		end
	end
	if fading then
		task.wait(0.35)
	end
	for player in round.Alive do
		if player.Parent then
			leaveRound(player)
			Disguises.Remove(player)
			BaseService.TeleportHome(player)
		end
	end
	if murderer then
		leaveRound(murderer)
	end
	if round.Partner then
		leaveRound(round.Partner)
	end
	for player in round.Names do
		Disguises.Forget(player)
	end

	local murdererName = if murderer
		then `{round.Names[murderer] or "?"} ({murderer.DisplayName})`
		else `{if round.MurdererBot then round.MurdererBot.Name else "?"} (a bot)`
	local status = if #round.Innocents == 0 and #round.Bots == 0
		then "Solo test round over" -- Studio debug rounds have nobody to survive
		elseif hero then `{round.Names[hero] or hero.DisplayName} shot the Murderer, {murdererName}!`
		elseif innocentsWon then `Innocents win! The Murderer was {murdererName}`
		else `The Murderer wins! It was {murdererName}`
	setPhase("Results", GameConfig.ResultsTime, status)
	ReplicatedStorage:SetAttribute("Classic", nil)
	-- The VS card: who was the Murderer, with which knife, and who stopped them (client/Transitions)
	local heroName: string? = if hero
		then `{round.Names[hero] or "?"} ({hero.DisplayName})`
		elseif round.HeroBot then `{round.HeroBot.Name} (bot Sheriff)`
		else nil
	local card = {
		Title = if hero or round.HeroBot
			then "The Sheriff saved the day!"
			elseif innocentsWon then "The innocents survived!"
			else "The Murderer wins!",
		Won = if innocentsWon then "Innocents" else "Murderer",
		MurdererName = if murderer and round.Partner
			then `{round.Names[murderer] or "?"} & {round.Names[round.Partner] or "?"}`
			elseif murderer then `{round.Names[murderer] or "?"} ({murderer.DisplayName})`
			elseif round.MurdererBot then `{round.MurdererBot.Name} (bot)`
			else "?",
		MurdererId = if murderer then murderer.UserId else 0,
		Knife = round.WeaponKnife,
		HeroName = heroName,
		HeroId = if hero then hero.UserId else 0,
		MurdererFace = murdererBotFace,
		HeroFace = heroBotFace,
		Kills = round.Kills,
		Classic = round.Classic,
	}
	for player in round.Names do
		if player.Parent then
			Net.Remotes.Effect:FireClient(player, "RoundCard", card)
		end
	end
end

local function roundOver(round: Round): boolean
	local murderer = round.Murderer
	-- Every Murderer down (both, in Double Trouble): the innocents win
	if murderer then
		local anyLeft = false
		for killer in round.Killers do
			if round.Alive[killer] and killer.Parent then
				anyLeft = true
			end
		end
		if not anyLeft then
			return true
		end
	end
	if round.MurdererBot and not round.MurdererBot.Alive then
		return true
	end
	if #round.Innocents == 0 and #round.Bots == 0 then
		return false -- solo Studio test: just run the clock
	end
	for player in round.Alive do
		if not isKiller(round, player) and player.Parent then
			return false
		end
	end
	for _, bot in round.Bots do
		if bot.Alive and bot ~= round.MurdererBot then
			return false
		end
	end
	return true
end

local function loop()
	while true do
		-- Intermission: steal knives, earn cash, buy upgrades and round items
		setPhase("Intermission", GameConfig.IntermissionTime, INTERMISSION_STATUS)
		local endsAt = os.clock() + GameConfig.IntermissionTime
		while os.clock() < endsAt do
			task.wait(1)
			if RunService:IsStudio() and ReplicatedStorage:GetAttribute("DebugSkip") then
				ReplicatedStorage:SetAttribute("DebugSkip", nil)
				break
			end
			if #Players:GetPlayers() < minPlayers() then
				-- Hold the timer until enough people are here
				endsAt = os.clock() + GameConfig.IntermissionTime
				setPhase("Intermission", GameConfig.IntermissionTime, `Waiting for {minPlayers()} players`)
			elseif
				newcomerWaiting
				and endsAt - os.clock() > GameConfig.NewcomerRoundIn
				-- never cut a Thief Moon short (it runs out the intermission)
				and not ReplicatedStorage:GetAttribute("Raid")
				and ReplicatedStorage:GetAttribute("NextRaidAt") == nil
			then
				newcomerWaiting = false
				endsAt = os.clock() + GameConfig.NewcomerRoundIn
				setPhase("Intermission", GameConfig.NewcomerRoundIn, INTERMISSION_STATUS)
			elseif ReplicatedStorage:GetAttribute("Status") ~= INTERMISSION_STATUS then
				setPhase("Intermission", endsAt - os.clock(), INTERMISSION_STATUS)
			end
		end

		newcomerWaiting = false -- they'll be in this round anyway
		local participants = eligiblePlayers()
		if #participants < minPlayers() then
			continue
		end

		startRound(participants)
		local round = current :: Round
		setPhase("Round", GameConfig.RoundTime, "Survive!")
		local roundEnds = os.clock() + GameConfig.RoundTime
		local nextDread = 0
		while os.clock() < roundEnds and not roundOver(round) do
			task.wait(0.1)
			stepBots(round)
			if os.clock() >= nextDread then
				nextDread = os.clock() + 0.4
				updateDread(round)
			end
		end
		endRound(round)
		task.wait(GameConfig.ResultsTime)
	end
end

-- Studio "Bot Round" buttons: start a round now with bots filling in, `role` = the side the
-- asking player plays ("Murderer" | "Innocent")
function RoundService.DebugBotRound(player: Player, role: string)
	botPlan = { Player = player, Role = if role == "Innocent" then "Innocent" else "Murderer" }
	ReplicatedStorage:SetAttribute("DebugMinPlayers", 1)
	ReplicatedStorage:SetAttribute("DebugSkip", true)
end

function RoundService.Init()
	-- First visit (no tutorial yet, barely played): flag them for the client's round explainer and
	-- pull the next round in a little (see newcomerWaiting)
	DataService.PlayerLoaded:Connect(function(player: Player, profile: DataService.Profile)
		if not profile.TutorialDone and profile.PlayTime < 120 then
			player:SetAttribute("FirstVisit", true)
			newcomerWaiting = true
		end
	end)
	task.spawn(function()
		while true do
			publishChances()
			task.wait(2)
		end
	end)
	-- Flash blinds a Murderer bot too
	PowerService.OnFlash(function(_flasher, origin, look, range, duration, burst)
		local round = current
		local bot = round and round.MurdererBot
		if bot and bot.Alive then
			local offset = bot.Root.Position - origin
			if offset.Magnitude < range and (offset.Magnitude <= burst or look:Dot(offset.Unit) > 0.57) then
				bot.StunnedUntil = workspace:GetServerTimeNow() + duration
				Net.Animate(bot.Model, "Hurt")
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		local round = current
		if round and round.Alive[player] then
			round.Alive[player] = nil
			ReplicatedStorage:SetAttribute("Alive", aliveCount(round))
			-- Don't let the Revolver leave with them
			local root = rootOf(player)
			if round.Gunner == player then
				dropRevolver(round, if root then root.Position else MapService.RoundCenter + Vector3.new(0, 3, 0))
			end
		end
	end)
	Net.Remotes.Ability.OnServerEvent:Connect(onAbility)
	Net.Remotes.Shoot.OnServerEvent:Connect(onShoot)
	Net.Remotes.Stab.OnServerEvent:Connect(function(player: Player, target: any)
		local round = current
		local mine = round and killerRound(round, player)
		if mine and typeof(target) == "Instance" and target:IsA("Model") then
			mine.StabHint = { Target = target, At = os.clock() }
		end
	end)
	task.spawn(loop)
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">ServerEvents</string>
            <string name="Source"><![CDATA[--!strict
-- Things the whole server does together. Two kinds, both dead simple on screen:
--
--   🤝 Server goal: one shared bar ("Steal 25 knives together"). Every player's steals / survivals
--      fill it; when it's full, a reward event starts for EVERYONE.
--   ⚡ Events: short boosts anyone can set off, by filling a goal or by doing something big:
--        LuckyRush  - 2x power-roll luck            (steal goal filled)
--        CashRush   - 2x vault income               (survive goal filled)
--        HeatWave   - Heat gains doubled            (someone hits max Heat)
--        CosmicRush - deep bosses restock fast       (someone steals from the last boss)
--      plus a Murderer wipe calling the Thief Moon early (RaidService hooks OnWipe).
--
-- State lives on ReplicatedStorage so the HUD and events board just read it:
--   GoalKind, GoalProgress, GoalNeed, GoalReward   and   Event_<Name> = server time it ends.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(script.Parent.Parent.Remotes)

local ServerEvents = {}

export type EventSpec = { Name: string, Title: string, Emoji: string, Seconds: number, Color: Color3, What: string }

ServerEvents.Events = {
	LuckyRush = {
		Name = "LuckyRush",
		Title = "LUCKY RUSH",
		Emoji = "🍀",
		Seconds = 300,
		Color = Color3.fromRGB(110, 255, 120),
		What = "2x power luck for everyone",
	},
	CashRush = {
		Name = "CashRush",
		Title = "CASH RUSH",
		Emoji = "💸",
		Seconds = 180,
		Color = Color3.fromRGB(255, 220, 80),
		What = "2x vault cash for everyone",
	},
	HeatWave = {
		Name = "HeatWave",
		Title = "HEAT WAVE",
		Emoji = "🔥",
		Seconds = 180,
		Color = Color3.fromRGB(255, 120, 50),
		What = "Heat gains doubled for everyone",
	},
	CosmicRush = {
		Name = "CosmicRush",
		Title = "COSMIC RUSH",
		Emoji = "🪐",
		Seconds = 180,
		Color = Color3.fromRGB(190, 120, 255),
		What = "Deep bosses restock super fast",
	},
} :: { [string]: EventSpec }

-- The goals cycle; the size grows with the number of players so it always takes teamwork
local GOALS = {
	{ Kind = "Steals", Text = "Steal %d knives together", Reward = "LuckyRush", Base = 10, PerPlayer = 3 },
	{ Kind = "Survives", Text = "Survive %d rounds together", Reward = "CashRush", Base = 4, PerPlayer = 1 },
}
local goalIndex = 0

-- Set by RaidService: a Murderer wiped every innocent, so the Thief Moon rises early
ServerEvents.OnWipe = nil :: ((string) -> ())?

function ServerEvents.Active(name: string): boolean
	local ends = ReplicatedStorage:GetAttribute(`Event_{name}`)
	return type(ends) == "number" and workspace:GetServerTimeNow() < ends
end

-- Starts (or extends) an event for everyone; `by` is who set it off, for the shout-out
function ServerEvents.Start(name: string, by: string?)
	local spec = ServerEvents.Events[name]
	if not spec then
		return
	end
	local now = workspace:GetServerTimeNow()
	local current = ReplicatedStorage:GetAttribute(`Event_{name}`)
	local from = if type(current) == "number" and current > now then current else now
	ReplicatedStorage:SetAttribute(`Event_{name}`, from + spec.Seconds)
	Net.Announce(`{spec.Emoji} {spec.Title}! {spec.What}{if by then ` (thanks {by}!)` else ""}`, spec.Color, 3)
end

local function nextGoal()
	goalIndex = goalIndex % #GOALS + 1
	local goal = GOALS[goalIndex]
	local need = goal.Base + goal.PerPlayer * #Players:GetPlayers()
	ReplicatedStorage:SetAttribute("GoalKind", goal.Kind)
	ReplicatedStorage:SetAttribute("GoalText", string.format(goal.Text, need))
	ReplicatedStorage:SetAttribute("GoalReward", goal.Reward)
	ReplicatedStorage:SetAttribute("GoalNeed", need)
	ReplicatedStorage:SetAttribute("GoalProgress", 0)
end

-- Someone did a thing that counts toward the current goal
function ServerEvents.Progress(kind: string, amount: number?)
	if ReplicatedStorage:GetAttribute("GoalKind") ~= kind then
		return
	end
	local progress = ((ReplicatedStorage:GetAttribute("GoalProgress") or 0) :: number) + (amount or 1)
	local need = (ReplicatedStorage:GetAttribute("GoalNeed") or 1) :: number
	if progress >= need then
		ServerEvents.Start(ReplicatedStorage:GetAttribute("GoalReward") :: string, "everyone")
		nextGoal()
	else
		ReplicatedStorage:SetAttribute("GoalProgress", progress)
	end
end

function ServerEvents.Wipe(murdererName: string)
	if ServerEvents.OnWipe then
		ServerEvents.OnWipe(murdererName)
	end
end

function ServerEvents.Init()
	nextGoal()
end

return ServerEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">ShopNPCs</string>
            <string name="Source"><![CDATA[--!strict
-- The plaza's shopkeepers. Instead of a Shop button, you walk up and talk to someone:
--   Mortimer, the Knife Merchant: sealed knife cases (the Case Shop) and Health upgrades
--   Madame Vesper, the Mystic: Innocent Powers (buy, upgrade, equip)
-- Each stands at a little stall with a glowing ring on the floor in front: step onto it and the
-- client opens that shop panel (ShopRing tag, ShopPanel attribute); step off and it closes. Purchases still go
-- through the usual server remotes, so standing here grants nothing by itself.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Props = require(ReplicatedStorage.Shared.Props)
local Toy = require(ReplicatedStorage.Shared.Toy)
local Disguises = require(script.Parent.Disguises)
local CharacterFaces = require(script.Parent.CharacterFaces)
local CharacterDetails = require(script.Parent.CharacterDetails)

local ShopNPCs = {}

type Spec = {
	Name: string,
	Title: string,
	Panel: string, -- the client panel the Talk prompt opens
	Position: Vector3,
	Facing: number, -- yaw in degrees
	Color: Color3, -- stall canopy / sign
	Skin: Color3,
	Coat: Color3,
	Pants: Color3,
	Wear: { Disguises.Wear },
	Lines: { string }, -- greetings (the client picks one)
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local SPECS: { Spec } = {
	{
		Name = "Mortimer",
		Title = "Knife Merchant",
		Panel = "Shop",
		-- The two stalls stand either side of the runway entrance, facing the plaza
		Position = Vector3.new(-45, 0, -26),
		-- Turned in at an angle (front = local -Z): the two stalls' lines of sight cross like an X
		-- across the entrance
		Facing = -50,
		Color = rgb(70, 200, 90),
		Skin = rgb(234, 184, 146),
		Coat = rgb(70, 30, 40),
		Pants = rgb(30, 26, 30),
		Wear = { { Prop = "TopHat", Color = rgb(25, 22, 28) } },
		Lines = {
			"Fresh cases, sealed tight! What'll it be?",
			"Every case has a knife inside... maybe a Rainbow one!",
			"Getting hurt out there? I sell Health too.",
			"Mutations, sizes, Godly blades... step right up!",
		},
	},
	{
		Name = "Madame Vesper",
		Title = "Power Mystic",
		Panel = "Powers",
		Position = Vector3.new(45, 0, -26), -- across the entrance from Mortimer
		Facing = 50,
		Color = rgb(170, 90, 255),
		Skin = rgb(204, 142, 105),
		Coat = rgb(70, 40, 120),
		Pants = rgb(40, 24, 70),
		Wear = { { Prop = "HairLong", Color = rgb(30, 20, 40) }, { Prop = "RoundGlasses", Color = rgb(200, 160, 70) } },
		Lines = {
			"The spirits whisper... you need a power.",
			"Vanish, Flash, Shield... the Murderer fears them all.",
			"Coins in the round fuel your powers, child.",
			"Equip your powers wisely. The night is long.",
		},
	},
}

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- The stall: a counter in front of the shopkeeper, posts, a striped canopy, a hanging sign, and
-- wares on the counter (knives for the merchant, a crystal ball for the mystic)
local function buildStall(folder: Instance, spec: Spec, frame: CFrame)
	local wood = rgb(110, 72, 44)
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end
	-- Local -Z is the front (where customers stand). Toy-style: studded wood, a striped awning
	local counter = block(folder, "Counter", Vector3.new(10, 3.4, 2.4), at(0, 1.7, -3), wood)
	Toy.Dress(counter, Toy.Sides, 1, 0)
	block(folder, "CounterTop", Vector3.new(10.6, 0.4, 3), at(0, 3.6, -3), wood:Lerp(Color3.new(0, 0, 0), 0.3))
	block(folder, "KeeperStep", Vector3.new(7, 0.45, 2.4), at(0, 0.225, 0.2), wood)
	for _, x in { -5, 5 } do
		for _, z in { -4, 2.5 } do
			block(folder, "Post", Vector3.new(0.6, 10, 0.6), at(x, 5, z), wood)
		end
	end
	-- Striped awning, tilted towards the customers
	for i = 0, 5 do
		local stripe = block(
			folder,
			"Canopy",
			Vector3.new(11 / 6, 0.6, 8.4),
			at(-5.5 + 11 / 12 + i * 11 / 6, 10.2, -0.8) * CFrame.Angles(math.rad(-10), 0, 0),
			if i % 2 == 0 then spec.Color else Color3.fromRGB(245, 245, 245)
		)
		stripe.CanCollide = false
		Toy.Dress(stripe, { Enum.NormalId.Top }, 1, 0)
	end
	-- A soft glowing ring on the floor in front: "stand here"
	local ring = block(
		folder,
		"GlowRing",
		Vector3.new(0.1, 9, 9),
		at(0, 0.25, -8.8) * CFrame.Angles(0, 0, math.rad(90)),
		spec.Color:Lerp(Color3.new(1, 1, 1), 0.3),
		Enum.Material.Neon
	)
	ring.Shape = Enum.PartType.Cylinder
	ring.Transparency = 0.55
	ring.CanCollide = false
	ring.CanQuery = false
	-- Standing on the ring opens the shop (client/Menus); walking off closes it
	ring:SetAttribute("ShopPanel", spec.Panel)
	ring:AddTag("ShopRing")
	-- One clean title floating over the stall (white fading into the stall's colour)
	local anchor = block(folder, "TitleAnchor", Vector3.one * 0.2, at(0, 12.5, -1), spec.Color)
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(280, 54)
	gui:SetAttribute("LabelCategory", "Shop")
	gui:AddTag("ResponsiveWorldLabel")
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Brightness = 0.85 -- full-bright signs, a touch softer than pure white
	gui.Adornee = anchor
	gui.Parent = anchor
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = spec.Title
	text.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), spec.Color:Lerp(Color3.new(1, 1, 1), 0.35))
	gradient.Parent = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = spec.Color:Lerp(Color3.new(0, 0, 0), 0.65)
	stroke.Parent = text
	-- Wares
	if spec.Panel == "Shop" then
		local casePositions = { -3.5, -1.8, 3.3 } -- leave the merchant's face clear in the middle
		for i, rarity in { "Common", "Epic", "Godly" } do
			local case = KnifeModel.BuildCase(rarity, true)
			case:ScaleTo(0.5)
			case:PivotTo(at(casePositions[i], 4.4, -3) * CFrame.Angles(0, math.rad(180 + (i - 2) * 15), 0))
			for _, d in case:GetDescendants() do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
				end
			end
			case.Parent = folder
		end
		-- Knives displayed on a board behind the merchant
		block(folder, "KnifeBoard", Vector3.new(8, 4.5, 0.4), at(0, 6, 2.3), wood, Enum.Material.WoodPlanks)
		for i, name in { "KitchenKnife", "Katana", "InfernoFang", "VoidEdge" } do
			local knife = KnifeModel.Build(name, true)
			KnifeModel.FitLength(knife, 2.6)
			knife:PivotTo(at(-3 + (i - 1) * 2, 6, 2) * CFrame.Angles(0, math.pi, math.rad(15)))
			for _, d in knife:GetDescendants() do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
				end
			end
			knife.Parent = folder
		end
	else
		-- A glowing crystal ball on a stand, candles, floating sparkles
		block(folder, "BallStand", Vector3.new(1, 0.6, 1), at(-2.4, 4.1, -3), rgb(200, 160, 70), Enum.Material.Metal)
		local ball =
			block(folder, "CrystalBall", Vector3.one * 1.6, at(-2.4, 5.05, -3), spec.Color, Enum.Material.Glass)
		ball.Shape = Enum.PartType.Ball
		ball.Transparency = 0.25
		ball.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = spec.Color
		light.Range = 18
		light.Brightness = 2.5
		light.Parent = ball
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkles.Color = ColorSequence.new(spec.Color, Color3.new(1, 1, 1))
		sparkles.LightEmission = 1
		sparkles.Size = NumberSequence.new(0.3, 0)
		sparkles.Lifetime = NumberRange.new(1, 2)
		sparkles.Rate = 12
		sparkles.Speed = NumberRange.new(0.5, 1.5)
		sparkles.Parent = ball
		for _, x in { -3.6, 3.6 } do
			block(folder, "Candle", Vector3.new(0.4, 1, 0.4), at(x, 4.3, -3), rgb(245, 238, 220))
			local flame =
				block(folder, "Flame", Vector3.new(0.3, 0.45, 0.3), at(x, 5, -3), rgb(255, 190, 90), Enum.Material.Neon)
			flame.CanCollide = false
			flame:AddTag("Flicker")
		end
		local crystal = Props.Build("Crystal", true)
		crystal:ScaleTo(1.4)
		crystal:PivotTo(at(-4.2, 0, 1.5))
		crystal.Parent = folder
	end
end

local function buildKeeper(folder: Instance, spec: Spec, frame: CFrame)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = spec.Skin
	description.TorsoColor = spec.Coat
	description.LeftArmColor = spec.Coat
	description.RightArmColor = spec.Coat
	description.LeftLegColor = spec.Pants
	description.RightLegColor = spec.Pants
	local rig = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	rig.Name = spec.Name
	rig.ModelStreamingMode = Enum.ModelStreamingMode.Atomic -- streams in whole, never half a body
	local humanoid = rig:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = spec.Name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.EvaluateStateMachine = false
	for _, d in rig:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	rig.PrimaryPart = root
	local height = humanoid.HipHeight + root.Size.Y / 2
	-- Stands behind the counter (local +Z), facing the customers (-Z)
	rig:PivotTo(frame * CFrame.new(0, height + 0.45, 0.2))
	local head = rig:FindFirstChild("Head") :: BasePart
	head = CharacterFaces.Apply(
		head,
		if spec.Panel == "Shop" then "rbxassetid://93391310013128" else "rbxassetid://137483136763270"
	)
	Disguises.AddAccessories(head, spec.Wear)
	CharacterDetails.Apply(rig, spec.Name)
	rig:AddTag("ShopNPC") -- clients fidget them (Moves) on top of the idle animation
	rig.Parent = folder
	local animator: Animator = humanoid:FindFirstChildOfClass("Animator")
		or (function()
			local created = Instance.new("Animator")
			created.Parent = humanoid
			return created
		end)()
	local idle = Instance.new("Animation")
	idle.AnimationId = "rbxassetid://507766388" -- Roblox's standard R15 idle (guards use it too)
	local ok, track = pcall(animator.LoadAnimation, animator, idle)
	if ok then
		track.Looped = true
		track:Play()
	end
end

function ShopNPCs.Init()
	local map = workspace:FindFirstChild("Map")
	local folder = Instance.new("Folder")
	folder.Name = "Shops"
	folder.Parent = map or workspace
	for _, spec in SPECS do
		local frame = CFrame.new(spec.Position) * CFrame.Angles(0, math.rad(spec.Facing), 0)
		local stall = Instance.new("Model")
		stall.Name = `{spec.Name}Stall`
		stall.Parent = folder
		buildStall(stall, spec, frame)
		buildKeeper(stall, spec, frame)
	end
end

return ShopNPCs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Social</string>
            <string name="Source"><![CDATA[--!strict
-- Playing together, kept simple:
--   👥 Friends bonus: every friend (or your teammate) in the server = +10% cash and power luck,
--      up to +30%. Player attribute FriendsHere (0-3). The Invite button is on the client.
--   🤝 Team up: pick one other player as your teammate (invite -> accept). Teammates see each other
--      outlined, share team-steal credit, count as a friend for the bonus, and in Double Trouble
--      rounds they're picked together: both Murderers, or both Sheriffs. Player attribute Partner
--      (the other's UserId). Remote TeamUp: ("Invite", userId) / ("Accept", userId) /
--      ("Decline", userId) / ("Leave").

local Players = game:GetService("Players")

local Net = require(script.Parent.Parent.Remotes)

local Social = {}

local friendCache: { [string]: boolean } = {}
local invites: { [Player]: { [number]: number } } = {} -- target -> inviter UserId -> when
local lastRequest: { [Player]: number } = {}

local function pairKey(a: Player, b: Player): string
	return if a.UserId < b.UserId then `{a.UserId}:{b.UserId}` else `{b.UserId}:{a.UserId}`
end

local function areFriends(a: Player, b: Player): boolean
	local key = pairKey(a, b)
	local cached = friendCache[key]
	if cached == nil then
		local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
		cached = ok and result == true
		friendCache[key] = cached
	end
	return cached :: boolean
end

function Social.PartnerOf(player: Player): Player?
	local id = player:GetAttribute("Partner")
	if type(id) ~= "number" then
		return nil
	end
	local other = Players:GetPlayerByUserId(id)
	if other and other:GetAttribute("Partner") == player.UserId then
		return other
	end
	return nil
end

local function refreshFriends()
	local all = Players:GetPlayers()
	for _, player in all do
		local count = 0
		for _, other in all do
			if other ~= player and (areFriends(player, other) or Social.PartnerOf(player) == other) then
				count += 1
			end
		end
		player:SetAttribute("FriendsHere", math.min(count, 3))
	end
end

-- +10% per friend here (max 3)
function Social.FriendsMultiplier(player: Player): number
	return 1 + ((player:GetAttribute("FriendsHere") or 0) :: number) * 0.1
end

local function setPartner(a: Player, b: Player?)
	local old = Social.PartnerOf(a)
	if old then
		old:SetAttribute("Partner", nil)
		Net.Notify(old, `{a.DisplayName} left your team.`, "info")
	end
	a:SetAttribute("Partner", if b then b.UserId else nil)
	if b then
		local theirs = Social.PartnerOf(b)
		if theirs and theirs ~= a then
			theirs:SetAttribute("Partner", nil)
		end
		b:SetAttribute("Partner", a.UserId)
	end
	refreshFriends()
end

local function onTeamUp(player: Player, action: unknown, userId: unknown)
	local now = os.clock()
	if now - (lastRequest[player] or 0) < 0.5 then
		return
	end
	lastRequest[player] = now
	if action == "Leave" then
		if Social.PartnerOf(player) then
			setPartner(player, nil)
			Net.Notify(player, "You left your team.", "info")
		end
		return
	end
	if type(userId) ~= "number" then
		return
	end
	local other = Players:GetPlayerByUserId(userId)
	if not other or other == player then
		return
	end
	if action == "Invite" then
		local pending = invites[other] or {}
		pending[player.UserId] = now
		invites[other] = pending
		Net.Remotes.Effect:FireClient(other, "TeamInvite", player.UserId, player.DisplayName)
		Net.Notify(player, `Team invite sent to {other.DisplayName}!`, "info")
	elseif action == "Accept" then
		local mine = invites[player]
		local sent = mine and mine[other.UserId]
		if not sent or now - sent > 60 then
			Net.Notify(player, "That invite expired.", "bad")
			return
		end
		if mine then
			mine[other.UserId] = nil
		end
		setPartner(player, other)
		Net.Notify(player, `🤝 You teamed up with {other.DisplayName}!`, "good")
		Net.Notify(other, `🤝 {player.DisplayName} teamed up with you!`, "good")
	elseif action == "Decline" then
		local mine = invites[player]
		if mine then
			mine[other.UserId] = nil
		end
		Net.Notify(other, `{player.DisplayName} said no thanks.`, "info")
	end
end

function Social.Init()
	Net.Remotes.TeamUp.OnServerEvent:Connect(onTeamUp)
	Players.PlayerAdded:Connect(function()
		task.defer(refreshFriends)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local partner = Social.PartnerOf(player)
		if partner then
			partner:SetAttribute("Partner", nil)
			Net.Notify(partner, `{player.DisplayName} left, so your team ended.`, "info")
		end
		invites[player] = nil
		lastRequest[player] = nil
		task.defer(refreshFriends)
	end)
	refreshFriends()
end

return Social
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--!strict
-- Loot and carrying. Watchmen drop sealed cases when they die; dropped cases and knives float
-- with a tag and a light beam. Hold the prompt to pick one up and carry it over your head back to
-- your vault (picking up alerts the guards). Cases open when you get home: a reveal rolls the
-- knife inside, its mutation and its size (Items.OpenCase). Knives stolen from other players'
-- vaults in a raid remember who they belong to - if the thief drops one, its owner can grab it
-- straight back onto their wall. If a carrier dies or gets knocked down, what they carried drops.
-- The server checks distance, state and rack space, and decides deposits from where it sees the
-- character.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local Fuel = require(script.Parent.Fuel)
local ServerEvents = require(script.Parent.ServerEvents)
local Social = require(script.Parent.Social)
local MapService = require(script.Parent.MapService)
local Offers = require(script.Parent.Offers)

type Carry = {
	Kind: string, -- "Case" | "Knife"
	Item: string, -- the case's rarity, or the knife item
	StolenFrom: number?, -- UserId of the vault it was stolen from
	Boss: { Zone: number, Slot: number }?,
	Helpers: { Player }, -- players who helped with a boss steal (team steal) -- taken off a biome boss's wall (GuardService)
	Visual: Model,
	LastPos: Vector3,
	LastCheck: number,
	Plate: number?, -- the plate the owner chose to put it on (Place)
}

local StealService = {}

-- Set by GuardService: (player, zoneIndex) when someone picks something up in the arena
StealService.OnPickup = nil :: ((Player, number) -> ())?
-- Set by GuardService: a knife taken off a boss's wall left the thief's hands. delivered = it made it
-- home (the slot restocks later); otherwise it goes straight back on the wall.
StealService.OnBossCarryEnded = nil :: ((zone: number, slot: number, item: string, delivered: boolean) -> ())?

local carriers: { [Player]: Carry } = {}
local dropFolder: Folder
local rng = Random.new()

local function rootPart(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function zoneIndexAt(position: Vector3): number?
	for _, zone in MapService.Zones do
		if MapService.InBounds(zone.Bounds, position) then
			return zone.Index
		end
	end
	return nil
end

-- The floating tag over a drop: a few lines of coloured text
local function tag(adornee: BasePart, lines: { { Text: string, Color: Color3, Height: number } })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(240, 0)
	for _, line in lines do
		gui.Size += UDim2.fromOffset(0, line.Height)
	end
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 120
	gui.AlwaysOnTop = true
	gui.Adornee = adornee
	gui.Parent = adornee
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	for i, line in lines do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.Size = UDim2.new(1, 0, 0, line.Height)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.TextStrokeTransparency = 0.2
		label.Text = line.Text
		label.Parent = gui
	end
end

local function ownerName(userId: number?): string?
	if not userId then
		return nil
	end
	local owner = Players:GetPlayerByUserId(userId)
	return if owner then owner.DisplayName else nil
end

local revealPower: (Player, string) -> ()
local startCarry: (Player, string, string, number?, { Zone: number, Slot: number }?) -> ()

-- Somewhere on the floor under `position`, ignoring bodies, players and other drops
local function floorAt(position: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { dropFolder }
	local map = dropFolder.Parent
	local guardsFolder = map and map:FindFirstChild("Guards")
	if guardsFolder then
		table.insert(ignore, guardsFolder)
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	params.FilterDescendantsInstances = ignore
	local ground = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -20, 0), params)
	return if ground then ground.Position.Y else position.Y - 3
end

-- The glow, light pillar and pickup prompt every drop gets
local function dress(model: Model, color: Color3, floorY: number, at: Vector3, objectText: string): ProximityPrompt
	model:AddTag("Spin")
	local highlight = Instance.new("Highlight")
	highlight.FillColor = color
	highlight.FillTransparency = 0.7
	highlight.OutlineColor = color
	highlight.Parent = model
	-- A light pillar so drops are easy to spot across the arena at night
	local pillar = Instance.new("Part")
	pillar.Name = "Beam"
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.6
	pillar.Size = Vector3.new(0.6, 30, 0.6)
	pillar.CFrame = CFrame.new(Vector3.new(at.X, floorY + 15, at.Z))
	pillar.Parent = model
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 14
	light.Brightness = 2
	light.Parent = pillar
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take"
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = model.PrimaryPart
	return prompt
end

-- Common checks before anyone picks something up
local function canPickUp(player: Player, anchor: BasePart, prompt: ProximityPrompt): boolean
	local root = rootPart(player)
	local profile = DataService.Get(player)
	if not root or not profile or player:GetAttribute("InRound") or carriers[player] then
		return false
	end
	if player:GetAttribute("KnockedUntil") then
		return false
	end
	if (root.Position - anchor.Position).Magnitude > prompt.MaxActivationDistance + 6 then
		return false -- fired from too far away: exploit or lag, ignore either way
	end
	if not BaseService.GetBase(player) then
		Net.Notify(player, "No free vault on this server, you can't store knives.", "bad")
		return false
	end
	if #profile.Knives >= profile.Slots then
		Net.Notify(player, "Your vault wall is full! Sell a knife or buy another mount.", "bad")
		Offers.Show(player, "Mount", "Your wall is full! Add another mount instantly.")
		return false
	end
	return true
end

-- Puts a knife item on the floor: glowing, tagged, spinning, and gone after a while.
-- `stolenFrom` marks a knife lifted from someone's vault: its owner can take it straight back.
function StealService.DropKnife(item: string, position: Vector3, stolenFrom: number?)
	local parsed = Items.Parse(item)
	if not parsed then
		return
	end
	local floorY = floorAt(position)
	local at = Vector3.new(position.X, floorY + 2.2, position.Z)
	local model = KnifeModel.Build(item, true)
	KnifeModel.FitItem(model, item, 3.2)
	model:PivotTo(CFrame.new(at) * CFrame.Angles(0, 0, math.rad(20)))
	model.Name = `Dropped_{parsed.Name}`
	local color = Items.Color(item)
	local knife = parsed.Knife
	local anchor = model.PrimaryPart :: BasePart
	local victim = ownerName(stolenFrom)
	local lines = {
		{ Text = Items.DisplayName(item), Color = color, Height = 30 },
		{ Text = knife.Rarity:upper(), Color = Knives.RarityColors[knife.Rarity], Height = 18 },
		{
			Text = `Damage {Items.Damage(item)}  ·  {Format.Cash(Items.Income(item))}/s`,
			Color = Color3.new(1, 1, 1),
			Height = 22,
		},
	}
	if victim then
		table.insert(lines, { Text = `Stolen from {victim}!`, Color = Color3.fromRGB(255, 120, 120), Height = 18 })
	end
	tag(anchor, lines)
	local prompt = dress(model, color, floorY, at, Items.DisplayName(item))
	prompt.Triggered:Connect(function(player)
		if not model.Parent then
			return
		end
		-- The owner takes their own knife straight back
		if stolenFrom and player.UserId == stolenFrom then
			local profile = DataService.Get(player)
			local root = rootPart(player)
			if profile and root and (root.Position - anchor.Position).Magnitude < prompt.MaxActivationDistance + 6 then
				if #profile.Knives < profile.Slots then
					model:Destroy()
					DataService.Update(player, function(p)
						DataService.AddKnife(p, item)
					end)
					BaseService.RefreshRack(player)
					Net.Notify(player, `Got your {Items.DisplayName(item)} back!`, "good")
					Net.Remotes.Effect:FireAllClients("Recovered", root.Position, color)
					return
				end
			end
		end
		if not canPickUp(player, anchor, prompt) then
			return
		end
		model:Destroy()
		startCarry(player, "Knife", item, if stolenFrom and player.UserId ~= stolenFrom then stolenFrom else nil)
		local zone = zoneIndexAt(at)
		if zone and StealService.OnPickup then
			StealService.OnPickup(player, zone)
		end
	end)
	model.Parent = dropFolder
	task.delay(if stolenFrom then GameConfig.DroppedKnifeLifetime * 2 else GameConfig.DroppedKnifeLifetime, function()
		if model.Parent then
			model:Destroy()
			-- A stolen knife nobody picked up goes home rather than vanishing
			local owner = stolenFrom and Players:GetPlayerByUserId(stolenFrom)
			local profile = owner and DataService.Get(owner)
			if owner and profile and #profile.Knives < profile.Slots then
				DataService.Update(owner, function(p)
					DataService.AddKnife(p, item)
				end)
				BaseService.RefreshRack(owner)
				Net.Notify(owner, `Your {Items.DisplayName(item)} found its way home.`, "good")
			end
		end
	end)
end

-- A sealed case on the floor (what watchmen drop)
function StealService.DropCase(rarity: string, position: Vector3)
	local color = Knives.RarityColors[rarity]
	if not color then
		return
	end
	local floorY = floorAt(position)
	local at = Vector3.new(position.X, floorY + 1.8, position.Z)
	local model = KnifeModel.BuildCase(rarity, true)
	model:PivotTo(CFrame.new(at))
	local anchor = model.PrimaryPart :: BasePart
	tag(anchor, {
		{ Text = `{rarity:upper()} CASE`, Color = color, Height = 30 },
		{ Text = "Sealed · open it at your vault", Color = Color3.fromRGB(230, 230, 240), Height = 18 },
		{ Text = "Mutation? Size? Find out!", Color = Color3.fromRGB(255, 220, 120), Height = 16 },
	})
	local prompt = dress(model, color, floorY, at, `{rarity} Case`)
	prompt.Triggered:Connect(function(player)
		if not model.Parent or not canPickUp(player, anchor, prompt) then
			return
		end
		model:Destroy()
		startCarry(player, "Case", rarity, nil)
		local zone = zoneIndexAt(at)
		if zone and StealService.OnPickup then
			StealService.OnPickup(player, zone)
		end
	end)
	model.Parent = dropFolder
	task.delay(GameConfig.DroppedKnifeLifetime, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

-- Ends a carry. deposited = made it home; otherwise it drops where they are
local function endCarry(player: Player, deposited: boolean, dropAt: Vector3?)
	local carry = carriers[player]
	if not carry then
		return
	end
	carriers[player] = nil
	player:SetAttribute("PlaceReady", nil)
	local visual = carry.Visual
	local fallback = visual.PrimaryPart and (visual.PrimaryPart :: BasePart).Position
	visual:Destroy()
	player:SetAttribute("Carrying", nil)
	player:SetAttribute("StolenFrom", nil)
	BaseService.RefreshWalkSpeed(player)
	local where = dropAt or fallback
	if carry.Boss then
		-- Boss knives never lie around: they go back on the wall (or count as delivered)
		local hook = StealService.OnBossCarryEnded
		if hook then
			hook(carry.Boss.Zone, carry.Boss.Slot, carry.Item, deposited)
		end
		return
	end
	if not deposited and where then
		if carry.Kind == "Case" then
			StealService.DropCase(carry.Item, where)
		else
			StealService.DropKnife(carry.Item, where, carry.StolenFrom)
		end
	end
end

-- Lifts something over a player's head: kind "Case" (item = rarity) or "Knife" (item string)
startCarry = function(
	player: Player,
	kind: string,
	item: string,
	stolenFrom: number?,
	boss: { Zone: number, Slot: number }?
)
	local character = player.Character :: Model
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = rootPart(player)
	if not head or not root then
		return
	end

	-- Held up like a trophy: lying across both raised hands, centred over the head, so everyone
	-- can see who has what (the arms come from the Carry pose in AnimLibrary)
	local visual: Model
	local above: CFrame
	if kind == "Case" then
		visual = KnifeModel.BuildCase(item, false)
		above = head.CFrame * CFrame.new(0, 1.9, 0)
		visual:PivotTo(above)
	else
		visual = KnifeModel.Build(item, false)
		KnifeModel.FitItem(visual, item, 3.6)
		above = head.CFrame * CFrame.new(0, 1.05, 0) -- resting on the raised hands
		-- Blade along the shoulders (pointing left), edge facing forward
		visual:PivotTo(above * CFrame.Angles(0, 0, math.rad(90)))
	end
	for _, p in visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Massless = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Anchored = false
		end
	end
	local box = visual:GetBoundingBox()
	local off = above:PointToObjectSpace(box.Position)
	visual:PivotTo(CFrame.new(above:VectorToWorldSpace(Vector3.new(-off.X, 0, -off.Z))) * visual:GetPivot())
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = visual.PrimaryPart :: BasePart
	weld.Parent = visual
	visual.Parent = character

	-- Team steal: anyone close by when you grab a boss's knife (and your teammate, wherever they are)
	local helpers: { Player } = {}
	if boss then
		for _, other in Players:GetPlayers() do
			local otherRoot = if other ~= player then rootPart(other) else nil
			if
				otherRoot
				and not other:GetAttribute("InRound")
				and ((otherRoot.Position - root.Position).Magnitude < 35 or Social.PartnerOf(player) == other)
			then
				table.insert(helpers, other)
			end
		end
	end
	carriers[player] = {
		Helpers = helpers,
		Kind = kind,
		Item = item,
		StolenFrom = stolenFrom,
		Boss = boss,
		Visual = visual,
		LastPos = root.Position,
		LastCheck = os.clock(),
	}
	Net.Animate(character, "Pickup")
	player:SetAttribute("Carrying", if kind == "Case" then `Case:{item}` else item)
	player:SetAttribute("StolenFrom", stolenFrom) -- the UserId it was taken from, if anyone
	BaseService.RefreshWalkSpeed(player)
	if kind == "Case" then
		Net.Notify(player, `You grabbed a {item} Case! Get it home!`, "good")
	elseif boss then
		Net.Notify(player, `You stole a {Items.DisplayName(item)}! RUN home before you're caught!`, "good")
	elseif stolenFrom then
		Net.Notify(player, `You stole a {Items.DisplayName(item)}! Get it home before they catch you!`, "good")
	else
		Net.Notify(player, `You grabbed a {Items.DisplayName(item)}! RUN!`, "good")
	end
end

function StealService.StartCarry(
	player: Player,
	kind: string,
	item: string,
	stolenFrom: number?,
	boss: { Zone: number, Slot: number }?
)
	if carriers[player] then
		return
	end
	startCarry(player, kind, item, stolenFrom, boss)
end

-- A boss caught their thief: the knife goes back on the wall (OnBossCarryEnded, not delivered)
function StealService.ReturnToBoss(player: Player): string?
	local carry = carriers[player]
	if not carry or not carry.Boss then
		return nil
	end
	local item = carry.Item
	endCarry(player, false, nil)
	Fuel.AddHeat(player, -1, "Caught by the boss!")
	Fuel.AddMeter(player, -1)
	return item
end

-- The wall slot a carrier's knife came from, if it's a boss's
function StealService.BossCarry(player: Player): { Zone: number, Slot: number }?
	local carry = carriers[player]
	return carry and carry.Boss
end

-- Rebirths bring better luck in cases
local function caseLuck(profile: DataService.Profile): number
	local luck = 1 + profile.Rebirths * GameConfig.Rebirth.LuckBonus
	-- Someone bought Server Luck: everyone's cases roll better for a while
	local until_ = ReplicatedStorage:GetAttribute("ServerLuckUntil")
	if type(until_) == "number" and workspace:GetServerTimeNow() < until_ then
		luck *= (ReplicatedStorage:GetAttribute("ServerLuckMultiplier") or 2) :: number
	end
	return luck
end

-- Opens a sealed case straight onto a player's wall: the knife, mutation and size are rolled here,
-- the reveal plays on their screen (Effects "Unbox") and the wall updates when it lands. Used for
-- cases carried home, bought in the Case Shop and won from the free chest. nil if the wall is full,
-- unless `force` (a case paid for with Robux always opens; the knife waits in storage).
function StealService.OpenCase(player: Player, rarity: string, force: boolean?): string?
	local profile = DataService.Get(player)
	if not profile or (#profile.Knives >= profile.Slots and not force) then
		return nil
	end
	local rolled, upgraded = Items.OpenCase(rng, rarity, caseLuck(profile))
	local item = Fuel.RollPower(player, rolled)
	local parsed = Items.Parse(item) :: Items.Item
	if parsed.Perk then
		task.delay(3.6, function()
			if player.Parent then
				revealPower(player, item)
			end
		end)
	end
	local isNew = not table.find(profile.Discovered, parsed.Name)
	local hype = Items.Hype(item)
	DataService.Update(player, function(p)
		DataService.AddKnife(p, item)
		if isNew then
			table.insert(p.Discovered, parsed.Name)
		end
		p.CasesOpened += 1
		if p.BestPull == "" or hype > Items.Hype(p.BestPull) then
			p.BestPull = item
		end
	end)
	Net.Remotes.Effect:FireClient(player, "Unbox", rarity, item, upgraded, isNew)
	task.delay(3.6, function()
		if player.Parent then
			BaseService.RefreshRack(player)
			Net.Remotes.Effect:FireAllClients("Deposit", player, parsed.Knife.Rarity)
			if player.Character then
				Net.Animate(player.Character, "Cheer")
			end
		end
	end)
	if hype >= 2 then
		task.delay(3.4, function()
			Net.Announce(`{player.DisplayName} unboxed a {Items.DisplayName(item)}!`, Items.Color(item), hype)
		end)
	end
	return item
end

-- A knife came home with a Murderer power: a big reveal for you, and the whole server hears about
-- the rare ones
revealPower = function(player: Player, item: string)
	local parsed = Items.Parse(item)
	if not parsed or not parsed.Perk then
		return
	end
	local oneIn = Items.PowerOneIn(parsed.Perk)
	Net.Remotes.Effect:FireClient(player, "PowerRoll", item, parsed.Perk, oneIn)
	if oneIn >= 300 then
		local perk = GameConfig.Perks[parsed.Perk]
		Net.Announce(
			`{player.DisplayName} rolled {if perk then perk.DisplayName else parsed.Perk} (1 in {oneIn})!`,
			Color3.fromRGB(255, 90, 140),
			if oneIn >= 1000 then 4 else 3
		)
	end
end

local function deposit(player: Player)
	local carry = carriers[player]
	if not carry then
		return
	end
	local profile = DataService.Get(player)
	if not profile or #profile.Knives >= profile.Slots then
		Net.Notify(player, "Your vault wall is full! Sell a knife to make room.", "bad")
		Offers.Show(player, "Mount", "Your wall is full! Add another mount instantly.")
		endCarry(player, false)
		return
	end
	if carry.Kind == "Case" then
		local rarity = carry.Item
		endCarry(player, true)
		StealService.OpenCase(player, rarity)
		return
	end
	-- Its Murderer power is rolled now, with your luck (Heat, deeper zones, bad-luck protection)
	local item = Fuel.RollPower(player, carry.Item)
	local parsed = Items.Parse(item) :: Items.Item
	local isNew = not table.find(profile.Discovered, parsed.Name)
	if carry.Boss then
		Fuel.AddHeat(player, 1, "Stole from a boss!")
		Fuel.AddMeter(player, 1)
		ServerEvents.Progress("Steals")
		-- 🤝 Whoever helped (near you when you grabbed it, or your teammate) shares the glory
		for _, helper in carry.Helpers do
			if helper.Parent and helper ~= player then
				Fuel.AddHeat(helper, 1, `Team steal with {player.DisplayName}!`)
				Fuel.AddMeter(helper, 1)
			end
		end
		-- The last boss's knife: the deep bosses restock fast for everyone for a while
		if carry.Boss.Zone >= #GameConfig.Zones and not ServerEvents.Active("CosmicRush") then
			ServerEvents.Start("CosmicRush", player.DisplayName)
		end
	end
	if parsed.Perk then
		revealPower(player, item)
	end
	DataService.Update(player, function(p)
		DataService.AddKnife(p, item, carry.Plate)
		if isNew then
			table.insert(p.Discovered, parsed.Name)
		end
		if carry.StolenFrom then
			p.KnivesStolen += 1
		end
	end)
	local stolenFrom = carry.StolenFrom
	endCarry(player, true)
	local name = Items.DisplayName(item)
	BaseService.RefreshRack(player)
	-- One short line (the plate's own label already shows the rest)
	Net.Notify(player, `{if isNew then "NEW! " else ""}{name} +{Format.Cash(Items.Income(item))}/s`, "good")
	Net.Remotes.Effect:FireAllClients("Deposit", player, parsed.Knife.Rarity)
	if stolenFrom then
		local victim = ownerName(stolenFrom) or "someone"
		Net.Announce(`{player.DisplayName} stole {victim}'s {name}!`, Color3.fromRGB(255, 90, 90), 1)
	end
	if player.Character then
		Net.Animate(player.Character, "Cheer")
	end
end

-- Put the carried knife on a plate: any empty, unlocked plate in your own vault. A short
-- animation (the knife flies from your hands onto the plate), then it's mounted.
function StealService.Place(player: Player, slot: number)
	local carry = carriers[player]
	local root = rootPart(player)
	local profile = DataService.Get(player)
	if not carry or carry.Kind ~= "Knife" or not root or not profile then
		return
	end
	if
		not BaseService.IsInOwnBase(player, root.Position)
		or slot < 1
		or slot > profile.Slots
		or DataService.IndexOnPlate(profile, slot) ~= nil
	then
		return
	end
	local base = BaseService.GetBase(player)
	if not base then
		return
	end
	local head = player.Character and player.Character:FindFirstChild("Head") :: BasePart?
	local from = if head then head.Position + Vector3.new(0, 1.2, 0) else root.Position
	-- Hide the one overhead while the copy flies; mount it when it lands
	for _, d in carry.Visual:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = 1
		end
	end
	if player.Character then
		Net.Animate(player.Character, "Pickup")
	end
	carry.Plate = slot
	Net.Remotes.Effect:FireAllClients("PlaceKnife", from, base.SlotCFrames[slot].Position, carry.Item)
	task.delay(0.45, function()
		if carriers[player] == carry then
			deposit(player)
		end
	end)
end

-- Deposits and the carrier speed check run on the server's view of positions
local function tick()
	local now = os.clock()
	for player, carry in carriers do
		local root = rootPart(player)
		if not root then
			-- Died (or the character went away): drop it where they were
			endCarry(player, false, carry.LastPos)
			continue
		end
		local pos = root.Position
		if BaseService.IsInOwnBase(player, pos) then
			if carry.Kind == "Case" then
				deposit(player) -- cases open as soon as you're home
				continue
			end
			-- Knives: you put them on a plate yourself (Tsunami style), StealService.Place
			if not player:GetAttribute("PlaceReady") then
				player:SetAttribute("PlaceReady", true)
				local profile = DataService.Get(player)
				if profile and #profile.Knives >= profile.Slots then
					Net.Notify(player, "Your vault is full! Sell a knife or add a floor to make room.", "bad")
					Offers.Show(player, "Mount", "Your vault is full! Add the next floor instantly.")
				else
					Net.Notify(player, "Walk to the glowing plate and press E to place your knife!", "good")
				end
			end
		elseif player:GetAttribute("PlaceReady") then
			player:SetAttribute("PlaceReady", nil)
		end
		local elapsed = now - carry.LastCheck
		if player:GetAttribute("Tumbling") then
			-- Flung by a hit (Ragdoll.Tumble): that's not cheating, start measuring again after
			carry.LastPos = pos
			carry.LastCheck = now
		elseif elapsed >= 0.5 then
			local humanoid = (player.Character :: Model):FindFirstChildOfClass("Humanoid") :: Humanoid
			local flat = Vector3.new(pos.X - carry.LastPos.X, 0, pos.Z - carry.LastPos.Z).Magnitude
			local allowed = math.max(humanoid.WalkSpeed, GameConfig.BaseWalkSpeed) * elapsed * GameConfig.SpeedTolerance
				+ 3
			if flat > allowed then
				warn(
					`[StealService] {player.Name} moved {math.floor(flat)} studs in {elapsed}s while carrying, dropping it`
				)
				Net.Notify(player, "Whoa, too fast! It slipped out of your hands.", "bad")
				endCarry(player, false, carry.LastPos)
				continue
			end
			carry.LastPos = pos
			carry.LastCheck = now
		end
	end
end

function StealService.GetCarriers(): { [Player]: Carry }
	return carriers
end

function StealService.IsCarrying(player: Player): boolean
	return carriers[player] ~= nil
end

-- Rounds pull everyone out of the arena, knockdowns knock it loose: whatever they carried drops
-- `owner` caught `thief` running off with `owner`'s knife: it goes straight back on their wall
-- (or onto the floor for them to grab if the wall is full). Returns the item, or nil.
function StealService.Recover(thief: Player, owner: Player): string?
	local carry = carriers[thief]
	if not carry or carry.Kind ~= "Knife" or carry.StolenFrom ~= owner.UserId then
		return nil
	end
	local profile = DataService.Get(owner)
	if not profile or #profile.Knives >= profile.Slots then
		return nil
	end
	local item = carry.Item
	endCarry(thief, true, nil)
	DataService.Update(owner, function(p)
		DataService.AddKnife(p, item)
	end)
	BaseService.RefreshRack(owner)
	return item
end

function StealService.ForceDrop(player: Player)
	local root = rootPart(player)
	endCarry(player, false, if root then root.Position else nil)
end

function StealService.Init()
	BaseService.OnPlacePrompt = StealService.Place
	dropFolder = Instance.new("Folder")
	dropFolder.Name = "DroppedKnives"
	dropFolder.Parent = workspace:FindFirstChild("Map")

	Players.PlayerRemoving:Connect(function(player)
		local carry = carriers[player]
		endCarry(player, false, if carry then carry.LastPos else nil)
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			tick()
		end
	end)
end

return StealService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Stealth</string>
            <string name="Source"><![CDATA[--!strict
-- Hiding characters: Vanish (invisible for a while) and the body-hiding half of Mimic. Sets the
-- player attributes guards and the HUD look at ("Invisible", "Mimic"), and puts everything back
-- exactly as it was afterwards - including if it gets cut short.

local Net = require(script.Parent.Parent.Remotes)

local Stealth = {}

local restores: { [Player]: () -> () } = {}

-- Makes the whole character (tools, carried knife, hats) see-through and hides its name tag.
-- Returns the function that undoes it.
function Stealth.Hide(player: Player): (() -> ())?
	local character = player.Character
	if not character then
		return nil
	end
	local saved: { [Instance]: number } = {}
	for _, d in character:GetDescendants() do
		if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
			saved[d] = (d :: any).Transparency;
			(d :: any).Transparency = 1
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	return function()
		for instance, transparency in saved do
			if instance.Parent then
				(instance :: any).Transparency = transparency
			end
		end
		if humanoid and humanoid.Parent then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end
	end
end

-- Invisible for `duration` seconds (or until Reveal). Guards drop you as a target.
function Stealth.Vanish(player: Player, duration: number)
	Stealth.Reveal(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Net.Remotes.Effect:FireAllClients("Smoke", root.Position)
	end
	local undo = Stealth.Hide(player)
	if not undo then
		return
	end
	player:SetAttribute("Invisible", true)
	local function finish()
		if restores[player] == finish then
			restores[player] = nil
			player:SetAttribute("Invisible", nil)
			undo()
		end
	end
	restores[player] = finish
	task.delay(duration, finish)
end

-- Ends any hiding early (hit by the Murderer, used another power, round ended...)
function Stealth.Reveal(player: Player)
	local restore = restores[player]
	if restore then
		restore()
	end
end

-- For other hiding effects (Mimic) that want Reveal to end them too
function Stealth.Register(player: Player, finish: () -> ())
	Stealth.Reveal(player)
	restores[player] = finish
end

function Stealth.Unregister(player: Player, finish: () -> ())
	if restores[player] == finish then
		restores[player] = nil
	end
end

return Stealth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">StuckKnives</string>
            <string name="Source"><![CDATA[--!strict
-- Thrown knives that hit a wall, door or floor stay stuck in it for a while (hub throws, boss
-- throws). Round knives live in the round's own folder instead and stay until the round ends.
-- Capped so a busy server never piles up hundreds of them.

local Debris = game:GetService("Debris")

local StuckKnives = {}

local MAX = 60
local folder: Folder? = nil
local stuck: { Model } = {}

-- Leaves `model` embedded where it hit: point first, a little way into the surface
function StuckKnives.Stick(model: Model, at: Vector3, direction: Vector3, seconds: number, parent: Instance?)
	model:PivotTo(CFrame.lookAt(at, at + direction) * CFrame.Angles(-math.pi / 2, 0, 0))
	-- Slide it back so only the very tip is in the wall: find how far the model reaches along the
	-- throw, and put that point just past the surface
	local reach = -math.huge
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local half = d.Size / 2
			for _, x in { -1, 1 } do
				for _, y in { -1, 1 } do
					for _, z in { -1, 1 } do
						local corner = d.CFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
						reach = math.max(reach, (corner - at):Dot(direction))
					end
				end
			end
		end
	end
	if reach > -math.huge then
		model:PivotTo(model:GetPivot() - direction * (reach - 0.3))
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("Trail") or d:IsA("ParticleEmitter") or d:IsA("Fire") then
			(d :: any).Enabled = false
		end
	end
	if parent then
		model.Parent = parent
		return
	end
	if not folder or not folder.Parent then
		local created = Instance.new("Folder")
		created.Name = "StuckKnives"
		created.Parent = workspace
		folder = created
	end
	model.Parent = folder
	table.insert(stuck, model)
	while #stuck > MAX do
		local oldest = table.remove(stuck, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	Debris:AddItem(model, seconds)
end

return StuckKnives
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Targets</string>
            <string name="Source"><![CDATA[--!strict
-- Things in the hub that hub knives can hit besides the watchmen: vault gates and burglars during
-- raids, and other players when knockdowns are allowed. CombatService asks here after it has
-- checked the guards; RaidService registers everything. Each target says whether a given attacker
-- may hit it right now and what happens when they do.

local Targets = {}

export type Target = {
	Part: BasePart, -- what reach is measured to (the closest point on its box)
	Model: Instance, -- a thrown knife hitting anything inside this counts
	CanHit: (attacker: Player) -> boolean,
	Hit: (attacker: Player, damage: number, kind: string, from: Vector3) -> (), -- kind: "Swing" | "Throw"
	Solid: boolean?, -- thrown knives stop on it
}

local registered: { [Target]: boolean } = {}
-- Lists of targets made fresh on demand (players come and go every frame)
local providers: { () -> { Target } } = {}

function Targets.Add(target: Target): () -> ()
	registered[target] = true
	return function()
		registered[target] = nil
	end
end

function Targets.AddProvider(provider: () -> { Target })
	table.insert(providers, provider)
end

local function all(): { Target }
	local list = {}
	for target in registered do
		if target.Part.Parent then
			table.insert(list, target)
		else
			registered[target] = nil
		end
	end
	for _, provider in providers do
		for _, target in provider() do
			table.insert(list, target)
		end
	end
	return list
end

-- Closest point on a part's box to `point`
local function closestPoint(part: BasePart, point: Vector3): Vector3
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local half = part.Size / 2
	local clamped = Vector3.new(
		math.clamp(localPoint.X, -half.X, half.X),
		math.clamp(localPoint.Y, -half.Y, half.Y),
		math.clamp(localPoint.Z, -half.Z, half.Z)
	)
	return part.CFrame:PointToWorldSpace(clamped)
end

-- The nearest hittable target within `range` in front of `position` (for swings)
function Targets.InReach(attacker: Player, position: Vector3, look: Vector3, range: number): Target?
	local best: Target? = nil
	local bestDistance = range
	for _, target in all() do
		local point = closestPoint(target.Part, position)
		local offset = point - position
		local distance = offset.Magnitude
		local facing = if distance > 0.5 then look:Dot(offset.Unit) else 1
		if distance <= bestDistance and facing > 0.1 and target.CanHit(attacker) then
			best, bestDistance = target, distance
		end
	end
	return best
end

-- The target a raycast hit belongs to, if any
function Targets.FromPart(attacker: Player, part: Instance): Target?
	for _, target in all() do
		if (part == target.Part or part:IsDescendantOf(target.Model)) and target.CanHit(attacker) then
			return target
		end
	end
	return nil
end

-- Soft targets a thrown knife passing from a to b goes through (things the ray can't stop on,
-- like players' characters, which hub knives fly through otherwise). Solid ones are left to the ray.
function Targets.AlongPath(attacker: Player, a: Vector3, b: Vector3, radius: number): Target?
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	for _, target in all() do
		local center = target.Part.Position
		local t = if lengthSq > 0 then math.clamp((center - a):Dot(ab) / lengthSq, 0, 1) else 0
		local closest = a + ab * t
		if
			not target.Solid
			and (closestPoint(target.Part, closest) - closest).Magnitude <= radius
			and target.CanHit(attacker)
		then
			return target
		end
	end
	return nil
end

return Targets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!strict
-- Knife trading between two players, made scam-proof the simple way:
--   1. A asks B to trade, B accepts: a trade window opens on both screens.
--   2. Each puts up to 6 of their knives in. ANY change un-readies BOTH sides.
--   3. Both press Ready -> a 3 second countdown both can see (cancel any time) -> swap.
-- The server checks everything again at the swap (still owned, room on both walls, nobody in a
-- round or carrying anything). Remote Trade (function):
--   ("Request", userId) ("Accept", userId) ("Decline", userId) ("Offer", { item }) ("Ready") ("Cancel")
-- Clients hear Effect "TradeRequest" (fromId, name), "TradeState" (state) and "TradeClosed" (why).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local Net = require(script.Parent.Parent.Remotes)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)

local TradeService = {}

local MAX_ITEMS = 6
local COUNTDOWN = 3

type Side = { Player: Player, Offer: { string }, Ready: boolean }
type Session = { A: Side, B: Side, Version: number, CountdownEnds: number? }

local sessions: { [Player]: Session } = {}
local requests: { [Player]: { [number]: number } } = {} -- target -> requester UserId -> when
local lastCall: { [Player]: number } = {}

local function sideOf(session: Session, player: Player): (Side, Side)
	if session.A.Player == player then
		return session.A, session.B
	end
	return session.B, session.A
end

local function push(session: Session)
	for _, side in { session.A, session.B } do
		local mine, theirs = sideOf(session, side.Player)
		Net.Remotes.Effect:FireClient(side.Player, "TradeState", {
			OtherName = theirs.Player.DisplayName,
			Mine = mine.Offer,
			Theirs = theirs.Offer,
			MyReady = mine.Ready,
			TheirReady = theirs.Ready,
			CountdownEnds = session.CountdownEnds,
		})
	end
end

local function close(session: Session, why: string)
	for _, side in { session.A, session.B } do
		if sessions[side.Player] == session then
			sessions[side.Player] = nil
			if side.Player.Parent then
				Net.Remotes.Effect:FireClient(side.Player, "TradeClosed", why)
			end
		end
	end
end

local function busy(player: Player): string?
	if player:GetAttribute("InRound") then
		return "in a round"
	end
	if player:GetAttribute("Carrying") then
		return "carrying something"
	end
	return nil
end

-- Does `player` own every item in `offer` (counting duplicates)?
local function owns(player: Player, offer: { string }): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	local have: { [string]: number } = {}
	for _, item in profile.Knives do
		have[item] = (have[item] or 0) + 1
	end
	for _, item in offer do
		if (have[item] or 0) <= 0 then
			return false
		end
		have[item] -= 1
	end
	return true
end

local function swap(session: Session)
	local a, b = session.A, session.B
	local pa, pb = DataService.Get(a.Player), DataService.Get(b.Player)
	if not pa or not pb then
		return close(session, "Someone left.")
	end
	local why = busy(a.Player) or busy(b.Player)
	if why then
		return close(session, `Trade cancelled: someone is {why}.`)
	end
	if not owns(a.Player, a.Offer) or not owns(b.Player, b.Offer) then
		return close(session, "Trade cancelled: a knife is gone.")
	end
	if #pa.Knives - #a.Offer + #b.Offer > pa.Slots or #pb.Knives - #b.Offer + #a.Offer > pb.Slots then
		return close(session, "Trade cancelled: not enough room on someone's wall.")
	end
	local function move(profile: DataService.Profile, give: { string }, get: { string })
		for _, item in give do
			local index = table.find(profile.Knives, item)
			if index then
				DataService.RemoveKnife(profile, index)
				if profile.Equipped == item and not table.find(profile.Knives, item) then
					profile.Equipped = ""
				end
			end
		end
		for _, item in get do
			DataService.AddKnife(profile, item)
			local parsed = Items.Parse(item)
			if parsed and not table.find(profile.Discovered, parsed.Name) then
				table.insert(profile.Discovered, parsed.Name)
			end
		end
	end
	DataService.Update(a.Player, function(p)
		move(p, a.Offer, b.Offer)
	end)
	DataService.Update(b.Player, function(p)
		move(p, b.Offer, a.Offer)
	end)
	-- Trades are worth saving straight away
	task.spawn(DataService.SaveNow, a.Player)
	task.spawn(DataService.SaveNow, b.Player)
	BaseService.RefreshRack(a.Player)
	BaseService.RefreshRack(b.Player)
	close(session, "Trade complete! 🤝")
end

local function handle(player: Player, action: unknown, arg: unknown): boolean
	local now = os.clock()
	if now - (lastCall[player] or 0) < 0.2 then
		return false
	end
	lastCall[player] = now
	local session = sessions[player]

	if action == "Request" and type(arg) == "number" then
		local other = Players:GetPlayerByUserId(arg)
		if not other or other == player or sessions[other] or session then
			Net.Notify(player, "They can't trade right now.", "bad")
			return false
		end
		local why = busy(player) or busy(other)
		if why then
			Net.Notify(player, `Can't trade while someone is {why}.`, "bad")
			return false
		end
		local pending = requests[other] or {}
		pending[player.UserId] = now
		requests[other] = pending
		Net.Remotes.Effect:FireClient(other, "TradeRequest", player.UserId, player.DisplayName)
		Net.Notify(player, `Trade request sent to {other.DisplayName}!`, "info")
		return true
	elseif (action == "Accept" or action == "Decline") and type(arg) == "number" then
		local other = Players:GetPlayerByUserId(arg)
		local mine = requests[player]
		local sent = mine and mine[arg]
		if mine then
			mine[arg] = nil
		end
		if action == "Decline" then
			if other then
				Net.Notify(other, `{player.DisplayName} doesn't want to trade.`, "info")
			end
			return true
		end
		if not other or not sent or now - sent > 60 or session or sessions[other] then
			Net.Notify(player, "That trade request expired.", "bad")
			return false
		end
		local fresh: Session = {
			A = { Player = other, Offer = {}, Ready = false },
			B = { Player = player, Offer = {}, Ready = false },
			Version = 0,
			CountdownEnds = nil,
		}
		sessions[player] = fresh
		sessions[other] = fresh
		push(fresh)
		return true
	end

	if not session then
		return false
	end
	local mine = sideOf(session, player)
	if action == "Cancel" then
		close(session, `{player.DisplayName} cancelled the trade.`)
		return true
	elseif action == "Offer" and type(arg) == "table" then
		local offer: { string } = {}
		for i, item in arg :: { any } do
			if i > MAX_ITEMS or type(item) ~= "string" then
				return false
			end
			table.insert(offer, item)
		end
		if not owns(player, offer) then
			return false
		end
		mine.Offer = offer
		-- Any change: both have to look again
		session.A.Ready = false
		session.B.Ready = false
		session.CountdownEnds = nil
		session.Version += 1
		push(session)
		return true
	elseif action == "Ready" then
		mine.Ready = not mine.Ready
		session.CountdownEnds = nil
		session.Version += 1
		if session.A.Ready and session.B.Ready then
			local version = session.Version
			session.CountdownEnds = workspace:GetServerTimeNow() + COUNTDOWN
			task.delay(COUNTDOWN, function()
				-- Nothing changed during the countdown: swap
				if
					sessions[player] == session
					and session.Version == version
					and session.A.Ready
					and session.B.Ready
				then
					swap(session)
				end
			end)
		end
		push(session)
		return true
	end
	return false
end

function TradeService.Init()
	Net.Remotes.Trade.OnServerInvoke = handle
	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			close(session, `{player.DisplayName} left.`)
		end
		requests[player] = nil
		lastCall[player] = nil
	end)
	-- A round starting or a knife being picked up ends any trade in progress
	local function watch(player: Player)
		for _, attribute in { "InRound", "Carrying" } do
			player:GetAttributeChangedSignal(attribute):Connect(function()
				local session = sessions[player]
				if session and player:GetAttribute(attribute) then
					close(session, "Trade cancelled.")
				end
			end)
		end
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">UpgradeService</string>
            <string name="Source"><![CDATA[--!strict
-- Cash purchases (Haunted Wheel tiers, vault walls, rack slots, Murderer tickets, Rebirth). Clients only send the name of what they
-- want; price and limits come from GameConfig on the server. Tickets are in-game cash only, never
-- Robux. Innocent Powers are bought through PowerService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(script.Parent.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)
local Offers = require(script.Parent.Offers)
local Rewards = require(script.Parent.Rewards)

local UpgradeService = {}

local lastRequest: { [Player]: number } = {}
-- Not enough cash for something: offer the cash pack that would cover it
local function short(player: Player, cost: number): (boolean, string)
	local profile = DataService.Get(player)
	if profile then
		Offers.Cash(player, cost - profile.Cash, BaseService.RackIncome(player))
	end
	return false, "Not enough cash"
end

local function purchase(player: Player, kind: unknown): (boolean, string)
	local now = os.clock()
	if now - (lastRequest[player] or 0) < 0.25 then
		return false, "Slow down!"
	end
	lastRequest[player] = now

	local profile = DataService.Get(player)
	if not profile or type(kind) ~= "string" then
		return false, "Not ready yet"
	end

	local caseRarity = kind:match("^Case:(%a+)$")
	if caseRarity then
		return Rewards.BuyCase(player, caseRarity)
	end

	if kind == "Treadmill" then
		local nextTier = GameConfig.Treadmills[profile.TreadmillLevel + 1]
		if not nextTier then
			return false, "Your Haunted Wheel is maxed!"
		end
		if not DataService.TrySpend(player, nextTier.Cost) then
			return short(player, nextTier.Cost)
		end
		DataService.Update(player, function(p)
			p.TreadmillLevel += 1
		end)
		BaseService.RefreshRack(player) -- updates the wheel's sign
		return true, `{nextTier.Name}! +{nextTier.Rate} Speed per second`
	elseif kind == "Trail" then
		local nextTrail = GameConfig.Trails[profile.TrailLevel + 1]
		if not nextTrail then
			return false, "You have the best knife trail!"
		end
		if not DataService.TrySpend(player, nextTrail.Cost) then
			return short(player, nextTrail.Cost)
		end
		DataService.Update(player, function(p)
			p.TrailLevel += 1
		end)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Net.Remotes.Effect:FireAllClients("Deposit", player, "Epic")
		end
		return true, `{nextTrail.Name}! Your wheel now trains Speed x{nextTrail.Multiplier}`
	elseif kind == "Health" then
		if profile.HealthLevel >= GameConfig.Health.MaxLevel then
			return false, "Your health is maxed!"
		end
		local cost = GameConfig.HealthCost(profile.HealthLevel)
		if not DataService.TrySpend(player, cost) then
			Offers.Show(player, "HealthBoost", "Need more health now? +3 Health levels instantly.")
			return short(player, cost)
		end
		DataService.Update(player, function(p)
			p.HealthLevel += 1
		end)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Net.Remotes.Effect:FireAllClients("Heal", root.Position)
		end
		return true,
			`Max health {GameConfig.MaxHealthFor(
				profile.HealthLevel,
				if player:GetAttribute("Pass_Titan") then 2 else 1
			)}!`
	elseif kind == "Walls" then
		local nextTier = GameConfig.Walls[profile.WallLevel + 1]
		if not nextTier then
			return false, "Your walls are as good as they get!"
		end
		if not DataService.TrySpend(player, nextTier.Cost) then
			return short(player, nextTier.Cost)
		end
		DataService.Update(player, function(p)
			p.WallLevel += 1
		end)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Net.Remotes.Effect:FireAllClients("WallsUp", player, root.Position)
		end
		return true, `{nextTier.Name}! Your gate now holds {nextTier.GateHealth} damage`
	elseif kind == "Rebirth" then
		local cost = GameConfig.RebirthCost(profile.Rebirths)
		if profile.Rebirths >= GameConfig.Rebirth.Max then
			return false, "You've reached the final rebirth!"
		end
		if player:GetAttribute("InRound") or player:GetAttribute("Carrying") then
			return false, "Finish what you're doing first"
		end
		if profile.Cash < cost then
			return false, `Rebirth needs {Format.Cash(cost)}`
		end
		-- Start over with a permanent boost: powers, stats, collection and tickets stay
		DataService.Update(player, function(p)
			p.Rebirths += 1
			p.Cash = 0
			p.Knives = {}
			p.Plates = {}
			p.Equipped = ""
			p.Slots = GameConfig.StartingSlots
			p.Speed = 0
			p.TreadmillLevel = 1
			p.WallLevel = 1
		end)
		BaseService.RefreshRack(player) -- (the walls rebuild themselves when WallLevel changes)
		local title = GameConfig.RebirthTitle(profile.Rebirths) or ""
		Net.Announce(
			`{player.DisplayName} REBIRTHED! They are now a {title} (x{1 + profile.Rebirths * GameConfig.Rebirth.IncomeBonus} income)`,
			Color3.fromRGB(255, 220, 90),
			2
		)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Net.Remotes.Effect:FireAllClients("Rebirth", player, root.Position)
		end
		return true,
			`Rebirth {profile.Rebirths}! Everything earns x{1 + profile.Rebirths * GameConfig.Rebirth.IncomeBonus}`
	elseif kind == "Slot" then
		if profile.Slots >= GameConfig.MaxSlots then
			return false, "Your vault is as tall as it gets!"
		end
		if not DataService.TrySpend(player, GameConfig.SlotCost(profile.Slots)) then
			Offers.Show(player, "Mount", "Want it now? Add the next floor instantly.")
			return false, "Not enough cash"
		end
		DataService.Update(player, function(p)
			p.Slots = math.min(GameConfig.MaxSlots, p.Slots + GameConfig.SlotsPerFloor)
		end)
		BaseService.RefreshRack(player)
		return true, `Your vault grew a floor: {profile.Slots} knife plates!`
	elseif kind == "Ticket" then
		if profile.Tickets >= GameConfig.MaxTickets then
			return false, `You can hold {GameConfig.MaxTickets} tickets at most`
		end
		if not DataService.TrySpend(player, GameConfig.TicketPrice(BaseService.RackIncome(player))) then
			return false, "Not enough cash"
		end
		DataService.Update(player, function(p)
			p.Tickets += 1
		end)
		return true, "Murderer ticket bought! It's used next round."
	end
	return false, "Unknown item"
end

function UpgradeService.Init()
	local function buy(player: Player, kind: unknown): (boolean, string)
		local ok, message = purchase(player, kind)
		Net.Notify(player, message, if ok then "good" else "bad")
		return ok, message
	end
	Net.Remotes.Purchase.OnServerInvoke = buy
	BaseService.OnUpgradeWalls = function(player: Player)
		buy(player, "Walls")
	end
	BaseService.OnUpgradeBase = function(player: Player)
		buy(player, "Slot")
	end
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return UpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">VaultWalls</string>
            <string name="Source"><![CDATA[--!strict
-- A vault's frame and laser gate for its wall tier (GameConfig.Walls). Vaults are open platforms
-- (like the Tsunami steal games): navy corner posts and beams, a low glass rail, and invisible walls
-- around it, so the whole plaza can see what everyone has. Better tiers get more laser lines, a
-- brighter accent colour and fancier post tops, so the plaza still shows off who's doing well.
-- Everything is built in the vault's own frame (local +Z = the open side facing the plaza). The
-- gate's invisible "Blocker" is what raiders hit and what clients make solid for everyone but the
-- owner (see client/Raid, which also fades the "Pane" lasers as the gate loses health). Gate state
-- lives in attributes on the Blocker: Owner, Health, MaxHealth, Open, Tier.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Props = require(ReplicatedStorage.Shared.Props)
local Toy = require(ReplicatedStorage.Shared.Toy)

local VaultWalls = {}

local HALF_W, HALF_D = 20, 22 -- vault is 40 wide, 44 deep
local T = 1 -- rail thickness
local POST = 1.8
local GATE_HALF = 8 -- gate opening is 16 wide
local GATE_H = 11
local FLOOR_H = 16 -- MapService.FloorHeight
local RAIL_H = 3.5
-- The front's invisible wall stops just under the first deck: too high to jump in from the plaza,
-- but from the upper floors you can jump out over the rail (the sides stay full height, so you
-- can't walk into the next vault)
local FRONT_H = 15
local NAVY = Color3.fromRGB(40, 44, 90)
local GLASS = Color3.fromRGB(190, 240, 255)

export type Built = {
	Gate: Model,
	Blocker: Part,
	Height: number,
	BackHeight: number,
}

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function deco(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = block(parent, name, size, cframe, color, material)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

-- Builds (or rebuilds) a vault's frame into `folder`. `color` is the vault's own colour (the strip
-- along the base and the gate's health bar), `tierIndex` its wall tier.
function VaultWalls.Build(folder: Folder, frame: CFrame, color: Color3, tierIndex: number, floors: number?): Built
	folder:ClearAllChildren()
	-- The frame rises with the vault: up past the top floor's railing
	local floorCount = floors or 1
	local FRAME_H = floorCount * FLOOR_H + 4
	local WALL_H = math.max(44, FRAME_H + 16) -- the invisible walls: nobody climbs or jumps out over them
	local tier = GameConfig.Walls[math.clamp(tierIndex, 1, #GameConfig.Walls)]
	local accent = tier.Trim
	local frameColor = NAVY:Lerp(tier.Color, 0.25)
	local function at(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end

	-- Invisible walls on every side but the gate: you can see in, you can't walk in
	local function invisible(name: string, size: Vector3, cframe: CFrame)
		local p = block(folder, name, size, cframe, Color3.new(), nil)
		p.Transparency = 1
		p.CastShadow = false
		p.CanTouch = false
	end
	invisible("BackWall", Vector3.new(HALF_W * 2, WALL_H, T), at(0, WALL_H / 2, -HALF_D + T / 2))
	for _, side in { -1, 1 } do
		invisible("SideWall", Vector3.new(T, WALL_H, HALF_D * 2), at(side * (HALF_W - T / 2), WALL_H / 2, 0))
		local frontLength = HALF_W - GATE_HALF
		invisible(
			"FrontWall",
			Vector3.new(frontLength, FRONT_H, T),
			at(side * (GATE_HALF + frontLength / 2), FRONT_H / 2, HALF_D - T / 2)
		)
	end
	invisible(
		"Lintel",
		Vector3.new(GATE_HALF * 2, FRONT_H - GATE_H, T),
		at(0, GATE_H + (FRONT_H - GATE_H) / 2, HALF_D - T / 2)
	)

	-- The low glass rail and its navy cap all the way round (gate excluded)
	local function rail(from: Vector3, to: Vector3)
		local mid = (from + to) / 2
		local length = (to - from).Magnitude
		local cf = frame * CFrame.lookAt(mid, to)
		local glass = deco(
			folder,
			"Rail",
			Vector3.new(0.4, RAIL_H, length),
			cf * CFrame.new(0, RAIL_H / 2 + 0.6, 0),
			GLASS,
			Enum.Material.Glass
		)
		glass.Transparency = 0.6
		glass.CastShadow = false
		deco(folder, "RailCap", Vector3.new(0.8, 0.5, length), cf * CFrame.new(0, RAIL_H + 0.85, 0), frameColor)
		-- The owner's colour along the bottom, so you can spot your own vault
		deco(folder, "Strip", Vector3.new(0.9, 0.4, length), cf * CFrame.new(0, 0.85, 0), color)
	end
	local inX, inZ = HALF_W - T / 2, HALF_D - T / 2
	rail(Vector3.new(-inX, 0, -inZ), Vector3.new(inX, 0, -inZ))
	for _, side in { -1, 1 } do
		rail(Vector3.new(side * inX, 0, -inZ), Vector3.new(side * inX, 0, inZ))
		rail(Vector3.new(side * (GATE_HALF + POST), 0, inZ), Vector3.new(side * inX, 0, inZ))
	end

	-- Navy corner posts and beams at each floor level: an open shelf you can see straight into
	local posts: { CFrame } = {}
	for _, x in { -inX, inX } do
		for _, z in { -inZ, inZ } do
			local cf = at(x, FRAME_H / 2, z)
			local post = deco(folder, "Post", Vector3.new(POST, FRAME_H, POST), cf, frameColor)
			Toy.Dress(post, Toy.Sides, 1, 0)
			table.insert(posts, cf * CFrame.new(0, FRAME_H / 2, 0))
		end
	end
	local levels: { number } = {}
	for k = 1, floorCount - 1 do
		table.insert(levels, k * FLOOR_H)
	end
	table.insert(levels, FRAME_H)
	for _, y in levels do
		for _, side in { -1, 1 } do
			deco(folder, "Beam", Vector3.new(POST * 0.7, 1, HALF_D * 2), at(side * inX, y - 0.5, 0), frameColor)
		end
		deco(folder, "Beam", Vector3.new(HALF_W * 2, 1, POST * 0.7), at(0, y - 0.5, -inZ), frameColor)
		if y == FRAME_H then
			deco(folder, "Beam", Vector3.new(HALF_W * 2, 1, POST * 0.7), at(0, y - 0.5, inZ), frameColor)
		end
	end
	-- Post tops: plain caps, glowing caps from tier 3, spinning crystals from tier 5
	for _, cf in posts do
		local cap = deco(
			folder,
			"PostCap",
			Vector3.new(POST + 0.6, 0.8, POST + 0.6),
			cf * CFrame.new(0, 0.4, 0),
			if tierIndex >= 3 then accent else Color3.new(1, 1, 1),
			if tierIndex >= 3 then Enum.Material.Neon else Enum.Material.SmoothPlastic
		)
		if tierIndex >= 5 then
			local crystal = Props.Build("Crystal", true)
			crystal:ScaleTo(1.2)
			crystal:PivotTo(cap.CFrame * CFrame.new(0, 0.4, 0))
			for _, d in crystal:GetDescendants() do
				if d:IsA("BasePart") then
					d.Color = accent
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
				end
			end
			crystal:AddTag("Spin")
			crystal.Parent = folder
		end
		if tierIndex >= 7 then
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparkle.Color = ColorSequence.new(accent, Color3.new(1, 1, 1))
			sparkle.LightEmission = 1
			sparkle.Rate = 4
			sparkle.Lifetime = NumberRange.new(1, 1.6)
			sparkle.Speed = NumberRange.new(1, 2)
			sparkle.SpreadAngle = Vector2.new(180, 180)
			sparkle.Size = NumberSequence.new(0.6, 0)
			sparkle.Parent = cap
		end
	end

	-- The gate: two posts with laser emitters and lines of light across the opening (more lines on
	-- better tiers). Broken gates switch the lasers off (SetOpen).
	local gate = Instance.new("Model")
	gate.Name = "Gate"
	local gateZ = HALF_D - T / 2
	for _, side in { -1, 1 } do
		local post = deco(
			gate,
			"GatePost",
			Vector3.new(POST, GATE_H + 1, POST),
			at(side * (GATE_HALF + POST / 2), (GATE_H + 1) / 2, gateZ),
			frameColor
		)
		Toy.Dress(post, Toy.Sides, 1, 0)
		post:SetAttribute("Keep", true)
		deco(
			gate,
			"GateTop",
			Vector3.new(POST + 0.5, 0.8, POST + 0.5),
			at(side * (GATE_HALF + POST / 2), GATE_H + 1.4, gateZ),
			accent,
			Enum.Material.Neon
		):SetAttribute("Keep", true)
	end
	local lines = math.clamp(tierIndex + 2, 3, 10)
	if Props.Has("DetailGateHardware") then
		for _, side in { -1, 1 } do
			local hardware = Props.Build("DetailGateHardware", true)
			hardware:PivotTo(at(side * (GATE_HALF + POST / 2 + 0.3), 0, gateZ + 0.15) * CFrame.Angles(0, math.pi, 0))
			hardware:SetAttribute("MapDetail", true)
			for _, part in hardware:GetDescendants() do
				if part:IsA("BasePart") then
					part:SetAttribute("Keep", true)
					if part.Name == "Power" or part.Name == "Bolts" then
						part.Color = accent
					elseif part.Name == "Shell" then
						part.Color = frameColor
					elseif part.Name == "Plates" then
						part.Color = tier.Color:Lerp(Color3.new(1, 1, 1), 0.35)
					end
				end
			end
			hardware.Parent = gate
		end
	end
	for i = 1, lines do
		local y = 0.9 + (i - 1) * (GATE_H - 1.4) / (lines - 1)
		local laser =
			deco(gate, "Pane", Vector3.new(GATE_HALF * 2, 0.22, 0.22), at(0, y, gateZ), accent, Enum.Material.Neon)
		laser.Transparency = 0.15
	end
	-- What actually blocks (on clients) and what raiders hit
	local blocker =
		block(gate, "Blocker", Vector3.new(GATE_HALF * 2, GATE_H, 1.2), at(0, GATE_H / 2, gateZ), Color3.new(), nil)
	blocker.Transparency = 1
	blocker.CanCollide = false -- each client decides (the owner walks through, everyone else bumps)
	blocker.CanQuery = true
	blocker.CanTouch = false
	blocker:AddTag("VaultGate")
	for _, d in gate:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetAttribute("BaseTransparency", d.Transparency)
		end
	end
	-- Health bar, shown during raids
	local gui = Instance.new("BillboardGui")
	gui.Name = "GateHealth"
	gui.Size = UDim2.fromOffset(200, 46)
	gui.StudsOffsetWorldSpace = Vector3.new(0, GATE_H / 2 + 2.6, 0)
	gui.MaxDistance = 160
	gui.Enabled = false
	gui.Adornee = blocker
	gui.Parent = blocker
	local name = Instance.new("TextLabel")
	name.Name = "Title"
	name.Size = UDim2.new(1, 0, 0, 20)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0
	name.Text = tier.Name
	name.Parent = gui
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Position = UDim2.fromOffset(0, 24)
	back.Size = UDim2.new(1, 0, 0, 16)
	back.BackgroundColor3 = Color3.fromRGB(30, 20, 30)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner").Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner").Parent = fill
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 16, 24)
	stroke.Parent = back
	gate.PrimaryPart = blocker
	gate.Parent = folder

	blocker:SetAttribute("Tier", tierIndex)
	blocker:SetAttribute("MaxHealth", tier.GateHealth)
	blocker:SetAttribute("Health", tier.GateHealth)
	blocker:SetAttribute("Floors", floorCount)
	return { Gate = gate, Blocker = blocker, Height = FRAME_H, BackHeight = FRAME_H }
end

-- Broken gates: the lasers switch off (and come back when it reforges); the posts stay
function VaultWalls.SetOpen(gate: Model, open: boolean)
	for _, d in gate:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Blocker" and not d:GetAttribute("Keep") then
			local base = d:GetAttribute("BaseTransparency")
			d.Transparency = if open then 1 else (if type(base) == "number" then base else 0)
		end
	end
	local blocker = gate:FindFirstChild("Blocker")
	if blocker then
		blocker:SetAttribute("Open", open or nil)
	end
end

return VaultWalls
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="66">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="67">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="68">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--!strict
-- Knife controls from the client side, MM2 style:
--   * desktop click / gamepad trigger: existing stab and throw controls
--   * mobile: tap the translucent knife button to stab; hold its joystick to aim and throw
--   * HOLD left click (or Q, gamepad LT/X, or the on-screen button): your arm cranks back, a
--     crosshair shows and the camera leans in; let go to throw at whatever is under the cursor
-- Knife tools are ManualActivationOnly, so a tap is turned into tool:Activate() here and the
-- server still decides every hit from Tool.Activated.
--   * other abilities (Murderer perks like Dash, the Smoke Bomb) fire on press
-- The Revolver fires at the cursor too. The client only sends aim; the server validates it all.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Ui = require(script.Parent.Ui)
local Moves = require(script.Parent.Moves)
local KnifeGesture = require(script.Parent.KnifeGesture)
local KnifeAim = require(script.Parent.KnifeAim)
local KNIFE_SIZE = KnifeAim.ButtonSize
local AnimLibrary = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AnimLibrary"))
local GameConfig = require(ReplicatedStorage.Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local Textures = require(ReplicatedStorage.Shared.Config:WaitForChild("Textures"))
local Items = require(ReplicatedStorage.Shared.Items)
local Artwork = require(ReplicatedStorage.Shared.Config.UiArtwork)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Abilities = {}

local THROW_INPUTS: { [Enum.KeyCode | Enum.UserInputType]: boolean } = {
	[Enum.KeyCode.Q] = true,
	[Enum.KeyCode.ButtonL2] = true,
	[Enum.KeyCode.ButtonX] = true,
}
local COMBO = { "Stab", "Slash" }
local HOLD_TO_THROW = 0.2 -- seconds holding left click before a tap becomes a throw
local BASE_FOV = 70

-- Mouse/touch aim at whatever is under the pointer; gamepad aims through the screen centre
local function screenAim(): Vector2
	local camera = workspace.CurrentCamera
	local lastInput = UserInputService:GetLastInputType()
	if lastInput.Name:find("Gamepad") or Ui.Phone or UserInputService.PreferredInput == Enum.PreferredInput.Touch then
		return camera.ViewportSize / 2
	end
	return UserInputService:GetMouseLocation()
end

local function aimPoint(at: Vector2?): Vector3
	local camera = workspace.CurrentCamera
	local screen = at or screenAim()
	local ray = camera:ViewportPointToRay(screen.X, screen.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Instance }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	return if hit then hit.Position else ray.Origin + ray.Direction * 300
end

-- Direction from the character to what's under the cursor / crosshair, like MM2's knife throw
local function aimDirection(at: Vector2?): Vector3
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	if not head then
		return workspace.CurrentCamera.CFrame.LookVector
	end
	local offset = aimPoint(at) - head.Position
	return if offset.Magnitude > 0.1 then offset.Unit else workspace.CurrentCamera.CFrame.LookVector
end

local function isKnife(tool: Instance): boolean
	return tool:IsA("Tool") and (tool:GetAttribute("HubKnife") ~= nil or tool:GetAttribute("MurderKnife") == true)
end

local function knifeInHand(): Tool?
	local character = player.Character
	if not character then
		return nil
	end
	for _, child in character:GetChildren() do
		if isKnife(child) then
			return child :: Tool
		end
	end
	return nil
end

-- Pull the knife out of the backpack if it isn't already in hand
local function drawKnife(): Tool?
	local held = knifeInHand()
	if held then
		return held
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not humanoid or not backpack then
		return nil
	end
	for _, child in backpack:GetChildren() do
		if isKnife(child) then
			humanoid:EquipTool(child :: Tool)
			return child :: Tool
		end
	end
	return nil
end

function Abilities.Init()
	local gui = Ui.gui
	local button = Ui.button({
		-- Bottom right, above where the touch jump button sits and clear of the tool hotbar
		AnchorPoint = Vector2.new(1, 1),
		-- (phones: just left of the jump button, under the right thumb)
		Position = if Ui.Phone then UDim2.new(1, -160, 1, -22) else UDim2.new(1, -20, 1, -186),
		Size = if Ui.Phone then UDim2.fromOffset(180, 70) else UDim2.fromOffset(230, 64),
		BackgroundColor3 = Color3.fromRGB(200, 40, 60),
		Text = "",
		Visible = false,
	}, gui)

	-- The Murderer's perk: its Blender badge on the ability button, and a card above it that
	-- explains the perk (passive perks get the card only)
	local buttonIcon = Instance.new("ImageLabel")
	buttonIcon.Name = "PerkIcon"
	buttonIcon.AnchorPoint = Vector2.new(0, 0.5)
	buttonIcon.Position = UDim2.new(0, -18, 0.5, 0)
	buttonIcon.Size = UDim2.fromOffset(if Ui.Phone then 58 else 66, if Ui.Phone then 58 else 66)
	buttonIcon.BackgroundTransparency = 1
	buttonIcon.ZIndex = (button.ZIndex or 1) + 3
	buttonIcon.Visible = false
	buttonIcon.Parent = button
	local perkCard = Instance.new("Frame")
	perkCard.Name = "PerkCard"
	perkCard.AnchorPoint = Vector2.new(1, 1)
	perkCard.Position = if Ui.Phone then UDim2.new(1, -160, 1, -100) else UDim2.new(1, -20, 1, -262)
	perkCard.Size = UDim2.fromOffset(260, 70)
	perkCard.BackgroundColor3 = Color3.fromRGB(28, 20, 34)
	perkCard.BackgroundTransparency = 0.15
	perkCard.Visible = false
	perkCard.Parent = Ui.root
	Ui.corner(perkCard, 14)
	Ui.stroke(perkCard)
	local cardIcon = Instance.new("ImageLabel")
	cardIcon.Position = UDim2.fromOffset(4, 3)
	cardIcon.Size = UDim2.fromOffset(64, 64)
	cardIcon.BackgroundTransparency = 1
	cardIcon.Parent = perkCard
	local cardName = Ui.label({
		Position = UDim2.fromOffset(74, 4),
		Size = UDim2.new(1, -80, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 90, 100),
		Text = "",
	}, perkCard)
	Ui.textStroke(cardName, 2)
	local cardText = Ui.label({
		Position = UDim2.fromOffset(74, 30),
		Size = UDim2.new(1, -80, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextScaled = false,
		TextSize = 14,
		TextWrapped = true,
		Text = "",
	}, perkCard)
	Ui.textStroke(cardText, 1)
	local function refreshPerk()
		local id = player:GetAttribute("Perk")
		local perk = type(id) == "string" and GameConfig.Perks[id] or nil
		local icon = if type(id) == "string" then Textures.PerkIcons[id] else nil
		perkCard.Visible = not Ui.Phone and not Ui.menuOpen() and perk ~= nil and player:GetAttribute("InRound") == true
		buttonIcon.Visible = icon ~= nil
		if perk then
			cardIcon.Image = icon or ""
			buttonIcon.Image = icon or ""
			cardName.Text = if perk.Passive then `{perk.DisplayName} (passive)` else perk.DisplayName
			cardText.Text = perk.Description
		end
	end
	player:GetAttributeChangedSignal("Perk"):Connect(refreshPerk)
	player:GetAttributeChangedSignal("InRound"):Connect(refreshPerk)
	refreshPerk()

	-- Crosshair + charge ring, shown while winding up a throw
	local crosshairGui = Instance.new("ScreenGui")
	crosshairGui.Name = "Crosshair"
	crosshairGui.ResetOnSpawn = false
	crosshairGui.IgnoreGuiInset = true
	crosshairGui.DisplayOrder = 5
	crosshairGui.Enabled = false
	crosshairGui.Parent = player:WaitForChild("PlayerGui")
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Size = UDim2.fromOffset(46, 46)
	ring.BackgroundTransparency = 1
	ring.Parent = crosshairGui
	Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Thickness = 3
	ringStroke.Color = Color3.new(1, 1, 1)
	ringStroke.Parent = ring
	local fill = Instance.new("Frame")
	fill.AnchorPoint = Vector2.new(0.5, 0.5)
	fill.Position = UDim2.fromScale(0.5, 0.5)
	fill.Size = UDim2.fromScale(0.15, 0.15)
	fill.BackgroundColor3 = Color3.fromRGB(255, 220, 120)
	fill.BackgroundTransparency = 0.25
	fill.Parent = ring
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(5, 5)
	dot.BackgroundColor3 = Color3.new(1, 1, 1)
	dot.Parent = ring
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local abilityName: string? = nil
	local readyAt = 0
	local chargingSince: number? = nil
	-- "perk" = the ability button's throw (hub throw / Knife Throw perk), "basic" = the Murderer's
	-- hold-click throw that every Murderer has
	local chargeKind = "perk"
	local basicThrowReadyAt = 0
	local restoreFov = BASE_FOV
	local lastSwing = 0
	local comboIndex = 0

	local function isThrow(): boolean
		return abilityName ~= nil and (abilityName :: string):find("Throw") ~= nil
	end

	local function ready(): boolean
		return abilityName ~= nil and workspace:GetServerTimeNow() >= readyAt
	end

	local function zoom(fov: number)
		TweenService:Create(workspace.CurrentCamera, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
			FieldOfView = fov,
		}):Play()
	end

	local function holdingMurderKnife(): boolean
		local tool = knifeInHand()
		return tool ~= nil and tool:GetAttribute("MurderKnife") == true
	end

	-- Spam Knife (always) / Hellfire (a few seconds after Q): no stab, every click throws a knife
	-- straight at the cursor
	local lastSpam = 0
	local function spamMode(): boolean
		if not holdingMurderKnife() then
			return false
		end
		local until_ = player:GetAttribute("SpamUntil")
		return type(until_) == "number" and workspace:GetServerTimeNow() < until_
	end
	local function spamThrow(at: Vector2?)
		local now = os.clock()
		if now - lastSpam < 0.1 then
			return
		end
		lastSpam = now
		local character = player.Character
		if character then
			Moves.Play(character, "Throw")
		end
		Remotes.Ability:FireServer(aimDirection(at), "Spam")
	end

	local function beginCharge(kind: string?)
		local basic = kind == "basic"
		if chargingSince or not drawKnife() then
			return
		end
		if basic and os.clock() < basicThrowReadyAt or not basic and not ready() then
			return
		end
		chargeKind = if basic then "basic" else "perk"
		chargingSince = os.clock()
		Moves.SetLocalCharge(chargingSince)
		Remotes.Charge:FireServer(true)
		crosshairGui.Enabled = true
		restoreFov = workspace.CurrentCamera.FieldOfView
		zoom(restoreFov - 10)
	end

	local function endCharge(throw: boolean)
		if not chargingSince then
			return
		end
		chargingSince = nil
		Moves.SetLocalCharge(nil)
		crosshairGui.Enabled = false
		zoom(restoreFov)
		local character = player.Character
		if throw and character and knifeInHand() then
			Moves.Play(character, "Throw")
			if chargeKind == "basic" then
				basicThrowReadyAt = os.clock() + GameConfig.MurdererThrowCooldown
				Remotes.Ability:FireServer(aimDirection(), "Throw")
			else
				Remotes.Ability:FireServer(aimDirection())
			end
		else
			Remotes.Charge:FireServer(false)
		end
	end

	-- Press: instant abilities fire; throws start charging
	local function press()
		if Ui.menuOpen() or not abilityName then
			return
		end
		if isThrow() then
			beginCharge()
		elseif ready() then
			Remotes.Ability:FireServer(aimDirection())
		end
	end
	local function release()
		endCharge(true)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or Ui.menuOpen() then
			return
		end
		if THROW_INPUTS[input.KeyCode] or THROW_INPUTS[input.UserInputType] then
			press()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if THROW_INPUTS[input.KeyCode] or THROW_INPUTS[input.UserInputType] then
			release()
		end
	end)

	-- Left click / screen tap / R2 with a knife in hand: tap = stab, hold = crank back and throw
	local primaryDown: InputObject? = nil
	local primaryAt = 0
	local function isPrimary(input: InputObject): boolean
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or Ui.menuOpen() or not isPrimary(input) or not knifeInHand() then
			return
		end
		if spamMode() then
			spamThrow(nil)
			return
		end
		primaryDown = input
		local pressedAt = os.clock()
		primaryAt = pressedAt
		task.delay(HOLD_TO_THROW, function()
			-- Still the same press, still held: it's a throw
			if primaryDown ~= input or primaryAt ~= pressedAt then
				return
			end
			if isThrow() and ready() then
				beginCharge()
			elseif holdingMurderKnife() then
				beginCharge("basic")
			end
		end)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if primaryDown ~= input then
			return
		end
		primaryDown = nil
		if chargingSince then
			release() -- it was a hold: throw
			return
		end
		local tool = knifeInHand()
		if tool then
			tool:Activate() -- it wasn't a throw: stab
		end
	end)
	-- The on-screen button: hold to charge on touch, click-hold with a mouse
	button.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			if not Ui.Phone or not isThrow() then
				press()
			end
		end
	end)
	button.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			if not Ui.Phone and isThrow() then
				release()
			end
		end
	end)

	local knifeButton = Ui.button({
		Name = "KnifeButton",
		Text = "",
		Size = UDim2.fromOffset(KNIFE_SIZE, KNIFE_SIZE),
		BackgroundColor3 = Color3.fromRGB(218, 56, 77),
		BackgroundTransparency = 0.65,
		Visible = false,
		ZIndex = 3,
	}, gui)
	local knifePadding = knifeButton:FindFirstChildOfClass("UIPadding")
	if knifePadding then
		knifePadding:Destroy()
	end
	local knifeCorner = knifeButton:FindFirstChildOfClass("UICorner") :: UICorner
	knifeCorner.CornerRadius = UDim.new(1, 0)
	local knifeBorder = knifeButton:FindFirstChildOfClass("UIStroke") :: UIStroke
	knifeBorder.Color, knifeBorder.Transparency = Color3.fromRGB(240, 250, 255), 0.2
	local knifeIcon = Ui.new("ImageLabel", {
		Name = "KnifeIcon",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(60, 52),
		Size = UDim2.fromOffset(64, 64),
		ZIndex = 3,
	}, knifeButton)
	local knifeLabel = Ui.label({
		Text = "Knife",
		TextScaled = false,
		TextSize = 14,
		Position = UDim2.fromOffset(0, 94),
		Size = UDim2.new(1, 0, 0, 20),
		ZIndex = 3,
	}, knifeButton)
	local knifeFallback = Ui.label({
		Text = "🔪",
		TextScaled = false,
		TextSize = 56,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
	}, knifeIcon)
	local chargeOutline =
		Ui.new("UIStroke", { Thickness = 3, Color = Color3.fromRGB(255, 219, 89), Enabled = false }, knifeIcon)
	Ui.corner(knifeIcon, 28)
	local chargeSegments: { Frame } = {}
	for i = 1, 24 do
		local angle = (i / 24) * math.pi * 2 - math.pi / 2
		local segment = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(60 + math.cos(angle) * 55, 60 + math.sin(angle) * 55),
			Size = UDim2.fromOffset(4, 7),
			Rotation = math.deg(angle) + 90,
			BackgroundColor3 = Color3.fromRGB(255, 219, 89),
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 4,
		}, knifeButton)
		Ui.corner(segment, 2)
		chargeSegments[i] = segment
	end
	local cancelButton = Ui.button({
		Name = "CancelKnife",
		Text = "X",
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Color3.fromRGB(43, 55, 80),
		Visible = false,
		ZIndex = 3,
	}, gui)
	local chargeHint = Ui.label({
		Text = "Release to throw",
		TextScaled = false,
		TextSize = 14,
		TextWrapped = true,
		Size = UDim2.fromOffset(150, 22),
		Visible = false,
		ZIndex = 3,
	}, gui)
	local gesture = KnifeGesture.new()
	local gestureTool: Tool? = nil
	local aimAxis = Vector2.zero
	local aimDelta = Vector2.zero
	local pointerOrigin = Vector2.zero
	local lastPointer = Vector2.zero
	local hasUsedKnife = false
	local iconTool: Tool? = nil
	local iconStarted = 0
	local fallbackImage = ""
	local function allowed(): boolean
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local stunned = player:GetAttribute("StunnedUntil")
		return humanoid ~= nil
			and humanoid.Health > 0
			and not Ui.menuOpen()
			and not player:GetAttribute("Carrying")
			and (type(stunned) ~= "number" or stunned <= workspace:GetServerTimeNow())
	end
	local function cancelKnife()
		gui:SetAttribute("KnifeGestureActive", false)
		KnifeGesture.cancel(gesture)
		gestureTool = nil
		aimAxis = Vector2.zero
		aimDelta = Vector2.zero
		primaryDown = nil
		endCharge(false)
	end
	local function knifeAvailable(): Tool?
		local held = knifeInHand()
		if held then
			return held
		end
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			for _, tool in backpack:GetChildren() do
				if isKnife(tool) then
					return tool :: Tool
				end
			end
		end
		return nil
	end
	local function positionControls()
		local at = Ui.Layout.knifePosition()
		local x, y = at.X, at.Y
		local factor = Ui.Scale.Scale
		knifeButton.Position = UDim2.fromOffset(x / factor, y / factor)
		knifeButton.Size = UDim2.fromOffset(KNIFE_SIZE / factor, KNIFE_SIZE / factor)
		local aiming = gesture.mode == "charging" or gesture.mode == "spam"
		local center = KNIFE_SIZE / 2
		local knob = if aiming then Vector2.new(center, center) + aimAxis * 40 else Vector2.new(center, center - 8)
		knifeIcon.Position = UDim2.fromOffset(knob.X / factor, knob.Y / factor)
		local iconSize = if aiming then 80 else 104
		knifeIcon.Size = UDim2.fromOffset(iconSize / factor, iconSize / factor)
		knifeFallback.TextSize = 56 / factor
		knifeLabel.Position = UDim2.fromOffset(0, (KNIFE_SIZE - 26) / factor)
		knifeLabel.Size = UDim2.new(1, 0, 0, 20 / factor)
		knifeLabel.TextSize = 18 / factor
		for i, segment in chargeSegments do
			local angle = (i / 24) * math.pi * 2 - math.pi / 2
			local radius = center - 5
			segment.Position = UDim2.fromOffset(
				(center + math.cos(angle) * radius) / factor,
				(center + math.sin(angle) * radius) / factor
			)
			segment.Size = UDim2.fromOffset(4 / factor, 9 / factor)
		end
		cancelButton.Position = UDim2.fromOffset((x + KNIFE_SIZE - 44) / factor, (y - 56) / factor)
		cancelButton.Size = UDim2.fromOffset(44 / factor, 44 / factor)
		local _, bounds = Ui.bounds()
		local hintX = x + KNIFE_SIZE + 12
		chargeHint.Position = UDim2.fromOffset(hintX / factor, (y - 44) / factor)
		chargeHint.Size = UDim2.fromOffset(math.max(44, math.min(112, bounds.X - hintX - 12)) / factor, 32 / factor)
		chargeHint.TextSize = 14 / factor
		if Ui.Phone then
			local padding = button:FindFirstChildOfClass("UIPadding")
			if padding then
				padding:Destroy()
			end
			button.AnchorPoint = Vector2.zero
			button.Position = UDim2.fromOffset((x - 76) / factor, (y + 8) / factor)
			button.Size = UDim2.fromOffset(64 / factor, 64 / factor)
			buttonIcon.Position, buttonIcon.Size =
				UDim2.fromOffset(4 / factor, 4 / factor), UDim2.fromOffset(56 / factor, 40 / factor)
			button.TextYAlignment = Enum.TextYAlignment.Bottom
			button.TextSize, button.TextScaled, button.TextTruncate = 14 / factor, false, Enum.TextTruncate.AtEnd
		end
	end
	knifeButton.InputBegan:Connect(function(input)
		if
			input.UserInputType ~= Enum.UserInputType.Touch
			and not (Ui.Phone and input.UserInputType == Enum.UserInputType.MouseButton1)
		then
			return
		end
		if not allowed() or gesture.owner ~= nil then
			return
		end
		local tool = drawKnife()
		if not tool then
			return
		end
		if KnifeGesture.press(gesture, input, os.clock()) then
			gui:SetAttribute("KnifeGestureActive", true)
			gestureTool = tool
			lastPointer = Vector2.new(input.Position.X, input.Position.Y)
			pointerOrigin = lastPointer
			hasUsedKnife = true
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local previewMouse = RunService:IsStudio()
			and gesture.owner ~= nil
			and gesture.owner.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		if input ~= gesture.owner and not previewMouse then
			return
		end
		local at = Vector2.new(input.Position.X, input.Position.Y)
		local pos, size = cancelButton.AbsolutePosition, cancelButton.AbsoluteSize
		if
			cancelButton.Visible
			and at.X >= pos.X
			and at.X <= pos.X + size.X
			and at.Y >= pos.Y
			and at.Y <= pos.Y + size.Y
		then
			cancelKnife()
			return
		end
		aimDelta += at - lastPointer
		lastPointer = at
		aimAxis = KnifeAim.Axis(at, pointerOrigin)
	end)
	local function applyKnifeAim()
		if gesture.owner == nil or aimDelta == Vector2.zero then
			return
		end
		local camera = workspace.CurrentCamera
		camera.CFrame = KnifeAim.Rotate(
			camera.CFrame,
			camera.Focus.Position,
			aimDelta,
			UserSettings().GameSettings:GetCameraYInvertValue()
		)
		aimDelta = Vector2.zero
	end
	UserInputService.InputEnded:Connect(function(input)
		if input ~= gesture.owner then
			return
		end
		-- Consume the final movement before sampling the release crosshair.
		applyKnifeAim()
		-- Input may end between render ticks on a slow phone. Resolve the threshold first.
		local canCharge = if holdingMurderKnife() then os.clock() >= basicThrowReadyAt else isThrow() and ready()
		local pending = KnifeGesture.tick(gesture, os.clock(), canCharge, spamMode())
		if allowed() and gestureTool == knifeInHand() then
			if pending == "charge" then
				beginCharge(if holdingMurderKnife() then "basic" else "perk")
			elseif pending == "spam" then
				spamThrow(nil)
			end
		end
		local action = KnifeGesture.release(gesture, input, os.clock(), spamMode())
		if allowed() and gestureTool == knifeInHand() then
			if action == "swing" then
				(gestureTool :: Tool):Activate()
			elseif action == "throw" then
				endCharge(true)
			elseif action == "spam" then
				spamThrow(nil)
			end
		end
		cancelKnife()
	end)
	UserInputService.WindowFocusReleased:Connect(cancelKnife)
	gui:GetAttributeChangedSignal("MenuOpen"):Connect(function()
		if Ui.menuOpen() then
			cancelKnife()
		end
	end)
	player:GetAttributeChangedSignal("InRound"):Connect(cancelKnife)
	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(cancelKnife)
	player:GetAttributeChangedSignal("StunnedUntil"):Connect(function()
		if not allowed() then
			cancelKnife()
		end
	end)
	player:GetAttributeChangedSignal("Carrying"):Connect(function()
		if not allowed() then
			cancelKnife()
		end
	end)
	player.CharacterAdded:Connect(cancelKnife)
	cancelButton.Activated:Connect(cancelKnife)
	RunService:BindToRenderStep("KnifeThumbAim", Enum.RenderPriority.Camera.Value + 1, applyKnifeAim)
	RunService.RenderStepped:Connect(function()
		local available = knifeAvailable()
		knifeButton.Visible = Ui.Phone and allowed() and available ~= nil
		if gesture.owner ~= nil and (not allowed() or gestureTool ~= knifeInHand()) then
			cancelKnife()
		end
		if Ui.Phone then
			positionControls()
			button.Visible = allowed() and abilityName ~= nil and not isThrow()
			perkCard.Visible = false
		end
		if not knifeButton.Visible then
			if Ui.Phone then
				cancelKnife()
			end
			cancelButton.Visible = false
			chargeHint.Visible = false
			return
		end
		if available ~= iconTool then
			iconTool, iconStarted = available, os.clock()
			knifeIcon.Image = if available then available.TextureId else ""
			local item = if available
				then available:GetAttribute("HubKnife") or player:GetAttribute("Equipped")
				else nil
			local parsed = if type(item) == "string" then Items.Parse(item) else nil
			fallbackImage = if parsed then Artwork[parsed.Knife.Name] or "" else ""
		end
		if not knifeIcon.IsLoaded and os.clock() - iconStarted > 8 and fallbackImage ~= "" then
			knifeIcon.Image = fallbackImage
		end
		knifeFallback.Visible = knifeIcon.Image == "" or not knifeIcon.IsLoaded
		local canCharge = if holdingMurderKnife() then os.clock() >= basicThrowReadyAt else isThrow() and ready()
		local action = KnifeGesture.tick(gesture, os.clock(), canCharge, spamMode())
		if action == "charge" then
			beginCharge(if holdingMurderKnife() then "basic" else "perk")
		elseif action == "spam" then
			spamThrow(nil)
		end
		cancelButton.Visible = gesture.mode == "charging" or gesture.mode == "spam"
		chargeHint.Visible = gesture.mode == "charging" or gesture.mode == "spam" or not hasUsedKnife
		chargeHint.Text = if gesture.mode == "charging"
			then "Release to throw"
			elseif gesture.mode == "spam" then "Drag: aim\nHold: throw"
			elseif spamMode() then "Tap: throw\nHold: repeat"
			else "Tap: stab\nHold: aim"
		knifeLabel.Text = if gesture.mode == "charging"
			then "Throw"
			elseif gesture.mode == "blocked" then "Wait"
			else "Knife"
		knifeButton.BackgroundColor3 = if gesture.owner
			then Color3.fromRGB(61, 178, 255)
			else Color3.fromRGB(218, 56, 77)
		knifeButton.BackgroundTransparency = if gesture.owner then 0.4 else 0.65
		knifeIcon.BackgroundColor3 = Color3.fromRGB(61, 178, 255)
		knifeIcon.BackgroundTransparency = if gesture.mode == "charging" or gesture.mode == "spam" then 0.35 else 1
		chargeOutline.Enabled = chargingSince ~= nil
		local fraction = if chargingSince
			then math.clamp((os.clock() - chargingSince) / AnimLibrary.ChargeTime, 0, 1)
			else 0
		for i, segment in chargeSegments do
			segment.Visible = chargingSince ~= nil
			segment.BackgroundTransparency = if i / 24 <= fraction then 0 else 0.8
		end
		chargeOutline.Thickness = if chargingSince
			then 2 + 4 * math.clamp((os.clock() - chargingSince) / AnimLibrary.ChargeTime, 0, 1)
			else 2
	end)

	Remotes:WaitForChild("AbilityState").OnClientEvent:Connect(function(name: string?, until_: number?)
		-- The hub knife's throw never belongs in a round (a late message can't bring it back)
		if name == "Throw Knife" and player:GetAttribute("InRound") then
			name = nil
		end
		abilityName = name
		readyAt = until_ or 0
		-- The hub throw is "hold click" with a mouse: the big button is only needed on touch screens
		button.Visible = name ~= nil and (Ui.Phone or name ~= "Throw Knife")
		button.BackgroundColor3 = if name == "Smoke Bomb"
			then Color3.fromRGB(120, 120, 140)
			else Color3.fromRGB(200, 40, 60)
		if not name then
			endCharge(false)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if Ui.menuOpen() then
			button.Visible = false
			perkCard.Visible = false
			crosshairGui.Enabled = false
			endCharge(false)
			return
		end
		-- Button label + cooldown
		if abilityName then
			local left = readyAt - workspace:GetServerTimeNow()
			local key = if UserInputService.PreferredInput == Enum.PreferredInput.Gamepad
				then "LT"
				elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then "Hold"
				else if isThrow() then "Hold Click" else "Q"
			if chargingSince then
				button.Text = "Release to throw!"
				button.BackgroundTransparency = 0
			elseif left > 0 then
				button.Text = `{abilityName}  {math.ceil(left)}s`
				button.BackgroundTransparency = 0.4
			else
				button.Text = if Ui.Phone then abilityName :: string else `[{key}] {abilityName}`
				button.BackgroundTransparency = 0
			end
		end
		-- Spam mode: a red crosshair on the cursor the whole time the knife is out
		if not chargingSince then
			local spamming = spamMode()
			crosshairGui.Enabled = spamming
			if spamming then
				local at = screenAim()
				ring.Position = UDim2.fromOffset(at.X, at.Y)
				ring.Size = UDim2.fromOffset(40, 40)
				ringStroke.Color = Color3.fromRGB(255, 70, 70)
				fill.Size = UDim2.fromScale(0.3, 0.3)
				fill.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
			end
		end
		-- Crosshair follows the aim point; the ring fills as the arm cranks back
		if chargingSince then
			if not knifeInHand() then
				endCharge(false)
				return
			end
			local fraction = math.clamp((os.clock() - chargingSince) / AnimLibrary.ChargeTime, 0, 1)
			local at = screenAim()
			ring.Position = UDim2.fromOffset(at.X, at.Y)
			fill.Size = UDim2.fromScale(0.15 + 0.85 * fraction, 0.15 + 0.85 * fraction)
			local full = fraction >= 1
			ringStroke.Color = if full then Color3.fromRGB(255, 70, 70) else Color3.new(1, 1, 1)
			fill.BackgroundColor3 = if full then Color3.fromRGB(255, 70, 70) else Color3.fromRGB(255, 220, 120)
			local pulse = if full then 1 + math.sin(os.clock() * 20) * 0.08 else 1
			ring.Size = UDim2.fromOffset(46 * pulse, 46 * pulse)
		end
	end)

	-- Who the Murderer's swing is at, as this screen sees it: the nearest living character in
	-- front (or right next to you). The server re-checks it with a little extra reach for lag.
	local function stabTarget(character: Model): Model?
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return nil
		end
		local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		local best: Model?, bestScore = nil, math.huge
		local seen: { [Model]: boolean } = {}
		for _, part in workspace:GetPartBoundsInRadius(root.Position, GameConfig.AttackRange + 3, params) do
			local model = part:FindFirstAncestorOfClass("Model")
			local humanoid = model and model:FindFirstChildOfClass("Humanoid")
			local targetRoot = model and model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not model or seen[model] or not humanoid or humanoid.Health <= 0 or not targetRoot then
				continue
			end
			seen[model] = true
			local offset = targetRoot.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local dist = flat.Magnitude
			local facing = if dist > 0.1 then look:Dot(flat.Unit) else 1
			if dist > GameConfig.AttackRange + 2.5 or (facing < 0.1 and dist > 4) then
				continue
			end
			local score = dist * (2 - facing) -- prefer whoever is straight ahead
			if score < bestScore then
				best, bestScore = model, score
			end
		end
		return best
	end

	-- Knife swings: animate the instant you click (same combo order as the server)
	local function wireKnife(tool: Tool)
		tool.ManualActivationOnly = true
		tool.Unequipped:Connect(cancelKnife)
		if tool:GetAttribute("Wired") then
			return
		end
		tool:SetAttribute("Wired", true)
		tool.Activated:Connect(function()
			local character = player.Character
			if not character or chargingSince or Ui.menuOpen() or not allowed() or spamMode() then
				return
			end
			local now = os.clock()
			local cooldown = if tool:GetAttribute("MurderKnife")
				then GameConfig.AttackCooldown
				else GameConfig.SwingCooldown
			if now - lastSwing < cooldown then
				return
			end
			comboIndex = if now - lastSwing > 1.2 then 1 else comboIndex % #COMBO + 1
			lastSwing = now
			Moves.Play(character, COMBO[comboIndex])
			if tool:GetAttribute("MurderKnife") then
				Remotes.Stab:FireServer(stabTarget(character))
			end
		end)
	end

	-- Revolver: every tool with the Revolver attribute fires at the aim point when activated
	local function watchTool(tool: Instance)
		if not tool:IsA("Tool") then
			return
		end
		if isKnife(tool) then
			wireKnife(tool)
		elseif tool:GetAttribute("Revolver") and not tool:GetAttribute("Wired") then
			tool:SetAttribute("Wired", true)
			tool.Activated:Connect(function()
				if not Ui.menuOpen() then
					Remotes.Shoot:FireServer(aimPoint())
				end
			end)
		end
	end
	local function watchContainer(container: Instance)
		for _, child in container:GetChildren() do
			watchTool(child)
		end
		container.ChildAdded:Connect(watchTool)
	end
	local function onCharacter(character: Model)
		watchContainer(character)
		cancelKnife()
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.Died:Connect(cancelKnife)
		end
	end
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
	watchContainer(player:WaitForChild("Backpack"))
	player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			watchContainer(child)
		end
	end)
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
-- Mood, on this client:
--   * music: dark ambient around the hub, drums when a raid starts, silence in rounds so you can
--     hear footsteps
--   * raids turn the sky deep red
--   * rounds: a heartbeat and a red vignette that grow as the Murderer gets close (the server sends
--     only how close, never who), Flash blinding, and the slow-motion moment when a round ends on
--     the final kill or the Murderer goes down

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local Raid = require(script.Parent.Raid)
local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local Atmosphere = {}

local function track(id: string, volume: number): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound:SetAttribute("Target", volume)
	sound.Parent = SoundService
	return sound
end

function Atmosphere.Init()
	-- Keep the camera on the character. Round disguises rebuild the body (the root part is swapped
	-- out) and the default camera loses its subject, leaving it parked back in the hub while you're
	-- teleported to the round map - a black, "paused" screen. Re-attach it whenever that happens.
	local function reattach()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local camera = workspace.CurrentCamera
		if not humanoid or not root then
			return
		end
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = nil
		camera.CameraSubject = humanoid
		-- Snap behind them straight away instead of gliding across the map
		if (camera.CFrame.Position - root.Position).Magnitude > 40 then
			camera.CFrame =
				CFrame.lookAt(root.Position - root.CFrame.LookVector * 8 + Vector3.new(0, 4, 0), root.Position)
		end
	end
	local function watchCharacter(character: Model)
		character.ChildAdded:Connect(function(child)
			if child.Name == "HumanoidRootPart" or child:IsA("Humanoid") then
				task.defer(reattach)
			end
		end)
	end
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
	player:GetAttributeChangedSignal("InRound"):Connect(function()
		-- Teleports happen right around this; check again once they've landed
		for _, delay in { 0.2, 1, 2.5 } do
			task.delay(delay, reattach)
		end
	end)
	-- Belt and braces: if the camera ever ends up far from a live character, bring it back
	task.spawn(function()
		while true do
			task.wait(1)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local camera = workspace.CurrentCamera
			if
				root
				and camera.CameraType == Enum.CameraType.Custom
				and (camera.Focus.Position - root.Position).Magnitude > 60
			then
				reattach()
			end
		end
	end)

	-- Music ---------------------------------------------------------------------------------------
	local hubMusic = track(Sounds.HubMusic, 0.22)
	local raidMusic = track(Sounds.RaidMusic, 0.3)
	local heartbeat = track(Sounds.Heartbeat, 0)
	hubMusic:Play()
	local function fade(sound: Sound, volume: number)
		TweenService:Create(sound, TweenInfo.new(1.5), { Volume = volume }):Play()
		if volume > 0 and not sound.IsPlaying then
			sound:Play()
		end
	end
	local function refreshMusic()
		local inRound = player:GetAttribute("InRound") == true
		local raid = ReplicatedStorage:GetAttribute("Raid") == true
		fade(hubMusic, if inRound or raid then 0 else hubMusic:GetAttribute("Target") :: number)
		fade(raidMusic, if raid and not inRound then raidMusic:GetAttribute("Target") :: number else 0)
	end
	player:GetAttributeChangedSignal("InRound"):Connect(refreshMusic)
	ReplicatedStorage:GetAttributeChangedSignal("Raid"):Connect(refreshMusic)
	refreshMusic()

	-- Raids: the sky goes deep red -----------------------------------------------------------------
	local raidTint = new("ColorCorrectionEffect", {
		Name = "RaidTint",
		TintColor = Color3.new(1, 1, 1),
	}, Lighting)
	local tintTween: Tween? = nil
	local skyTween: Tween? = nil
	local function refreshSky()
		local raid = ReplicatedStorage:GetAttribute("Raid") == true and not player:GetAttribute("InRound")
		if tintTween then
			tintTween:Cancel()
		end
		local nextTint = TweenService:Create(raidTint, TweenInfo.new(0.5), {
			TintColor = if raid then Color3.fromRGB(255, 225, 210) else Color3.new(1, 1, 1),
			Contrast = if raid then 0.06 else 0,
		})
		tintTween = nextTint
		nextTint:Play()
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			if skyTween then
				skyTween:Cancel()
			end
			local nextSky = TweenService:Create(atmosphere, TweenInfo.new(0.5), {
				Color = if raid
					then Color3.fromRGB(215, 145, 125)
					else atmosphere:GetAttribute("HubColor") or atmosphere.Color,
				Decay = if raid
					then Color3.fromRGB(142, 101, 104)
					else atmosphere:GetAttribute("HubDecay") or atmosphere.Decay,
			})
			skyTween = nextSky
			nextSky:Play()
		end
		if raid then
			Effects.Sound(Sounds.Alarm, nil, 0.35)
		end
	end
	ReplicatedStorage:GetAttributeChangedSignal("Raid"):Connect(refreshSky)
	player:GetAttributeChangedSignal("InRound"):Connect(refreshSky)
	refreshSky()

	-- Dread: heartbeat + red vignette as the Murderer closes in ---------------------------------
	local dreadGui = new("ScreenGui", {
		Name = "Dread",
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		ResetOnSpawn = false,
	}, player:WaitForChild("PlayerGui"))
	local setDread = Raid.Vignette(dreadGui, Color3.fromRGB(150, 0, 10))
	RunService.RenderStepped:Connect(function()
		local dread = player:GetAttribute("Dread")
		local level = if type(dread) == "number" and player:GetAttribute("InRound") then dread else 0
		-- Pulse with the heartbeat
		local pulse = 0.75 + 0.25 * math.abs(math.sin(os.clock() * (2.5 + level * 3)))
		setDread(level * pulse)
		heartbeat.Volume += ((level * 0.9) - heartbeat.Volume) * 0.05
		heartbeat.PlaybackSpeed = 0.9 + level * 0.5
		if level > 0.05 and not heartbeat.IsPlaying then
			heartbeat:Play()
		elseif level <= 0.01 and heartbeat.IsPlaying and heartbeat.Volume < 0.02 then
			heartbeat:Stop()
		end
	end)

	-- Flash blinding: a white-out that fades ---------------------------------------------------------
	local whiteout = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
	}, dreadGui)

	-- The final moment: slow-motion feel (FOV punch, desaturate, big text) ------------------------
	local finalLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(800, 100),
		Font = Ui.SPOOKY,
		Text = "",
		TextTransparency = 1,
		ZIndex = 51,
	}, dreadGui)
	Ui.textStroke(finalLabel, 4)
	local finalGrade = new("ColorCorrectionEffect", { Name = "FinalMoment", Enabled = false }, Lighting)
	local function resetRoundEffects()
		if not player:GetAttribute("InRound") then
			finalGrade.Enabled = false
			whiteout.BackgroundTransparency = 1
		end
	end
	player:GetAttributeChangedSignal("InRound"):Connect(resetRoundEffects)
	player.CharacterAdded:Connect(resetRoundEffects)

	Remotes.Effect.OnClientEvent:Connect(function(kind: string, ...)
		if kind == "Blinded" then
			local duration = ...
			whiteout.BackgroundTransparency = 0
			Effects.Sound(Sounds.Flash, nil, 1)
			TweenService:Create(
				whiteout,
				TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ BackgroundTransparency = 1 }
			):Play()
		elseif kind == "FinalKill" then
			if not player:GetAttribute("InRound") then
				return
			end
			local position, why = ...
			local camera = workspace.CurrentCamera
			finalLabel.Text = if why == "Hero" then "THE MURDERER IS DOWN!" else "FINAL KILL"
			finalLabel.TextColor3 = if why == "Hero" then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 50, 60)
			finalLabel.TextTransparency = 0
			local stroke = finalLabel:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Transparency = 0
			end
			finalGrade.Enabled = true
			finalGrade.Saturation = -0.8
			finalGrade.Contrast = 0.3
			Effects.Sound(Sounds.Sting, nil, 0.9)
			Effects.Shake(3, 0.6)
			local oldFov = camera.FieldOfView
			camera.FieldOfView = oldFov - 22
			TweenService:Create(camera, TweenInfo.new(1.8, Enum.EasingStyle.Sine), { FieldOfView = oldFov }):Play()
			Effects.Burst(
				position,
				if why == "Hero" then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(200, 0, 20),
				80,
				30,
				1.2
			)
			task.delay(1.8, function()
				TweenService:Create(finalGrade, TweenInfo.new(0.8), { Saturation = 0, Contrast = 0 }):Play()
				TweenService:Create(finalLabel, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.8), { Transparency = 1 }):Play()
				end
				task.wait(0.8)
				finalGrade.Enabled = false
			end)
		end
	end)
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">CaseOdds</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation mirrors Items.OpenCase and the current replicated luck multipliers.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Items)
local Knives = require(Shared.Config.Knives)
local player = Players.LocalPlayer
local Odds = {}
local function pct(n: number): string
	return (string.format("%.3f", n):gsub("0+$", ""):gsub("%.$", "")) .. "%"
end

function Odds.Text(rarity: string): string
	local pool = Knives.ByRarity[rarity]
	local nextRarity = Knives.Rarities[(table.find(Knives.Rarities, rarity) or 1) + 1]
	local inside = {}
	for _, knife in pool do
		table.insert(inside, `{knife.DisplayName} {pct((if nextRarity then 96 else 100) / #pool)}`)
	end
	if nextRarity then
		for _, knife in Knives.ByRarity[nextRarity] do
			table.insert(inside, `{knife.DisplayName} {pct(4 / #Knives.ByRarity[nextRarity])}`)
		end
	end
	local luck = 1 + (player:GetAttribute("Rebirths") or 0) * GameConfig.Rebirth.LuckBonus
	local untilLuck = ReplicatedStorage:GetAttribute("ServerLuckUntil")
	if type(untilLuck) == "number" and untilLuck > workspace:GetServerTimeNow() then
		luck *= (ReplicatedStorage:GetAttribute("ServerLuckMultiplier") or 2)
	end
	local mutationTotal, sizeTotal = 0, 0
	for _, m in Items.Mutations do
		mutationTotal += m.Weight * (if m.Rank > 0 then luck else 1)
	end
	for _, s in Items.Sizes do
		sizeTotal += s.Weight * (if s.Rank > 0 then luck else 1)
	end
	local mutations, sizes = {}, {}
	for _, m in Items.Mutations do
		table.insert(
			mutations,
			`{if m.Rank == 0 then "None" else m.DisplayName} {pct(
				m.Weight * (if m.Rank > 0 then luck else 1) / mutationTotal * 100
			)}`
		)
	end
	for _, s in Items.Sizes do
		table.insert(
			sizes,
			`{if s.Id == "" then "Normal" else s.DisplayName} {pct(
				s.Weight * (if s.Rank > 0 then luck else 1) / sizeTotal * 100
			)}`
		)
	end
	return `{table.concat(inside, " · ")}\nMutations: {table.concat(mutations, " · ")}\nSizes: {table.concat(
		sizes,
		" · "
	)}`
end

return Odds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">CaseShowcase</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local View = {}

function View.Build(
	parent: Instance,
	rarity: string,
	price: string,
	purchase: () -> (),
	odds: () -> (),
	height: number?
): Frame
	local color = Knives.RarityColors[rarity]
	local row = Theme.surface(
		parent,
		{ Name = rarity .. "Case", Size = UDim2.new(1, -8, 0, height or 346), ZIndex = 7 },
		Theme.Navy,
		color
	)
	Theme.text(row, rarity:upper() .. " CASE", {
		Name = "CaseTitle",
		Position = UDim2.fromOffset(12, 2),
		Size = UDim2.new(1, -24, 0, 60),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color,
		MaximumTextSize = 52,
		ZIndex = 10,
	})
	local chest = Ui.new("Frame", {
		Position = UDim2.fromOffset(4, 62),
		Size = UDim2.new(0.33, 0, 1, -68),
		BackgroundTransparency = 1,
		ZIndex = 7,
	}, row)
	Theme.burst(chest, color)
	Theme.image(chest, "Case" .. rarity, { Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 1), ZIndex = 9 })
	local rewards = Ui.new("Frame", {
		Name = "Rewards",
		Position = UDim2.new(0.34, 0, 0, 66),
		Size = UDim2.new(0.65, -6, 1, -154),
		BackgroundTransparency = 1,
		ZIndex = 7,
	}, row)
	local nextRarity = Knives.Rarities[(table.find(Knives.Rarities, rarity) or 1) + 1]
	local count = #Knives.ByRarity[rarity] + (if nextRarity then #Knives.ByRarity[nextRarity] else 0)
	Ui.new("UIGridLayout", {
		CellSize = UDim2.new(1 / count, -6, 1, -4),
		CellPadding = UDim2.fromOffset(6, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, rewards)
	local order = 0
	for _, tier in { rarity, nextRarity } do
		if not tier then
			continue
		end
		for _, knife in Knives.ByRarity[tier] do
			order += 1
			local tile = Theme.surface(
				rewards,
				{ Name = knife.Name, LayoutOrder = order, ZIndex = 8 },
				Knives.RarityColors[tier]
			)
			Theme.image(
				tile,
				knife.Name,
				{ Name = "Knife", Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, -36), ZIndex = 9 }
			)
			local percent = (if tier == rarity then (if nextRarity then 96 else 100) else 4) / #Knives.ByRarity[tier]
			local value = string.format("%.2f", percent):gsub("0+$", ""):gsub("%.$", "")
			Theme.text(tile, value .. "%", {
				Name = "Odds",
				Position = UDim2.new(0, 0, 1, -38),
				Size = UDim2.new(1, 0, 0, 36),
				MaximumTextSize = 30,
				ZIndex = 10,
			})
		end
	end
	Theme.button(row, "Full odds", Theme.Cyan, {
		Name = "FullOdds",
		Position = UDim2.new(0.60, -8, 1, -66),
		Size = UDim2.new(0.12, 0, 0, 54),
		MaximumTextSize = 23,
		ZIndex = 10,
	}, odds)
	Theme.button(row, price, Theme.Green, {
		Name = "Purchase",
		Position = UDim2.new(0.73, -4, 1, -74),
		Size = UDim2.new(0.27, -8, 0, 64),
		MaximumTextSize = 50,
		ZIndex = 10,
	}, purchase, if price:sub(1, 1) == "$" then "Cash" else nil)
	return row
end

return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetic effects the server asks for through Remotes.Effect (sounds, particle bursts, bullet
-- tracers), plus local-only polish: spinning coins and pickups, and hiding other players' "Sell"
-- prompts on their racks. Nothing here affects gameplay.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Knives = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Knives"))
local Sounds = require(ReplicatedStorage.Shared.Config:WaitForChild("Sounds"))
local GameConfig = require(ReplicatedStorage.Shared.Config:WaitForChild("GameConfig"))
local Props = require(ReplicatedStorage.Shared:WaitForChild("Props"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))
local Items = require(ReplicatedStorage.Shared:WaitForChild("Items"))
local KnifeModel = require(ReplicatedStorage.Shared:WaitForChild("KnifeModel"))
local Lod = require(script.Parent.Lod)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Effects = {}

local function anchorAt(position: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one * 0.2
	p.Position = position
	p.Parent = workspace
	Debris:AddItem(p, 4)
	return p
end

-- 2D sound (UI) when position is nil, otherwise a 3D sound at that spot
function Effects.Sound(id: string, position: Vector3?, volume: number?)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.7
	if position then
		sound.RollOffMaxDistance = 120
		sound.Parent = anchorAt(position)
		sound:Play()
	else
		SoundService:PlayLocalSound(sound)
		sound.Parent = SoundService
		Debris:AddItem(sound, 4)
	end
end

function Effects.Burst(position: Vector3, color: Color3, count: number, speed: number?, size: number?)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.4
	emitter.Size = NumberSequence.new(size or 0.6, 0)
	emitter.Speed = NumberRange.new((speed or 12) * 0.5, speed or 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Drag = 3
	emitter.Enabled = false
	emitter.Parent = anchorAt(position)
	emitter:Emit(count)
end

local function smoke(position: Vector3)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Speed = NumberRange.new(3, 8)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(1.5, 2.5)
	emitter.Enabled = false
	emitter.Parent = anchorAt(position)
	emitter:Emit(30)
end

local function tracer(from: Vector3, to: Vector3)
	local length = (to - from).Magnitude
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 230, 120)
	beam.Size = Vector3.new(0.15, 0.15, length)
	beam.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -length / 2)
	beam.Parent = workspace
	TweenService:Create(beam, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	Debris:AddItem(beam, 0.3)
end

-- Floating "+$5" text over a spot, only for the local player
function Effects.FloatText(position: Vector3, text: string, color: Color3)
	local holder = anchorAt(position)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(4, 1.5)
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui
	TweenService:Create(gui, TweenInfo.new(1), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
end

-- Coins ---------------------------------------------------------------------------------------
-- The pickup plays the moment you touch a coin (the server confirms and pays a beat later): the
-- coin flies into you and shrinks, and the chime climbs while you keep a streak going.

local GOLD = Color3.fromRGB(255, 215, 60)
local COIN_STREAK_WINDOW = 1.6
local coinStreak, lastCoinAt, lastCoinPredicted = 0, 0, 0

local function coinChime()
	local now = os.clock()
	coinStreak = if now - lastCoinAt < COIN_STREAK_WINDOW then math.min(coinStreak + 1, 10) else 0
	lastCoinAt = now
	local sound = Instance.new("Sound")
	sound.SoundId = Sounds.Coin
	sound.Volume = 0.5
	sound.PlaybackSpeed = 1 + coinStreak * 0.06
	SoundService:PlayLocalSound(sound)
	sound.Parent = SoundService
	Debris:AddItem(sound, 3)
end

local function flyCoinIn(coin: Model)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local ghost = coin:Clone()
	for _, d in ghost:GetDescendants() do
		if d:IsA("ParticleEmitter") or d:IsA("Light") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanTouch = false
		end
	end
	ghost:RemoveTag("Coin")
	ghost.Parent = workspace
	local start = coin:GetPivot()
	local started = os.clock()
	local duration = 0.22
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		local t = math.min((os.clock() - started) / duration, 1)
		local target = if root and root.Parent then root.Position + Vector3.new(0, 1, 0) else start.Position
		local eased = t * t
		local position = start.Position:Lerp(target, eased) + Vector3.new(0, math.sin(t * math.pi) * 1.5, 0)
		ghost:PivotTo(CFrame.new(position) * CFrame.Angles(0, os.clock() * 18, 0))
		ghost:ScaleTo(math.max(1 - t * 0.7, 0.05))
		if t >= 1 then
			connection:Disconnect()
			ghost:Destroy()
			Effects.Burst(target, GOLD, 8, 8, 0.35)
		end
	end)
end

-- Hooks a coin the server just spawned: a glint when it appears, local pickup when touched
local function trackCoin(coin: Instance)
	if not coin:IsA("Model") then
		return
	end
	local hitbox = coin:WaitForChild("Hitbox", 5) :: BasePart?
	if not hitbox then
		return
	end
	if (hitbox.Position - (workspace.CurrentCamera :: Camera).CFrame.Position).Magnitude < 150 then
		Effects.Burst(hitbox.Position, GOLD, 6, 4, 0.4)
	end
	local taken = false
	hitbox.Touched:Connect(function(other)
		local character = player.Character
		if taken or not character or not other:IsDescendantOf(character) then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		taken = true
		lastCoinPredicted = os.clock()
		coinChime()
		flyCoinIn(coin)
		-- Hide our copy now; the server removes the real one when it pays out
		for _, d in coin:GetDescendants() do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			elseif d:IsA("ParticleEmitter") or d:IsA("Light") then
				(d :: any).Enabled = false
			end
		end
	end)
end

-- Short camera shake (hits you land and hits you take)
local shakeUntil, shakeStrength = 0, 0
function Effects.Shake(strength: number, duration: number)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
	shakeStrength = math.max(if os.clock() < shakeUntil then shakeStrength else 0, strength)
end
RunService:BindToRenderStep("KnifeShake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeUntil - os.clock()
	if left <= 0 then
		shakeStrength = 0
		return
	end
	local s = shakeStrength * math.min(1, left * 6)
	local camera = workspace.CurrentCamera
	camera.CFrame *= CFrame.Angles(
		math.rad((math.random() - 0.5) * s),
		math.rad((math.random() - 0.5) * s),
		math.rad((math.random() - 0.5) * s * 0.5)
	)
end)

-- Full-screen red flash, optionally with big text ("YOU DIED")
local function flash(text: string?, strength: number, duration: number)
	local gui = Instance.new("ScreenGui")
	gui.Name = "Flash"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- a white flash, not a red one
	frame.BackgroundTransparency = 1 - strength
	frame.Parent = gui
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
	if text then
		local label = Instance.new("TextLabel")
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.45)
		label.Size = UDim2.fromScale(0.6, 0.16)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.Text = text
		label.Parent = frame
		TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end
	Debris:AddItem(gui, duration + 0.1)
end

-- Chunks flying off something that broke (gates, barricades): real little parts, client-only
local function debris(position: Vector3, color: Color3, material: Enum.Material, count: number)
	for _ = 1, count do
		local chunk = Instance.new("Part")
		chunk.Size = Vector3.new(math.random(4, 10) / 10, math.random(4, 10) / 10, math.random(4, 14) / 10)
		chunk.CFrame = CFrame.new(
			position + Vector3.new(math.random(-20, 20) / 10, math.random(0, 30) / 10, math.random(-20, 20) / 10)
		) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		chunk.Color = color
		chunk.Material = material
		chunk.CanCollide = true
		chunk.CanQuery = false
		chunk.CanTouch = false
		chunk.AssemblyLinearVelocity = Vector3.new(math.random(-30, 30), math.random(15, 40), math.random(-30, 30))
		chunk.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
		chunk.Parent = workspace
		Debris:AddItem(chunk, 3)
		task.delay(2.2, function()
			if chunk.Parent then
				TweenService:Create(chunk, TweenInfo.new(0.7), { Transparency = 1 }):Play()
			end
		end)
	end
end

-- A quick burst of light
local function lightFlash(position: Vector3, color: Color3, brightness: number, range: number, duration: number)
	local holder = anchorAt(position)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = holder
	TweenService:Create(light, TweenInfo.new(duration, Enum.EasingStyle.Quad), { Brightness = 0 }):Play()
end

-- A pillar of light shooting up from a spot (rebirths, chests)
local function pillar(position: Vector3, color: Color3, height: number, duration: number)
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Shape = Enum.PartType.Cylinder
	beam.Material = Enum.Material.Neon
	beam.Color = color
	beam.Transparency = 0.2
	beam.Size = Vector3.new(0.5, 6, 6)
	beam.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	beam.Parent = workspace
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(beam, info, {
		Size = Vector3.new(height, 1, 1),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Transparency = 1,
	}):Play()
	Debris:AddItem(beam, duration + 0.1)
end

-- A copy of a knife flying in an arc from `from` to `to` (placing it, equipping it)
local function flyKnife(item: string, from: Vector3, to: Vector3, duration: number, length: number)
	local model = KnifeModel.Build(item, true)
	KnifeModel.FitLength(model, length)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("Trail") then
			d.Enabled = true
		end
	end
	model.Parent = workspace
	local start = os.clock()
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - start) / duration)
		local eased = 1 - (1 - t) ^ 2
		local at = from:Lerp(to, eased) + Vector3.new(0, math.sin(t * math.pi) * 3, 0)
		model:PivotTo(CFrame.new(at) * CFrame.Angles(0, t * math.pi * 2, math.rad(20)))
		if t >= 1 then
			connection:Disconnect()
			model:Destroy()
		end
	end)
end

local handlers: { [string]: (...any) -> () } = {
	-- Double Trouble: your fellow Murderer, outlined red for you only, for the round
	Partner = function(character: Model?, name: string)
		if not character then
			return
		end
		local highlight = Instance.new("Highlight")
		highlight.Name = "PartnerOutline"
		highlight.FillTransparency = 1
		highlight.OutlineColor = Color3.fromRGB(255, 40, 60)
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = character
		highlight.Parent = character
		Effects.FloatText(
			(character:GetPivot()).Position + Vector3.new(0, 5, 0),
			`🔪 Partner: {name}`,
			Color3.fromRGB(255, 80, 90)
		)
		local connection: RBXScriptConnection
		connection = player:GetAttributeChangedSignal("InRound"):Connect(function()
			if not player:GetAttribute("InRound") then
				connection:Disconnect()
				highlight:Destroy()
			end
		end)
	end,
	-- A Murderer power rolled on a knife you just got (or stole from the Sheriff-shot Murderer)
	PowerRoll = function(item: string, power: string, oneIn: number)
		local perk = GameConfig.Perks[power]
		local gui = Instance.new("ScreenGui")
		gui.Name = "PowerRoll"
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 45
		gui.Parent = player:WaitForChild("PlayerGui")
		local rare = oneIn >= 300
		local color = if oneIn >= 1000
			then Color3.fromRGB(255, 80, 200)
			elseif rare then Color3.fromRGB(255, 120, 60)
			else Color3.fromRGB(255, 220, 90)
		local function line(text: string, y: number, height: number, c: Color3): TextLabel
			local label = Instance.new("TextLabel")
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromScale(0.5, y)
			label.Size = UDim2.fromOffset(760, height)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = c
			label.Text = text
			label.Parent = gui
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 3
			stroke.Color = Color3.fromRGB(20, 16, 26)
			stroke.Parent = label
			return label
		end
		local labels = {
			line("✨ MURDERER POWER! ✨", 0.24, 36, Color3.new(1, 1, 1)),
			line(if perk then perk.DisplayName else power, 0.31, 70, color),
			line(`on your {Items.DisplayName(item)} · 1 in {oneIn}`, 0.38, 28, Color3.fromRGB(230, 230, 240)),
		}
		if perk then
			table.insert(labels, line(perk.Description, 0.43, 24, Color3.fromRGB(255, 200, 210)))
		end
		for _, label in labels do
			local scale = Instance.new("UIScale")
			scale.Scale = 0.3
			scale.Parent = label
			TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		Effects.Sound(Sounds.Reveal, nil, 1)
		if rare then
			Effects.Sound(Sounds.Cheer, nil, 0.8)
		end
		task.delay(if rare then 4 else 2.6, function()
			for _, label in labels do
				TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
				local stroke = label:FindFirstChildOfClass("UIStroke")
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.55)
			gui:Destroy()
		end)
	end,
	-- Putting a stolen knife on your plate: it flies from your hands and lands with a burst
	PlaceKnife = function(from: Vector3, to: Vector3, item: string)
		if not Lod.Near(to) then
			return
		end
		flyKnife(item, from, to, 0.45, 4)
		task.delay(0.45, function()
			Effects.Burst(to, Items.Color(item), 30, 14, 0.7)
			Effects.Burst(to, Color3.fromRGB(110, 255, 110), 16, 10, 0.5)
			Effects.Sound(Sounds.Cash, to, 0.8)
		end)
	end,
	-- Equipping a knife: it flies off its plate into your hand, a ring of light, a big banner
	Equipped = function(who: Player, item: string, from: Vector3?)
		local character = who.Character
		local hand = character
			and (character:FindFirstChild("RightHand") or character:FindFirstChild("HumanoidRootPart")) :: BasePart?
		if not hand then
			return
		end
		local to = hand.Position
		if from and Lod.Near(to) then
			flyKnife(item, from, to, 0.4, 3)
		end
		task.delay(if from then 0.4 else 0, function()
			Effects.Burst(to, Items.Color(item), 40, 18, 0.8)
			Effects.Sound(Sounds.Unsheath, to, 1)
		end)
		if who ~= player then
			return
		end
		-- Your own screen: the knife's name, big, in its colour, and its Murderer power
		local gui = Instance.new("ScreenGui")
		gui.Name = "EquipBanner"
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 40
		gui.Parent = player:WaitForChild("PlayerGui")
		local function line(text: string, y: number, height: number, color: Color3): TextLabel
			local label = Instance.new("TextLabel")
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromScale(0.5, y)
			label.Size = UDim2.fromOffset(700, height)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = color
			label.Text = text
			label.Parent = gui
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 3
			stroke.Color = Color3.fromRGB(20, 16, 26)
			stroke.Parent = label
			return label
		end
		local parsed = Items.Parse(item)
		local perk = parsed and parsed.Perk and GameConfig.Perks[parsed.Perk]
		local labels = {
			line("EQUIPPED", 0.3, 34, Color3.fromRGB(255, 230, 120)),
			line(Items.DisplayName(item), 0.36, 56, Items.Color(item)),
		}
		if perk then
			table.insert(
				labels,
				line(`🔪 Murderer power: {perk.DisplayName}`, 0.42, 30, Color3.fromRGB(255, 120, 140))
			)
		end
		for _, label in labels do
			local scale = Instance.new("UIScale")
			scale.Scale = 0.4
			scale.Parent = label
			TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		task.delay(2.2, function()
			for _, label in labels do
				TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
				local stroke = label:FindFirstChildOfClass("UIStroke")
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.55)
			gui:Destroy()
		end)
	end,
	-- (Murderer only) a vanished innocent still leaves a faint shimmer
	Shimmer = function(character: Model?, duration: number)
		if not character or not character.Parent then
			return
		end
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(200, 220, 255)
		highlight.FillTransparency = 0.88
		highlight.OutlineColor = Color3.fromRGB(220, 235, 255)
		highlight.OutlineTransparency = 0.65
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Adornee = character
		highlight.Parent = character
		Debris:AddItem(highlight, duration)
	end,
	-- Bought a Health level: a green burst over them
	Heal = function(position: Vector3)
		Effects.FloatText(position + Vector3.new(0, 4, 0), "+MAX HEALTH", Color3.fromRGB(110, 255, 140))
		Effects.Sound(Sounds.Reveal, position, 0.5)
	end,
	-- Radar: outlines through walls, only on this client, for a few seconds
	Radar = function(entries: { any }, duration: number)
		Effects.Sound(Sounds.Sting, nil, 0.4)
		for _, entry in entries do
			local model = entry.Model :: Instance?
			if model and model.Parent then
				local highlight = Instance.new("Highlight")
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillColor = entry.Color
				highlight.FillTransparency = 0.55
				highlight.OutlineColor = entry.Color
				highlight.Parent = model
				Debris:AddItem(highlight, duration)
			end
		end
	end,
	TrapSnap = function(position: Vector3)
		Effects.Burst(position + Vector3.new(0, 1, 0), Color3.fromRGB(200, 200, 210), 25, 12, 0.5)
		Effects.Sound(Sounds.Slash, position, 1)
		Effects.FloatText(position + Vector3.new(0, 4, 0), "SNAP!", Color3.fromRGB(255, 200, 80))
	end,
	PowerUsed = function(_id: string, position: Vector3)
		Effects.Burst(position, Color3.fromRGB(200, 170, 255), 15, 8, 0.4)
	end,
	Died = function()
		flash("YOU DIED", 0.7, 3)
	end,
	Hurt = function()
		flash(nil, 0.35, 0.35)
		Effects.Shake(3, 0.3)
	end,
	-- Floating damage number over a guard you hit
	Damage = function(position: Vector3, amount: number)
		Effects.FloatText(position, tostring(amount), Color3.fromRGB(255, 230, 120))
		Effects.Shake(1.2, 0.12)
	end,
	Swing = function(position: Vector3)
		Effects.Sound(Sounds.Slash, position, 0.8)
	end,
	Hit = function(position: Vector3)
		-- Cartoon impact sparks (no blood: keeps the game rated for younger players)
		Effects.Burst(position, Color3.fromRGB(255, 235, 120), 24, 16, 0.6)
	end,
	Shield = function(position: Vector3)
		Effects.Burst(position, Color3.fromRGB(90, 190, 255), 40, 20, 0.9)
		Effects.Sound(Sounds.Unsheath, position, 1)
	end,
	Smoke = function(position: Vector3)
		smoke(position)
	end,
	Dash = function(position: Vector3)
		Effects.Burst(position, Color3.fromRGB(255, 255, 255), 20, 14, 0.5)
		Effects.Sound(Sounds.Lunge, position, 0.8)
	end,
	Blink = function(from: Vector3, to: Vector3)
		Effects.Burst(from, Color3.fromRGB(170, 70, 255), 30, 12, 0.8)
		Effects.Burst(to, Color3.fromRGB(170, 70, 255), 30, 12, 0.8)
		Effects.Sound(Sounds.Lunge, to, 0.8)
	end,
	Shot = function(from: Vector3, to: Vector3)
		tracer(from, to)
		Effects.Sound(Sounds.Gunshot, from, 1)
		Effects.Burst(to, Color3.fromRGB(255, 220, 120), 10, 8, 0.4)
	end,
	Coin = function(position: Vector3, amount: number)
		-- Usually the pickup already played locally (see trackCoin); this just confirms the cash
		if os.clock() - lastCoinPredicted > 0.75 then
			coinChime()
		end
		Effects.FloatText(position, `+${Format.Short(amount)}`, Color3.fromRGB(255, 215, 60))
	end,
	Deposit = function(who: Player, rarity: string)
		local character = who.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Effects.Burst(
				root.Position + Vector3.new(0, 3, 0),
				Knives.RarityColors[rarity] or Color3.new(1, 1, 1),
				50,
				22,
				0.8
			)
		end
		if who == player then
			Effects.Sound(Sounds.Cash, nil, 0.6)
		end
	end,
	RevolverDrop = function(position: Vector3)
		Effects.Burst(position, Color3.fromRGB(80, 255, 120), 30, 10, 0.6)
	end,
	Unsheath = function(position: Vector3?)
		Effects.Sound(Sounds.Unsheath, position, 1)
	end,

	-- Raids ----------------------------------------------------------------------------------------
	GateHit = function(position: Vector3, amount: number)
		Effects.Burst(position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 170, 60), 18, 18, 0.5)
		Effects.Sound(Sounds.GateHit, position, 0.6)
		Effects.FloatText(
			position + Vector3.new(math.random(-4, 4), 5, 0),
			`-{math.floor(amount)}`,
			Color3.fromRGB(255, 120, 80)
		)
	end,
	GateBreak = function(position: Vector3, color: Color3)
		Effects.Burst(position, color, 80, 35, 1.2)
		debris(position, Color3.fromRGB(70, 66, 78), Enum.Material.Metal, 16)
		lightFlash(position, color, 8, 40, 0.8)
		Effects.Sound(Sounds.GateBreak, position, 1)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude < 60 then
			Effects.Shake(5, 0.6)
		end
	end,
	GateReforge = function(position: Vector3, color: Color3)
		Effects.Burst(position, color, 40, 12, 0.8)
		Effects.Sound(Sounds.Unsheath, position, 0.8)
	end,
	GateRepair = function(position: Vector3, color: Color3)
		Effects.Burst(position, Color3.fromRGB(120, 255, 140), 30, 10, 0.6)
		Effects.FloatText(position + Vector3.new(0, 6, 0), "REPAIRED!", Color3.fromRGB(120, 255, 140))
		Effects.Sound(Sounds.GateHit, position, 0.4)
		local _ = color
	end,
	Alarm = function()
		Effects.Sound(Sounds.Alarm, nil, 0.6)
		flash(nil, 0.25, 0.8)
	end,
	Stolen = function(position: Vector3, color: Color3)
		Effects.Burst(position + Vector3.new(0, 3, 0), color, 40, 16, 0.7)
		Effects.Sound(Sounds.Lunge, position, 1)
	end,
	Recovered = function(position: Vector3, color: Color3)
		Effects.Burst(position + Vector3.new(0, 3, 0), color, 50, 20, 0.8)
		Effects.Sound(Sounds.Cash, position, 0.8)
	end,
	Knockdown = function(position: Vector3)
		Effects.Burst(position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 230, 120), 30, 14, 0.6)
		Effects.Sound(Sounds.Knockdown, position, 0.8)
		Effects.FloatText(position + Vector3.new(0, 4, 0), "KO!", Color3.fromRGB(255, 230, 120))
	end,
	BurglarSpawn = function(position: Vector3)
		smoke(position)
	end,

	-- Powers ---------------------------------------------------------------------------------------
	Flash = function(origin: Vector3, look: Vector3)
		-- The old camera pops up in front of them, and the bulb goes off
		local camera = Props.Build("Camera", true)
		camera:PivotTo(CFrame.lookAt(origin + look * 1.6, origin + look * 6))
		for _, d in camera:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		camera.Parent = workspace
		Debris:AddItem(camera, 0.9)
		lightFlash(origin + look * 2, Color3.fromRGB(255, 255, 230), 40, 45, 0.5)
		Effects.Burst(origin + look * 2, Color3.new(1, 1, 1), 40, 30, 0.8)
		Effects.Sound(Sounds.Flash, origin, 1)
	end,
	Barricade = function(position: Vector3)
		smoke(position)
		Effects.Sound(Sounds.GateHit, position, 0.7)
		Effects.Shake(1.5, 0.2)
	end,
	Smash = function(position: Vector3)
		debris(position, Color3.fromRGB(150, 98, 54), Enum.Material.WoodPlanks, 14)
		Effects.Sound(Sounds.WoodBreak, position, 1)
	end,
	NoEnergy = function(_id: string)
		Effects.Sound(Sounds.Tick, nil, 0.6)
		Effects.Shake(0.8, 0.15)
	end,

	-- Progress -------------------------------------------------------------------------------------
	Rebirth = function(who: Player, position: Vector3)
		pillar(position, Color3.fromRGB(255, 220, 90), 140, 2.2)
		Effects.Burst(position + Vector3.new(0, 3, 0), Color3.fromRGB(255, 220, 90), 120, 40, 1.2)
		lightFlash(position, Color3.fromRGB(255, 220, 120), 10, 60, 2)
		Effects.Sound(Sounds.Reveal, position, 1)
		if who == player then
			Effects.Sound(Sounds.Cheer, nil, 0.5)
			flash("REBIRTH!", 0.3, 2)
		end
	end,
	WallsUp = function(_who: Player, position: Vector3)
		smoke(position)
		Effects.Sound(Sounds.GateBreak, position, 0.6)
	end,
	ChestOpen = function(position: Vector3, _who: Player)
		pillar(position, Color3.fromRGB(255, 220, 90), 40, 1.2)
		Effects.Burst(position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 220, 90), 60, 25, 0.9)
		Effects.Sound(Sounds.Reveal, position, 0.8)
	end,
	CashBurst = function(at: Vector3?, cash: number)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local position = at or (if root then root.Position else nil)
		if not position then
			Effects.Sound(Sounds.Cash, nil, 0.9)
			return
		end
		Effects.Burst(position + Vector3.new(0, 2, 0), Color3.fromRGB(110, 255, 110), 70, 30, 1)
		Effects.FloatText(position + Vector3.new(0, 6, 0), `+${Format.Short(cash)}`, Color3.fromRGB(110, 255, 110))
		Effects.Sound(Sounds.Cash, nil, 0.9)
	end,
	IndexClaim = function(cash: number, speed: number)
		Effects.Sound(Sounds.Reveal, nil, 0.7)
		local root = player.Character and player.Character:FindFirstChild("Head") :: BasePart?
		if root then
			Effects.FloatText(
				root.Position + Vector3.new(0, 3, 0),
				`+${Format.Short(cash)}  +{Format.Short(speed)}⚡`,
				Color3.fromRGB(255, 230, 90)
			)
			Effects.Burst(root.Position, Color3.fromRGB(80, 170, 255), 50, 20, 0.8)
		end
	end,
}

-- 🤝 Your teammate is outlined green in the hub (so you can find each other)
local function trackTeammate()
	local current: Highlight? = nil
	local function refresh()
		if current then
			current:Destroy()
			current = nil
		end
		local id = player:GetAttribute("Partner")
		local mate = if type(id) == "number" then Players:GetPlayerByUserId(id) else nil
		local character = mate and mate.Character
		if character and not player:GetAttribute("InRound") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "TeammateOutline"
			highlight.FillTransparency = 1
			highlight.OutlineColor = Color3.fromRGB(90, 255, 120)
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Adornee = character
			highlight.Parent = character
			current = highlight
		end
	end
	player:GetAttributeChangedSignal("Partner"):Connect(refresh)
	player:GetAttributeChangedSignal("InRound"):Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(3) -- they respawn / stream in
			refresh()
		end
	end)
end

function Effects.Init()
	trackTeammate()
	Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind: string, ...)
		local handler = handlers[kind]
		if handler then
			handler(...)
		end
	end)

	-- Coins and the Revolver pickup spin locally (no server traffic)
	local spinning: { [Instance]: CFrame } = {}
	local function track(instance: Instance)
		if instance:IsA("BasePart") then
			spinning[instance] = instance.CFrame
		elseif instance:IsA("Model") then
			spinning[instance] = instance:GetPivot()
		end
	end
	for _, tag in { "Coin", "Spin" } do
		for _, instance in CollectionService:GetTagged(tag) do
			track(instance)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(track)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
			spinning[instance] = nil
		end)
	end
	for _, coin in CollectionService:GetTagged("Coin") do
		task.spawn(trackCoin, coin)
	end
	CollectionService:GetInstanceAddedSignal("Coin"):Connect(trackCoin)
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for instance, base in spinning do
			if not instance.Parent then
				spinning[instance] = nil
				continue
			end
			-- Nobody near enough to notice it turning (LOD)
			if not Lod.Near(base.Position) then
				continue
			end
			-- Each one a little out of step with its neighbours
			local t = now + (base.Position.X + base.Position.Z) * 0.37
			local bob = CFrame.new(0, math.sin(t * 2) * 0.3, 0)
			local turn = CFrame.Angles(0, t * 2, 0)
			local goal = CFrame.new(base.Position) * bob * turn * (base - base.Position)
			if instance:IsA("BasePart") then
				instance.CFrame = goal
			elseif instance:IsA("Model") then
				instance:PivotTo(goal)
			end
		end
	end)

	-- Rainbow-mutation knives cycle through every colour; aura rings on vault floors breathe
	local rainbow: { [Instance]: { BasePart } } = {}
	local function trackRainbow(model: Instance)
		local parts = {}
		for _, d in model:GetDescendants() do
			if
				d:IsA("BasePart")
				and d.Transparency < 1
				and (d:GetAttribute("KnifeRole") == nil or d:GetAttribute("RainbowValue") ~= nil)
			then
				table.insert(parts, d)
			end
		end
		rainbow[model] = parts
	end
	for _, model in CollectionService:GetTagged("RainbowKnife") do
		trackRainbow(model)
	end
	CollectionService:GetInstanceAddedSignal("RainbowKnife"):Connect(trackRainbow)
	CollectionService:GetInstanceRemovedSignal("RainbowKnife"):Connect(function(model)
		rainbow[model] = nil
	end)
	local rings: { [BasePart]: Vector3 } = {}
	local function trackRing(ring: Instance)
		if ring:IsA("BasePart") then
			rings[ring] = ring.Size
		end
	end
	for _, ring in CollectionService:GetTagged("AuraRing") do
		trackRing(ring)
	end
	CollectionService:GetInstanceAddedSignal("AuraRing"):Connect(trackRing)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for model, parts in rainbow do
			if not model.Parent then
				rainbow[model] = nil
				continue
			end
			local first = parts[1]
			if first and not Lod.Near(first.Position) then
				continue
			end
			for i, part in parts do
				local value = part:GetAttribute("RainbowValue")
				part.Color =
					Color3.fromHSV((t * 0.35 + i * 0.08) % 1, 0.65, if type(value) == "number" then value else 1)
			end
		end
		for ring, size in rings do
			if not ring.Parent then
				rings[ring] = nil
				continue
			end
			if not Lod.Near(ring.Position) then
				continue
			end
			local pulse = 1 + math.sin(t * 2.2 + size.Y) * 0.04
			ring.Size = Vector3.new(size.X, size.Y * pulse, size.Z * pulse)
		end
	end)

	-- Haunted Wheels turn while their owner runs inside (local only, pivoting around the hub)
	local wheels: { [Model]: CFrame } = {}
	local function trackWheel(wheel: Instance)
		local pivot = wheel:GetAttribute("Pivot")
		if wheel:IsA("Model") and typeof(pivot) == "CFrame" then
			wheels[wheel] = pivot -- the server's resting position, not whatever has streamed in yet
		end
	end
	for _, wheel in CollectionService:GetTagged("HauntedWheel") do
		trackWheel(wheel)
	end
	CollectionService:GetInstanceAddedSignal("HauntedWheel"):Connect(trackWheel)
	local wheelAngles: { [Model]: number } = {}
	RunService.RenderStepped:Connect(function(dt: number)
		for wheel, base in wheels do
			if not wheel.Parent then
				wheels[wheel] = nil
				wheelAngles[wheel] = nil
			elseif wheel:GetAttribute("Spinning") and wheel.PrimaryPart then
				-- Faster wheel tiers spin faster; the rungs roll back under the runner's feet
				local rate = (wheel:GetAttribute("SpinRate") or 2) :: number
				local angle = (wheelAngles[wheel] or 0) + dt * rate
				wheelAngles[wheel] = angle
				wheel:PivotTo(base * CFrame.Angles(angle, 0, 0))
			end
		end
	end)

	-- Keep exposure steady across joins and round teleports; room lamps supply the mood.
	local Lighting = game:GetService("Lighting")
	local function roundLighting()
		local inRound = player:GetAttribute("InRound") == true
		local info = TweenInfo.new(1.2, Enum.EasingStyle.Quad)
		Lighting.ExposureCompensation = 0
		-- Round maps are indoors with no lamps: rounds get warm, neutral room light, and the hub's
		-- own values (published by the server as Lighting attributes, MapService) come back after.
		-- Never cache Lighting here: the client can start before the server has set it up.
		local hubAmbient = Lighting:GetAttribute("HubAmbient")
		local hubOutdoor = Lighting:GetAttribute("HubOutdoor")
		if inRound then
			TweenService:Create(Lighting, info, {
				Ambient = Color3.fromRGB(165, 160, 150),
				OutdoorAmbient = Color3.fromRGB(170, 165, 155),
			}):Play()
		elseif typeof(hubAmbient) == "Color3" and typeof(hubOutdoor) == "Color3" then
			TweenService:Create(Lighting, info, { Ambient = hubAmbient, OutdoorAmbient = hubOutdoor }):Play()
		end
		local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
		if bloom then
			TweenService:Create(bloom, info, { Intensity = if inRound then 0.25 else 0.3 }):Play()
		end
	end
	player:GetAttributeChangedSignal("InRound"):Connect(roundLighting)
	roundLighting()

	-- While training you keep facing the way you run (the server turns you once you step in)
	player:GetAttributeChangedSignal("Training"):Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.AutoRotate = not player:GetAttribute("Training")
		end
	end)

	-- Every stride on your own wheel pops a "+Speed" number and a soft footstep
	local strideTimer = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if not player:GetAttribute("Training") then
			strideTimer = 0
			return
		end
		local level = (player:GetAttribute("TreadmillLevel") or 1) :: number
		local stride = 0.6 / (1 + level * 0.12) -- quicker steps on better wheels
		strideTimer += dt
		if strideTimer < stride then
			return
		end
		strideTimer = 0
		local character = player.Character
		local head = character and character:FindFirstChild("Head") :: BasePart?
		if head then
			local rate = GameConfig.Treadmills[level] and GameConfig.Treadmills[level].Rate or 0
			local gained = math.max(1, math.floor(rate * stride))
			local jitter = Vector3.new(math.random(-10, 10) / 10, 2.5, math.random(-10, 10) / 10)
			Effects.FloatText(head.Position + jitter, `+{gained} ⚡`, Color3.fromRGB(120, 200, 255))
			Effects.Sound("rbxasset://sounds/action_footsteps_plastic.mp3", head.Position, 0.25)
		end
	end)

	-- Flickering lamps in the round maps: electric lights cut out for a blink now and then,
	-- flames (candles, fireplaces; attribute "Flame") waver softly all the time
	local flickering: { [BasePart]: PointLight } = {}
	local function trackFlicker(instance: Instance)
		local light = instance:FindFirstChildOfClass("PointLight")
		if instance:IsA("BasePart") and light then
			flickering[instance] = light
			light:SetAttribute("BaseBrightness", light.Brightness)
			instance:SetAttribute("BaseTransparency", instance.Transparency)
		end
	end
	for _, instance in CollectionService:GetTagged("Flicker") do
		trackFlicker(instance)
	end
	CollectionService:GetInstanceAddedSignal("Flicker"):Connect(trackFlicker)
	CollectionService:GetInstanceRemovedSignal("Flicker"):Connect(function(instance)
		flickering[instance :: BasePart] = nil
	end)
	task.spawn(function()
		local rng = Random.new()
		while true do
			task.wait(0.08)
			local t = os.clock()
			for part, light in flickering do
				local base = (light:GetAttribute("BaseBrightness") or 1) :: number
				if part:GetAttribute("Flame") then
					local seed = part.Position.X * 0.13 + part.Position.Z * 0.07
					light.Brightness = base * (0.85 + 0.2 * math.noise(t * 4, seed))
				else
					local baseTransparency = (part:GetAttribute("BaseTransparency") or 0) :: number
					local off = rng:NextNumber() < 0.08
					light.Brightness = if off then base * 0.1 else base
					part.Transparency = if off then math.max(baseTransparency, 0.6) else baseTransparency
				end
			end
		end
	end)

	-- Wall clocks in the round maps keep real time (the second hand ticks)
	local hands: { [BasePart]: CFrame } = {}
	local function trackHand(instance: Instance)
		local center = instance:GetAttribute("Center")
		if instance:IsA("BasePart") and typeof(center) == "CFrame" then
			hands[instance] = center
		end
	end
	for _, instance in CollectionService:GetTagged("ClockHand") do
		trackHand(instance)
	end
	CollectionService:GetInstanceAddedSignal("ClockHand"):Connect(trackHand)
	CollectionService:GetInstanceRemovedSignal("ClockHand"):Connect(function(instance)
		hands[instance :: BasePart] = nil
	end)
	task.spawn(function()
		while true do
			local now = os.date("*t")
			local seconds = now.sec
			local minutes = now.min + seconds / 60
			local hours = now.hour % 12 + minutes / 60
			for hand, center in hands do
				local kind = hand:GetAttribute("Hand")
				local turn = if kind == "Hour"
					then hours / 12
					elseif kind == "Minute" then minutes / 60
					else seconds / 60
				hand.CFrame = center * CFrame.Angles(0, 0, -turn * math.pi * 2) * CFrame.new(0, hand.Size.Y / 2, 0)
			end
			task.wait(1)
		end
	end)

	-- Rack "Sell" prompts belong to one player; hide everyone else's
	local function filterPrompt(instance: Instance)
		-- (raid "Steal" prompts are managed by client/Raid)
		if instance:IsA("ProximityPrompt") and not instance:GetAttribute("Steal") then
			local owner = instance:GetAttribute("Owner")
			if owner ~= nil and owner ~= player.UserId then
				instance.Enabled = false
			end
		end
	end
	for _, d in workspace:GetDescendants() do
		filterPrompt(d)
	end
	workspace.DescendantAdded:Connect(filterPrompt)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- Always-on HUD, Steal An Egg style:
--   * bottom left: your Speed and Cash in big chunky numbers (with income, training, boost)
--   * right: upgrade buttons (Haunted Wheel, vault walls, mounts, Murderer tickets)
--   * bottom right: event timers (next raid, next murder round, the plaza's free chest)
--   * top: the phase / round timer, raid banner, and big server-wide announcements
--   * rounds: the Energy meter that powers your Innocent Powers, the role reveal, results
--   * toasts, the zone title when you cross into a new part of the runway
-- Pure display; every number comes from attributes the server sets.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local Effects = require(script.Parent.Effects)
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("GameConfig"))
local Sounds = require(ReplicatedStorage.Shared.Config:WaitForChild("Sounds"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local Hud = {}

local KIND_COLORS = {
	good = Color3.fromRGB(70, 200, 100),
	bad = Color3.fromRGB(230, 70, 70),
	info = Color3.fromRGB(70, 150, 240),
}
local SPEED_COLOR = Color3.fromRGB(255, 160, 40)
local CASH_COLOR = Color3.fromRGB(110, 255, 110)

-- Big number with a thick outline (the Speed and Cash readouts)
local function bigNumber(parent: Instance, color: Color3, position: UDim2, size: UDim2): TextLabel
	local label = Ui.label({
		Position = position,
		Size = size,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color,
		Text = "",
	}, parent)
	Ui.textStroke(label, 3.5)
	Ui.gradient(label, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200))
	return label
end

local function pill(parent: Instance, order: number): (Frame, TextLabel, TextLabel)
	local frame = new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(250, 46),
		BackgroundColor3 = Color3.fromRGB(20, 16, 28),
		BackgroundTransparency = 0.35,
	}, parent)
	Ui.corner(frame, 14)
	local icon = Ui.label({ Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(4, 3), Text = "" }, frame)
	local text = Ui.label({
		Size = UDim2.new(1, -54, 1, -8),
		Position = UDim2.fromOffset(48, 4),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}, frame)
	Ui.textStroke(text, 2.5)
	return frame, icon, text
end

-- Studio phone preview (DebugPhone): ghosts of Roblox's touch thumbstick and jump button, using
-- the same sizes and positions Roblox's TouchGui does, so the layout can be checked on desktop
local function touchGhosts()
	-- Studio-only guides share the real safe-area geometry used by the combat controls.
	local function ghost(name: string, text: string): Frame
		local frame = new(
			"Frame",
			{ Name = name, BackgroundColor3 = Color3.fromRGB(255, 60, 60), BackgroundTransparency = 0.75 },
			Ui.gui
		)
		Ui.corner(frame, 100)
		Ui.label({ Size = UDim2.fromScale(1, 1), Text = text, TextSize = 14, TextScaled = false }, frame)
		return frame
	end
	local jump, stick = ghost("DebugJump", "JUMP"), ghost("DebugStick", "MOVE")
	local function resize()
		local at, size = Ui.Layout.touchBounds()
		jump.Position, jump.Size = UDim2.fromOffset(at.X, at.Y), UDim2.fromOffset(size.X, size.Y)
		local _, bounds = Ui.bounds()
		local diameter = if bounds.Y < 500 then 70 else 120
		stick.Position, stick.Size = UDim2.new(0, 25, 1, -diameter - 20), UDim2.fromOffset(diameter, diameter)
	end
	Ui.Layout.Changed:Connect(resize)
	resize()
end

function Hud.Init()
	local gui = Ui.gui
	if Ui.Phone and RunService:IsStudio() and ReplicatedStorage:GetAttribute("DebugPhone") then
		touchGhosts()
	end

	-- Top centre: phase + timer, with a smaller line under it for round info -------------------
	local timerFrame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(380, 58),
		BackgroundColor3 = Ui.PANEL,
		BackgroundTransparency = 0.15,
	}, gui)
	Ui.corner(timerFrame, 16)
	Ui.stroke(timerFrame)
	Ui.padding(timerFrame, 12, 6)
	local timerLabel = Ui.label({ Size = UDim2.fromScale(1, 1), Text = "Loading..." }, timerFrame)
	Ui.textStroke(timerLabel, 2)
	local subLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(460, 26),
		Text = "",
	}, gui)
	-- The Upgrade Base sign by your own gate: next floor's price, how full you are, a "!" when you
	-- can afford it (the prompt on it buys it; other vaults' signs stay blank)
	task.spawn(function()
		local built: { Title: TextLabel, Price: TextLabel, Count: TextLabel, Alert: TextLabel }? = nil
		local builtFor: Instance? = nil
		while true do
			task.wait(0.5)
			local index = player:GetAttribute("VaultIndex")
			local map = workspace:FindFirstChild("Map")
			local bases = map and map:FindFirstChild("Bases")
			local base = bases and type(index) == "number" and bases:FindFirstChild(`Base{index}`)
			local sign = base and base:FindFirstChild("UpgradeSign")
			local board = sign and sign:FindFirstChild("Board")
			local surface = board and board:FindFirstChild("Gui") :: SurfaceGui?
			if not surface then
				continue
			end
			if builtFor ~= surface then
				builtFor = surface
				local function text(y: number, height: number, color: Color3): TextLabel
					return Ui.label({
						Position = UDim2.fromScale(0.05, y),
						Size = UDim2.fromScale(0.9, height),
						TextColor3 = color,
						Text = "",
					}, surface)
				end
				built = {
					Title = text(0.05, 0.28, Color3.new(1, 1, 1)),
					Price = text(0.36, 0.36, Color3.fromRGB(110, 255, 110)),
					Count = text(0.74, 0.2, Color3.fromRGB(220, 220, 230)),
					Alert = Ui.label({
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.fromScale(1, 0),
						Size = UDim2.fromScale(0.18, 0.4),
						TextColor3 = Color3.fromRGB(255, 60, 60),
						Text = "!",
					}, surface),
				}
				for _, label in built :: any do
					Ui.textStroke(label, 2)
				end
			end
			local labels = built :: any
			local slots = (player:GetAttribute("Slots") or GameConfig.StartingSlots) :: number
			local knives = (player:GetAttribute("KnifeCount") or 0) :: number
			local cash = (player:GetAttribute("Cash") or 0) :: number
			labels.Title.Text = "🏠 Upgrade Base"
			labels.Count.Text = `{knives}/{slots} knives`
			if slots >= GameConfig.MaxSlots then
				labels.Price.Text = "MAX"
				labels.Alert.Visible = false
			else
				local cost = GameConfig.SlotCost(slots)
				labels.Price.Text = `${Ui.abbreviate(cost)}`
				labels.Alert.Visible = cash >= cost
			end
		end
	end)

	-- 🤝 The server goal and any live events (ServerEvents), under the timer
	local goalLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 122),
		Size = UDim2.fromOffset(460, 22),
		Text = "",
		TextColor3 = Color3.fromRGB(150, 230, 255),
	}, gui)
	Ui.textStroke(goalLabel, 1.5)
	local eventLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 146),
		Size = UDim2.fromOffset(520, 26),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 230, 120),
	}, gui)
	Ui.textStroke(eventLabel, 2)
	local EVENT_TEXT: { { Name: string, Text: string } } = {
		{ Name = "LuckyRush", Text = "🍀 LUCKY RUSH · 2x power luck" },
		{ Name = "CashRush", Text = "💸 CASH RUSH · 2x cash" },
		{ Name = "HeatWave", Text = "🔥 HEAT WAVE · 2x Heat" },
		{ Name = "CosmicRush", Text = "🪐 COSMIC RUSH · deep bosses restock fast" },
	}
	task.spawn(function()
		while true do
			task.wait(0.5)
			local inRound = player:GetAttribute("InRound") == true
			local text = ReplicatedStorage:GetAttribute("GoalText")
			local progress = ReplicatedStorage:GetAttribute("GoalProgress") or 0
			local need = ReplicatedStorage:GetAttribute("GoalNeed") or 1
			goalLabel.Visible = not inRound and type(text) == "string"
			goalLabel.Text = `🤝 Server goal: {text} ({progress}/{need})`
			local now = workspace:GetServerTimeNow()
			local live = {}
			for _, event in EVENT_TEXT do
				local ends = ReplicatedStorage:GetAttribute(`Event_{event.Name}`)
				if type(ends) == "number" and ends > now then
					table.insert(live, `{event.Text} {Ui.clock(ends - now)}`)
				end
			end
			eventLabel.Visible = #live > 0 and not player:GetAttribute("InRound") and not Ui.menuOpen()
			eventLabel.Text = table.concat(live, "   ")
		end
	end)

	-- "Your chance to be the Murderer: 6%" (MM2 style), between rounds
	local chanceLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.fromOffset(420, 22),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 110, 120),
	}, gui)
	Ui.textStroke(chanceLabel, 1.5)
	local function refreshChance()
		local chance = player:GetAttribute("MurdererChance")
		chanceLabel.Visible = type(chance) == "number" and not player:GetAttribute("InRound")
		chanceLabel.Text = `Murderer chance: {chance or 0}%`
	end
	player:GetAttributeChangedSignal("MurdererChance"):Connect(refreshChance)
	player:GetAttributeChangedSignal("InRound"):Connect(refreshChance)
	refreshChance()
	Ui.textStroke(subLabel, 2)

	-- Bottom centre: health, big and easy to see (Roblox's own bar sits top right where nobody looks)
	pcall(function()
		game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	local healthFrame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if Ui.Phone then -8 else -74),
		Size = UDim2.fromOffset(if Ui.Phone then 240 else 360, if Ui.Phone then 24 else 30),
		BackgroundColor3 = Color3.fromRGB(40, 14, 18),
		BackgroundTransparency = 0.1,
	}, gui)
	Ui.corner(healthFrame, 12)
	Ui.stroke(healthFrame)
	local healthFill = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(80, 220, 100),
	}, healthFrame)
	Ui.corner(healthFill, 12)
	local healthText = Ui.label({
		Size = UDim2.fromScale(1, 1),
		Text = "❤️ 100 / 100",
		ZIndex = 3,
	}, healthFrame)
	Ui.textStroke(healthText, 2)
	local healthConnections: { RBXScriptConnection } = {}
	local hideToken = 0
	local function watchHealth(character: Model)
		for _, c in healthConnections do
			c:Disconnect()
		end
		table.clear(healthConnections)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		local function refresh()
			local fraction = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
			healthFill.Size = UDim2.fromScale(fraction, 1)
			healthFill.Visible = fraction > 0.01
			-- Green -> yellow -> red as it drops
			healthFill.BackgroundColor3 = if fraction > 0.5
				then Color3.fromRGB(255, 220, 60):Lerp(Color3.fromRGB(80, 220, 100), (fraction - 0.5) * 2)
				else Color3.fromRGB(230, 50, 50):Lerp(Color3.fromRGB(255, 220, 60), fraction * 2)
			healthText.Text = `❤️ {math.ceil(humanoid.Health)} / {math.floor(humanoid.MaxHealth)}`
			-- Only on screen while it means something: hurt, or in a round. Full health in the hub
			-- hides it a moment later.
			if (fraction < 0.999 or player:GetAttribute("InRound")) and not Ui.menuOpen() then
				healthFrame.Visible = true
				hideToken += 1
			else
				hideToken += 1
				local token = hideToken
				task.delay(2.5, function()
					if token == hideToken and not player:GetAttribute("InRound") then
						healthFrame.Visible = false
					end
				end)
			end
		end
		table.insert(healthConnections, player:GetAttributeChangedSignal("InRound"):Connect(refresh))
		table.insert(healthConnections, humanoid.HealthChanged:Connect(refresh))
		table.insert(healthConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(refresh))
		refresh()
	end
	player.CharacterAdded:Connect(watchHealth)
	if player.Character then
		task.spawn(watchHealth, player.Character)
	end

	-- Bottom left: Speed and Cash -----------------------------------------------------------------
	-- (phones: top left beside the icon strip, away from the thumbstick)
	local stats = new("Frame", {
		AnchorPoint = if Ui.Phone then Vector2.zero else Vector2.new(0, 1),
		Position = if Ui.Phone then UDim2.fromOffset(80, 58) else UDim2.new(0, 14, 1, -14),
		Size = UDim2.fromOffset(330, 176),
		BackgroundTransparency = 1,
	}, gui)
	if Ui.Phone then
		new("UIScale", { Scale = 0.72 }, stats)
	end
	Ui.label({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(0, 4), Text = "👟" }, stats)
	local speedLabel = bigNumber(stats, SPEED_COLOR, UDim2.fromOffset(56, 0), UDim2.fromOffset(270, 58))
	local trainLabel = Ui.label({
		Position = UDim2.fromOffset(58, 54),
		Size = UDim2.fromOffset(260, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(150, 210, 255),
		Text = "",
	}, stats)
	Ui.textStroke(trainLabel, 2)
	Ui.label({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(0, 84), Text = "💵" }, stats)
	local cashLabel = bigNumber(stats, CASH_COLOR, UDim2.fromOffset(56, 78), UDim2.fromOffset(270, 62))
	local incomeLabel = Ui.label({
		Position = UDim2.fromOffset(58, 138),
		Size = UDim2.fromOffset(270, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}, stats)
	Ui.textStroke(incomeLabel, 2)
	local rackLabel = Ui.label({
		Position = UDim2.fromOffset(58, 158),
		Size = UDim2.fromOffset(270, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(200, 200, 220),
		Text = "",
	}, stats)
	Ui.textStroke(rackLabel, 1.5)
	Hud.CashLabel = cashLabel

	-- 🔥 Heat, right above Speed: one number that both games fill, boosting cash and power luck
	local heatLabel = Ui.label({
		Position = UDim2.fromOffset(0, -44),
		Size = UDim2.fromOffset(320, 34),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 150, 60),
		Text = "",
	}, stats)
	Ui.textStroke(heatLabel, 2.5)
	local heatHint = Ui.label({
		Position = UDim2.fromOffset(4, -14),
		Size = UDim2.fromOffset(320, 16),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 220, 170),
		Text = "",
	}, stats)
	Ui.textStroke(heatHint, 1.5)
	local function refreshHeat()
		local heat = (player:GetAttribute("Heat") or 0) :: number
		local fuel = GameConfig.Fuel
		heatLabel.Text = `🔥 HEAT {heat}/{fuel.MaxHeat}`
		heatLabel.TextColor3 = Color3.fromRGB(255, 200, 90):Lerp(Color3.fromRGB(255, 60, 40), heat / fuel.MaxHeat)
		local friends = (player:GetAttribute("FriendsHere") or 0) :: number
		heatHint.Text = (
			if heat > 0
				then `x{math.floor((1 + heat * fuel.HeatIncome) * 10) / 10} cash · x{math.floor(
					(1 + heat * fuel.HeatLuck) * 10
				) / 10} power luck`
				else "Steal & survive rounds to heat up!"
		) .. (if friends > 0 then `  · 👥 +{friends * 10}%` else "")
	end
	player:GetAttributeChangedSignal("Heat"):Connect(refreshHeat)
	player:GetAttributeChangedSignal("FriendsHere"):Connect(refreshHeat)
	refreshHeat()
	Remotes.Effect.OnClientEvent:Connect(function(kind: string, _heat: any, delta: any, reason: any)
		if kind ~= "Heat" or type(delta) ~= "number" then
			return
		end
		local scale = heatLabel:FindFirstChildOfClass("UIScale") or new("UIScale", {}, heatLabel)
		scale.Scale = 1.35
		TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Effects.FloatText(
				root.Position + Vector3.new(0, 4, 0),
				`{if delta > 0 then "+" else ""}{delta} 🔥 {reason or ""}`,
				if delta > 0 then Color3.fromRGB(255, 160, 60) else Color3.fromRGB(150, 160, 190)
			)
		end
	end)

	-- Right side: upgrades, folded behind one "Upgrades" button (a badge counts what you can afford)
	-- so the screen stays clear; the list drops down under it when opened
	local upgradePanel, upgradeBody = Theme.shell("Upgrades", "Upgrades", Theme.Green, "Upgrades", 520, 640)
	local shop: ScrollingFrame
	local upgradesButton = Theme.button(gui, "Upgrades", Theme.Green, {
		AnchorPoint = Vector2.new(1, 0),
		Name = "UpgradesButton",
		Position = UDim2.new(1, -12, 0, 56),
		Size = UDim2.fromOffset(120, 44),
		MaximumTextSize = 20,
	}, function()
		Ui.Menu.Toggle(upgradePanel)
	end, "Upgrades")
	local upgradesBadge = Theme.badge(upgradesButton)
	shop = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
	}, upgradeBody)
	Ui.new(
		"UIPadding",
		{ PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) },
		shop
	)
	new("UIListLayout", {
		Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, shop)
	local buttons: { [string]: TextButton } = {}
	local order = 0
	local function shopButton(kind: string, color: Color3, icon: string)
		order += 1
		local button = Theme.button(shop, kind, color, {
			Name = kind,
			ZIndex = 7,
			LayoutOrder = order,
			Size = UDim2.new(1, -6, 0, 72),
			MaximumTextSize = 30,
		}, function()
			Remotes.Purchase:InvokeServer(kind)
		end, icon)
		buttons[kind] = button
	end
	shopButton("Treadmill", Theme.Cyan, "Training")
	shopButton("Trail", Theme.Purple, "RustyShank")
	shopButton("Health", Theme.Red, "Health")
	shopButton("Walls", Color3.fromRGB(176, 125, 79), "Walls")
	shopButton("Slot", Theme.Gold, "Floor")
	local function setButtonText(kind: string, text: string)
		local label = buttons[kind]:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = text
		end
	end

	-- Bottom right: event timers ----------------------------------------------------------------
	-- (phones: top right, out from under the jump button)
	local timers = new("Frame", {
		AnchorPoint = if Ui.Phone then Vector2.new(1, 0) else Vector2.new(1, 1),
		Position = if Ui.Phone then UDim2.new(1, -10, 0, 6) else UDim2.new(1, -14, 1, -14),
		Size = UDim2.fromOffset(250, 160),
		BackgroundTransparency = 1,
	}, gui)
	if Ui.Phone then
		new("UIScale", { Scale = 0.72 }, timers)
	end
	new("UIListLayout", {
		Padding = UDim.new(0, if Ui.Phone then 4 else 8),
		VerticalAlignment = if Ui.Phone then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, timers)
	-- New-player shield: how long nobody can rob you
	local shieldPill, shieldIcon, shieldText = pill(timers, 0)
	shieldIcon.Text = "🛡️"
	local function refreshShield()
		local left = player:GetAttribute("ShieldLeft")
		local on = player:GetAttribute("Shielded") == true and type(left) == "number" and left > 0
		shieldPill.Visible = on
		if on then
			shieldText.Text = `Protected {math.ceil((left :: number) / 60)}m`
			shieldText.TextColor3 = Color3.fromRGB(150, 210, 255)
		end
	end
	player:GetAttributeChangedSignal("ShieldLeft"):Connect(refreshShield)
	player:GetAttributeChangedSignal("Shielded"):Connect(refreshShield)
	refreshShield()
	local raidPill, raidIcon, raidText = pill(timers, 1)
	raidIcon.Text = "⚔️"
	local roundPill, roundIcon, roundText = pill(timers, 2)
	roundPill.Visible = false -- the top timer says the same thing
	roundIcon.Text = "🔪"
	local chestPill, chestIcon, chestText = pill(timers, 3)
	chestIcon.Visible = false
	chestPill.BackgroundColor3 = Theme.Navy
	chestPill.BackgroundTransparency = 0
	Theme.outline(chestPill)
	Theme.studs(chestPill)
	Theme.image(
		chestPill,
		"CaseLegendary",
		{ Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(32, 36), ZIndex = 2 }
	)
	chestText.ZIndex = 2

	local function refreshStats()
		local cash = player:GetAttribute("Cash") or 0
		local slots = player:GetAttribute("Slots") or GameConfig.StartingSlots
		local speed = player:GetAttribute("Speed") or 0
		local treadmill = player:GetAttribute("TreadmillLevel") or 1
		local walls = player:GetAttribute("WallLevel") or 1
		local rebirths = player:GetAttribute("Rebirths") or 0
		cashLabel.Text = `${Ui.abbreviate(cash)}`
		speedLabel.Text = Ui.abbreviate(speed)
		local training = player:GetAttribute("Training")
		local rate = GameConfig.Treadmills[treadmill].Rate * (1 + rebirths * GameConfig.Rebirth.SpeedBonus)
		trainLabel.Text = if training
			then `+{Ui.abbreviate(rate)}/s  running!`
			else `{math.floor(GameConfig.WalkSpeedFor(speed))} walk speed`
		incomeLabel.Text = `+${Ui.abbreviate(player:GetAttribute("Income") or 0)}/s`
		rackLabel.Text = `Wall {player:GetAttribute("KnifeCount") or 0}/{slots}  ·  Luck {player:GetAttribute("Luck") or 0}`
			.. (if rebirths > 0 then `  ·  Rebirth {rebirths}` else "")

		local nextWheel = GameConfig.Treadmills[treadmill + 1]
		setButtonText(
			"Treadmill",
			if nextWheel then `{nextWheel.Name}\n${Ui.abbreviate(nextWheel.Cost)}` else "Wheel MAX"
		)
		local trailLevel = (player:GetAttribute("TrailLevel") or 0) :: number
		local nextTrail = GameConfig.Trails[trailLevel + 1]
		setButtonText(
			"Trail",
			if nextTrail
				then `{nextTrail.Name} x{nextTrail.Multiplier}\n${Ui.abbreviate(nextTrail.Cost)}`
				else "Trail MAX"
		)
		local healthLevel = (player:GetAttribute("HealthLevel") or 0) :: number
		local titan = if player:GetAttribute("Pass_Titan") then 2 else 1
		setButtonText(
			"Health",
			if healthLevel >= GameConfig.Health.MaxLevel
				then `Health MAX ({GameConfig.MaxHealthFor(healthLevel, titan)})`
				else `Max Health {GameConfig.MaxHealthFor(healthLevel + 1, titan)}\n${Ui.abbreviate(
					GameConfig.HealthCost(healthLevel)
				)}`
		)
		-- How many upgrades you could buy right now (the badge on the Upgrades button)
		local costs = {
			if nextWheel then nextWheel.Cost else math.huge,
			if nextTrail then nextTrail.Cost else math.huge,
			if healthLevel < GameConfig.Health.MaxLevel then GameConfig.HealthCost(healthLevel) else math.huge,
			if GameConfig.Walls[walls + 1] then GameConfig.Walls[walls + 1].Cost else math.huge,
			if slots < GameConfig.MaxSlots then GameConfig.SlotCost(slots) else math.huge,
		}
		local affordable = 0
		for _, cost in costs do
			if cash >= cost then
				affordable += 1
			end
		end
		upgradesBadge.Visible = affordable > 0
		upgradesBadge.Text = tostring(affordable)
		local nextWalls = GameConfig.Walls[walls + 1]
		setButtonText(
			"Walls",
			if nextWalls
				then `Upgrade Walls\n{Ui.abbreviate(nextWalls.GateHealth)} HP - ${Ui.abbreviate(nextWalls.Cost)}`
				else "Walls MAX"
		)
		setButtonText(
			"Slot",
			if slots >= GameConfig.MaxSlots
				then "Vault MAX"
				else `+1 Floor (10 plates)\n${Ui.abbreviate(GameConfig.SlotCost(slots))}`
		)
	end
	for _, attribute in
		{
			"Cash",
			"Slots",
			"Speed",
			"TreadmillLevel",
			"TrailLevel",
			"WallLevel",
			"HealthLevel",
			"Pass_Titan",
			"Training",
			"Tickets",
			"Income",
			"KnifeCount",
			"Luck",
			"Rebirths",
		}
	do
		player:GetAttributeChangedSignal(attribute):Connect(refreshStats)
	end
	refreshStats()

	-- Cash pops: every gain floats up from the cash readout (Steal An Egg's "+$372K")
	local lastCash = player:GetAttribute("Cash") or 0
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		local cash = (player:GetAttribute("Cash") or 0) :: number
		local gained = cash - lastCash
		lastCash = cash
		if gained <= 0 or Ui.Phone or Ui.menuOpen() then
			return
		end
		local pop = Ui.label({
			Position = UDim2.fromOffset(60 + math.random(0, 120), 70),
			Size = UDim2.fromOffset(160, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = CASH_COLOR,
			Text = `+${Ui.abbreviate(gained)}`,
		}, stats)
		Ui.textStroke(pop, 2)
		local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(pop, info, { Position = pop.Position - UDim2.fromOffset(0, 50), TextTransparency = 1 })
			:Play()
		local stroke = pop:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		end
		game:GetService("Debris"):AddItem(pop, 1)
		-- Big gains make the number punch
		if gained >= math.max(100, ((player:GetAttribute("Income") or 0) :: number) * 5) then
			local scale = cashLabel:FindFirstChildOfClass("UIScale") or new("UIScale", {}, cashLabel)
			scale.Scale = 1.25
			TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end)

	-- Results banner (big, centre) for the few seconds between a round and the next intermission
	local banner = Ui.label({
		Font = Ui.SPOOKY,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(760, 90),
		TextStrokeTransparency = 0,
		TextColor3 = Color3.fromRGB(255, 230, 120),
		Visible = false,
	}, gui)

	-- Announcements: big banners across the top for rare unboxes, raids, thefts, rebirths --------
	local announceHolder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 178),
		Size = UDim2.fromOffset(720, 70),
		BackgroundTransparency = 1,
	}, gui)
	local announceQueue: { { Text: string, Color: Color3, Hype: number } } = {}
	local announcing = false
	local function nextAnnouncement()
		local entry = table.remove(announceQueue, 1)
		if not entry then
			announcing = false
			return
		end
		announcing = true
		local frame = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, -90),
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = entry.Color:Lerp(Color3.new(0, 0, 0), 0.55),
			BackgroundTransparency = 0.15,
		}, announceHolder)
		Ui.corner(frame, 16)
		new("UIStroke", { Thickness = 3, Color = entry.Color }, frame)
		local label = Ui.label({
			Size = UDim2.new(1, -24, 1, -12),
			Position = UDim2.fromOffset(12, 6),
			TextColor3 = Color3.new(1, 1, 1),
			Text = entry.Text,
		}, frame)
		Ui.textStroke(label, 2.5)
		if entry.Hype >= 3 then
			-- Rainbow sweep for the really big ones
			local gradient = new("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 120)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 150)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 200, 255)),
				}),
			}, label)
			task.spawn(function()
				while gradient.Parent do
					gradient.Offset = Vector2.new(math.sin(os.clock() * 3) * 0.5, 0)
					task.wait()
				end
			end)
		end
		Effects.Sound(if entry.Hype >= 2 then Sounds.Sting else Sounds.Coin, nil, if entry.Hype >= 2 then 0.6 else 0.4)
		TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0) })
			:Play()
		task.delay(2.6 + entry.Hype * 0.5, function()
			local out = TweenService:Create(
				frame,
				TweenInfo.new(0.3),
				{ Position = UDim2.new(0.5, 0, 0, -90), BackgroundTransparency = 1 }
			)
			out:Play()
			out.Completed:Wait()
			frame:Destroy()
			nextAnnouncement()
		end)
	end
	Remotes.Effect.OnClientEvent:Connect(function(kind: string, text: string, color: Color3, hype: number)
		if kind ~= "Announce" then
			return
		end
		table.insert(announceQueue, { Text = text, Color = color, Hype = hype or 1 })
		if #announceQueue > 4 then
			table.remove(announceQueue, 1)
		end
		if not announcing then
			nextAnnouncement()
		end
	end)

	-- Energy (rounds): the charge your Innocent Powers spend; coins fill it -----------------------
	-- A pill that sizes itself to its contents: "⚡ ENERGY", one cell per point, then "3/8"
	local ENERGY_ON = Color3.fromRGB(255, 214, 60)
	local ENERGY_OFF = Color3.fromRGB(58, 52, 70)
	local energyFrame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Name = "EnergyBar",
		Position = UDim2.new(0.5, 0, 1, if Ui.Phone then -130 else -204), -- above the power buttons
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(24, 19, 34),
		BackgroundTransparency = 0.15,
		Visible = false,
	}, gui)
	Ui.corner(energyFrame, 18)
	new("UIStroke", { Thickness = 2.5, Color = Color3.fromRGB(14, 10, 20) }, energyFrame)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, energyFrame)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, energyFrame)
	local function energyText(text: string, layoutOrder: number, color: Color3): TextLabel
		local label = Ui.label({
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			TextScaled = false,
			TextSize = 20,
			LayoutOrder = layoutOrder,
			TextColor3 = color,
			Text = text,
		}, energyFrame)
		Ui.textStroke(label, 2)
		return label
	end
	energyText("⚡ ENERGY", 0, ENERGY_ON)
	new("Frame", { Size = UDim2.fromOffset(4, 1), BackgroundTransparency = 1, LayoutOrder = 1 }, energyFrame)
	local cells: { Frame } = {}
	for i = 1, GameConfig.MaxEnergy do
		local cell = new("Frame", {
			Size = UDim2.fromOffset(16, 20),
			BackgroundColor3 = ENERGY_OFF,
			LayoutOrder = 1 + i,
		}, energyFrame)
		Ui.corner(cell, 4)
		new("UIStroke", { Thickness = 1.5, Color = Color3.fromRGB(14, 10, 20) }, cell)
		table.insert(cells, cell)
	end
	new("Frame", { Size = UDim2.fromOffset(4, 1), BackgroundTransparency = 1, LayoutOrder = 98 }, energyFrame)
	local countLabel = energyText("0/" .. GameConfig.MaxEnergy, 99, Color3.fromRGB(235, 230, 245))
	local lastEnergy = 0
	local function refreshEnergy()
		local energy = player:GetAttribute("Energy")
		energyFrame.Visible = type(energy) == "number" and not Ui.menuOpen()
		if type(energy) ~= "number" then
			return
		end
		for i, cell in cells do
			cell.BackgroundColor3 = if i <= energy then ENERGY_ON else ENERGY_OFF
		end
		countLabel.Text = `{math.floor(energy)}/{GameConfig.MaxEnergy}`
		if energy > lastEnergy then
			local scale = energyFrame:FindFirstChildOfClass("UIScale") or new("UIScale", {}, energyFrame)
			scale.Scale = 1.12
			TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		lastEnergy = energy
	end
	player:GetAttributeChangedSignal("Energy"):Connect(refreshEnergy)
	refreshEnergy()

	-- The events board over the runway entrance: live countdowns, filled in on this client ------
	task.spawn(function()
		local board: Instance? = nil
		while true do
			task.wait(0.5)
			if not board or not board.Parent then
				local map = workspace:FindFirstChild("Map")
				local decor = map and map:FindFirstChild("Decor")
				board = decor and decor:FindFirstChild("EventBoard")
				if not board then
					continue
				end
			end
			local phase = ReplicatedStorage:GetAttribute("Phase")
			local now = workspace:GetServerTimeNow()
			local left = (ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0) - now
			local status = ReplicatedStorage:GetAttribute("Status") or ""
			local raidEnds = ReplicatedStorage:GetAttribute("RaidEndsAt")
			local nextRaid = ReplicatedStorage:GetAttribute("NextRaidAt")
			-- Tsunami style: each event's name in its own colour, then the time in white
			local function line(color: string, name: string, rest: string): string
				return `<font color="{color}">{name}</font> {rest}`
			end
			local line1 = if phase == "Round"
				then line("#FF5A5A", "MURDER ROUND", "NOW!")
				elseif phase == "Results" then line("#FF5A5A", "MURDER ROUND", "OVER")
				elseif status:find("Waiting") then line("#FF5A5A", string.upper(status), "")
				else line("#FF5A5A", "MURDER ROUND", `IN {Ui.clock(left)}`)
			local line2 = if type(raidEnds) == "number"
				then line("#FFB43C", "THIEF MOON", `ENDS IN {Ui.clock(raidEnds - now)}`)
				elseif type(nextRaid) == "number" then line(
					"#FFB43C",
					"THIEF MOON",
					`IN {Ui.clock(nextRaid - now)}`
				)
				else line("#FFB43C", "THIEF MOON", "SOON")
			local texts = {
				line1,
				line2,
				line("#FFE14B", "SURVIVORS", "EARN 2X CASH"),
				line(
					"#5AF08C",
					"SERVER GOAL",
					`{ReplicatedStorage:GetAttribute("GoalProgress") or 0}/{ReplicatedStorage:GetAttribute("GoalNeed") or "?"}`
				),
			}
			for _, face in (board :: Instance):GetChildren() do
				for i = 1, #texts do
					local label = face:FindFirstChild(`Line{i}`) :: TextLabel?
					if label then
						label.Text = texts[i]
					end
				end
			end
		end
	end)

	-- Timers, banners, every frame ------------------------------------------------------------
	local freeChestLabel: TextLabel? = nil
	RunService.RenderStepped:Connect(function()
		local phase = ReplicatedStorage:GetAttribute("Phase")
		local endsAt = ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0
		local status = ReplicatedStorage:GetAttribute("Status") or ""
		local now = workspace:GetServerTimeNow()
		local clock = Ui.clock(endsAt - now)
		local inRound = player:GetAttribute("InRound")
		local raidEnds = ReplicatedStorage:GetAttribute("RaidEndsAt")
		timerFrame.Visible = not Ui.menuOpen() and Ui.gui:GetAttribute("ZoneNotice") ~= true
		if phase == "Round" then
			local map = ReplicatedStorage:GetAttribute("MapName") or ""
			timerLabel.Text = `{map}  {clock}  ·  {ReplicatedStorage:GetAttribute("Alive") or 0} alive`
			timerFrame.BackgroundColor3 = Color3.fromRGB(150, 30, 50)
			local bits = {}
			local disguise = player:GetAttribute("Disguise")
			if inRound and disguise then
				local role = player:GetAttribute("Role")
				table.insert(bits, `You are {disguise} ({role})`)
			elseif not inRound then
				table.insert(bits, "Round in progress - steal while they're busy!")
			end
			local revolver = ReplicatedStorage:GetAttribute("Revolver")
			if revolver == "Dropped" then
				table.insert(bits, "Revolver on the floor!")
			elseif revolver == "Taken" then
				table.insert(bits, "Someone has the Revolver")
			end
			local loot = ReplicatedStorage:GetAttribute("Loot")
			if loot then
				table.insert(bits, `Murderer loot: {loot}`)
			end
			subLabel.Text = table.concat(bits, "   ·   ")
		elseif type(raidEnds) == "number" then
			-- The raid takes over the top of the screen, pulsing red
			local pulse = (math.sin(os.clock() * 6) + 1) / 2
			timerLabel.Text = `🌕 THIEF MOON  {Ui.clock(raidEnds - now)}`
			timerFrame.BackgroundColor3 = Color3.fromRGB(120, 20, 30):Lerp(Color3.fromRGB(200, 40, 50), pulse)
			local revengeUntil = player:GetAttribute("RevengeUntil")
			subLabel.Text = if type(revengeUntil) == "number" and revengeUntil > now
				then `REVENGE! Their vault is open to you: {Ui.clock(revengeUntil - now)}`
				else "Burglars are out · gates are weak · bounties x2!"
		elseif phase == "Results" or status:find("Waiting") then
			timerLabel.Text = if phase == "Results" then "Round over!" else status
			timerFrame.BackgroundColor3 = Ui.PANEL
			subLabel.Text = ""
		else
			timerLabel.Text = `🔪 MURDER ROUND in {clock}`
			timerFrame.BackgroundColor3 = Ui.PANEL
			local revengeUntil = player:GetAttribute("RevengeUntil")
			subLabel.Text = if type(revengeUntil) == "number" and revengeUntil > now
				then `REVENGE! Their vault is open to you: {Ui.clock(revengeUntil - now)}`
				elseif (endsAt - now) < 30 then "Get ready! Check your powers"
				else ""
		end
		banner.Visible = phase == "Results" and not Ui.menuOpen()
		if phase == "Results" then
			banner.Text = status
		end
		upgradesButton.Visible = not inRound and not Ui.menuOpen() and gui:GetAttribute("KnifeGestureActive") ~= true
		stats.Visible = not Ui.menuOpen()
		timers.Visible = not inRound and not Ui.menuOpen()

		-- Event pills
		local nextRaid = ReplicatedStorage:GetAttribute("NextRaidAt")
		-- (only once it's close; the top timer already shows the next murder round)
		raidPill.Visible = type(raidEnds) == "number" or (type(nextRaid) == "number" and nextRaid - now < 60)
		raidText.Text = if type(raidEnds) == "number"
			then `THIEF MOON {Ui.clock(raidEnds - now)}`
			elseif type(nextRaid) == "number" then `Thief Moon in {Ui.clock(nextRaid - now)}`
			else ""
		raidText.TextColor3 = if type(raidEnds) == "number" then Color3.fromRGB(255, 90, 90) else Color3.new(1, 1, 1)
		roundText.Text = if phase == "Round"
			then "Murder round on!"
			elseif status:find("Waiting") then "Waiting for players"
			else `Murder in {clock}`
		local nextChest = (player:GetAttribute("NextFreeChest") or 0) :: number
		local chestLeft = nextChest - now
		chestText.Text = if chestLeft <= 0 then "Free chest\nREADY!" else `Free chest\n{Ui.clock(chestLeft)}`
		chestText.TextColor3 = if chestLeft <= 0 then Color3.fromRGB(120, 255, 140) else Color3.new(1, 1, 1)
		chestPill.Visible = chestLeft <= 0
		shieldPill.Visible = false -- remaining shield/boost times are available in Stats
		raidPill.Visible = false -- the top timer already reports active raids
		-- The chest's own label on the plaza counts down for you too
		if not freeChestLabel or not freeChestLabel.Parent then
			local map = workspace:FindFirstChild("Map")
			local rewards = map and map:FindFirstChild("PlazaRewards")
			local chest = rewards and rewards:FindFirstChild("FreeChest")
			freeChestLabel = chest and chest:FindFirstChild("Text", true) :: TextLabel?
		end
		if freeChestLabel then
			freeChestLabel.Text = if chestLeft <= 0 then "FREE!" else Ui.clock(chestLeft)
			freeChestLabel.TextColor3 = if chestLeft <= 0
				then Color3.fromRGB(120, 255, 140)
				else Color3.fromRGB(220, 220, 230)
		end
		-- Boost
		local boostUntil = player:GetAttribute("BoostUntil")
		local boostLeft = if type(boostUntil) == "number" then boostUntil - now else 0
		if boostLeft > 0 then
			incomeLabel.Text =
				`+${Ui.abbreviate(player:GetAttribute("Income") or 0)}/s  ·  {GameConfig.BoostMultiplier}x BOOST {Ui.clock(
					boostLeft
				)}`
			incomeLabel.TextColor3 = Color3.fromRGB(255, 210, 80)
		else
			incomeLabel.TextColor3 = Color3.new(1, 1, 1)
		end
	end)

	-- Notifications (stack at the bottom middle) -------------------------------------------------
	local toasts = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -230), -- above the power bar and the Energy bar
		Size = UDim2.fromOffset(560, 220),
		BackgroundTransparency = 1,
	}, gui)
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}, toasts)

	Remotes.Notify.OnClientEvent:Connect(function(text: string, kind: string)
		local toast = Ui.label({
			Size = UDim2.new(1, 0, 0, 44),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 0,
			BackgroundColor3 = KIND_COLORS[kind] or KIND_COLORS.info,
			TextScaled = false,
			TextSize = 14,
			TextWrapped = true,
			Text = text,
		}, toasts)
		Ui.corner(toast, 12)
		Ui.stroke(toast, 2)
		Ui.textStroke(toast, 1.5)
		Ui.padding(toast, 14, 4)
		local scale = new("UIScale", { Scale = 0.6 }, toast)
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		task.delay(4, function()
			local fade = TweenService:Create(
				toast,
				TweenInfo.new(0.4),
				{ BackgroundTransparency = 1, TextTransparency = 1, TextStrokeTransparency = 1 }
			)
			fade:Play()
			fade.Completed:Wait()
			toast:Destroy()
		end)
		local labels = {}
		for _, child in toasts:GetChildren() do
			if child:IsA("TextLabel") then
				table.insert(labels, child)
			end
		end
		if #labels > 2 then
			labels[1]:Destroy()
		end
	end)

	-- Classic full-screen role reveal ----------------------------------------------------------
	local reveal = new("Frame", {
		-- Oversized so it also covers the top-bar inset
		Size = UDim2.new(1, 0, 1, 120),
		Position = UDim2.fromOffset(0, -60),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
	}, gui)
	local nameLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(700, 70),
		TextColor3 = Color3.fromRGB(230, 230, 230),
		ZIndex = 21,
	}, reveal)
	local roleLabel = Ui.label({
		Font = Enum.Font.FredokaOne,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(800, 110),
		TextStrokeTransparency = 0,
		ZIndex = 21,
	}, reveal)
	local hintLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.fromOffset(760, 36),
		TextColor3 = Color3.fromRGB(200, 200, 200),
		ZIndex = 21,
	}, reveal)

	Remotes.Role.OnClientEvent:Connect(function(role: string, disguise: string?)
		nameLabel.Text = `You are {disguise or player.DisplayName}`
		if role == "Murderer" then
			roleLabel.Text = "THE MURDERER"
			roleLabel.TextColor3 = Color3.fromRGB(255, 50, 60)
			hintLabel.Text =
				`Your chance was {player:GetAttribute("MurdererChance") or "?"}%. Blend in - your knife arrives in {GameConfig.MurdererGrace}s, and pulling it out shows everyone!`
		else
			roleLabel.Text = "INNOCENT"
			roleLabel.TextColor3 = Color3.fromRGB(90, 230, 120)
			hintLabel.Text = "Survive. Grab coins to charge your powers. Find the Revolver!"
		end
		Effects.Sound(Sounds.Sting, nil, 0.8)
		reveal.Visible = true
		reveal.BackgroundTransparency = 0.15
		for _, label in { nameLabel, roleLabel, hintLabel } do
			label.TextTransparency = 0
			label.TextStrokeTransparency = if label == roleLabel then 0 else 1
		end
		task.delay(3.5, function()
			local info = TweenInfo.new(0.8)
			TweenService:Create(reveal, info, { BackgroundTransparency = 1 }):Play()
			for _, label in { nameLabel, roleLabel, hintLabel } do
				TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
			task.wait(0.8)
			reveal.Visible = false
		end)
	end)

	-- Physical pixels inside Roblox's safe area; input device never controls HUD scale.
	stats.AnchorPoint = Vector2.new(0, 1)
	stats.Position = UDim2.new(0, 12, 1, -12)
	stats.Size = UDim2.fromOffset(232, 44)
	local oldScale = stats:FindFirstChildOfClass("UIScale")
	if oldScale then
		oldScale:Destroy()
	end
	for _, child in stats:GetChildren() do
		if child:IsA("TextLabel") then
			child.Visible = child == speedLabel or child == cashLabel
		end
	end
	Ui.art(stats, "Speed", { Position = UDim2.fromOffset(0, 6), Size = UDim2.fromOffset(32, 32) })
	Ui.art(stats, "Cash", { Position = UDim2.fromOffset(116, 6), Size = UDim2.fromOffset(32, 32) })
	speedLabel.Position, cashLabel.Position = UDim2.fromOffset(34, 0), UDim2.fromOffset(150, 0)
	speedLabel.Size, cashLabel.Size = UDim2.fromOffset(78, 44), UDim2.fromOffset(82, 44)
	for _, text in { speedLabel, cashLabel } do
		text.TextScaled = false
		text.TextSize = 20
		text.TextTruncate = Enum.TextTruncate.AtEnd
	end
	if Ui.Phone then
		stats.Size = UDim2.fromOffset(112, 44)
		stats.Position = UDim2.new(0, 148, 1, -12)
		local pictures = {}
		for _, child in stats:GetChildren() do
			if child:IsA("ImageLabel") then
				table.insert(pictures, child)
			end
		end
		for i, picture in pictures do
			picture.Position, picture.Size = UDim2.fromOffset(0, (i - 1) * 22), UDim2.fromOffset(22, 22)
		end
		speedLabel.Position, cashLabel.Position = UDim2.fromOffset(24, 0), UDim2.fromOffset(24, 22)
		for _, text in { speedLabel, cashLabel } do
			text.Size, text.TextSize = UDim2.fromOffset(88, 22), 16
		end
	end
	timers.AnchorPoint, timers.Position, timers.Size =
		Vector2.new(1, 0), UDim2.new(1, -12, 0, 0), UDim2.fromOffset(120, 44)
	local timerScale = timers:FindFirstChildOfClass("UIScale")
	if timerScale then
		timerScale:Destroy()
	end
	chestPill.Size = UDim2.fromOffset(120, 44)
	chestIcon.Size, chestIcon.Position = UDim2.fromOffset(26, 32), UDim2.fromOffset(2, 6)
	chestText.Position, chestText.Size = UDim2.fromOffset(36, 4), UDim2.fromOffset(80, 36)
	chestText.TextScaled, chestText.TextSize, chestText.TextWrapped = false, 14, true
	goalLabel.Visible = false
	goalLabel:GetPropertyChangedSignal("Visible"):Connect(function()
		if goalLabel.Visible then
			goalLabel.Visible = false
		end
	end)
	energyFrame.AnchorPoint, energyFrame.Position, energyFrame.Size =
		Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 124), UDim2.fromOffset(180, 20)
	energyFrame.AutomaticSize = Enum.AutomaticSize.None
	for _, child in energyFrame:GetChildren() do
		if child:IsA("TextLabel") then
			child.TextSize = 14
			child.Size = UDim2.fromOffset(36, 20)
			child.AutomaticSize = Enum.AutomaticSize.None
			if child ~= countLabel then
				child.Text = "⚡"
				child.Size = UDim2.fromOffset(16, 20)
			end
		elseif child:IsA("Frame") then
			child.Size = UDim2.fromOffset(if table.find(cells, child) then 10 else 1, 14)
		end
	end
	healthFrame.AnchorPoint, healthFrame.Position, healthFrame.Size =
		Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 148), UDim2.fromOffset(180, 20)
	for _, text in { healthText, chanceLabel, subLabel } do
		text.TextScaled = false
		text.TextSize = 14
		text.TextTruncate = Enum.TextTruncate.AtEnd
	end
	local function layout()
		local _, bounds = Ui.bounds()
		local width = math.min(380, math.max(220, bounds.X - 300))
		local center = bounds.X / 2
		if Ui.Phone then
			local right = math.min(center + 90, Ui.Layout.knifePosition().X - 12)
			local left = if bounds.Y < 420 then 256 else 136
			local healthWidth = math.min(180, math.max(80, right - left))
			healthFrame.Position = UDim2.fromOffset(math.min(center, right - healthWidth / 2), 148)
			healthFrame.Size = UDim2.fromOffset(healthWidth, 20)
		end
		timerFrame.Position, timerFrame.Size = UDim2.fromOffset(center, 0), UDim2.fromOffset(width, 40)
		chanceLabel.Position, chanceLabel.Size = UDim2.fromOffset(center, 44), UDim2.fromOffset(width, 20)
		subLabel.Position, subLabel.Size = UDim2.fromOffset(center, 68), UDim2.fromOffset(width, 20)
		subLabel.TextWrapped = false
		eventLabel.Position, eventLabel.Size = UDim2.fromOffset(center, 90), UDim2.fromOffset(width, 20)
		eventLabel.TextScaled, eventLabel.TextSize, eventLabel.TextTruncate = false, 14, Enum.TextTruncate.AtEnd
		banner.Size = UDim2.fromOffset(math.min(600, bounds.X - 24), 44)
		announceHolder.Size = UDim2.fromOffset(math.min(480, bounds.X - 24), 60)
		for _, text in { nameLabel, roleLabel, hintLabel } do
			text.Size = UDim2.new(1, -32, 0, if text == hintLabel then 60 else 54)
			text.TextWrapped = true
		end
		nameLabel.Position = UDim2.new(0.5, 0, 0.5, -72)
		roleLabel.Position = UDim2.new(0.5, 0, 0.5, -12)
		hintLabel.Position = UDim2.new(0.5, 0, 0.5, 54)
		hintLabel.TextScaled, hintLabel.TextSize = false, 14
		toasts.Size, toasts.Position = UDim2.fromOffset(math.min(440, bounds.X - 260), 96), UDim2.new(0.5, 0, 1, -160)
	end
	Ui.Layout.Changed:Connect(layout)
	layout()
	Ui.Menu.Changed:Connect(function()
		toasts.Visible = not Ui.menuOpen()
		announceHolder.Visible = not Ui.menuOpen()
		if Ui.menuOpen() then
			healthFrame.Visible = false
			energyFrame.Visible = false
		else
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			healthFrame.Visible = hum ~= nil
				and hum.Health > 0
				and (hum.Health < hum.MaxHealth or player:GetAttribute("InRound") == true)
			refreshEnergy()
		end
	end)
end

Hud.CashLabel = nil :: TextLabel?

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">IndexView</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local Config = ReplicatedStorage.Shared.Config
local Knives = require(Config.Knives)
local GameConfig = require(Config.GameConfig)
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage.Remotes
local View = {}

function View.Build(): (Frame, () -> number)
	local frame, body = Theme.shell("Index", "Knife Index", Theme.Cyan, "Index", 530)
	local filter = "All"
	local selected = Knives.List[1]
	local found: { [string]: boolean } = {}
	local claimed: { [string]: boolean } = {}
	local filters = Ui.new("ScrollingFrame", {
		Name = "RarityFilters",
		Size = UDim2.new(0, 128, 1, -52),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ZIndex = 7,
	}, body)
	Ui.new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, filters)
	Ui.padding(filters, 3, 3)
	local grid = Ui.new("ScrollingFrame", {
		Name = "Collection",
		Position = UDim2.fromOffset(142, 0),
		Size = UDim2.new(1, -380, 1, -52),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Cyan,
		ZIndex = 7,
	}, body)
	Ui.padding(grid, 3, 3)
	Ui.new("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 176),
		CellPadding = UDim2.fromOffset(8, 9),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	local inspector = Theme.surface(
		body,
		{ Name = "Inspector", Position = UDim2.new(1, -226, 0, 0), Size = UDim2.new(0, 226, 1, 0), ZIndex = 7 },
		Theme.Navy,
		Color3.fromRGB(70, 119, 179)
	)
	local title = Theme.text(
		inspector,
		"",
		{ Name = "KnifeName", Position = UDim2.fromOffset(6, 4), Size = UDim2.new(1, -12, 0, 36), MaximumTextSize = 30 }
	)
	local rarity = Theme.text(
		inspector,
		"",
		{ Position = UDim2.fromOffset(6, 40), Size = UDim2.new(1, -12, 0, 25), MaximumTextSize = 22 }
	)
	local display = Ui.new(
		"Frame",
		{ Position = UDim2.fromOffset(4, 64), Size = UDim2.new(1, -8, 0, 190), BackgroundTransparency = 1, ZIndex = 7 },
		inspector
	)
	local burst = Theme.burst(display, Theme.Gold)
	local art = Theme.image(display, selected.Name)
	Theme.text(
		inspector,
		"Rewards",
		{ Position = UDim2.fromOffset(4, 250), Size = UDim2.new(1, -8, 0, 26), MaximumTextSize = 24 }
	)
	local rewards = {}
	for i, symbol in { "Cash", "Speed" } do
		local tile = Theme.surface(
			inspector,
			{ Position = UDim2.new((i - 1) * 0.5, 6, 0, 278), Size = UDim2.new(0.5, -12, 0, 74), ZIndex = 7 },
			Theme.Navy,
			Color3.fromRGB(61, 99, 144)
		)
		Theme.image(tile, symbol, { Position = UDim2.new(0.5, -28, 0, -4), Size = UDim2.fromOffset(56, 48) })
		rewards[i] = Theme.text(tile, "", {
			Name = symbol .. "Reward",
			Position = UDim2.fromOffset(2, 42),
			Size = UDim2.new(1, -4, 0, 28),
			MaximumTextSize = 22,
		})
	end
	local claim = Theme.button(
		inspector,
		"CLAIM",
		Theme.Green,
		{ Name = "Claim", Position = UDim2.new(0, 6, 1, -60), Size = UDim2.new(1, -12, 0, 54), MaximumTextSize = 40 },
		function()
			Remotes.ClaimIndex:InvokeServer(selected.Name)
		end
	)
	local footer = Theme.surface(
		body,
		{ Name = "Progress", Position = UDim2.new(0, 0, 1, -42), Size = UDim2.new(1, -238, 0, 42), ZIndex = 7 },
		Theme.Navy,
		Color3.fromRGB(47, 103, 155)
	)
	local fill = Theme.surface(
		footer,
		{ Position = UDim2.fromOffset(5, 5), Size = UDim2.new(0, 0, 1, -10), ZIndex = 7, Visible = false },
		Theme.Green
	)
	local progress = Theme.text(footer, "", {
		Name = "ProgressText",
		Position = UDim2.fromOffset(8, 2),
		Size = UDim2.new(1, -150, 1, -4),
		MaximumTextSize = 25,
	})
	local all = Theme.button(footer, "Claim all", Theme.Cyan, {
		Name = "ClaimAll",
		Position = UDim2.new(1, -138, 0, 3),
		Size = UDim2.fromOffset(132, 36),
		MaximumTextSize = 21,
	}, function()
		Remotes.ClaimIndex:InvokeServer("All")
	end)
	local tiles: { [string]: any } = {}
	local filterButtons: { [string]: TextButton } = {}
	local function inspect()
		local known = found[selected.Name] == true
		title.Text = if known then selected.DisplayName else "???"
		rarity.Text, rarity.TextColor3 = selected.Rarity:upper(), Knives.RarityColors[selected.Rarity]
		art:Destroy()
		art = Theme.image(
			display,
			selected.Name,
			{ ImageColor3 = if known then Color3.new(1, 1, 1) else Color3.new(0, 0, 0) }
		)
		burst.Visible = known
		local reward = GameConfig.IndexRewards[selected.Rarity]
		rewards[1].Text, rewards[2].Text = "+$" .. Ui.abbreviate(reward.Cash), "+" .. Ui.abbreviate(reward.Speed)
		Theme.enabled(
			claim,
			known and not claimed[selected.Name],
			if not known then "UNDISCOVERED" elseif claimed[selected.Name] then "CLAIMED" else "CLAIM"
		)
		for name, tile in tiles do
			tile.Border.Color = if name == selected.Name then Theme.Gold else Theme.Black
			tile.Border.Thickness = if name == selected.Name then 4 else 3
		end
	end
	local function applyFilter()
		for _, knife in Knives.List do
			tiles[knife.Name].Button.Visible = filter == "All" or knife.Rarity == filter
		end
		for name, button in filterButtons do
			local border = button:FindFirstChildOfClass("UIStroke") :: UIStroke
			border.Color = if name == filter then Theme.Gold else Theme.Black
		end
		grid.CanvasPosition = Vector2.zero
	end
	local names = { "All" }
	for _, name in Knives.Rarities do
		table.insert(names, name)
	end
	for order, name in names do
		local color = if name == "All" then Theme.Green else Knives.RarityColors[name]
		filterButtons[name] = Theme.button(
			filters,
			name,
			color,
			{ Name = name, LayoutOrder = order, Size = UDim2.new(1, -6, 0, 37), MaximumTextSize = 21 },
			function()
				filter = name
				applyFilter()
			end
		)
	end
	for order, knife in Knives.List do
		local button = Theme.button(
			grid,
			"",
			Knives.RarityColors[knife.Rarity],
			{ Name = knife.Name, LayoutOrder = order, MaximumTextSize = 25 },
			function()
				selected = knife
				inspect()
			end
		)
		local border = button:FindFirstChildOfClass("UIStroke") :: UIStroke
		local name = Theme.text(button, "???", {
			Name = "KnifeName",
			Position = UDim2.fromOffset(4, 3),
			Size = UDim2.new(1, -8, 0, 30),
			MaximumTextSize = 23,
			ZIndex = 10,
		})
		local image = Theme.image(
			button,
			knife.Name,
			{ Position = UDim2.fromOffset(3, 28), Size = UDim2.new(1, -6, 1, -32), ZIndex = 9 }
		)
		tiles[knife.Name] = { Button = button, Name = name, Art = image, Border = border }
	end
	local function refresh(): number
		found, claimed = {}, {}
		for _, name in Ui.list(player:GetAttribute("Discovered")) do
			found[name] = true
		end
		for _, name in Ui.list(player:GetAttribute("IndexClaimed")) do
			claimed[name] = true
		end
		local count, claimable = 0, 0
		for _, knife in Knives.List do
			local known = found[knife.Name] == true
			count += if known then 1 else 0
			claimable += if known and not claimed[knife.Name] then 1 else 0
			local tile = tiles[knife.Name]
			tile.Name.Text = if known then knife.DisplayName else "???"
			tile.Art.ImageColor3 = if known then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		end
		fill.Size = UDim2.new(count / #Knives.List, -10 * count / #Knives.List, 1, -10)
		fill.Visible = count > 0
		progress.Text = `Discovered: {count} / {#Knives.List}`
		Theme.enabled(all, claimable > 0, `Claim all ({claimable})`)
		inspect()
		return claimable
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible then
			refresh()
		end
	end)
	refresh()
	applyFilter()
	return frame, refresh
end

return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">KnifeAim</string>
            <string name="Source"><![CDATA[--!strict
-- Joystick visuals with native touch-pan sensitivity (Roblox CameraInput).
-- Camera motion follows finger movement, never a fixed time-based turn rate.
local Aim = {}
Aim.ButtonSize = 160
function Aim.Axis(pointer: Vector2, origin: Vector2): Vector2
	local offset = (pointer - origin) / 48
	return if offset.Magnitude > 1 then offset.Unit else offset
end
function Aim.RotationDelta(camera: CFrame, pixels: Vector2, invertY: number?): Vector2
	local pitch = math.asin(math.clamp(camera.LookVector.Y, -1, 1))
	local vertical = 1
	if pixels.Y * pitch < 0 then
		vertical = (1 - (2 * math.abs(pitch) / math.pi) ^ 0.75) * 0.75 + 0.25
	end
	return Vector2.new(math.rad(pixels.X), math.rad(pixels.Y * 0.66) * vertical * (invertY or 1))
end
function Aim.Rotate(camera: CFrame, focus: Vector3, pixels: Vector2, invertY: number?): CFrame
	if pixels == Vector2.zero then
		return camera
	end
	local distance = (camera.Position - focus).Magnitude
	local delta = Aim.RotationDelta(camera, pixels, invertY)
	local look = camera.LookVector
	local yaw = math.atan2(-look.X, -look.Z) - delta.X
	local pitch = math.clamp(math.asin(look.Y) - delta.Y, math.rad(-80), math.rad(80))
	local rotation = CFrame.fromOrientation(pitch, yaw, 0)
	local position = if distance < 1 then camera.Position else focus - rotation.LookVector * distance
	return CFrame.new(position) * rotation
end
return Aim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">KnifeGesture</string>
            <string name="Source"><![CDATA[--!strict
-- Pure gesture policy: only the pointer that pressed the knife can release it.
-- No world input, rendering, or server requests belong in this module.
local Gesture = {}
Gesture.__index = Gesture

export type State = {
	owner: any,
	started: number,
	mode: string,
	lastRepeat: number,
}

function Gesture.new(): State
	return { owner = nil, started = 0, mode = "idle", lastRepeat = 0 }
end

function Gesture.press(state: State, owner: any, now: number): boolean
	if state.owner ~= nil then
		return false
	end
	state.owner, state.started, state.mode = owner, now, "pending"
	return true
end

function Gesture.tick(state: State, now: number, canCharge: boolean, spam: boolean): string?
	if state.owner == nil or now - state.started < 0.2 then
		return nil
	end
	if spam and (state.mode == "pending" or state.mode == "spam") then
		if state.mode == "pending" or now - state.lastRepeat >= 0.1 then
			state.mode, state.lastRepeat = "spam", now
			return "spam"
		end
	elseif state.mode == "pending" then
		state.mode = if canCharge then "charging" else "blocked"
		return if canCharge then "charge" else "cooldown"
	elseif state.mode == "spam" and not spam then
		state.mode = "blocked"
	end
	return nil
end

function Gesture.cancel(state: State)
	state.owner, state.mode = nil, "idle"
end

function Gesture.release(state: State, owner: any, now: number, spam: boolean): string?
	if state.owner ~= owner or state.owner == nil then
		return nil
	end
	local mode = state.mode
	local tap = mode == "pending" and now - state.started < 0.2
	Gesture.cancel(state)
	if tap then
		return if spam then "spam" else "swing"
	end
	return if mode == "charging" then "throw" else nil
end

return Gesture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">KnifeTrails</string>
            <string name="Source"><![CDATA[--!strict
-- Running fast should *feel* fast (Steal An Egg style), on this client:
--   * knife trails: anyone with a trail (attribute TrailLevel, or the Phantom Trail pass) sheds a
--     stream of their trail's knife as they run - spinning, glowing in the trail colour, fading out.
--     The faster they go, the thicker the stream. Hidden in rounds (disguises stay anonymous).
--   * for you: the camera widens with your speed, speed lines streak in from the screen edges,
--     the wind gets louder and your feet kick up dust.
-- Purely cosmetic; speed itself is the server's (BaseService.RefreshWalkSpeed).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Ui = require(script.Parent.Ui)
local Lod = require(script.Parent.Lod)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local KnifeModel = require(Shared:WaitForChild("KnifeModel"))
local Sounds = require(Shared.Config:WaitForChild("Sounds"))
local player = Players.LocalPlayer
local new = Ui.new

local KnifeTrails = {}

local BASE_FOV = 70
local MAX_EXTRA_FOV = 24
local KNIFE_LENGTH = 3
local LIFE = 0.55
local MAX_PER_PLAYER = if Ui.Phone then 12 else 24 -- phones get a lighter stream
local VIEW_DISTANCE = if Ui.Phone then 120 else 170

type Trail = { Knife: string, Color: Color3 }
type Flying = { Model: Model, Parts: { BasePart }, Born: number, Spin: Vector3, Drift: Vector3, Base: CFrame }

local templates: { [string]: Model } = {}
local flying: { [Player]: { Flying } } = {}
local lastSpawn: { [Player]: number } = {}
local folder: Folder

-- The trail a player shows, if any
local function trailOf(other: Player): Trail?
	if other:GetAttribute("InRound") then
		return nil
	end
	if other:GetAttribute("Pass_PhantomTrail") then
		return GameConfig.PhantomTrail
	end
	local level = other:GetAttribute("TrailLevel")
	local trail = if type(level) == "number" then GameConfig.Trails[level] else nil
	return trail
end

-- A small glowing copy of a knife, built once per kind and cloned after that
local function template(knife: string, color: Color3): Model
	local key = knife .. color:ToHex()
	local cached = templates[key]
	if cached then
		return cached
	end
	local model = KnifeModel.Build(knife, false)
	KnifeModel.FitLength(model, KNIFE_LENGTH)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			d.Massless = true
		elseif d:IsA("Script") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Light") then
			d:Destroy()
		end
	end
	-- Every knife in the stream leaves a short streak in the trail's colour (Highlights would be
	-- simpler, but Roblox only draws ~31 of those at once)
	local _, size = model:GetBoundingBox()
	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if anchor then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, size.Y * 0.4, 0)
		a0.Parent = anchor
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -size.Y * 0.4, 0)
		a1.Parent = anchor
		local streak = Instance.new("Trail")
		streak.Attachment0 = a0
		streak.Attachment1 = a1
		streak.Color = ColorSequence.new(color)
		streak.LightEmission = 1
		streak.LightInfluence = 0
		streak.Lifetime = 0.18
		streak.Transparency = NumberSequence.new(0.3, 1)
		streak.Parent = anchor
	end
	templates[key] = model
	return model
end

local function spawnKnife(other: Player, root: BasePart, velocity: Vector3, trail: Trail)
	local list = flying[other] or {}
	flying[other] = list
	if #list >= MAX_PER_PLAYER then
		return
	end
	local rng = Random.new()
	local back = -velocity.Unit
	local side = back:Cross(Vector3.yAxis)
	local at = root.Position
		+ back * rng:NextNumber(1.5, 3)
		+ side * rng:NextNumber(-1.4, 1.4)
		+ Vector3.new(0, rng:NextNumber(-1.6, 1.2), 0)
	local model = template(trail.Knife, trail.Color):Clone()
	local base = CFrame.lookAt(at, at + velocity) * CFrame.Angles(math.rad(rng:NextNumber(-60, 60)), 0, math.rad(90))
	model:PivotTo(base)
	local parts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	model.Parent = folder
	table.insert(list, {
		Model = model,
		Parts = parts,
		Born = os.clock(),
		Spin = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-14, 14), rng:NextNumber(-8, 8)), -- rad/s
		Drift = back * rng:NextNumber(2, 5) + Vector3.new(0, rng:NextNumber(0.5, 2.5), 0),
		Base = base,
	})
end

local function stepTrails(now: number)
	local camera = workspace.CurrentCamera
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local trail = trailOf(other)
		if root and trail and camera and (root.Position - camera.CFrame.Position).Magnitude < VIEW_DISTANCE then
			local velocity = root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
			local speed = velocity.Magnitude
			if speed > 14 then
				-- Faster = more knives (one every ~0.1s at a jog, every ~0.025s flat out)
				local interval = math.clamp(2.2 / speed, 0.025, 0.1)
				-- Weaker devices (LOD profile) get a thinner stream, and other people's trails thinner still
				local fewest = if Lod.Profile == "Low" then 0.09 elseif Lod.Profile == "Medium" then 0.05 else 0.025
				interval = math.max(interval, if other == Players.LocalPlayer then fewest else fewest * 1.6)
				local live = flying[other]
				local cap = if Lod.Profile == "Low" then 8 elseif Lod.Profile == "Medium" then 14 else 30
				if live and #live >= cap then
					continue
				end
				if now - (lastSpawn[other] or 0) >= interval then
					lastSpawn[other] = now
					spawnKnife(other, root, velocity, trail)
				end
			end
		end
	end
	-- Animate and retire
	for other, list in flying do
		for i = #list, 1, -1 do
			local f = list[i]
			local t = (now - f.Born) / LIFE
			if t >= 1 or not f.Model.Parent then
				f.Model:Destroy()
				table.remove(list, i)
				continue
			end
			local age = now - f.Born
			local spin = f.Spin * age
			f.Model:PivotTo(CFrame.new(f.Drift * age) * f.Base * CFrame.Angles(spin.X, spin.Y, spin.Z))
			local fade = t * t
			for _, p in f.Parts do
				p.LocalTransparencyModifier = fade
			end
		end
		if #list == 0 and not other.Parent then
			flying[other] = nil
		end
	end
end

-- Your own speed: camera, lines, wind, dust ------------------------------------------------------

function KnifeTrails.Init()
	folder = Instance.new("Folder")
	folder.Name = "KnifeTrailFx"
	folder.Parent = workspace

	local gui = new("ScreenGui", {
		Name = "SpeedLines",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 1,
	}, player:WaitForChild("PlayerGui"))
	-- Thin white streaks pointing at the middle of the screen from all round the edge
	local lines: { { Frame: Frame, Angle: number, Phase: number } } = {}
	local rng = Random.new()
	for i = 1, 26 do
		local angle = (i / 26) * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local line = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(rng:NextInteger(90, 200), 2),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Rotation = math.deg(angle),
		}, gui)
		table.insert(lines, { Frame = line, Angle = angle, Phase = rng:NextNumber(0, 1) })
	end

	local wind = Instance.new("Sound")
	wind.SoundId = Sounds.Wind
	wind.Looped = true
	wind.Volume = 0
	wind.Parent = SoundService
	wind:Play()

	-- Dust at your feet (a fresh emitter for every character: the old one dies with it)
	local dustTemplate = Instance.new("ParticleEmitter")
	local dust = dustTemplate
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(200, 190, 175))
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	dust.Lifetime = NumberRange.new(0.4, 0.7)
	dust.Speed = NumberRange.new(1, 3)
	dust.SpreadAngle = Vector2.new(40, 40)
	dust.Rate = 0
	local function attachDust(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if root then
			local at = Instance.new("Attachment")
			at.Name = "DustAt"
			at.Position = Vector3.new(0, -2.8, 0.6)
			at.Parent = root
			dust = dustTemplate:Clone()
			dust.Parent = at
		end
	end
	if player.Character then
		task.spawn(attachDust, player.Character)
	end
	player.CharacterAdded:Connect(attachDust)

	local fovNow = BASE_FOV
	local linesHidden = false
	RunService.RenderStepped:Connect(function(dt: number)
		local now = os.clock()
		stepTrails(now)

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local speed = if root then (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude else 0
		local inRound = player:GetAttribute("InRound") == true
		-- 0 at a normal jog, 1 flat out
		local rush = if inRound then 0 else math.clamp((speed - 20) / (GameConfig.MaxWalkSpeed - 20), 0, 1)

		-- Camera: wider the faster you go (left alone while something else is steering the FOV:
		-- aiming a throw, or being pulled by a knife aura)
		local camera = workspace.CurrentCamera
		local busy = (character and character:GetAttribute("ChargeStart") ~= nil)
			or player:GetAttribute("AuraSlow") ~= nil
		if camera and not busy then
			local target = BASE_FOV + MAX_EXTRA_FOV * rush
			fovNow += (target - fovNow) * math.min(1, dt * 4)
			if math.abs(camera.FieldOfView - fovNow) > 0.05 then
				camera.FieldOfView = fovNow
			end
		elseif camera then
			fovNow = camera.FieldOfView
		end

		-- Speed lines from the edges (nothing to move while they're all hidden)
		if rush <= 0.25 and linesHidden then
			wind.Volume = 0
			dust.Rate = 0
			return
		end
		linesHidden = rush <= 0.25
		local size = gui.AbsoluteSize
		local radius = math.max(size.X, size.Y) * 0.5
		for _, l in lines do
			local phase = (now * 2.6 + l.Phase) % 1
			local dist = radius * (1.05 - phase * 0.35)
			l.Frame.Position = UDim2.new(0.5, math.cos(l.Angle) * dist, 0.5, math.sin(l.Angle) * dist)
			l.Frame.BackgroundTransparency = if rush > 0.25 then 1 - (rush - 0.25) * 0.75 * (1 - phase) else 1
		end

		wind.Volume = 0.6 * rush
		wind.PlaybackSpeed = 0.9 + 0.3 * rush
		dust.Rate = if rush > 0.1 and root then 30 * rush else 0
	end)
end

return KnifeTrails
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[--!strict
-- Safe-area geometry, independent of whether a keyboard/controller is attached.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Layout = {}
Layout.KnifeSize = require(script.Parent.KnifeAim).ButtonSize
local changed = Instance.new("BindableEvent")
Layout.Changed = changed.Event
local root: GuiObject? = nil

function Layout.metrics(size: Vector2)
	return {
		Compact = size.X < 900 or size.Y < 500,
		Short = size.Y < 420,
		Menu = Vector2.new(math.min(960, math.max(0, size.X - 24)), math.min(650, math.max(0, size.Y - 24))),
		NavigationWidth = if size.Y < 420 then 232 else 112,
	}
end
function Layout.bind(frame: GuiObject)
	root = frame
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		changed:Fire()
	end)
	frame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		changed:Fire()
	end)
end
function Layout.bounds(): (Vector2, Vector2)
	if root then
		return root.AbsolutePosition, root.AbsoluteSize
	end
	return Vector2.zero, workspace.CurrentCamera.ViewportSize
end
function Layout.get()
	local _, size = Layout.bounds()
	return Layout.metrics(size)
end
function Layout.touchBounds(): (Vector2, Vector2)
	local origin, size = Layout.bounds()
	local jump = Players.LocalPlayer.PlayerGui:FindFirstChild("JumpButton", true)
	if jump and jump:IsA("GuiObject") and jump.Visible and jump.AbsoluteSize.X > 0 then
		return jump.AbsolutePosition - origin, jump.AbsoluteSize
	end
	local diameter = if size.Y < 500 then 70 else 120
	return Vector2.new(size.X - diameter * 1.5 + 10, size.Y - diameter - 20), Vector2.one * diameter
end
function Layout.knifePosition(): Vector2
	local _, size = Layout.bounds()
	local jump = Layout.touchBounds()
	return Vector2.new(
		math.clamp(jump.X - Layout.KnifeSize - 12, 12, math.max(12, size.X - Layout.KnifeSize - 12)),
		math.clamp(jump.Y - 12, 64, math.max(64, size.Y - Layout.KnifeSize - 12))
	)
end
function Layout.fit(frame: GuiObject, maximum: Vector2?)
	local function resize()
		local size = Layout.get().Menu
		local maxSize = maximum or Vector2.new(960, 650)
		maxSize = Vector2.new(
			(frame:GetAttribute("MaximumWidth") or maxSize.X) :: number,
			(frame:GetAttribute("MaximumHeight") or maxSize.Y) :: number
		)
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromOffset(
			math.min(size.X, maxSize.X),
			math.min(size.Y, maxSize.Y, (frame:GetAttribute("PreferredHeight") or maxSize.Y) :: number)
		)
	end
	local connection = Layout.Changed:Connect(resize)
	frame:GetAttributeChangedSignal("PreferredHeight"):Connect(resize)
	frame:GetAttributeChangedSignal("MaximumWidth"):Connect(resize)
	frame:GetAttributeChangedSignal("MaximumHeight"):Connect(resize)
	frame.Destroying:Connect(function()
		connection:Disconnect()
	end)
	resize()
end
-- Studio-only virtual safe area, for repeatable layout checks without changing world scale.
function Layout.preview(size: Vector2?)
	assert(RunService:IsStudio(), "Preview is Studio-only")
	if root then
		root.Size = if size then UDim2.fromOffset(size.X, size.Y) else UDim2.fromScale(1, 1)
		changed:Fire()
	end
end
return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Lod</string>
            <string name="Source"><![CDATA[--!strict
-- Level of detail for weak devices. The world has hundreds of lights and dozens of particle
-- effects (vault chandeliers, sconces, knife auras, guard lanterns, biome props); a phone can't
-- light all of them. Every few frames this works through a slice of them and only keeps on:
--   * lights within LightRange of the camera, the closest LightBudget of them
--   * particles / fire / sparkles within ParticleRange
-- Phones (and the lowest graphics levels) get tighter numbers and no bloom. Anything another
-- script turns off stays off: LOD only ever switches off what was on, and puts it back as it was.
--
-- Lod.Near(position, range) is the shared distance check other client loops use to skip work
-- on things nobody can see (Moves, Effects spinners).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Lod = {}

type Profile = { LightRange: number, LightBudget: number, ParticleRange: number, AnimRange: number }

local PROFILES: { [string]: Profile } = {
	High = { LightRange = 160, LightBudget = 64, ParticleRange = 180, AnimRange = 220 },
	Medium = { LightRange = 110, LightBudget = 36, ParticleRange = 120, AnimRange = 150 },
	Low = { LightRange = 70, LightBudget = 18, ParticleRange = 75, AnimRange = 100 },
}

local profile: Profile = PROFILES.High
Lod.Profile = "High"

local lights: { [Light]: boolean } = {} -- tracked lights -> currently culled by us
local effects: { [Instance]: boolean } = {} -- ParticleEmitter / Fire / Sparkles / Smoke
local lightList: { Light } = {}
local effectList: { Instance } = {}
local dirty = true

-- (Studio: ReplicatedStorage DebugPhone = true previews the phone profile, like Ui.Phone)
local function phone(): boolean
	return (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
		or (RunService:IsStudio() and game:GetService("ReplicatedStorage"):GetAttribute("DebugPhone") == true)
end

local applyStars: (ParticleEmitter) -> ()
local applyKnifeAura: (ParticleEmitter) -> ()

-- The graphics slider (1-10; 0 = automatic) decides the profile; phones never go above Medium
local function pickProfile()
	local level = 0
	pcall(function()
		level = UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	local name
	if level == 0 then
		name = if phone() then "Low" else "High"
	elseif level <= 3 then
		name = "Low"
	elseif level <= 6 then
		name = "Medium"
	else
		name = "High"
	end
	if phone() and name == "High" then
		name = "Medium"
	end
	if name ~= Lod.Profile then
		Lod.Profile = name
	end
	profile = PROFILES[name]
	for _, part in game:GetService("CollectionService"):GetTagged("StarField") do
		local emitter = part:FindFirstChildOfClass("ParticleEmitter")
		if emitter then
			applyStars(emitter)
		end
	end
	for _, effect in game:GetService("CollectionService"):GetTagged("KnifeAuraEmitter") do
		if effect:IsA("ParticleEmitter") then
			applyKnifeAura(effect)
		end
	end
	-- Bloom is a full-screen pass: skip it on low settings
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Enabled = name ~= "Low"
	end
end

local function positionOf(instance: Instance): Vector3?
	local parent = instance.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

local function isEffect(instance: Instance): boolean
	return instance:IsA("ParticleEmitter") or instance:IsA("Fire") or instance:IsA("Sparkles") or instance:IsA("Smoke")
end

-- Star fields (tag "StarField" on the emitter's part) are seen from everywhere: instead of being
-- culled by distance, their density follows the profile
local STAR_DENSITY: { [string]: number } = { High = 1, Medium = 0.55, Low = 0.25 }
local AURA_DENSITY: { [string]: number } = { High = 1, Medium = 0.65, Low = 0.35 }
applyKnifeAura = function(emitter: ParticleEmitter)
	local rate = emitter:GetAttribute("BaseRate")
	if type(rate) == "number" then
		local minimum = emitter:GetAttribute("AuraMinRate")
		local floor = if type(minimum) == "number" then minimum else 0
		emitter.Rate = math.min(rate, math.max(floor, rate * AURA_DENSITY[Lod.Profile]))
	end
end
local function isStarField(instance: Instance): boolean
	local parent = instance.Parent
	return parent ~= nil and game:GetService("CollectionService"):HasTag(parent, "StarField")
end
applyStars = function(emitter: ParticleEmitter)
	local base = emitter:GetAttribute("BaseRate")
	if type(base) ~= "number" then
		base = emitter.Rate
		emitter:SetAttribute("BaseRate", base)
	end
	emitter.Rate = (base :: number) * (STAR_DENSITY[Lod.Profile] or 1)
	-- Fill the sky straight away instead of over the first half minute (once per emitter)
	if not emitter:GetAttribute("Filled") then
		emitter:SetAttribute("Filled", true)
		task.defer(function()
			emitter:Emit(math.floor(emitter.Rate * emitter.Lifetime.Max * 0.8))
		end)
	end
end

local function add(instance: Instance)
	if instance:IsA("ParticleEmitter") and instance:HasTag("KnifeAuraEmitter") then
		applyKnifeAura(instance)
	end
	if instance:IsA("ParticleEmitter") and isStarField(instance) then
		applyStars(instance)
		return
	end
	if instance:IsA("Light") then
		if lights[instance] == nil then
			lights[instance] = false
			dirty = true
		end
	elseif isEffect(instance) then
		if effects[instance] == nil then
			effects[instance] = false
			dirty = true
		end
	end
end

local function remove(instance: Instance)
	if lights[instance :: any] ~= nil then
		lights[instance :: any] = nil
		dirty = true
	elseif effects[instance] ~= nil then
		effects[instance] = nil
		dirty = true
	end
end

local function rebuildLists()
	table.clear(lightList)
	for light in lights do
		table.insert(lightList, light)
	end
	table.clear(effectList)
	for effect in effects do
		table.insert(effectList, effect)
	end
	dirty = false
end

-- Turn something off for LOD (remembering it was on), or back on if LOD turned it off
local function setCulled(instance: Instance, culled: boolean, map: { [any]: boolean })
	local was = map[instance]
	if culled and not was then
		if (instance :: any).Enabled then
			(instance :: any).Enabled = false
			map[instance] = true
		end
	elseif not culled and was then
		(instance :: any).Enabled = true
		map[instance] = false
	end
end

local cameraPosition = Vector3.zero

-- Shared cheap check for other client loops: is `position` close enough to be worth animating?
function Lod.Near(position: Vector3, range: number?): boolean
	return (position - cameraPosition).Magnitude <= (range or profile.AnimRange)
end

function Lod.AnimRange(): number
	return profile.AnimRange
end

-- Lights: everything in range, then only the closest LightBudget of those
local scored: { { Light: Light, Distance: number } } = {}
local function updateLights()
	table.clear(scored)
	local range = profile.LightRange
	for _, light in lightList do
		local position = positionOf(light)
		if not position or not light.Parent then
			continue
		end
		local distance = (position - cameraPosition).Magnitude
		if distance <= range then
			table.insert(scored, { Light = light, Distance = distance })
		else
			setCulled(light, true, lights)
		end
	end
	table.sort(scored, function(a, b)
		return a.Distance < b.Distance
	end)
	for i, entry in scored do
		setCulled(entry.Light, i > profile.LightBudget, lights)
	end
end

local function updateEffects()
	local range = profile.ParticleRange
	for _, effect in effectList do
		local position = positionOf(effect)
		if position and effect.Parent then
			setCulled(effect, (position - cameraPosition).Magnitude > range, effects)
		end
	end
end

function Lod.Init()
	pickProfile()
	pcall(function()
		UserSettings().GameSettings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(pickProfile)
	end)
	for _, d in workspace:GetDescendants() do
		add(d)
	end
	workspace.DescendantAdded:Connect(add)
	workspace.DescendantRemoving:Connect(remove)

	-- Lights and effects alternate, a few times a second: plenty for things that only change as
	-- you walk, and nearly free per frame
	local timer = 0
	local turn = false
	RunService.Heartbeat:Connect(function(dt: number)
		cameraPosition = workspace.CurrentCamera.CFrame.Position
		timer += dt
		if timer < 0.2 then
			return
		end
		timer = 0
		if dirty then
			rebuildLists()
		end
		turn = not turn
		if turn then
			updateLights()
		else
			updateEffects()
		end
	end)
end

return Lod
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="81">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry point. The client is display + requests only; the server owns every number.
-- Works with mouse, touch and gamepad.

local clientStart = os.clock() -- requires included: some wait on replicated modules
local Lod = require(script.Parent.Lod)
local Effects = require(script.Parent.Effects)
local Hud = require(script.Parent.Hud)
local Menus = require(script.Parent.Menus)
local Abilities = require(script.Parent.Abilities)
local Moves = require(script.Parent.Moves)
local PowerBar = require(script.Parent.PowerBar)
local Unbox = require(script.Parent.Unbox)
local Raid = require(script.Parent.Raid)
local Atmosphere = require(script.Parent.Atmosphere)
local Tutorial = require(script.Parent.Tutorial)
local Welcome = require(script.Parent.Welcome)
local Store = require(script.Parent.Store)
local KnifeTrails = require(script.Parent.KnifeTrails)
local Transitions = require(script.Parent.Transitions)
local Overheads = require(script.Parent.Overheads)
local RoundIntro = require(script.Parent.RoundIntro)
local Tumble = require(script.Parent.Tumble)
local WorldLabels = require(script.Parent.WorldLabels)

-- Timed, so slow starts show up in the output (the summary prints once everything is up)
local clientTimings: { string } = {}
local function timed(name: string, fn: () -> ())
	local t = os.clock()
	fn()
	table.insert(clientTimings, string.format("%s %.0fms", name, (os.clock() - t) * 1000))
end
timed("Lod", Lod.Init)
timed("Moves", Moves.Init)
timed("Effects", Effects.Init)
timed("Hud", Hud.Init)
timed("Menus", Menus.Init)
timed("Abilities", Abilities.Init)
timed("PowerBar", PowerBar.Init)
timed("Unbox", Unbox.Init)
timed("Raid", Raid.Init)
timed("Atmosphere", Atmosphere.Init)
timed("Welcome", Welcome.Init)
timed("Store", Store.Init)
timed("KnifeTrails", KnifeTrails.Init)
timed("Transitions", Transitions.Init)
timed("Overheads", Overheads.Init)
timed("RoundIntro", RoundIntro.Init)
timed("Tumble", Tumble.Init)
timed("WorldLabels", WorldLabels.Init)
task.spawn(Tutorial.Init)
print(
	string.format(
		"[Steal a Knife] client ready in %.2fs (%s)",
		os.clock() - clientStart,
		table.concat(clientTimings, ", ")
	)
)

-- No tumbling: Roblox's FallingDown / Ragdoll states knock you over after hard landings, bumps and
-- dashes into walls. The client owns its character's state machine, so they're turned off here.
-- (Dying still ragdolls - that's the Dead state, handled by the server.)
local player = game:GetService("Players").LocalPlayer
local function steady(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	end
end
if player.Character then
	task.spawn(steady, player.Character)
end
player.CharacterAdded:Connect(steady)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">MenuController</string>
            <string name="Source"><![CDATA[--!strict
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Lod = require(script.Parent.Lod)
local Menu = {}
local entries: { [GuiObject]: boolean } = {}
local active: GuiObject? = nil
local savedFocus: GuiObject? = nil
local backpack = true
local gui: ScreenGui
local backdrop: GuiObject
local transitioning = false
local changed = Instance.new("BindableEvent")
Menu.Changed = changed.Event
local blur = Instance.new("BlurEffect")
blur.Name = "MenuBlur"
blur.Size = 8
blur.Enabled = false
blur.Parent = Lighting

function Menu.CanBlur(): boolean
	local level = UserSettings().GameSettings.SavedQualityLevel.Value
	return level > 6 or (level == 0 and Lod.Profile == "High")
end

local function refresh()
	if transitioning then
		return
	end
	local nextActive: GuiObject? = nil
	for frame in entries do
		if frame.Parent and frame.Visible then
			nextActive = frame
			break
		end
	end
	local wasOpen = active ~= nil
	active = nextActive
	local open = active ~= nil
	if open and not wasOpen then
		savedFocus = GuiService.SelectedObject
		pcall(function()
			backpack = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack)
		end)
	elseif wasOpen and not open then
		GuiService.SelectedObject = nil
		if savedFocus and savedFocus.Parent and savedFocus.Visible then
			GuiService.SelectedObject = savedFocus
		end
		savedFocus = nil
	end
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, if open then false else backpack)
	end)
	gui:SetAttribute("MenuOpen", open)
	gui:SetAttribute("ActiveMenu", if active then active.Name else nil)
	backdrop.Visible = open
	blur.Enabled = open and gui:GetAttribute("MenuBlurEnabled") == true and Menu.CanBlur()
	if active and UserInputService.PreferredInput == Enum.PreferredInput.Gamepad then
		local close = active:FindFirstChild("Close", true)
		if close and close:IsA("GuiObject") then
			GuiService.SelectedObject = close
		end
	end
	changed:Fire(active)
end
function Menu.Register(frame: GuiObject)
	if entries[frame] then
		return
	end
	entries[frame] = true
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible and not transitioning then
			transitioning = true
			for other in entries do
				if other ~= frame then
					other.Visible = false
				end
			end
			transitioning = false
		end
		refresh()
	end)
	frame.Destroying:Connect(function()
		entries[frame] = nil
		refresh()
	end)
	if frame.Visible then
		transitioning = true
		for other in entries do
			if other ~= frame then
				other.Visible = false
			end
		end
		transitioning = false
	end
	refresh()
end
function Menu.Open(frame: GuiObject)
	frame.Visible = true
end
function Menu.Close()
	transitioning = true
	for frame in entries do
		frame.Visible = false
	end
	transitioning = false
	refresh()
end
function Menu.Toggle(frame: GuiObject)
	frame.Visible = not frame.Visible
end
function Menu.IsOpen(): boolean
	return active ~= nil
end
function Menu.Current(): GuiObject?
	return active
end
function Menu.Init(screen: ScreenGui, overlay: GuiObject)
	gui, backdrop = screen, overlay
	gui:SetAttribute("MenuBlurEnabled", false)
	gui:GetAttributeChangedSignal("MenuBlurEnabled"):Connect(refresh)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
			Menu.Close()
		end
	end)
	Players.LocalPlayer:GetAttributeChangedSignal("InRound"):Connect(function()
		if Players.LocalPlayer:GetAttribute("InRound") then
			Menu.Close()
		end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(Menu.Close)
	UserSettings().GameSettings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
		task.defer(refresh)
	end)
end
return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">MenuTheme</string>
            <string name="Source"><![CDATA[--!strict
-- The illustrated concept's shared surfaces, typography and sprite assets.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Ui = require(script.Parent.Ui)
local Art = require(ReplicatedStorage.Shared.Config.MenuArtwork)
local Textures = require(ReplicatedStorage.Shared.Config.Textures)
local Theme = {}
Theme.Navy = Color3.fromRGB(12, 29, 48)
Theme.Green = Color3.fromRGB(45, 244, 15)
Theme.Cyan = Color3.fromRGB(0, 203, 255)
Theme.Purple = Color3.fromRGB(190, 31, 250)
Theme.Gold = Color3.fromRGB(255, 207, 28)
Theme.Red = Color3.fromRGB(255, 46, 57)
Theme.Black = Color3.fromRGB(4, 7, 12)
local icons = {
	CaseLegendary = 1,
	CaseEpic = 2,
	CaseGodly = 3,
	Cash = 4,
	Index = 5,
	Rebirth = 6,
	Speed = 7,
	Training = 8,
	Luck = 9,
}

function Theme.outline(parent: Instance, color: Color3?, thickness: number?)
	return Ui.new(
		"UIStroke",
		{ Color = color or Theme.Black, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border },
		parent
	)
end

function Theme.text(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local options: { [string]: any } = {
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		ZIndex = 8,
	}
	local maximum = 32
	for key, value in (props or {}) :: { [string]: any } do
		if key == "MaximumTextSize" then
			maximum = value
		else
			options[key] = value
		end
	end
	local label: TextLabel = Ui.new("TextLabel", options, parent)
	if label.TextScaled then
		Ui.new("UITextSizeConstraint", { MinTextSize = 10, MaxTextSize = maximum }, label)
	end
	Ui.new("UIStroke", {
		Color = Theme.Black,
		Thickness = if maximum >= 48 then 4 else 2.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	}, label)
	return label
end

function Theme.studs(parent: GuiObject)
	Ui.new("ImageLabel", {
		Name = "Studs",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = Textures.Toy.Stud,
		ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(44, 44),
		ImageTransparency = 0.28,
		ZIndex = parent.ZIndex,
		Active = false,
	}, parent)
end

function Theme.surface(parent: Instance, props: { [string]: any }, color: Color3, edge: Color3?): Frame
	props.BackgroundColor3 = color
	props.ZIndex = props.ZIndex or 6
	local frame: Frame = Ui.new("Frame", props, parent)
	Ui.corner(frame, 9)
	Theme.outline(frame, edge, 3)
	Ui.gradient(frame, color:Lerp(Color3.new(1, 1, 1), 0.12), color:Lerp(Color3.new(0, 0, 0), 0.12))
	Theme.studs(frame)
	return frame
end

-- Small utility symbols stay native so they remain sharp at every HUD scale.
local symbols =
	{ More = true, Upgrades = true, Players = true, Stats = true, Health = true, Walls = true, Floor = true }
local function symbol(parent: Instance, name: string, props: { [string]: any }?): ImageLabel
	local options: { [string]: any } = {
		Name = name .. "Art",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 8,
	}
	for key, value in (props or {}) :: { [string]: any } do
		options[key] = value
	end
	local root: ImageLabel = Ui.new("ImageLabel", options, parent)
	local square = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.8),
		BackgroundTransparency = 1,
		ZIndex = root.ZIndex,
	}, root)
	Ui.new("UIAspectRatioConstraint", { AspectRatio = 1 }, square)
	local color = if name == "Health"
		then Theme.Red
		elseif name == "Floor" then Theme.Gold
		elseif name == "Upgrades" then Theme.Green
		else Theme.Cyan
	local function shape(x: number, y: number, w: number, h: number, round: boolean?): Frame
		local part: Frame = Ui.new("Frame", {
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = root.ZIndex,
		}, square)
		Ui.corner(part, if round then 100 else 2)
		Theme.outline(part, Theme.Black, 2)
		return part
	end
	if name == "More" then
		for i = 0, 2 do
			shape(0.08, 0.12 + i * 0.3, 0.84, 0.18)
		end
	elseif name == "Upgrades" then
		shape(0.37, 0.37, 0.26, 0.52)
		local tip = shape(0.25, 0.16, 0.5, 0.5)
		tip.Rotation = 45
		shape(0.37, 0.32, 0.26, 0.24)
	elseif name == "Players" then
		shape(0.05, 0.46, 0.5, 0.4, true)
		shape(0.45, 0.46, 0.5, 0.4, true)
		shape(0.13, 0.12, 0.33, 0.33, true)
		shape(0.53, 0.12, 0.33, 0.33, true)
	elseif name == "Stats" then
		shape(0.06, 0.55, 0.22, 0.35)
		shape(0.39, 0.32, 0.22, 0.58)
		shape(0.72, 0.08, 0.22, 0.82)
	elseif name == "Walls" then
		for row = 0, 2 do
			for col = 0, 1 do
				shape(0.08 + col * 0.44, 0.12 + row * 0.27, 0.4, 0.23)
			end
		end
	else
		shape(0.35, 0.08, 0.3, 0.84)
		shape(0.08, 0.35, 0.84, 0.3)
	end
	return root
end

function Theme.image(parent: Instance, name: string, props: { [string]: any }?): ImageLabel
	if symbols[name] then
		return symbol(parent, name, props)
	end
	local icon = icons[name]
	local knife = table.find(Art.KnifeNames, name)
	local asset = if icon then Art.Icons else Art.Knives
	local index = icon or knife
	if not index or asset == "" then
		return Ui.art(parent, name, props)
	end
	local columns = if icon then 3 else 6
	local rows = if icon then 3 else 4
	local size = if icon then Art.IconSize else Art.KnifeSize
	local cell = Vector2.new(size.X / columns, size.Y / rows)
	local options: { [string]: any } = {
		Name = name .. "Art",
		Image = asset,
		ImageRectOffset = Vector2.new(((index - 1) % columns) * cell.X, math.floor((index - 1) / columns) * cell.Y),
		ImageRectSize = cell,
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 8,
	}
	for key, value in (props or {}) :: { [string]: any } do
		options[key] = value
	end
	return Ui.new("ImageLabel", options, parent)
end

function Theme.button(
	parent: Instance,
	text: string,
	color: Color3,
	props: { [string]: any },
	action: (() -> ())?,
	icon: string?
): TextButton
	local maximum = props.MaximumTextSize or 36
	props.MaximumTextSize = nil
	props.Text, props.BackgroundColor3, props.AutoButtonColor = "", color, false
	props.ZIndex = props.ZIndex or 8
	local button: TextButton = Ui.new("TextButton", props, parent)
	Ui.corner(button, 9)
	Theme.outline(button)
	Ui.gradient(button, color:Lerp(Color3.new(1, 1, 1), 0.18), color:Lerp(Color3.new(0, 0, 0), 0.14))
	Theme.studs(button)
	local shine = Ui.new("Frame", {
		Position = UDim2.fromOffset(5, 4),
		Size = UDim2.new(1, -10, 0.38, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.85,
		ZIndex = button.ZIndex,
	}, button)
	Ui.corner(shine, 5)
	local label = Theme.text(button, text, {
		Name = "Label",
		Position = UDim2.new(if icon then 0.24 else 0, 6, 0, 4),
		Size = UDim2.new(if icon then 0.76 else 1, -12, 1, -8),
		MaximumTextSize = maximum,
		ZIndex = button.ZIndex + 1,
	})
	if icon then
		Theme.image(
			button,
			icon,
			{ Position = UDim2.fromOffset(3, 2), Size = UDim2.new(0.25, 0, 1, -4), ZIndex = button.ZIndex + 1 }
		)
	end
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			shine.BackgroundTransparency = 0.72
		end
	end)
	button.MouseLeave:Connect(function()
		shine.BackgroundTransparency = 0.85
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") == true or button:GetAttribute("Busy") == true then
			return
		end
		if action then
			button:SetAttribute("Busy", true)
			local ok, message = pcall(function(): any
				action()
				return nil
			end)
			button:SetAttribute("Busy", false)
			if not ok then
				warn("[Menu] " .. tostring(message))
			end
		end
	end)
	label.Name = "Label"
	return button
end

function Theme.enabled(button: TextButton, enabled: boolean, label: string?)
	button:SetAttribute("Disabled", not enabled)
	button.Active = enabled
	button.Selectable = enabled
	local veil = button:FindFirstChild("DisabledVeil") :: Frame?
	if not veil then
		local created: Frame = Ui.new("Frame", {
			Name = "DisabledVeil",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Navy,
			BackgroundTransparency = 0.48,
			ZIndex = button.ZIndex + 3,
			Visible = false,
		}, button)
		Ui.corner(created, 9)
		veil = created
	end
	(veil :: Frame).Visible = not enabled
	if label then
		(button:FindFirstChild("Label") :: TextLabel).Text = label
	end
end

function Theme.badge(parent: GuiObject): TextLabel
	local badge = Theme.text(parent, "", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Red,
		MaximumTextSize = 19,
		Visible = false,
		ZIndex = parent.ZIndex + 5,
	})
	Ui.corner(badge, 100)
	Theme.outline(badge, Color3.new(1, 1, 1), 2)
	return badge
end

function Theme.burst(parent: GuiObject, color: Color3)
	local glow: Frame = Ui.new("Frame", {
		Name = "Burst",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = parent.ZIndex + 1,
	}, parent)
	for angle = 0, 330, 30 do
		local ray = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.09, 0.8),
			Rotation = angle,
			BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.65),
			BorderSizePixel = 0,
			ZIndex = glow.ZIndex,
		}, glow)
		Ui.new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.65, 0.65),
				NumberSequenceKeypoint.new(1, 0.2),
			}),
		}, ray)
	end
	return glow
end

function Theme.arrow(parent: Instance, props: { [string]: any })
	props.BackgroundTransparency, props.ZIndex = 1, 8
	local arrow = Ui.new("Frame", props, parent)
	local stem = Ui.new("Frame", {
		Position = UDim2.new(0, 4, 0.5, -12),
		Size = UDim2.new(0.6, 0, 0, 24),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 8,
	}, arrow)
	Ui.corner(stem, 2)
	Theme.outline(stem)
	local clip = Ui.new("Frame", {
		Position = UDim2.fromScale(0.45, 0),
		Size = UDim2.fromScale(0.55, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 9,
	}, arrow)
	local tip = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(40, 40),
		Rotation = 45,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 9,
	}, clip)
	Theme.outline(tip)
	Ui.new("Frame", {
		Position = UDim2.new(0.42, 0, 0.5, -9),
		Size = UDim2.new(0.15, 0, 0, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 10,
	}, arrow)
	return arrow
end

function Theme.shell(
	name: string,
	title: string,
	color: Color3,
	icon: string,
	height: number,
	width: number?
): (Frame, Frame, Frame)
	local designWidth = width or 1000
	local frame: Frame = Ui.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(designWidth, height),
		BackgroundColor3 = Theme.Navy,
		Visible = false,
		ZIndex = 5,
	}, Ui.gui)
	Ui.corner(frame, 10)
	Theme.outline(frame, color:Lerp(Theme.Navy, 0.45), 3)
	Theme.studs(frame)
	local scale = Ui.new("UIScale", { Scale = 1 }, frame)
	local header = Theme.surface(frame, { Name = "Header", Size = UDim2.new(1, 0, 0, 88), ZIndex = 6 }, color)
	Theme.image(header, icon, { Position = UDim2.fromOffset(8, 2), Size = UDim2.fromOffset(104, 84) })
	Theme.text(header, title, {
		Name = "Title",
		Position = UDim2.fromOffset(112, 2),
		Size = UDim2.new(1, -212, 0, 80),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaximumTextSize = 72,
	})
	Theme.button(
		header,
		"X",
		Theme.Red,
		{ Name = "Close", Position = UDim2.new(1, -78, 0, 10), Size = UDim2.fromOffset(66, 66), MaximumTextSize = 58 },
		function()
			frame.Visible = false
		end
	)
	local body: Frame = Ui.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(12, 100),
		Size = UDim2.new(1, -24, 1, -112),
		BackgroundTransparency = 1,
		ZIndex = 6,
	}, frame)
	local function fit()
		local _, bounds = Ui.bounds()
		scale.Scale =
			math.min(1.15, math.max(0.1, (bounds.X - 24) / designWidth), math.max(0.1, (bounds.Y - 24) / height))
	end
	local connection = Ui.Layout.Changed:Connect(fit)
	frame.Destroying:Connect(function()
		connection:Disconnect()
	end)
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible then
			fit()
			local target = scale.Scale
			scale.Scale = target * 0.96
			TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad), { Scale = target }):Play()
		end
	end)
	Ui.registerMenu(frame)
	fit()
	return frame, body, header
end

return Theme
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[--!strict
-- The left-side menu buttons (chunky, Steal An Egg style) and their panels:
--   Index    every knife in the game: silhouettes until you own one, and a reward to claim for each
--   Knives   your wall (equip the one you fight / murder with, sell the rest)
--   Rebirth  start over for a permanent multiplier
-- and the shopkeepers' panels, opened by standing on the ring at their stall (server ShopNPCs):
--   Mortimer the Knife Merchant  Health upgrades and sealed cases, with the odds of everything inside
--   Madame Vesper the Mystic     buy, upgrade and equip Innocent Powers
-- Knife cards show a live 3D model in a ViewportFrame built from the same KnifeModel as the game.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local IndexView = require(script.Parent.IndexView)
local RebirthView = require(script.Parent.RebirthView)
local CaseShowcase = require(script.Parent.CaseShowcase)
local CaseOdds = require(script.Parent.CaseOdds)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local Items = require(Shared:WaitForChild("Items"))
local Knives = require(Shared.Config:WaitForChild("Knives"))
local Textures = require(Shared.Config:WaitForChild("Textures"))
local KnifeModel = require(Shared:WaitForChild("KnifeModel"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local Menus = {}

local DARK = Ui.PANEL

-- A live 3D knife (or case) in a card; rotates slowly
local spinning: { [ViewportFrame]: Model } = {}
local function viewport(parent: Instance, build: () -> Model, dim: boolean?, size: UDim2?): ViewportFrame
	local frame = new("ViewportFrame", {
		Size = size or UDim2.fromScale(1, 0.55),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.new(1, 1, 1),
		ImageColor3 = if dim then Color3.new(0, 0, 0) else Color3.new(1, 1, 1),
		ZIndex = 6,
	}, parent)
	local model = build()
	if model:GetAttribute("Case") then
		model:PivotTo(CFrame.Angles(math.rad(-18), math.rad(205), 0)) -- three-quarter view of the lock
	else
		model:PivotTo(CFrame.Angles(0, 0, math.rad(-40))) -- flat of the blade to the camera, tilted
	end
	model.Parent = frame
	local camera = new("Camera", { FieldOfView = 30 }, frame)
	frame.CurrentCamera = camera
	local cf, size3 = model:GetBoundingBox()
	camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 0, size3.Magnitude * 1.7), cf.Position)
	spinning[frame] = model
	return frame
end
RunService.RenderStepped:Connect(function(dt: number)
	for frame, model in spinning do
		if not frame.Parent then
			spinning[frame] = nil
		else
			local visible = true
			local ancestor: Instance? = frame
			while ancestor do
				if ancestor:IsA("GuiObject") and not ancestor.Visible then
					visible = false
					break
				end
				ancestor = ancestor.Parent
			end
			if visible and require(script.Parent.Lod).Profile == "High" then
				model:PivotTo(model:GetPivot() * CFrame.Angles(0, dt * 0.8, 0))
			end
		end
	end
end)

local function panel(title: string, color: Color3, icon: string): (Frame, Frame)
	if title == "Mortimer's Knife Cases" then
		local frame, body = Theme.shell(title, "Shop", Theme.Green, "Cash", 540)
		return frame, body
	end
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Name = title,
		Size = UDim2.fromOffset(960, 650),
		BackgroundColor3 = DARK,
		Visible = false,
		ZIndex = 5,
	}, Ui.gui)
	Ui.corner(frame, 18)
	new("UIStroke", { Thickness = 2, Color = Color3.fromRGB(10, 18, 34) }, frame)
	-- Faint diagonal stripes in the background
	new("UIGradient", {
		Rotation = 45,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 215)),
	}, frame)
	local header = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 5,
	}, frame)
	Ui.corner(header, 18)
	Ui.gradient(header, color:Lerp(Color3.new(1, 1, 1), 0.2), color:Lerp(Color3.new(0, 0, 0), 0.2))
	local titleLabel = Ui.label({
		Size = UDim2.new(1, -130, 1, -12),
		Position = UDim2.fromOffset(20, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = `{icon} {title}`,
		ZIndex = 6,
	}, header)
	Ui.textStroke(titleLabel, 3)
	local close = Ui.chunky(
		{
			Name = "Close",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(50, 46),
			BackgroundColor3 = Color3.fromRGB(230, 50, 60),
			Text = "X",
			ZIndex = 6,
		},
		header,
		nil,
		function()
			frame.Visible = false
		end
	)
	close.Name = "Close"
	local body = new("Frame", {
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		ZIndex = 5,
	}, frame)
	Ui.padding(body, 14, 8)
	-- Pop in
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible then
			local scale = frame:FindFirstChildOfClass("UIScale") or new("UIScale", {}, frame)
			local target = 1 -- a bit bigger on desktop: easier to read
			scale.Scale = target * 0.85
			TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back), { Scale = target }):Play()
		end
	end)
	Ui.fitMenu(frame)
	Ui.registerMenu(frame)
	return frame, body
end

local function scrollGrid(parent: Instance, cell: Vector2): ScrollingFrame
	local scroll = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
	}, parent)
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	Ui.padding(scroll, 4, 4)
	local grid = scroll:FindFirstChildOfClass("UIGridLayout") :: UIGridLayout
	local function reflow()
		local width = math.max(140, scroll.AbsoluteSize.X - 16)
		local columns = math.max(1, math.floor((width + 10) / (cell.X + 10)))
		grid.CellSize = UDim2.fromOffset((width - (columns - 1) * 10) / columns, cell.Y)
	end
	scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(reflow)
	reflow()
	return scroll
end

local function card(parent: Instance, order: number, color: Color3?): Frame
	local tint = color or Color3.fromRGB(90, 90, 110)
	local frame = new("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 5,
	}, parent)
	Ui.corner(frame, 12)
	Ui.gradient(frame, tint:Lerp(DARK, 0.35), tint:Lerp(DARK, 0.75))
	new("UIStroke", { Color = tint, Thickness = 3 }, frame)
	return frame
end

local function cardText(parent: Instance, y: number, height: number, text: string, color: Color3?): TextLabel
	local label = Ui.label({
		Position = UDim2.fromOffset(6, y),
		Size = UDim2.new(1, -12, 0, height),
		Text = text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = color or Color3.new(1, 1, 1),
		ZIndex = 6,
	}, parent)
	Ui.textStroke(label, 1.5)
	return label
end

-- The knife's Murderer perk: its Blender badge in the card's top corner
local function perkBadge(parent: Instance, perkId: string)
	local icon = Textures.PerkIcons[perkId]
	local perk = GameConfig.Perks[perkId]
	if not icon or not perk then
		return
	end
	new("ImageLabel", {
		Name = "Perk",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Image = icon,
		ZIndex = 8,
	}, parent)
	local name = Ui.label({
		Position = UDim2.fromOffset(40, 10),
		Size = UDim2.new(1, -44, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 120, 120),
		Text = perk.DisplayName,
		ZIndex = 8,
	}, parent)
	Ui.textStroke(name, 1.5)
end

local function smallButton(
	parent: Instance,
	y: UDim,
	height: number,
	color: Color3,
	text: string,
	onClick: () -> ()
): TextButton
	return Ui.chunky({
		Position = UDim2.new(0, 6, y.Scale, y.Offset),
		Size = UDim2.new(1, -12, 0, height),
		BackgroundColor3 = color,
		Text = text,
		ZIndex = 7,
	}, parent, nil, onClick)
end

function Menus.Init()
	-- Left column of big buttons
	-- (phones: a strip of square icon buttons down the left edge, under the Store button)
	local column = new("Frame", {
		Name = "Navigation",
		AnchorPoint = if Ui.Phone then Vector2.zero else Vector2.new(0, 0.5),
		Position = if Ui.Phone then UDim2.fromOffset(10, 118) else UDim2.new(0, 14, 0.4, 0),
		Size = if Ui.Phone then UDim2.fromOffset(60, 300) else UDim2.fromOffset(190, 330),
		BackgroundTransparency = 1,
	}, Ui.gui)
	local navGrid = new("UIGridLayout", {
		CellSize = UDim2.fromOffset(112, 44),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, column)
	local function placeNavigation()
		local layout = Ui.Layout.get()
		column.AnchorPoint = Vector2.zero
		column.Position = UDim2.fromOffset(12, 64)
		column.Size = UDim2.fromOffset(layout.NavigationWidth, if layout.Short then 96 else 200)
		navGrid.FillDirectionMaxCells = if layout.Short then 2 else 1
	end
	Ui.Layout.Changed:Connect(placeNavigation)
	placeNavigation()

	local panels: { Frame } = {}
	local function toggle(frame: Frame)
		local open = not frame.Visible
		for _, p in panels do
			p.Visible = false
		end
		frame.Visible = open
		if open and GuiService.SelectedObject ~= nil then
			GuiService.SelectedObject = frame:FindFirstChild("Close", true)
		end
	end

	-- SHOP: sealed cases ---------------------------------------------------------------------------
	local shopFrame, shopBody = panel("Mortimer's Knife Cases", Color3.fromRGB(70, 200, 90), "🛒")
	table.insert(panels, shopFrame)
	local shopList = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
	}, shopBody)
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, shopList)
	local oddsFrame, oddsBody = panel("Cash case: full odds", Color3.fromRGB(61, 178, 255), "📊")
	table.insert(panels, oddsFrame)
	local oddsScroll = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ZIndex = 5,
	}, oddsBody)
	local fullOdds = Ui.label({
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 16,
		TextScaled = false,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 6,
	}, oddsScroll)
	Ui.button(
		{ Text = "Back to cash cases", Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 44), ZIndex = 6 },
		oddsBody,
		function()
			oddsFrame.Visible = false
			shopFrame.Visible = true
		end
	)

	-- Health upgrades, at the top of the merchant's list
	do
		local color = Color3.fromRGB(235, 70, 90)
		local row = new("Frame", {
			LayoutOrder = 0,
			Size = UDim2.new(1, -12, 0, 86),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 5,
		}, shopList)
		Ui.corner(row, 14)
		Ui.gradient(row, color:Lerp(DARK, 0.3), color:Lerp(DARK, 0.8))
		new("UIStroke", { Thickness = 3, Color = color }, row)
		local label = Ui.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -190, 1, -16),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			ZIndex = 6,
		}, row)
		Ui.textStroke(label, 2)
		local buy = Ui.chunky(
			{
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(150, 60),
				BackgroundColor3 = color,
				Text = "",
				ZIndex = 7,
			},
			row,
			"❤️",
			function()
				Remotes.Purchase:InvokeServer("Health")
			end
		)
		local function refreshHealth()
			local level = (player:GetAttribute("HealthLevel") or 0) :: number
			local titan = if player:GetAttribute("Pass_Titan") then 2 else 1
			local now = GameConfig.MaxHealthFor(level, titan)
			if level >= GameConfig.Health.MaxLevel then
				label.Text = `❤️ MAX HEALTH {now} (maxed!)`
				buy.Visible = false
			else
				label.Text =
					`❤️ MAX HEALTH {now} → {GameConfig.MaxHealthFor(level + 1, titan)}\nBosses and vault owners need more hits to take you down`
				local text = buy:FindFirstChild("Label") :: TextLabel?
				if text then
					text.Text = `${Ui.abbreviate(GameConfig.HealthCost(level))}`
				end
			end
		end
		player:GetAttributeChangedSignal("HealthLevel"):Connect(refreshHealth)
		player:GetAttributeChangedSignal("Pass_Titan"):Connect(refreshHealth)
		refreshHealth()
	end
	for order, entry in GameConfig.CaseShop do
		local row = CaseShowcase.Build(shopList, entry.Rarity, "$" .. Ui.abbreviate(entry.Cost), function()
			Remotes.Purchase:InvokeServer("Case:" .. entry.Rarity)
		end, function()
			fullOdds.Text = CaseOdds.Text(entry.Rarity)
				.. "\n\nCash purchase. Knife, mutation and size are separate rolls. Current rebirth and server luck apply to mutation and size."
			oddsFrame.Visible = true
		end)
		row.LayoutOrder = order + 1
	end

	-- INDEX: the illustrated collection grid and selected knife inspector.
	local indexFrame, refreshIndexView = IndexView.Build()
	table.insert(panels, indexFrame)

	-- KNIVES: your wall ----------------------------------------------------------------------------
	local knivesFrame, knivesBody =
		panel("My Knives · equipped = your Murderer perk", Color3.fromRGB(130, 80, 230), "🔪")
	table.insert(panels, knivesFrame)
	local rackGrid = scrollGrid(knivesBody, Vector2.new(150, 254))

	-- POWERS ---------------------------------------------------------------------------------------
	local powersFrame, powersBody = panel("Innocent Powers", Color3.fromRGB(240, 130, 40), "⚡")
	table.insert(panels, powersFrame)
	local topRow = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, ZIndex = 5 }, powersBody)
	local loadoutLabel = Ui.label({
		Size = UDim2.fromScale(0.6, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		ZIndex = 6,
	}, topRow)
	Ui.textStroke(loadoutLabel, 2)
	local slotButton = Ui.chunky(
		{
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromScale(0.38, 1),
			BackgroundColor3 = Color3.fromRGB(90, 180, 90),
			Text = "",
			ZIndex = 6,
		},
		topRow,
		nil,
		function()
			Remotes.Power:InvokeServer("Slot")
		end
	)
	local powersHolder = new("Frame", {
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		ZIndex = 5,
	}, powersBody)
	local powersGrid = scrollGrid(powersHolder, Vector2.new(205, 230))

	-- REBIRTH --------------------------------------------------------------------------------------
	local rebirthFrame, refreshRebirth = RebirthView.Build()
	table.insert(panels, rebirthFrame)

	-- Refreshers ------------------------------------------------------------------------------------
	local function clearGrid(grid: Instance)
		for _, child in grid:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
	end

	local function refreshRack()
		clearGrid(rackGrid)
		local owned = Ui.list(player:GetAttribute("Knives"))
		local equipped = player:GetAttribute("Equipped") or ""
		if #owned == 0 then
			local empty = card(rackGrid, 1)
			cardText(empty, 20, 120, "Steal knives off the bosses' walls on the runway and carry them home!")
			return
		end
		for index, item in owned do
			local parsed = Items.Parse(item)
			if not parsed then
				continue
			end
			local knife = parsed.Knife
			local c = card(rackGrid, index, Items.Color(item))
			Ui.art(c, knife.Name, { Size = UDim2.new(1, 0, 0, 84), ZIndex = 6 })
			local previewButton = new(
				"TextButton",
				{ Name = "Preview", Text = "", Size = UDim2.new(1, 0, 0, 84), BackgroundTransparency = 1, ZIndex = 7 },
				c
			)
			previewButton.Activated:Connect(function()
				local selected, body = panel("Knife Preview", Items.Color(item), "🔪")
				selected:SetAttribute("MaximumWidth", 460)
				selected:SetAttribute("MaximumHeight", 380)
				viewport(body, function()
					return KnifeModel.Build(item, true)
				end, false, UDim2.new(1, 0, 1, -44))
				cardText(body, 0, 24, Items.DisplayName(item), Items.Color(item)).Position = UDim2.new(0, 6, 1, -36)
				selected.Visible = true
				selected:GetPropertyChangedSignal("Visible"):Connect(function()
					if not selected.Visible then
						selected:Destroy()
					end
				end)
			end)
			cardText(c, 88, 20, Items.DisplayName(item), Items.Color(item))
			cardText(c, 108, 16, `{knife.Rarity} · Dmg {Items.Damage(item)}`, Knives.RarityColors[knife.Rarity])
			cardText(c, 124, 18, `+${Ui.abbreviate(Items.Income(item))}/s`, Color3.fromRGB(120, 255, 140))
			if parsed.Perk then
				perkBadge(c, parsed.Perk)
			end
			local isEquipped = item == equipped
			smallButton(
				c,
				UDim.new(1, -98),
				44,
				if isEquipped then Color3.fromRGB(70, 200, 100) else Color3.fromRGB(80, 150, 240),
				if isEquipped then "Equipped" else "Equip",
				function()
					Remotes.Equip:InvokeServer(if isEquipped then "" else item)
				end
			)
			smallButton(
				c,
				UDim.new(1, -48),
				44,
				Color3.fromRGB(230, 150, 50),
				`Sell ${Ui.abbreviate(Items.Income(item) * GameConfig.SellSeconds)}`,
				function()
					Remotes.Sell:InvokeServer(index)
				end
			)
		end
	end

	local indexBadge: TextLabel? = nil
	local function refreshIndex()
		local claimable = refreshIndexView()
		if indexBadge then
			indexBadge.Visible = claimable > 0
			indexBadge.Text = tostring(claimable)
		end
	end

	local function parsePowers(): { [string]: number }
		local out = {}
		for _, entry in Ui.list(player:GetAttribute("Powers")) do
			local id, level = entry:match("^(%w+):(%d+)$")
			if id and level then
				out[id] = tonumber(level) :: number
			end
		end
		return out
	end

	local function refreshPowers()
		clearGrid(powersGrid)
		local owned = parsePowers()
		local loadout = Ui.list(player:GetAttribute("Loadout"))
		local slots = player:GetAttribute("PowerSlots") or GameConfig.PowerSlots
		loadoutLabel.Text = `Loadout {#loadout}/{slots}{if Ui.Phone then "" else " · keys Z X C"}`
		local label = slotButton:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = if slots >= GameConfig.MaxPowerSlots
				then "All slots"
				else `+1 Slot ${Ui.abbreviate(GameConfig.PowerSlotCost)}`
		end
		for index, power in GameConfig.Powers do
			local level = owned[power.Id] or 0
			local equipped = table.find(loadout, power.Id) ~= nil
			local c = card(powersGrid, index, power.Color)
			if equipped then
				(c:FindFirstChildOfClass("UIStroke") :: UIStroke).Color = Color3.new(1, 1, 1)
			end
			cardText(c, 4, 26, power.DisplayName, power.Color)
			local energy = (power :: any).Energy
			cardText(
				c,
				30,
				15,
				if level > 0
					then `Level {level}/{GameConfig.PowerMaxLevel} · ⚡{energy[level]} in rounds`
					else `Locked · ⚡{energy[1]} in rounds`,
				Color3.fromRGB(220, 220, 230)
			)
			local description = Ui.label({
				Position = UDim2.fromOffset(8, 48),
				Size = UDim2.new(1, -16, 0, 56),
				Text = power.Description,
				TextScaled = false,
				TextSize = 14,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 6,
			}, c)
			Ui.textStroke(description, 1)
			local maxed = level >= GameConfig.PowerMaxLevel
			smallButton(
				c,
				UDim.new(1, -98),
				44,
				if maxed then Color3.fromRGB(90, 90, 100) else Color3.fromRGB(240, 150, 50),
				if maxed
					then "MAX"
					elseif level == 0 then `Unlock ${Ui.abbreviate(GameConfig.PowerCost(power.Cost, 0))}`
					else `Upgrade ${Ui.abbreviate(GameConfig.PowerCost(power.Cost, level))}`,
				function()
					if not maxed then
						Remotes.Power:InvokeServer("Buy", power.Id)
					end
				end
			)
			if level > 0 then
				smallButton(
					c,
					UDim.new(1, -48),
					44,
					if equipped then Color3.fromRGB(70, 200, 100) else Color3.fromRGB(80, 150, 240),
					if equipped then "Equipped" else "Equip",
					function()
						Remotes.Power:InvokeServer(if equipped then "Unequip" else "Equip", power.Id)
					end
				)
			end
		end
	end

	-- RebirthView owns its live requirement and bonus displays.

	for attribute, refresh in
		{
			Knives = refreshRack,
			Equipped = refreshRack,
			Discovered = refreshIndex,
			IndexClaimed = refreshIndex,
			Powers = refreshPowers,
			Loadout = refreshPowers,
			PowerSlots = refreshPowers,
			Rebirths = refreshRebirth,
		} :: { [string]: () -> () }
	do
		player:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		if rebirthFrame.Visible then
			refreshRebirth()
		end
	end)

	-- The buttons themselves ------------------------------------------------------------------------
	local function menuButton(order: number, text: string, color: Color3, icon: string, frame: Frame, refresh: () -> ())
		local button = Theme.button(column, text, color, {
			LayoutOrder = order,
			Size = UDim2.fromOffset(112, 44),
			MaximumTextSize = 23,
		}, function()
			refresh()
			toggle(frame)
		end, icon)
		return button
	end
	Ui.Navigation = column
	local indexButton = menuButton(2, "Index", Theme.Cyan, "Index", indexFrame, refreshIndex)
	indexBadge = Theme.badge(indexButton)
	local moreFrame, moreBody = Theme.shell("More", "More", Theme.Cyan, "More", 460, 580)
	table.insert(panels, moreFrame)
	local moreList = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ZIndex = 5,
	}, moreBody)
	Ui.new(
		"UIPadding",
		{ PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) },
		moreList
	)
	Ui.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, moreList)
	local moreOrder = { Knives = 1, Players = 2, Powers = 3, Rebirth = 4, Stats = 5 }
	local moreColors = {
		Knives = Theme.Gold,
		Players = Theme.Cyan,
		Powers = Color3.fromRGB(255, 148, 28),
		Rebirth = Theme.Purple,
		Stats = Theme.Green,
	}
	local function moreButton(name: string, icon: string, frame: Frame, refresh: () -> ())
		Theme.button(moreList, name, moreColors[name], {
			Name = name,
			LayoutOrder = moreOrder[name],
			Size = UDim2.new(1, -6, 0, 60),
			ZIndex = 8,
		}, function()
			refresh()
			toggle(frame)
		end, icon)
	end
	moreButton("Knives", "Katana", knivesFrame, refreshRack)
	moreButton("Powers", "Speed", powersFrame, refreshPowers)
	moreButton("Rebirth", "Rebirth", rebirthFrame, refreshRebirth)

	-- PLAYERS: everyone here, with a Team Up and a Trade button each (+ invite friends) -------------
	local playersFrame, playersBody = panel("Players", Color3.fromRGB(90, 200, 255), "👥")
	table.insert(panels, playersFrame)
	local playersHint = Ui.label({
		Size = UDim2.new(1, 0, 0, 44),
		Text = "🤝 Team up: you're picked together in Double Trouble rounds (both Murderers or both Sheriffs) and share steals. 👥 Friends here = +10% cash each!",
		TextColor3 = Color3.fromRGB(220, 230, 255),
		TextWrapped = true,
		ZIndex = 6,
	}, playersBody)
	playersHint.TextScaled = true
	local playersList = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
	}, playersBody)
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, playersList)
	local function refreshPlayers()
		for _, child in playersList:GetChildren() do
			if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		Ui.button(
			{
				LayoutOrder = 0,
				Size = UDim2.new(1, -10, 0, 44),
				Text = "📨 Invite friends (+10% cash each!)",
				BackgroundColor3 = Color3.fromRGB(90, 200, 110),
				ZIndex = 6,
			},
			playersList,
			function()
				pcall(function()
					game:GetService("SocialService"):PromptGameInvite(player)
				end)
			end
		)
		local others = #Players:GetPlayers() - 1
		playersFrame:SetAttribute("PreferredHeight", math.min(650, 200 + math.max(1, others) * 100))
		if others == 0 then
			Ui.label({
				Text = "No other players here yet",
				Size = UDim2.new(1, -10, 0, 44),
				TextSize = 16,
				TextScaled = false,
				ZIndex = 6,
			}, playersList)
		end
		local partnerId = player:GetAttribute("Partner")
		for i, other in Players:GetPlayers() do
			if other == player then
				continue
			end
			local row = new("Frame", {
				LayoutOrder = i,
				Size = UDim2.new(1, -10, 0, 96),
				BackgroundColor3 = Color3.fromRGB(44, 38, 58),
				ZIndex = 6,
			}, playersList)
			Ui.corner(row, 10)
			local teammate = partnerId == other.UserId
			Ui.label({
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -20, 0, 32),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = (if teammate then "🤝 " else "") .. other.DisplayName,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = if teammate then Color3.fromRGB(120, 255, 140) else Color3.new(1, 1, 1),
				ZIndex = 7,
			}, row)
			Ui.button(
				{
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(0.5, -6, 1, -8),
					Size = UDim2.new(0.5, -16, 0, 44),
					Text = if teammate then "Leave team" else "🤝 Team up",
					BackgroundColor3 = if teammate then Color3.fromRGB(200, 80, 80) else Color3.fromRGB(80, 170, 255),
					ZIndex = 7,
				},
				row,
				function()
					if teammate then
						Remotes.TeamUp:FireServer("Leave")
					else
						Remotes.TeamUp:FireServer("Invite", other.UserId)
					end
				end
			)
			Ui.button(
				{
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -6, 1, -8),
					Size = UDim2.new(0.5, -16, 0, 44),
					Text = "🔁 Trade",
					BackgroundColor3 = Color3.fromRGB(240, 170, 60),
					ZIndex = 7,
				},
				row,
				function()
					Remotes.Trade:InvokeServer("Request", other.UserId)
				end
			)
		end
	end
	moreButton("Players", "Players", playersFrame, refreshPlayers)
	local statsFrame, statsBody = panel("Stats", Color3.fromRGB(87, 202, 150), "📊")
	table.insert(panels, statsFrame)
	local detailsScroll = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -56),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		ZIndex = 5,
	}, statsBody)
	local statsText = Ui.label({
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 6,
	}, detailsScroll)
	local blurButton = Ui.button(
		{
			Name = "MenuBlur",
			Text = "Menu blur: OFF",
			Position = UDim2.new(0, 0, 1, -48),
			Size = UDim2.new(1, -8, 0, 44),
			ZIndex = 6,
		},
		statsBody,
		function()
			if Ui.Menu.CanBlur() then
				Ui.gui:SetAttribute("MenuBlurEnabled", not Ui.gui:GetAttribute("MenuBlurEnabled"))
			end
		end
	)
	local function refreshDetails()
		statsText.Text = `Income: ${Ui.abbreviate(player:GetAttribute("Income") or 0)}/s\nHeat: {player:GetAttribute(
			"Heat"
		) or 0}/10\nWalk speed: {math.floor(GameConfig.WalkSpeedFor((player:GetAttribute("Speed") or 0) :: number))}\nWall level: {player:GetAttribute(
			"WallLevel"
		) or 0}\nLuck: {player:GetAttribute("Luck") or 0}\nRebirths: {player:GetAttribute("Rebirths") or 0}\nFriend boost: +{(player:GetAttribute(
			"FriendsHere"
		) or 0) * 10}%\n\nServer goal: {ReplicatedStorage:GetAttribute("GoalText") or "None"} ({ReplicatedStorage:GetAttribute(
			"GoalProgress"
		) or 0}/{ReplicatedStorage:GetAttribute("GoalNeed") or 1})`
		local now = workspace:GetServerTimeNow()
		local boost = player:GetAttribute("BoostUntil")
		local luck = ReplicatedStorage:GetAttribute("ServerLuckUntil")
		statsText.Text ..= `\nShield: {if player:GetAttribute("Shielded")
			then Ui.clock(player:GetAttribute("ShieldLeft") or 0)
			else "None"}\nCash boost: {if type(boost) == "number" and boost > now then Ui.clock(boost - now) else "None"}\nServer luck: {if type(
				luck
			)
					== "number"
				and luck > now
			then Ui.clock(luck - now)
			else "None"}`
		blurButton.Text = if Ui.Menu.CanBlur()
			then (if Ui.gui:GetAttribute("MenuBlurEnabled") then "Menu blur: ON" else "Menu blur: OFF")
			else "Menu blur: requires High graphics"
	end
	moreButton("Stats", "Stats", statsFrame, refreshDetails)
	Ui.gui:GetAttributeChangedSignal("MenuBlurEnabled"):Connect(refreshDetails)
	player.AttributeChanged:Connect(function()
		if statsFrame.Visible then
			refreshDetails()
		end
	end)
	ReplicatedStorage.AttributeChanged:Connect(function()
		if statsFrame.Visible then
			refreshDetails()
		end
	end)
	menuButton(3, "More", Theme.Cyan, "More", moreFrame, function() end)
	player:GetAttributeChangedSignal("Partner"):Connect(function()
		if playersFrame.Visible then
			refreshPlayers()
		end
	end)

	-- Yes / No popups for team-up and trade requests -------------------------------------------------
	local function ask(text: string, onYes: () -> (), onNo: () -> ())
		local box = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 140),
			Size = UDim2.fromOffset(420, 110),
			BackgroundColor3 = DARK,
			ZIndex = 40,
		}, Ui.gui)
		Ui.corner(box, 14)
		Ui.fitMenu(box, Vector2.new(420, 120))
		Ui.registerMenu(box)
		Ui.stroke(box)
		Ui.label({
			Position = UDim2.fromOffset(10, 8),
			Size = UDim2.new(1, -20, 0, 44),
			Text = text,
			TextWrapped = true,
			ZIndex = 41,
		}, box)
		local function finish(yes: boolean)
			box:Destroy()
			if yes then
				onYes()
			else
				onNo()
			end
		end
		Ui.button(
			{
				Position = UDim2.new(0, 10, 1, -50),
				Size = UDim2.new(0.5, -15, 0, 44),
				Text = "✅ Yes",
				BackgroundColor3 = Color3.fromRGB(80, 200, 100),
				ZIndex = 41,
			},
			box,
			function()
				finish(true)
			end
		)
		Ui.button(
			{
				Position = UDim2.new(0.5, 5, 1, -50),
				Size = UDim2.new(0.5, -15, 0, 44),
				Text = "No",
				BackgroundColor3 = Color3.fromRGB(200, 80, 80),
				ZIndex = 41,
			},
			box,
			function()
				finish(false)
			end
		)
		task.delay(20, function()
			if box.Parent then
				finish(false)
			end
		end)
	end

	-- TRADE window ------------------------------------------------------------------------------------
	local tradeFrame, tradeBody = panel("Trade", Color3.fromRGB(240, 170, 60), "🔁")
	local tradeOffer: { string } = {}
	local tradeState: { [string]: any } = {}
	local tradeActive = false
	tradeFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if not tradeFrame.Visible and tradeActive then
			tradeActive = false
			tradeOffer = {}
			task.spawn(function()
				Remotes.Trade:InvokeServer("Cancel")
			end)
		end
	end)
	local function tradeColumn(x: number, title: string): ScrollingFrame
		Ui.label({
			Position = UDim2.new(x, 4, 0, 0),
			Size = UDim2.new(0.5, -8, 0, 28),
			Text = title,
			ZIndex = 6,
		}, tradeBody)
		local list = new("ScrollingFrame", {
			Position = UDim2.new(x, 4, 0, 32),
			Size = UDim2.new(0.5, -8, 1, -100),
			BackgroundColor3 = Color3.fromRGB(40, 34, 52),
			ScrollBarThickness = 6,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ZIndex = 6,
		}, tradeBody)
		Ui.corner(list, 10)
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
		return list
	end
	local myList = tradeColumn(0, "Your knives (tap to offer, max 6)")
	local theirList = tradeColumn(0.5, "They offer")
	local tradeStatus = Ui.label({
		Position = UDim2.new(0, 4, 1, -64),
		Size = UDim2.new(0.5, -8, 0, 28),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 230, 140),
		ZIndex = 6,
	}, tradeBody)
	local readyButton = Ui.button(
		{
			Position = UDim2.new(0.5, 4, 1, -64),
			Size = UDim2.new(0.25, -6, 0, 56),
			Text = "Ready",
			BackgroundColor3 = Color3.fromRGB(80, 200, 100),
			ZIndex = 6,
		},
		tradeBody,
		function()
			Remotes.Trade:InvokeServer("Ready")
		end
	)
	Ui.button(
		{
			Position = UDim2.new(0.75, 2, 1, -64),
			Size = UDim2.new(0.25, -6, 0, 56),
			Text = "Cancel",
			BackgroundColor3 = Color3.fromRGB(200, 80, 80),
			ZIndex = 6,
		},
		tradeBody,
		function()
			tradeFrame.Visible = false
		end
	)
	local function itemRow(list: ScrollingFrame, item: string, order: number, picked: boolean, onTap: (() -> ())?)
		local row = Ui.button({
			LayoutOrder = order,
			Size = UDim2.new(1, -8, 0, 44),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = Items.DisplayName(item),
			TextColor3 = Items.Color(item),
			BackgroundColor3 = if picked then Color3.fromRGB(80, 160, 90) else Color3.fromRGB(60, 54, 74),
			ZIndex = 7,
		}, list, onTap)
		local parsed = Items.Parse(item)
		if parsed and parsed.Perk and GameConfig.Perks[parsed.Perk] then
			row.Text ..= ` · {GameConfig.Perks[parsed.Perk].DisplayName}`
		end
	end
	local function drawTrade()
		for _, list in { myList, theirList } do
			for _, child in list:GetChildren() do
				if child:IsA("GuiButton") then
					child:Destroy()
				end
			end
		end
		local counted: { [string]: number } = {}
		for _, item in tradeOffer do
			counted[item] = (counted[item] or 0) + 1
		end
		for i, item in Ui.list(player:GetAttribute("Knives")) do
			local picked = (counted[item] or 0) > 0
			if picked then
				counted[item] -= 1
			end
			itemRow(myList, item, i, picked, function()
				local index = table.find(tradeOffer, item)
				if picked and index then
					table.remove(tradeOffer, index)
				elseif #tradeOffer < 6 then
					table.insert(tradeOffer, item)
				end
				Remotes.Trade:InvokeServer("Offer", tradeOffer)
			end)
		end
		for i, item in tradeState.Theirs or {} do
			itemRow(theirList, item, i, true, nil)
		end
		local countdown = tradeState.CountdownEnds
		tradeStatus.Text = if type(countdown) == "number"
			then `Swapping in {math.max(0, math.ceil(countdown - workspace:GetServerTimeNow()))}...`
			elseif tradeState.TheirReady then `{tradeState.OtherName or "They"} is ready!`
			else `Trading with {tradeState.OtherName or "?"}`
		readyButton.Text = if tradeState.MyReady then "Not ready" else "Ready"
	end
	Remotes.Effect.OnClientEvent:Connect(function(kind: string, a: any, b: any)
		if kind == "TeamInvite" and type(a) == "number" then
			ask(`🤝 {b} wants to team up with you!`, function()
				Remotes.TeamUp:FireServer("Accept", a)
			end, function()
				Remotes.TeamUp:FireServer("Decline", a)
			end)
		elseif kind == "TradeRequest" and type(a) == "number" then
			ask(`🔁 {b} wants to trade knives with you!`, function()
				Remotes.Trade:InvokeServer("Accept", a)
			end, function()
				Remotes.Trade:InvokeServer("Decline", a)
			end)
		elseif kind == "TradeState" and type(a) == "table" then
			tradeActive = true
			tradeState = a
			tradeOffer = table.clone(a.Mine or {})
			if not tradeFrame.Visible then
				for _, p in panels do
					p.Visible = false
				end
				tradeFrame.Visible = true
			end
			drawTrade()
		elseif kind == "TradeClosed" then
			tradeActive = false
			tradeFrame.Visible = false
			tradeState = {}
			tradeOffer = {}
		end
	end)
	-- Keep the countdown ticking
	task.spawn(function()
		while true do
			task.wait(0.25)
			if tradeFrame.Visible and type(tradeState.CountdownEnds) == "number" then
				drawTrade()
			end
		end
	end)
	-- Slow mode (T): walk at normal speed instead of your trained speed
	local slowButton: TextButton
	local function setSlow(on: boolean)
		Remotes.SlowMode:FireServer(on)
	end
	slowButton = Theme.button(column, "Slow: OFF", Color3.fromRGB(150, 150, 160), {
		LayoutOrder = 5,
		Name = "Slow",
		Size = UDim2.fromOffset(112, 44),
		MaximumTextSize = 18,
	}, function()
		setSlow(not player:GetAttribute("SlowMode"))
	end)
	local function refreshSlow()
		local on = player:GetAttribute("SlowMode") == true
		(slowButton:FindFirstChild("Label") :: TextLabel).Text = (if Ui.Phone then "Slow: " else "[T] Slow: ")
			.. (if on then "ON" else "OFF")
		slowButton.BackgroundColor3 = if on then Color3.fromRGB(90, 200, 110) else Color3.fromRGB(150, 150, 160)
	end
	player:GetAttributeChangedSignal("SlowMode"):Connect(refreshSlow)
	refreshSlow()
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.T then
			setSlow(not player:GetAttribute("SlowMode"))
		end
	end)
	if RunService:IsStudio() and not Ui.Phone then
		-- Studio: test buttons
		local tests = new("Frame", {
			LayoutOrder = 6,
			Size = UDim2.new(1, 0, 0, 66),
			BackgroundTransparency = 1,
		}, column)
		new("UIGridLayout", { CellSize = UDim2.new(0.5, -3, 0, 30), CellPadding = UDim2.fromOffset(6, 6) }, tests)
		type Test = { Text: string, Command: string, Arg: string?, Color: Color3 }
		local specs: { Test } = {
			{ Text = "Bot: Murd", Command = "BotRound", Arg = "Murderer", Color = Color3.fromRGB(200, 40, 50) },
			{ Text = "Bot: Inno", Command = "BotRound", Arg = "Innocent", Color = Color3.fromRGB(70, 150, 240) },
			{ Text = "Raid", Command = "Raid", Arg = nil, Color = Color3.fromRGB(230, 90, 40) },
			{ Text = "Case", Command = "Case", Arg = "Epic", Color = Color3.fromRGB(170, 90, 255) },
		}
		for _, spec in specs do
			Ui.button({ Text = spec.Text, BackgroundColor3 = spec.Color }, tests, function()
				Remotes.Debug:InvokeServer(spec.Command, spec.Arg)
			end)
		end
	end

	refreshRack()
	refreshIndex()
	refreshPowers()
	refreshRebirth()

	player:GetAttributeChangedSignal("InRound"):Connect(function()
		local inRound = player:GetAttribute("InRound") == true
		column.Visible = not inRound
		if inRound then
			for _, p in panels do
				p.Visible = false
			end
		end
	end)

	-- Keyboard / gamepad shortcuts: K = knives, B = powers (gamepad: L1 / R1)
	ContextActionService:BindAction("ToggleKnives", function(_, state)
		if state == Enum.UserInputState.Begin and column.Visible then
			refreshRack()
			toggle(knivesFrame)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.K, Enum.KeyCode.ButtonL1)

	-- Shopkeepers (server ShopNPCs): stand on the glowing ring in front of a stall and its shop
	-- opens; step off and it closes. Close it yourself and it stays shut until you step off.
	local onRing: BasePart? = nil
	local openedFrame: Frame? = nil
	local nextCheck = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextCheck then
			return
		end
		nextCheck = now + 0.15
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local standing: BasePart? = nil
		if root and not player:GetAttribute("InRound") then
			for _, instance in CollectionService:GetTagged("ShopRing") do
				local ring = instance :: BasePart
				local offset = root.Position - ring.Position
				local radius = ring.Size.Y / 2 + 1.5
				if Vector3.new(offset.X, 0, offset.Z).Magnitude < radius and math.abs(offset.Y) < 6 then
					standing = ring
					break
				end
			end
		end
		if standing == onRing then
			return
		end
		-- Stepped off (or onto a different ring): close what this ring opened
		if openedFrame and openedFrame.Visible then
			openedFrame.Visible = false
		end
		openedFrame = nil
		onRing = standing
		if standing then
			local which = standing:GetAttribute("ShopPanel")
			local frame = if which == "Shop" then shopFrame elseif which == "Powers" then powersFrame else nil
			if frame then
				if which == "Powers" then
					refreshPowers()
				end
				if not frame.Visible then
					toggle(frame)
				end
				openedFrame = frame
			end
		end
	end)
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Moves</string>
            <string name="Source"><![CDATA[--!strict
-- Client animation engine. Every frame, after Roblox's Animator has posed each character (walk,
-- run, idle), this layers our procedural clips on top by multiplying each joint's Transform.
-- Works on players and guards alike, on Motor6D and AnimationConstraint rigs.
--
-- What plays comes from:
--   * Remotes.Anim (server -> everyone): one-shot clips like stabs, hurts, cheers
--   * Moves.Play (local prediction): your own swings start the instant you click
--   * state that lasts: a character's ChargeStart attribute (winding up a throw), its player's
--     Carrying attribute (knife over the head), holding the Revolver, and guards' idle fidgets
-- Knife trails on the held knife switch on during the part of a clip that swings it.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnimLibrary = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AnimLibrary"))
local Lod = require(script.Parent.Lod)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local localPlayer = Players.LocalPlayer

local Moves = {}

type Playing = { Clip: AnimLibrary.Clip, Name: string, Start: number }
type Rig = {
	Joints: { [string]: Instance }, -- Motor6D or AnimationConstraint, by name
	Playing: { Playing },
	-- What we wrote last frame, so joints the Animator didn't touch don't accumulate our offsets
	LastBase: { [Instance]: CFrame },
	LastWritten: { [Instance]: CFrame },
	Seed: number,
	TrailOn: boolean,
	LoopWeight: number, -- current blend of held poses (carry / aim)
}

-- Holding a Tool, the default Animate script raises the right arm ~84 degrees forward. Our poses are
-- designed from a hanging arm, so while one plays we blend that raise back out.
local TOOL_HOLD_UNDO = CFrame.Angles(math.rad(84), math.rad(12), math.rad(6)):Inverse()
local LOOP_BLEND = 0.12 -- seconds for held poses (carry, aim) to blend in and out

local rigs: { [Model]: Rig } = {}
local tracked: { [Model]: boolean } = {} -- models we animate (rigs build once their joints exist)

local function getRig(model: Model): Rig?
	local rig = rigs[model]
	if rig and rig.Joints.RightShoulder:IsDescendantOf(model) then
		return rig
	end
	rigs[model] = nil -- never built, or its joints were replaced
	if not model:FindFirstChildOfClass("Humanoid") then
		return nil
	end
	local joints: { [string]: Instance } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") or d:IsA("AnimationConstraint") then
			joints[d.Name] = d
		end
	end
	if not joints.RightShoulder then
		return nil -- still streaming in; try again next frame
	end
	local built: Rig = {
		Joints = joints,
		Playing = {},
		LastBase = {},
		LastWritten = {},
		Seed = math.random() * 100,
		TrailOn = false,
		LoopWeight = 0,
	}
	rigs[model] = built
	local connections: { RBXScriptConnection } = {}
	-- Round disguises (ApplyDescription) swap body parts, which replaces the joints: rebuild the
	-- rig next frame, keeping whatever clip is playing
	table.insert(
		connections,
		model.DescendantAdded:Connect(function(d)
			if (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) and rigs[model] == built then
				rigs[model] = nil
				for _, c in connections do
					c:Disconnect()
				end
				local rebuilt = getRig(model)
				if rebuilt then
					rebuilt.Playing = built.Playing
					rebuilt.Seed = built.Seed
				end
			end
		end)
	)
	table.insert(
		connections,
		model.Destroying:Connect(function()
			rigs[model] = nil
			tracked[model] = nil
		end)
	)
	return built
end

-- The knife trail on whatever knife this model is holding (hub tool, murderer tool, guard knife)
local function setTrail(model: Model, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("Trail") and d.Name == "KnifeTrail" then
			d.Enabled = on
		end
	end
end

function Moves.Play(model: Model, name: string)
	local clip = AnimLibrary.Clips[name]
	tracked[model] = true
	local rig = getRig(model)
	if not clip or not rig then
		return
	end
	-- One-shots replace each other (a new swing cuts the last one short)
	table.clear(rig.Playing)
	table.insert(rig.Playing, { Clip = clip, Name = name, Start = os.clock() })
end

-- Your own character's charge starts locally, before the server has heard about it
local localChargeStart: number? = nil
function Moves.SetLocalCharge(start: number?)
	localChargeStart = start
end

local function addPose(total: { [string]: Vector3 }, pose: AnimLibrary.Pose, weight: number)
	for joint, value in pose do
		total[joint] = (total[joint] or Vector3.zero) + value * weight
	end
end

local function heldTool(model: Model): Tool?
	return model:FindFirstChildOfClass("Tool")
end

-- 0 -> 1 -> 0 over a clip, so poses ease in from and back out to whatever the Animator is doing
local function envelope(t: number, length: number): number
	return math.clamp(math.min(t / 0.07, (length - t) / 0.12), 0, 1)
end

local function step(dt: number)
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for model in tracked do
		if not model.Parent then
			rigs[model] = nil
			tracked[model] = nil
			continue
		end
		local rig = getRig(model)
		if not rig then
			continue
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			continue -- ragdolls are physics now
		end
		-- Too far away to see the detail (LOD): leave it to the Animator. Our own character always
		-- animates. Whatever we'd written gets overwritten by the Animator next frame.
		if model ~= localPlayer.Character and #rig.Playing == 0 then
			local root = model.PrimaryPart
			if root and not Lod.Near(root.Position) then
				table.clear(rig.LastWritten)
				table.clear(rig.LastBase)
				continue
			end
		end
		local total: { [string]: Vector3 } = {}
		local trail = false
		local undo = 0 -- how much of the tool-hold arm raise to take out this frame

		-- One-shot clips
		for i = #rig.Playing, 1, -1 do
			local playing = rig.Playing[i]
			local t = now - playing.Start
			if t >= playing.Clip.Length then
				table.remove(rig.Playing, i)
				continue
			end
			addPose(total, AnimLibrary.Sample(playing.Clip, t), 1)
			undo = math.max(undo, envelope(t, playing.Clip.Length))
			local window = playing.Clip.Trail
			if window and t >= window[1] and t <= window[2] then
				trail = true
			end
		end
		local busy = #rig.Playing > 0

		-- Winding up a throw (players and guards): crank back over ChargeTime, then tremble
		local chargeStart: number? = nil
		if model == localPlayer.Character then
			chargeStart = localChargeStart
		else
			local attr = model:GetAttribute("ChargeStart")
			if type(attr) == "number" then
				-- Server time -> seconds charged so far
				chargeStart = now - (serverNow - attr)
			end
		end
		if chargeStart and not busy then
			local chargeTime = (model:GetAttribute("ChargeTime") or AnimLibrary.ChargeTime) :: number
			local fraction = math.clamp((now - chargeStart) / chargeTime, 0, 1)
			local pose = AnimLibrary.Sample(AnimLibrary.Clips.Charge, fraction)
			if fraction >= 1 then
				-- Fully cranked: a little shake says "let go!"
				local shake = math.sin(now * 55 + rig.Seed) * 2.5
				pose.RightShoulder = (pose.RightShoulder or Vector3.zero) + Vector3.new(shake, 0, shake * 0.5)
			end
			addPose(total, pose, 1)
			undo = math.max(undo, math.min(1, fraction * 5))
		end

		-- Held states
		local player = Players:GetPlayerFromCharacter(model)
		local loop: AnimLibrary.Pose? = nil
		if not busy and not chargeStart then
			if (player and player:GetAttribute("Carrying")) or model:GetAttribute("Carrying") then
				local bob = math.sin(now * 6 + rig.Seed) * 4
				local carry = table.clone(AnimLibrary.Loops.Carry)
				carry.RightShoulder += Vector3.new(bob, 0, 0)
				carry.LeftShoulder += Vector3.new(-bob, 0, 0)
				loop = carry
			elseif player and player:GetAttribute("Training") then
				-- Running up the rungs of the Haunted Wheel: legs and arms pump faster on better wheels
				local level = (player:GetAttribute("TreadmillLevel") or 1) :: number
				local phase = now * (9 + level * 1.6) + rig.Seed
				local swing = math.sin(phase)
				loop = {
					RightHip = Vector3.new(swing * 45, 0, 0),
					LeftHip = Vector3.new(-swing * 45, 0, 0),
					RightKnee = Vector3.new(-25 - math.max(0, swing) * 45, 0, 0),
					LeftKnee = Vector3.new(-25 - math.max(0, -swing) * 45, 0, 0),
					RightShoulder = Vector3.new(-swing * 50, 0, 0),
					LeftShoulder = Vector3.new(swing * 50, 0, 0),
					RightElbow = Vector3.new(60, 0, 0),
					LeftElbow = Vector3.new(60, 0, 0),
					Waist = Vector3.new(8, 0, 0),
					RootMove = Vector3.new(0, math.abs(math.cos(phase)) * 0.3, 0),
				}
			else
				local tool = heldTool(model)
				if tool and tool:GetAttribute("Revolver") then
					loop = AnimLibrary.Loops.Aim
				end
			end
		end
		-- Held poses blend in and out instead of snapping
		local goal = if loop then 1 else 0
		rig.LoopWeight += math.clamp(goal - rig.LoopWeight, -dt / LOOP_BLEND, dt / LOOP_BLEND)
		if loop and rig.LoopWeight > 0 then
			addPose(total, loop, rig.LoopWeight)
			undo = math.max(undo, rig.LoopWeight)
		end

		-- Guards fidget while nothing else is happening: look around, lantern swings, breathing
		if CollectionService:HasTag(model, "ShopNPC") and not busy then
			-- Shopkeepers: lean on the counter, gesture, look around at the customers
			local s = rig.Seed
			addPose(total, {
				Neck = Vector3.new(math.sin(now * 0.7 + s) * 8, math.sin(now * 0.5 + s) * 30, 0),
				LeftShoulder = Vector3.new(40 + math.sin(now * 1.3 + s) * 25, 0, -10),
				LeftElbow = Vector3.new(50 + math.sin(now * 2.1 + s) * 20, 0, 0),
				RightShoulder = Vector3.new(30 + math.sin(now * 1.1 + s + 1) * 15, 0, 10),
				RightElbow = Vector3.new(45, 0, 0),
				Waist = Vector3.new(6 + math.sin(now * 1.4 + s) * 3, math.sin(now * 0.6 + s) * 10, 0),
			}, 1)
		end
		if CollectionService:HasTag(model, "Guard") and not busy and not chargeStart then
			local s = rig.Seed
			addPose(total, {
				Neck = Vector3.new(math.sin(now * 0.9 + s) * 6, math.sin(now * 0.45 + s) * 35, 0),
				LeftShoulder = Vector3.new(15 + math.sin(now * 2.2 + s) * 10, 0, math.sin(now * 1.7 + s) * 6),
				LeftElbow = Vector3.new(20, 0, 0),
				RightShoulder = Vector3.new(20, 0, 8), -- knife held ready
				RightElbow = Vector3.new(35, 0, 0),
				Waist = Vector3.new(math.sin(now * 1.6 + s) * 2, 0, 0),
			}, 1)
		end

		if trail ~= rig.TrailOn then
			rig.TrailOn = trail
			setTrail(model, trail)
		end

		-- Apply on top of whatever the Animator wrote this frame
		for name, joint in rig.Joints do
			local angles = total[name]
			local move = if name == "Root" then total.RootMove else nil
			local current = (joint :: any).Transform :: CFrame
			local base = current
			if rig.LastWritten[joint] and current == rig.LastWritten[joint] then
				base = rig.LastBase[joint] -- the Animator didn't touch it; don't stack our offset
			end
			if angles or move then
				local offset = AnimLibrary.ToCFrame(angles or Vector3.zero, move)
				if name == "RightShoulder" and heldTool(model) and undo > 0 then
					offset = CFrame.new():Lerp(TOOL_HOLD_UNDO, undo) * offset
				end
				local result = base * offset;
				(joint :: any).Transform = result
				rig.LastBase[joint] = base
				rig.LastWritten[joint] = result
			elseif rig.LastWritten[joint] then
				(joint :: any).Transform = base
				rig.LastWritten[joint] = nil
				rig.LastBase[joint] = nil
			end
		end
	end
end

local function track(model: Instance)
	if model:IsA("Model") then
		tracked[model] = true
	end
end

function Moves.Init()
	-- Everyone's character, and every guard
	local function watchPlayer(player: Player)
		if player.Character then
			track(player.Character)
		end
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			track(character)
		end)
	end
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, guard in CollectionService:GetTagged("Guard") do
		track(guard)
	end
	CollectionService:GetInstanceAddedSignal("Guard"):Connect(function(guard)
		track(guard)
	end)
	-- Round bots (Studio bot rounds) and raid burglars
	for _, tag in { "RoundBot", "Burglar", "ShopNPC" } do
		for _, model in CollectionService:GetTagged(tag) do
			track(model)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(track)
	end

	Remotes:WaitForChild("Anim").OnClientEvent:Connect(function(model: Model, name: string)
		if model and model.Parent then
			Moves.Play(model, name)
		end
	end)

	-- PreSimulation runs after the Animator has written this frame's pose
	RunService.PreSimulation:Connect(step)
end

return Moves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">Overheads</string>
            <string name="Source"><![CDATA[--!strict
-- How much money everyone has, floating over their head in the hub (Tsunami style). Drawn on each
-- client from the player's Cash attribute; hidden in rounds so it can't give a disguise away.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)

local Overheads = {}

local function attach(owner: Player, character: Model)
	local head = character:WaitForChild("Head", 10) :: BasePart?
	if not head or not character.Parent then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CashTag"
	gui:SetAttribute("LabelCategory", "Utility")
	gui:AddTag("ResponsiveWorldLabel")
	gui.Size = UDim2.fromOffset(160, 34)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Adornee = head
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(110, 255, 110)
	text.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(15, 60, 20)
	stroke.Parent = text
	local function refresh()
		local cash = (owner:GetAttribute("Cash") or 0) :: number
		text.Text = `${Format.Short(cash)}`
		gui.Enabled = not owner:GetAttribute("InRound")
	end
	refresh()
	local connections = {
		owner:GetAttributeChangedSignal("Cash"):Connect(refresh),
		owner:GetAttributeChangedSignal("InRound"):Connect(refresh),
	}
	gui.Destroying:Connect(function()
		for _, connection in connections do
			connection:Disconnect()
		end
	end)
	gui.Parent = head
end

local function track(owner: Player)
	owner.CharacterAdded:Connect(function(character)
		attach(owner, character)
	end)
	if owner.Character then
		task.spawn(attach, owner, owner.Character)
	end
end

function Overheads.Init()
	for _, owner in Players:GetPlayers() do
		track(owner)
	end
	Players.PlayerAdded:Connect(track)
end

return Overheads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">PowerBar</string>
            <string name="Source"><![CDATA[--!strict
-- The Innocent Power bar: one button per equipped power (keys Z / X / C, gamepad d-pad
-- Left / Up / Right, or tap). Shows the cooldown in the arena and the Energy cost in a round, and
-- hides itself while you're the Murderer. The server decides whether a use actually happens.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Ui = require(script.Parent.Ui)
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("GameConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local PowerBar = {}

local KEYS = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C }
local PAD = { Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadRight }
local KEY_LABELS = { "Z", "X", "C" }
local PAD_LABELS = { "◀", "▲", "▶" }

local byId: { [string]: any } = {}
for _, power in GameConfig.Powers do
	byId[power.Id] = power
end

local function aimDirection(): Vector3
	return workspace.CurrentCamera.CFrame.LookVector
end

function PowerBar.Init()
	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Name = "Powers",
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(224, 52),
		BackgroundTransparency = 1,
	}, Ui.gui)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10),
	}, bar)

	type Slot = { Button: TextButton, Name: TextLabel, Key: TextLabel, Shade: Frame, Count: TextLabel }
	local slots: { Slot } = {}
	local loadout: { string } = {}

	local function use(index: number)
		local id = loadout[index]
		if id and bar.Visible and not Ui.menuOpen() then
			Remotes.UsePower:FireServer(id, aimDirection())
		end
	end

	for i = 1, GameConfig.MaxPowerSlots do
		local button: TextButton = new("TextButton", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(68, 52),
			AutoButtonColor = true,
			Text = "",
			BackgroundColor3 = Ui.PANEL,
			Visible = false,
		}, bar)
		Ui.corner(button, 14)
		new("UIStroke", { Thickness = 2, Color = Color3.new(1, 1, 1) }, button)
		local name = Ui.label({
			Position = UDim2.fromOffset(4, 2),
			Size = UDim2.new(1, -8, 0, 26),
			Text = "",
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextStrokeTransparency = 0.4,
		}, button)
		local key = Ui.label({
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.fromOffset(22, 18),
			Text = KEY_LABELS[i],
			TextColor3 = Color3.fromRGB(220, 220, 230),
		}, button)
		local shade = new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.45,
			ZIndex = 3,
		}, button)
		Ui.corner(shade, 14)
		local count = Ui.label({
			Position = UDim2.new(0, 4, 1, -22),
			Size = UDim2.new(1, -8, 0, 20),
			Text = "",
			ZIndex = 4,
		}, button)
		button.Activated:Connect(function()
			use(i)
		end)
		slots[i] = { Button = button, Name = name, Key = key, Shade = shade, Count = count }
	end

	local function refresh()
		loadout = Ui.list(player:GetAttribute("Loadout"))
		for i, slot in slots do
			local power = byId[loadout[i]]
			slot.Button.Visible = power ~= nil
			if power then
				slot.Name.Text = power.DisplayName
				slot.Name.TextColor3 = power.Color
				slot.Button.BackgroundColor3 = power.Color:Lerp(Color3.fromRGB(20, 18, 28), 0.72);
				(slot.Button:FindFirstChildOfClass("UIStroke") :: UIStroke).Color = power.Color
			end
		end
	end
	player:GetAttributeChangedSignal("Loadout"):Connect(refresh)
	refresh()

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		for i = 1, #KEYS do
			if input.KeyCode == KEYS[i] or input.KeyCode == PAD[i] then
				use(i)
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		if Ui.Phone then
			local _, bounds = Ui.bounds()
			local knife = Ui.Layout.knifePosition()
			local right = math.min(bounds.X / 2 + 112, knife.X - 88)
			local left = math.max(152, right - 224)
			local width = math.max(140, right - left)
			bar.Position = UDim2.fromOffset((left + right) / 2, math.max(172, bounds.Y - 162) + 52)
			bar.Size = UDim2.fromOffset(width, 52)
			for _, slot in slots do
				slot.Button.Size = UDim2.fromOffset((width - 20) / 3, 52)
			end
		end
		-- The Murderer fights with their knife; powers are for innocents
		local inRound = player:GetAttribute("InRound") == true
		local murderer = inRound and player:GetAttribute("Role") == "Murderer"
		-- In the hub the powers only show where you'd use them: out on the runway with the guards,
		-- or during a Thief Moon. Safe on the plaza / in your vault, they're out of the way.
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local onRunway = root ~= nil
			and root.Position.Z > -2
			and math.abs(root.Position.X) < GameConfig.ArenaWidth / 2 + 2
		local bloodMoon = type(ReplicatedStorage:GetAttribute("RaidEndsAt")) == "number"
		local classic = inRound and ReplicatedStorage:GetAttribute("Classic") == true
		bar.Visible = not Ui.menuOpen()
			and not murderer
			and not classic
			and #loadout > 0
			and (inRound or onRunway or bloodMoon)
		local gamepad = UserInputService.PreferredInput == Enum.PreferredInput.Gamepad
		local now = workspace:GetServerTimeNow()
		for i, slot in slots do
			local id = loadout[i]
			if not id then
				continue
			end
			-- Rounds: only your first power comes along
			slot.Button.Visible = not inRound or i == 1
			slot.Key.Text = if Ui.Phone then "" elseif gamepad then PAD_LABELS[i] else KEY_LABELS[i]
			local energy = player:GetAttribute("Energy")
			if type(energy) == "number" then
				-- In a round: costs Energy (coins fill it); shaded while you can't afford it
				local power = byId[id]
				local level = GameConfig.RoundPowerLevel -- the same for everyone in rounds
				local cost = power.Energy[math.clamp(level, 1, #power.Energy)]
				slot.Shade.Size = UDim2.fromScale(1, if energy >= cost then 0 else 1 - energy / cost)
				slot.Count.Text = `⚡{cost}`
			else
				-- In the arena: cooldown, the shade drains as it recharges
				local readyAt = player:GetAttribute(`PowerReady_{id}`)
				local left = if type(readyAt) == "number" then readyAt - now else 0
				local power = byId[id]
				slot.Shade.Size = UDim2.fromScale(1, math.clamp(left / power.Cooldown, 0, 1))
				slot.Count.Text = if left > 0 then tostring(math.ceil(left)) else ""
			end
		end
	end)
end

return PowerBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">Raid</string>
            <string name="Source"><![CDATA[--!strict
-- The raid side of the hub, on this client:
--   * vault gates are solid for everyone but their owner (unless broken, or you have revenge on
--     its owner); the server double-checks and evicts anyone who slips through
--   * "Steal" prompts on other players' pedestals light up only when that vault is open to you
--   * hold R (or the button) at your own gate to repair it whenever it's been hit
--   * every gate's glowing barrier fades and stutters as its health drops
--   * pushing into someone's powerful knife aura: the screen tints, you slow, "Get away from..."
--   * getting knocked down: stars, a shake, the screen greys out for a moment

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local Raid = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function revengeOn(ownerId: number?): boolean
	local until_ = player:GetAttribute("RevengeUntil")
	return ownerId ~= nil
		and player:GetAttribute("RevengeOn") == ownerId
		and type(until_) == "number"
		and now() < until_
end

local function blockerOf(ownerId: number): BasePart?
	for _, blocker in CollectionService:GetTagged("VaultGate") do
		if blocker:GetAttribute("Owner") == ownerId then
			return blocker :: BasePart
		end
	end
	return nil
end

-- Whether a vault is open to me right now
local function openToMe(ownerId: number?): boolean
	if ReplicatedStorage:GetAttribute("Phase") ~= "Intermission" or player:GetAttribute("InRound") then
		return false
	end
	if not ownerId or ownerId == player.UserId then
		return false
	end
	if revengeOn(ownerId) then
		return true
	end
	local blocker = blockerOf(ownerId)
	return blocker ~= nil and blocker:GetAttribute("Open") == true
end

-- The barrier glow behind each gate's bars: solid at full health, thinner as it's chipped away,
-- and stuttering when it's about to give
local function refreshBarriers()
	local t = os.clock()
	for _, instance in CollectionService:GetTagged("VaultGate") do
		local blocker = instance :: BasePart
		local gate = blocker.Parent
		if not gate or blocker:GetAttribute("Open") then
			continue
		end
		local health = (blocker:GetAttribute("Health") or 1) :: number
		local max = (blocker:GetAttribute("MaxHealth") or 1) :: number
		local ratio = math.clamp(health / max, 0, 1)
		local stutter = ratio < 0.3 and math.noise(t * 9, blocker.Position.X) > 0.15
		for _, d in gate:GetChildren() do
			if d:IsA("BasePart") and d.Name == "Pane" then
				local base = (d:GetAttribute("BaseTransparency") or 0.35) :: number
				d.Transparency = if stutter then 0.95 else base + (1 - ratio) * (0.9 - base)
			end
		end
	end
end

local function refreshGates()
	for _, instance in CollectionService:GetTagged("VaultGate") do
		local blocker = instance :: BasePart
		local owner = blocker:GetAttribute("Owner") :: number?
		local solid = owner ~= nil and owner ~= player.UserId and not openToMe(owner)
		-- Empty vaults are sealed too (nothing to see, nowhere to hide)
		if owner == nil then
			solid = true
		end
		blocker.CanCollide = solid
	end
end

local function refreshPrompts()
	local inRound = player:GetAttribute("InRound") == true
	for _, prompt in CollectionService:GetTagged("StealPrompt") do
		local p = prompt :: ProximityPrompt
		p.Enabled = not inRound and openToMe(p:GetAttribute("Owner") :: number?)
	end
end

local function trackPrompt(instance: Instance)
	if instance:IsA("ProximityPrompt") and instance:GetAttribute("WallUpgrade") then
		instance.Enabled = instance:GetAttribute("Owner") == player.UserId
		return
	end
	if instance:IsA("ProximityPrompt") and instance:GetAttribute("Steal") then
		instance:AddTag("StealPrompt")
		instance.Enabled = false
	end
end

-- Coloured light creeping in from the screen edges; returns a setter for how strong (0..1).
-- (Atmosphere uses one too, for the Murderer's dread.)
function Raid.Vignette(parent: Instance, color: Color3): (number) -> ()
	local frames = {}
	for _, side in
		{
			{ Size = UDim2.fromScale(1, 0.32), Position = UDim2.fromScale(0, 0), Rotation = 90 },
			{ Size = UDim2.fromScale(1, 0.32), Position = UDim2.fromScale(0, 0.68), Rotation = -90 },
			{ Size = UDim2.fromScale(0.24, 1), Position = UDim2.fromScale(0, 0), Rotation = 0 },
			{ Size = UDim2.fromScale(0.24, 1), Position = UDim2.fromScale(0.76, 0), Rotation = 180 },
		}
	do
		local frame = new("Frame", {
			Size = side.Size,
			Position = side.Position,
			BackgroundColor3 = color,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, parent)
		new("UIGradient", {
			Rotation = side.Rotation,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, frame)
		table.insert(frames, frame)
	end
	local current = 0
	return function(strength: number)
		current += (strength - current) * 0.15
		for _, frame in frames do
			frame.BackgroundTransparency = 1 - current * 0.75
		end
	end
end

function Raid.Init()
	-- Gates and prompts: refresh on every change, and on a slow timer for revenge running out
	for _, d in workspace:GetDescendants() do
		trackPrompt(d)
	end
	workspace.DescendantAdded:Connect(trackPrompt)
	CollectionService:GetInstanceAddedSignal("VaultGate"):Connect(function(blocker)
		blocker.AttributeChanged:Connect(function()
			refreshGates()
			refreshPrompts()
		end)
		refreshGates()
	end)
	for _, blocker in CollectionService:GetTagged("VaultGate") do
		blocker.AttributeChanged:Connect(function()
			refreshGates()
			refreshPrompts()
		end)
	end
	CollectionService:GetInstanceAddedSignal("StealPrompt"):Connect(refreshPrompts)
	for _, attribute in { "RevengeOn", "RevengeUntil", "InRound" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			refreshGates()
			refreshPrompts()
		end)
	end
	ReplicatedStorage:GetAttributeChangedSignal("Raid"):Connect(function()
		refreshGates()
		refreshPrompts()
	end)
	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		refreshGates()
		refreshPrompts()
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			refreshGates()
			refreshPrompts()
		end
	end)

	-- Repairing your own gate during a raid ------------------------------------------------------
	local repairButton = Ui.chunky(
		{
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 108),
			Size = UDim2.fromOffset(120, 44),
			BackgroundColor3 = Color3.fromRGB(90, 160, 255),
			Text = "Repair" .. Ui.hint("R", "L3"),
			Visible = false,
		},
		Ui.gui,
		"🔧",
		function()
			Remotes.RepairGate:FireServer()
		end
	)
	local function nearOwnGate(): boolean
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local blocker = blockerOf(player.UserId)
		return root ~= nil
			and blocker ~= nil
			and blocker:GetAttribute("Open") ~= true
			and ((blocker:GetAttribute("Health") or 0) :: number) < ((blocker:GetAttribute("MaxHealth") or 0) :: number)
			and (root.Position - blocker.Position).Magnitude < 16
	end
	repairButton:GetPropertyChangedSignal("Visible"):Connect(function()
		Ui.gui:SetAttribute("RepairVisible", repairButton.Visible)
	end)
	ContextActionService:BindAction("RepairGate", function(_, state)
		if state == Enum.UserInputState.Begin and nearOwnGate() and not Ui.menuOpen() then
			Remotes.RepairGate:FireServer()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.R, Enum.KeyCode.ButtonL3)

	-- Aura pressure: a tint creeping in from the edges, and the warning ------------------------------
	local auraGui = new("ScreenGui", {
		Name = "AuraPressure",
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		ResetOnSpawn = false,
	}, player:WaitForChild("PlayerGui"))
	local setVignette = Raid.Vignette(auraGui, Color3.fromRGB(170, 70, 255))
	local warning = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromOffset(700, 44),
		Text = "",
		TextTransparency = 1,
		TextColor3 = Color3.fromRGB(230, 170, 255),
	}, auraGui)
	Ui.textStroke(warning, 3)

	-- Knocked down: stars and a grey-out
	local knockLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(600, 70),
		Text = "💫 KNOCKED DOWN 💫",
		TextColor3 = Color3.fromRGB(255, 230, 120),
		Visible = false,
	}, auraGui)
	Ui.textStroke(knockLabel, 4)
	local grey = new("ColorCorrectionEffect", { Name = "KnockGrey", Enabled = false }, workspace.CurrentCamera)
	player:GetAttributeChangedSignal("KnockedUntil"):Connect(function()
		local knocked = player:GetAttribute("KnockedUntil")
		local down = type(knocked) == "number" and knocked > now()
		knockLabel.Visible = down
		grey.Enabled = down
		grey.Saturation = -0.7
		if down then
			Effects.Shake(4, 0.5)
			local scale = knockLabel:FindFirstChildOfClass("UIScale") or new("UIScale", {}, knockLabel)
			scale.Scale = 0.4
			TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end)

	local camera = workspace.CurrentCamera
	local baseFov = 70
	local barrierTimer = 0
	RunService.RenderStepped:Connect(function(dt: number)
		-- Repair button
		barrierTimer += dt
		if barrierTimer >= 0.1 then
			barrierTimer = 0
			repairButton.Visible = nearOwnGate()
				and not Ui.menuOpen()
				and Ui.gui:GetAttribute("KnifeGestureActive") ~= true
			refreshBarriers()
		end
		-- Aura pressure
		local slow = player:GetAttribute("AuraSlow")
		local pressure = if type(slow) == "number" then math.clamp((1 - slow) / 0.6, 0, 1) else 0
		setVignette(pressure)
		local from = player:GetAttribute("AuraFrom")
		if pressure > 0.02 and type(from) == "string" then
			warning.Text = `Get away from {from}!`
			warning.TextTransparency = math.max(0, warning.TextTransparency - dt * 4)
			-- The pull wobbles your view a little
			camera.FieldOfView = baseFov - pressure * 8 + math.sin(os.clock() * 7) * pressure * 1.5
		else
			warning.TextTransparency = math.min(1, warning.TextTransparency + dt * 3)
		end
		local stroke = warning:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = warning.TextTransparency
		end
	end)
	-- Put the field of view back once you're out of the aura
	player:GetAttributeChangedSignal("AuraSlow"):Connect(function()
		if player:GetAttribute("AuraSlow") == nil then
			TweenService:Create(camera, TweenInfo.new(0.4), { FieldOfView = baseFov }):Play()
		end
	end)
end

return Raid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">RebirthView</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage.Remotes
local View = {}

function View.Build(): (Frame, () -> ())
	local frame, body = Theme.shell("Rebirth", "Rebirth", Theme.Purple, "Rebirth", 450)
	local current = Theme.surface(body, { Name = "Current", Size = UDim2.new(0.36, -6, 0, 126) }, Theme.Green)
	local nextTier = Theme.surface(
		body,
		{ Name = "Next", Position = UDim2.fromScale(0.45, 0), Size = UDim2.new(0.34, -6, 0, 126) },
		Theme.Gold
	)
	Theme.arrow(
		body,
		{ Name = "UpgradeArrow", Position = UDim2.new(0.36, 0, 0, 30), Size = UDim2.new(0.09, -6, 0, 60) }
	)
	local titles, multipliers = {}, {}
	for i, pane in { current, nextTier } do
		titles[i] = Theme.text(pane, "", {
			Name = "RebirthNumber",
			Position = UDim2.fromOffset(6, 5),
			Size = UDim2.new(1, -12, 0, 42),
			MaximumTextSize = 37,
		})
		Theme.image(pane, "Cash", { Position = UDim2.fromOffset(12, 44), Size = UDim2.fromOffset(82, 74) })
		multipliers[i] = Theme.text(pane, "", {
			Name = "Multiplier",
			Position = UDim2.fromOffset(92, 46),
			Size = UDim2.new(1, -100, 0, 70),
			MaximumTextSize = 43,
		})
	end
	local benefits = {}
	for i, symbol in { "Training", "Luck" } do
		local pane = Theme.surface(
			body,
			{ Position = UDim2.new(0.8, 0, 0, (i - 1) * 66), Size = UDim2.new(0.2, 0, 0, 60) },
			if i == 1 then Theme.Cyan else Theme.Purple
		)
		Theme.image(pane, symbol, { Position = UDim2.fromOffset(2, 5), Size = UDim2.fromOffset(55, 50) })
		benefits[i] = Theme.text(
			pane,
			"",
			{ Position = UDim2.fromOffset(56, 2), Size = UDim2.new(1, -60, 1, -4), MaximumTextSize = 26 }
		)
	end
	local warning = Theme.surface(
		body,
		{ Name = "ResetWarning", Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 48) },
		Theme.Navy,
		Color3.fromRGB(57, 116, 175)
	)
	Theme.image(warning, "Rebirth", { Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(40, 40) })
	Theme.text(warning, "Resets: cash, knives, mounts, speed, wheel, walls", {
		Position = UDim2.fromOffset(44, 4),
		Size = UDim2.new(0.64, -44, 1, -8),
		MaximumTextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	Theme.text(warning, "✓ Keeps: powers, Index, stats", {
		Position = UDim2.new(0.64, 6, 0, 4),
		Size = UDim2.new(0.36, -12, 1, -8),
		MaximumTextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local progress = Theme.surface(
		body,
		{ Name = "CashProgress", Position = UDim2.fromOffset(0, 200), Size = UDim2.new(1, 0, 0, 48) },
		Theme.Navy,
		Color3.fromRGB(57, 116, 175)
	)
	local fill = Theme.surface(
		progress,
		{ Position = UDim2.fromOffset(5, 5), Size = UDim2.new(0, 0, 1, -10), Visible = false },
		Theme.Green
	)
	local cashText =
		Theme.text(progress, "", { Name = "CashRequirement", Size = UDim2.fromScale(1, 1), MaximumTextSize = 38 })
	local action = Theme.button(body, "REBIRTH", Theme.Purple, {
		Name = "RebirthAction",
		Position = UDim2.new(0.12, 0, 0, 262),
		Size = UDim2.new(0.76, 0, 0, 66),
		MaximumTextSize = 52,
	}, function()
		Remotes.Purchase:InvokeServer("Rebirth")
	end, "Rebirth")
	local lock = Ui.new("Frame", {
		Name = "Locked",
		Position = UDim2.new(1, -66, 0.5, -22),
		Size = UDim2.fromOffset(38, 44),
		BackgroundTransparency = 1,
		ZIndex = 12,
	}, action)
	local lavender = Color3.fromRGB(180, 116, 240)
	local bow = Ui.new(
		"Frame",
		{ Position = UDim2.fromOffset(7, 0), Size = UDim2.fromOffset(24, 28), BackgroundTransparency = 1, ZIndex = 12 },
		lock
	)
	Ui.corner(bow, 12)
	Theme.outline(bow, lavender, 5)
	local plate = Ui.new("Frame", {
		Position = UDim2.fromOffset(2, 18),
		Size = UDim2.fromOffset(34, 24),
		BackgroundColor3 = lavender,
		BorderSizePixel = 0,
		ZIndex = 13,
	}, lock)
	Ui.corner(plate, 4)
	Ui.new("Frame", {
		Position = UDim2.fromOffset(15, 6),
		Size = UDim2.fromOffset(4, 11),
		BackgroundColor3 = Theme.Purple:Lerp(Theme.Navy, 0.75),
		BorderSizePixel = 0,
		ZIndex = 14,
	}, plate)
	local function refresh()
		local rebirths = player:GetAttribute("Rebirths") or 0
		local cash = player:GetAttribute("Cash") or 0
		local config = GameConfig.Rebirth
		local maximum = rebirths >= config.Max
		local nextCount = if maximum then rebirths else rebirths + 1
		local cost = GameConfig.RebirthCost(rebirths)
		titles[1].Text, titles[2].Text = `Rebirth {rebirths}`, if maximum then "MAX REBIRTH" else `Rebirth {nextCount}`
		multipliers[1].Text = `{1 + rebirths * config.IncomeBonus}x Income`
		multipliers[2].Text = `{1 + nextCount * config.IncomeBonus}x Income`
		benefits[1].Text = `+{math.floor(nextCount * config.SpeedBonus * 100)}%\nTraining`
		benefits[2].Text = `+{math.floor(nextCount * config.LuckBonus * 100)}%\nCase Luck`
		local ratio = if maximum then 1 else math.clamp(cash / cost, 0, 1)
		fill.Size, fill.Visible = UDim2.new(ratio, -10 * ratio, 1, -10), ratio > 0
		cashText.Text = if maximum then "MAXIMUM REBIRTH REACHED" else `${Ui.abbreviate(cash)} / ${Ui.abbreviate(cost)}`
		local carrying = player:GetAttribute("Carrying")
		local blocked = player:GetAttribute("InRound") == true
			or (carrying ~= nil and carrying ~= false and carrying ~= "")
		local label = if maximum then "MAX REBIRTH" elseif blocked then "FINISH YOUR CURRENT RUN" else "REBIRTH"
		Theme.enabled(action, not maximum and not blocked and cash >= cost, label)
		lock.Visible = action:GetAttribute("Disabled") == true
	end
	for _, attribute in { "Cash", "Rebirths", "InRound", "Carrying" } do
		player:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible then
			refresh()
		end
	end)
	refresh()
	return frame, refresh
end

return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">RoundIntro</string>
            <string name="Source"><![CDATA[--!strict
-- The heads-up before your first Murder Mystery round of the session: for the last 10 seconds of
-- the intermission a big card counts down and says what's about to happen, so the teleport into
-- the round map is exciting instead of confusing. First-time players (attribute FirstVisit, set
-- by RoundService) get the full explanation; everyone else a short reminder with their chance of
-- being the Murderer.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))
local player = Players.LocalPlayer
local new = Ui.new

local RoundIntro = {}

local STATUS = "🔪 MURDER ROUND in" -- RoundService.IntermissionStatus
local WARN_AT = 10 -- seconds before the round

function RoundIntro.Init()
	local card = new("Frame", {
		Name = "RoundIntro",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(620, 190),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 60, -- over the welcome card (50s): it matters more right now
	}, Ui.gui)
	Ui.corner(card, 18)
	Ui.fitMenu(card, Vector2.new(620, 190))
	Ui.gradient(card, Color3.fromRGB(70, 16, 24), Color3.fromRGB(30, 8, 14))
	new("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 70, 70) }, card)
	local scale = new("UIScale", {}, card)
	local title = Ui.label({
		Size = UDim2.new(1, -30, 0, 44),
		Position = UDim2.fromOffset(15, 10),
		Font = Ui.SPOOKY,
		TextColor3 = Color3.fromRGB(255, 70, 70),
		Text = "",
		ZIndex = 61,
	}, card)
	Ui.textStroke(title, 4)
	local body = Ui.label({
		Size = UDim2.new(1, -40, 1, -68),
		Position = UDim2.fromOffset(20, 60),
		TextScaled = false,
		TextSize = 16,
		TextWrapped = true,
		Text = "",
		ZIndex = 61,
	}, card)
	Ui.textStroke(body, 2.5)

	local shownThisSession = false
	local showing = false
	local lastSecond = -1

	local function hide()
		if not showing then
			return
		end
		showing = false
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0.6 }):Play()
		task.delay(0.2, function()
			if not showing then
				card.Visible = false
			end
		end)
	end

	RunService.Heartbeat:Connect(function()
		local phase = ReplicatedStorage:GetAttribute("Phase")
		local status = ReplicatedStorage:GetAttribute("Status")
		local endsAt = ReplicatedStorage:GetAttribute("PhaseEndsAt")
		if
			phase ~= "Intermission"
			or status ~= STATUS
			or type(endsAt) ~= "number"
			or player:GetAttribute("InRound")
		then
			hide()
			return
		end
		local left = endsAt - workspace:GetServerTimeNow()
		if left > WARN_AT or left <= 0 then
			hide()
			return
		end
		if not showing then
			if shownThisSession then
				return
			end
			shownThisSession = true
			showing = true
			Ui.Menu.Close()
			card.Visible = true
			scale.Scale = 0.6
			TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			Effects.Sound(Sounds.Sting, nil, 0.7)
			if player:GetAttribute("FirstVisit") then
				body.Text = "Everyone here is about to play MURDER MYSTERY! One player is secretly the MURDERER. "
					.. "Everyone else: SURVIVE! Grab coins for powers - and if you find the Revolver, shoot the Murderer!"
			else
				local chance = player:GetAttribute("MurdererChance")
				body.Text =
					`Who's the Murderer this time? Your chance: {chance or "?"}%. Innocents: survive and find the Revolver!`
			end
		end
		local second = math.ceil(left)
		if second ~= lastSecond then
			lastSecond = second
			title.Text = `🔪 MURDER ROUND IN {second}`
			if second <= 5 then
				Effects.Sound(Sounds.Tick, nil, 0.6)
			end
		end
	end)
end

return RoundIntro
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!strict
-- The Robux side of the HUD (Config/Monetization, server: MonetizationService):
--   * the 💎 STORE button and panel: passes, boosts, and Robux cases with their full odds
--   * contextual offers (Remotes.Offer): a card that slides in when you hit something a product
--     fixes - short on cash, wall full, gate under attack - then gets out of the way
--   * "Instant Repair" beside the Repair button while your gate is damaged
--   * the Server Luck timer while someone's luck boost is running
-- Purchases go through MarketplaceService; in Studio, anything without an id is faked for testing.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local Effects = require(script.Parent.Effects)
local StoreView = require(script.Parent.StoreView)
local CaseOdds = require(script.Parent.CaseOdds)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local Monetization = require(Shared.Config:WaitForChild("Monetization"))
local Sounds = require(Shared.Config:WaitForChild("Sounds"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local Store = {}

local DARK = Ui.PANEL
local ROBUX = Color3.fromRGB(0, 176, 111)
-- Where offer cards settle: left of the right-hand buttons (higher on phones, above the thumbs)
local OFFER_X = if Ui.Phone then -190 else -262
local OFFER_Y = if Ui.Phone then 0.46 else 0.62

-- Buying ---------------------------------------------------------------------------------------

local function buy(kind: string, key: string)
	local entry: { Id: number } = if kind == "Pass"
		then Monetization.PassByKey[key] :: any
		else Monetization.ProductByKey[key] :: any
	if not entry then
		return
	end
	if entry.Id > 0 then
		if kind == "Pass" then
			MarketplaceService:PromptGamePassPurchase(player, entry.Id)
		else
			MarketplaceService:PromptProductPurchase(player, entry.Id)
		end
	elseif RunService:IsStudio() then
		Remotes:WaitForChild("StoreTest"):InvokeServer(kind, key)
	end
end

local function kindOf(key: string): string
	return if Monetization.PassByKey[key] then "Pass" else "Product"
end

local function owned(key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true or player:GetAttribute("Bought_" .. key) == true
end

-- What a cash pack is worth to *you* right now
local function cashFor(product: Monetization.Product): number?
	if not product.Cash then
		return nil
	end
	local income = (player:GetAttribute("Income") or 0) :: number
	return GameConfig.Pay(product.Cash, income)
end

-- A green Robux price button
local function priceButton(parent: Instance, price: number, props: { [string]: any }, onClick: () -> ()): TextButton
	props.BackgroundColor3 = ROBUX
	props.Text = `R$ {price}`
	local button = Theme.button(parent, `R$ {price}`, Theme.Green, props, onClick)
	return button
end

-- Case odds (the same numbers the Case Shop shows) -----------------------------------------------

-- The Store panel --------------------------------------------------------------------------------

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.ZIndex = props.ZIndex or 6
	local label = Ui.label(props, parent)
	Ui.textStroke(label, 1.5)
	return label
end

function Store.Init()
	local gui = Ui.gui

	StoreView.Build({ buy = buy, owned = owned, cash = cashFor, odds = CaseOdds.Text, price = priceButton })

	-- Contextual offers ---------------------------------------------------------------------------
	local offerCard: Frame? = nil
	local function hideOffers()
		if offerCard and (Ui.menuOpen() or gui:GetAttribute("KnifeGestureActive") == true) then
			offerCard:Destroy()
			offerCard = nil
		end
	end
	gui:GetAttributeChangedSignal("MenuOpen"):Connect(hideOffers)
	gui:GetAttributeChangedSignal("KnifeGestureActive"):Connect(hideOffers)
	local function closeOffer()
		local card = offerCard
		offerCard = nil
		if card then
			TweenService:Create(card, TweenInfo.new(0.25), { Position = UDim2.new(1, 360, OFFER_Y, 0) }):Play()
			task.delay(0.3, function()
				card:Destroy()
			end)
		end
	end
	Remotes:WaitForChild("Offer").OnClientEvent:Connect(function(key: string, reason: string)
		if
			Ui.menuOpen()
			or gui:GetAttribute("KnifeGestureActive") == true
			or player:GetAttribute("InRound")
			or owned(key)
		then
			return
		end
		local kind = kindOf(key)
		local entry: { Name: string, Icon: string, Price: number, Color: Color3 } = if kind == "Pass"
			then Monetization.PassByKey[key] :: any
			else Monetization.ProductByKey[key] :: any
		if not entry then
			return
		end
		closeOffer()
		local card = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 360, OFFER_Y, 0),
			Size = UDim2.fromOffset(330, 150),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 20,
		}, gui)
		offerCard = card
		Ui.corner(card, 14)
		Ui.gradient(card, entry.Color:Lerp(DARK, 0.25), entry.Color:Lerp(DARK, 0.75))
		new("UIStroke", { Thickness = 3.5, Color = Color3.fromRGB(16, 12, 22) }, card)
		text(card, {
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -56, 0, 32),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = `{entry.Icon} {entry.Name}`,
			ZIndex = 21,
		})
		text(card, {
			Position = UDim2.fromOffset(10, 40),
			Size = UDim2.new(1, -20, 0, 46),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = false,
			TextSize = 16,
			TextWrapped = true,
			Text = reason,
			ZIndex = 21,
		})
		priceButton(card, entry.Price, {
			Position = UDim2.fromOffset(10, 94),
			Size = UDim2.fromOffset(190, 46),
			ZIndex = 22,
		}, function()
			buy(kind, key)
			closeOffer()
		end)
		Ui.button({
			Position = UDim2.fromOffset(210, 94),
			Size = UDim2.fromOffset(110, 46),
			BackgroundColor3 = Color3.fromRGB(80, 76, 96),
			Text = "No thanks",
			ZIndex = 22,
		}, card, closeOffer)
		Effects.Sound(Sounds.Reveal, nil, 0.4)
		TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back), {
			Position = UDim2.new(1, OFFER_X, OFFER_Y, 0),
		}):Play()
		task.delay(14, function()
			if offerCard == card then
				closeOffer()
			end
		end)
	end)
	player:GetAttributeChangedSignal("InRound"):Connect(function()
		if player:GetAttribute("InRound") then
			closeOffer()
		end
	end)

	-- Instant Repair, beside the Repair button while your gate is damaged -------------------------
	local repair = Monetization.ProductByKey.Repair
	local instant = priceButton(gui, repair.Price, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 160),
		Size = UDim2.fromOffset(120, 44),
		Visible = false,
	}, function()
		buy("Product", "Repair")
	end)
	local instantLabel = instant:FindFirstChild("Label") :: TextLabel?
	if instantLabel then
		instantLabel.Text = `🔧 Instant  R$ {repair.Price}`
	end
	local function refreshRepair()
		instant.Visible = gui:GetAttribute("RepairVisible") == true
			and not Ui.menuOpen()
			and gui:GetAttribute("KnifeGestureActive") ~= true
	end
	for _, attribute in { "RepairVisible", "MenuOpen", "KnifeGestureActive" } do
		gui:GetAttributeChangedSignal(attribute):Connect(refreshRepair)
	end
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">StoreView</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation only. Marketplace prompts, ownership and grants stay in Store/server services.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Ui = require(script.Parent.Ui)
local Theme = require(script.Parent.MenuTheme)
local CaseShowcase = require(script.Parent.CaseShowcase)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Remotes = ReplicatedStorage.Remotes
local Config = ReplicatedStorage.Shared.Config
local Monetization = require(Config.Monetization)
local Knives = require(Config.Knives)
local player = Players.LocalPlayer
local View = {}

local function exactCash(amount: number): string
	local text = string.format("%.0f", amount)
	local groups = text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return "$" .. groups
end

local function label(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local options: { [string]: any } =
		{ Text = text, TextScaled = false, TextSize = 16, TextWrapped = true, ZIndex = 6 }
	for key, value in (props or {}) :: { [string]: any } do
		options[key] = value
	end
	return Theme.text(parent, text, options)
end
local function card(parent: Instance, order: number, color: Color3, height: number): Frame
	return Theme.surface(
		parent,
		{ LayoutOrder = order, Size = UDim2.new(1, -8, 0, height), ZIndex = 7 },
		color:Lerp(Theme.Navy, 0.3),
		color
	)
end
local function page(parent: Instance, props: { [string]: any }): ScrollingFrame
	props.BackgroundTransparency = 1
	props.CanvasSize = UDim2.new()
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.ScrollBarThickness = 4
	props.ZIndex = 5
	local scroll: ScrollingFrame = Ui.new("ScrollingFrame", props, parent)
	Ui.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	Ui.padding(scroll, 4)
	return scroll
end

function View.Build(actions: any): Frame
	local frame, body, header = Theme.shell("Store", "Shop", Theme.Green, "Cash", 540)
	local shopTitle = header:FindFirstChild("Title") :: TextLabel
	shopTitle.Size = UDim2.fromOffset(340, 80)
	local tabs = Ui.new("Frame", {
		Position = UDim2.fromOffset(478, 16),
		Size = UDim2.fromOffset(432, 60),
		BackgroundTransparency = 1,
		ZIndex = 8,
	}, header)
	Ui.new("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -8, 1, 0),
		CellPadding = UDim2.fromOffset(8, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, tabs)
	local pages: { [string]: ScrollingFrame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local function selectTab(name: string)
		for key, scroll in pages do
			scroll.Visible = key == name
			local border = tabButtons[key]:FindFirstChildOfClass("UIStroke") :: UIStroke
			border.Color = if key == name then Color3.new(1, 1, 1) else Theme.Black
		end
	end
	for i, name in { "Cases", "Passes", "Boosts" } do
		pages[name] = page(body, { Name = name, Size = UDim2.fromScale(1, 1), Visible = i == 1 })
		tabButtons[name] = Theme.button(
			tabs,
			name,
			({ Theme.Gold, Theme.Cyan, Theme.Purple })[i],
			{ Name = name, LayoutOrder = i, MaximumTextSize = 25 },
			function()
				selectTab(name)
			end,
			({ "CaseLegendary", "Index", "Speed" })[i]
		)
	end
	local refreshers: { () -> () } = {}
	local function showOdds(rarity: string)
		local dialog = Ui.new(
			"Frame",
			{ Name = "CaseOdds", Size = UDim2.fromOffset(720, 560), BackgroundColor3 = Ui.PANEL, ZIndex = 8 },
			Ui.gui
		)
		Ui.corner(dialog, 16)
		Ui.fitMenu(dialog, Vector2.new(720, 560))
		Ui.registerMenu(dialog)
		label(dialog, rarity .. " Case — full odds", {
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -80, 0, 44),
			ZIndex = 9,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		Ui.button(
			{
				Name = "Close",
				Text = "X",
				Position = UDim2.new(1, -52, 0, 8),
				Size = UDim2.fromOffset(44, 44),
				ZIndex = 10,
			},
			dialog,
			function()
				dialog:Destroy()
				frame.Visible = true
			end
		)
		local scroll = page(dialog, { Position = UDim2.fromOffset(16, 64), Size = UDim2.new(1, -32, 1, -80) })
		label(
			scroll,
			actions.odds(rarity)
				.. "\n\nKnife, mutation and size are separate rolls. Current rebirth and server luck apply to mutations and sizes. Murderer powers are rolled separately at your vault.",
			{
				TextSize = 16,
				TextYAlignment = Enum.TextYAlignment.Top,
				Size = UDim2.new(1, -12, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				ZIndex = 10,
			}
		)
	end
	local function cashCase(rarity: string)
		for _, entry in GameConfig.CaseShop do
			if entry.Rarity == rarity then
				return entry
			end
		end
		error("Unknown cash case " .. rarity)
	end
	local hero = Ui.new("Frame", {
		Name = "FeaturedCase",
		Size = UDim2.new(1, -8, 0, 328),
		LayoutOrder = 1,
		BackgroundTransparency = 1,
		ZIndex = 7,
	}, pages.Cases)
	local function feature(rarity: string)
		for _, child in hero:GetChildren() do
			child:Destroy()
		end
		local entry = cashCase(rarity)
		local showcase = CaseShowcase.Build(hero, rarity, "$" .. Ui.abbreviate(entry.Cost), function()
			Remotes.Purchase:InvokeServer("Case:" .. rarity)
		end, function()
			showOdds(rarity)
		end)
		showcase.Size = UDim2.fromScale(1, 1)
	end
	local secondary = Ui.new("Frame", {
		Name = "MoreCashCases",
		LayoutOrder = 2,
		Size = UDim2.new(1, -8, 0, 78),
		BackgroundTransparency = 1,
		ZIndex = 7,
	}, pages.Cases)
	for i, rarity in { "Epic", "Godly" } do
		Theme.button(secondary, rarity:upper() .. "\nCASE", Knives.RarityColors[rarity], {
			Name = rarity .. "Case",
			Position = UDim2.fromScale((i - 1) * 0.32, 0),
			Size = UDim2.new(0.31, 0, 1, -4),
			MaximumTextSize = 31,
		}, function()
			feature(rarity)
			pages.Cases.CanvasPosition = Vector2.zero
		end, "Case" .. rarity)
	end
	local otherCash = Ui.new("Frame", {
		Name = "CashCatalog",
		LayoutOrder = 3,
		Size = UDim2.new(1, -8, 0, 78),
		BackgroundTransparency = 1,
		ZIndex = 7,
	}, pages.Cases)
	Ui.new("UIGridLayout", {
		CellSize = UDim2.new(1 / 5, -7, 1, 0),
		CellPadding = UDim2.fromOffset(7, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, otherCash)
	for i, rarity in { "Common", "Rare", "Mythic", "Celestial", "Cosmic" } do
		Theme.button(
			otherCash,
			rarity .. "\n$" .. Ui.abbreviate(cashCase(rarity).Cost),
			Knives.RarityColors[rarity],
			{ LayoutOrder = i, MaximumTextSize = 24 },
			function()
				feature(rarity)
				pages.Cases.CanvasPosition = Vector2.zero
			end
		)
	end
	feature("Legendary")
	label(
		pages.Cases,
		"ROBUX CASES",
		{ LayoutOrder = 5, Size = UDim2.new(1, -8, 0, 44), TextSize = 28, TextColor3 = Theme.Gold }
	)
	local function caseRow(key: string, order: number)
		local product = Monetization.ProductByKey[key]
		local rarity = product.Case :: string
		local row = CaseShowcase.Build(pages.Cases, rarity, "R$ " .. product.Price, function()
			actions.buy("Product", key)
		end, function()
			showOdds(rarity)
		end)
		row.LayoutOrder = order
	end
	caseRow("CaseLegendary", 6)
	caseRow("CaseEpic", 7)
	caseRow("CaseGodly", 8)
	local starter = Monetization.ProductByKey.Starter
	local starterRow = card(pages.Cases, 4, starter.Color, 112)
	Ui.art(starterRow, "CaseRare", { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(80, 90), ZIndex = 6 })
	label(starterRow, "Starter Pack · once per player", {
		Position = UDim2.fromOffset(96, 8),
		Size = UDim2.new(1, -252, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local contents = label(starterRow, "", {
		Position = UDim2.fromOffset(96, 48),
		Size = UDim2.new(1, -252, 0, 56),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	actions.price(
		starterRow,
		starter.Price,
		{ Position = UDim2.new(1, -140, 0, 12), Size = UDim2.fromOffset(128, 44), ZIndex = 7 },
		function()
			actions.buy("Product", "Starter")
		end
	)
	Ui.button(
		{ Text = "Case odds", Position = UDim2.new(1, -140, 0, 62), Size = UDim2.fromOffset(128, 44), ZIndex = 7 },
		starterRow,
		function()
			showOdds("Rare")
		end
	)
	table.insert(refreshers, function()
		starterRow.Visible = not actions.owned("Starter")
		contents.Text = `{exactCash(actions.cash(starter) or 0)} + 1 Rare Case`
	end)
	local function productGrid(scroll: ScrollingFrame): Frame
		local grid = Ui.new("Frame", {
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			ZIndex = 5,
		}, scroll) :: Frame
		local layout = Ui.new(
			"UIGridLayout",
			{ CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder },
			grid
		)
		local function resize()
			local width = math.max(160, grid.AbsoluteSize.X)
			local columns = math.max(1, math.floor((width + 12) / 192))
			layout.CellSize = UDim2.fromOffset((width - (columns - 1) * 12) / columns, 256)
		end
		grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
		resize()
		return grid
	end
	local passGrid, boostGrid = productGrid(pages.Passes), productGrid(pages.Boosts)
	local symbols: { [string]: string } = {
		DoubleCash = "Cash",
		VIP = "VIP",
		FastWheel = "Speed",
		PhantomTrail = "VoidEdge",
		Fortified = "Fortified",
		Titan = "Health",
		Mount = "Upgrades",
		ServerLuck = "Rebirth",
		BloodMoon = "CaseMythic",
		ChestRefill = "CaseRare",
	}
	local function offer(parent: Frame, entry: any, order: number, kind: string)
		local item = card(parent, order, entry.Color, 256)
		Theme.image(
			item,
			symbols[entry.Key] or "Cash",
			{ Position = UDim2.new(0.5, -32, 0, 4), Size = UDim2.fromOffset(64, 64), ZIndex = 6 }
		)
		label(item, entry.Name, { Position = UDim2.fromOffset(8, 72), Size = UDim2.new(1, -16, 0, 40), TextSize = 20 })
		local description = label(item, entry.Description, {
			TextSize = 14,
			Position = UDim2.fromOffset(12, 114),
			Size = UDim2.new(1, -24, 0, 82),
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		local purchase = actions.price(
			item,
			entry.Price,
			{ Position = UDim2.new(0, 8, 1, -52), Size = UDim2.new(1, -16, 0, 44), ZIndex = 7 },
			function()
				if kind ~= "Pass" or not actions.owned(entry.Key) then
					actions.buy(kind, entry.Key)
				end
			end
		)
		table.insert(refreshers, function()
			local text = purchase:FindFirstChild("Label") :: TextLabel
			text.Text = if kind == "Pass" and actions.owned(entry.Key) then "✓ Owned" else `R$ {entry.Price}`
			if entry.Cash then
				description.Text = `${Ui.abbreviate(actions.cash(entry) or 0)} for you\n{entry.Description}`
			end
		end)
	end
	for i, pass in Monetization.Passes do
		offer(passGrid, pass, i, "Pass")
	end
	for i, key in { "ServerLuck", "CashSmall", "CashMedium", "CashBig", "Mount", "ChestRefill", "BloodMoon" } do
		offer(boostGrid, Monetization.ProductByKey[key], i, "Product")
	end
	local function refresh()
		for _, fn in refreshers do
			fn()
		end
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible then
			selectTab("Cases")
			refresh()
		end
	end)
	player.AttributeChanged:Connect(function()
		if frame.Visible then
			refresh()
		end
	end)
	local shop = Theme.button(Ui.Navigation, "Shop", Theme.Green, {
		Name = "StoreButton",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(112, 44),
		MaximumTextSize = 23,
	}, function()
		Ui.Menu.Toggle(frame)
	end, "CaseLegendary")
	local function visibility()
		shop.Visible = not player:GetAttribute("InRound")
	end
	player:GetAttributeChangedSignal("InRound"):Connect(visibility)
	visibility()
	selectTab("Cases")
	return frame
end
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">Transitions</string>
            <string name="Source"><![CDATA[--!strict
-- Two simple on-screen moments, Steal An Egg style:
--  * Zone titles: walking into a zone pops its name up at the top of the screen for a moment
--    (there are no signs in the world), with a red "needs X speed" line if you're too slow for it.
--  * Round fades: the server fires Effect "Fade" just before teleporting you into a round or back
--    home; the screen fades to black with where you're going, then fades back in once you're there.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Format = require(ReplicatedStorage.Shared.Format)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)

local Ui = require(script.Parent.Ui)
local KnifeIcons = require(ReplicatedStorage.Shared.Config.KnifeIcons)
local Transitions = {}

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local ZONE_EMOJI: { [string]: string } = {
	Common = "🌳",
	Rare = "🌸",
	Epic = "💀",
	Legendary = "⚱️",
	Mythic = "🔥",
	Godly = "⚡",
	Celestial = "👼",
	Cosmic = "🪐",
}

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	for key, value in props do
		(text :: any)[key] = value
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 20, 40)
	stroke.Parent = text
	text.Parent = parent
	return text
end

function Transitions.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Transitions"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Zone title ----------------------------------------------------------------------------------
	local banner = Instance.new("Frame")
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.fromScale(0.5, 0.17)
	banner.Size = UDim2.fromScale(0.5, 0.11)
	banner.BackgroundTransparency = 1
	banner.Visible = false
	banner.Parent = Ui.root
	banner.ZIndex = 3
	local title = label(banner, { Size = UDim2.fromScale(1, 0.68) })
	local subtitle = label(banner, {
		Position = UDim2.fromScale(0, 0.68),
		Size = UDim2.fromScale(1, 0.32),
		TextColor3 = Color3.fromRGB(255, 90, 90),
	})
	local bannerToken = 0
	if Ui.Phone then
		local function fitZone()
			local _, bounds = Ui.bounds()
			banner.Position = UDim2.fromScale(0.5, 0)
			banner.Size = UDim2.fromOffset(math.min(380, math.max(220, bounds.X - 300)), 40)
		end
		Ui.Layout.Changed:Connect(fitZone)
		fitZone()
		title.Size = UDim2.new(1, 0, 0, 22)
		subtitle.Position, subtitle.Size = UDim2.fromOffset(0, 22), UDim2.new(1, 0, 0, 18)
		for _, text in { title, subtitle } do
			text.TextScaled, text.TextSize, text.TextTruncate = false, 14, Enum.TextTruncate.AtEnd
		end
	end
	Ui.Menu.Changed:Connect(function()
		if Ui.menuOpen() then
			bannerToken += 1
			banner.Visible = false
			Ui.gui:SetAttribute("ZoneNotice", false)
		end
	end)
	local function showZone(index: number)
		if Ui.menuOpen() then
			return
		end
		local zone = GameConfig.Zones[index] :: any
		title.Text = `{zone.Title or zone.Rarity} {ZONE_EMOJI[zone.Rarity] or ""}`
		title.TextColor3 = zone.Color:Lerp(Color3.new(1, 1, 1), 0.35)
		local need = zone.SpeedNeeded or 0
		local speed = (player:GetAttribute("Speed") or 0) :: number
		subtitle.Text = if need > speed
			then (if Ui.Phone
				then `Needs {Format.Short(need)} speed`
				else `Needs {Format.Short(need)} speed to outrun the boss!`)
			else ""
		bannerToken += 1
		local token = bannerToken
		banner.Visible = true
		for _, text in { title, subtitle } do
			text.TextTransparency = 0
			local stroke = text:FindFirstChildOfClass("UIStroke") :: UIStroke
			stroke.Transparency = 0
		end
		if Ui.Phone then
			Ui.gui:SetAttribute("ZoneNotice", true)
		else
			banner.Position = UDim2.fromScale(0.5, 0.14)
			TweenService
				:Create(banner, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.17) })
				:Play()
		end
		task.delay(1.8, function()
			if token ~= bannerToken then
				return
			end
			for _, text in { title, subtitle } do
				TweenService:Create(text, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
				TweenService:Create(text:FindFirstChildOfClass("UIStroke") :: UIStroke, TweenInfo.new(0.5), {
					Transparency = 1,
				}):Play()
			end
		end)
		task.delay(2.3, function()
			if token == bannerToken then
				banner.Visible = false
				Ui.gui:SetAttribute("ZoneNotice", false)
			end
		end)
	end
	local lastZone = 0
	task.spawn(function()
		while true do
			task.wait(0.25)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local zone = 0
			if root and not player:GetAttribute("InRound") then
				local pos = root.Position
				if math.abs(pos.X) <= GameConfig.ArenaWidth / 2 and pos.Z >= 0 then
					zone = math.clamp(math.floor(pos.Z / GameConfig.ZoneDepth) + 1, 1, #GameConfig.Zones)
				end
			end
			if zone ~= lastZone and zone > 0 then
				showZone(zone)
			end
			lastZone = zone
		end
	end)

	-- Round fade ----------------------------------------------------------------------------------
	local cover = Instance.new("Frame")
	cover.Size = UDim2.fromScale(1, 1)
	cover.BackgroundColor3 = Color3.fromRGB(12, 10, 20)
	cover.BackgroundTransparency = 1
	cover.Visible = false
	cover.ZIndex = 10
	cover.Parent = gui
	local where = label(cover, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.6, 0.1),
		TextTransparency = 1,
		ZIndex = 11,
	})
	-- At-risk reel ---------------------------------------------------------------------------------
	-- At the start of a round a reel of your knives spins and lands on the one the Murderer takes if
	-- they get you; then it shrinks to a reminder in the corner for the rest of the round.
	local riskPanel = Instance.new("Frame")
	riskPanel.AnchorPoint = Vector2.new(0.5, 0)
	riskPanel.Position = UDim2.fromScale(0.5, 0.6)
	riskPanel.Size = UDim2.fromOffset(560, 150)
	riskPanel.BackgroundColor3 = Color3.fromRGB(24, 18, 30)
	riskPanel.BackgroundTransparency = 0.1
	riskPanel.Visible = false
	riskPanel.ZIndex = 20
	riskPanel.Parent = gui
	local riskCorner = Instance.new("UICorner")
	riskCorner.CornerRadius = UDim.new(0, 16)
	riskCorner.Parent = riskPanel
	local riskStroke = Instance.new("UIStroke")
	riskStroke.Thickness = 4
	riskStroke.Color = Color3.fromRGB(255, 80, 90)
	riskStroke.Parent = riskPanel
	label(riskPanel, {
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -20, 0, 30),
		Text = "IF THE MURDERER GETS YOU, THEY TAKE...",
		TextColor3 = Color3.fromRGB(255, 110, 110),
		ZIndex = 21,
	})
	local window = Instance.new("Frame")
	window.Position = UDim2.fromOffset(10, 42)
	window.Size = UDim2.new(1, -20, 0, 70)
	window.BackgroundColor3 = Color3.fromRGB(12, 10, 16)
	window.ClipsDescendants = true
	window.ZIndex = 21
	window.Parent = riskPanel
	local strip = Instance.new("Frame")
	strip.BackgroundTransparency = 1
	strip.Size = UDim2.fromScale(0, 1)
	strip.ZIndex = 22
	strip.Parent = window
	local pointer = Instance.new("Frame")
	pointer.AnchorPoint = Vector2.new(0.5, 0)
	pointer.Position = UDim2.fromScale(0.5, 0)
	pointer.Size = UDim2.new(0, 4, 1, 0)
	pointer.BackgroundColor3 = Color3.fromRGB(255, 220, 60)
	pointer.BorderSizePixel = 0
	pointer.ZIndex = 25
	pointer.Parent = window
	local riskHint = label(riskPanel, {
		Position = UDim2.fromOffset(10, 118),
		Size = UDim2.new(1, -20, 0, 24),
		Text = "",
		TextColor3 = Color3.fromRGB(230, 230, 240),
		ZIndex = 21,
	})
	local badge = label(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.fromOffset(320, 24),
		Text = "",
		Visible = false,
		ZIndex = 3,
	})
	local riskIcon = Ui.new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.fromOffset(-32, 0),
		Visible = false,
		ZIndex = 20,
	}, badge)
	if Ui.Phone then
		badge.Name = "AtRisk"
		badge.Parent = Ui.root
		badge.TextScaled = false
		badge.TextSize = 14
		badge.TextTruncate = Enum.TextTruncate.AtEnd
		badge.BackgroundTransparency = 0.15
		badge.BackgroundColor3 = Ui.PANEL
		Ui.corner(badge, 8)
	end
	local TILE = 150
	local riskToken = 0
	local riskActive = false
	Ui.Menu.Changed:Connect(function()
		badge.Visible = riskActive and player:GetAttribute("InRound") == true and not Ui.menuOpen()
	end)
	Ui.Layout.Changed:Connect(function()
		if Ui.Phone then
			local _, bounds = Ui.bounds()
			badge.Size = UDim2.fromOffset(math.min(320, bounds.X * 0.5), 28)
		end
	end)
	local function tile(item: string, index: number)
		local parsed = Items.Parse(item)
		local frame = Instance.new("Frame")
		frame.Position = UDim2.fromOffset((index - 1) * TILE, 0)
		frame.Size = UDim2.new(0, TILE - 6, 1, 0)
		frame.BackgroundColor3 = Items.Color(item):Lerp(Color3.fromRGB(20, 16, 26), 0.75)
		frame.ZIndex = 22
		frame.Parent = strip
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = frame
		label(frame, {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0.55, 0),
			Text = Items.DisplayName(item),
			TextColor3 = Items.Color(item),
			ZIndex = 23,
		})
		label(frame, {
			Position = UDim2.new(0, 6, 0.6, 0),
			Size = UDim2.new(1, -12, 0.32, 0),
			Text = if parsed then parsed.Knife.Rarity else "",
			TextColor3 = if parsed then Knives.RarityColors[parsed.Knife.Rarity] else Color3.new(1, 1, 1),
			ZIndex = 23,
		})
	end
	local function showRisk(choices: { string }, chosen: string)
		riskActive = true
		riskToken += 1
		local token = riskToken
		if Ui.Phone then
			local parsed = Items.Parse(chosen)
			badge.Text = `At risk: {Items.DisplayName(chosen)}`
			badge.TextColor3 = Items.Color(chosen)
			local _, bounds = Ui.bounds()
			badge.Size = UDim2.fromOffset(math.min(320, bounds.X * 0.5), 28)
			badge.Position = UDim2.new(0.5, 0, 0, 90)
			riskIcon.Image = if parsed then KnifeIcons[parsed.Knife.Name] or "" else ""
			riskIcon.Visible = true
			badge.Visible = player:GetAttribute("InRound") == true and not Ui.menuOpen()
			return
		end
		strip:ClearAllChildren()
		local count = 34
		local landAt = count - 3
		for i = 1, count do
			tile(if i == landAt then chosen else choices[math.random(1, #choices)], i)
		end
		strip.Size = UDim2.new(0, count * TILE, 1, 0)
		strip.Position = UDim2.fromOffset(0, 0)
		riskHint.Text = ""
		badge.Visible = false
		task.wait(1.4) -- after the fade and the role reveal
		if token ~= riskToken or not player:GetAttribute("InRound") then
			return
		end
		riskPanel.Visible = true
		local centre = window.AbsoluteSize.X / 2 - (TILE - 6) / 2
		local target = -((landAt - 1) * TILE) + centre + math.random(-30, 30)
		local spin = TweenService:Create(strip, TweenInfo.new(3.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(target, 0),
		})
		spin:Play()
		spin.Completed:Wait()
		if token ~= riskToken then
			return
		end
		riskHint.Text = `Survive - or shoot the Murderer - to keep your {Items.DisplayName(chosen)}!`
		task.wait(3)
		if token ~= riskToken then
			return
		end
		riskPanel.Visible = false
		if player:GetAttribute("InRound") then
			badge.Text = `⚠ At risk: {Items.DisplayName(chosen)}`
			badge.TextColor3 = Items.Color(chosen)
			badge.Visible = true
		end
	end
	player:GetAttributeChangedSignal("InRound"):Connect(function()
		if not player:GetAttribute("InRound") then
			riskActive = false
			riskToken += 1
			riskPanel.Visible = false
			badge.Visible = false
		end
	end)

	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid") :: Humanoid
		humanoid.Died:Connect(function()
			riskActive = false
			riskToken += 1
			badge.Visible = false
			riskPanel.Visible = false
		end)
	end)
	if player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Died:Connect(function()
				riskActive = false
				riskToken += 1
				badge.Visible = false
				riskPanel.Visible = false
			end)
		end
	end

	-- End-of-round VS card (MM2 style) --------------------------------------------------------------
	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.55)
	card.Size = UDim2.fromOffset(560, 250)
	card.BackgroundColor3 = Color3.fromRGB(24, 18, 30)
	card.BackgroundTransparency = 0.08
	card.Visible = false
	card.ZIndex = 30
	card.Name = "RoundResults"
	card.Parent = Ui.root
	Ui.fitMenu(card, Vector2.new(560, 260))
	Ui.registerMenu(card)
	Ui.button(
		{ Name = "Close", Text = "X", Position = UDim2.new(1, -52, 0, 6), Size = UDim2.fromOffset(44, 44), ZIndex = 33 },
		card,
		function()
			card.Visible = false
		end
	)
	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 16)
	cardCorner.Parent = card
	local cardStroke = Instance.new("UIStroke")
	cardStroke.Thickness = 2
	cardStroke.Parent = card
	local cardTitle = label(card, {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -80, 0, 38),
		ZIndex = 31,
	})
	label(card, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(70, 50),
		Text = "VS",
		ZIndex = 31,
	})
	local function side(x: number, role: string, color: Color3)
		local holder = Instance.new("Frame")
		holder.Position = UDim2.fromOffset(x, 54)
		holder.Size = UDim2.fromOffset(220, 186)
		holder.BackgroundColor3 = Color3.fromRGB(40, 32, 50)
		holder.ZIndex = 31
		holder.Parent = card
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = holder
		label(holder, {
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.new(1, -12, 0, 26),
			Text = role,
			TextColor3 = color,
			ZIndex = 32,
		})
		local photo = Instance.new("ImageLabel")
		photo.AnchorPoint = Vector2.new(0.5, 0)
		photo.Position = UDim2.new(0.5, 0, 0, 34)
		photo.Size = UDim2.fromOffset(96, 96)
		photo.BackgroundColor3 = Color3.fromRGB(60, 50, 70)
		photo.ZIndex = 32
		photo.Parent = holder
		local photoCorner = Instance.new("UICorner")
		photoCorner.CornerRadius = UDim.new(0.5, 0)
		photoCorner.Parent = photo
		local name = label(holder, {
			Position = UDim2.fromOffset(6, 134),
			Size = UDim2.new(1, -12, 0, 24),
			ZIndex = 32,
		})
		local detail = label(holder, {
			Position = UDim2.fromOffset(6, 158),
			Size = UDim2.new(1, -12, 0, 20),
			TextColor3 = Color3.fromRGB(220, 220, 230),
			ZIndex = 32,
		})
		return photo, name, detail
	end
	local mPhoto, mName, mDetail = side(14, "MURDERER", Color3.fromRGB(255, 70, 80))
	local hPhoto, hName, hDetail = side(326, "SHERIFF", Color3.fromRGB(90, 170, 255))
	local cardToken = 0
	local function setPhoto(image: ImageLabel, userId: number, face: any?)
		image.Image = ""
		image.BackgroundColor3 = Color3.fromRGB(60, 50, 70)
		-- A bot: its disguise's face drawn on its skin colour
		if userId <= 0 and type(face) == "table" then
			image.BackgroundColor3 = if typeof(face.Skin) == "Color3" then face.Skin else Color3.fromRGB(230, 190, 150)
			image.Image = if type(face.Face) == "string" then face.Face else ""
			return
		end
		if userId > 0 then
			task.spawn(function()
				local ok, url = pcall(
					Players.GetUserThumbnailAsync,
					Players,
					userId,
					Enum.ThumbnailType.HeadShot,
					Enum.ThumbnailSize.Size150x150
				)
				if ok then
					image.Image = url
				end
			end)
		end
	end
	local function showCard(info: { [string]: any })
		cardToken += 1
		local token = cardToken
		local murdererWon = info.Won == "Murderer"
		cardTitle.Text = (if info.Classic then "CLASSIC · " else "") .. tostring(info.Title or "")
		cardTitle.TextColor3 = if murdererWon then Color3.fromRGB(255, 80, 90) else Color3.fromRGB(110, 200, 255)
		cardStroke.Color = cardTitle.TextColor3
		mName.Text = tostring(info.MurdererName or "?")
		local knife = if type(info.Knife) == "string" then info.Knife else ""
		mDetail.Text = `{if knife ~= "" then Items.DisplayName(knife) else "Knife"} · {info.Kills or 0} kills`
		mDetail.TextColor3 = if knife ~= "" then Items.Color(knife) else Color3.new(1, 1, 1)
		setPhoto(mPhoto, tonumber(info.MurdererId) or 0, info.MurdererFace)
		if info.HeroName then
			hName.Text = tostring(info.HeroName)
			hDetail.Text = "Revolver · shot the Murderer!"
		else
			hName.Text = if murdererWon then "Nobody stopped them" else "Survived!"
			hDetail.Text = if murdererWon then "" else "The innocents made it"
		end
		setPhoto(hPhoto, tonumber(info.HeroId) or 0, info.HeroFace)
		card.Visible = true
		local scale = card:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		scale.Parent = card
		scale.Scale = 0.7
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		task.delay(6, function()
			if token == cardToken then
				card.Visible = false
			end
		end)
	end

	local fadeToken = 0
	Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind: string, text: any, extra: any)
		if kind == "RoundCard" then
			if type(text) == "table" then
				showCard(text)
			end
			return
		end
		if kind == "AtRisk" then
			if type(text) == "table" and type(extra) == "string" and #text > 0 then
				task.spawn(showRisk, text, extra)
			end
			return
		end
		if kind ~= "Fade" then
			return
		end
		fadeToken += 1
		local token = fadeToken
		local wasInRound = player:GetAttribute("InRound") == true
		cover.Visible = true
		where.Text = if type(text) == "string" then text else ""
		local stroke = where:FindFirstChildOfClass("UIStroke") :: UIStroke
		TweenService:Create(cover, TweenInfo.new(0.3), { BackgroundTransparency = 0 }):Play()
		TweenService:Create(where, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 0 }):Play()
		-- Hold until we've actually moved (InRound flips), then a beat for the camera and streaming
		local start = os.clock()
		while
			token == fadeToken
			and (player:GetAttribute("InRound") == true) == wasInRound
			and os.clock() - start < 6
		do
			task.wait()
		end
		task.wait(0.6)
		if token ~= fadeToken then
			return
		end
		TweenService:Create(cover, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(where, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()
		task.delay(0.65, function()
			if token == fadeToken then
				cover.Visible = false
			end
		end)
	end)
end

return Transitions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">Tumble</string>
            <string name="Source"><![CDATA[--!strict
-- The fling half of a Steal An Egg-style hit (server Ragdoll.Tumble goes limp and sets these):
-- player attribute TumblePush (Vector3) = the launch velocity, Tumbling = when it ends. This client
-- owns its character's physics, so the throw is applied here: smooth on every screen.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Tumble = {}

function Tumble.Init()
	player:GetAttributeChangedSignal("Tumbling"):Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not humanoid or not root then
			return
		end
		if player:GetAttribute("Tumbling") then
			local push = player:GetAttribute("TumblePush")
			-- Physics state: the walk controller lets go of the body, so the push isn't eaten
			humanoid.PlatformStand = true
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			if typeof(push) == "Vector3" then
				local spin = Vector3.new(math.random(-6, 6), math.random(-3, 3), math.random(-6, 6))
				-- Held for a few frames so nothing (landing, the controller waking up) cancels it
				-- Every limb gets the push (they're loose pieces while limp, and would drag the rest back)
				local parts: { BasePart } = {}
				for _, d in character:GetDescendants() do
					if d:IsA("BasePart") and not d.Anchored then
						table.insert(parts, d)
					end
				end
				for _ = 1, 4 do
					if not player:GetAttribute("Tumbling") then
						break
					end
					for _, part in parts do
						part.AssemblyLinearVelocity = push
					end
					root.AssemblyAngularVelocity = spin
					RunService.Heartbeat:Wait()
				end
			end
		else
			-- Back on your feet
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

return Tumble
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!strict
-- The first minute, for new players: a glowing trail from you to where you need to go, a bouncing
-- arrow over it, and one short instruction at a time. Steps advance on their own as you do them:
--   1. take down a watchman in the Courtyard   2. grab the case it drops
--   3. carry it home, place it on a plate             4. run in your Haunted Wheel
--   5. the Murder Mystery rounds (just read it)       6. your vault gate
-- Finishing (or skipping) tells the server, which pays a small reward once (Rewards).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local new = Ui.new

local Tutorial = {}

type Step = { Text: string, Target: () -> Vector3?, Done: () -> boolean }

local function root(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function nearestGuard(): Vector3?
	local here = root()
	if not here then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, guard in CollectionService:GetTagged("Guard") do
		local r = (guard :: Model).PrimaryPart
		-- Courtyard guards only (the first zone)
		if r and r.Position.Z < 220 and r.Position.Z > 0 then
			local distance = (r.Position - here.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = r.Position, distance
			end
		end
	end
	return best
end

local function myVault(): Model?
	local index = player:GetAttribute("VaultIndex")
	local map = workspace:FindFirstChild("Map")
	local bases = map and map:FindFirstChild("Bases")
	return bases and bases:FindFirstChild(`Base{index}`) :: Model?
end

local function vaultDoor(): Vector3?
	local vault = myVault()
	local floor = vault and vault:FindFirstChild("Floor") :: BasePart?
	return floor and floor.Position
end

-- Your vault's gate (the barrier rivals break)
local function gate(): Vector3?
	for _, blocker in game:GetService("CollectionService"):GetTagged("VaultGate") do
		if blocker:GetAttribute("Owner") == player.UserId then
			return (blocker :: BasePart).Position
		end
	end
	return nil
end

local function wheel(): Vector3?
	local vault = myVault()
	local plate = vault and vault:FindFirstChild("WheelFloor") :: BasePart?
	return plate and plate.Position
end

function Tutorial.Init()
	if player:GetAttribute("TutorialDone") == true then
		return
	end
	-- Wait for data; returning players skip all of this
	local started = os.clock()
	while player:GetAttribute("DataLoaded") ~= true and os.clock() - started < 20 do
		task.wait(0.5)
	end
	if player:GetAttribute("TutorialDone") == true then
		return
	end

	local carriedOnce = false
	local banked = false
	player:GetAttributeChangedSignal("Carrying"):Connect(function()
		if player:GetAttribute("Carrying") then
			carriedOnce = true
		end
	end)
	-- Banked = a knife actually landed on your wall (getting caught also ends the carry)
	local knivesAtStart = (player:GetAttribute("KnifeCount") or 0) :: number
	player:GetAttributeChangedSignal("KnifeCount"):Connect(function()
		if ((player:GetAttribute("KnifeCount") or 0) :: number) > knivesAtStart then
			banked = true
		end
	end)
	local stepShownAt = os.clock()
	local steps: { Step } = {
		{
			Text = if Ui.Phone
				then "Frank guards knives in the Courtyard. Walk up and hold the Steal prompt on one!"
				else "Frank guards a wall of knives in the Courtyard. Walk up and hold E on one to steal it!",
			Target = nearestGuard,
			Done = function()
				return carriedOnce
			end,
		},
		{
			Text = if Ui.Phone
				then "RUN home before Frank catches you! Then tap Place Knife at the glowing plate."
				else "RUN home before Frank catches you! Then press E on the glowing plate to place it.",
			Target = vaultDoor,
			Done = function()
				return banked
			end,
		},
		{
			Text = "Your knife earns cash every second - walk over its green pad to collect! Now run in your Haunted Wheel to get faster.",
			Target = wheel,
			Done = function()
				return player:GetAttribute("Training") == true
			end,
		},
		{
			-- The other half of the game: no target, it just has to be read (or a round starts)
			Text = "Every few minutes EVERYONE plays Murder Mystery! 🔪 1 Murderer vs everyone. Watch the top timer!",
			Target = function(): Vector3?
				return nil
			end,
			Done = function()
				return os.clock() - stepShownAt > 9 or player:GetAttribute("InRound") == true
			end,
		},
		{
			Text = if Ui.Phone
				then "Rivals can break your gate! Use Repair beside your gate, or buy stronger walls in Upgrades."
				else "Rivals can break your gate and steal knives! Go to it: R repairs it, G upgrades your walls.",
			Target = gate,
			Done = function()
				local at = gate()
				local me = root()
				return at ~= nil and me ~= nil and (me.Position - at).Magnitude < 12
			end,
		},
	}

	-- The banner
	local banner = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 104),
		-- Half the screen at most, so it never covers the side menus on narrow windows
		Size = UDim2.new(0.5, 0, 0, 64),
		BackgroundColor3 = Color3.fromRGB(255, 200, 60),
	}, Ui.gui)
	new("UISizeConstraint", { MaxSize = Vector2.new(640, 100) }, banner)
	Ui.corner(banner, 16)
	Ui.gradient(banner, Color3.fromRGB(255, 220, 90), Color3.fromRGB(230, 150, 30))
	new("UIStroke", { Thickness = 4, Color = Color3.fromRGB(20, 16, 28) }, banner)
	local stepLabel = Ui.label({
		Size = UDim2.new(1, -120, 1, -10),
		Position = UDim2.fromOffset(12, 5),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}, banner)
	Ui.textStroke(stepLabel, 2.5)
	local skip = Ui.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(90, 44),
		BackgroundColor3 = Color3.fromRGB(90, 90, 110),
		Text = "Skip",
	}, banner)
	stepLabel.TextScaled, stepLabel.TextSize, stepLabel.TextWrapped = false, 14, true
	local function layout()
		local _, bounds = Ui.bounds()
		banner.Size = UDim2.fromOffset(math.min(540, math.max(260, bounds.X - 280)), 80)
		banner.Position = UDim2.new(0.5, 0, 0, 104)
	end
	Ui.Layout.Changed:Connect(layout)
	layout()

	-- The trail: a beam from you to the target, and an arrow bouncing over it
	local targetPart = new("Part", {
		Name = "TutorialTarget",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.one * 0.2,
	}, workspace)
	local targetAttachment = new("Attachment", {}, targetPart)
	local beam = new("Beam", {
		Attachment1 = targetAttachment,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 90)),
		LightEmission = 1,
		Width0 = 1.2,
		Width1 = 1.2,
		FaceCamera = true,
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		TextureMode = Enum.TextureMode.Wrap,
		TextureLength = 3,
		TextureSpeed = 2,
		Transparency = NumberSequence.new(0.2),
		Segments = 20,
		CurveSize0 = 6,
	}, targetPart)
	local arrowGui = new("BillboardGui", {
		Size = UDim2.fromOffset(80, 80),
		StudsOffsetWorldSpace = Vector3.new(0, 7, 0),
		AlwaysOnTop = true,
		Adornee = targetPart,
	}, targetPart)
	local arrow =
		Ui.label({ Size = UDim2.fromScale(1, 1), Text = "⬇", TextColor3 = Color3.fromRGB(255, 220, 80) }, arrowGui)
	Ui.textStroke(arrow, 4)

	local current = 1
	local finished = false
	local function finish(skipped: boolean)
		if finished then
			return
		end
		finished = true
		Remotes.Tutorial:FireServer(if skipped then "Skip" else "Done")
		targetPart:Destroy()
		if skipped then
			banner:Destroy()
			return
		end
		stepLabel.Text = "You've got it! Steal knives, defend your vault, survive the Murderer. Good luck!"
		Effects.Sound(Sounds.Reveal, nil, 0.7)
		task.delay(4, function()
			TweenService:Create(banner, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
			task.wait(0.5)
			banner:Destroy()
		end)
	end
	skip.Activated:Connect(function()
		finish(true)
	end)

	local function showStep()
		stepShownAt = os.clock()
		local compact = {
			"Hold Steal on a Courtyard knife.",
			"Run home and use Place Knife.",
			"Collect cash, then run in your wheel.",
			"Watch the Murder Round timer!",
			"Use Repair or buy stronger walls.",
		}
		stepLabel.Text =
			`{current}/{#steps}  {if Ui.Layout.get().Compact then compact[current] else steps[current].Text}`
		local scale = banner:FindFirstChildOfClass("UIScale") or new("UIScale", {}, banner)
		scale.Scale = 1.1
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	showStep()

	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		if finished then
			connection:Disconnect()
			return
		end
		-- Hide during rounds
		banner.Visible = not player:GetAttribute("InRound") and not Ui.menuOpen()
		local step = steps[current]
		if step.Done() then
			Effects.Sound(Sounds.Coin, nil, 0.6)
			current += 1
			if current > #steps then
				finish(false)
				return
			end
			showStep()
			return
		end
		local here = root()
		local target = step.Target()
		local show = here ~= nil and target ~= nil and not player:GetAttribute("InRound")
		beam.Enabled = show
		arrowGui.Enabled = show
		if show and here and target then
			targetPart.Position = target
			local attachment = here:FindFirstChild("TutorialAttachment") :: Attachment?
			if not attachment then
				attachment =
					new("Attachment", { Name = "TutorialAttachment", Position = Vector3.new(0, -2.5, 0) }, here)
			end
			beam.Attachment0 = attachment
			arrowGui.StudsOffsetWorldSpace = Vector3.new(0, 7 + math.sin(os.clock() * 5) * 1, 0)
		end
	end)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[--!strict
-- Small UI toolkit shared by the client modules: one ScreenGui, instance helper, and the house
-- style (FredokaOne, rounded corners, thick dark outlines).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Layout = require(script.Parent.Layout)
local MenuController = require(script.Parent.MenuController)

local Format = require(ReplicatedStorage.Shared.Format)
local Artwork = require(ReplicatedStorage.Shared.Config.UiArtwork)
local KnifeIcons = require(ReplicatedStorage.Shared.Config.KnifeIcons)

local Ui = { gui = nil :: any, root = nil :: any, Navigation = nil :: any }

-- Phones (and tablets): touch with no keyboard. They get a compact layout that keeps clear of the
-- thumbstick (bottom left) and jump button (bottom right). In Studio, ReplicatedStorage attribute
-- DebugPhone = true previews it on desktop (with ghosts of where the touch controls would be).
Ui.Phone = UserInputService.TouchEnabled
	or (RunService:IsStudio() and ReplicatedStorage:GetAttribute("DebugPhone") == true)

-- Turn a Ui.chunky button into a square icon-only one (phones: no room for the words)
function Ui.iconOnly(button: GuiObject)
	local label = button:FindFirstChild("Label")
	if label and label:IsA("GuiObject") then
		label.Visible = false
	end
	for _, child in button:GetChildren() do
		if child:IsA("TextLabel") and child.Name ~= "Label" and child.Name ~= "Badge" then
			-- the icon: centre it
			child.AnchorPoint = Vector2.new(0.5, 0.5)
			child.Position = UDim2.fromScale(0.5, 0.5)
		end
	end
end

Ui.FONT = Enum.Font.FredokaOne
Ui.WHITE = Color3.new(1, 1, 1)
Ui.PANEL = Color3.fromRGB(24, 35, 57)
Ui.SPOOKY = Enum.Font.FredokaOne -- big dramatic text (role reveal, results)
Ui.OUTLINE = Color3.fromRGB(30, 30, 40)

function Ui.new(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = if parent == Ui.gui and Ui.root then Ui.root else parent
	return instance
end

function Ui.art(parent: Instance, name: string, props: { [string]: any }?): ImageLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Image = KnifeIcons[name] or Artwork[name] or "",
		ScaleType = Enum.ScaleType.Fit,
	}
	for key, value in (props or {}) :: { [string]: any } do
		defaults[key] = value
	end
	local image: ImageLabel = Ui.new("ImageLabel", defaults, parent)
	if KnifeIcons[name] then
		task.delay(8, function()
			if image.Parent and not image.IsLoaded then
				image.Image = Artwork[name] or KnifeIcons[name]
			end
		end)
	end
	return image
end

function Ui.corner(parent: Instance, radius: number)
	Ui.new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

function Ui.stroke(parent: Instance, thickness: number?)
	Ui.new("UIStroke", {
		Thickness = math.min(thickness or 2, 2),
		Color = Ui.OUTLINE,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function Ui.padding(parent: Instance, x: number, y: number?)
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
	}, parent)
end

function Ui.label(props: { [string]: any }, parent: Instance?): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Ui.FONT,
		TextScaled = true,
		TextColor3 = Ui.WHITE,
	}
	for key, value in props do
		defaults[key] = value
	end
	local label: TextLabel = Ui.new("TextLabel", defaults, parent)
	if label.TextScaled then
		Ui.new("UITextSizeConstraint", { MinTextSize = 14, MaxTextSize = 28 }, label)
	end
	return label
end

-- Chunky rounded button with an outline; `onClick` fires for mouse, touch and gamepad select
function Ui.button(props: { [string]: any }, parent: Instance?, onClick: (() -> ())?): TextButton
	local defaults: { [string]: any } = {
		AutoButtonColor = true,
		Font = Ui.FONT,
		TextScaled = true,
		TextColor3 = Ui.WHITE,
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
	}
	for key, value in props do
		defaults[key] = value
	end
	local button: TextButton = Ui.new("TextButton", defaults, parent)
	Ui.corner(button, 12)
	Ui.stroke(button)
	Ui.padding(button, 8, 4)
	Ui.new("UITextSizeConstraint", { MaxTextSize = 26 }, button)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Thick dark outline around text (the chunky Steal-An-Egg look)
function Ui.textStroke(label: TextLabel | TextButton, thickness: number?, color: Color3?)
	Ui.new("UIStroke", {
		Thickness = math.min(thickness or 2, 2),
		Color = color or Color3.fromRGB(20, 16, 28),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	}, label)
end

-- Top-to-bottom gradient from a colour to a darker version of it
function Ui.gradient(parent: GuiObject, top: Color3, bottom: Color3?)
	Ui.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(top, bottom or top:Lerp(Color3.new(0, 0, 0), 0.35)),
	}, parent)
end

-- A big menu button: icon + label, gradient body, dark outline, little bounce when pressed.
-- `badge` (optional) is a red bubble in the corner for things to collect.
function Ui.chunky(
	props: { [string]: any },
	parent: Instance?,
	icon: string?,
	onClick: (() -> ())?
): (TextButton, TextLabel?)
	local color = props.BackgroundColor3 or Color3.fromRGB(80, 200, 90)
	local text = props.Text or ""
	props.Text = ""
	props.BackgroundColor3 = Color3.new(1, 1, 1)
	props.AutoButtonColor = false
	local button: TextButton = Ui.new("TextButton", props, parent)
	Ui.corner(button, 12)
	Ui.new("UIStroke", {
		Thickness = 2,
		Color = Color3.fromRGB(20, 16, 28),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, button)
	Ui.gradient(button, color:Lerp(Color3.new(1, 1, 1), 0.15), color:Lerp(Color3.new(0, 0, 0), 0.25))
	-- Glossy top strip
	local shine = Ui.new("Frame", {
		Size = UDim2.new(1, -10, 0.38, 0),
		Position = UDim2.fromOffset(5, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		ZIndex = (button.ZIndex or 1) + 1,
	}, button)
	Ui.corner(shine, 8)
	local iconLabel: TextLabel? = nil
	local hasIcon = icon ~= nil and icon ~= ""
	if hasIcon then
		local symbol = ({
			["📖"] = "Index",
			["☰"] = "More",
			["⬆️"] = "Upgrades",
			["♻️"] = "Rebirth",
			["💎"] = "CaseLegendary",
			["🔪"] = "RustyShank",
			["💰"] = "Cash",
			["👑"] = "VIP",
			["❤️"] = "Health",
		})[icon :: string]
		iconLabel = Ui.label({
			Size = UDim2.new(1, -8, 1, -8),
			Position = UDim2.fromOffset(6, 4),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			Text = icon,
			ZIndex = (button.ZIndex or 1) + 2,
		}, button)
		if symbol then
			(iconLabel :: TextLabel).Visible = false
			Ui.art(
				button,
				symbol,
				{ Size = UDim2.new(0, 36, 1, -8), Position = UDim2.fromOffset(4, 4), ZIndex = (button.ZIndex or 1) + 2 }
			)
		end
	end
	local label = Ui.label({
		Name = "Label",
		Size = UDim2.new(1, -12, 1, -10),
		Position = UDim2.fromOffset(6, 5),
		Text = text,
		ZIndex = (button.ZIndex or 1) + 2,
	}, button)
	if hasIcon then
		-- leave room for the icon on the left
		Ui.new("UIPadding", { PaddingLeft = UDim.new(0.28, 0) }, label)
	end
	Ui.textStroke(label, 1.5)
	Ui.new("UITextSizeConstraint", { MaxTextSize = 34 }, label)
	local scale = Ui.new("UIScale", {}, button)
	button.MouseEnter:Connect(function()
		scale.Scale = 1.05
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	button.Activated:Connect(function()
		scale.Scale = 0.92
		task.delay(0.08, function()
			scale.Scale = 1
		end)
		if onClick then
			onClick()
		end
	end)
	return button, iconLabel
end

-- A red bubble with a number in a button's corner (hidden at 0)
function Ui.badge(parent: GuiObject): TextLabel
	local badge = Ui.label({
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(230, 40, 50),
		Text = "",
		Visible = false,
		ZIndex = (parent.ZIndex or 1) + 5,
	}, parent)
	Ui.corner(badge, 15)
	Ui.new("UIStroke", { Thickness = 2.5, Color = Color3.new(1, 1, 1) }, badge)
	return badge
end

function Ui.abbreviate(n: number): string
	return Format.Short(n)
end

function Ui.clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- Comma-separated player attributes ("Knives", "Discovered", "Items") as a list
function Ui.list(value: any): { string }
	local out = {}
	if type(value) == "string" and value ~= "" then
		for item in value:gmatch("[^,]+") do
			table.insert(out, item)
		end
	end
	return out
end

local player = Players.LocalPlayer
Ui.gui = Ui.new("ScreenGui", {
	Name = "HUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui")) :: ScreenGui

-- The root uses safe-area pixels; individual components reflow instead of shrinking text.
Ui.root =
	Ui.new("Frame", { Name = "SafeRoot", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, Ui.gui) :: Frame
Ui.Scale = Ui.new("UIScale", { Scale = 1 }, Ui.gui)
Ui.Layout = Layout
Ui.Menu = MenuController
Layout.bind(Ui.root)
player:WaitForChild("PlayerGui").ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
function Ui.bounds(): (Vector2, Vector2)
	return Layout.bounds()
end
function Ui.fitMenu(frame: GuiObject, maximum: Vector2?)
	Layout.fit(frame, maximum)
end

local backdrop = Ui.new("TextButton", {
	Name = "MenuBackdrop",
	Size = UDim2.fromScale(1, 1),
	Text = "",
	BackgroundColor3 = Color3.fromRGB(7, 13, 25),
	BackgroundTransparency = 0.35,
	AutoButtonColor = false,
	Visible = false,
	ZIndex = 4,
	Active = true,
	Selectable = false,
}, Ui.gui)
MenuController.Init(Ui.gui, backdrop)
function Ui.registerMenu(frame: GuiObject)
	MenuController.Register(frame)
end
function Ui.menuOpen(): boolean
	return MenuController.IsOpen()
end
function Ui.hint(keyboard: string, gamepad: string): string
	if UserInputService.PreferredInput == Enum.PreferredInput.Touch or Ui.Phone then
		return ""
	end
	return ` [{if UserInputService.PreferredInput == Enum.PreferredInput.Gamepad then gamepad else keyboard}]`
end
return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Unbox</string>
            <string name="Source"><![CDATA[--!strict
-- Sequential presentation of rewards already granted by StealService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Ui = require(script.Parent.Ui)
local Items = require(ReplicatedStorage.Shared.Items)
local View = require(script.Parent.UnboxView)
local Unbox = {}
local queue: { { Rarity: string, Item: string, Upgraded: boolean, IsNew: boolean } } = {}
local playing = false
local function drain()
	if playing then
		return
	end
	playing = true
	local returnTo = Ui.Menu.Current()
	local character = Players.LocalPlayer.Character
	local phase = ReplicatedStorage:GetAttribute("Phase")
	while #queue > 0 do
		local reward = table.remove(queue, 1)
		if reward then
			View.Play(reward.Rarity, reward.Item, reward.Upgraded, reward.IsNew)
		end
	end
	playing = false
	-- Return to the cash/Robux case menu after all queued reveals finish.
	if
		returnTo
		and returnTo.Parent
		and (returnTo.Name == "Mortimer's Knife Cases" or returnTo.Name == "Store")
		and not Ui.menuOpen()
		and not Players.LocalPlayer:GetAttribute("InRound")
		and Players.LocalPlayer.Character == character
		and ReplicatedStorage:GetAttribute("Phase") == phase
	then
		returnTo.Visible = true
	end
end
function Unbox.Init()
	ReplicatedStorage.Remotes.Effect.OnClientEvent:Connect(function(kind: string, ...)
		if kind ~= "Unbox" then
			return
		end
		local rarity, item, upgraded, isNew = ...
		if type(rarity) ~= "string" or type(item) ~= "string" or not Items.Parse(item) then
			return
		end
		table.insert(queue, { Rarity = rarity, Item = item, Upgraded = upgraded == true, IsNew = isNew == true })
		task.spawn(drain)
	end)
end
return Unbox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">UnboxView</string>
            <string name="Source"><![CDATA[--!strict
-- Server-selected rewards only; the reel is presentation and never rolls a grant.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local Sounds = require(ReplicatedStorage.Shared.Config.Sounds)
local View = {}

function View.Play(rarity: string, item: string, upgraded: boolean, isNew: boolean)
	local parsed = Items.Parse(item)
	if not parsed then
		return
	end
	local color = Items.Color(item)
	local frame = Ui.new("Frame", { Name = "Unbox", BackgroundColor3 = Ui.PANEL, ZIndex = 30 }, Ui.gui)
	Ui.corner(frame, 16)
	Ui.fitMenu(frame, Vector2.new(900, 520))
	Ui.registerMenu(frame)
	local title = Ui.label({
		Text = "Opening " .. rarity .. " Case",
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -84, 0, 44),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
	}, frame)
	local skipped, dismissed = false, false
	local close = Ui.button(
		{
			Name = "Close",
			Text = "Skip",
			Position = UDim2.new(1, -68, 0, 8),
			Size = UDim2.fromOffset(60, 44),
			ZIndex = 32,
		},
		frame,
		function()
			if skipped then
				dismissed = true
			else
				skipped = true
			end
		end
	)
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if not frame.Visible then
			skipped = true
			dismissed = true
		end
	end)
	local scroll = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -24, 1, -76),
		BackgroundTransparency = 1,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ZIndex = 31,
	}, frame)
	local window = Ui.new("Frame", {
		Size = UDim2.new(1, -8, 0, 150),
		ClipsDescendants = true,
		BackgroundColor3 = Color3.fromRGB(14, 23, 41),
		ZIndex = 31,
	}, scroll)
	Ui.corner(window, 12)
	local strip = Ui.new("Frame", {
		Size = UDim2.fromOffset(34 * 130, 144),
		Position = UDim2.fromOffset(window.AbsoluteSize.X / 2 - 60, 3),
		BackgroundTransparency = 1,
		ZIndex = 31,
	}, window)
	local rng = Random.new()
	local pool = Knives.ByRarity[rarity]
	for i = 1, 34 do
		local knife = if i == 29 then parsed.Knife else pool[rng:NextInteger(1, #pool)]
		local tile = Ui.new("Frame", {
			Position = UDim2.fromOffset((i - 1) * 130, 0),
			Size = UDim2.fromOffset(120, 144),
			BackgroundColor3 = Knives.RarityColors[knife.Rarity]:Lerp(Ui.PANEL, 0.7),
			ZIndex = 31,
		}, strip)
		Ui.corner(tile, 10)
		Ui.art(tile, knife.Name, { Size = UDim2.new(1, 0, 0, 90), ZIndex = 31 })
		Ui.label({
			Text = knife.DisplayName,
			Position = UDim2.fromOffset(4, 90),
			Size = UDim2.new(1, -8, 0, 50),
			TextSize = 14,
			TextScaled = false,
			TextWrapped = true,
			ZIndex = 32,
		}, tile)
	end
	Ui.new("Frame", {
		Position = UDim2.new(0.5, -2, 0, 0),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 215, 80),
		ZIndex = 33,
	}, window)
	-- Wait for fitting/layout to resolve before choosing the reel's center.
	RunService.RenderStepped:Wait()
	local startX = window.AbsoluteSize.X / 2 - 60
	strip.Position = UDim2.fromOffset(startX, 3)
	local endX = startX - 28 * 130
	local spin = TweenService:Create(
		strip,
		TweenInfo.new(3.1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(endX, 3) }
	)
	local last = -1
	local tick = RunService.RenderStepped:Connect(function()
		local index = math.floor((startX - strip.Position.X.Offset) / 130)
		if index ~= last then
			last = index
			Effects.Sound(Sounds.Tick, nil, 0.25)
		end
	end)
	spin:Play()
	local started = os.clock()
	while not skipped and spin.PlaybackState == Enum.PlaybackState.Playing and os.clock() - started < 4 do
		task.wait()
	end
	spin:Cancel()
	tick:Disconnect()
	strip.Position = UDim2.fromOffset(endX, 3)
	if not dismissed then
		title.Text = "Case reward"
		close.Text = "X"
		skipped = true
		Effects.Sound(Sounds.Reveal, nil, 0.7)
		local tags = (if isNew then "NEW!  " else "") .. (if upgraded then "RARITY UP!  " else "")
		local text = Ui.label({
			Text = tags
				.. Items.DisplayName(item)
				.. `\n{parsed.Knife.Rarity} · +${Ui.abbreviate(Items.Income(item))}/s · Damage {Items.Damage(item)}\nMutation: {parsed.Mutation.DisplayName} · Size: {parsed.Size.DisplayName}`,
			Position = UDim2.fromOffset(8, 158),
			Size = UDim2.new(1, -24, 0, 100),
			TextScaled = false,
			TextSize = 16,
			TextWrapped = true,
			TextColor3 = color,
			ZIndex = 32,
		}, scroll)
		Ui.textStroke(text, 1)
		local revealed = os.clock()
		while not dismissed and os.clock() - revealed < 2.7 do
			task.wait()
		end
	end
	frame:Destroy()
end
return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">Welcome</string>
            <string name="Source"><![CDATA[--!strict
-- The welcome-back card, shown once when you join (the server sends Remotes.Welcome):
--   * what your vault earned while you were away (already paid)
--   * the 7-day login streak, with today's reward to claim (Remotes.ClaimDaily)
--   * the new-player shield, for people who just started

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("GameConfig"))
local Sounds = require(ReplicatedStorage.Shared.Config:WaitForChild("Sounds"))
local Knives = require(ReplicatedStorage.Shared.Config:WaitForChild("Knives"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local new = Ui.new

local Welcome = {}

type Info = { Offline: number, Away: number, Streak: number, DailyReady: boolean, Shielded: boolean? }

local GOLD = Color3.fromRGB(255, 205, 60)
local RARITY_COLORS: { [string]: Color3 } = Knives.RarityColors

local function rewardText(reward: GameConfig.DailyReward): (string, string, Color3)
	if reward.Kind == "Case" then
		local rarity = reward.Rarity or "Common"
		return "📦", `{rarity} Case`, RARITY_COLORS[rarity] or GOLD
	elseif reward.Kind == "Tickets" then
		return "🎟️", `{reward.Amount or 1} Tickets`, Color3.fromRGB(230, 70, 90)
	end
	return "💰", "Cash", Color3.fromRGB(90, 210, 110)
end

local function awayText(seconds: number): string
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	if hours >= 1 then
		return `{hours}h {minutes}m`
	end
	return `{minutes}m`
end

local function show(info: Info)
	local nothingNew = info.Offline <= 0 and not info.DailyReady and not info.Shielded and info.Away > 0
	if nothingNew then
		return
	end

	local dim = new("Frame", {
		Name = "Welcome",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(30, 26, 23),
		BackgroundTransparency = 1,
		ZIndex = 50,
	}, Ui.gui)
	local card = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 430),
		BackgroundColor3 = Ui.PANEL,
		ZIndex = 51,
	}, dim)
	Ui.corner(card, 18)
	new("UIStroke", { Thickness = 4, Color = Color3.fromRGB(20, 16, 28) }, card)
	Ui.gradient(card, Color3.fromRGB(48, 38, 66), Color3.fromRGB(24, 20, 34))
	local scale = new("UIScale", { Scale = 0.6 }, card)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()

	local title = Ui.label({
		Size = UDim2.new(1, -40, 0, 54),
		Position = UDim2.fromOffset(20, 14),
		Text = if info.Away > 0 then "WELCOME BACK!" else "WELCOME TO BLACKWOOD!",
		Font = Ui.SPOOKY,
		TextColor3 = GOLD,
		ZIndex = 52,
	}, card)
	Ui.textStroke(title, 3)

	local y = 78
	-- First visit: the game in one glance, the same promise as the thumbnail
	if info.Away <= 0 then
		local halves = new("Frame", {
			Size = UDim2.new(1, -40, 0, 64),
			Position = UDim2.fromOffset(20, y),
			BackgroundTransparency = 1,
			ZIndex = 52,
		}, card)
		local function half(x: number, text: string, top: Color3, bottom: Color3)
			local pill = new("Frame", {
				Position = UDim2.fromScale(x, 0),
				Size = UDim2.fromScale(0.44, 1),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 52,
			}, halves)
			Ui.corner(pill, 14)
			Ui.gradient(pill, top, bottom)
			new("UIStroke", { Thickness = 3, Color = Color3.fromRGB(20, 16, 28) }, pill)
			local label = Ui.label({
				Size = UDim2.new(1, -16, 1, -10),
				Position = UDim2.fromOffset(8, 5),
				Text = text,
				ZIndex = 53,
			}, pill)
			Ui.textStroke(label, 3)
		end
		half(0, "🔪 STEAL KNIVES", Color3.fromRGB(255, 220, 80), Color3.fromRGB(235, 150, 30))
		half(0.56, "😈 BECOME THE MURDERER", Color3.fromRGB(255, 80, 80), Color3.fromRGB(180, 20, 30))
		local arrow = Ui.label({
			Position = UDim2.fromScale(0.44, 0),
			Size = UDim2.fromScale(0.12, 1),
			Text = "➜",
			ZIndex = 53,
		}, halves)
		Ui.textStroke(arrow, 3)
		y += 72
		local how = Ui.label({
			Size = UDim2.new(1, -40, 0, 46),
			Position = UDim2.fromOffset(20, y),
			Text = "Every few minutes the WHOLE SERVER plays Murder Mystery: one Murderer, everyone else survives. "
				.. "The knives you steal give you Murderer powers!",
			TextColor3 = Color3.fromRGB(255, 225, 225),
			TextWrapped = true,
			ZIndex = 52,
		}, card)
		Ui.textStroke(how, 2)
		y += 54
	end
	if info.Offline > 0 then
		local earned = Ui.label({
			Size = UDim2.new(1, -40, 0, 34),
			Position = UDim2.fromOffset(20, y),
			Text = `💰 Your vault earned ${Ui.abbreviate(info.Offline)} while you were away ({awayText(info.Away)})`,
			TextColor3 = Color3.fromRGB(140, 240, 150),
			ZIndex = 52,
		}, card)
		Ui.textStroke(earned, 2)
		y += 44
	end
	if info.Shielded then
		local shield = Ui.label({
			Size = UDim2.new(1, -40, 0, 30),
			Position = UDim2.fromOffset(20, y),
			Text = `🛡️ New-player shield: nobody can steal your knives for your first {GameConfig.NewPlayerShield // 60} minutes`,
			TextColor3 = Color3.fromRGB(150, 210, 255),
			ZIndex = 52,
		}, card)
		Ui.textStroke(shield, 2)
		y += 40
	end

	-- The streak: seven days, today's lit up
	local heading = Ui.label({
		Size = UDim2.new(1, -40, 0, 28),
		Position = UDim2.fromOffset(20, y),
		Text = "DAILY STREAK - log in every day, miss one and it starts over",
		TextColor3 = Color3.fromRGB(230, 220, 255),
		ZIndex = 52,
	}, card)
	Ui.textStroke(heading, 2)
	y += 36
	local row = new("Frame", {
		Size = UDim2.new(1, -40, 0, 104),
		Position = UDim2.fromOffset(20, y),
		BackgroundTransparency = 1,
		ZIndex = 52,
	}, card)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
	}, row)
	local today = info.Streak
	for day, reward in GameConfig.Daily do
		local icon, text, color = rewardText(reward)
		local claimed = day < today or (day == today and not info.DailyReady)
		local isToday = day == today
		local tile = new("Frame", {
			Size = UDim2.fromOffset(76, if isToday then 104 else 92),
			BackgroundColor3 = if isToday then color else Color3.fromRGB(40, 34, 54),
			BackgroundTransparency = if claimed and not isToday then 0.4 else 0,
			ZIndex = 53,
		}, row)
		Ui.corner(tile, 10)
		new("UIStroke", { Thickness = if isToday then 3 else 2, Color = if isToday then GOLD else color }, tile)
		local dayLabel = Ui.label({
			Size = UDim2.new(1, -6, 0, 20),
			Position = UDim2.fromOffset(3, 4),
			Text = if claimed then "✓ DAY " .. day else "DAY " .. day,
			ZIndex = 54,
		}, tile)
		Ui.textStroke(dayLabel, 1.5)
		Ui.label({
			Size = UDim2.new(1, 0, 0, 36),
			Position = UDim2.fromOffset(0, 26),
			Text = icon,
			ZIndex = 54,
		}, tile)
		local what = Ui.label({
			Size = UDim2.new(1, -6, 0, 22),
			Position = UDim2.new(0, 3, 1, -28),
			Text = text,
			ZIndex = 54,
		}, tile)
		Ui.textStroke(what, 1.5)
	end
	y += 116

	local function close()
		TweenService:Create(dim, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0.6 }):Play()
		task.delay(0.2, function()
			dim:Destroy()
		end)
	end

	if info.DailyReady then
		local claim: TextButton
		claim = Ui.chunky(
			{
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, y),
				Size = UDim2.fromOffset(300, 60),
				BackgroundColor3 = Color3.fromRGB(80, 200, 90),
				Text = `Claim Day {today}!`,
				ZIndex = 53,
			},
			card,
			"🎁",
			function()
				claim.Active = false
				local ok, result = Remotes:WaitForChild("ClaimDaily"):InvokeServer()
				if ok then
					Effects.Sound(Sounds.Cash, nil, 0.7)
				end
				local _ = result
				close()
			end
		)
	else
		Ui.chunky({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, y),
			Size = UDim2.fromOffset(300, 60),
			BackgroundColor3 = Color3.fromRGB(90, 140, 230),
			Text = "Let's go!",
			ZIndex = 53,
		}, card, "🔪", close)
	end
	local content = new("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 1, -132),
		BackgroundTransparency = 1,
		CanvasSize = UDim2.fromOffset(0, y - 72),
		ScrollBarThickness = 4,
		ZIndex = 52,
	}, card)
	local children = card:GetChildren()
	for _, child in children do
		if child:IsA("GuiObject") and child ~= title and child ~= content then
			if child:IsA("TextButton") then
				child.AnchorPoint = Vector2.new(0.5, 1)
				child.Position, child.Size = UDim2.new(0.5, 0, 1, -8), UDim2.new(1, -40, 0, 44)
			else
				child.Position -= UDim2.fromOffset(0, 72)
				child.Parent = content
			end
		end
	end
	for _, tile in row:GetChildren() do
		if tile:IsA("Frame") then
			tile.Size = UDim2.new(1 / 7, -8, 0, tile.Size.Y.Offset)
		end
	end
	title.Size = UDim2.new(1, -88, 0, 44)
	Ui.button({
		Name = "Close",
		Text = "X",
		Position = UDim2.new(1, -52, 0, 12),
		Size = UDim2.fromOffset(44, 44),
		ZIndex = 55,
	}, card, close)
	Ui.fitMenu(card, Vector2.new(620, y + 76))
	Ui.registerMenu(dim)
	if info.Offline > 0 then
		Effects.Sound(Sounds.Cash, nil, 0.6)
	end
end

function Welcome.Init()
	Remotes:WaitForChild("Welcome").OnClientEvent:Connect(show)
end

return Welcome
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">WorldLabels</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation-only caps; never change adornee, range, prompts or Enabled state.
local CollectionService = game:GetService("CollectionService")
local Ui = require(script.Parent.Ui)
local WorldLabels = {}
local originals: { [BillboardGui]: UDim2 } = {}
local function resize(gui: BillboardGui)
	if not Ui.Phone then
		gui.Size = originals[gui]
		return
	end
	local _, bounds = Ui.bounds()
	local shop = gui:GetAttribute("LabelCategory") == "Shop"
	local width = if shop then math.min(220, bounds.X * 0.28) else 160
	local height = if shop then 42 else 32
	local original = originals[gui]
	gui.Size = UDim2.fromOffset(math.min(width, original.X.Offset), math.min(height, original.Y.Offset))
end
function WorldLabels.Init()
	local function add(instance: Instance)
		if not instance:IsA("BillboardGui") then
			return
		end
		originals[instance] = instance.Size
		resize(instance)
	end
	for _, gui in CollectionService:GetTagged("ResponsiveWorldLabel") do
		add(gui)
	end
	CollectionService:GetInstanceAddedSignal("ResponsiveWorldLabel"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("ResponsiveWorldLabel"):Connect(function(instance)
		if instance:IsA("BillboardGui") then
			originals[instance] = nil
		end
	end)
	Ui.Layout.Changed:Connect(function()
		for gui in originals do
			resize(gui)
		end
	end)
end
return WorldLabels
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
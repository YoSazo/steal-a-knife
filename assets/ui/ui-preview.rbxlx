		Sole = rgb(5, 5, 5),
	},
	Zoe = {
		Style = "Zip",
		Cloth = rgb(60, 200, 230),
		Accent = rgb(250, 250, 250),
		Shoe = rgb(60, 200, 230),
		Sole = rgb(250, 250, 250),
	},
	Max = {
		Style = "Field",
		Cloth = rgb(74, 107, 58),
		Accent = rgb(160, 138, 94),
		Shoe = rgb(58, 42, 24),
		Sole = rgb(20, 15, 10),
	},
	Ruby = {
		Style = "Bracelet",
		Cloth = rgb(200, 40, 60),
		Accent = rgb(240, 200, 90),
		Shoe = rgb(20, 20, 22),
		Sole = rgb(10, 10, 10),
	},
	Sam = {
		Style = "Hoodie",
		Cloth = rgb(122, 122, 132),
		Accent = rgb(240, 240, 240),
		Shoe = rgb(240, 240, 240),
		Sole = rgb(42, 42, 50),
	},
	Ivy = {
		Style = "Bow",
		Cloth = rgb(250, 250, 250),
		Accent = rgb(122, 60, 160),
		Shoe = rgb(250, 250, 250),
		Sole = rgb(200, 200, 210),
	},
	Ben = {
		Style = "Sport",
		Cloth = rgb(255, 255, 255),
		Accent = rgb(168, 34, 42),
		Shoe = rgb(240, 240, 240),
		Sole = rgb(170, 176, 188),
	},
	Kate = {
		Style = "Bracelet",
		Cloth = rgb(244, 244, 244),
		Accent = rgb(230, 230, 235),
		Shoe = rgb(25, 25, 28),
		Sole = rgb(240, 240, 240),
	},
}

local function detail(
	folder: Model,
	anchor: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	metal: boolean?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = anchor.CFrame * offset
	p.Color = color
	p.Material = if metal then Enum.Material.Metal else Enum.Material.SmoothPlastic
	p.Reflectance = if metal then 0.04 else 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = p
	weld.Parent = p
	p.Parent = folder
	return p
end

function CharacterDetails.Apply(character: Model, name: string)
	local old = character:FindFirstChild("DisguiseDetails")
	if old then
		old:Destroy()
	end
	local finish = FINISHES[name]
	if not finish then
		return
	end
	local folder = Instance.new("Model")
	folder.Name = "DisguiseDetails"
	folder.Parent = character
	local head = character:FindFirstChild("Head") :: BasePart?
	if head then
		local k = head.Size.Y / 1.2
		for _, side in { -1, 1 } do
			local skin = head.Color
			detail(
				folder,
				head,
				"Ear",
				Vector3.new(0.1, 0.25, 0.22) * k,
				CFrame.new(side * head.Size.X * 0.48, -0.04 * k, 0),
				skin
			)
			detail(
				folder,
				head,
				"EarInset",
				Vector3.new(0.025, 0.13, 0.11) * k,
				CFrame.new(side * (head.Size.X * 0.48 + 0.054 * k), -0.04 * k, -0.01 * k),
				skin:Lerp(rgb(155, 89, 72), 0.18)
			)
		end
	end
	local torso = character:FindFirstChild("UpperTorso") :: BasePart?
	if torso then
		local front = -torso.Size.Z / 2 - 0.028
		local w, h = torso.Size.X, torso.Size.Y
		local function chest(
			label: string,
			x: number,
			y: number,
			width: number,
			height: number,
			color: Color3,
			metal: boolean?
		)
			detail(
				folder,
				torso,
				label,
				Vector3.new(width, height, 0.045),
				CFrame.new(x * w, y * h, front),
				color,
				metal
			)
		end
		if finish.Style == "Zip" then
			chest("ZipTrack", 0, -0.03, 0.035, h * 0.79, finish.Accent)
			chest("ZipPull", 0.025, 0.27, 0.07, 0.12, finish.Accent, true)
		elseif finish.Style == "Buttons" or finish.Style == "Jacket" or finish.Style == "Suit" then
			for i = 1, 3 do
				chest(
					"SquareButton",
					if finish.Style == "Jacket" then -0.22 else 0,
					0.12 - i * 0.17,
					0.06,
					0.06,
					finish.Accent,
					true
				)
			end
			if finish.Style ~= "Buttons" then
				for _, side in { -1, 1 } do
					chest("LapelTop", side * 0.2, 0.3, w * 0.11, h * 0.15, finish.Cloth:Lerp(rgb(255, 255, 255), 0.12))
					chest(
						"LapelStep",
						side * 0.17,
						0.18,
						w * 0.075,
						h * 0.09,
						finish.Cloth:Lerp(rgb(255, 255, 255), 0.08)
					)
				end
			end
		elseif finish.Style == "Hoodie" then
			for _, side in { -1, 1 } do
				chest("Drawstring", side * 0.12, 0.23, 0.035, h * 0.22, finish.Accent)
				chest("DrawstringTip", side * 0.12, 0.1, 0.055, 0.075, finish.Accent, true)
			end
		elseif finish.Style == "Bow" then
			chest("BowKnot", 0, 0.35, 0.12, 0.12, finish.Accent:Lerp(rgb(25, 20, 40), 0.2))
			for _, side in { -1, 1 } do
				chest("BowWing", side * 0.065, 0.35, 0.14, 0.18, finish.Accent)
			end
		elseif finish.Style == "Field" then
			for _, side in { -1, 1 } do
				chest("PocketFlap", side * 0.23, 0.06, w * 0.22, 0.1, finish.Cloth:Lerp(rgb(255, 255, 255), 0.08))
				chest("PocketSnap", side * 0.23, 0.02, 0.045, 0.045, finish.Accent, true)
			end
		end
	end
	for _, side in { "Left", "Right" } do
		local hand = character:FindFirstChild(side .. "Hand") :: BasePart?
		if hand then
			-- A few low-relief squares imply knuckles without changing the mitten silhouette or grip.
			for index = -1, 1 do
				detail(
					folder,
					hand,
					"Knuckle",
					Vector3.new(0.07, 0.07, 0.035),
					CFrame.new(index * hand.Size.X * 0.2, -hand.Size.Y * 0.15, -hand.Size.Z / 2 - 0.012),
					hand.Color
				)
			end
		end
		local arm = character:FindFirstChild(side .. "LowerArm") :: BasePart?
		if arm and finish.Style == "Bracelet" then
			local y = -arm.Size.Y * 0.3
			detail(
				folder,
				arm,
				"Wristband",
				Vector3.new(arm.Size.X + 0.025, 0.12, arm.Size.Z + 0.025),
				CFrame.new(0, y, 0),
				rgb(25, 25, 28)
			)
			for index = -1, 1 do
				detail(
					folder,
					arm,
					"WristStud",
					Vector3.new(0.055, 0.055, 0.045),
					CFrame.new(index * arm.Size.X * 0.22, y, -arm.Size.Z / 2 - 0.03),
					finish.Accent,
					true
				)
			end
		end
		local foot = character:FindFirstChild(side .. "Foot") :: BasePart?
		if foot then
			detail(
				folder,
				foot,
				"ToeTrim",
				Vector3.new(foot.Size.X * 0.86, 0.09, 0.045),
				CFrame.new(0, -foot.Size.Y * 0.06, -foot.Size.Z / 2 - 0.018),
				finish.Shoe
			)
			detail(
				folder,
				foot,
				"SoleEdge",
				Vector3.new(foot.Size.X + 0.025, 0.07, foot.Size.Z + 0.025),
				CFrame.new(0, -foot.Size.Y * 0.35, 0),
				finish.Sole
			)
			detail(
				folder,
				foot,
				"HeelTab",
				Vector3.new(foot.Size.X * 0.38, 0.09, 0.04),
				CFrame.new(0, foot.Size.Y * 0.12, foot.Size.Z / 2 + 0.018),
				finish.Accent
			)
			if finish.Style ~= "Suit" then
				for i = 1, 2 do
					detail(
						folder,
						foot,
						"Lace",
						Vector3.new(foot.Size.X * 0.52, 0.035, 0.055),
						CFrame.new(0, foot.Size.Y / 2 + 0.012, -foot.Size.Z * (0.12 + i * 0.12)),
						finish.Sole:Lerp(rgb(255, 255, 255), 0.65)
					)
				end
			end
		end
	end
end

return CharacterDetails
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CharacterFaces</string>
            <string name="Source"><![CDATA[--!strict
-- Dynamic heads have a baked face and incompatible decal UVs. Disguises use a texture-free
-- classic head while retaining the original rig's dimensions, attachments and neck joints.
local CharacterFaces = {}

function CharacterFaces.Apply(head: BasePart, texture: string): BasePart
	local character = head.Parent
	assert(character, "A character face needs a parented head")
	if head:IsA("MeshPart") then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local requiresNeck = humanoid and humanoid.RequiresNeck
		if humanoid then
			humanoid.RequiresNeck = false
		end
		local classic = Instance.new("Part")
		classic.Name = "Head"
		classic.Size = head.Size
		classic.CFrame = head.CFrame
		classic.Color = head.Color
		classic.Material = Enum.Material.SmoothPlastic
		classic.Transparency = head.Transparency
		classic.Anchored = head.Anchored
		classic.CanCollide = head.CanCollide
		classic.CanQuery = head.CanQuery
		classic.CanTouch = head.CanTouch
		classic.Massless = head.Massless
		classic.CollisionGroup = head.CollisionGroup
		classic.CustomPhysicalProperties = head.CustomPhysicalProperties
		classic.CastShadow = head.CastShadow
		classic.TopSurface = Enum.SurfaceType.Smooth
		classic.BottomSurface = Enum.SurfaceType.Smooth
		for name, value in head:GetAttributes() do
			classic:SetAttribute(name, value)
		end
		for _, tag in head:GetTags() do
			classic:AddTag(tag)
		end
		-- Attachment references remain intact for both AnimationConstraints and ragdoll sockets.
		for _, child in head:GetChildren() do
			if
				child:IsA("Decal")
				or child:IsA("Texture")
				or child:IsA("SurfaceAppearance")
				or child:IsA("FaceControls")
				or child:IsA("WrapTarget")
				or child:IsA("DataModelMesh")
			then
				child:Destroy()
			else
				child.Parent = classic
			end
		end
		local mesh = Instance.new("SpecialMesh")
		mesh.Name = "ClassicHeadMesh"
		mesh.MeshType = Enum.MeshType.Head
		mesh.Parent = classic
		classic.Parent = character
		for _, joint in character:GetDescendants() do
			-- Separate branches keep Roblox's writable joint types narrowed in strict Luau.
			-- selene: allow(if_same_then_else)
			if joint:IsA("JointInstance") then
				if joint.Part0 == head then
					joint.Part0 = classic
				end
				if joint.Part1 == head then
					joint.Part1 = classic
				end
			elseif joint:IsA("WeldConstraint") then
				if joint.Part0 == head then
					joint.Part0 = classic
				end
				if joint.Part1 == head then
					joint.Part1 = classic
				end
			elseif joint:IsA("NoCollisionConstraint") then
				if joint.Part0 == head then
					joint.Part0 = classic
				end
				if joint.Part1 == head then
					joint.Part1 = classic
				end
			elseif joint:IsA("BillboardGui") and joint.Adornee == head then
				joint.Adornee = classic
			end
		end
		if character:IsA("Model") and character.PrimaryPart == head then
			character.PrimaryPart = classic
		end
		head:Destroy()
		head = classic
		if humanoid then
			humanoid.RequiresNeck = requiresNeck == true
		end
	end
	-- Reapplying an expression must never leave a second face underneath it.
	for _, child in head:GetChildren() do
		if child:IsA("Decal") or child:IsA("Texture") then
			child:Destroy()
		elseif child:IsA("SpecialMesh") then
			child.TextureId = ""
		end
	end
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = texture
	face.Color3 = Color3.new(1, 1, 1)
	face.Parent = head
	head:SetAttribute("ClassicCharacterFace", true)
	return head
end

return CharacterFaces
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
-- Fighting in the hub. Everyone carries their equipped knife (or the free Rusty Shank) as a Tool:
-- click to swing (stab / slash combo), hold right-click / Q / LT / the Throw button to crank back
-- and release to throw - MM2 style. Clients animate instantly; damage lands on the clip's Impact
-- frame and thrown knives leave the hand on its Release frame. Guards take damage; so do whatever
-- RaidService registers in Targets (vault gates, burglars, and players - who only get knocked down,
-- never hurt). All hits are decided here from Tool.Activated and Remotes.Ability.
-- Also owns deaths: every character goes limp with a death cry and collapses (Mad Murderer style).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnimLibrary = require(ReplicatedStorage.Shared.AnimLibrary)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Net = require(script.Parent.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GuardService = require(script.Parent.GuardService)
local Ragdoll = require(script.Parent.Ragdoll)
local Targets = require(script.Parent.Targets)
local StuckKnives = require(script.Parent.StuckKnives)

local CombatService = {}

local HUB_KNIFE = "HubKnife" -- attribute marking the hub weapon so rounds can take it away
local lastSwing: { [Player]: number } = {}
local combo: { [Player]: number } = {}
local COMBO_CLIPS = { "Stab", "Slash" }
local COMBO_RESET = 1.2 -- seconds without swinging before the combo starts over
local throwReadyAt: { [Player]: number } = {}

type Flying = {
	Model: Model,
	Owner: Player,
	Position: Vector3,
	Direction: Vector3,
	Traveled: number,
	Speed: number,
	Damage: number,
}
local flying: { Flying } = {}
local flyingFolder: Folder

-- The knife you fight with: the equipped one if you still own it, else your best, else the starter
function CombatService.WieldedKnife(player: Player): string
	local profile = DataService.Get(player)
	if not profile then
		return GameConfig.StarterKnife
	end
	if profile.Equipped ~= "" and table.find(profile.Knives, profile.Equipped) then
		return profile.Equipped
	end
	local best, bestDamage = GameConfig.StarterKnife, -1
	for _, item in profile.Knives do
		local damage = Items.Damage(item)
		if damage > bestDamage then
			best, bestDamage = item, damage
		end
	end
	return best
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function currentTool(player: Player): Tool?
	local containers: { Instance? } = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for _, container in containers do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute(HUB_KNIFE) then
					return child
				end
			end
		end
	end
	return nil
end

-- Which clip a swing plays: alternates Stab, Slash, Stab... (the client predicts the same order)
function CombatService.NextSwing(player: Player): string
	local now = os.clock()
	local index = if now - (lastSwing[player] or 0) > COMBO_RESET then 1 else (combo[player] or 0) % #COMBO_CLIPS + 1
	combo[player] = index
	return COMBO_CLIPS[index]
end

local function swing(player: Player, tool: Tool)
	local now = os.clock()
	if now - (lastSwing[player] or 0) < GameConfig.SwingCooldown or player:GetAttribute("InRound") then
		return
	end
	local character = player.Character
	if not character or not rootOf(player) then
		return
	end
	local clipName = CombatService.NextSwing(player)
	lastSwing[player] = now
	local clip = AnimLibrary.Clips[clipName]
	Net.Animate(character, clipName, player)
	-- The blade connects partway through the swing; check reach at that moment
	task.delay(clip.Impact or 0.15, function()
		local root = rootOf(player)
		if not root or tool.Parent ~= character then
			return
		end
		Net.Remotes.Effect:FireAllClients("Swing", root.Position)
		local damage = Items.Damage(tool:GetAttribute(HUB_KNIFE) :: string)
		local guard = GuardService.InReach(root.Position, root.CFrame.LookVector, GameConfig.SwingRange)
		if guard then
			GuardService.Damage(guard, damage, player)
			return
		end
		local target = Targets.InReach(player, root.Position, root.CFrame.LookVector, GameConfig.SwingRange)
		if target then
			target.Hit(player, damage, "Swing", root.Position)
		end
	end)
end

-- Gives (or refreshes) the hub knife; nothing while in a round
function CombatService.Arm(player: Player, equip: boolean?)
	local character = player.Character
	-- Not in rounds, and not while both hands hold a stolen knife over your head
	if not character or player:GetAttribute("InRound") or player:GetAttribute("Carrying") then
		return
	end
	local name = CombatService.WieldedKnife(player)
	local existing = currentTool(player)
	if existing and existing:GetAttribute(HUB_KNIFE) == name then
		-- Already the right knife: just make sure it's in hand when asked
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if equip and existing.Parent ~= character and humanoid then
			humanoid:EquipTool(existing)
		end
		return
	end
	local wasHeld = existing ~= nil and existing.Parent == character
	if existing then
		existing:Destroy()
	end
	local tool = KnifeModel.BuildTool(name)
	tool:SetAttribute(HUB_KNIFE, name)
	tool.Activated:Connect(function()
		swing(player, tool)
	end)
	local backpack = player:FindFirstChildOfClass("Backpack")
	tool.Parent = if wasHeld or equip then character else backpack
	Net.Remotes.AbilityState:FireClient(player, "Throw Knife", throwReadyAt[player] or 0)
end

function CombatService.Disarm(player: Player)
	local tool = currentTool(player)
	if tool then
		tool:Destroy()
		-- ...and its Throw button goes with it (RoundService hands the Murderer their own later)
		Net.Remotes.AbilityState:FireClient(player, nil)
	end
end

-- Winding up: the character's ChargeStart attribute (server time) drives everyone's view of the
-- crank-back, and how long it was held decides the throw's power
local function onCharge(player: Player, charging: unknown)
	local character = player.Character
	if not character then
		return
	end
	if charging == true and character:FindFirstChildOfClass("Tool") and rootOf(player) then
		if character:GetAttribute("ChargeStart") == nil then
			character:SetAttribute("ChargeStart", workspace:GetServerTimeNow())
			character:SetAttribute("ChargeTime", AnimLibrary.ChargeTime)
		end
	else
		character:SetAttribute("ChargeStart", nil)
	end
end

-- How charged the throw was (0.25 for a quick flick, 1 for fully cranked); clears the charge
function CombatService.TakeCharge(player: Player): number
	local character = player.Character
	local start = character and character:GetAttribute("ChargeStart")
	if character then
		character:SetAttribute("ChargeStart", nil)
	end
	if type(start) ~= "number" then
		return 0.25
	end
	return math.clamp((workspace:GetServerTimeNow() - start) / AnimLibrary.ChargeTime, 0.25, 1)
end

-- Where a thrown knife leaves from: the right hand, or the chest if there isn't one
-- Where a thrown knife leaves from: the throwing hand at shoulder height, just ahead of the body.
-- The server sees players a little in the past, so a sprinting thrower is led by their speed x ping
-- (otherwise the knife would start behind them on their own screen).
function CombatService.HandPosition(player: Player): Vector3?
	local root = rootOf(player)
	if not root then
		return nil
	end
	local from = (root.CFrame * CFrame.new(1, 1.4, -1.6)).Position
	local velocity = root.AssemblyLinearVelocity
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	return from + flat * math.clamp(player:GetNetworkPing() + 0.08, 0.05, 0.35)
end

-- Thrown knives (hub): straight line from the hand, hits the first guard it passes through
local function throw(player: Player, aim: unknown)
	if player:GetAttribute("InRound") then
		return -- rounds have their own abilities (RoundService)
	end
	local now = workspace:GetServerTimeNow()
	local root = rootOf(player)
	local tool = currentTool(player)
	local character = player.Character
	if not root or not tool or not character or now < (throwReadyAt[player] or 0) then
		CombatService.TakeCharge(player)
		return
	end
	local direction = root.CFrame.LookVector
	if typeof(aim) == "Vector3" then
		local v = aim :: Vector3
		if v == v and v.Magnitude > 0.01 and v.Magnitude < 1e4 then
			direction = v.Unit
		end
	end
	local charge = CombatService.TakeCharge(player)
	local config = GameConfig.HubThrow
	throwReadyAt[player] = now + math.max(config.Cooldown, GameConfig.ThrowMinInterval)
	Net.Remotes.AbilityState:FireClient(player, "Throw Knife", throwReadyAt[player])
	Net.Animate(character, "Throw", player)

	local name = tool:GetAttribute(HUB_KNIFE) :: string
	local baseDamage = Items.Damage(name)
	-- The knife leaves the hand on the Release frame of the throw
	task.delay(AnimLibrary.Clips.Throw.Release or 0.07, function()
		local from = CombatService.HandPosition(player)
		if not from then
			return
		end
		local model = KnifeModel.Build(name, true)
		KnifeModel.FitLength(model, 2.6)
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanQuery = false
			elseif d:IsA("Trail") then
				d.Enabled = true -- streak behind it all the way
			end
		end
		model.Parent = flyingFolder
		table.insert(flying, {
			Model = model,
			Owner = player,
			Position = from,
			Direction = direction,
			Traveled = 0,
			Speed = 55 + 60 * charge,
			Damage = math.floor(baseDamage * (1 + (config.DamageMultiplier - 1) * charge)),
		})
		Net.Remotes.Effect:FireAllClients("Dash", from)
	end)
end

local function stepFlying(dt: number)
	local config = GameConfig.HubThrow
	for i = #flying, 1, -1 do
		local f = flying[i]
		local stepLength = f.Speed * dt
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore: { Instance } = { flyingFolder }
		if f.Owner.Character then
			table.insert(ignore, f.Owner.Character)
		end
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(f.Position, f.Direction * stepLength, params)
		local done = false
		-- Knockable players and other soft targets along the way (the ray passes through characters)
		local passed = Targets.AlongPath(f.Owner, f.Position, f.Position + f.Direction * stepLength, 2.2)
		if passed and not passed.Solid then
			passed.Hit(f.Owner, f.Damage, "Throw", f.Position)
			done = true
		elseif hit then
			local guard = GuardService.FromPart(hit.Instance)
			local target = if guard then nil else Targets.FromPart(f.Owner, hit.Instance)
			if guard then
				GuardService.Damage(guard, f.Damage, f.Owner)
			elseif target then
				target.Hit(f.Owner, f.Damage, "Throw", f.Position)
			end
			-- Other players are ghosts to hub knives; anything else stops it
			done = Players:GetPlayerFromCharacter(hit.Instance:FindFirstAncestorOfClass("Model")) == nil
		end
		-- Hit a wall (not a guard, target or person): it sticks there for a minute
		if
			done
			and hit
			and not passed
			and not GuardService.FromPart(hit.Instance)
			and not Targets.FromPart(f.Owner, hit.Instance)
		then
			StuckKnives.Stick(f.Model, hit.Position, f.Direction, 60)
			table.remove(flying, i)
			continue
		end
		f.Position += f.Direction * stepLength
		f.Traveled += stepLength
		if done or f.Traveled > config.Range then
			f.Model:Destroy()
			table.remove(flying, i)
		else
			f.Model:PivotTo(
				CFrame.lookAt(f.Position, f.Position + f.Direction) * CFrame.Angles(-f.Traveled * 0.5, 0, 0)
			)
		end
	end
end

-- Max health from the Health level (cash upgrade) and the Titan pass. Topping up keeps the same
-- fraction of health you had, so buying mid-fight doesn't heal you outright.
function CombatService.ApplyHealth(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local level = (player:GetAttribute("HealthLevel") or 0) :: number
	local max = GameConfig.MaxHealthFor(level, if player:GetAttribute("Pass_Titan") then 2 else 1)
	if player:GetAttribute("InRound") then
		max = GameConfig.Health.Base -- rounds are fair: everyone is equal
	end
	if humanoid.MaxHealth ~= max then
		local fraction = humanoid.Health / math.max(humanoid.MaxHealth, 1)
		humanoid.MaxHealth = max
		humanoid.Health = math.max(1, max * fraction)
	end
end

-- Deaths: go limp, cry out, collapse. Players respawn at their vault as usual.
local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	task.defer(function()
		local level = (player:GetAttribute("HealthLevel") or 0) :: number
		local max = GameConfig.MaxHealthFor(level, if player:GetAttribute("Pass_Titan") then 2 else 1)
		if not player:GetAttribute("InRound") and humanoid.Health > 0 then
			humanoid.MaxHealth = max
			humanoid.Health = max
		end
	end)
	humanoid.BreakJointsOnDeath = false
	humanoid.Died:Connect(function()
		Ragdoll.DeathCry(character)
		Ragdoll.Collapse(character, nil)
		Net.Remotes.Effect:FireClient(player, "Died")
		-- Auto-loading is off (see Main), so respawn here once the body has had time to fall
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == character then
				player:LoadCharacterAsync()
			end
		end)
	end)
	task.defer(CombatService.Arm, player)
end

function CombatService.Init()
	flyingFolder = Instance.new("Folder")
	flyingFolder.Name = "ThrownKnives"
	flyingFolder.Parent = workspace

	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
		-- Re-arm when the equipped knife / collection changes, and around rounds
		-- Equipping a knife puts it straight in your hands; a changed collection just swaps it
		player:GetAttributeChangedSignal("Equipped"):Connect(function()
			CombatService.Arm(player, true)
		end)
		player:GetAttributeChangedSignal("Knives"):Connect(function()
			CombatService.Arm(player)
		end)
		-- Hands full while carrying a stolen knife; your own knife comes back once you're home
		player:GetAttributeChangedSignal("Carrying"):Connect(function()
			if player:GetAttribute("Carrying") then
				CombatService.TakeCharge(player)
				CombatService.Disarm(player)
				Net.Remotes.AbilityState:FireClient(player, nil)
			else
				CombatService.Arm(player, true)
			end
		end)
		player:GetAttributeChangedSignal("InRound"):Connect(function()
			if player:GetAttribute("InRound") then
				CombatService.Disarm(player)
			else
				CombatService.Arm(player)
			end
			CombatService.ApplyHealth(player)
		end)
		for _, attribute in { "HealthLevel", "Pass_Titan" } do
			player:GetAttributeChangedSignal(attribute):Connect(function()
				CombatService.ApplyHealth(player)
			end)
		end
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		combo[player] = nil
		throwReadyAt[player] = nil
	end)

	Net.Remotes.Ability.OnServerEvent:Connect(throw)
	Net.Remotes.Charge.OnServerEvent:Connect(onCharge)
	RunService.Heartbeat:Connect(stepFlying)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Player save data. Everything that matters (cash, knives, upgrades, luck) lives here and only
-- the server touches it. Saves go through UpdateAsync with retries and a session lock so two
-- servers can never overwrite each other (the classic dupe/rollback bug).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local Net = require(script.Parent.Parent.Remotes)

export type Profile = {
	Cash: number,
	Knives: { string }, -- item strings (Items): "Katana", "Katana|Gold|Huge"
	Plates: { number }, -- Plates[i] = the vault plate Knives[i] sits on (DataService.AddKnife/RemoveKnife)
	Slots: number,
	Luck: number,
	Tickets: number,
	TotalKills: number,
	RoundsWon: number,
	Equipped: string, -- item you fight with / bring into rounds as the Murderer; "" = best owned
	Discovered: { string }, -- every catalog knife ever owned (plain names), for the collection book
	Powers: { [string]: number }, -- Innocent Power id -> level (1..3)
	Loadout: { string }, -- equipped power ids, at most PowerSlots
	PowerSlots: number,
	Speed: number, -- trained on the vault treadmill; turned into walk speed by GameConfig.WalkSpeedFor
	TreadmillLevel: number,
	WallLevel: number, -- GameConfig.Walls tier: wall height and gate health
	Rebirths: number,
	TutorialDone: boolean,
	CasesOpened: number,
	KnivesStolen: number, -- from other players' vaults in raids
	BestPull: string, -- the most hyped item ever unboxed (for bragging rights)
	IndexClaimed: { string }, -- knives whose Index reward was collected
	NextFreeChest: number, -- os.time() when the plaza's free chest is ready for them again
	LastSeen: number, -- os.time() of the last save (offline earnings count from here)
	PlayTime: number, -- seconds played in total (the new-player shield runs out on this)
	DailyStreak: number, -- day of the 7-day login streak last claimed (0 = none yet)
	LastDaily: number, -- the UTC day number it was claimed on
	TrailLevel: number, -- highest knife trail bought (GameConfig.Trails), 0 = none
	HealthLevel: number, -- max health upgrades bought (GameConfig.Health)
	Receipts: { string }, -- recent Robux PurchaseIds already granted (ProcessReceipt is idempotent)
	Bought: { string }, -- one-time Robux products already bought (Starter Pack)
	Pending: { number }, -- money waiting on each slot's cash pad (BaseService), collected by walking over it
	Heat: number, -- 0-10, boosts income and power luck (server Fuel)
	PowerPity: number, -- knives in a row without a Murderer power (bad-luck protection)
	RevengeUntil: number, -- os.time() until which a robbed Murderer gets revenge luck
}

local STORE_NAME = "PlayerData_v2" -- v1 = saves before the 2026-10-03 reset (kept, not deleted)
local LOCK_TIMEOUT = 600 -- a lock older than this belongs to a server that died
local AUTOSAVE_INTERVAL = 120
local MAX_ATTEMPTS = 5

local DataService = {}

local profiles: { [Player]: Profile } = {}
-- When each player was last seen before this visit (os.time(), 0 = never), for offline earnings
DataService.AwaySince = {} :: { [Player]: number }
local loadedEvent = Instance.new("BindableEvent")
local changedEvent = Instance.new("BindableEvent")
DataService.PlayerLoaded = loadedEvent.Event -- (player, profile)
DataService.Changed = changedEvent.Event -- (player, profile)

-- In Studio without API access (or in an unpublished place) we play with throwaway data.
-- GetDataStore itself throws in an unpublished place, so it has to be guarded too.
local storeOk, storeOrErr = pcall(DataStoreService.GetDataStore, DataStoreService, STORE_NAME)
local store: DataStore = if storeOk then storeOrErr else nil :: any
local offline = not storeOk
if offline then
	warn(`[DataService] no DataStore ({storeOrErr}) - using temporary data`)
end

local function defaultProfile(): Profile
	return {
		Cash = GameConfig.StartingCash,
		Knives = {},
		Plates = {},
		Slots = GameConfig.StartingSlots,
		Luck = 0,
		Tickets = 0,
		TotalKills = 0,
		RoundsWon = 0,
		Equipped = "",
		Discovered = {},
		Powers = {},
		Loadout = {},
		PowerSlots = GameConfig.PowerSlots,
		Speed = 0,
		TreadmillLevel = 1,
		WallLevel = 1,
		Rebirths = 0,
		TutorialDone = false,
		CasesOpened = 0,
		KnivesStolen = 0,
		BestPull = "",
		IndexClaimed = {},
		NextFreeChest = 0,
		LastSeen = 0,
		PlayTime = 0,
		DailyStreak = 0,
		LastDaily = 0,
		Receipts = {},
		Bought = {},
		TrailLevel = 0,
		HealthLevel = 0,
		Pending = {},
		Heat = 0,
		PowerPity = 0,
		RevengeUntil = 0,
	}
end

-- Fill in fields added after a player's last save, and clamp anything nonsensical
local function reconcile(data: any): Profile
	local profile = defaultProfile()
	if type(data) == "table" then
		for key, value in pairs(profile :: any) do
			if type(data[key]) == type(value) then
				(profile :: any)[key] = data[key]
			end
		end
	end
	-- Whole floors only (older saves bought single mounts: round up to the floor they started)
	profile.Slots = math.clamp(
		math.ceil(profile.Slots / GameConfig.SlotsPerFloor) * GameConfig.SlotsPerFloor,
		GameConfig.StartingSlots,
		GameConfig.MaxSlots
	)
	-- One number per slot, never negative or broken (a dense array saves cleanly)
	local pending: { number } = {}
	for slot = 1, GameConfig.MaxSlots do
		local value = profile.Pending[slot]
		pending[slot] = if type(value) == "number"
				and value == value
				and value >= 0
				and value < math.huge
			then value
			else 0
	end
	profile.Pending = pending
	profile.Heat = math.clamp(math.floor(profile.Heat), 0, GameConfig.Fuel.MaxHeat)
	profile.PowerPity = math.max(0, math.floor(profile.PowerPity))
	profile.Speed = math.max(0, profile.Speed)
	profile.TreadmillLevel = math.clamp(math.floor(profile.TreadmillLevel), 1, #GameConfig.Treadmills)
	profile.Cash = math.max(0, profile.Cash)
	profile.WallLevel = math.clamp(math.floor(profile.WallLevel), 1, #GameConfig.Walls)
	profile.Rebirths = math.clamp(math.floor(profile.Rebirths), 0, GameConfig.Rebirth.Max)
	profile.TrailLevel = math.clamp(math.floor(profile.TrailLevel), 0, #GameConfig.Trails)
	profile.HealthLevel = math.clamp(math.floor(profile.HealthLevel), 0, GameConfig.Health.MaxLevel)
	-- Drop knives that were removed from the catalog so nothing downstream sees an unknown name
	-- Each kept knife keeps its plate (older saves: plates in list order); duplicates or bad plates
	-- get the first free one
	local items, plates, used = {}, {}, {}
	for i, item in profile.Knives do
		if Items.Valid(item) then
			table.insert(items, item)
			local plate = profile.Plates[i]
			if type(plate) == "number" and plate >= 1 and plate <= GameConfig.MaxSlots and not used[plate] then
				plate = math.floor(plate)
			else
				plate = 0
			end
			table.insert(plates, plate)
			if plate > 0 then
				used[plate] = true
			end
		end
	end
	for i, plate in plates do
		if plate == 0 then
			local free = 1
			while used[free] do
				free += 1
			end
			plates[i] = free
			used[free] = true
		end
	end
	profile.Knives = items
	profile.Plates = plates
	local discovered = {}
	for _, name in profile.Discovered do
		local base = if type(name) == "string" then Items.Name(name) else ""
		if Knives.ByName[base] and not table.find(discovered, base) then
			table.insert(discovered, base)
		end
	end
	profile.Discovered = discovered
	if not Items.Valid(profile.BestPull) then
		profile.BestPull = ""
	end
	if profile.Equipped ~= "" and not table.find(profile.Knives, profile.Equipped) then
		profile.Equipped = ""
	end
	-- Powers: known ids, sane levels; loadout only holds owned powers, once each, within the slots
	local powers: { [string]: number } = {}
	for _, power in GameConfig.Powers do
		local level = profile.Powers[power.Id]
		if type(level) == "number" and level >= 1 then
			powers[power.Id] = math.clamp(math.floor(level), 1, GameConfig.PowerMaxLevel)
		end
	end
	profile.Powers = powers
	profile.PowerSlots = math.clamp(profile.PowerSlots, GameConfig.PowerSlots, GameConfig.MaxPowerSlots)
	local loadout = {}
	for _, id in profile.Loadout do
		if type(id) == "string" and powers[id] and not table.find(loadout, id) and #loadout < profile.PowerSlots then
			table.insert(loadout, id)
		end
	end
	profile.Loadout = loadout
	return profile
end

-- Knives and the plates they sit on --------------------------------------------------------------
-- Every change to a profile's Knives goes through these, so Plates stays lined up with it.

-- The first empty plate (1..), or nil when every unlocked plate is taken
function DataService.FreePlate(profile: Profile): number?
	for plate = 1, profile.Slots do
		if not table.find(profile.Plates, plate) then
			return plate
		end
	end
	return nil
end

-- Adds a knife, on `plate` if that one is free, else on the first free plate (or past the
-- unlocked ones if the wall is full - it shows up once a new floor is bought). Returns the plate.
function DataService.AddKnife(profile: Profile, item: string, plate: number?): number
	local target = if plate and plate >= 1 and not table.find(profile.Plates, plate) then plate else nil
	if not target then
		target = DataService.FreePlate(profile)
	end
	if not target then
		local n = profile.Slots + 1
		while table.find(profile.Plates, n) do
			n += 1
		end
		target = n
	end
	table.insert(profile.Knives, item)
	table.insert(profile.Plates, target :: number)
	return target :: number
end

-- Removes the knife at list index `index` (and its plate); returns the item
function DataService.RemoveKnife(profile: Profile, index: number): string?
	local item = table.remove(profile.Knives, index)
	table.remove(profile.Plates, index)
	return item
end

function DataService.PlateOf(profile: Profile, index: number): number
	return profile.Plates[index] or index
end

-- Which knife (list index) sits on `plate`, if any
function DataService.IndexOnPlate(profile: Profile, plate: number): number?
	return table.find(profile.Plates, plate)
end

local function key(player: Player): string
	return `u_{player.UserId}`
end

local function isStudioApiError(err: any): boolean
	local message = string.lower(tostring(err))
	return RunService:IsStudio()
		and (
			message:find("studioaccesstoapisnotallowed", 1, true) ~= nil
			or message:find("api access is not enabled", 1, true) ~= nil
			or message:find("publish", 1, true) ~= nil
		)
end

local function loadAsync(player: Player): Profile?
	if offline then
		return defaultProfile()
	end
	for attempt = 1, MAX_ATTEMPTS do
		local lockedElsewhere = false
		-- The other server is probably dead: take over. In Studio the "other server" is always the
		-- previous playtest that was stopped before it could release, so don't make testers wait.
		local forceLock = attempt == MAX_ATTEMPTS or (RunService:IsStudio() and attempt >= 2)
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(old: any)
				old = old or {}
				local lock = old.Lock
				if not forceLock and lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_TIMEOUT then
					lockedElsewhere = true
					return nil
				end
				old.Lock = { JobId = game.JobId, Time = os.time() }
				return old
			end)
		end)
		if ok and not lockedElsewhere then
			return reconcile(result and result.Data)
		elseif not ok and isStudioApiError(result) then
			warn(
				"[DataService] Studio has no DataStore access - using temporary data (Game Settings > Security to enable)"
			)
			offline = true
			return defaultProfile()
		end
		warn(
			`[DataService] load attempt {attempt} for {player.Name} failed: {if ok
				then "locked by another server"
				else result}`
		)
		task.wait(if lockedElsewhere then 4 else attempt)
	end
	return nil
end

local function saveAsync(player: Player, profile: Profile, release: boolean): boolean
	if offline then
		return true
	end
	for attempt = 1, MAX_ATTEMPTS do
		local lostLock = false
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old: any)
				old = old or {}
				if old.Lock and old.Lock.JobId ~= game.JobId then
					lostLock = true -- someone else owns this save now; writing would roll them back
					return nil
				end
				profile.LastSeen = os.time()
				old.Data = profile
				old.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
				return old
			end)
		end)
		if ok then
			if lostLock then
				warn(`[DataService] {player.Name}'s save is locked by another server, skipped`)
			end
			return not lostLock
		end
		warn(`[DataService] save attempt {attempt} for {player.Name} failed: {err}`)
		task.wait(attempt)
	end
	return false
end

-- Mirror the profile onto the player so the HUD and leaderboard can read it (read-only for clients)
local function publish(player: Player, profile: Profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		(leaderstats:FindFirstChild("Cash") :: IntValue).Value = math.floor(profile.Cash);
		(leaderstats:FindFirstChild("Rebirths") :: IntValue).Value = profile.Rebirths;
		(leaderstats:FindFirstChild("Stolen") :: IntValue).Value = profile.KnivesStolen
	end
	player:SetAttribute("Cash", math.floor(profile.Cash))
	player:SetAttribute("Slots", profile.Slots)
	player:SetAttribute("KnifeCount", #profile.Knives)
	player:SetAttribute("Speed", math.floor(profile.Speed))
	player:SetAttribute("TreadmillLevel", profile.TreadmillLevel)
	player:SetAttribute("Luck", profile.Luck)
	player:SetAttribute("Heat", profile.Heat)
	player:SetAttribute("Tickets", profile.Tickets)
	player:SetAttribute("Knives", table.concat(profile.Knives, ","))
	player:SetAttribute("Equipped", profile.Equipped)
	player:SetAttribute("Discovered", table.concat(profile.Discovered, ","))
	player:SetAttribute("Kills", profile.TotalKills)
	local powers = {}
	for id, level in profile.Powers do
		table.insert(powers, `{id}:{level}`)
	end
	table.sort(powers)
	player:SetAttribute("Powers", table.concat(powers, ","))
	player:SetAttribute("Loadout", table.concat(profile.Loadout, ","))
	player:SetAttribute("PowerSlots", profile.PowerSlots)
	player:SetAttribute("Wins", profile.RoundsWon)
	player:SetAttribute("WallLevel", profile.WallLevel)
	player:SetAttribute("Rebirths", profile.Rebirths)
	player:SetAttribute("Title", GameConfig.RebirthTitle(profile.Rebirths))
	player:SetAttribute("TutorialDone", profile.TutorialDone)
	player:SetAttribute("CasesOpened", profile.CasesOpened)
	player:SetAttribute("KnivesStolen", profile.KnivesStolen)
	player:SetAttribute("BestPull", profile.BestPull)
	player:SetAttribute("IndexClaimed", table.concat(profile.IndexClaimed, ","))
	player:SetAttribute("NextFreeChest", profile.NextFreeChest)
	player:SetAttribute("DailyStreak", profile.DailyStreak)
	player:SetAttribute("TrailLevel", profile.TrailLevel)
	player:SetAttribute("HealthLevel", profile.HealthLevel)
	for _, bought in profile.Bought do
		player:SetAttribute("Bought_" .. bought, true)
	end
	player:SetAttribute("LastDaily", profile.LastDaily)
	local shielded = DataService.IsNewPlayer(player, profile)
	player:SetAttribute("Shielded", shielded or nil)
	player:SetAttribute("ShieldLeft", if shielded then GameConfig.NewPlayerShield - profile.PlayTime else nil)
	changedEvent:Fire(player, profile)
end

local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	for _, stat in { "Cash", "Rebirths", "Stolen" } do
		local value = Instance.new("IntValue")
		value.Name = stat
		value.Parent = leaderstats
	end
	leaderstats.Parent = player

	local profile = loadAsync(player)
	if not player.Parent then
		if profile then
			saveAsync(player, profile, true) -- they left while loading; release the lock
		end
		return
	end
	if not profile then
		player:Kick("We couldn't load your data (Roblox servers are busy). Please rejoin!")
		return
	end
	profiles[player] = profile
	DataService.AwaySince[player] = profile.LastSeen
	publish(player, profile)
	player:SetAttribute("DataLoaded", true)
	loadedEvent:Fire(player, profile)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		saveAsync(player, profile, true)
		profiles[player] = nil
	end
	DataService.AwaySince[player] = nil
end

-- New players' knives can't be taken (break-ins, burglars, Murderer loot) for their first
-- GameConfig.NewPlayerShield seconds of play. In Studio everyone is new every session, so the
-- shield is off there unless ReplicatedStorage has DebugShield = true.
function DataService.IsNewPlayer(player: Player, profile: Profile?): boolean
	if RunService:IsStudio() and not ReplicatedStorage:GetAttribute("DebugShield") then
		return false
	end
	local p = profile or profiles[player]
	return p ~= nil and p.Rebirths == 0 and p.PlayTime < GameConfig.NewPlayerShield
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

-- The only way game code changes data: mutate inside fn, then everything is re-published
function DataService.Update(player: Player, fn: (Profile) -> ())
	local profile = profiles[player]
	if not profile then
		return
	end
	fn(profile)
	publish(player, profile)
end

-- Write this player's save right now (after a Robux purchase); true if it stuck
function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and saveAsync(player, profile, false)
end

function DataService.AddCash(player: Player, amount: number)
	DataService.Update(player, function(profile)
		profile.Cash += amount
	end)
end

function DataService.TrySpend(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount < 0 or profile.Cash < amount then
		return false
	end
	DataService.Update(player, function(p)
		p.Cash -= amount
	end)
	return true
end

function DataService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, profile in profiles do
				task.spawn(saveAsync, player, profile, false)
			end
		end
	end)

	-- Play time (and with it the new-player shield running out)
	task.spawn(function()
		while true do
			task.wait(30)
			for player, profile in profiles do
				local wasNew = DataService.IsNewPlayer(player, profile)
				profile.PlayTime += 30
				if DataService.IsNewPlayer(player, profile) then
					player:SetAttribute("ShieldLeft", GameConfig.NewPlayerShield - profile.PlayTime)
				elseif wasNew then
					player:SetAttribute("Shielded", nil)
					player:SetAttribute("ShieldLeft", nil)
					Net.Notify(player, "Your new-player shield is gone - guard your vault!", "info")
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			pending += 1
			task.spawn(function()
				saveAsync(player, profile, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">DebugService</string>
            <string name="Source"><![CDATA[--!strict
-- Studio-only test hooks (never created in a live server). Command-bar / MCP code runs in its own
-- module instances, so it reaches the real game state through this BindableFunction:
--   game.ServerStorage.Debug:Invoke("Give", player, { "Katana", ... }, equip?)
--   game.ServerStorage.Debug:Invoke("Cash", player, 5000)
--   game.ServerStorage.Debug:Invoke("Data", player) -> profile
--   game.ServerStorage.Debug:Invoke("StartRound", player) -> starts/skips to a one-player round
--   game.ServerStorage.Debug:Invoke("Drop", player, "Katana") -> drops that knife in front of them
--   game.ServerStorage.Debug:Invoke("BotRound", player, "Murderer" | "Innocent") -> a round with bots

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Parent.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local RoundService = require(script.Parent.RoundService)
local StealService = require(script.Parent.StealService)
local RaidService = require(script.Parent.RaidService)

local DebugService = {}

local commands: { [string]: (Player, ...any) -> any } = {
	-- equip = true also makes the last one given your fighting / Murderer knife
	Give = function(player: Player, names: { string }, equip: boolean?)
		DataService.Update(player, function(p)
			for _, item in names do
				DataService.AddKnife(p, item)
				local name = Items.Name(item)
				if not table.find(p.Discovered, name) then
					table.insert(p.Discovered, name)
				end
			end
			if equip and #names > 0 then
				p.Equipped = names[#names]
			end
		end)
		BaseService.RefreshRack(player)
		return true
	end,
	Cash = function(player: Player, amount: number)
		DataService.AddCash(player, amount)
		return true
	end,
	Data = function(player: Player)
		return DataService.Get(player)
	end,
	-- Speed stat; nil = enough for max walk speed (GameConfig.MaxWalkSpeed)
	Speed = function(player: Player, amount: number?)
		local target = amount or 7e8
		DataService.Update(player, function(p)
			p.Speed = target
		end)
		BaseService.RefreshWalkSpeed(player)
		return GameConfig.WalkSpeedFor(target)
	end,
	StartRound = function(player: Player)
		ReplicatedStorage:SetAttribute("DebugMinPlayers", 1)
		ReplicatedStorage:SetAttribute("DebugSkip", true)
		Net.Notify(player, "Studio debug: starting a one-player round...", "info")
		return true
	end,
	Drop = function(player: Player, name: string)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			StealService.DropKnife(name, root.Position + root.CFrame.LookVector * 5)
		end
		return root ~= nil
	end,
	Case = function(player: Player, rarity: string?)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			StealService.DropCase(rarity or "Common", root.Position + root.CFrame.LookVector * 5)
		end
		return root ~= nil
	end,
	Raid = function(player: Player, enabled: boolean?)
		local start = if enabled == nil then not RaidService.IsRaiding() else enabled
		if not start then
			RaidService.Stop()
		else
			RaidService.Start()
		end
		local active = RaidService.IsRaiding()
		Net.Notify(player, if active then "Studio debug: raid active" else "Studio debug: raid inactive", "info")
		return active
	end,
	Walls = function(player: Player, level: number)
		DataService.Update(player, function(p)
			p.WallLevel = math.clamp(level, 1, #GameConfig.Walls)
		end)
		return true
	end,
	BotRound = function(player: Player, role: string)
		if ReplicatedStorage:GetAttribute("Phase") ~= "Intermission" then
			Net.Notify(player, "Wait for this round to end first", "bad")
			return false
		end
		RoundService.DebugBotRound(player, role)
		Net.Notify(player, `Bot round: you're the {if role == "Innocent" then "Innocent" else "Murderer"}!`, "info")
		return true
	end,
}

function DebugService.Init()
	if not RunService:IsStudio() then
		return
	end
	local hook = Instance.new("BindableFunction")
	hook.Name = "Debug"
	hook.OnInvoke = function(command: string, player: Player, ...)
		local fn = commands[command]
		return if fn then fn(player, ...) else nil
	end
	hook.Parent = ServerStorage

	Net.Remotes.Debug.OnServerInvoke = function(player: Player, command: string, ...)
		local fn = commands[command]
		return if fn then fn(player, ...) else nil
	end
end

return DebugService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">

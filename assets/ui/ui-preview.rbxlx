      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Big-number formatting shared by the HUD and server messages: 1.5K, 2.3M ... 4.1Qn, 7Sx, up to
-- Vigintillion (Vg), then scientific notation. Money goes into the quintillions and beyond.

local Format = {}

local SUFFIXES = {
	"",
	"K",
	"M",
	"B",
	"T",
	"Qd",
	"Qn",
	"Sx",
	"Sp",
	"Oc",
	"No",
	"Dc",
	"Ud",
	"Dd",
	"Td",
	"Qad",
	"Qid",
	"Sxd",
	"Spd",
	"Ocd",
	"Nvd",
	"Vg",
}

-- 1234 -> "1.2K", 999 -> "999", 1e18 -> "1Qn"
function Format.Short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local text
	if n >= 1000 then
		text = string.format("%.2e", n * 1000 ^ (i - 1))
	elseif i == 1 then
		text = tostring(math.floor(n))
	elseif n >= 100 then
		text = string.format("%d%s", math.floor(n), SUFFIXES[i])
	else
		-- 1.5K, 12.3M; drop a trailing ".0"
		text = (string.format("%.1f", math.floor(n * 10) / 10):gsub("%.0$", "")) .. SUFFIXES[i]
	end
	return if negative then "-" .. text else text
end

-- "$1.5K"
function Format.Cash(n: number): string
	return "$" .. Format.Short(n)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
-- Owned knives are "items": a catalog knife plus a mutation and a size, rolled when its sealed case
-- is opened. Stored as one string so profiles, attributes and round loot stay simple:
--   "Katana"              plain, normal size (every save from before cases still works)
--   "Katana|Gold|Big"     Gold mutation, Big size ("Katana||Huge" = no mutation, Huge)
--   "Katana|Gold|Big|SpamKnife"  ...with a rolled Murderer power ("" = none, "?" = not rolled yet:
--                         rolled when it reaches your vault). Saves from before power rolls (3
--                         fields) keep the power their knife type used to give.
-- Mutations and sizes multiply income; they also make the knife hit a little harder.

local Knives = require(script.Parent.Config.Knives)

export type Mutation = {
	Id: string,
	DisplayName: string,
	Income: number, -- income multiplier
	Damage: number, -- damage multiplier
	Weight: number, -- roll weight (out of the total)
	Color: Color3,
	Rank: number, -- 0 = none; higher = rarer (announcements, sorting)
}

export type Size = {
	Id: string,
	DisplayName: string,
	Scale: number, -- how big the model is
	Income: number,
	Damage: number,
	Weight: number,
	Rank: number,
}

export type Item = {
	Item: string,
	Name: string,
	Knife: Knives.Knife,
	Mutation: Mutation,
	Size: Size,
	Perk: string?, -- the Murderer power this one carries (GameConfig.Perks id), nil = none
	Unrolled: boolean, -- "?" : the power roll still has to happen
}

local Items = {}

Items.Mutations = {
	{
		Id = "",
		DisplayName = "",
		Income = 1,
		Damage = 1,
		Weight = 8000,
		Color = Color3.new(1, 1, 1),
		Rank = 0,
	},
	{
		Id = "Gold",
		DisplayName = "Gold",
		Income = 2,
		Damage = 1.1,
		Weight = 1250,
		Color = Color3.fromRGB(255, 200, 40),
		Rank = 1,
	},
	{
		Id = "Diamond",
		DisplayName = "Diamond",
		Income = 3,
		Damage = 1.2,
		Weight = 500,
		Color = Color3.fromRGB(120, 230, 255),
		Rank = 2,
	},
	{
		Id = "Rainbow",
		DisplayName = "Rainbow",
		Income = 5,
		Damage = 1.35,
		Weight = 200,
		Color = Color3.fromRGB(255, 110, 220),
		Rank = 3,
	},
	{
		Id = "Void",
		DisplayName = "Void",
		Income = 10,
		Damage = 1.6,
		Weight = 50,
		Color = Color3.fromRGB(150, 60, 255),
		Rank = 4,
	},
} :: { Mutation }

Items.Sizes = {
	{ Id = "Tiny", DisplayName = "Tiny", Scale = 0.7, Income = 0.75, Damage = 0.9, Weight = 1400, Rank = 0 },
	{ Id = "Small", DisplayName = "Small", Scale = 0.85, Income = 0.9, Damage = 0.95, Weight = 2400, Rank = 0 },
	{ Id = "", DisplayName = "", Scale = 1, Income = 1, Damage = 1, Weight = 4200, Rank = 0 },
	{ Id = "Big", DisplayName = "Big", Scale = 1.2, Income = 1.25, Damage = 1.05, Weight = 1500, Rank = 1 },
	{ Id = "Huge", DisplayName = "Huge", Scale = 1.45, Income = 1.6, Damage = 1.1, Weight = 440, Rank = 2 },
	{
		Id = "Colossal",
		DisplayName = "Colossal",
		Scale = 1.8,
		Income = 2.5,
		Damage = 1.2,
		Weight = 60,
		Rank = 3,
	},
} :: { Size }

-- Murderer powers are rare rolls on top of a knife (not tied to its type): "1 in OneIn" each, with
-- luck (Heat, deeper zones, bad-luck protection) multiplying every chance. Rarest first.
Items.Powers = {
	{ Id = "Hellfire", OneIn = 3000 },
	{ Id = "SpamKnife", OneIn = 1000 },
	{ Id = "ExplodingKnife", OneIn = 700 },
	{ Id = "LaserKnife", OneIn = 450 },
	{ Id = "Invisiknife", OneIn = 300 },
	{ Id = "GhostKnife", OneIn = 200 },
	{ Id = "Bulletproof", OneIn = 120 },
	{ Id = "ShapeShifter", OneIn = 60 },
	{ Id = "Identifier", OneIn = 40 },
	{ Id = "Fury", OneIn = 25 },
} :: { { Id: string, OneIn: number } }
local powerById: { [string]: { Id: string, OneIn: number } } = {}
for _, power in Items.Powers do
	powerById[power.Id] = power
end

-- "1 in N" for a power (0 if unknown)
function Items.PowerOneIn(power: string?): number
	local entry = power and powerById[power]
	return if entry then entry.OneIn else 0
end

-- Rolls a power ("" = none). luck multiplies every chance.
function Items.RollPower(rng: Random, luck: number?): string
	local boost = math.max(1, luck or 1)
	for _, power in Items.Powers do
		if rng:NextNumber() < boost / power.OneIn then
			return power.Id
		end
	end
	return ""
end

local mutationById: { [string]: Mutation } = {}
for _, m in Items.Mutations do
	mutationById[m.Id] = m
end
local sizeById: { [string]: Size } = {}
for _, s in Items.Sizes do
	sizeById[s.Id] = s
end
Items.MutationById = mutationById
Items.SizeById = sizeById

local cache: { [string]: Item } = {}
local invalid: { [string]: boolean } = {}

-- nil when the knife isn't in the catalog (or the string is garbage)
function Items.Parse(item: string): Item?
	local cached = cache[item]
	if cached or invalid[item] then
		return cached
	end
	local fields = string.split(item, "|")
	local name, mutation, size, power = fields[1], fields[2] or "", fields[3] or "", fields[4]
	local knife = Knives.ByName[name]
	local m = mutationById[mutation]
	local s = sizeById[size]
	-- No 4th field: an old save, which keeps its knife type's power
	local perk: string? = if power == nil
		then knife and knife.Perk
		elseif power == "" or power == "?" then nil
		else power
	if not knife or not m or not s or #fields > 4 or (perk ~= nil and not powerById[perk]) then
		invalid[item] = true
		return nil
	end
	local parsed: Item = {
		Item = item,
		Name = name,
		Knife = knife,
		Mutation = m,
		Size = s,
		Perk = perk,
		Unrolled = power == "?",
	}
	cache[item] = parsed
	return parsed
end

function Items.Make(name: string, mutation: string?, size: string?, power: string?): string
	local m, s = mutation or "", size or ""
	if power then
		return `{name}|{m}|{s}|{power}`
	end
	if m == "" and s == "" then
		return name
	end
	return `{name}|{m}|{s}`
end

-- The same knife with a different power ("" = none)
function Items.WithPower(item: string, power: string): string
	local p = Items.Parse(item)
	if not p then
		return item
	end
	return Items.Make(p.Name, p.Mutation.Id, p.Size.Id, power)
end

function Items.Valid(item: unknown): boolean
	return type(item) == "string" and Items.Parse(item) ~= nil
end

function Items.Name(item: string): string
	local parsed = Items.Parse(item)
	return if parsed then parsed.Name else item
end

-- Cash per second on the wall (before rebirth / boosts)
function Items.Income(item: string): number
	local p = Items.Parse(item)
	if not p then
		return 0
	end
	return math.floor(p.Knife.Income * p.Mutation.Income * p.Size.Income * 10 + 0.5) / 10
end

function Items.Damage(item: string): number
	local p = Items.Parse(item)
	if not p then
		return 0
	end
	return math.floor(p.Knife.Damage * p.Mutation.Damage * p.Size.Damage)
end

-- "Gold Huge Sakura Katana"
function Items.DisplayName(item: string): string
	local p = Items.Parse(item)
	if not p then
		return item
	end
	local parts = {}
	if p.Mutation.DisplayName ~= "" then
		table.insert(parts, p.Mutation.DisplayName)
	end
	if p.Size.DisplayName ~= "" then
		table.insert(parts, p.Size.DisplayName)
	end
	table.insert(parts, p.Knife.DisplayName)
	return table.concat(parts, " ")
end

-- How special this one is, for announcements: 0 = everyday, 3+ = the whole server should know
function Items.Hype(item: string): number
	local p = Items.Parse(item)
	if not p then
		return 0
	end
	local rarityRank = (table.find(Knives.Rarities, p.Knife.Rarity) or 1) - 1
	local oneIn = Items.PowerOneIn(p.Perk)
	local powerRank = if oneIn >= 1000 then 4 elseif oneIn >= 300 then 3 elseif oneIn >= 100 then 2 else 0
	return math.max(rarityRank - 1, p.Mutation.Rank + (if p.Mutation.Rank > 0 then 1 else 0), p.Size.Rank, powerRank)
end

-- The colour that best describes it: its mutation if it has one, else its rarity
function Items.Color(item: string): Color3
	local p = Items.Parse(item)
	if not p then
		return Color3.new(1, 1, 1)
	end
	return if p.Mutation.Rank > 0 then p.Mutation.Color else Knives.RarityColors[p.Knife.Rarity]
end

-- How strong a mounted knife's aura is: rarity, mutation and size all add up (0 .. ~10). The
-- aura is drawn around it on the wall and slows anyone who isn't the owner within AuraRadius.
function Items.AuraPower(item: string): number
	local p = Items.Parse(item)
	if not p then
		return 0
	end
	local rarity = (table.find(Knives.Rarities, p.Knife.Rarity) or 1) - 1
	return rarity * 1.2 + p.Mutation.Rank * 1.1 + p.Size.Rank * 0.6
end

function Items.AuraRadius(power: number): number
	-- Capped so the best knives still fit their floor of the vault
	return math.min(4 + power * 1.1, 15)
end

local function weighted<T>(rng: Random, list: { T }, weightOf: (T) -> number): T
	local total = 0
	for _, entry in list do
		total += weightOf(entry)
	end
	local roll = rng:NextNumber() * total
	for _, entry in list do
		roll -= weightOf(entry)
		if roll <= 0 then
			return entry
		end
	end
	return list[#list]
end

-- Rolls a mutation and a size. `luck` >= 1 makes everything past "none" / "normal" likelier.
function Items.Roll(rng: Random, luck: number?): (Mutation, Size)
	local boost = math.max(1, luck or 1)
	local mutation = weighted(rng, Items.Mutations, function(m: Mutation)
		return if m.Rank > 0 then m.Weight * boost else m.Weight
	end)
	local size = weighted(rng, Items.Sizes, function(s: Size)
		return if s.Rank > 0 then s.Weight * boost else s.Weight
	end)
	return mutation, size
end

-- What a sealed case of `rarity` holds: a random knife from that rarity (or, rarely, the next one
-- up), a mutation and a size. Returns the item and whether it jumped a rarity.
function Items.OpenCase(rng: Random, rarity: string, luck: number?): (string, boolean)
	local rarityIndex = table.find(Knives.Rarities, rarity) or 1
	local upgraded = rarityIndex < #Knives.Rarities and rng:NextNumber() < 0.04
	if upgraded then
		rarityIndex += 1
	end
	local pool = Knives.ByRarity[Knives.Rarities[rarityIndex]]
	local knife = pool[rng:NextInteger(1, #pool)]
	local mutation, size = Items.Roll(rng, luck)
	-- The power is rolled when it reaches someone's vault (their luck counts), so it starts as "?"
	return Items.Make(knife.Name, mutation.Id, size.Id, "?"), upgraded
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">KnifeAura</string>
          <string name="Source"><![CDATA[--!strict
-- Curve-authored animated silhouettes: outer lobes, hot core, curled tips and embers.
-- Independent upright attachments keep the effect separate from the spinning knife.
local Art = require(script.Parent.Config.KnifeAuraArt)
local Items = require(script.Parent.Items)
local Knives = require(script.Parent.Config.Knives)
local KnifeAura = {}

function KnifeAura.Power(item: string): number
	local parsed = Items.Parse(item)
	if not parsed then
		return 0
	end
	local family = Knives.ByRarity[parsed.Knife.Rarity]
	local low, high = math.huge, 0
	for _, knife in family do
		low = math.min(low, knife.Damage)
		high = math.max(high, knife.Damage)
	end
	local withinTier = if high > low then (parsed.Knife.Damage - low) / (high - low) else 0
	return Items.AuraPower(item) + withinTier * 0.7
end

function KnifeAura.Dimensions(power: number): (number, number)
	local strength = math.clamp(power, 0, 15)
	return 2.1 + strength * 0.34, 5 + strength * 1.2
end

local function emitter(anchor: BasePart, name: string, texture: string, rate: number, y: number): ParticleEmitter
	local attachment = Instance.new("Attachment")
	attachment.Name = name .. "Origin"
	attachment.Position = Vector3.new(0, y, 0)
	attachment:SetAttribute("KnifeAuraOwned", true)
	local p = Instance.new("ParticleEmitter")
	p.Name = name
	p.Texture = texture
	p.FlipbookLayout = if texture == Art.Ember
		then Enum.ParticleFlipbookLayout.Grid4x4
		else Enum.ParticleFlipbookLayout.Grid8x8
	p.FlipbookMode = Enum.ParticleFlipbookMode.Loop
	p.FlipbookFramerate = NumberRange.new(24, 28)
	p.FlipbookStartRandom = true
	p.FlipbookBlendFrames = true
	p.LightEmission = 0.15
	p.LightInfluence = 0
	p.Brightness = 1
	p.EmissionDirection = Enum.NormalId.Top
	p.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
	p.SpreadAngle = Vector2.new(5, 5)
	p.Rotation = NumberRange.new(0)
	p.RotSpeed = NumberRange.new(0)
	p.LockedToPart = true
	p.Rate = rate
	p:SetAttribute("BaseRate", rate)
	p:AddTag("KnifeAuraEmitter")
	p.Parent = attachment
	attachment.Parent = anchor
	return p
end

local function shape(p: ParticleEmitter, width: number, height: number, maskWidth: number, maskHeight: number)
	-- Account for transparent atlas padding when fitting the visible silhouette.
	local quadWidth, quadHeight = width / maskWidth, height / maskHeight
	local size = math.sqrt(quadWidth * quadHeight)
	local stretch = math.sqrt(quadHeight / quadWidth)
	p.Squash = NumberSequence.new(stretch - 1)
	p.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size * 0.65),
		NumberSequenceKeypoint.new(0.18, size),
		NumberSequenceKeypoint.new(0.7, size * 0.93),
		NumberSequenceKeypoint.new(1, size * 0.35),
	})
end

function KnifeAura.Mount(anchor: BasePart, power: number, clearance: number?)
	local strength = math.clamp(power, 0, 15)
	local width, height = KnifeAura.Dimensions(strength)
	if clearance then
		local room = math.max(0.1, clearance)
		height = room * (1 - math.exp(-height / room))
		width = math.min(width, height * 0.8 + 0.8)
	end
	for _, child in anchor:GetChildren() do
		if
			child:GetAttribute("KnifeAuraOwned")
			or child.Name == "AuraFire"
			or (child:IsA("ParticleEmitter") and child:HasTag("KnifeAuraEmitter"))
		then
			child:Destroy()
		end
	end
	anchor:SetAttribute("AuraPower", power)
	anchor:SetAttribute("AuraWidth", width)
	anchor:SetAttribute("AuraHeight", height)
	anchor:SetAttribute("AuraArtVersion", 4)
	local outer = emitter(anchor, "FlameOuter", Art.SoftFlame, 4 + strength * 0.05, height * 0.24)
	outer:SetAttribute("AuraMinRate", 2.4)
	outer.Color = ColorSequence.new(Color3.fromRGB(255, 66, 4), Color3.fromRGB(238, 29, 7))
	outer.LightEmission = 0.2
	outer.Brightness = 1.1
	outer.ZOffset = -0.5
	outer.Lifetime = NumberRange.new(2.4, 2.8)
	outer.Speed = NumberRange.new(height * 0.012, height * 0.025)
	shape(outer, width * 1.32, height * 0.48, 0.54, 0.7)
	outer.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.12, 0.23),
		NumberSequenceKeypoint.new(0.6, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	local core = emitter(anchor, "FlameCore", Art.Core, 4 + strength * 0.08, height * 0.2)
	core:SetAttribute("AuraMinRate", 2.8)
	core.Color = ColorSequence.new(Color3.fromRGB(255, 230, 31), Color3.fromRGB(255, 145, 4))
	core.LightEmission = 0.72
	core.Brightness = 1.2
	core.ZOffset = -0.35
	core.Lifetime = NumberRange.new(1.8, 2.2)
	core.Speed = NumberRange.new(height * 0.015, height * 0.03)
	core.FlipbookFramerate = NumberRange.new(27, 30)
	shape(core, width * 0.68, height * 0.4, 0.36, 0.62)
	core.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.12, 0.08),
		NumberSequenceKeypoint.new(0.55, 0.18),
		NumberSequenceKeypoint.new(1, 1),
	})
	local tongues = emitter(anchor, "FlameTongues", Art.Core, 3 + strength * 0.1, height * 0.3)
	tongues:SetAttribute("AuraMinRate", 1.5)
	tongues.Color = ColorSequence.new(Color3.fromRGB(255, 177, 7), Color3.fromRGB(255, 67, 5))
	tongues.LightEmission = 0.75
	tongues.Brightness = 1.2
	tongues.ZOffset = -0.45
	tongues.Lifetime = NumberRange.new(1, 1.4)
	tongues.Speed = NumberRange.new(height * 0.04, height * 0.07)
	tongues.SpreadAngle = Vector2.new(20, 20)
	shape(tongues, width * 0.35, height * 0.35, 0.36, 0.62)
	tongues.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.18, 0.16),
		NumberSequenceKeypoint.new(0.65, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	local glow = emitter(anchor, "FlameGlow", Art.SoftFlame, 1.5, height * 0.23)
	glow:SetAttribute("AuraMinRate", 0.9)
	glow.Color = ColorSequence.new(Color3.fromRGB(255, 151, 7), Color3.fromRGB(255, 75, 6))
	glow.LightEmission = 1
	glow.Brightness = 0.8
	glow.ZOffset = -0.65
	glow.Lifetime = NumberRange.new(1.4, 1.6)
	glow.Speed = NumberRange.new(height * 0.02)
	shape(glow, width * 1.5, height * 0.48, 0.54, 0.7)
	glow.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.9),
		NumberSequenceKeypoint.new(0.7, 0.94),
		NumberSequenceKeypoint.new(1, 1),
	})
	local wisps = emitter(anchor, "FlameWisps", Art.Wisp, 2 + strength * 0.06, height * 0.57)
	wisps:SetAttribute("AuraMinRate", 1.4)
	wisps.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 166, 32)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(243, 108, 49)),
		ColorSequenceKeypoint.new(0.72, Color3.fromRGB(172, 183, 197)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(145, 164, 189)),
	})
	wisps.LightEmission = 0.35
	wisps.ZOffset = -0.25
	wisps.Lifetime = NumberRange.new(1.7, 2.1)
	wisps.FlipbookFramerate = NumberRange.new(18, 22)
	wisps.Speed = NumberRange.new(height * 0.016, height * 0.035)
	wisps.SpreadAngle = Vector2.new(7, 7)
	shape(wisps, width * 0.3, height * 0.55, 0.38, 0.78)
	wisps.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.18, 0.22),
		NumberSequenceKeypoint.new(0.6, 0.54),
		NumberSequenceKeypoint.new(1, 1),
	})
	local embers = emitter(anchor, "FlameEmbers", Art.Ember, 4 + strength * 0.4, height * 0.12)
	embers:SetAttribute("AuraMinRate", 2)
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 221, 62), Color3.fromRGB(255, 95, 14))
	embers.LightEmission = 0.6
	embers.Lifetime = NumberRange.new(0.85, 1.3)
	embers.Speed = NumberRange.new(height * 0.3, height * 0.55)
	embers.SpreadAngle = Vector2.new(18, 18)
	embers.Rotation = NumberRange.new(-25, 25)
	embers.RotSpeed = NumberRange.new(-35, 35)
	embers.Size = NumberSequence.new(0.45 + strength * 0.055, 0.08)
	embers.Transparency = NumberSequence.new(0.08, 1)
	local light = Instance.new("PointLight")
	light.Name = "AuraGlow"
	light:SetAttribute("KnifeAuraOwned", true)
	light.Color = Color3.fromRGB(255, 167, 65)
	light.Range = 5 + strength * 0.65
	light.Brightness = 0.55 + strength * 0.045
	light.Shadows = false
	light.Parent = anchor
end

return KnifeAura
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">KnifeModel</string>
          <string name="Source"><![CDATA[--!strict
-- Builds knife models. Two flavours:
--   * Mesh knives from Blender (Config/KnifeMeshes). The server turns the mesh ids into template
--     models once at startup (Preload) and parks them in ReplicatedStorage.KnifeTemplates, so both
--     server and client just clone them.
--   * Part-built knives (bright, low-poly), used until the templates exist or if meshes fail.
-- Either way the knife stands along +Y from a grip at the origin, and the model's PrimaryPart is
-- an invisible "Handle" part at the grip, so pivots, welds and Tool grips work the same.

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Items = require(script.Parent.Items)
local KnifeIcons = require(script.Parent.Config.KnifeIcons)
local Props = require(script.Parent.Props)
local Knives = require(script.Parent.Config.Knives)
local KnifeMeshes = require(script.Parent.Config.KnifeMeshes)
local KnifeDetailMeshes = require(script.Parent.Config.KnifeDetailMeshes)
local KnifeAppearance = require(script.Parent.Config.KnifeAppearance)

local KnifeModel = {}

local MESH_SCALE = 1.35 -- Blender units -> studs, tuned to match the part knives' size
-- Mesh frame (blade along -X, spine +Y) -> knife frame (blade along +Y)
local MESH_TO_KNIFE = CFrame.Angles(0, 0, -math.pi / 2)
local TEMPLATE_FOLDER = "KnifeTemplates"
local TOOL_LENGTH = 2.4 -- studs, pommel to tip, for the knife the Murderer holds
local SILHOUETTE = "GoldenDagger" -- every skin uses the same blade, crossguard and grip

local function part(parent: Instance, name: string, size: Vector3, offset: CFrame, color: Color3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = offset
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

local function weldAll(parent: Instance, root: BasePart)
	for _, child in parent:GetChildren() do
		if child:IsA("BasePart") and child ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = child
			weld.Parent = child
		end
	end
end

local function assembleParts(parent: Instance, knife: Knives.Knife): BasePart
	local standard = Knives.ByName[SILHOUETTE]
	local length, width = standard.BladeLength, standard.BladeWidth
	local handle = part(parent, "Handle", Vector3.new(0.35, 1.1, 0.35), CFrame.new(), knife.HandleColor)
	local pommel = part(parent, "Pommel", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, -0.65, 0), knife.GuardColor)
	pommel.Shape = Enum.PartType.Ball
	part(parent, "Guard", Vector3.new(0.3, 0.2, width + 0.6), CFrame.new(0, 0.65, 0), knife.GuardColor)
	local blade = part(
		parent,
		"Blade",
		Vector3.new(0.12, length * 0.8, width),
		CFrame.new(0, 0.75 + length * 0.4, 0),
		knife.BladeColor
	)

	local tip = Instance.new("WedgePart")
	tip.Name = "Tip"
	tip.Size = Vector3.new(0.12, length * 0.25, width)
	tip.CFrame = CFrame.new(0, 0.75 + length * 0.8 + length * 0.125, 0)
	tip.Color = knife.BladeColor
	tip.CanCollide, tip.CanQuery, tip.CanTouch, tip.Massless = false, false, false, true
	tip.Parent = parent

	if knife.Neon then
		blade.Material = Enum.Material.Neon
		tip.Material = Enum.Material.Neon
		local light = Instance.new("PointLight")
		light.Color = knife.BladeColor
		light.Range = 10
		light.Parent = blade
	end
	weldAll(parent, handle)
	return handle
end

local function finishPart(p: BasePart, knife: Knives.Knife, role: string)
	local styles = KnifeAppearance[knife.Name]
	local finish = styles and styles[role]
	p:SetAttribute("KnifeRole", role)
	if finish then
		p.Color = finish.Color
		p.Material = finish.Material
	end
	p.Reflectance = if p.Material == Enum.Material.Metal then 0.06 else 0
	p.CastShadow = p.Material ~= Enum.Material.Neon
end

local function addBladeLight(model: Model, knife: Knives.Knife)
	if not knife.Neon then
		return
	end
	local light = Instance.new("PointLight")
	light.Name = "BladeGlow"
	light.Color = KnifeAppearance[knife.Name].CuttingEdge.Color
	light.Range = 5
	light.Brightness = 0.45
	light.Shadows = false
	light.Parent = model:FindFirstChild("Blade")
end

-- Server only: create one template per knife from the mesh ids. Yields (a few seconds).
function KnifeModel.Preload()
	assert(RunService:IsServer(), "KnifeModel.Preload runs on the server")
	if ReplicatedStorage:FindFirstChild(TEMPLATE_FOLDER) then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = TEMPLATE_FOLDER
	local pending = 0
	-- Skins differ by finish and shallow relief, never by blade shape or size.
	for _, knife in Knives.List do
		local name = knife.Name
		local specs = KnifeMeshes[SILHOUETTE]
		if not specs then
			continue
		end
		pending += 1
		task.spawn(function()
			local model = Instance.new("Model")
			model.Name = name
			local root = part(model, "Handle", Vector3.new(0.3, 1, 0.3), CFrame.new(), Color3.new())
			root.Transparency = 1
			local ok, err = pcall(function()
				for _, spec in specs do
					if spec.Name == "Extra" then
						continue
					end
					local mesh = AssetService:CreateMeshPartAsync(Content.fromUri(spec.MeshId))
					mesh.Name = if spec.Name == "Handle" then "Grip" else spec.Name
					mesh.Size = spec.Size * MESH_SCALE
					mesh.CFrame = MESH_TO_KNIFE * CFrame.new(spec.Offset * MESH_SCALE)
					local role = if spec.Name == "Handle"
						then "Grip"
						else if spec.Name == "Pommel" then "Guard" else spec.Name
					finishPart(mesh, knife, role)
					mesh.CanCollide = false
					mesh.CanQuery = false
					mesh.CanTouch = false
					mesh.Massless = true
					mesh.Parent = model
				end
			end)
			if ok then
				-- Detail failures leave the complete original silhouette usable.
				local detailsOk, detailsError = pcall(function()
					local details: { KnifeMeshes.MeshPartSpec } = KnifeDetailMeshes[name] or {}
					for _, spec in details do
						local mesh = AssetService:CreateMeshPartAsync(Content.fromUri(spec.MeshId))
						mesh.Name = spec.Name
						mesh.Size = spec.Size * MESH_SCALE
						mesh.CFrame = MESH_TO_KNIFE * CFrame.new(spec.Offset * MESH_SCALE)
						mesh.CanCollide, mesh.CanQuery, mesh.CanTouch, mesh.Massless = false, false, false, true
						finishPart(mesh, knife, spec.Name)
						mesh.Parent = model
					end
				end)
				if not detailsOk then
					warn(`[KnifeModel] details for {name} unavailable: {detailsError}`)
				end
				addBladeLight(model, knife)
				weldAll(model, root)
				model.PrimaryPart = root
				model.Parent = folder
			else
				model:Destroy()
				warn(`[KnifeModel] mesh knife {name} failed, using parts: {err}`)
			end
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 20 do
		task.wait(0.1)
	end
	folder.Parent = ReplicatedStorage
end

local function template(name: string): Model?
	local folder = ReplicatedStorage:FindFirstChild(TEMPLATE_FOLDER)
	return folder and folder:FindFirstChild(name) :: Model?
end

-- A motion trail along the blade, off by default; the client's animation engine (Moves) turns it
-- on for the part of a swing where the knife is moving
local function addTrail(model: Model, knife: Knives.Knife)
	local blade = model:FindFirstChild("Blade") :: BasePart?
	local root = model.PrimaryPart
	if not blade or not root then
		return
	end
	local length = math.max(blade.Size.X, blade.Size.Y, blade.Size.Z)
	local up = root.CFrame.UpVector
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBase"
	a0.Position = blade.CFrame:PointToObjectSpace(blade.Position - up * length * 0.35)
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTip"
	a1.Position = blade.CFrame:PointToObjectSpace(blade.Position + up * length * 0.5)
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Name = "KnifeTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.16
	trail.MinLength = 0.02
	trail.LightEmission = 0.7
	trail.FaceCamera = false
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), Knives.RarityColors[knife.Rarity])
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Enabled = false
	trail.Parent = blade
end

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function sparkles(parent: BasePart, color: ColorSequence, rate: number, size: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "MutationSparkles"
	emitter.Texture = SPARKLE
	emitter.Color = color
	emitter.LightEmission = 1
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.5, 1)
	emitter.Speed = NumberRange.new(0.3, 1.2)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Parent = parent
end

-- Mutations preserve the grip, the edge/body contrast and the raised detailing.
function KnifeModel.ApplyMutation(model: Model, mutation: string)
	if mutation == "" then
		return
	end
	local blade = (model:FindFirstChild("Blade") or model:FindFirstChild("Grip")) :: BasePart?
	for _, d in model:GetDescendants() do
		if not d:IsA("BasePart") or d.Transparency >= 1 then
			continue
		end
		local role = d:GetAttribute("KnifeRole")
		local isGrip = role == "Grip" or role == "GripDetail"
		local isBlade = role == "Blade" or role == "Tip"
		local isAccent = role == "Inlay" or role == "CuttingEdge" or role == "Extra"
		if mutation == "Gold" then
			d.Color = if isGrip
				then d.Color:Lerp(Color3.fromRGB(76, 40, 25), 0.45)
				else if isAccent
					then Color3.fromRGB(255, 232, 139)
					else if isBlade then Color3.fromRGB(211, 157, 42) else Color3.fromRGB(168, 109, 30)
			if not isGrip then
				d.Material = Enum.Material.Metal
				d.Reflectance = 0.08
			end
		elseif mutation == "Diamond" then
			d.Color = if isGrip
				then d.Color:Lerp(Color3.fromRGB(39, 89, 124), 0.55)
				else if isAccent
					then Color3.fromRGB(218, 253, 255)
					else if isBlade then Color3.fromRGB(96, 179, 205) else Color3.fromRGB(62, 118, 153)
			if not isGrip then
				d.Material = if isAccent then Enum.Material.Glass else Enum.Material.Metal
				d.Reflectance = 0.12
			end
		elseif mutation == "Rainbow" then
			if not isGrip then
				local value = if isAccent then 1 else if isBlade then 0.55 else 0.32
				d:SetAttribute("RainbowValue", value)
				d.Material = if isAccent then Enum.Material.Neon else Enum.Material.Metal
				d.Color = Color3.fromHSV(0.55, 0.65, value)
			end
		elseif mutation == "Void" then
			d.Color = if isAccent
				then Color3.fromRGB(180, 111, 255)
				else if isBlade then Color3.fromRGB(48, 29, 76) else Color3.fromRGB(24, 15, 37)
			if not isGrip then
				d.Material = if isAccent then Enum.Material.Neon else Enum.Material.Metal
			end
		end
	end
	if not blade then
		return
	end
	local glow = blade:FindFirstChild("BladeGlow") :: PointLight?
	if glow then
		glow.Color = Items.MutationById[mutation].Color
	end
	if mutation == "Gold" then
		sparkles(blade, ColorSequence.new(Color3.fromRGB(255, 230, 120)), 4, 0.35)
	elseif mutation == "Diamond" then
		sparkles(blade, ColorSequence.new(Color3.fromRGB(200, 250, 255)), 7, 0.4)
	elseif mutation == "Rainbow" then
		sparkles(
			blade,
			ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
			}),
			10,
			0.45
		)
		model:AddTag("RainbowKnife")
	elseif mutation == "Void" then
		sparkles(blade, ColorSequence.new(Color3.fromRGB(170, 90, 255), Color3.fromRGB(20, 0, 40)), 9, 0.55)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(140, 60, 255)
		light.Name = "MutationGlow"
		light.Range = 5
		light.Brightness = 0.6
		light.Parent = blade
	end
end

-- Static display model (pedestals, racks, carried over the head, menus). Takes a knife name or an
-- item string ("Katana|Gold|Huge"); mutations restyle it, sizes are applied by FitItem.
function KnifeModel.Build(item: string, anchored: boolean?): Model
	local parsed = Items.Parse(item)
	assert(parsed, `unknown knife {item}`)
	local name, knife = parsed.Name, parsed.Knife
	local source = template(name)
	local model: Model
	if source then
		model = source:Clone()
	else
		model = Instance.new("Model")
		model.Name = name
		model.PrimaryPart = assembleParts(model, knife)
		for _, p in model:GetChildren() do
			if p:IsA("BasePart") then
				local role = if p.Name == "Handle"
					then "Grip"
					else if p.Name == "Pommel" then "Guard" else if p.Name == "Tip" then "Blade" else p.Name
				finishPart(p, knife, role)
			end
		end
		local blade = model:FindFirstChild("Blade")
		if blade then
			local light = blade:FindFirstChildOfClass("PointLight")
			if light then
				light:Destroy()
			end
		end
		addBladeLight(model, knife)
	end
	local root = model.PrimaryPart :: BasePart
	root.Massless = false
	addTrail(model, knife)
	KnifeModel.ApplyMutation(model, parsed.Mutation.Id)
	model:SetAttribute("Item", item)
	model:SetAttribute("Silhouette", SILHOUETTE)
	if anchored then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.Anchored = true
			end
		end
	end
	return model
end

-- Rarity flourishes shared by both chest builds: chains on Epic+, embers and sparkles, a glow
function KnifeModel.DressCase(model: Model, seam: BasePart, color: Color3, rank: number)
	if rank >= 3 then
		for _, x in { -0.55, 0.55 } do
			local chain =
				part(model, "Chain", Vector3.new(0.14, 0.14, 2.3), CFrame.new(x, 1.3, 0), Color3.fromRGB(110, 110, 120))
			chain.Material = Enum.Material.DiamondPlate
		end
	end
	if rank >= 5 then
		-- Godly: a ring of embers around it
		sparkles(seam, ColorSequence.new(color, Color3.fromRGB(255, 200, 120)), 12, 0.5)
	elseif rank >= 2 then
		sparkles(seam, ColorSequence.new(color), 3 * rank, 0.35)
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8 + rank * 2
	light.Brightness = 1.5
	light.Parent = seam
end

-- A sealed case: what a watchman drops. Iron-banded crate with a glowing seam and lock in its
-- rarity's colour; better cases get gold trim, chains and a floating sigil. Opened (with a reveal)
-- once you carry it home. PrimaryPart "Handle" sits at its centre.
function KnifeModel.BuildCase(rarity: string, anchored: boolean?): Model
	local color = Knives.RarityColors[rarity] or Color3.new(1, 1, 1)
	local rank = table.find(Knives.Rarities, rarity) or 1
	local wood = Color3.fromRGB(110, 70, 40):Lerp(Color3.fromRGB(50, 28, 48), math.min((rank - 1) / 4, 1))
	local trim = if rank >= 4 then Color3.fromRGB(230, 180, 60) else Color3.fromRGB(70, 66, 78)
	if Props.Has("Chest") then
		-- The Blender chest, recoloured for its rarity
		local model = Props.Build("Chest", false)
		model.Name = `Case_{rarity}`
		local root = model.PrimaryPart :: BasePart
		root.Name = "Handle"
		root.Massless = false
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d ~= root then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.Massless = true
				if d.Name == "Lock" or d.Name == "Seam" then
					d.Color = color
					d.Material = Enum.Material.Neon
				elseif d.Name == "Wood" then
					d.Color = wood
				elseif d.Name == "Iron" then
					d.Color = trim
				end
			end
		end
		local seam = model:FindFirstChild("Seam") :: BasePart
		local sigil = part(
			model,
			"Sigil",
			Vector3.new(0.5, 0.5, 0.12),
			CFrame.new(0, 1.75, 0) * CFrame.Angles(0, 0, math.rad(45)),
			color
		)
		sigil.Material = Enum.Material.Neon
		KnifeModel.DressCase(model, seam, color, rank)
		weldAll(model, root)
		model:SetAttribute("Case", rarity)
		if anchored then
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
				end
			end
		end
		return model
	end
	local model = Instance.new("Model")
	model.Name = `Case_{rarity}`
	local root = part(model, "Handle", Vector3.new(0.4, 0.4, 0.4), CFrame.new(), Color3.new())
	root.Transparency = 1
	root.Massless = false
	local body = part(model, "Body", Vector3.new(2.8, 1.45, 1.9), CFrame.new(0, -0.2, 0), wood)
	body.Material = Enum.Material.WoodPlanks
	local lid =
		part(model, "Lid", Vector3.new(2.95, 0.55, 2.02), CFrame.new(0, 0.82, 0), wood:Lerp(Color3.new(1, 1, 1), 0.08))
	lid.Material = Enum.Material.WoodPlanks
	-- Glowing seam all the way round where the lid meets the box
	local seam = part(model, "Seam", Vector3.new(2.9, 0.09, 1.98), CFrame.new(0, 0.53, 0), color)
	seam.Material = Enum.Material.Neon
	-- Iron (or gold) straps and corner caps
	for _, x in { -0.95, 0.95 } do
		local band = part(model, "Band", Vector3.new(0.26, 2.12, 2.06), CFrame.new(x, 0.1, 0), trim)
		band.Material = Enum.Material.Metal
	end
	for _, x in { -1.42, 1.42 } do
		for _, y in { -0.88, 1.05 } do
			for _, z in { -0.96, 0.96 } do
				local cap = part(model, "Corner", Vector3.new(0.22, 0.22, 0.22), CFrame.new(x, y, z), trim)
				cap.Material = Enum.Material.Metal
			end
		end
	end
	-- The lock on the front, glowing, with a dark keyhole
	local lock = part(model, "Lock", Vector3.new(0.62, 0.7, 0.16), CFrame.new(0, 0.4, -1.04), color)
	lock.Material = Enum.Material.Neon
	part(model, "Keyhole", Vector3.new(0.12, 0.28, 0.05), CFrame.new(0, 0.36, -1.13), Color3.fromRGB(15, 10, 20))
	-- A rarity sigil hovering over the lid
	local sigil = part(
		model,
		"Sigil",
		Vector3.new(0.5, 0.5, 0.12),
		CFrame.new(0, 1.55, 0) * CFrame.Angles(0, 0, math.rad(45)),
		color
	)
	sigil.Material = Enum.Material.Neon
	KnifeModel.DressCase(model, seam, color, rank)
	weldAll(model, root)
	model.PrimaryPart = root
	model:SetAttribute("Case", rarity)
	if anchored then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end
	return model
end

-- Scales a knife so it is `length` studs from pommel to tip, whatever its catalog size
function KnifeModel.FitLength(model: Model, length: number)
	local _, size = model:GetBoundingBox()
	model:ScaleTo(model:GetScale() * length / math.max(size.X, size.Y, size.Z))
end

-- Size rolls still carry their bonuses and aura strength, not a different visual size.
function KnifeModel.FitItem(model: Model, _item: string, length: number)
	KnifeModel.FitLength(model, length)
end

-- Tool version, wielded in the hub and by the Murderer. The PrimaryPart is already called "Handle".
function KnifeModel.BuildTool(name: string): Tool
	local parsed = Items.Parse(name)
	assert(parsed, `unknown knife {name}`)
	local tool = Instance.new("Tool")
	tool.Name = Items.DisplayName(name)
	tool.ToolTip = Items.DisplayName(name)
	-- The knife's picture in the hotbar, not its name
	tool.TextureId = KnifeIcons[parsed.Knife.Name] or ""
	tool.CanBeDropped = false
	-- Clicks are handled by the client (tap = stab, hold = throw), which calls Activate() on a tap
	tool.ManualActivationOnly = true
	-- Held upright in the fist, MM2 style: tip pointing at the sky. (Measured in Studio: R15's
	-- RightGripAttachment is already turned -90 on X, so a plain grip stands the blade straight up.)
	tool.Grip = CFrame.new()
	local model = KnifeModel.Build(name, false)
	KnifeModel.FitLength(model, TOOL_LENGTH)
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	if model:HasTag("RainbowKnife") then
		tool:AddTag("RainbowKnife")
	end
	model:Destroy()
	return tool
end

return KnifeModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[--!strict
-- Custom props made in Blender (blender/scripts/make_props.py), uploaded like the knives, and
-- turned into templates at startup (Preload, server). Everything else asks for a prop by name and
-- gets a Model whose PrimaryPart "Root" sits at the prop's origin. If a mesh isn't uploaded yet (or
-- fails to load), a part-built stand-in is used, so the game never breaks waiting on assets.
--   Props.Build("Skull") -> Model

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PropMeshes = require(script.Parent.Config.PropMeshes)

local Props = {}

local TEMPLATE_FOLDER = "PropTemplates"

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

local function weldAll(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
end

local function newModel(name: string): (Model, Part)
	local model = Instance.new("Model")
	model.Name = name
	local root = part(model, "Root", Vector3.new(0.2, 0.2, 0.2), CFrame.new(), Color3.new())
	root.Transparency = 1
	model.PrimaryPart = root
	return model, root
end

-- Part-built stand-ins, roughly the same size and look as the meshes
local fallbacks: { [string]: (Model) -> () } = {
	Coin = function(m)
		local face = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis along Z: the coin faces -Z
		local gold =
			part(m, "Gold", Vector3.new(0.3, 2.2, 2.2), face, Color3.fromRGB(255, 190, 40), Enum.Material.Metal)
		gold.Shape = Enum.PartType.Cylinder
		local emblem =
			part(m, "Emblem", Vector3.new(0.36, 1, 1), face, Color3.fromRGB(255, 225, 120), Enum.Material.Metal)
		emblem.Shape = Enum.PartType.Cylinder
	end,
	Pedestal = function(m)
		local stone = part(
			m,
			"Stone",
			Vector3.new(1.17, 3.5, 3.5),
			CFrame.new(0, 0.585, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(70, 64, 82),
			Enum.Material.Slate
		)
		stone.Shape = Enum.PartType.Cylinder
		local glow = part(
			m,
			"Glow",
			Vector3.new(0.08, 2.6, 2.6),
			CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(90, 220, 255),
			Enum.Material.Neon
		)
		glow.Shape = Enum.PartType.Cylinder
	end,
	LootSack = function(m)
		local sack = part(
			m,
			"Sack",
			Vector3.new(2.2, 2.4, 2.0),
			CFrame.new(0, 1.1, 0),
			Color3.fromRGB(150, 110, 70),
			Enum.Material.Fabric
		)
		sack.Shape = Enum.PartType.Ball
		part(
			m,
			"Tie",
			Vector3.new(0.7, 0.5, 0.7),
			CFrame.new(0, 2.4, 0),
			Color3.fromRGB(90, 60, 35),
			Enum.Material.Fabric
		)
	end,
	BurglarMask = function(m)
		part(
			m,
			"Mask",
			Vector3.new(1.3, 0.38, 0.12),
			CFrame.new(0, 0, 0),
			Color3.fromRGB(15, 15, 18),
			Enum.Material.Fabric
		)
	end,
	Skull = function(m)
		local bone = Color3.fromRGB(235, 228, 205)
		part(m, "Cranium", Vector3.new(1.3, 1.2, 1.3), CFrame.new(0, 0.1, 0), bone).Shape = Enum.PartType.Ball
		part(m, "Jaw", Vector3.new(0.9, 0.4, 0.8), CFrame.new(0, -0.5, -0.15), bone)
		for _, x in { -0.28, 0.28 } do
			part(
				m,
				"Eye",
				Vector3.new(0.32, 0.32, 0.2),
				CFrame.new(x, 0.12, -0.58),
				Color3.fromRGB(255, 40, 40),
				Enum.Material.Neon
			)
		end
	end,
	Crystal = function(m)
		part(
			m,
			"Crystal",
			Vector3.new(1.1, 2.6, 1.1),
			CFrame.new(0, 1.3, 0) * CFrame.Angles(0, math.rad(45), 0),
			Color3.fromRGB(170, 70, 255),
			Enum.Material.Neon
		)
	end,
	Chandelier = function(m)
		local iron = Color3.fromRGB(40, 36, 46)
		part(m, "Chain", Vector3.new(0.2, 3, 0.2), CFrame.new(0, 1.5, 0), iron, Enum.Material.Metal)
		local ring = part(
			m,
			"Ring",
			Vector3.new(0.4, 5, 5),
			CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
			iron,
			Enum.Material.Metal
		)
		ring.Shape = Enum.PartType.Cylinder
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			part(
				m,
				"Candle",
				Vector3.new(0.3, 0.8, 0.3),
				CFrame.new(math.cos(a) * 2.2, 0.6, math.sin(a) * 2.2),
				Color3.fromRGB(240, 230, 210)
			)
			part(
				m,
				"Flame",
				Vector3.new(0.25, 0.35, 0.25),
				CFrame.new(math.cos(a) * 2.2, 1.15, math.sin(a) * 2.2),
				Color3.fromRGB(255, 180, 70),
				Enum.Material.Neon
			)
		end
	end,
	Sconce = function(m)
		local iron = Color3.fromRGB(45, 40, 50)
		part(m, "Plate", Vector3.new(0.8, 1.4, 0.2), CFrame.new(0, 0, 0), iron, Enum.Material.Metal)
		part(m, "Arm", Vector3.new(0.25, 0.25, 0.9), CFrame.new(0, -0.2, -0.5), iron, Enum.Material.Metal)
		part(m, "Cup", Vector3.new(0.6, 0.4, 0.6), CFrame.new(0, 0, -0.95), iron, Enum.Material.Metal)
		part(
			m,
			"Flame",
			Vector3.new(0.3, 0.5, 0.3),
			CFrame.new(0, 0.4, -0.95),
			Color3.fromRGB(255, 170, 70),
			Enum.Material.Neon
		)
	end,
	Lantern = function(m)
		local iron = Color3.fromRGB(40, 36, 46)
		part(m, "Cap", Vector3.new(1.2, 0.3, 1.2), CFrame.new(0, 0.85, 0), iron, Enum.Material.Metal)
		part(
			m,
			"Glass",
			Vector3.new(0.9, 1.3, 0.9),
			CFrame.new(0, 0, 0),
			Color3.fromRGB(255, 200, 120),
			Enum.Material.Neon
		).Transparency =
			0.2
		part(m, "Base", Vector3.new(1.1, 0.25, 1.1), CFrame.new(0, -0.75, 0), iron, Enum.Material.Metal)
	end,
	Camera = function(m)
		part(m, "Body", Vector3.new(1, 0.65, 0.5), CFrame.new(), Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
		local lens = part(
			m,
			"Lens",
			Vector3.new(0.4, 0.5, 0.5),
			CFrame.new(0, 0, -0.35) * CFrame.Angles(0, math.rad(90), 0),
			Color3.fromRGB(60, 60, 70),
			Enum.Material.Glass
		)
		lens.Shape = Enum.PartType.Cylinder
		part(
			m,
			"Bulb",
			Vector3.new(0.35, 0.2, 0.2),
			CFrame.new(0.25, 0.4, 0),
			Color3.fromRGB(255, 255, 220),
			Enum.Material.Neon
		)
	end,
}

-- Server only: make a template per prop from PropMeshes. Yields a little.
function Props.Preload()
	assert(RunService:IsServer(), "Props.Preload runs on the server")
	if ReplicatedStorage:FindFirstChild(TEMPLATE_FOLDER) then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = TEMPLATE_FOLDER
	local pending = 0
	for name, specs in PropMeshes do
		pending += 1
		task.spawn(function()
			local model, root = newModel(name)
			local ok, err = pcall(function()
				for _, spec in specs do
					local mesh = AssetService:CreateMeshPartAsync(Content.fromUri(spec.MeshId))
					mesh.Name = spec.Name
					mesh.Size = spec.Size
					mesh.CFrame = CFrame.new(spec.Offset)
					mesh.Color = spec.Color
					mesh.Material = (Enum.Material :: any)[spec.Material] or Enum.Material.SmoothPlastic
					mesh.CanCollide = false
					mesh.CanQuery = false
					mesh.CanTouch = false
					mesh.Massless = true
					mesh.Parent = model
				end
			end)
			if ok then
				weldAll(model, root)
				model.Parent = folder
			else
				warn(`[Props] mesh prop {name} failed, using parts: {err}`)
			end
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 15 do
		task.wait(0.1)
	end
	folder.Parent = ReplicatedStorage
end

-- Whether the Blender mesh version of a prop is loaded
function Props.Has(name: string): boolean
	local folder = ReplicatedStorage:FindFirstChild(TEMPLATE_FOLDER)
	return folder ~= nil and folder:FindFirstChild(name) ~= nil
end

-- A fresh copy of a prop, unanchored and welded (anchor it yourself if it stays put)
function Props.Build(name: string, anchored: boolean?): Model
	local folder = ReplicatedStorage:FindFirstChild(TEMPLATE_FOLDER)
	local template = folder and folder:FindFirstChild(name) :: Model?
	local model: Model
	if template then
		model = template:Clone()
	else
		local root
		model, root = newModel(name)
		local build = fallbacks[name]
		assert(build, `unknown prop {name}`)
		build(model)
		weldAll(model, root)
	end
	if anchored then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end
	return model
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">SignTheme</string>
          <string name="Source"><![CDATA[--!strict
-- World-space counterparts of the illustrated menus. Presentation only.
local Art = require(script.Parent.Config.MenuArtwork)
local Textures = require(script.Parent.Config.Textures)
local SignTheme = {}
SignTheme.Green = Color3.fromRGB(45, 244, 15)
SignTheme.Gold = Color3.fromRGB(255, 207, 28)
local black = Color3.fromRGB(4, 7, 12)

function SignTheme.surface(panel: Frame, color: Color3)
	panel.BackgroundColor3 = color
	panel.BorderSizePixel = 0
	panel.ClipsDescendants = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = panel
	local edge = Instance.new("UIStroke")
	edge.Color, edge.Thickness, edge.ApplyStrokeMode = black, 3, Enum.ApplyStrokeMode.Border
	edge.Parent = panel
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.18), color:Lerp(Color3.new(0, 0, 0), 0.14))
	gradient.Parent = panel
	local studs = Instance.new("ImageLabel")
	studs.Name = "Studs"
	studs.BackgroundTransparency = 1
	studs.Size = UDim2.fromScale(1, 1)
	studs.Image = Textures.Toy.Stud
	studs.ScaleType, studs.TileSize = Enum.ScaleType.Tile, UDim2.fromOffset(44, 44)
	studs.ImageTransparency = 0.28
	studs.Parent = panel
end

function SignTheme.text(label: TextLabel, maximum: number)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled, label.TextWrapped = true, false
	label.ZIndex = 2
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize, constraint.MaxTextSize = 10, maximum
	constraint.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Color, stroke.Thickness = black, 2.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
end

function SignTheme.cashIcon(parent: Instance, position: UDim2, size: UDim2)
	local icon = Instance.new("ImageLabel")
	icon.Name = "CashArt"
	icon.BackgroundTransparency = 1
	icon.Position, icon.Size = position, size
	icon.Image = Art.Icons
	local cell = Art.IconSize / 3
	icon.ImageRectOffset, icon.ImageRectSize = Vector2.new(0, cell.Y), cell
	icon.ScaleType, icon.ZIndex = Enum.ScaleType.Fit, 2
	icon.Parent = parent
	return icon
end

return SignTheme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Toy</string>
          <string name="Source"><![CDATA[--!strict
-- The toy look (Steal An Egg style): saturated flat colours covered in small classic studs, with a
-- two-tone checker every few studs. Both are tinted by the part's own colour, so one call dresses
-- any floor or wall. Textures are per face, so only dress the faces people see.
-- Every boundary wall in the hub uses the same DirtWall (tan dirt + studs + a grass cap), so the
-- vault area and the runway read as one place.

local Textures = require(script.Parent.Config.Textures)

local Toy = {}

-- Matched to how Steal An Egg renders (their grass ~(78,203,47), dirt ~(196,139,87) on screen)
Toy.Grass = Color3.fromRGB(48, 146, 30)
Toy.Dirt = Color3.fromRGB(214, 146, 78)

local function texture(part: BasePart, face: Enum.NormalId, id: string, tile: number, name: string): Texture
	local t = Instance.new("Texture")
	t.Name = name
	t.Texture = id
	t.Face = face
	t.StudsPerTileU = tile
	t.StudsPerTileV = tile
	t.Parent = part
	return t
end

-- studSize: studs per stud (default 1); checker: studs per checker square (0 = none)
function Toy.Dress(part: BasePart, faces: { Enum.NormalId }?, studSize: number?, checker: number?)
	part.Material = Enum.Material.SmoothPlastic
	local square = checker or 8
	local list: { Enum.NormalId } = faces or { Enum.NormalId.Top }
	for _, face in list do
		-- The stud image holds 2x2 studs
		texture(part, face, Textures.Toy.Stud, (studSize or 1) * 2, "Studs")
		if square > 0 then
			-- The checker image holds 2x2 squares
			-- Faint, like Steal An Egg's: the two shades blend rather than stand out
			texture(part, face, Textures.Toy.Checker, square * 2, "Checker").Transparency = 0.55
		end
	end
end

-- Every face but the bottom (walls you can see from both sides, posts)
Toy.Sides = {
	Enum.NormalId.Top,
	Enum.NormalId.Front,
	Enum.NormalId.Back,
	Enum.NormalId.Left,
	Enum.NormalId.Right,
}

-- The hub's one wall style: studded tan dirt in a checker with a strip of grass along the top.
-- Expects an axis-aligned (unrotated or 90-degree-turned) wall.
function Toy.DirtWall(part: BasePart, color: Color3?): Part
	part.Color = color or Toy.Dirt
	Toy.Dress(part, {
		Enum.NormalId.Front,
		Enum.NormalId.Back,
		Enum.NormalId.Left,
		Enum.NormalId.Right,
	}, 1, 4)
	local cap = Instance.new("Part")
	cap.Name = "GrassCap"
	cap.Anchored = true
	cap.CanCollide = false
	cap.CanQuery = false
	cap.CanTouch = false
	cap.Size = Vector3.new(part.Size.X + 0.8, 1.6, part.Size.Z + 0.8)
	cap.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + 0.5, 0)
	cap.Color = Toy.Grass
	cap.TopSurface = Enum.SurfaceType.Smooth
	cap.BottomSurface = Enum.SurfaceType.Smooth
	cap.Parent = part.Parent
	Toy.Dress(cap, Toy.Sides, 1, 0)
	return cap
end

return Toy
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="27">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="28">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point. Order matters: the map exists before anything uses it, and DataService
-- starts loading players last so every service is already listening for PlayerLoaded.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Nobody spawns until the world exists (building it takes a few seconds); CombatService handles
-- respawns after that
Players.CharacterAutoLoads = false

local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local Props = require(ReplicatedStorage.Shared.Props)
local Services = script.Parent.Services
local MapService = require(Services.MapService)
local BaseService = require(Services.BaseService)
local StealService = require(Services.StealService)
local GuardService = require(Services.GuardService)
local UpgradeService = require(Services.UpgradeService)
local InventoryService = require(Services.InventoryService)
local CombatService = require(Services.CombatService)
local PowerService = require(Services.PowerService)
local RaidService = require(Services.RaidService)
local Rewards = require(Services.Rewards)
local ShopNPCs = require(Services.ShopNPCs)
local MonetizationService = require(Services.MonetizationService)
local RoundService = require(Services.RoundService)
local ServerEvents = require(Services.ServerEvents)
local Social = require(Services.Social)
local TradeService = require(Services.TradeService)
local DataService = require(Services.DataService)
local DebugService = require(Services.DebugService)

-- Each step is timed; the summary prints once the server is ready (startup time is how long the
-- first players wait for a character)
local timings: { string } = {}
local startedAt = os.clock()
local function timed(name: string, fn: () -> ())
	local t = os.clock()
	fn()
	table.insert(timings, string.format("%s %.0fms", name, (os.clock() - t) * 1000))
end

-- Blender mesh knives and props download side by side (both before anything uses them): the
-- slowest part of a server start, and the first players are waiting on it
timed("Meshes", function()
	local done = 0
	task.spawn(function()
		KnifeModel.Preload()
		done += 1
	end)
	task.spawn(function()
		Props.Preload()
		done += 1
	end)
	while done < 2 do
		task.wait()
	end
end)
timed("Social", Social.Init)
timed("Events", ServerEvents.Init)
timed("Map", MapService.Init)
timed("Base", BaseService.Init)
timed("Steal", StealService.Init)
timed("Guard", GuardService.Init)
timed("Upgrade", UpgradeService.Init)
timed("Inventory", InventoryService.Init)
timed("Combat", CombatService.Init)
timed("Power", PowerService.Init)
timed("Raid", RaidService.Init)
timed("Rewards", Rewards.Init)
timed("Shops", ShopNPCs.Init)
timed("Monetization", MonetizationService.Init)
timed("Round", RoundService.Init)
timed("Trade", TradeService.Init)
timed("Debug", DebugService.Init)

-- BaseService claims the vault on PlayerLoaded before this deferred initial spawn.
DataService.PlayerLoaded:Connect(function(player: Player)
	task.defer(function()
		if player.Parent and not player.Character then
			player:LoadCharacterAsync()
		end
	end)
end)
DataService.Init()

print(string.format("[Steal a Knife] server ready in %.1fs (%s)", os.clock() - startedAt, table.concat(timings, ", ")))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- All client<->server traffic. Clients can only ask; the server validates and decides everything.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"
folder.Parent = ReplicatedStorage

local function event(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

local function func(name: string): RemoteFunction
	local remote = Instance.new("RemoteFunction")
	remote.Name = name
	remote.Parent = folder
	return remote
end

local Remotes = {
	Notify = event("Notify"), -- server -> client: (text, kind)
	Role = event("Role"), -- server -> client: ("Murderer" | "Innocent", disguiseName)
	Purchase = func("Purchase"), -- client -> server: (kind) -> (ok, message)
	Equip = func("Equip"), -- client -> server: (knifeName) -> ok
	Sell = func("Sell"), -- client -> server: (rackIndex) -> ok
	Ability = event("Ability"), -- client -> server: (aimDirection: Vector3)
	Shoot = event("Shoot"), -- client -> server: (aimPosition: Vector3) while holding the Revolver
	Stab = event("Stab"), -- client -> server: (target: Model?) who the Murderer's swing is aimed at; only a hint the server re-checks
	AbilityState = event("AbilityState"), -- server -> client: (name?, cooldownEndsAt?) name=nil hides it
	Effect = event("Effect"), -- server -> all clients: (kind, ...) cosmetic only
	Anim = event("Anim"), -- server -> clients: (model, clipName) play an AnimLibrary clip
	Charge = event("Charge"), -- client -> server: (charging: boolean) winding up a throw
	Power = func("Power"), -- client -> server: (action "Buy" | "Equip" | "Unequip" | "Slot", powerId?) -> ok
	UsePower = event("UsePower"), -- client -> server: (powerId, aimDirection)
	Debug = func("Debug"), -- Studio-only client -> server test commands
	Tutorial = event("Tutorial"), -- client -> server: (step) the first-minute guide moved on
	RepairGate = event("RepairGate"), -- client -> server: () hold-to-repair your gate in a raid
	ClaimIndex = func("ClaimIndex"), -- client -> server: (knifeName | "All") -> ok
	Welcome = event("Welcome"), -- server -> client: ({ Offline, Away, Streak, DailyReady }) on join
	ClaimDaily = func("ClaimDaily"), -- client -> server: () -> (ok, message) today's login-streak reward
	Offer = event("Offer"), -- server -> client: (storeKey, reason) a contextual store offer
	TeamUp = event("TeamUp"), -- client -> server: ("Invite" | "Accept" | "Decline", userId) / ("Leave")
	Trade = func("Trade"), -- client -> server: (action, ...) -> ok, see TradeService
	SlowMode = event("SlowMode"), -- client -> server: (on: boolean) walk at normal speed in the hub
	StoreTest = func("StoreTest"), -- client -> server: (kind, key) Studio-only fake purchase for unset ids
}

return {
	Remotes = Remotes,
	-- kind: "info" | "good" | "bad"
	Notify = function(player: Player, text: string, kind: string?)
		Remotes.Notify:FireClient(player, text, kind or "info")
	end,
	-- A big banner across everyone's screen (rare unboxes, raids, thefts). hype 1..4 = how loud.
	Announce = function(text: string, color: Color3, hype: number?)
		Remotes.Effect:FireAllClients("Announce", text, color, hype or 1)
	end,
	-- Plays an AnimLibrary clip on a character/guard for everyone. `except` is the player who
	-- already started it locally (their own swing), so they don't see it twice.
	Animate = function(model: Model, clip: string, except: Player?)
		for _, player in game:GetService("Players"):GetPlayers() do
			if player ~= except then
				Remotes.Anim:FireClient(player, model, clip)
			end
		end
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
-- Each player gets a vault: a safe zone with a knife rack that pays cash every second.
-- Also owns character placement and walk speed, since both depend on where the player "lives".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local SignTheme = require(ReplicatedStorage.Shared.SignTheme)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Items = require(ReplicatedStorage.Shared.Items)
local Knives = require(ReplicatedStorage.Shared.Config.Knives)
local KnifeModel = require(ReplicatedStorage.Shared.KnifeModel)
local KnifeAura = require(ReplicatedStorage.Shared.KnifeAura)
local Net = require(script.Parent.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local Fuel = require(script.Parent.Fuel)
local ServerEvents = require(script.Parent.ServerEvents)
local Social = require(script.Parent.Social)
local MapService = require(script.Parent.MapService)
local VaultWalls = require(script.Parent.VaultWalls)

local BaseService = {}

local owners: { [number]: Player } = {} -- base index -> player
local baseOf: { [Player]: MapService.BaseSite } = {}
local rackModels: { [Player]: Folder } = {}

-- Set by InventoryService: called when the owner uses a prompt on one of their mounted knives
BaseService.OnSellPrompt = nil :: ((Player, number) -> ())?
BaseService.OnEquipPrompt = nil :: ((Player, string) -> ())?
-- Set by RaidService: someone held "Steal" on a knife on another player's wall
BaseService.OnStealPrompt = nil :: ((Player, Player, number) -> ())?
-- Set by RaidService: a vault's walls were rebuilt (new tier, or the vault changed hands)
BaseService.OnWallsBuilt = nil :: ((MapService.BaseSite, Player?) -> ())?
BaseService.OnUpgradeWalls = nil :: ((Player) -> ())?
-- Set by StealService: the owner pressed Place on their next empty plate while carrying a knife
BaseService.OnPlacePrompt = nil :: ((Player, number) -> ())?
-- Set by UpgradeService: the owner pressed Upgrade Base at the sign by their gate
BaseService.OnUpgradeBase = nil :: ((Player) -> ())?

-- Rebirths multiply everything a vault earns
function BaseService.IncomeMultiplier(player: Player): number
	local profile = DataService.Get(player)
	local multiplier = 1 + (if profile then profile.Rebirths * GameConfig.Rebirth.IncomeBonus else 0)
	-- Game passes (MonetizationService sets these attributes)
	if player:GetAttribute("Pass_DoubleCash") then
		multiplier *= 2
	end
	if player:GetAttribute("Pass_VIP") then
		multiplier *= 1.1
	end
	-- 🔥 Heat from playing both games, friends playing with you, and the server's Cash Rush
	multiplier *= Fuel.IncomeMultiplier(player) * Social.FriendsMultiplier(player)
	if ServerEvents.Active("CashRush") then
		multiplier *= 2
	end
	return multiplier
end

function BaseService.RackIncome(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	local total = 0
	for i, item in profile.Knives do
		if i > profile.Slots then
			break
		end
		total += Items.Income(item)
	end
	return total * BaseService.IncomeMultiplier(player)
end
local rackIncome = BaseService.RackIncome

-- The knife a player fights with (equipped, or their hardest-hitting one) can never be stolen or
-- looted - nobody loses their weapon
function BaseService.ProtectedItem(player: Player): string?
	local profile = DataService.Get(player)
	if not profile or #profile.Knives == 0 then
		return nil
	end
	if profile.Equipped ~= "" and table.find(profile.Knives, profile.Equipped) then
		return profile.Equipped
	end
	local best, bestDamage = nil, -1
	for _, item in profile.Knives do
		local damage = Items.Damage(item)
		if damage > bestDamage then
			best, bestDamage = item, damage
		end
	end
	return best
end

function BaseService.OwnerOf(base: MapService.BaseSite): Player?
	return owners[base.Index]
end

-- The vault this point is in (and who owns it)
function BaseService.BaseAt(position: Vector3): (MapService.BaseSite?, Player?)
	for _, base in MapService.Bases do
		if MapService.InBounds(base.Bounds, position) then
			return base, owners[base.Index]
		end
	end
	return nil, nil
end

-- Walls and gate for the owner's tier (tier 1 for an empty vault)
function BaseService.RefreshWalls(base: MapService.BaseSite)
	local owner = owners[base.Index]
	local profile = owner and DataService.Get(owner)
	local tier = if profile then profile.WallLevel else 1
	local floors = if profile then GameConfig.FloorsFor(profile.Slots) else 1
	MapService.SetFloors(base, floors)
	local built = VaultWalls.Build(base.WallFolder, base.Frame, base.Color, tier, floors)
	base.Gate = built.Gate
	base.Blocker = built.Blocker
	-- Fortified Vault pass: +50% gate health on every tier
	if owner and owner:GetAttribute("Pass_Fortified") then
		local max = (built.Blocker:GetAttribute("MaxHealth") or 0) :: number
		built.Blocker:SetAttribute("MaxHealth", max * 1.5)
		built.Blocker:SetAttribute("Health", max * 1.5)
	end
	base.Blocker:SetAttribute("Owner", if owner then owner.UserId else nil)
	base.Blocker:SetAttribute("OwnerName", if owner then owner.DisplayName else nil)
	local nextTier = GameConfig.Walls[tier + 1]
	if owner and nextTier then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "UpgradeWalls"
		prompt.ActionText = `Upgrade Walls ({Format.Cash(nextTier.Cost)})`
		prompt.ObjectText = `{GameConfig.Walls[tier].Name} - {GameConfig.Walls[tier].GateHealth} HP`
		prompt.KeyboardKeyCode = Enum.KeyCode.G
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("WallUpgrade", true)
		prompt:SetAttribute("Owner", owner.UserId)
		prompt.Triggered:Connect(function(player)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if
				player == owner
				and root
				and not player:GetAttribute("InRound")
				and (root.Position - base.Blocker.Position).Magnitude <= 15
				and BaseService.OnUpgradeWalls
			then
				BaseService.OnUpgradeWalls(player)
			end
		end)
		prompt.Parent = base.Blocker
	end
	-- The Upgrade Base sign by the gate: the owner buys the next floor there
	local upgradeSign = base.Folder:FindFirstChild("UpgradeSign")
	local board = upgradeSign and upgradeSign:FindFirstChild("Board") :: BasePart?
	if board then
		local old = board:FindFirstChild("UpgradeBase")
		if old then
			old:Destroy()
		end
		if owner then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "UpgradeBase"
			prompt.ActionText = "Upgrade Base"
			prompt.ObjectText = "+1 floor, 10 more plates"
			prompt.HoldDuration = 0.3
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("Owner", owner.UserId)
			prompt.Triggered:Connect(function(player)
				if player == owner and not player:GetAttribute("InRound") and BaseService.OnUpgradeBase then
					BaseService.OnUpgradeBase(player)
				end
			end)
			prompt.Parent = board
		end
	end
	-- The vault's sign rides on top of its back wall
	base.SignPart.CFrame = base.Frame * CFrame.new(0, built.BackHeight + 2.4, -22)
	if BaseService.OnWallsBuilt then
		BaseService.OnWallsBuilt(base, owner)
	end
end

function BaseService.GetBase(player: Player): MapService.BaseSite?
	return baseOf[player]
end

function BaseService.IsInOwnBase(player: Player, position: Vector3): boolean
	local base = baseOf[player]
	return base ~= nil and MapService.InBounds(base.Bounds, position)
end

function BaseService.IsInAnyBase(position: Vector3): boolean
	for _, base in MapService.Bases do
		if MapService.InBounds(base.Bounds, position, 2) then
			return true
		end
	end
	return false
end

-- Where a murder round pulled someone from: the next trip "home" goes back there instead
-- (whether they survived the round or respawned after dying in it). The rule: a round never
-- moves you in the hub.
local returnSpots: { [Player]: CFrame? } = {}
function BaseService.SetReturnSpot(player: Player, spot: CFrame?)
	returnSpots[player] = spot
end
Players.PlayerRemoving:Connect(function(player)
	returnSpots[player] = nil
end)

function BaseService.TeleportHome(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local base = baseOf[player]
	local destination = if base then base.Spawn else MapService.LobbySpawn
	local spot = returnSpots[player]
	if spot and not player:GetAttribute("InRound") then
		returnSpots[player] = nil
		destination = spot
	end
	task.spawn(function()
		-- Load the vault on their client first so StreamingEnabled doesn't pause them on arrival,
		-- but never wait long: a slow stream must not leave them stranded
		local streamed = false
		task.spawn(function()
			pcall(player.RequestStreamAroundAsync, player, destination.Position, 3)
			streamed = true
		end)
		local started = os.clock()
		while not streamed and os.clock() - started < 1.5 do
			task.wait()
		end
		-- Move them, and make sure it stuck (their client owns the character and can fight a move)
		for _ = 1, 3 do
			if not character.Parent then
				return
			end
			character:PivotTo(destination)
			task.wait(0.4)
			local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root or (root.Position - destination.Position).Magnitude < 30 then
				return
			end
		end
	end)
end

-- (Knife trails are bought - GameConfig.Trails, profile.TrailLevel - and drawn by client/KnifeTrails)

-- Single source of truth for walk speed: round > carrying > upgrades
function BaseService.RefreshWalkSpeed(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local profile = DataService.Get(player)
	local speed = GameConfig.WalkSpeedFor(if profile then profile.Speed else 0)
	-- Slow mode: plain walking speed, for getting around your vault without overshooting
	if player:GetAttribute("SlowMode") then
		speed = GameConfig.WalkSpeedFor(0)
	end
	if player:GetAttribute("InRound") then
		speed = if player:GetAttribute("Role") == "Murderer"
			then (if player:GetAttribute("KnifeOut") then GameConfig.MurdererWalkSpeed else GameConfig.RoundWalkSpeed)
			else GameConfig.RoundWalkSpeed
		-- Sneakers and knife perks (both set by RoundService, cleared when the round ends)
		speed += (player:GetAttribute("RoundSpeedBonus") or 0) :: number
		speed += (player:GetAttribute("PerkSpeed") or 0) :: number
	else
		if player:GetAttribute("Carrying") then
			speed *= GameConfig.CarrySpeedMultiplier
		end
		-- Pushing through the aura of someone else's powerful knives
		local aura = player:GetAttribute("AuraSlow")
		if type(aura) == "number" then
			speed *= aura
		end
	end
	-- Caught in a bear trap
	local stunnedUntil = player:GetAttribute("StunnedUntil")
	if type(stunnedUntil) == "number" and workspace:GetServerTimeNow() < stunnedUntil then
		speed = 0
	end
	humanoid.WalkSpeed = speed
end

-- The label floating over a knife on its pedestal (Steal a Brainrot style): its name in its
-- colour, its rarity, and what it earns
local function nameplate(parent: Instance, adornee: BasePart, item: string, perSecond: number)
	local parsed = Items.Parse(item) :: Items.Item
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate"
	gui.Size = UDim2.fromOffset(170, 54)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4.4, 0)
	gui.MaxDistance = 40
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = parent
	local lines = {
		{ Text = parsed.Knife.Rarity, Color = Knives.RarityColors[parsed.Knife.Rarity], Height = 16 },
		{ Text = Items.DisplayName(item), Color = Color3.new(1, 1, 1), Height = 20 },
		{
			Text = `{Format.Cash(math.floor(perSecond * 10 + 0.5) / 10)}/s`,
			Color = Color3.fromRGB(110, 255, 110),
			Height = 18,
		},
	}
	-- Its Murderer power, so you know what it does in a round
	local perk = parsed.Perk and GameConfig.Perks[parsed.Perk]
	if perk then
		table.insert(lines, 1, {
			Text = `🔪 {perk.DisplayName} · Murderer power`,
			Color = Color3.fromRGB(255, 120, 140),
			Height = 15,
		})
		gui.Size = UDim2.fromOffset(190, 70)
	end
	local y = 0
	for _, line in lines do
		local label = Instance.new("TextLabel")
		label.Position = UDim2.fromOffset(0, y)
		label.Size = UDim2.new(1, 0, 0, line.Height)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.TextStrokeTransparency = 0
		label.Text = line.Text
		label.Parent = gui
		y += line.Height
	end
end

-- The aura a mounted knife gives off. Better knives (rarity, mutation, size) get a wider, more
-- dramatic upright flame. The floor ring still shows the unchanged slowdown radius.
local function aura(folder: Instance, model: Model, base: MapService.BaseSite, item: string, color: Color3)
	local power = Items.AuraPower(item)
	local boxCF, boxSize = model:GetBoundingBox()
	local anchor = Instance.new("Part")
	anchor.Name = "Aura"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(boxCF.Position - Vector3.new(0, boxSize.Y * 0.2, 0))
	anchor.Parent = folder
	local clearance: number? = nil
	local level = math.floor((boxCF.Position.Y - base.Frame.Position.Y) / MapService.FloorHeight) + 1
	if level < MapService.Floors then
		clearance = base.Frame.Position.Y + level * MapService.FloorHeight - 1.5 - anchor.Position.Y
	end
	KnifeAura.Mount(anchor, KnifeAura.Power(item), clearance)
	if power >= 1 then
		-- How far it reaches, as a faint glowing circle on the floor
		local radius = Items.AuraRadius(power)
		local floorPoint = (base.Frame * CFrame.new(0, 0.62, 0)).Position
		local center = Vector3.new(boxCF.Position.X, floorPoint.Y, boxCF.Position.Z)
		local ring = Instance.new("Part")
		ring.Name = "AuraRing"
		ring.Shape = Enum.PartType.Cylinder
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.CastShadow = false
		ring.Material = Enum.Material.Neon
		ring.Color = color
		ring.Transparency = 0.95
		ring.Size = Vector3.new(0.05, radius * 2, radius * 2)
		ring.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = folder
		ring:AddTag("AuraRing")
		ring:SetAttribute("Power", power)
		-- A glowing dashed edge marks exactly where the slowdown starts
		local dashes = math.clamp(math.floor(radius * 1.6), 12, 40)
		for i = 0, dashes - 1 do
			local angle = i / dashes * math.pi * 2
			local dash = Instance.new("Part")
			dash.Name = "AuraEdge"
			dash.Anchored = true
			dash.CanCollide = false
			dash.CanQuery = false
			dash.CanTouch = false
			dash.CastShadow = false
			dash.Material = Enum.Material.Neon
			dash.Color = color
			dash.Transparency = 0.35
			dash.Size = Vector3.new(0.25, 0.08, 2 * math.pi * radius / dashes * 0.55)
			dash.CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * radius, 0.03, math.sin(angle) * radius))
				* CFrame.Angles(0, -angle, 0)
			dash.Parent = folder
		end
	end
end

local function makePrompt(parent: Instance, props: { [string]: any }): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.HoldDuration = 0
	p.MaxActivationDistance = 8
	p.RequiresLineOfSight = false
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

-- Carrying a knife (not a case) right now
local function carryingKnife(player: Player): boolean
	local carrying = player:GetAttribute("Carrying")
	return type(carrying) == "string" and carrying:sub(1, 5) ~= "Case:"
end

-- Worth a second tap before it's sold: rare knives, mutations, big sizes
local function precious(item: string): boolean
	local parsed = Items.Parse(item)
	return parsed ~= nil
		and (Knives.Rank(parsed.Knife.Rarity) >= 4 or parsed.Mutation.Rank > 0 or parsed.Size.Rank >= 2)
end

-- Tsunami-style sell sign: a thin board standing between the plate and its cash pad, leaning back a
-- little, "SELL $11K". Tap / click it to sell (precious knives ask for a second tap).
local function sellSign(
	folder: Instance,
	base: MapService.BaseSite,
	owner: Player,
	plate: number,
	index: number,
	item: string
)
	local pad = base.CashPads[plate]
	local stone = base.SlotPads[plate]
	if not pad or not stone then
		return
	end
	local toPlate = (stone.Position - pad.Position) * Vector3.new(1, 0, 1)
	if toPlate.Magnitude < 0.1 then
		return
	end
	toPlate = toPlate.Unit
	local at = pad.Position + toPlate * 2.9 + Vector3.new(0, 1.1, 0)
	local board = Instance.new("Part")
	board.Name = "SellSign"
	board.Anchored = true
	board.CanCollide = false
	board.CanTouch = false
	board.CastShadow = false
	board.Size = Vector3.new(4.6, 1.9, 0.16)
	-- Front face looks at the walkway; leaning back like a little easel
	board.CFrame = CFrame.lookAt(at, at - toPlate) * CFrame.Angles(math.rad(-18), 0, 0)
	board.Color = Color3.fromRGB(255, 160, 40)
	board.Material = Enum.Material.SmoothPlastic
	board.Transparency = 1
	board.Parent = folder
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	gui.Brightness = 0.9
	gui.MaxDistance = 60
	gui.Parent = board
	local panel = Instance.new("Frame")
	panel.Position = UDim2.fromOffset(5, 5)
	panel.Size = UDim2.new(1, -10, 1, -10)
	panel.Parent = gui
	SignTheme.surface(panel, SignTheme.Gold)
	SignTheme.cashIcon(panel, UDim2.fromScale(0.02, 0.15), UDim2.fromScale(0.19, 0.7))
	local price = math.floor(Items.Income(item) * GameConfig.SellSeconds)
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Name = "SalePrice"
	label.Position = UDim2.fromScale(0.6, 0.5)
	label.Size = UDim2.fromScale(0.76, 0.8)
	label.Text = `SELL {Format.Cash(price)}`
	label.Parent = panel
	SignTheme.text(label, 38)
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 28
	click.Parent = board
	local armedUntil = 0
	click.MouseClick:Connect(function(who)
		if who ~= owner or owner:GetAttribute("InRound") then
			return
		end
		local profile = DataService.Get(owner)
		-- Still the same knife on this plate? (the wall may have changed since the sign was made)
		if not profile or DataService.IndexOnPlate(profile, plate) ~= index or profile.Knives[index] ~= item then
			return
		end
		if precious(item) and os.clock() > armedUntil then
			armedUntil = os.clock() + 3
			label.Text = "TAP AGAIN TO SELL"
			task.delay(3, function()
				if label.Parent and os.clock() >= armedUntil then
					label.Text = `SELL {Format.Cash(price)}`
				end
			end)
			return
		end
		-- Off the plate with a puff and a burst of cash, then the wall updates
		local spot = base.SlotCFrames[plate].Position
		Net.Remotes.Effect:FireAllClients("Smoke", spot)
		Net.Remotes.Effect:FireClient(owner, "CashBurst", spot, price)
		if BaseService.OnSellPrompt then
			BaseService.OnSellPrompt(owner, index)
		end
	end)
end

function BaseService.RefreshRack(player: Player)
	local base = baseOf[player]
	local profile = DataService.Get(player)
	if not base or not profile then
		return
	end
	local folder = rackModels[player]
	folder:ClearAllChildren()
	for _, pad in base.SlotPads do
		for _, old in pad:GetChildren() do
			if old:IsA("ProximityPrompt") then
				old:Destroy()
			end
		end
	end
	-- Bought a floor: the vault grows (and its frame with it)
	if base.Blocker:GetAttribute("Floors") ~= GameConfig.FloorsFor(profile.Slots) then
		BaseService.RefreshWalls(base)
	end
	local equipped = profile.Equipped
	local protected = BaseService.ProtectedItem(player)
	local multiplier = BaseService.IncomeMultiplier(player)
	for slot, pad in base.SlotPads do
		local rim = base.SlotRims[slot]
		local unlocked = slot <= profile.Slots
		-- Tsunami plates: navy and cyan when unlocked, grey while locked
		rim.Color = if unlocked then Color3.fromRGB(70, 214, 245) else Color3.fromRGB(150, 150, 160)
		rim.Material = Enum.Material.SmoothPlastic
		-- Knives keep their own plate (profile.Plates), so selling one never shuffles the rest
		local index = DataService.IndexOnPlate(profile, slot)
		local item = if index then profile.Knives[index] else nil
		local parsed = item and Items.Parse(item)
		if unlocked and index and item and parsed then
			local knife = parsed.Knife
			local model = KnifeModel.Build(item, true)
			-- Bigger items float bigger (a Colossal towers over its pedestal)
			KnifeModel.FitLength(model, 6 * (1 + (parsed.Size.Scale - 1) * 0.5))
			-- Centre the blade over the pedestal, then let clients bob and turn it (tag Spin)
			model:PivotTo(base.SlotCFrames[slot])
			local boxCF = model:GetBoundingBox()
			model:PivotTo(model:GetPivot() + (base.SlotCFrames[slot].Position - boxCF.Position))
			model:AddTag("Spin")
			model.Parent = folder
			local glow = Items.Color(item)
			-- The knife you fight with lights its plate up white
			if item == equipped then
				rim.Color = Color3.new(1, 1, 1)
				rim.Material = Enum.Material.Neon
			end
			-- Fire supplies the pedestal glow; an opaque beam would hide its long wisps.
			local anchor = model.PrimaryPart :: BasePart
			nameplate(folder, anchor, item, Items.Income(item) * multiplier)
			aura(folder, model, base, item, glow)

			-- One prompt per knife (the client hides prompts with someone else's Owner): Equip.
			-- Selling is the thin sign standing by the plate (sellSign).
			local name = Items.DisplayName(item)
			local equip = makePrompt(pad, {
				ActionText = if item == equipped then "Equipped" else "Equip",
				ObjectText = name,
			})
			equip:SetAttribute("Owner", player.UserId)
			equip.Triggered:Connect(function(who)
				if who == player and BaseService.OnEquipPrompt then
					BaseService.OnEquipPrompt(player, item)
				end
			end)
			sellSign(folder, base, player, slot, index, item)
			-- Raiders' prompt: only shown when this vault is open to them (client/Raid). The
			-- knife the owner fights with is always safe.
			if item ~= protected then
				local steal = makePrompt(pad, {
					ActionText = "Steal",
					ObjectText = `{name} ({knife.Rarity})`,
					HoldDuration = GameConfig.Raid.StealTime,
				})
				steal:SetAttribute("Owner", player.UserId)
				steal:SetAttribute("Steal", true)
				steal.Triggered:Connect(function(who)
					if who ~= player and BaseService.OnStealPrompt then
						BaseService.OnStealPrompt(who, player, index)
					end
				end)
			end
		elseif unlocked and not index then
			-- An empty plate takes the knife you're carrying (any of them, not just the next one)
			local place = makePrompt(pad, {
				ActionText = "Place Knife",
				ObjectText = "",
				HoldDuration = 0,
			})
			place:SetAttribute("Owner", player.UserId)
			place:SetAttribute("Place", true)
			place.Enabled = carryingKnife(player)
			local plate = slot
			place.Triggered:Connect(function(who)
				if who == player and BaseService.OnPlacePrompt then
					BaseService.OnPlacePrompt(player, plate)
				end
			end)
		end
	end
	player:SetAttribute("Income", rackIncome(player))
	base.TreadmillSign.Text = GameConfig.Treadmills[profile.TreadmillLevel].Name
end

local function claimBase(player: Player)
	for i, base in MapService.Bases do
		if not owners[i] then
			owners[i] = player
			baseOf[player] = base
			base.Sign.Text = `{player.DisplayName}'s Vault`
			local folder = Instance.new("Folder")
			folder.Name = `Rack_{player.Name}`
			folder.Parent = workspace:FindFirstChild("Map")
			rackModels[player] = folder
			player:SetAttribute("VaultIndex", i)
			-- The empty plates' "Place Knife" prompts only show while carrying a knife
			player:GetAttributeChangedSignal("Carrying"):Connect(function()
				local carrying = carryingKnife(player)
				for _, pad in base.SlotPads do
					for _, prompt in pad:GetChildren() do
						if prompt:IsA("ProximityPrompt") and prompt:GetAttribute("Place") then
							prompt.Enabled = carrying
						end
					end
				end
			end)
			BaseService.RefreshRack(player)
			BaseService.RefreshWalls(base)
			return
		end
	end
	warn(`[BaseService] no free base for {player.Name} - set the place's max players to {MapService.MaxBases}`)
end

local function releaseBase(player: Player)
	local base = baseOf[player]
	if base then
		owners[base.Index] = nil
		base.Sign.Text = "Empty Vault"
		for _, pad in base.SlotPads do
			pad.Color = Color3.fromRGB(40, 38, 46)
			for _, prompt in pad:GetChildren() do
				if prompt:IsA("ProximityPrompt") then
					prompt:Destroy()
				end
			end
		end
		for _, rim in base.SlotRims do
			rim.Color = Color3.fromRGB(30, 28, 34)
			rim.Material = Enum.Material.SmoothPlastic
		end
	end
	if rackModels[player] then
		rackModels[player]:Destroy()
	end
	baseOf[player] = nil
	rackModels[player] = nil
	if base then
		BaseService.RefreshWalls(base)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart")
	task.defer(function()
		if not player:GetAttribute("InRound") then
			BaseService.TeleportHome(player)
		end
		BaseService.RefreshWalkSpeed(player)
	end)
end

function BaseService.Init()
	Net.Remotes.SlowMode.OnServerEvent:Connect(function(player: Player, on: unknown)
		player:SetAttribute("SlowMode", if on == true then true else nil)
		BaseService.RefreshWalkSpeed(player)
	end)
	-- The hub floats in space: anyone who falls off the island is caught and sent home (whatever
	-- they were carrying drops where they fell, like any other fall)
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				-- (a dead body's loose root part sinks through the floor: that's not a fall, and
				-- rescuing it would use up their after-round return spot)
				if
					root
					and humanoid
					and humanoid.Health > 0
					and root.Position.Y < -45
					and not player:GetAttribute("InRound")
				then
					root.AssemblyLinearVelocity = Vector3.zero
					BaseService.TeleportHome(player)
				end
			end
		end
	end)
	DataService.PlayerLoaded:Connect(function(player: Player)
		claimBase(player)
		if player.Character then
			onCharacterAdded(player, player.Character)
		end
	end)
	local function watchCharacters(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
	end
	Players.PlayerAdded:Connect(watchCharacters)
	for _, player in Players:GetPlayers() do
		watchCharacters(player)
	end
	Players.PlayerRemoving:Connect(releaseBase)
	DataService.Changed:Connect(function(player: Player, profile: DataService.Profile)
		BaseService.RefreshWalkSpeed(player)
		-- New walls go up when the tier changes (upgrade, rebirth)
		local base = baseOf[player]
		if base and base.Blocker:GetAttribute("Tier") ~= profile.WallLevel then
			BaseService.RefreshWalls(base)
		end
	end)
	-- The equipped knife's plaque glows white
	local function watchEquipped(player: Player)
		player:GetAttributeChangedSignal("Equipped"):Connect(function()
			BaseService.RefreshRack(player)
		end)
	end
	Players.PlayerAdded:Connect(watchEquipped)
	for _, player in Players:GetPlayers() do
		watchEquipped(player)
	end

	-- Haunted Wheel: stand inside your vault's wheel to train Speed (AFK is fine)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local now = os.clock()
			local dt = now - last
			last = now
			for player, base in baseOf do
				local profile = DataService.Get(player)
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local on = false
				if profile and root and humanoid and humanoid.Health > 0 and not player:GetAttribute("InRound") then
					local localPos = base.Treadmill.CFrame:PointToObjectSpace(root.Position)
					local size = base.Treadmill.Size
					on = math.abs(localPos.X) < size.X / 2 + 0.5
						and math.abs(localPos.Z) < size.Z / 2 + 0.5
						and localPos.Y > 0
						and localPos.Y < 6
				end
				if player:GetAttribute("Training") ~= (on or nil) then
					player:SetAttribute("Training", on or nil)
					base.Wheel:SetAttribute("Spinning", on or nil) -- clients spin it
					if on and root and profile then
						-- Face the way the rungs roll, so it looks like running up the steps
						local hub = (base.Wheel.PrimaryPart :: BasePart).CFrame
						local forward = hub:VectorToWorldSpace(Vector3.zAxis)
						root.CFrame = CFrame.lookAt(root.Position, root.Position + forward)
					end
				end
				-- Better wheels spin faster (and the runner's legs keep up, see Moves)
				if on and profile then
					base.Wheel:SetAttribute("SpinRate", 1.4 + profile.TreadmillLevel * 0.55)
				end
				if on and profile then
					local rate = GameConfig.Treadmills[profile.TreadmillLevel].Rate
						* (1 + profile.Rebirths * GameConfig.Rebirth.SpeedBonus)
						* (if player:GetAttribute("Pass_FastWheel") then 2 else 1)
						* GameConfig.TrailMultiplier(
							profile.TrailLevel,
							player:GetAttribute("Pass_PhantomTrail") == true
						)
					DataService.Update(player, function(p)
						p.Speed += rate * dt
					end)
				end
			end
		end
	end)

	-- Every knife earns onto its own cash pad once a second (Tsunami style); the pads show what's
	-- waiting
	task.spawn(function()
		while true do
			task.wait(1)
			for player, base in baseOf do
				local profile = DataService.Get(player)
				if not profile then
					continue
				end
				local multiplier = BaseService.IncomeMultiplier(player)
				local boostUntil = player:GetAttribute("BoostUntil")
				if type(boostUntil) == "number" and workspace:GetServerTimeNow() < boostUntil then
					multiplier *= GameConfig.BoostMultiplier
				end
				DataService.Update(player, function(p)
					for index, item in p.Knives do
						local plate = p.Plates[index] or index
						if plate <= p.Slots then
							p.Pending[plate] = (p.Pending[plate] or 0) + Items.Income(item) * multiplier
						end
					end
				end)
				for slot, label in base.CashLabels do
					local waiting = profile.Pending[slot] or 0
					label.Text = if waiting > 0 and slot <= profile.Slots then Format.Cash(waiting) else ""
				end
			end
		end
	end)

	-- Walking over a cash pad collects it (only the owner's own pads)
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player, base in baseOf do
				local profile = DataService.Get(player)
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not profile or not root or player:GetAttribute("InRound") then
					continue
				end
				if not MapService.InBounds(base.Bounds, root.Position, 2) then
					continue
				end
				for slot, pad in base.CashPads do
					local waiting = profile.Pending[slot] or 0
					if waiting <= 0 or not pad.Parent or not pad:IsDescendantOf(workspace) then
						continue
					end
					local offset = pad.CFrame:PointToObjectSpace(root.Position)
					if
						math.abs(offset.X) < pad.Size.X / 2 + 0.8
						and math.abs(offset.Z) < pad.Size.Z / 2 + 0.8
						and offset.Y > 0
						and offset.Y < 6
					then
						DataService.Update(player, function(p)
							p.Pending[slot] = 0
						end)
						DataService.AddCash(player, waiting)
						base.CashLabels[slot].Text = ""
						Net.Remotes.Effect:FireClient(player, "CashBurst", pad.Position, waiting)
					end
				end
			end
		end
	end)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CharacterDetails</string>
            <string name="Source"><![CDATA[--!strict
-- Small raised, square details follow each existing outfit rather than replacing its artwork.
-- Everything is welded, massless and non-queryable so combat and movement keep their old shape.
local CharacterDetails = {}
local rgb = Color3.fromRGB
type Finish = { Style: string, Cloth: Color3, Accent: Color3, Shoe: Color3, Sole: Color3 }
local FINISHES: { [string]: Finish } = {
	Mortimer = {
		Style = "Suit",
		Cloth = rgb(70, 30, 40),
		Accent = rgb(220, 190, 90),
		Shoe = rgb(30, 26, 30),

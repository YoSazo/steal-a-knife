{
  "name": "StealAKnife",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$path": "src/first"
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "DevTouchCameraMovementMode": "Classic",
        "DevComputerCameraMovementMode": "Classic"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingIntegrityMode": "Disabled",
        "StreamOutBehavior": "Opportunistic",
        "StreamingTargetRadius": 768
      }
    }
  }
}
